<lb n="42"/>gezogen <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">ufgehalten</unclear> werde.
<lb n="43"/><unclear cert="medium" resp="#joint">Deroegen</unclear> ich <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">anrueffen</unclear> des <unclear cert="medium" resp="#joint">Großvaters</unclear>,
<lb n="44"/><unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">früntschafft</unclear>, den Herren mit disem <unclear cert="medium" resp="#joint">schryben</unclear>
<lb n="45"/><unclear cert="medium" resp="#joint">zeersuochen</unclear> nit <unclear cert="medium" resp="#joint">umbgehn</unclear> wellen, hiemit gantz
<lb n="46"/><unclear cert="low" resp="#joint">dienst</unclear>, <unclear cert="low" resp="#joint">frünnd</unclear>: <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">nachpüerlich</unclear> <unclear cert="low" resp="#joint">pitend</unclear>, der
<lb n="47"/><unclear cert="low" resp="#joint">Herr</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Oberkeit</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">verschaffen</unclear> <unclear cert="low" resp="#joint">welle</unclear>,
<lb n="48"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">dochter</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">irem</unclear> <unclear cert="low" resp="#joint">pässer</unclear> <unclear cert="low" resp="#joint">sölcher</unclear> <unclear cert="low" resp="#joint">gestalt</unclear>,
<lb n="49"/>nit <unclear cert="medium" resp="#joint">yngezogen</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">ufgehalten</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> also zuo
<lb n="50"/><unclear cert="medium" resp="#joint">merer</unclear> <unclear cert="medium" resp="#joint">unghorsame</unclear> <unclear cert="medium" resp="#joint">anlaß</unclear> geben <unclear cert="medium" resp="#joint">werde</unclear>.
<lb n="51"/><unclear cert="medium" resp="#joint">Sannder</unclear> <unclear cert="medium" resp="#joint">daß</unclear> sy sich mit disem allem <unclear cert="medium" resp="#joint">daß</unclear> wegen
<lb n="52"/><unclear cert="medium" resp="#joint">ir</unclear> <unclear cert="medium" resp="#joint">gesetzen</unclear> <unclear cert="medium" resp="#joint">vorten</unclear> <unclear cert="medium" resp="#joint">widerumb</unclear> <unclear cert="medium" resp="#joint">allhero</unclear> ver-
<lb n="53"/><unclear cert="medium" resp="#joint">füege</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> so <unclear cert="medium" resp="#joint">ire</unclear> nit die <unclear cert="medium" resp="#joint">gnaud</unclear>, sonder <unclear cert="medium" resp="#joint">etwaz</unclear>
<lb n="54"/><unclear cert="medium" resp="#joint">clagbarlichs</unclear> <unclear cert="medium" resp="#joint">begegnen</unclear> und widerfaren wurde
<lb n="55"/><unclear cert="medium" resp="#joint">soll</unclear> sy inn <unclear cert="medium" resp="#joint">oberkeitlichem</unclear> schutz, und schirm gehalten
<lb n="56"/>werden. <unclear cert="low" resp="#joint">Daß</unclear> <unclear cert="low" resp="#joint">stath</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">glichmessigen</unclear>,
<lb n="57"/>oder anderen <unclear cert="medium" resp="#joint">fählen</unclear> <unclear cert="medium" resp="#joint">hinwiderumb</unclear> <unclear cert="medium" resp="#joint">zebeschulden</unclear>,
<lb n="58"/>und <unclear cert="medium" resp="#joint">bewyß</unclear> den Herren sonsten allen <unclear cert="low" resp="#joint">angenemen</unclear>
<lb n="59"/>nachparlichen willen und dienst <unclear cert="medium" resp="#joint">zebeweisen</unclear>,
<lb n="60"/>bin ich <unclear cert="medium" resp="#joint">anerbietlich</unclear> <unclear cert="medium" resp="#joint">bereit</unclear> und willig. <unclear cert="medium" resp="#joint">Damit</unclear>
