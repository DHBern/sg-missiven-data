    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1729_6353.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich <unclear cert="low" resp="#joint">gruoß</unclear> sampt was wir
<lb n="2"/>Ehren liebs <unclear cert="medium" resp="#joint">unnd</unclear> guots <unclear cert="low" resp="#joint">vermögend</unclear> zuvor, <unclear cert="medium" resp="#joint">Fromm</unclear>,
<lb n="3"/>Fürsichtig, <unclear cert="medium" resp="#joint">Ersamm</unclear>, <unclear cert="low" resp="#joint">Wyß</unclear>, Insonders <unclear cert="low" resp="#joint">guote</unclear> Fründ,
<lb n="4"/><unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">getrüw</unclear> lieb <unclear cert="medium" resp="#joint">Eydtgnosen</unclear>.
<lb n="5"/>Demnach unns hüttigs tags <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">getr</unclear>. lieber
<lb n="6"/>Burger <unclear cert="low" resp="#joint">houpt</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Hanns</unclear> <unclear cert="low" resp="#joint">Schwaller</unclear></persName> <unclear cert="low" resp="#joint">klagswyse</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">fürbringen</unclear> lassen, wie das <persName resp="#ner">Heinrich <unclear cert="medium" resp="#joint">Zysar</unclear></persName>, <unclear cert="medium" resp="#joint">sin</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">geordneter</unclear> Factor, nach dem er <unclear cert="low" resp="#joint">ime</unclear> alle <unclear cert="medium" resp="#joint">sine</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">selbiger</unclear> <unclear cert="medium" resp="#joint">enden</unclear> habende sachen <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">geschäfft</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">verthribet</unclear>, <unclear cert="low" resp="#joint">usgerissen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> nach uffhebung
<lb n="11"/>etwas Summ <unclear cert="medium" resp="#joint">gellts</unclear>, sich uff <unclear cert="low" resp="#joint">flüchtigen</unclear> fuoß
<lb n="12"/><unclear cert="low" resp="#joint">gestellt</unclear>, Wan nun obgedachter <persName resp="#ner">H. <unclear cert="low" resp="#joint">Schwaller</unclear></persName>
<lb n="13"/><unclear cert="low" resp="#joint">vorhabens</unclear>, dem <unclear cert="low" resp="#joint">sinigen</unclear> sovil möglich, daselbs
<lb n="14"/><unclear cert="medium" resp="#joint">widerum</unclear> <unclear cert="medium" resp="#joint">nachzufragen</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> guoter <unclear cert="medium" resp="#joint">Fründ</unclear>
<lb n="15"/>und hilff wohl <unclear cert="medium" resp="#joint">manglen</unclear> <unclear cert="medium" resp="#joint">wirt</unclear> unns ouch des-
<lb n="16"/>halben umb ein <unclear cert="low" resp="#joint">Intercessionschryben</unclear> an üch ange-
<lb n="17"/>lanngt, So haben wir nit <unclear cert="low" resp="#joint">umbgehn</unclear>
<lb n="18"/>können, üch mit <unclear cert="medium" resp="#joint">disrem</unclear> <unclear cert="low" resp="#joint">einfalten</unclear> schryben zu-
<lb n="19"/>ersuochen, <unclear cert="medium" resp="#joint">unnd</unclear> wie <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">beschiht</unclear> <unclear cert="low" resp="#joint">gannz</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">Eydtgnosisch</unclear> <unclear cert="low" resp="#joint">zufirten</unclear>, Ir <unclear cert="medium" resp="#joint">wöllend</unclear> <unclear cert="medium" resp="#joint">disen</unclear>
<lb n="21"/>unsern in all <unclear cert="low" resp="#joint">gepürlich</unclear> sachen, <unclear cert="low" resp="#joint">handreychung</unclear> thuon,
<lb n="22"/><unclear cert="medium" resp="#joint">unnd</unclear> allso <unclear cert="low" resp="#joint">behulffen</unclear> <unclear cert="low" resp="#joint">ud</unclear> berathen sin, das
<lb n="23"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">gspüren</unclear>, solliches <unclear cert="medium" resp="#joint">unnsers</unclear> Intercedierens
<lb n="24"/><unclear cert="low" resp="#joint">gnoss</unclear> haben, Euch in ander <unclear cert="medium" resp="#joint">wäg</unclear> <unclear cert="medium" resp="#joint">zudienen</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">sind</unclear> wir <unclear cert="low" resp="#joint">gneygt</unclear> <unclear cert="low" resp="#joint">ud</unclear> <unclear cert="low" resp="#joint">guotwillig</unclear>
<lb n="26"/>dat. <origDate when="1611-07-29" resp="#ner">29 July 1611</origDate>.
<lb n="27"/><orgName ref="stadtasg-actors-944" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Schults</unclear> unnd Rhat
<lb n="28"/>der Statt <unclear cert="medium" resp="#joint">Sollothurn</unclear></orgName>.
<pb facs="StadtASG_Missive_1729_6354.jpg" n="2"/>
<pb facs="StadtASG_Missive_1729_6355.jpg" n="3"/>
<pb facs="StadtASG_Missive_1729_6356.jpg" n="4"/>
<lb n="29"/>Denn frommen fuersichtigen,
<lb n="30"/>ehrsammen, <unclear cert="low" resp="#joint">wÿsen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="31"/>meister unnd Rhat <unclear cert="medium" resp="#joint">d</unclear> Statt
<lb n="32"/>Sannt Gallen</orgName> unsern insonders
<lb n="33"/>guoten fründen <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">getrüwen</unclear>
<lb n="34"/>lieben <unclear cert="low" resp="#joint">Eÿdtgnossen</unclear>
</p>
