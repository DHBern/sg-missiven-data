<p>
<pb facs="StadtASG_Missive_1944_7235.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unßer</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear> willig <unclear cert="low" resp="#joint">dinnst</unclear> <unclear cert="medium" resp="#joint">etc</unclear>. getrüw lieb <unclear cert="medium" resp="#joint">Alt</unclear>
<lb n="2"/><orgName role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnosßen</unclear></orgName>.
<lb n="3"/><unclear cert="medium" resp="#joint">Welcher</unclear> <unclear cert="medium" resp="#joint">masßen</unclear> uff <unclear cert="medium" resp="#joint">erst</unclear> zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> gehaltner <unclear cert="low" resp="#joint">tagleystung</unclear>, den
<lb n="4"/>gemeinen <orgName resp="#ner">Eidtgnößischen <unclear cert="low" resp="#joint">Khaufflüthen</unclear></orgName> <unclear cert="low" resp="#joint">vergönnt</unclear> und <unclear cert="low" resp="#joint">zuoge</unclear>-
<lb n="5"/>laßen, <unclear cert="low" resp="#joint">etliche</unclear> <unclear cert="low" resp="#joint">Gsandten</unclear> <unclear cert="low" resp="#joint">uß</unclear> den <unclear cert="low" resp="#joint">Orthen</unclear> <unclear cert="low" resp="#joint">zenemmen</unclear>, damit
<lb n="6"/><unclear cert="low" resp="#joint">Koenn</unclear>. Mt. <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-131" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Franckhrych</unclear></placeName> der <unclear cert="low" resp="#joint">beschwerden</unclear>, so denselben wider
<lb n="7"/>die <unclear cert="low" resp="#joint">Vereinigung</unclear> und <unclear cert="medium" resp="#joint">Ewigen</unclear> <unclear cert="medium" resp="#joint">friden</unclear> <unclear cert="medium" resp="#joint">begegnet</unclear>, <unclear cert="medium" resp="#joint">möge</unclear> ver-
<lb n="8"/><unclear cert="medium" resp="#joint">stendiget</unclear> und umb <unclear cert="low" resp="#joint">gnedigs</unclear> <unclear cert="low" resp="#joint">Ynsehen</unclear> ersuocht werden, sind
<lb n="9"/>wir durch <unclear cert="low" resp="#joint">unßern</unclear> <unclear cert="medium" resp="#joint">daselbs</unclear> <unclear cert="low" resp="#joint">geweßnen</unclear> <unclear cert="low" resp="#joint">eeren</unclear> <unclear cert="low" resp="#joint">Gsandten</unclear> <unclear cert="low" resp="#joint">informiert</unclear>
<lb n="10"/>und bericht worden, und habent <unclear cert="low" resp="#joint">uß</unclear> söllicher relation auch
<lb n="11"/><unclear cert="low" resp="#joint">vermerckht</unclear>, <unclear cert="medium" resp="#joint">das</unclear> <unclear cert="medium" resp="#joint">er</unclear> die meinung und <unclear cert="medium" resp="#joint">verstand</unclear> by <unclear cert="medium" resp="#joint">Inen</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">gehept</unclear>, <unclear cert="low" resp="#joint">Wyl</unclear> diß ein gemeines <unclear cert="low" resp="#joint">gschefft</unclear>, und <unclear cert="low" resp="#joint">In</unclear> unßeren
<lb n="13"/><unclear cert="low" resp="#joint">Orthen</unclear> auch so wol alß <unclear cert="medium" resp="#joint">Inn</unclear> den anderen <unclear cert="low" resp="#joint">Khaufflüth</unclear> sind,
<lb n="14"/>so <unclear cert="low" resp="#joint">werde</unclear> Inn <unclear cert="medium" resp="#joint">söllicher</unclear> <unclear cert="low" resp="#joint">gsandtschafft</unclear> auch ein <unclear cert="medium" resp="#joint">glychheit</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">geprucht</unclear> und wir <unclear cert="low" resp="#joint">darvon</unclear> auch nit <unclear cert="medium" resp="#joint">ußgeschloßen</unclear> werden,
<lb n="16"/>Wie dann <unclear cert="low" resp="#joint">vormahlen</unclear> Inn derglychen <unclear cert="low" resp="#joint">fälen</unclear> auch <unclear cert="low" resp="#joint">beschehen</unclear>.
<lb n="17"/>Wann aber <unclear cert="low" resp="#joint">G</unclear>. L. A. E. <unclear cert="low" resp="#joint">unß</unclear> nit <unclear cert="low" resp="#joint">ohne</unclear> mißfallen und
<lb n="18"/><unclear cert="medium" resp="#joint">beduren</unclear> <unclear cert="medium" resp="#joint">fürkhommen</unclear>, das <unclear cert="medium" resp="#joint">neben</unclear> <unclear cert="medium" resp="#joint">uwerem</unclear> <unclear cert="medium" resp="#joint">Buw</unclear>- Statt-
<lb n="19"/><unclear cert="low" resp="#joint">schryber</unclear> (den wir <unclear cert="medium" resp="#joint">hierzuo</unclear> <unclear cert="medium" resp="#joint">bequem</unclear> achtend und unß ge-
<lb n="20"/>fallen <unclear cert="medium" resp="#joint">Lasßend</unclear>) <unclear cert="medium" resp="#joint">Nieman</unclear> <unclear cert="medium" resp="#joint">dan</unclear> <unclear cert="medium" resp="#joint">unßere</unclear> <unclear cert="medium" resp="#joint">G</unclear>. L. E. der Statt
<lb n="21"/><placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schaffhußen</unclear></placeName>, auch <unclear cert="medium" resp="#joint">umb</unclear> ein <unclear cert="low" resp="#joint">Gsandten</unclear> ersuocht, <unclear cert="low" resp="#joint">unß</unclear>
<lb n="22"/>aber <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">unehr</unclear> erzeigt worden, das man <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">unßeren</unclear>
<lb n="23"/>und <unclear cert="medium" resp="#joint">unßern</unclear> <unclear cert="medium" resp="#joint">Orthen</unclear> <unclear cert="medium" resp="#joint">kheine</unclear> <unclear cert="medium" resp="#joint">erfordert</unclear>. So <unclear cert="medium" resp="#joint">khönnend</unclear>
<lb n="24"/>wir die sach nit <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">hingan</unclear> laßen, <unclear cert="medium" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">wyl</unclear> ein sölliche
<lb n="25"/>verachtung und <unclear cert="low" resp="#joint">undanckhbarkeit</unclear> unß begegnet, <unclear cert="low" resp="#joint">wöllend</unclear>
<lb n="26"/>wir hiemit die <unclear cert="low" resp="#joint">Ynwilligung</unclear> Inn <unclear cert="low" resp="#joint">obangedüttete</unclear> Bott-
<lb n="27"/>schafft Inn <placeName ref="stadtasg-places-131" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Franckhrych</unclear></placeName>, <unclear cert="medium" resp="#joint">gentzlichen</unclear> <unclear cert="low" resp="#joint">widerruofft</unclear> und
<lb n="28"/><unclear cert="medium" resp="#joint">uffgehept</unclear> haben, es <unclear cert="medium" resp="#joint">syge</unclear> dann das uß <unclear cert="low" resp="#joint">unßeren</unclear> <unclear cert="low" resp="#joint">Orthen</unclear>
<lb n="29"/>darzuo <unclear cert="medium" resp="#joint">auch</unclear> Inn <unclear cert="low" resp="#joint">glycher</unclear> <unclear cert="medium" resp="#joint">anzal</unclear> angesprochen und <unclear cert="low" resp="#joint">geprucht</unclear>
<lb n="30"/><unclear cert="medium" resp="#joint">werdent</unclear>, <unclear cert="low" resp="#joint">Fahlß</unclear> aber <unclear cert="low" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">unßere</unclear> <unclear cert="low" resp="#joint">G</unclear>. L. A. E. der
<lb n="31"/>übrigen <unclear cert="low" resp="#joint">Orthen</unclear>, für üch <unclear cert="low" resp="#joint">selbßen</unclear> diße Bottschafft ab-
<lb n="32"/><unclear cert="low" resp="#joint">gahn</unclear> laßen <unclear cert="medium" resp="#joint">wöltendt</unclear>, so werdent dann <unclear cert="medium" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">unßere</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">Orth</unclear> <unclear cert="medium" resp="#joint">Inn</unclear> den <unclear cert="medium" resp="#joint">ußgehenden</unclear> <unclear cert="medium" resp="#joint">Credentzschryben</unclear> unnd
<lb n="34"/><unclear cert="medium" resp="#joint">Instructionen</unclear>, <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">Ynvermelten</unclear> sonder <unclear cert="medium" resp="#joint">ußzelaßen</unclear>
<pb facs="StadtASG_Missive_1944_7236.jpg" n="2"/>
<lb n="35"/><unclear cert="medium" resp="#joint">wüßen</unclear>, <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">bschwerdt</unclear> <unclear cert="medium" resp="#joint">sin</unclear> dißes von uns in guotem
<lb n="36"/><unclear cert="low" resp="#joint">vermärken</unclear>, als <unclear cert="low" resp="#joint">wöllicher</unclear> <unclear cert="medium" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> billicher rettung
