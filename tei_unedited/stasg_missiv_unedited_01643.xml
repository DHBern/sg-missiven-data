<p>
<pb facs="StadtASG_Missive_1643_5985.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freündtlich</unclear> willig <unclear cert="medium" resp="#joint">dinst</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> was wir ehren, liebs,
<lb n="2"/><unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">guotß</unclear> <unclear cert="low" resp="#joint">vermüegendt</unclear> zuovor, frome fürsichtige <unclear cert="low" resp="#joint">ehr</unclear>-
<lb n="3"/><unclear cert="medium" resp="#joint">same</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">weyse</unclear>, <unclear cert="medium" resp="#joint">jnnsonnders</unclear> guote <unclear cert="low" resp="#joint">freündt</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">getreüe</unclear> liebe
<lb n="4"/><unclear cert="low" resp="#joint">nachpawren</unclear>. Wir <unclear cert="low" resp="#joint">haben</unclear> ain <unclear cert="low" resp="#joint">argewanigschn</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">verlümbdete</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">weybßperson</unclear> diser tagen in gefangenschafft leggen lassen <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">nun</unclear> mehr sovil uß <unclear cert="low" resp="#joint">jro</unclear> <unclear cert="low" resp="#joint">erfaren</unclear>, das wir unß der <unclear cert="low" resp="#joint">peynlichen</unclear>
<lb n="7"/>fragen gegen <unclear cert="low" resp="#joint">jra</unclear> nit <unclear cert="low" resp="#joint">uberheben</unclear> können; <unclear cert="medium" resp="#joint">jst</unclear> <unclear cert="low" resp="#joint">derowegen</unclear> an <unclear cert="medium" resp="#joint">üch</unclear>
<lb n="8"/>unnser <unclear cert="medium" resp="#joint">freündt</unclear>. <unclear cert="medium" resp="#joint">nachbawrliches</unclear> begeren, ir <unclear cert="medium" resp="#joint">wöllend</unclear> <unclear cert="medium" resp="#joint">ordnung</unclear>
<lb n="9"/>geben lassen, das <unclear cert="low" resp="#joint">ewer</unclear> <unclear cert="low" resp="#joint">nachrichter</unclear> noch heüt abendts <unclear cert="medium" resp="#joint">allhir</unclear>
<lb n="10"/>zuo <placeName ref="stadtasg-places-8" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Appentzell</unclear></placeName> <unclear cert="low" resp="#joint">erschyne</unclear>, damit wir <unclear cert="medium" resp="#joint">jn</unclear> der sach <unclear cert="low" resp="#joint">füegkhlich</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">procediren</unclear> <unclear cert="low" resp="#joint">khönnendt</unclear>. <unclear cert="medium" resp="#joint">Unnd</unclear> <unclear cert="low" resp="#joint">thüend</unclear>, <unclear cert="low" resp="#joint">neben</unclear> anerbietung
<lb n="12"/>alles guoten <unclear cert="low" resp="#joint">nachbawrlichen</unclear> <unclear cert="low" resp="#joint">wyllenß</unclear>, unß <unclear cert="medium" resp="#joint">beyder</unclear> <unclear cert="medium" resp="#joint">syts</unclear> <unclear cert="medium" resp="#joint">göt</unclear>-
<lb n="13"/>licher gnaden <unclear cert="medium" resp="#joint">anbevelchen</unclear>; datum <origDate when="1609" resp="#ner">den .20. <unclear cert="low" resp="#joint">t</unclear>. junij. <unclear cert="medium" resp="#joint">Ao</unclear> 1609</origDate>.
<lb n="14"/><orgName ref="stadtasg-actors-506" cert="medium" role="issuer" resp="#ner">Lanndtamman <unclear cert="medium" resp="#joint">unnd</unclear> raath
<lb n="15"/>zuo <unclear cert="low" resp="#joint">Appentzell</unclear></orgName>. <unclear cert="low" resp="#joint">etc</unclear>.
