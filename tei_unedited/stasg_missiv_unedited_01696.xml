    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1696_6209.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">fründtl</unclear>. und nach <unclear cert="low" resp="#joint">purlich</unclear> willig dienst
<lb n="2"/>und was wir <unclear cert="medium" resp="#joint">Eheren</unclear> liebs und <unclear cert="medium" resp="#joint">guets</unclear> ver
<lb n="3"/>moegend. <unclear cert="medium" resp="#joint">Zuo</unclear> vor <unclear cert="low" resp="#joint">From</unclear> <unclear cert="low" resp="#joint">Fuersichtig</unclear> <unclear cert="low" resp="#joint">Ehr</unclear> <unclear cert="low" resp="#joint">sam</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">wyss</unclear>. In sonders guet <unclear cert="medium" resp="#joint">frund</unclear> und <unclear cert="medium" resp="#joint">gethruewe</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">leib</unclear> nach <unclear cert="medium" resp="#joint">puren</unclear>. Die <unclear cert="low" resp="#joint">wil</unclear> wir unseren
<lb n="6"/>gethrüwen und lieben Herren Landt <persName resp="#ner">Aman
<lb n="7"/><unclear cert="low" resp="#joint">Katlen</unclear></persName> <unclear cert="low" resp="#joint">giser</unclear>, <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">dis</unclear> <unclear cert="low" resp="#joint">nüw</unclear> an <unclear cert="medium" resp="#joint">gesetze</unclear> <unclear cert="medium" resp="#joint">Jar</unclear> <unclear cert="medium" resp="#joint">rechnug</unclear>
<lb n="8"/>gen <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> Zuo ainem <unclear cert="low" resp="#joint">gsandten</unclear> geordnet,
<lb n="9"/>Habend wir Ime nebet anderem <unclear cert="low" resp="#joint">bevelch</unclear>
<lb n="10"/>mit <persName resp="#ner">Ernst <unclear cert="low" resp="#joint">Empfolet</unclear></persName> <unclear cert="low" resp="#joint">flisig</unclear> an zuo halten
<lb n="11"/>ob villicht diser <unclear cert="low" resp="#joint">Durch</unclear> <placeName ref="stadtasg-places-10" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Zug</unclear></placeName> und <placeName ref="stadtasg-places-133" cert="medium" resp="#ner">Bass</placeName> ins
<lb n="12"/><unclear cert="medium" resp="#joint">künftig</unclear> <unclear cert="medium" resp="#joint">hin</unclear> ab <unclear cert="medium" resp="#joint">gsteelt</unclear> <unclear cert="medium" resp="#joint">moechte</unclear> werden. <unclear cert="low" resp="#joint">dero</unclear>
<lb n="13"/>wegen uns gar <unclear cert="low" resp="#joint">nuzlich</unclear> und frucht <unclear cert="low" resp="#joint">barlichen</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">bedunkt</unclear>. wann ir ouch ainen <unclear cert="low" resp="#joint">gsandten</unclear> <unclear cert="medium" resp="#joint">gschickt</unclear>
<lb n="15"/>in <unclear cert="low" resp="#joint">besserem</unclear> an <unclear cert="low" resp="#joint">sehen</unclear> wann die bed Herren
<lb n="16"/>mit Ernst an ghalten hettend. Diser pass
<lb n="17"/>zuo er werren und ab stellen. <unclear cert="medium" resp="#joint">gueter</unclear> hoffnung
<lb n="18"/><unclear cert="low" resp="#joint">soelches</unclear> by den <unclear cert="low" resp="#joint">gsandten</unclear> gemeinen <unclear cert="medium" resp="#joint">Eid</unclear> <unclear cert="medium" resp="#joint">gnossen</unclear>
<lb n="19"/>Zuo er hollen, <unclear cert="low" resp="#joint">Woellend</unclear> also <unclear cert="low" resp="#joint">soelches</unclear> nach <unclear cert="low" resp="#joint">purliches</unclear>
<lb n="20"/>schriben von uns in besten wie es dan <unclear cert="medium" resp="#joint">bschicht</unclear>
<lb n="21"/>ver nemen, und ainen <unclear cert="low" resp="#joint">gsandten</unclear> nach <unclear cert="low" resp="#joint">üweren</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">gefalen</unclear> Er wellen. wie dan unser <unclear cert="low" resp="#joint">Her</unclear> Landt
<lb n="23"/>aman willens <unclear cert="low" resp="#joint">jez</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">Fritag</unclear> morgen</date> Zu <unclear cert="low" resp="#joint">ver</unclear> <unclear cert="low" resp="#joint">Ritten</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">Thund</unclear> hie mit <unclear cert="low" resp="#joint">üch</unclear> und uns samptlich in gottes <unclear cert="low" resp="#joint">Huld</unclear>
<lb n="25"/>und schirm <unclear cert="low" resp="#joint">Bevelhende</unclear>, dato den <origDate resp="#ner">5. <unclear cert="medium" resp="#joint">18</unclear> <unclear cert="medium" resp="#joint">hoeuet</unclear>
<lb n="26"/>Anno. 610</origDate>
<lb n="27"/><orgName ref="stadtasg-actors-773" cert="medium" role="issuer" resp="#ner">Landt aman und Rat der usseren
<lb n="28"/>Roden dess landts Zuo Appenzell</orgName>,
<pb facs="StadtASG_Missive_1696_6210.jpg" n="2"/>
<lb n="29"/>[]
<pb facs="StadtASG_Missive_1696_6211.jpg" n="3"/>
<pb facs="StadtASG_Missive_1696_6212.jpg" n="4"/>
<lb n="30"/>Den <unclear cert="medium" resp="#joint">fromen</unclear> fuersichtigen eersamen
<lb n="31"/>und wysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und
<lb n="32"/><unclear cert="medium" resp="#joint">Rhat</unclear> zu Sant Gallen</orgName>, <unclear cert="medium" resp="#joint">unnseren</unclear> <unclear cert="medium" resp="#joint">in</unclear>-
<lb n="33"/><unclear cert="medium" resp="#joint">sunders</unclear> <unclear cert="medium" resp="#joint">guten</unclear> fruenden und wol ver-
<lb n="34"/><unclear cert="medium" resp="#joint">thruewten</unclear> lieben nachpuren,
</p>
