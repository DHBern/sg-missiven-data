<lb n="21"/>sonder durch die <unclear cert="low" resp="#joint">Mannen</unclear>. <unclear cert="low" resp="#joint">bgemelt</unclear> <unclear cert="medium" resp="#joint">selbst</unclear> <unclear cert="medium" resp="#joint">beschechen</unclear>.
