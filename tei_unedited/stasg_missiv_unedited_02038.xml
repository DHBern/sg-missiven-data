<p>
<pb facs="StadtASG_Missive_2038_7609.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edel</unclear> <unclear cert="low" resp="#joint">from</unclear> <unclear cert="low" resp="#joint">eervest</unclear> <unclear cert="low" resp="#joint">fürnem</unclear> <unclear cert="low" resp="#joint">fürsichtig</unclear> <unclear cert="low" resp="#joint">wyß</unclear>, <unclear cert="low" resp="#joint">innbe</unclear>-
<lb n="2"/><unclear cert="low" resp="#joint">sondere</unclear>, <unclear cert="low" resp="#joint">günstige</unclear> herren <unclear cert="medium" resp="#joint">nachparn</unclear>, <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">syen</unclear>, unser
<lb n="3"/><unclear cert="medium" resp="#joint">früntlich</unclear> guotwillige <unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">zuvor</unclear> <unclear cert="low" resp="#joint">etc</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Gegennt</unclear> <unclear cert="low" resp="#joint">wurts</unclear>, waß die <unclear cert="low" resp="#joint">bede</unclear>, <unclear cert="low" resp="#joint">alhieige</unclear> <unclear cert="low" resp="#joint">bestrikte</unclear>,
<lb n="5"/><unclear cert="low" resp="#joint">persohnen</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Balthas</unclear> <unclear cert="low" resp="#joint">Heÿder</unclear></persName>, von <placeName ref="stadtasg-places-227" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Vläningen</unclear></placeName>, ein <unclear cert="medium" resp="#joint">spill</unclear>-
<lb n="6"/>man, und <persName resp="#ner"><unclear cert="medium" resp="#joint">Hans</unclear> <unclear cert="medium" resp="#joint">Hürte</unclear></persName>, oder <unclear cert="medium" resp="#joint">Hünd</unclear>, <unclear cert="medium" resp="#joint">usß</unclear> <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">pundt</unclear>,
<lb n="7"/>von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Castels</unclear></placeName>, <unclear cert="medium" resp="#joint">usßgesagt</unclear>, ist <unclear cert="low" resp="#joint">umbstantzlich</unclear> nit <unclear cert="medium" resp="#joint">merers</unclear>,
<lb n="8"/>dann waß die <unclear cert="medium" resp="#joint">stoeeß</unclear>, und <unclear cert="medium" resp="#joint">lermen</unclear>, mit wort und
<lb n="9"/><unclear cert="medium" resp="#joint">werkhen</unclear>, inn <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName> <unclear cert="low" resp="#joint">vorstatt</unclear>, <unclear cert="low" resp="#joint">vorloffen</unclear>, <unclear cert="low" resp="#joint">nit</unclear> ab,
<lb n="10"/>sonder <unclear cert="low" resp="#joint">gstanndig</unclear> <unclear cert="low" resp="#joint">seÿen</unclear>, <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">muotwils</unclear>, der <unclear cert="medium" resp="#joint">völle</unclear>,
<lb n="11"/><unclear cert="medium" resp="#joint">wy</unclear>. und <unclear cert="medium" resp="#joint">trunkenheit</unclear> zuo <unclear cert="medium" resp="#joint">gebend</unclear>, die <unclear cert="medium" resp="#joint">wÿber</unclear>.
<lb n="12"/>belangende, <unclear cert="medium" resp="#joint">alß</unclear> deß <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">pundt</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Anna</unclear> <unclear cert="low" resp="#joint">Maria</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">Schmidin</unclear></persName>, <unclear cert="low" resp="#joint">habe</unclear> <unclear cert="low" resp="#joint">vonn</unclear> <unclear cert="low" resp="#joint">begangnen</unclear>, <unclear cert="low" resp="#joint">beider</unclear> <unclear cert="low" resp="#joint">Mannen</unclear>.
<lb n="14"/><unclear cert="low" resp="#joint">diebstäl</unclear> nichts <unclear cert="medium" resp="#joint">gewüßt</unclear>, dann, von einem <unclear cert="low" resp="#joint">buochkessel</unclear>,
<lb n="15"/>sy zuo <placeName ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Bischoffzell</unclear></placeName>, <unclear cert="medium" resp="#joint">denn</unclear>, armen <unclear cert="low" resp="#joint">siechen</unclear>, <unclear cert="low" resp="#joint">enntwend</unclear>
<lb n="16"/>und <unclear cert="medium" resp="#joint">durch</unclear> die <unclear cert="medium" resp="#joint">Mann</unclear>, (also <unclear cert="medium" resp="#joint">zusamen</unclear> <unclear cert="medium" resp="#joint">gschlagen</unclear>.) gen
<lb n="17"/><placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Costantz</unclear></placeName> tragen und umb 4 <unclear cert="medium" resp="#joint">fl</unclear>. <unclear cert="medium" resp="#joint">verkoufft</unclear>, <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">Hefft</unclear>-
<lb n="18"/><unclear cert="medium" resp="#joint">lins</unclear>, <unclear cert="medium" resp="#joint">Irro</unclear> <unclear cert="medium" resp="#joint">bewüßt</unclear>, <unclear cert="medium" resp="#joint">eims</unclear> <unclear cert="medium" resp="#joint">armen</unclear> <unclear cert="medium" resp="#joint">paffenß</unclear> <unclear cert="medium" resp="#joint">glÿch</unclear>.
<lb n="19"/><unclear cert="medium" resp="#joint">lig</unclear>, und <unclear cert="medium" resp="#joint">wÿl</unclear>, <unclear cert="medium" resp="#joint">vnd</unclear> 1 <unclear cert="medium" resp="#joint">vierling</unclear> <unclear cert="medium" resp="#joint">Nuß</unclear>. genomen, an
<lb n="20"/><unclear cert="medium" resp="#joint">dem</unclear> und <unclear cert="medium" resp="#joint">andern</unclear> <unclear cert="medium" resp="#joint">diebstälen</unclear>, sy nit <unclear cert="medium" resp="#joint">bÿgewohnt</unclear>,
<lb n="21"/>sonder <unclear cert="medium" resp="#joint">durch</unclear> die <unclear cert="medium" resp="#joint">Mannen</unclear>. <unclear cert="medium" resp="#joint">bgemelt</unclear> <unclear cert="medium" resp="#joint">selbst</unclear> beschechen.
<lb n="22"/><unclear cert="medium" resp="#joint">Deß</unclear> <placeName ref="stadtasg-places-84" cert="medium" resp="#ner">Langen</placeName>, <unclear cert="medium" resp="#joint">wÿb</unclear>, <persName resp="#ner"><unclear cert="medium" resp="#joint">Barbel</unclear> Schlipfferin</persName> <unclear cert="low" resp="#joint">vonn</unclear>
<lb n="23"/><placeName ref="stadtasg-places-8" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Appzell</unclear></placeName>, die <unclear cert="medium" resp="#joint">sÿe</unclear>, <unclear cert="medium" resp="#joint">nur</unclear> <unclear cert="medium" resp="#joint">zwen</unclear> tag, <unclear cert="medium" resp="#joint">eher</unclear> sy <unclear cert="low" resp="#joint">gen</unclear>
<lb n="24"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sanntgallen</unclear></placeName> <unclear cert="low" resp="#joint">khomen</unclear>, mit Inen <unclear cert="medium" resp="#joint">gezogen</unclear>. und <unclear cert="low" resp="#joint">vonn</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">keinem</unclear> <unclear cert="low" resp="#joint">diebstal</unclear>, <unclear cert="low" resp="#joint">gewüßt</unclear>, noch <unclear cert="medium" resp="#joint">geholffen</unclear> sonder aller-
<lb n="26"/><unclear cert="low" resp="#joint">dings</unclear>, <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">vnschuldig</unclear> <unclear cert="low" resp="#joint">seÿe</unclear> <unclear cert="low" resp="#joint">etc</unclear>. Waß dann
<lb n="27"/>die <unclear cert="medium" resp="#joint">vßage</unclear>, <unclear cert="medium" resp="#joint">aineß</unclear>. <unclear cert="medium" resp="#joint">driten</unclear> gefangnen, so <persName resp="#ner"><unclear cert="medium" resp="#joint">Jerg</unclear> <unclear cert="medium" resp="#joint">Strab</unclear></persName>
<lb n="28"/><unclear cert="medium" resp="#joint">vonn</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Stuotgart</unclear></placeName> <unclear cert="medium" resp="#joint">sich</unclear> <unclear cert="medium" resp="#joint">nennt</unclear>, <unclear cert="medium" resp="#joint">vff</unclear> <unclear cert="medium" resp="#joint">zwÿen</unclear> <unclear cert="medium" resp="#joint">vnbekannt</unclear>,
<pb facs="StadtASG_Missive_2038_7610.jpg" n="2"/>
<lb n="29"/>der ist eines gassenschreiers, <persName resp="#ner">Johanes Dunckel</persName>, vonn
<lb n="30"/><placeName ref="stadtasg-places-112" cert="medium" resp="#ner">Straßburg</placeName> buertig, aber begangnen thodtschlags wiches
<lb n="31"/>vonn dannen jnns <placeName resp="#ner">Seüwrland</placeName> gehn <placeName resp="#ner">Aschaffenhoffen</placeName>
<lb n="32"/>gesetzt, jnn wolcher dienst vor runder zeit, selbiger
<lb n="33"/>sin her uffs Morden gethon, diser sambt andern
<lb n="34"/>mittknecht die erschlagne körpel jnns gestüdt
<lb n="35"/>verziechen muessen. Diser gassenschreier ziche
<lb n="36"/>denn fürnembste stett und marckt nach. Habe
<lb n="37"/>meermals zweü schöne pferd zu reiten, ein gutsch.
<lb n="38"/>fuere mit sich ein mentschen, sÿe jung und rach,
<lb n="39"/>von leib, wol bekleidet und bÿ geldt, aber
<lb n="40"/>mit faltschen truglichen wahr umbgange, und
<lb n="41"/>vil leuet hin und wider mit zerung uffschlahe,
<lb n="42"/>diß und mehrers weurdt und khann Meister <persName resp="#ner">Hanns</persName>
<lb n="43"/>die heren selbst auch berichten. Deßwegen ein
<lb n="44"/>uffsehen und vermerckens zu haben, thundt
<lb n="45"/>hierueber E. F. E. W. widerum ersuchen, bemelten
<lb n="46"/>M. <persName resp="#ner">Hans</persName> nachrichtern mit erlouptnuß abzu-
<lb n="47"/>ferckigen, daß er <date resp="#ner">kuenfftigen montag</date>, früeher
<lb n="48"/>glegenheit sich alhie jnnstelle, mitt denn ge-
<lb n="49"/>fangnen rechtlich zu procediren, wie wir denn
<lb n="50"/>denn rechts tag, uff <date resp="#ner">zinstag denn 7 diß</date>, anbe-
<lb n="51"/>stimpt haben. Thunt hiruober E. F. E. W.
<lb n="52"/>jnn goettliche protection wol bevolchen. Datt.
<lb n="53"/><origPlace ref="stadtasg-places-88" cert="medium" resp="#ner">Reinegk</origPlace>. <origDate when="1617-01-04" resp="#ner">Denn 4. januarij. Anno. 1617.</origDate>
<lb n="54"/><persName role="issuer" resp="#ner">Sebastian Alther</persName> deß raths
<lb n="55"/>ußer roden deß landts <placeName ref="stadtasg-places-8" cert="medium" resp="#ner">Appzell</placeName>,
<lb n="56"/>landtvogt jnn und ußeren
<lb n="57"/><placeName resp="#ner">Reinthall</placeName>.
<pb facs="StadtASG_Missive_2038_7611.jpg" n="3"/>
<pb facs="StadtASG_Missive_2038_7612.jpg" n="4"/>
<lb n="58"/><unclear cert="medium" resp="#joint">Denen</unclear> Edlen, <unclear cert="medium" resp="#joint">strengen</unclear>, ehrnvesten, frommen, <unclear cert="low" resp="#joint">fuer</unclear>-
<lb n="59"/><unclear cert="low" resp="#joint">sichtigen</unclear>, <unclear cert="low" resp="#joint">weysen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">Rhat</unclear>
<lb n="60"/>der Statt Sant Gallen</orgName>, <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">besonders</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">guenstigen</unclear> herren <unclear cert="low" resp="#joint">etc</unclear>.
