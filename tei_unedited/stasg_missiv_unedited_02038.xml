<p>
<pb facs="StadtASG_Missive_2038_7609.jpg" n="1"/>
<lb n="1"/>Edel from <unclear cert="medium" resp="#joint">eervest</unclear> <unclear cert="medium" resp="#joint">fürnem</unclear> fürsichtig wyß, <unclear cert="medium" resp="#joint">innbe</unclear>-
<lb n="2"/><unclear cert="medium" resp="#joint">sondere</unclear>, <unclear cert="medium" resp="#joint">günstige</unclear> herren <unclear cert="low" resp="#joint">nachparn</unclear>, <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">syen</unclear>, unser
<lb n="3"/><unclear cert="low" resp="#joint">früntlich</unclear> <unclear cert="medium" resp="#joint">guotwillige</unclear> dienst zuvor etc.
<lb n="4"/><unclear cert="low" resp="#joint">Gegennt</unclear> <unclear cert="low" resp="#joint">wurts</unclear>, waß die <unclear cert="low" resp="#joint">bede</unclear>, <unclear cert="low" resp="#joint">alhieige</unclear> <unclear cert="low" resp="#joint">bestrikte</unclear>,
<lb n="5"/><unclear cert="low" resp="#joint">persohnen</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Balthas</unclear> <unclear cert="low" resp="#joint">Heÿder</unclear></persName>, von <placeName ref="stadtasg-places-227" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Vläningen</unclear></placeName>, ein <unclear cert="low" resp="#joint">spill</unclear>-
<lb n="6"/>man, und <persName resp="#ner">Hans <unclear cert="low" resp="#joint">Hürte</unclear></persName>, oder <unclear cert="low" resp="#joint">Hünd</unclear>, <unclear cert="low" resp="#joint">usß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">pundt</unclear>,
<lb n="7"/>von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Castels</unclear></placeName>, <unclear cert="low" resp="#joint">usßgesagt</unclear>, ist <unclear cert="low" resp="#joint">umbstantzlich</unclear> nit <unclear cert="medium" resp="#joint">merers</unclear>,
<lb n="8"/>dann waß die <unclear cert="low" resp="#joint">stoeeß</unclear>, und <unclear cert="low" resp="#joint">lermen</unclear>, mit wort und
<lb n="9"/><unclear cert="low" resp="#joint">werkhen</unclear>, inn <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName> vorstatt, <unclear cert="low" resp="#joint">vorloffen</unclear>, nit ab,
<lb n="10"/>sonder <unclear cert="low" resp="#joint">gstanndig</unclear> <unclear cert="low" resp="#joint">seÿen</unclear>, solches <unclear cert="low" resp="#joint">muotwils</unclear>, der <unclear cert="low" resp="#joint">völle</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">wy</unclear>. und <unclear cert="low" resp="#joint">trunkenheit</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">gebend</unclear>, die <unclear cert="low" resp="#joint">wÿber</unclear>.
<lb n="12"/>belangende, alß deß uß dem <unclear cert="low" resp="#joint">pundt</unclear>. <persName resp="#ner">Anna Maria
<lb n="13"/><unclear cert="low" resp="#joint">Schmidin</unclear></persName>, habe <unclear cert="medium" resp="#joint">vonn</unclear> begangnen, <unclear cert="medium" resp="#joint">beider</unclear> <unclear cert="medium" resp="#joint">Mannen</unclear>.
<lb n="14"/><unclear cert="medium" resp="#joint">diebstäl</unclear> nichts <unclear cert="low" resp="#joint">gewüßt</unclear>, dann, von einem <unclear cert="low" resp="#joint">buochkessel</unclear>,
<lb n="15"/>sy <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Bischoffzell</unclear></placeName>, <unclear cert="low" resp="#joint">denn</unclear>, armen siechen, <unclear cert="low" resp="#joint">enntwend</unclear>
