<lb n="31"/><unclear cert="low" resp="#joint">vonn</unclear> dannen <unclear cert="medium" resp="#joint">jnns</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Seüwrland</unclear></placeName> <unclear cert="medium" resp="#joint">gehn</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Aschaffenhoffen</unclear></placeName>
