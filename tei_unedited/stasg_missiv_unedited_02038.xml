<lb n="35"/><unclear cert="low" resp="#joint">verziechen</unclear> <unclear cert="low" resp="#joint">muessen</unclear>. Diser <unclear cert="low" resp="#joint">gassenschreier</unclear> <unclear cert="low" resp="#joint">ziche</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">denn</unclear> <unclear cert="low" resp="#joint">fürnembste</unclear> <unclear cert="low" resp="#joint">stett</unclear> und <unclear cert="medium" resp="#joint">marckt</unclear> nach. <unclear cert="low" resp="#joint">Habe</unclear>
