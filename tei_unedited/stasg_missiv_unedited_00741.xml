<p>
<pb facs="StadtASG_Missive_741_1883.JPG" n="1"/>
<lb n="1"/>Wir der <orgName ref="stadtasg-actors-506" cert="medium" role="issuer" resp="#ner">landtaman und ratt <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">Appennzell</unclear></orgName> <unclear cert="medium" resp="#joint">tund</unclear> khund
