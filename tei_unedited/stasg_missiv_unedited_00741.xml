<lb n="8"/><unclear cert="medium" resp="#joint">laßenn</unclear>, <unclear cert="medium" resp="#joint">meldemt</unclear> wie das sy, <unclear cert="medium" resp="#joint">gegenn</unclear> den ersamen <persName resp="#ner"><unclear cert="medium" resp="#joint">Hansen</unclear>
