        <body>
<p>
<pb facs="StadtASG_Missive_1942_7227.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründt</unclear>- nachbarlich willig dienst und grueß
<lb n="2"/><unclear cert="medium" resp="#joint">zuevor</unclear>, Edler, Vester, insonders <unclear cert="medium" resp="#joint">lieber</unclear> <unclear cert="medium" resp="#joint">herr</unclear> <unclear cert="medium" resp="#joint">Vogt</unclear>,
<lb n="3"/>gueter <unclear cert="medium" resp="#joint">fründ</unclear> und nachbar.
<lb n="4"/>Wegen <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">bewußten</unclear> <unclear cert="medium" resp="#joint">geschaefts</unclear>, so sich noch <unclear cert="medium" resp="#joint">uner</unclear>-
<lb n="5"/><unclear cert="medium" resp="#joint">oertert</unclear> <unclear cert="medium" resp="#joint">haltet</unclear>, <unclear cert="medium" resp="#joint">enzwüschet</unclear> <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">verordneten</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">schuelherren</unclear>, an <unclear cert="medium" resp="#joint">einem</unclear>, so <unclear cert="medium" resp="#joint">denne</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Vt</unclear>. <unclear cert="medium" resp="#joint">ampts</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">angehoerigen</unclear>, <orgName ref="stadtasg-actors-102" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Stattaman</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear> <unclear cert="medium" resp="#joint">zue</unclear> Arbon</orgName>,
<lb n="8"/>an dem <unclear cert="medium" resp="#joint">anderen</unclear> <unclear cert="medium" resp="#joint">theil</unclear>, sol <unclear cert="medium" resp="#joint">üwer</unclear> auch <unclear cert="medium" resp="#joint">amptsan</unclear>-
<lb n="9"/><unclear cert="medium" resp="#joint">gehoeriger</unclear> <persName resp="#ner">Martin <unclear cert="low" resp="#joint">Strauß</unclear></persName>, <unclear cert="low" resp="#joint">imnamen</unclear> <unclear cert="low" resp="#joint">sein-selbst</unclear>,
<lb n="10"/>und <unclear cert="low" resp="#joint">andrer</unclear> <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">mithaften</unclear>, abermals <unclear cert="medium" resp="#joint">etwas</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">mittel</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">guetlicher</unclear> vergleichung diser sachen
<lb n="12"/><unclear cert="low" resp="#joint">anbieten</unclear>, und sonderlich under <unclear cert="medium" resp="#joint">anderem</unclear> sich
<lb n="13"/>auch <unclear cert="medium" resp="#joint">vernemmen</unclear> haben lassen, was hierinnen
<lb n="14"/><unclear cert="medium" resp="#joint">accordiert</unclear> und verglichen werden <unclear cert="medium" resp="#joint">moechte</unclear>, <unclear cert="medium" resp="#joint">daß</unclear>
<lb n="15"/>für solches <unclear cert="medium" resp="#joint">ermelte</unclear> <unclear cert="medium" resp="#joint">Stattaman</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear> gegen
<lb n="16"/><unclear cert="medium" resp="#joint">ermelten</unclear> <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">schuelherren</unclear> <unclear cert="medium" resp="#joint">guet</unclear> seyn, und
<lb n="17"/><unclear cert="medium" resp="#joint">sich</unclear> <unclear cert="medium" resp="#joint">verschreiben</unclear> <unclear cert="medium" resp="#joint">werdte</unclear>.
<lb n="18"/><unclear cert="medium" resp="#joint">Sidmalen</unclear> dann <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">schuelherren</unclear> die sach
<lb n="19"/><unclear cert="medium" resp="#joint">gerne</unclear> <unclear cert="medium" resp="#joint">zue</unclear> einer <unclear cert="medium" resp="#joint">endtschaft</unclear> <unclear cert="medium" resp="#joint">braechten</unclear>, so <unclear cert="medium" resp="#joint">gelangt</unclear>
<lb n="20"/>an <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Vt</unclear>. unser <unclear cert="medium" resp="#joint">fründt</unclear>- nachbarliches ge-
<lb n="21"/><unclear cert="medium" resp="#joint">sinnen</unclear>, die welle, (so es mit dero <unclear cert="medium" resp="#joint">gueter</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">gelegenheit</unclear> geschehen kan,) <unclear cert="medium" resp="#joint">ihro</unclear> <unclear cert="medium" resp="#joint">unbeschwerdt</unclear> <unclear cert="medium" resp="#joint">Mit</unclear>-
<lb n="23"/><unclear cert="medium" resp="#joint">wuch</unclear> <unclear cert="medium" resp="#joint">nechsten</unclear>, den <date resp="#ner">10. <unclear cert="low" resp="#joint">20</unclear>. <unclear cert="low" resp="#joint">nechsteingehenden</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">monats</unclear> <unclear cert="low" resp="#joint">Maji</unclear></date> <unclear cert="low" resp="#joint">zue</unclear> disem <unclear cert="medium" resp="#joint">geschaeft</unclear> <unclear cert="medium" resp="#joint">belieben</unclear>
<lb n="25"/>lassen, und nit allein von <unclear cert="medium" resp="#joint">oberkeit</unclear> wegen
<lb n="26"/>der handlung in <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">persohn</unclear> <unclear cert="medium" resp="#joint">beywohnen</unclear>,
<lb n="27"/>sondern auch günstig verschaffen, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">dannzumal</unclear> <unclear cert="low" resp="#joint">Stattaman</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear>, <unclear cert="medium" resp="#joint">wie</unclear>
<lb n="29"/>auch <unclear cert="medium" resp="#joint">gemelter</unclear> Strauß und <unclear cert="medium" resp="#joint">mithafte</unclear>, nach
<lb n="30"/><unclear cert="medium" resp="#joint">notturft</unclear> <unclear cert="medium" resp="#joint">verfast</unclear>, <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Vt</unclear>. im <unclear cert="medium" resp="#joint">schloß</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">erscheinen</unclear>: so <unclear cert="medium" resp="#joint">werden</unclear> die <unclear cert="medium" resp="#joint">anwaeld</unclear> von
<lb n="32"/><unclear cert="medium" resp="#joint">unserem</unclear> <unclear cert="medium" resp="#joint">schuelraht</unclear> sich <unclear cert="medium" resp="#joint">gleichs</unclear> <unclear cert="medium" resp="#joint">fahls</unclear> <unclear cert="medium" resp="#joint">auf</unclear>
<pb facs="StadtASG_Missive_1942_7228.jpg" n="2"/>
<lb n="33"/>yustellen, und versuchen, ob man guetigklich
<lb n="34"/>verglichen werden möcht; Im fall nun
<lb n="35"/>solches <unclear cert="low" resp="#joint">ervolgt</unclear>, so wirt es darbey
<lb n="36"/>verwanden. Da es aber nit möglich,
<lb n="37"/>und man den unseren mit so schlechten mitlen
<lb n="38"/>oder conditionen wurde begegnen, daß sie
<lb n="39"/>es nit köunten annemmen: So gelangt
<lb n="40"/>hiemit an E. Vht. abermals unser freündt-
<lb n="41"/>nachbarliches bitten, dieweil man vor
<lb n="42"/>disem umb Recht wider Stattamman und
<lb n="43"/>Raht diser sach halber inständig angehalten,
<lb n="44"/>E. Vht. welle demselben seinen lauff vol-
<lb n="45"/>gends ohne weittere verlengerung lassen,
<lb n="46"/>und deßwegen den unseren den Richter
<lb n="47"/>zeit und malstatt hürzu zeigen, da-
<lb n="48"/>mit <unclear cert="low" resp="#joint">man</unclear> demselben hernach gebürlich nachzu-
<lb n="49"/>setzen wüssen möge.
<lb n="50"/>Is aber der obangedütete <date resp="#ner">10/20. tag Maij</date> E. Vht.
<lb n="51"/>hürzu nit bequem, wie wir dann dero hiemit
<lb n="52"/>nit wellend fürgeschriben haben, so geliebe
<lb n="53"/>dero, den darauff <date resp="#ner">nechstvolgenden Montag
<lb n="54"/>oder Mitwochen</date> (so es sein kan) <unclear cert="low" resp="#joint">hür</unclear>-
<lb n="55"/>(.<unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">nach</unclear>- zu zubestimmen, und uns <unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">schrifftlich</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">richtung</unclear>.) widerumb zuberichten.
<lb n="57"/>Das alles begeren wir umb E. Vht. nach
<lb n="58"/>begebenheit gantz willigklich <unclear cert="low" resp="#joint">zuverdienen</unclear>.
<lb n="59"/><unclear cert="low" resp="#joint">Gottes</unclear> obhalt uns samentlich wol be-
<lb n="60"/>velhende. Dat. <origDate when="1615" resp="#ner">14. <unclear cert="low" resp="#joint">d</unclear>. Aprilis <unclear cert="low" resp="#joint">Ao</unclear> <unclear cert="low" resp="#joint">1615</unclear></origDate>.
<lb n="61"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">B</unclear>. und Rht</orgName>
<lb n="62"/>Dem Edlen Vesten <unclear cert="low" resp="#joint">Hauptman</unclear> <persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Bernhard</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">Bodmern</unclear></persName>, <unclear cert="low" resp="#joint">Bischöffl</unclear>. <placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Cost</unclear>.</placeName> <unclear cert="low" resp="#joint">Raht</unclear> und Obervogt zu <placeName ref="stadtasg-places-5" cert="medium" resp="#ner">Arbon</placeName>
<lb n="64"/>unserem sonders lieben herren gueten freünd und Nachbarn.
<pb facs="StadtASG_Missive_1942_7229.jpg" n="3"/>
<pb facs="StadtASG_Missive_1942_7230.jpg" n="4"/>
<lb n="65"/>[]
</p>
