    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1466_5257.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unßer</unclear> <unclear cert="medium" resp="#joint">freundtlich</unclear> willig dienßt
<lb n="2"/><unclear cert="medium" resp="#joint">zuvor</unclear>, ersamen und <unclear cert="low" resp="#joint">weyßen</unclear>, be-
<lb n="3"/><unclear cert="low" resp="#joint">sondere</unclear> lieben und <unclear cert="low" resp="#joint">guetten</unclear> freundt.
<lb n="4"/><unclear cert="low" resp="#joint">Unß</unclear> hat <unclear cert="low" resp="#joint">unßers</unclear> <unclear cert="medium" resp="#joint">burgers</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Goergen</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">Gruenenburgs</unclear></persName> sohn, <persName resp="#ner">Hannß <unclear cert="low" resp="#joint">Gruenen</unclear>-
<lb n="6"/><unclear cert="medium" resp="#joint">burg</unclear></persName>, sporer handtwercks, sambt
<lb n="7"/><unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">beiständen</unclear>, <persName resp="#ner"><unclear cert="medium" resp="#joint">Sebastian</unclear> <unclear cert="medium" resp="#joint">Jägern</unclear></persName>,
<lb n="8"/><persName resp="#ner"><unclear cert="low" resp="#joint">Matheiß</unclear> Schwarz</persName> <unclear cert="low" resp="#joint">genambt</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Schindlin</unclear></persName>, unnd
<lb n="9"/><persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Vewen</unclear></persName>, angebracht, wie sy in
<lb n="10"/><unclear cert="low" resp="#joint">erfahrung</unclear> komen, das in e. e. <unclear cert="low" resp="#joint">wß</unclear>.
<lb n="11"/>statt, an einem <unclear cert="medium" resp="#joint">sporer</unclear> <unclear cert="medium" resp="#joint">mangel</unclear> <unclear cert="medium" resp="#joint">seie</unclear>,
<lb n="12"/>und einer, so desselbigen handtwercks
<lb n="13"/>kundig und <unclear cert="low" resp="#joint">erfahren</unclear>, sich auch <unclear cert="medium" resp="#joint">redlich</unclear>
<lb n="14"/>und wol verhallten, <unclear cert="low" resp="#joint">daselbs</unclear> <unclear cert="low" resp="#joint">wol</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">zuekhomen</unclear> <unclear cert="low" resp="#joint">möechte</unclear>, da dann er <persName resp="#ner">Hannß
<lb n="16"/><unclear cert="low" resp="#joint">Gruenenburg</unclear></persName> <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">anlaß</unclear> und ver-
<lb n="17"/><unclear cert="low" resp="#joint">trößtung</unclear> gegen ihme beschehen, ver-
<lb n="18"/>merckht, <unclear cert="low" resp="#joint">welchen</unclear> nach, sy <unclear cert="medium" resp="#joint">verursacht</unclear>
<lb n="19"/>worden, für <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">zuekheren</unclear>, und <unclear cert="medium" resp="#joint">unnß</unclear>
<lb n="20"/>umb <unclear cert="low" resp="#joint">interceßion</unclear>, <unclear cert="low" resp="#joint">seinethalben</unclear>, <unclear cert="low" resp="#joint">geg</unclear>
<lb n="21"/>e. e. <unclear cert="medium" resp="#joint">wß</unclear>. anzuerueffen, mit dem ver-
<lb n="22"/><unclear cert="medium" resp="#joint">melden</unclear>, wafern <unclear cert="medium" resp="#joint">dieselben</unclear>, an <unclear cert="medium" resp="#joint">ihne</unclear>
<lb n="23"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Gruenenburger</unclear></persName>, seines <unclear cert="medium" resp="#joint">handtwerckhs</unclear>,
<lb n="24"/><unclear cert="medium" resp="#joint">od</unclear> <unclear cert="medium" resp="#joint">verprechenden</unclear> <unclear cert="medium" resp="#joint">arbaith</unclear> halben,
<lb n="25"/>etwas <unclear cert="medium" resp="#joint">burgschafft</unclear> begeren <unclear cert="low" resp="#joint">sollten</unclear>,
<lb n="26"/>sy <unclear cert="low" resp="#joint">drej</unclear>, <unclear cert="medium" resp="#joint">der</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Jäger</unclear></persName>, <persName resp="#ner"><unclear cert="medium" resp="#joint">Schwarz</unclear></persName> und <persName resp="#ner"><unclear cert="low" resp="#joint">Vewe</unclear></persName>,
<lb n="27"/>sambt und <unclear cert="medium" resp="#joint">sonders</unclear>, für <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">einstehen</unclear>
<lb n="28"/>wollten. <unclear cert="low" resp="#joint">Unß</unclear> demnach <unclear cert="low" resp="#joint">under</unclear>-
<lb n="29"/>thenig und fleißig <unclear cert="medium" resp="#joint">angerueffen</unclear>,
<pb facs="StadtASG_Missive_1466_5258.jpg" n="2"/>
<lb n="30"/>wir <unclear cert="medium" resp="#joint">wollten</unclear> <unclear cert="medium" resp="#joint">ihme</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Gaunenbuerg</unclear></persName> <unclear cert="low" resp="#joint">zue</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">guetem</unclear> mit unnser <unclear cert="medium" resp="#joint">fuerschrifft</unclear>, an E. E.
<lb n="32"/><unclear cert="medium" resp="#joint">Wßh</unclear>. willfährig erschinen, <unclear cert="low" resp="#joint">guetter</unclear>
<lb n="33"/>hoffnung derselben <unclear cert="low" resp="#joint">fruechtbarlich</unclear> <unclear cert="low" resp="#joint">zuege</unclear>-
<lb n="34"/><unclear cert="low" resp="#joint">niessen</unclear>.
<lb n="35"/>Wann wir dann die unnsern, zue aller
<lb n="36"/><unclear cert="medium" resp="#joint">wolfahrt</unclear>, unnd <unclear cert="low" resp="#joint">guetem</unclear> <unclear cert="low" resp="#joint">zueverhelffen</unclear> nit
<lb n="37"/>weniger genaigt alls schuldig, unnd wir
<lb n="38"/>nit anderst <unclear cert="medium" resp="#joint">wissen</unclear>, dann <unclear cert="medium" resp="#joint">das</unclear> sich gemeld
<lb n="39"/><persName resp="#ner">Hanß <unclear cert="low" resp="#joint">Gaunenbuerg</unclear></persName> von <unclear cert="medium" resp="#joint">jugendt</unclear> <unclear cert="medium" resp="#joint">auff</unclear>, <unclear cert="medium" resp="#joint">frömb</unclear>-
<lb n="40"/>lich und redlich <unclear cert="medium" resp="#joint">gehallten</unclear>, unnd <unclear cert="medium" resp="#joint">er</unclear> sein
<lb n="41"/><unclear cert="medium" resp="#joint">handtwerckh</unclear> wol <unclear cert="low" resp="#joint">erlehnet</unclear>, haben wir
<lb n="42"/>ihme die <unclear cert="low" resp="#joint">gebettne</unclear> <unclear cert="medium" resp="#joint">fuerschrifft</unclear> nit <unclear cert="low" resp="#joint">verwaigrn</unclear>
<lb n="43"/>noch abschlagen mögen.
<lb n="44"/>Und gelangt demnach an <unclear cert="medium" resp="#joint">dieselben</unclear> <unclear cert="medium" resp="#joint">unnser</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">frueundtlich</unclear> und nachbarlich <unclear cert="medium" resp="#joint">pitten</unclear>, Sy
<lb n="46"/><unclear cert="low" resp="#joint">wellen</unclear> ihnen <unclear cert="medium" resp="#joint">disen</unclear> unnsern buerger, <persName resp="#ner"><unclear cert="medium" resp="#joint">Hansen</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">Gaunenbuerg</unclear></persName> umb <unclear cert="low" resp="#joint">vorberueerter</unclear> ursachen,
<lb n="48"/>wie auch seiner beystennden, und dero, im
<lb n="49"/>faal von <unclear cert="low" resp="#joint">nöten</unclear>, <unclear cert="low" resp="#joint">angebottner</unclear> <unclear cert="low" resp="#joint">buergschafft</unclear>,
<lb n="50"/>auch diser unnser ihme <unclear cert="low" resp="#joint">wolgemaintten</unclear>
<lb n="51"/>fuerschrifft willen, in <unclear cert="low" resp="#joint">guenstigen</unclear> <unclear cert="medium" resp="#joint">bevelch</unclear>
<lb n="52"/>hallten, und <unclear cert="medium" resp="#joint">ine</unclear>, vor <unclear cert="low" resp="#joint">anndern</unclear>, <unclear cert="low" resp="#joint">ußerer</unclear>
<lb n="53"/><unclear cert="medium" resp="#joint">handtwerckhs</unclear>, bey <unclear cert="medium" resp="#joint">ihnen</unclear> zue: und ein-
<lb n="54"/><unclear cert="low" resp="#joint">kommen</unclear> lassen. <unclear cert="low" resp="#joint">Zwifflen</unclear> wir nitt,
<lb n="55"/>er werde sich in seim <unclear cert="medium" resp="#joint">handtwerckh</unclear>,
<lb n="56"/>thun und wäsen, zue E. E. <unclear cert="low" resp="#joint">Wßh</unclear>. und <unclear cert="medium" resp="#joint">dero</unclear>
<lb n="57"/>gemainer <unclear cert="low" resp="#joint">buergerschafft</unclear>, <unclear cert="medium" resp="#joint">guenstigen</unclear> und
<lb n="58"/><unclear cert="medium" resp="#joint">gueten</unclear> belieben verhallten.
<pb facs="StadtASG_Missive_1466_5259.jpg" n="3"/>
<lb n="59"/><unclear cert="low" resp="#joint">les</unclear> begeren Eer. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. wir
<lb n="60"/><unclear cert="low" resp="#joint">hinwider</unclear> <unclear cert="low" resp="#joint">freundt</unclear>. <unclear cert="low" resp="#joint">unnd</unclear> Nachbarlich
<lb n="61"/>zuoverdienen, dieselben unnd uns alle,
<lb n="62"/><unclear cert="low" resp="#joint">Goettlichem</unclear> schirmb bevelchendt. <unclear cert="low" resp="#joint">Dath</unclear>
<lb n="63"/><origDate when="1604-11-09" resp="#ner">9. Novembris. <unclear cert="medium" resp="#joint">Ao</unclear>. <unclear cert="medium" resp="#joint">1604</unclear></origDate>.
<lb n="64"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermaister unnd <unclear cert="low" resp="#joint">Rha</unclear>
<lb n="65"/>der Statt <unclear cert="medium" resp="#joint">Lindaw</unclear></orgName>.
<pb facs="StadtASG_Missive_1466_5260.jpg" n="4"/>
<lb n="66"/>Den ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="67"/>und <unclear cert="low" resp="#joint">Rhat</unclear> der Statt St. Gallen</orgName>, unsern
<lb n="68"/>besondern lieben und gueten <unclear cert="low" resp="#joint">freunden</unclear>.
<lb n="69"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>.
</p>
