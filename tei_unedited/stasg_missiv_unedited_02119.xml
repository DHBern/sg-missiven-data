        <body>
<p>
<pb facs="StadtASG_Missive_2119_7937.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">fründtlich</unclear> willig <unclear cert="medium" resp="#joint">dinst</unclear> zuvor, fürsichtig, <unclear cert="medium" resp="#joint">ehrsamen</unclear> und <unclear cert="medium" resp="#joint">weiße</unclear>
<lb n="2"/>besonders <unclear cert="medium" resp="#joint">liebe</unclear> und guotte fründt,
<lb n="3"/>Wir haben derselben schreiben den <date resp="#ner">5 diß</date> datiert, empfangen, auch
<lb n="4"/>die <unclear cert="medium" resp="#joint">dabej</unclear> mündtlich abgelegte werbung <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">schifflöhnen</unclear> <unclear cert="medium" resp="#joint">halber</unclear> von
<lb n="5"/><unclear cert="medium" resp="#joint">hinn</unclear> nach <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Costantz</placeName> und <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schafhaußen</unclear></placeName>, <unclear cert="medium" resp="#joint">vernomen</unclear>, <unclear cert="medium" resp="#joint">darauff</unclear> <unclear cert="medium" resp="#joint">thun</unclear> wir
<lb n="6"/><unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Ft</unclear>. hiemit berichten, <unclear cert="medium" resp="#joint">sovill</unclear> <unclear cert="medium" resp="#joint">erstlich</unclear>, die <unclear cert="medium" resp="#joint">schiffarthe</unclear> von <unclear cert="medium" resp="#joint">hinn</unclear> <unclear cert="medium" resp="#joint">nache</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">Costanz</unclear>. <unclear cert="medium" resp="#joint">betrifft</unclear> hat die <orgName ref="stadtasg-actors-56" cert="medium" resp="#ner">Statt Costantz</orgName> nach der zeit, <unclear cert="medium" resp="#joint">Irer</unclear> <unclear cert="medium" resp="#joint">ordinari</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">schiffleüth</unclear>, welche <unclear cert="medium" resp="#joint">wochentlich</unclear> <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">was</unclear> von <unclear cert="medium" resp="#joint">dannen</unclear> <unclear cert="medium" resp="#joint">hiher</unclear>, und
<lb n="9"/>von <unclear cert="medium" resp="#joint">hinen</unclear> <unclear cert="medium" resp="#joint">hinab</unclear> <unclear cert="medium" resp="#joint">geschifft</unclear> <unclear cert="medium" resp="#joint">würdt</unclear>, <unclear cert="medium" resp="#joint">verfihren</unclear>, welches <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">disortig</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">bißher</unclear>, <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">praeiudicirlich</unclear>, <unclear cert="low" resp="#joint">zugelaßen</unclear>, und Inen keinen <unclear cert="medium" resp="#joint">sondern</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">intrag</unclear> gethan, außer <unclear cert="medium" resp="#joint">was</unclear> <unclear cert="medium" resp="#joint">etwan</unclear>, an <unclear cert="medium" resp="#joint">Jarmärkhten</unclear>, oder sonsten
<lb n="12"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">Eil</unclear> <unclear cert="low" resp="#joint">guot</unclear> beschehen,
<lb n="13"/><unclear cert="medium" resp="#joint">Hiervon</unclear> haben sie <unclear cert="medium" resp="#joint">Iren</unclear> <unclear cert="medium" resp="#joint">bestimpten</unclear> <unclear cert="medium" resp="#joint">schiflohn</unclear>, wie <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Ft</unclear>. <unclear cert="medium" resp="#joint">sovill</unclear> die <unclear cert="medium" resp="#joint">kauff</unclear>-
<lb n="14"/><unclear cert="medium" resp="#joint">mans</unclear> <unclear cert="medium" resp="#joint">güetter</unclear> belangt, <unclear cert="medium" resp="#joint">ab</unclear> <unclear cert="medium" resp="#joint">mit</unclear> komender designation <unclear cert="medium" resp="#joint">zuersehen</unclear>,
<lb n="15"/>welcher <unclear cert="medium" resp="#joint">lohn</unclear> auch von <unclear cert="medium" resp="#joint">vilen</unclear> <unclear cert="medium" resp="#joint">Jahren</unclear> <unclear cert="medium" resp="#joint">hero</unclear> also <unclear cert="medium" resp="#joint">verbliben</unclear>, und unsers
<lb n="16"/>wißens in <unclear cert="medium" resp="#joint">neülicheit</unclear> nit <unclear cert="medium" resp="#joint">erhöht</unclear> <unclear cert="medium" resp="#joint">worden</unclear>, allein <unclear cert="medium" resp="#joint">sovill</unclear> den <unclear cert="medium" resp="#joint">wein</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">belanget</unclear>, hatt man Inen, wie sie zuvor vom <unclear cert="medium" resp="#joint">fuoder</unclear> 6 <unclear cert="medium" resp="#joint">batzen</unclear>
<lb n="18"/>gehabt, <unclear cert="medium" resp="#joint">bej</unclear> wenig <unclear cert="medium" resp="#joint">Jahren</unclear>, 30 <unclear cert="low" resp="#joint">kr</unclear> <unclear cert="low" resp="#joint">geordnet</unclear>, <unclear cert="low" resp="#joint">Betreffendt</unclear>
<lb n="19"/>aber <unclear cert="medium" resp="#joint">die</unclear> <orgName ref="stadtasg-actors-28" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schafhaußer</unclear></orgName> <unclear cert="medium" resp="#joint">schiffart</unclear>, haben <unclear cert="medium" resp="#joint">wir</unclear> alhie <unclear cert="low" resp="#joint">bestelte</unclear> <unclear cert="low" resp="#joint">schifleüt</unclear>
<lb n="20"/>auß <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">burgern</unclear>, <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">verfertigen</unclear>, auch alles <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">Jenige</unclear>
<lb n="21"/>was von <unclear cert="medium" resp="#joint">hinnen</unclear> <unclear cert="medium" resp="#joint">naher</unclear> <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schafhaußen</unclear></placeName> <unclear cert="medium" resp="#joint">verschifft</unclear> <unclear cert="medium" resp="#joint">würdt</unclear>, <unclear cert="medium" resp="#joint">a</unclear>
<lb n="22"/>von <unclear cert="medium" resp="#joint">Schafhaußen</unclear> wider <unclear cert="medium" resp="#joint">herwertz</unclear> haben sie <unclear cert="medium" resp="#joint">keine</unclear> <unclear cert="medium" resp="#joint">widerfur</unclear>
<lb n="23"/><unclear cert="medium" resp="#joint">sondern</unclear> <unclear cert="medium" resp="#joint">müßen</unclear> <unclear cert="medium" resp="#joint">lähr</unclear> <unclear cert="medium" resp="#joint">fahren</unclear>, und bezalt man <unclear cert="medium" resp="#joint">Inen</unclear> diser <unclear cert="medium" resp="#joint">zeit</unclear>
<lb n="24"/>die <unclear cert="low" resp="#joint">schifflön</unclear>, <unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">auß</unclear> obangeregter designation, welcher <unclear cert="medium" resp="#joint">lohn</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">aber</unclear> erst <unclear cert="medium" resp="#joint">bej</unclear> <unclear cert="medium" resp="#joint">ohngefar</unclear> <unclear cert="medium" resp="#joint">5</unclear> <unclear cert="medium" resp="#joint">Jaren</unclear>, <unclear cert="medium" resp="#joint">mit</unclear> <unclear cert="medium" resp="#joint">sowoll</unclear> <unclear cert="medium" resp="#joint">beeder</unclear> <unclear cert="medium" resp="#joint">orthen</unclear> <unclear cert="medium" resp="#joint">obrig</unclear>-
<lb n="26"/><unclear cert="medium" resp="#joint">keitlichem</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> auch der <unclear cert="medium" resp="#joint">kaufleüthen</unclear> <unclear cert="medium" resp="#joint">consens</unclear> also <unclear cert="medium" resp="#joint">taxiert</unclear>, und
<lb n="27"/><unclear cert="low" resp="#joint">erhöht</unclear>, <unclear cert="low" resp="#joint">uber</unclear> <unclear cert="low" resp="#joint">hievorigen</unclear> <unclear cert="low" resp="#joint">alten</unclear> <unclear cert="low" resp="#joint">lohn</unclear> <unclear cert="low" resp="#joint">auff</unclear> ein <unclear cert="low" resp="#joint">Saltzfaß</unclear>. <unclear cert="low" resp="#joint">3</unclear> <unclear cert="low" resp="#joint">kr</unclear>. <unclear cert="low" resp="#joint">1</unclear> <unclear cert="low" resp="#joint">schei</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">salz</unclear> <unclear cert="low" resp="#joint">1</unclear> <unclear cert="low" resp="#joint">kr</unclear>. <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">Zentner</unclear> <unclear cert="low" resp="#joint">kauffmansgutt</unclear> auch 1 <unclear cert="low" resp="#joint">kr</unclear>. <unclear cert="low" resp="#joint">nachfolgen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">Verfuhr</unclear> <unclear cert="low" resp="#joint">willen</unclear> <unclear cert="low" resp="#joint">geschlagen</unclear> <unclear cert="low" resp="#joint">worden</unclear>,
<pb facs="StadtASG_Missive_2119_7938.jpg" n="2"/>
<lb n="30"/><unclear cert="low" resp="#joint">Letstlich</unclear> <unclear cert="low" resp="#joint">dieweillen</unclear> <unclear cert="low" resp="#joint">Sewe</unclear> <unclear cert="low" resp="#joint">trieb</unclear>, <unclear cert="low" resp="#joint">so</unclear> woll beÿ gar kleinen, als auch gar
<lb n="31"/>zu grosten waser, man die <unclear cert="low" resp="#joint">wahren</unclear> <unclear cert="low" resp="#joint">überschlagen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">verschikhen</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">muoß</unclear>, <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Steimer</unclear> <unclear cert="low" resp="#joint">schifleüth</unclear>, welche diß ver-
<lb n="33"/>richten, sondern auch die jenige, welche man zum außlären, herumb
<lb n="34"/>schalten, stoßen, und andern der enden gebraucht, nit mehr deß
<lb n="35"/>alten lohns sich settigen laßen, sondern die schifleüth mit teglicher
<lb n="36"/>steigerung beschwerdt und Inen großen uncosten verursacht, darzu
<lb n="37"/>dan Eins vnder auch diß geschlagen, und ist nit die wenigste
<lb n="38"/>ursach der steigerung gewesten dz wier auß bewegenden ursachen
<lb n="39"/>auch vff anhalten, der kauffleüthen, einem Jeden schiff last
<lb n="40"/>30. vaß saltz schwer, an der ladung abgebrochen, die schiff geschicht
<lb n="41"/>sonderbare Nögell daran geschlagen, und Inen ordinantz geben,
<lb n="42"/>wie weil Jeder schiffman, sein schiff belästen solle, damit sie
<lb n="43"/><unclear cert="low" resp="#joint">auff</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">zufall</unclear> <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">sturmwinden</unclear>, mit minderer gefahr
<lb n="44"/><unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">komen</unclear> und den handelsleüthen, dz Irig, desto mehr
<lb n="45"/>gesichert seÿe, welche ordnung die kauffleüth Inen sonderlich
<lb n="46"/>woll belieben laßen, und darauff den schifleüthen umb solches
<lb n="47"/>abgangs deß gwicht obangedeüte beschwerdten und dan auch
<lb n="48"/>für dz drüebe und wmb deßen willen, daß sie <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">schifleüth</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">widerfuhre</unclear> auß <placeName ref="stadtasg-places-185" cert="medium" resp="#ner">Schafhausen</placeName>, entrathen, und mit lähren
<lb n="50"/>schiffen zu rugkh fahren mießen, Iren lohn mit eim wenigen
<lb n="51"/>wie obgemelt erhöht, zelaßen verwilliget, dabeÿ es bißhero
<lb n="52"/>mit menigkhlichs guettem Contento, verbleiben thuet, diß haben
<lb n="53"/>wir <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ft</unclear>. <unclear cert="low" resp="#joint">vff</unclear> Ir begern, berichten wellen, und verbleiben,
<lb n="54"/><unclear cert="low" resp="#joint">denselben</unclear> zu angenemen nachbarlichen <unclear cert="low" resp="#joint">diensten</unclear>, <unclear cert="low" resp="#joint">Jederzeit</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">beÿgethan</unclear> <unclear cert="low" resp="#joint">datum</unclear> <origDate when="1619-03-07" resp="#ner">7. Martij Ao 1619</origDate>
<lb n="56"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermeister und Raht
<lb n="57"/>der Statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_2119_7939.jpg" n="3"/>
<pb facs="StadtASG_Missive_2119_7940.jpg" n="4"/>
<lb n="58"/>Den <unclear cert="medium" resp="#joint">fuersichtigen</unclear>, ersamen und <unclear cert="medium" resp="#joint">weisen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="59"/>und <unclear cert="medium" resp="#joint">Rhat</unclear> der statt <unclear cert="medium" resp="#joint">sanct</unclear> Gallen</orgName>, unsern besondern
<lb n="60"/>lieben und <unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">freunden</unclear>.
</p>
