        <body>
<p>
<pb facs="StadtASG_Missive_1833_6801.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freundtlich</unclear> willig dienst zuvor,
<lb n="2"/><unclear cert="medium" resp="#joint">fuersichtigen</unclear>, ersamen, und <unclear cert="medium" resp="#joint">weisen</unclear>, be-
<lb n="3"/><unclear cert="low" resp="#joint">sondere</unclear> lieben, und gueten <unclear cert="low" resp="#joint">freundt</unclear>.
<lb n="4"/>Unß hat an <unclear cert="low" resp="#joint">heut</unclear> dato, in <unclear cert="medium" resp="#joint">unnserer</unclear> ge-
<lb n="5"/>woehnlichen rhatsversamblung, unnser
<lb n="6"/>burger, <persName resp="#ner"><unclear cert="low" resp="#joint">Hannß</unclear> <unclear cert="low" resp="#joint">Hiebel</unclear></persName>, <unclear cert="low" resp="#joint">hammerschmid</unclear> <unclear cert="low" resp="#joint">zuer</unclear>
<lb n="7"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Hammerschmiti</unclear></placeName>, <unclear cert="low" resp="#joint">negst</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">statt</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">gelegen</unclear>, neben <unclear cert="medium" resp="#joint">seinem</unclear> sohn <persName resp="#ner">Michael <unclear cert="low" resp="#joint">Hiebeln</unclear></persName>,
<lb n="9"/>und <persName resp="#ner"><unclear cert="medium" resp="#joint">Hainrich</unclear> <unclear cert="medium" resp="#joint">Gsellenn</unclear></persName>, E. E. W. <unclear cert="low" resp="#joint">burger</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">beistandt</unclear>, an- und fuergebracht.
<lb n="11"/><unclear cert="low" resp="#joint">Welchermaßen</unclear> bemelter sein <unclear cert="low" resp="#joint">Hannßen</unclear> sohn,
<lb n="12"/><persName resp="#ner">Michael</persName>, <unclear cert="medium" resp="#joint">einen</unclear> <unclear cert="medium" resp="#joint">anlaß</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">einem</unclear> <unclear cert="low" resp="#joint">heurat</unclear>
<lb n="13"/>mit E. E. W. <unclear cert="low" resp="#joint">burgers</unclear> <unclear cert="low" resp="#joint">dochter</unclear> <unclear cert="low" resp="#joint">ainer</unclear>,
<lb n="14"/>habe, und sich daselbsten <unclear cert="medium" resp="#joint">burgerlichen</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">einzuelassenn</unclear> willens. Dieweil er
<lb n="16"/>aber berichtet, das er <unclear cert="medium" resp="#joint">zue</unclear> seiner <unclear cert="low" resp="#joint">burgerlichen</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">einkommung</unclear> und <unclear cert="low" resp="#joint">verheurathung</unclear>, vor <unclear cert="medium" resp="#joint">ge</unclear>-
<lb n="18"/><unclear cert="low" resp="#joint">haltnen</unclear> <unclear cert="medium" resp="#joint">hochzeit</unclear>, 150 fl. in <unclear cert="low" resp="#joint">muentz</unclear>, an
<lb n="19"/><unclear cert="low" resp="#joint">bahrem</unclear> <unclear cert="medium" resp="#joint">gellt</unclear>, <unclear cert="medium" resp="#joint">aigens</unclear> <unclear cert="medium" resp="#joint">vermoegens</unclear>, <unclear cert="low" resp="#joint">ur</unclear>-
<lb n="20"/><unclear cert="low" resp="#joint">kundtlich</unclear> <unclear cert="low" resp="#joint">bescheinen</unclear> und <unclear cert="low" resp="#joint">dorthuen</unclear> <unclear cert="low" resp="#joint">mueße</unclear>.
<lb n="21"/><unclear cert="medium" resp="#joint">Allß</unclear> hat gedachter <unclear cert="low" resp="#joint">Hannß</unclear> <unclear cert="low" resp="#joint">Hiebel</unclear>, <unclear cert="low" resp="#joint">unnserm</unclear>
<lb n="22"/>lieben <unclear cert="low" resp="#joint">ambtsburgermaister</unclear>, <unclear cert="low" resp="#joint">inn</unclear> ge-
<lb n="23"/><unclear cert="low" resp="#joint">seßnem</unclear> <unclear cert="medium" resp="#joint">rhat</unclear>, in die handt <unclear cert="medium" resp="#joint">angelobt</unclear>
<lb n="24"/>und versprochen, das er nit <unclear cert="low" resp="#joint">allein</unclear> dem
<lb n="25"/><unclear cert="medium" resp="#joint">besagten</unclear> <persName resp="#ner">Michael <unclear cert="low" resp="#joint">Hiebeln</unclear></persName>, seinem sohn
<lb n="26"/><unclear cert="low" resp="#joint">diejenige</unclear> 150 fl., so er nach E. E. W.
<lb n="27"/><unclear cert="medium" resp="#joint">stattgebrauch</unclear>, <unclear cert="medium" resp="#joint">zum</unclear> <unclear cert="medium" resp="#joint">burgerlichen</unclear> <unclear cert="medium" resp="#joint">einkommen</unclear>
<lb n="28"/>soll und haben <unclear cert="medium" resp="#joint">mueß</unclear>, gleich nach <unclear cert="low" resp="#joint">erlangter</unclear>
<pb facs="StadtASG_Missive_1833_6802.jpg" n="2"/>
<lb n="29"/><unclear cert="medium" resp="#joint">burgerrechten</unclear>, an baßem wolle zuostath
<lb n="30"/>und <unclear cert="low" resp="#joint">bevelch</unclear> <unclear cert="low" resp="#joint">urkundt</unclear> siner <unclear cert="low" resp="#joint">ehelichen</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">geburt</unclear>, <unclear cert="low" resp="#joint">leibs</unclear> <unclear cert="low" resp="#joint">friheit</unclear> und <unclear cert="medium" resp="#joint">verhaltens</unclear>,
<lb n="32"/><unclear cert="medium" resp="#joint">zuo</unclear> handt <unclear cert="low" resp="#joint">zepringen</unclear>, <unclear cert="low" resp="#joint">soweyt</unclear> das auch
<lb n="33"/>vilbemelter <unclear cert="low" resp="#joint">sin</unclear> sohn, an künfftigem
<lb n="34"/><unclear cert="low" resp="#joint">sinem</unclear> <unclear cert="low" resp="#joint">verlaßnen</unclear> haab und <unclear cert="low" resp="#joint">gueth</unclear>,
<lb n="35"/>neben andern sinen <unclear cert="medium" resp="#joint">mitgeschewistrigten</unclear>,
<lb n="36"/>ein <unclear cert="low" resp="#joint">glicher</unclear> <unclear cert="medium" resp="#joint">miterb</unclear> <unclear cert="low" resp="#joint">sin</unclear> und <unclear cert="medium" resp="#joint">gellten</unclear> solle.
<lb n="37"/>Unß hierauf <unclear cert="low" resp="#joint">innammen</unclear> <unclear cert="low" resp="#joint">sines</unclear> sohns und,
<lb n="38"/><unclear cert="low" resp="#joint">thenig</unclear> ersuecht und gebetten, solches E.
<lb n="39"/>E. W. vermittelst unsers intercession
<lb n="40"/>schreibens, nachberlich zueberichten, und
<lb n="41"/>diselben dienstfreundtlich zeersuechen und
<lb n="42"/><unclear cert="low" resp="#joint">zebitten</unclear>, das E. E. W. solch sin anerbietn
<lb n="43"/>und versprechen für bekhanndt uff: und
<lb n="44"/><unclear cert="low" resp="#joint">annemmen</unclear> thuen.
<lb n="45"/><unclear cert="medium" resp="#joint">Wann</unclear> wir dann solch <unclear cert="medium" resp="#joint">begeren</unclear> nit für un-
<lb n="46"/><unclear cert="medium" resp="#joint">billich</unclear> gehalten, und unß <unclear cert="low" resp="#joint">sin</unclear> <persName resp="#ner">Hannß
<lb n="47"/><unclear cert="low" resp="#joint">Geibels</unclear></persName> (<unclear cert="low" resp="#joint">alls</unclear> eines wolbegüeteten
<lb n="48"/>manns) thuen und <unclear cert="medium" resp="#joint">wesen</unclear> wol <unclear cert="low" resp="#joint">bekhanndt</unclear>,
<lb n="49"/><unclear cert="medium" resp="#joint">daher</unclear> nit <unclear cert="medium" resp="#joint">zweifflen</unclear>, er werde sin ver-
<lb n="50"/>sprechen würckhlich hallten. <unclear cert="low" resp="#joint">Allso</unclear> haben
<lb n="51"/>wir <unclear cert="low" resp="#joint">sinem</unclear> <unclear cert="medium" resp="#joint">sohn</unclear> <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">gebetne</unclear> intercession
<lb n="52"/>an <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. billich nit <unclear cert="low" resp="#joint">verweign</unclear> noch
<lb n="53"/>abschlagen <unclear cert="low" resp="#joint">kuenden</unclear>.
<lb n="54"/>Ist demnach an dieselben unser dienst:
<lb n="55"/><unclear cert="low" resp="#joint">fründt</unclear>: und <unclear cert="low" resp="#joint">nachberlich</unclear> <unclear cert="low" resp="#joint">ersuechn</unclear>, <unclear cert="medium" resp="#joint">die</unclear>
<lb n="56"/><unclear cert="medium" resp="#joint">wollen</unclear> umb <unclear cert="low" resp="#joint">angedeüter</unclear> ursachen willen
<lb n="57"/><unclear cert="low" resp="#joint">ihne</unclear> <persName resp="#ner">Michael <unclear cert="low" resp="#joint">Geibeln</unclear></persName>, <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">irem</unclear> burger
<pb facs="StadtASG_Missive_1833_6803.jpg" n="3"/>
<lb n="58"/><unclear cert="medium" resp="#joint">guenstig</unclear> uff. und <unclear cert="low" resp="#joint">annemen</unclear>, und <unclear cert="low" resp="#joint">Ihne</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">anbefolohen</unclear> <unclear cert="low" resp="#joint">Jedeszeit</unclear> in <unclear cert="low" resp="#joint">guetem</unclear>
<lb n="60"/>Befelch haben und hallten. Zweiffelt uns
<lb n="61"/>nit <unclear cert="low" resp="#joint">Er</unclear> <unclear cert="low" resp="#joint">Werde</unclear> sich also unverweißlicher
<lb n="62"/>gebuer in eim und anderm <unclear cert="low" resp="#joint">Verhalten</unclear>.
<lb n="63"/>Das <unclear cert="low" resp="#joint">seyen</unclear> umb E. F. W. Wir, sambt
<lb n="64"/>Ihrs Jungeverwannten In <unclear cert="low" resp="#joint">glichen</unclear> unnd
<lb n="65"/><unclear cert="medium" resp="#joint">andern</unclear> <unclear cert="medium" resp="#joint">fuertragenden</unclear> fällen freundtlich
<lb n="66"/>und Nachbarlich <unclear cert="low" resp="#joint">Zubedienen</unclear> <unclear cert="low" resp="#joint">erbieting</unclear>,
<lb n="67"/>datt <origDate resp="#ner"><unclear cert="medium" resp="#joint">22</unclear>. <unclear cert="medium" resp="#joint">Aprilis</unclear>. <unclear cert="medium" resp="#joint">ao</unclear>. <unclear cert="low" resp="#joint">613</unclear></origDate>.
<lb n="68"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und Rhat
<lb n="69"/>der Statt <unclear cert="low" resp="#joint">Lindaw</unclear></orgName>.
<pb facs="StadtASG_Missive_1833_6804.jpg" n="4"/>
<lb n="70"/>Den <unclear cert="medium" resp="#joint">fursichtigen</unclear> ersamen und weysen
<lb n="71"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und Rhat der Statt St.
<lb n="72"/>Gallen</orgName>, unsern bsondern lieben <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="73"/><unclear cert="medium" resp="#joint">gueten</unclear> freunden.
<lb n="74"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>.
</p>
