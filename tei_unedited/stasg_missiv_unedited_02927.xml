    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2927_11503.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unßer</unclear> <unclear cert="medium" resp="#joint">frundtlich</unclear> willig <unclear cert="medium" resp="#joint">dienßt</unclear>, <unclear cert="medium" resp="#joint">zuevor</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">Ernveßte</unclear> <unclear cert="medium" resp="#joint">Fuernemme</unclear> <unclear cert="medium" resp="#joint">wyß</unclear>, <unclear cert="medium" resp="#joint">Inson</unclear>-
<lb n="3"/><unclear cert="medium" resp="#joint">der</unclear> liebe herren.
<lb n="4"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">Ihr</unclear>, <unclear cert="low" resp="#joint">dießelbige</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">Irer</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">Statt</unclear> in <unclear cert="low" resp="#joint">ietzigem</unclear> <unclear cert="low" resp="#joint">schwirren</unclear> <unclear cert="low" resp="#joint">werendem</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Kriegswesen</unclear>, <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">kriegs</unclear> <unclear cert="low" resp="#joint">pressuren</unclear>, <unclear cert="low" resp="#joint">trangßal</unclear>
<lb n="7"/>und <unclear cert="medium" resp="#joint">schaden</unclear> <unclear cert="medium" resp="#joint">ußstehn</unclear> <unclear cert="medium" resp="#joint">mueßen</unclear>, <unclear cert="medium" resp="#joint">uffwendung</unclear>
<lb n="8"/>an <unclear cert="low" resp="#joint">geltmittlen</unclear> <unclear cert="low" resp="#joint">genzlich</unclear> <unclear cert="low" resp="#joint">ußgeschetzt</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">syn</unclear>. und deßwegen umb <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">Rath</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">anlehen</unclear>. <unclear cert="low" resp="#joint">etlich</unclear> <unclear cert="low" resp="#joint">taußent</unclear> <unclear cert="low" resp="#joint">guldin</unclear> <unclear cert="low" resp="#joint">by</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">frundtlich</unclear> <unclear cert="low" resp="#joint">angeßucht</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">Ihrem</unclear> <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">dato</unclear> deß
<lb n="13"/><date resp="#ner"><unclear cert="low" resp="#joint">27</unclear>. <unclear cert="low" resp="#joint">Juni</unclear></date> <unclear cert="low" resp="#joint">nechst</unclear> <unclear cert="low" resp="#joint">abgangnem</unclear> schriben
<lb n="14"/>mit <unclear cert="low" resp="#joint">mehrerm</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>.
<lb n="15"/><unclear cert="low" resp="#joint">Obwohlen</unclear> <unclear cert="low" resp="#joint">wier</unclear> nun, mit den herren,
<lb n="16"/><unclear cert="low" resp="#joint">wege</unclear> <unclear cert="low" resp="#joint">solch</unclear> <unclear cert="low" resp="#joint">Ihres</unclear> <unclear cert="low" resp="#joint">bedaurlichen</unclear> <unclear cert="low" resp="#joint">zustands</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">beschwärlich</unclear> <unclear cert="low" resp="#joint">zuestandts</unclear> <unclear cert="low" resp="#joint">halber</unclear>, <unclear cert="low" resp="#joint">ein</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">mitleiden</unclear> <unclear cert="low" resp="#joint">tragen</unclear>, und <unclear cert="low" resp="#joint">dahero</unclear>
<lb n="19"/>wünschen möchten, <unclear cert="medium" resp="#joint">daß</unclear> wir
<lb n="20"/><unclear cert="low" resp="#joint">denselben</unclear> in <unclear cert="medium" resp="#joint">Ihrem</unclear> <unclear cert="medium" resp="#joint">bittlichen</unclear> <unclear cert="medium" resp="#joint">begeren</unclear>
<lb n="21"/>willfahren <unclear cert="medium" resp="#joint">köndten</unclear>.
<lb n="22"/><unclear cert="medium" resp="#joint">So</unclear> <unclear cert="medium" resp="#joint">ligt</unclear> <unclear cert="medium" resp="#joint">uns</unclear> aber <unclear cert="low" resp="#joint">daselbige</unclear> <unclear cert="low" resp="#joint">So</unclear> <unclear cert="low" resp="#joint">kombt</unclear> <unclear cert="low" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">Jedoch</unclear> <unclear cert="low" resp="#joint">eben</unclear> <unclear cert="low" resp="#joint">diße</unclear> <unclear cert="low" resp="#joint">weis</unclear> in der
<lb n="23"/><unclear cert="low" resp="#joint">Ihre</unclear> <unclear cert="low" resp="#joint">selber</unclear> <unclear cert="low" resp="#joint">bewußt</unclear> <unclear cert="low" resp="#joint">Nachbarschaft</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">gleichfahls</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">beschwärlichste</unclear> <unclear cert="low" resp="#joint">kriegsstandt</unclear>, und <unclear cert="low" resp="#joint">wie</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">weinigem</unclear> selben <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">deudtschen</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">Confoederirten</unclear> <unclear cert="low" resp="#joint">stenden</unclear> <unclear cert="low" resp="#joint">selben</unclear> <unclear cert="low" resp="#joint">theil</unclear> <unclear cert="low" resp="#joint">er</unclear>-
<lb n="27"/><unclear cert="low" resp="#joint">legen</unclear> <unclear cert="low" resp="#joint">hilff</unclear> <unclear cert="low" resp="#joint">erdulden</unclear> <unclear cert="low" resp="#joint">mueßten</unclear>, <unclear cert="low" resp="#joint">dardurch</unclear> <unclear cert="low" resp="#joint">wier</unclear>
<lb n="28"/>aber <unclear cert="medium" resp="#joint">auch</unclear> nicht <unclear cert="low" resp="#joint">wenigers</unclear> <unclear cert="low" resp="#joint">abkombt</unclear> <unclear cert="low" resp="#joint">unßers</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">Stattseckels</unclear>, und <unclear cert="low" resp="#joint">fernere</unclear> <unclear cert="low" resp="#joint">tägliche</unclear> <unclear cert="low" resp="#joint">große</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">ußgaaben</unclear>, <unclear cert="low" resp="#joint">nicht</unclear> wohl, <unclear cert="low" resp="#joint">wie</unclear>
<pb facs="StadtASG_Missive_2927_11504.jpg" n="2"/>
<lb n="31"/>aber inhalt ihres schreibens ihne für-
<lb n="32"/>gespannen sein muoßte, nit wolte ver-
<lb n="33"/>fechten helffen.
<lb n="34"/>Dieweil es aber denzmale in andre weg
<lb n="35"/>beliebendt seie er aignen hero
<lb n="36"/>einfallts erinnerung, si die
<lb n="37"/>zwei vorernante zuo erforderten
<lb n="38"/>tag citiren lassen wellen, ich es
<lb n="39"/>solches zuo sein gedechtnis wellen
<lb n="40"/>behalten. Actum <origDate when="1632-07-12" resp="#ner">12. julij
<lb n="41"/>anno 1632</origDate>.
<lb n="42"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Bürgermeister und rath
<lb n="43"/>der statt S. Gallen</orgName>.
<lb n="44"/>Dem ehrnvesten fürnemmen und weisen
<lb n="45"/>hern <persName role="recipient" resp="#ner">Caspar Schlüchtern</persName>, wolver-
<lb n="46"/>ordneten vogt der graffschafft <placeName ref="stadtasg-places-180" cert="medium" resp="#ner">Kiburg</placeName>,
<lb n="47"/>unserm sonders lieben herren.
</p>
