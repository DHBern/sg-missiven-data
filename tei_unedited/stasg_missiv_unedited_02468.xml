    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2468_9511.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründt</unclear>, <unclear cert="medium" resp="#joint">nachberlich</unclear>, willig
<lb n="2"/>dienst sampt was wir ehren liebs
<lb n="3"/>und guots <unclear cert="low" resp="#joint">vermoegenet</unclear>, <unclear cert="low" resp="#joint">zuvor</unclear>,
<lb n="4"/>Edler vester und weiser, insonders
<lb n="5"/>lieber herr landtvogt, guot
<lb n="6"/><unclear cert="medium" resp="#joint">fründt</unclear> und <orgName ref="stadtasg-actors-750" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoß</unclear></orgName>.
<lb n="7"/><unclear cert="medium" resp="#joint">Wasmaßen</unclear> ihro <unclear cert="low" resp="#joint">Fl</unclear>. <unclear cert="low" resp="#joint">Gn</unclear>. des
<lb n="8"/>herrn <unclear cert="low" resp="#joint">Prelat</unclear> zuo <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>
<lb n="9"/><unclear cert="low" resp="#joint">wolbestelte</unclear> herrn,
<lb n="10"/><unclear cert="medium" resp="#joint">hoffrht</unclear> und weltliche <unclear cert="low" resp="#joint">rhät</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">auf</unclear> <unclear cert="low" resp="#joint">Ew</unclear>. <unclear cert="low" resp="#joint">Nachberlich</unclear> <unclear cert="low" resp="#joint">ersuochn</unclear>,
<lb n="12"/>mit <persName resp="#ner"><unclear cert="medium" resp="#joint">Ulrich</unclear> <unclear cert="medium" resp="#joint">Hoeschen</unclear></persName>, so vor
<lb n="13"/>diß <unclear cert="medium" resp="#joint">diebstahls</unclear> halber in Ge-
<lb n="14"/><unclear cert="low" resp="#joint">fängknußß</unclear> <unclear cert="low" resp="#joint">gelegen</unclear>, und
<lb n="15"/><unclear cert="low" resp="#joint">etwa</unclear> <unclear cert="low" resp="#joint">seither</unclear> sich <unclear cert="low" resp="#joint">auoßherumb</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">verfuegt</unclear> und ein <unclear cert="low" resp="#joint">Stuellein</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">wat</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Ewer</unclear> <unclear cert="low" resp="#joint">Statt</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">entwendet</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">peinliche</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">rechtfertigung</unclear> <unclear cert="low" resp="#joint">gestelt</unclear> <unclear cert="low" resp="#joint">wordn</unclear>,
<lb n="20"/><unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">wirdet</unclear> der <unclear cert="low" resp="#joint">herr</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">sowohl</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">beyverwarten</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">befelch</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">besagtes</unclear> <unclear cert="low" resp="#joint">unsers</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">geheimen</unclear> <unclear cert="low" resp="#joint">Rht</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">seckelmaisters</unclear> <unclear cert="low" resp="#joint">Eeman</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">fernerer</unclear> <unclear cert="low" resp="#joint">Erleiterung</unclear> mit
<lb n="25"/><unclear cert="low" resp="#joint">mehreren</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">vernemen</unclear>: <unclear cert="low" resp="#joint">Fründt</unclear>-
<lb n="27"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wolgeneigt</unclear> <unclear cert="low" resp="#joint">bittend</unclear>, <unclear cert="low" resp="#joint">der</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">woelle</unclear> ihne nicht <unclear cert="low" resp="#joint">allein</unclear>
<pb facs="StadtASG_Missive_2468_9512.jpg" n="2"/>
<lb n="29"/><unclear cert="low" resp="#joint">guetwillig</unclear> <unclear cert="low" resp="#joint">ansechen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">E</unclear>.
<lb n="30"/><unclear cert="low" resp="#joint">vermuogschlagne</unclear> <unclear cert="low" resp="#joint">fründtliche</unclear>
<lb n="31"/>und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">nachperschafft</unclear> <unclear cert="low" resp="#joint">vorstenden</unclear> <unclear cert="low" resp="#joint">begerens</unclear>
<lb n="32"/>und den <unclear cert="low" resp="#joint">Maleficanten</unclear>,
<lb n="33"/><unclear cert="low" resp="#joint">gegn</unclear> den <unclear cert="low" resp="#joint">bbrüchlichen</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">revershi</unclear> <unclear cert="low" resp="#joint">volgen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>.
<lb n="35"/><unclear cert="low" resp="#joint">Daß</unclear> <unclear cert="low" resp="#joint">begeren</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">E</unclear>.
<lb n="36"/>in <unclear cert="medium" resp="#joint">vernere</unclear> <unclear cert="medium" resp="#joint">fründt.nauch</unclear>- und der-
<lb n="37"/><unclear cert="low" resp="#joint">glichen</unclear>, <unclear cert="low" resp="#joint">old</unclear> <unclear cert="low" resp="#joint">ande</unclear> <unclear cert="low" resp="#joint">begebenheitten</unclear>,
<lb n="38"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">Eydtgnossischen</unclear> <unclear cert="low" resp="#joint">willen</unclear>,
<lb n="39"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">gnaden</unclear> <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">beschulden</unclear>,
<lb n="40"/><unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">samptlichen</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">schirm</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">hoechsten</unclear> <unclear cert="low" resp="#joint">wolbefelchende</unclear>.
<lb n="42"/>Datum den <origDate when="1624-02-26" resp="#ner">26ten Februarij
<lb n="43"/>Anno 1624</origDate>.
<lb n="44"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">Rhatt</unclear>
<lb n="45"/>der statt <unclear cert="low" resp="#joint">Sant</unclear> Gallen</orgName>.
<lb n="46"/>Dem edlen vesten und wysen,
<lb n="47"/><persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Itel</unclear> <unclear cert="medium" resp="#joint">Reding</unclear></persName>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Rhats</unclear>
<lb n="48"/>ze <placeName ref="stadtasg-places-71" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schwytz</unclear></placeName> Landtvogt
<lb n="49"/><unclear cert="medium" resp="#joint">im</unclear> <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Obren</unclear> und <unclear cert="medium" resp="#joint">Nidren</unclear> <unclear cert="medium" resp="#joint">Thurgöuw</unclear></placeName>.
<lb n="50"/><unclear cert="medium" resp="#joint">unserm</unclear> <unclear cert="medium" resp="#joint">bsonders</unclear> lieben <unclear cert="medium" resp="#joint">herren</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">guetten</unclear> fründt und <unclear cert="low" resp="#joint">Eydtgnossen</unclear>.
<pb facs="StadtASG_Missive_2468_9513.jpg" n="3"/>
<pb facs="StadtASG_Missive_2468_9514.jpg" n="4"/>
<lb n="52"/><unclear cert="medium" resp="#joint">An</unclear> <persName role="recipient" resp="#ner">H. <unclear cert="medium" resp="#joint">L.vogt</unclear> <unclear cert="medium" resp="#joint">Reding</unclear></persName> von <placeName ref="stadtasg-places-287" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schweiz</unclear></placeName>
<lb n="53"/>im <origPlace ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Turgoew</unclear></origPlace> <origDate when="1624-02-26" resp="#ner">26. Febr. 1624</origDate>.
</p>
