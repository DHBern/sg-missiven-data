<p>
<pb facs="StadtASG_Missive_1536_5555.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unßer</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear> willig dienst und was wir Eren liebs <unclear cert="low" resp="#joint">undt</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">guts</unclear> <unclear cert="low" resp="#joint">vermögn</unclear> <unclear cert="low" resp="#joint">zuovor</unclear> <unclear cert="low" resp="#joint">fromen</unclear> fürsichtig Ersamen
<lb n="3"/><unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">weyßen</unclear>, <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">guten</unclear> <unclear cert="low" resp="#joint">freündten</unclear> und getreüwen lieben
<lb n="4"/>Eidgnossen.
<lb n="5"/>Es hat uns <unclear cert="medium" resp="#joint">unßer</unclear> lieber Mitbürger <persName resp="#ner">Jacob</persName> wild <unclear cert="low" resp="#joint">underthenig</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">zuevernemmen</unclear> geben, wie das er in <unclear cert="low" resp="#joint">glaubwürdige</unclear> <unclear cert="low" resp="#joint">erfarung</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">khomen</unclear>, <unclear cert="low" resp="#joint">was</unclear> ein geliebter schwaher <persName resp="#ner"><unclear cert="low" resp="#joint">Christoff</unclear> <unclear cert="low" resp="#joint">Rai</unclear></persName> <unclear cert="low" resp="#joint">eüwer</unclear>
<lb n="8"/>lieber <unclear cert="low" resp="#joint">Mitbürger</unclear> <unclear cert="low" resp="#joint">vorhabens</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">eeleiblichen</unclear> <unclear cert="low" resp="#joint">sohn</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Io</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">hans</unclear></persName> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Jenige</unclear> <unclear cert="low" resp="#joint">behaüßung</unclear> <unclear cert="low" resp="#joint">darinen</unclear> <unclear cert="low" resp="#joint">gemelter</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">lieber</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">schweher</unclear> wohne, sambt allen darinen <unclear cert="medium" resp="#joint">ligendten</unclear> <unclear cert="low" resp="#joint">Weinfassen</unclear>
<lb n="11"/>Nur umb 1200 fl. <unclear cert="low" resp="#joint">zuotestieren</unclear> und <unclear cert="low" resp="#joint">zuvermachen</unclear>
<lb n="12"/>da doch bemelte <unclear cert="low" resp="#joint">behaüßung</unclear> des <unclear cert="low" resp="#joint">lerten</unclear> <unclear cert="low" resp="#joint">faß</unclear>,
<lb n="13"/>von <unclear cert="low" resp="#joint">sinen</unclear> <unclear cert="low" resp="#joint">schweher</unclear> umb 3000 fl. <unclear cert="low" resp="#joint">erkhaufft</unclear> <unclear cert="medium" resp="#joint">wordten</unclear>,
<lb n="14"/><unclear cert="low" resp="#joint">wann</unclear> <unclear cert="medium" resp="#joint">Er</unclear> <unclear cert="low" resp="#joint">schweher</unclear> auch <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">iet</unclear> und allweg dahin erkhleret.
<lb n="15"/>das er <unclear cert="low" resp="#joint">sine</unclear> kindter <unclear cert="low" resp="#joint">eins</unclear> wie das <unclear cert="medium" resp="#joint">andter</unclear> halten <unclear cert="medium" resp="#joint">wülle</unclear>
<lb n="16"/>und <unclear cert="low" resp="#joint">weilen</unclear> nun er <unclear cert="low" resp="#joint">wilde</unclear> auch siner döchteren eine zue
<lb n="17"/>einem Eelichen weib habe, mit dere er bißhero wie <unclear cert="low" resp="#joint">einem</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">Eelichen</unclear> <unclear cert="low" resp="#joint">Man</unclear> <unclear cert="low" resp="#joint">zuestehe</unclear> und gebüre gehaußet, und aber <unclear cert="low" resp="#joint">siner</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">bedunckhens</unclear> (wann obgemelt testieren solte sinen fort-
<lb n="20"/>gang gewinnen) er sambt siner lieben haußfrauwen übel
<lb n="21"/>vürkhürtzt, und ein <unclear cert="low" resp="#joint">große</unclear> <unclear cert="low" resp="#joint">unglicheit</unclear> in dem fall <unclear cert="low" resp="#joint">gehalten</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">würdte</unclear>, hat er uns <unclear cert="low" resp="#joint">daruff</unclear> <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">undthenig</unclear> <unclear cert="low" resp="#joint">angerüefft</unclear>
<lb n="23"/>undt gebetten ime mit unßer Intercession (deren er frucht-
<lb n="24"/><unclear cert="low" resp="#joint">barlich</unclear> <unclear cert="low" resp="#joint">zuegnießen</unclear> <unclear cert="low" resp="#joint">verhoffe</unclear>) dergestalt behülfflich
<lb n="25"/>zuo erschinen, Ob doch durch eüch in bestettigung abstandts
<lb n="26"/>testierens etlicher <unclear cert="low" resp="#joint">maßen</unclear> ein <unclear cert="low" resp="#joint">glicheit</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">geschwüster</unclear>-
<lb n="27"/><unclear cert="low" resp="#joint">richten</unclear> <unclear cert="low" resp="#joint">angestelt</unclear>, und er und sein liebe haußfraw nit <unclear cert="low" resp="#joint">so</unclear>
<lb n="28"/>gar <unclear cert="low" resp="#joint">außgeschloßen</unclear> <unclear cert="low" resp="#joint">werdten</unclear>. wann wir nun den
<lb n="29"/><unclear cert="low" resp="#joint">unßeren</unclear> <unclear cert="medium" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">billichen</unclear> sachen fürdterung zue <unclear cert="low" resp="#joint">erzeigen</unclear> <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">schuldig</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">erkennen</unclear>, <unclear cert="low" resp="#joint">dernaben</unclear> aber auch <unclear cert="low" resp="#joint">zwißchen</unclear> so <unclear cert="low" resp="#joint">nahen</unclear> <unclear cert="low" resp="#joint">verwandten</unclear>
<lb n="31"/>nit gern unwillen <unclear cert="low" resp="#joint">erwöhßen</unclear> <unclear cert="low" resp="#joint">sehen</unclear> <unclear cert="low" resp="#joint">wolten</unclear>, So gelangt
<lb n="32"/>und ist an <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">unßer</unclear> <unclear cert="low" resp="#joint">fründ</unclear> <unclear cert="low" resp="#joint">Eidtgnößisch</unclear> piten undt
<pb facs="StadtASG_Missive_1536_5556.jpg" n="2"/>
<lb n="33"/>ersuecht, die <unclear cert="low" resp="#joint">wuellen</unclear> in betrachtung gestaltsame der sachen
<lb n="34"/>(und das der vortheil den <unclear cert="low" resp="#joint">obgedachter</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">widersaecher</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">hußfrawen</unclear> <unclear cert="low" resp="#joint">habe</unclear>, wann im der selbig <unclear cert="low" resp="#joint">solte</unclear> <unclear cert="low" resp="#joint">erkend</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">ebe</unclear> <unclear cert="low" resp="#joint">groß</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">moechte</unclear> <unclear cert="low" resp="#joint">befridiget</unclear> und <unclear cert="low" resp="#joint">hür</unclear> <unclear cert="low" resp="#joint">eehaft</unclear> werden, <unclear cert="medium" resp="#joint">Er</unclear> <unclear cert="low" resp="#joint">wurde</unclear> <unclear cert="medium" resp="#joint">ouch</unclear> gar
<lb n="38"/>nit dawieder das <unclear cert="low" resp="#joint">ime</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">dß</unclear> <unclear cert="low" resp="#joint">ihenig</unclear> <unclear cert="low" resp="#joint">was</unclear> dem <unclear cert="low" resp="#joint">Zwyck</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">olte</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">frawen</unclear>, ein <unclear cert="low" resp="#joint">gebürlichen</unclear> <unclear cert="low" resp="#joint">vorußverordnen</unclear>)
<lb n="40"/>disers ouch dahin dirigieren und richten, damit nit allein <unclear cert="low" resp="#joint">zwüschen</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">fründschaft</unclear> erhalten, sonderen ouch wie obgemelt ein
<lb n="42"/>ungevarliche glicheit mechte angestelt werden. Das
<lb n="43"/>umb E. E. F. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">begebende</unclear> <unclear cert="low" resp="#joint">zuotragende</unclear> <unclear cert="low" resp="#joint">faell</unclear> <unclear cert="low" resp="#joint">fründlich</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">udt</unclear> <unclear cert="low" resp="#joint">Eydgnößisch</unclear> <unclear cert="low" resp="#joint">zuoverdienen</unclear> <unclear cert="low" resp="#joint">wuellen</unclear> wir <unclear cert="low" resp="#joint">ied</unclear> <unclear cert="low" resp="#joint">zit</unclear> <unclear cert="low" resp="#joint">bereitwillig</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">eingedenckh</unclear> und <unclear cert="low" resp="#joint">unvergessen</unclear> <unclear cert="low" resp="#joint">sin</unclear>, Goetlicher bewahr u. <unclear cert="low" resp="#joint">W</unclear>. .
<lb n="46"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">samptlich</unclear> <unclear cert="low" resp="#joint">wolbevelchende</unclear>. Datum <origDate when="1607-01-30" resp="#ner">den 30. <unclear cert="low" resp="#joint">Januarii</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">Ao</unclear>. 1607</origDate>.
