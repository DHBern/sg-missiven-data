<lb n="5"/>Uß üwerem <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">zuogethanen</unclear> schryben, sambt <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">bylag</unclear>,
