<lb n="7"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Eydtgnoßischen</unclear> landen</placeName>, unnd was <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">verschidnen</unclear> <unclear cert="medium" resp="#joint">orten</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">har</unclear> üch <unclear cert="low" resp="#joint">warnungswyß</unclear> <unclear cert="low" resp="#joint">communicirt</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">mehrerem</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">verstanden</unclear>. <unclear cert="low" resp="#joint">thuond</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">abermaligen</unclear> <unclear cert="low" resp="#joint">wyser</unclear> so <unclear cert="low" resp="#joint">nit</unclear>
