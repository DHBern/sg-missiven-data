<lb n="35"/><unclear cert="low" resp="#joint">danckbarkeit</unclear> <unclear cert="low" resp="#joint">beruehmen</unclear>. <unclear cert="low" resp="#joint">Sonnst</unclear> <unclear cert="low" resp="#joint">hatt</unclear> <unclear cert="low" resp="#joint">beruerter</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">fynndt</unclear>, <unclear cert="low" resp="#joint">mitt</unclear> syner macht, von <unclear cert="medium" resp="#joint">gnaden</unclear> Gottes
