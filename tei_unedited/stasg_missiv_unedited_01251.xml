<lb n="35"/><unclear cert="low" resp="#joint">danckbarkeit</unclear> <unclear cert="low" resp="#joint">beruehmen</unclear>. <unclear cert="low" resp="#joint">Sonnst</unclear> hatt <unclear cert="medium" resp="#joint">beruerter</unclear>
