<p>
<pb facs="StadtASG_Missive_1251_4189.jpg" n="1"/>
<lb n="1"/>Unser früntlich willige diennst. Sampt was wir
<lb n="2"/><unclear cert="medium" resp="#joint">eeren</unclear>, liebs unnd guots <unclear cert="medium" resp="#joint">vermoegend</unclear> zuovor, fromm, fürsichtig,
<lb n="3"/>ersam, wyß, <unclear cert="medium" resp="#joint">insonnders</unclear> guott <unclear cert="medium" resp="#joint">fründt</unclear> unnd <unclear cert="low" resp="#joint">getrüwe</unclear> lieb
<lb n="4"/>eydtgnossen. Ir <unclear cert="low" resp="#joint">habennth</unclear> <unclear cert="low" resp="#joint">one</unclear> <unclear cert="low" resp="#joint">zwyffel</unclear> vor langist ver-
<lb n="5"/>nomen, wie <unclear cert="low" resp="#joint">kro</unclear>. <unclear cert="low" resp="#joint">Mt</unclear>. <unclear cert="low" resp="#joint">kriegsvolkh</unclear>, so sich im
<lb n="6"/><unclear cert="low" resp="#joint">jüngst</unclear> abgloffnen <unclear cert="low" resp="#joint">osteren</unclear>, inn der <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">eydtgnoschafft</unclear></orgName> <unclear cert="low" resp="#joint">uffgnomen</unclear>,
<lb n="7"/>unnd versamlet, den <persName resp="#ner"><unclear cert="low" resp="#joint">hertzogen</unclear> <unclear cert="low" resp="#joint">vonn</unclear> <unclear cert="low" resp="#joint">Saffoy</unclear></persName>, alls ein <unclear cert="low" resp="#joint">erklaerten</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">fyenndt</unclear>, inn synen landen umb <unclear cert="medium" resp="#joint">die</unclear> statt <placeName ref="stadtasg-places-169" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Genff</unclear></placeName> <unclear cert="low" resp="#joint">gelägnen</unclear>,
<lb n="9"/>angriffenn unnd <unclear cert="medium" resp="#joint">ettliche</unclear> <unclear cert="medium" resp="#joint">stett</unclear>, <unclear cert="low" resp="#joint">schlösser</unclear>, <unclear cert="low" resp="#joint">fläkhen</unclear> unnd <unclear cert="low" resp="#joint">vestinen</unclear>
<lb n="10"/>erobert, <unclear cert="medium" resp="#joint">ingenomen</unclear>, <unclear cert="medium" resp="#joint">enndtlich</unclear> aber <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">beweeglichen</unclear> ursachen,
<lb n="11"/>ab, unnd <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">andre</unclear> <unclear cert="low" resp="#joint">straaß</unclear> inn <placeName ref="stadtasg-places-131" cert="medium" resp="#ner">Franckhrych</placeName> <unclear cert="low" resp="#joint">gezogen</unclear>, unnd <unclear cert="low" resp="#joint">unßeren</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">getrüwen</unclear>, lieben, eydt unnd pundtsgnossen der statt <unclear cert="medium" resp="#joint">Genff</unclear>
<lb n="13"/>unnd unns die <unclear cert="medium" resp="#joint">verwarung</unclear> der <unclear cert="medium" resp="#joint">gwonnen</unclear> landtschafften, unnd
<lb n="14"/>damit den krieg, wider den <unclear cert="low" resp="#joint">fyenndt</unclear> uff dem <unclear cert="low" resp="#joint">hallß</unclear> <unclear cert="low" resp="#joint">gelassen</unclear>.
<lb n="15"/><unclear cert="low" resp="#joint">Diewyl</unclear> aber <unclear cert="low" resp="#joint">sidt</unclear> har <unclear cert="low" resp="#joint">dersälb</unclear> sich mächtig <unclear cert="medium" resp="#joint">gsterckht</unclear>, <unclear cert="medium" resp="#joint">persoendlich</unclear>
<lb n="16"/>sich inn das <unclear cert="low" resp="#joint">väldt</unclear>, mit <unclear cert="low" resp="#joint">syner</unclear> <unclear cert="medium" resp="#joint">macht</unclear> <unclear cert="low" resp="#joint">gelägert</unclear>, unnd an
