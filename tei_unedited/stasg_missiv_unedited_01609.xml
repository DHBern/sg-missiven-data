<p>
<pb facs="StadtASG_Missive_1609_5841.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">fründtlich</unclear> willig dienst sampt was wir
<lb n="2"/><unclear cert="low" resp="#joint">ehren</unclear> liebs unnd guots <unclear cert="low" resp="#joint">vermogen</unclear> zuovor, <unclear cert="medium" resp="#joint">fromm</unclear>,
<lb n="3"/>fürsichtig, ersam, <unclear cert="low" resp="#joint">wyß</unclear>, <unclear cert="medium" resp="#joint">insunders</unclear> guote <unclear cert="low" resp="#joint">fründt</unclear> unnd
<lb n="4"/><unclear cert="low" resp="#joint">getreuwe</unclear> liebe Eydtgnossen. <unclear cert="medium" resp="#joint">Unß</unclear> <unclear cert="low" resp="#joint">hat</unclear> unser <unclear cert="low" resp="#joint">getrüwer</unclear>
<lb n="5"/>lieber burger <unclear cert="low" resp="#joint">haupt</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Jeorig</unclear> von <unclear cert="medium" resp="#joint">Roll</unclear></persName> <unclear cert="medium" resp="#joint">füerthin</unclear> <unclear cert="medium" resp="#joint">zuover</unclear>-
<lb n="6"/>stehn geben, wie das sin <unclear cert="medium" resp="#joint">sohn</unclear> unser amptman uff
<lb n="7"/><placeName resp="#ner"><unclear cert="medium" resp="#joint">Wallenstain</unclear></placeName>, <unclear cert="medium" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">üwern</unclear> <unclear cert="medium" resp="#joint">burgern</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Malchior</unclear> <unclear cert="medium" resp="#joint">Lacher</unclear></persName> unnd
<lb n="8"/><persName resp="#ner"><unclear cert="low" resp="#joint">Hainrich</unclear> <unclear cert="low" resp="#joint">Rottmunder</unclear></persName>, wie ouch uff <persName resp="#ner">Lienhart</persName> unnd <persName resp="#ner">Jacob</persName>
<lb n="9"/><persName resp="#ner"><unclear cert="low" resp="#joint">Kolern</unclear></persName> umb <unclear cert="low" resp="#joint">erkuoffte</unclear> verschrybungen unnd obligationen,
<lb n="10"/>etliche verfallne unnd <unclear cert="low" resp="#joint">ußstendne</unclear> <unclear cert="low" resp="#joint">zinß</unclear> <unclear cert="low" resp="#joint">selbs</unclear> <unclear cert="low" resp="#joint">persoenlich</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">zuoerzüchen</unclear> unnd <unclear cert="low" resp="#joint">selbige</unclear> nit allein <unclear cert="medium" resp="#joint">sonders</unclear> ouch
<lb n="12"/>diewyl <unclear cert="low" resp="#joint">syne</unclear> <unclear cert="low" resp="#joint">pflicht</unclear> <unclear cert="low" resp="#joint">lich</unclear> was <unclear cert="medium" resp="#joint">verursachet</unclear> <unclear cert="medium" resp="#joint">gestallten</unclear> die
<lb n="13"/>principal summa unnd houptguot <unclear cert="medium" resp="#joint">ynzuozüchen</unclear> unnd
<lb n="14"/><unclear cert="medium" resp="#joint">abzebringen</unclear> <unclear cert="medium" resp="#joint">verhrsachet</unclear>, <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">ußebner</unclear> die sachen
<lb n="15"/><unclear cert="low" resp="#joint">anderst</unclear> dan sy <unclear cert="low" resp="#joint">ietzunder</unclear> <unclear cert="low" resp="#joint">geschaffen</unclear> <unclear cert="low" resp="#joint">wohl</unclear> hette mogen
<lb n="16"/><unclear cert="low" resp="#joint">uberhept</unclear> sin, ouch <unclear cert="medium" resp="#joint">erwuenscht</unclear> üch unnd uns, <unclear cert="low" resp="#joint">byneben</unclear>
<lb n="17"/>ouch die <unclear cert="low" resp="#joint">üewern</unclear> obgemellt nit umb sovil <unclear cert="medium" resp="#joint">zemolestiern</unclear>
<lb n="18"/>Diewyl nun aber man by <unclear cert="low" resp="#joint">disen</unclear> schwaebenden <unclear cert="low" resp="#joint">gefarlichen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">zyten</unclear> die sachen <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">guotten</unclear> versichern <unclear cert="low" resp="#joint">jmmers</unclear> nit
<lb n="20"/>allwegen <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">zuosorgen</unclear> ein <unclear cert="medium" resp="#joint">jeder</unclear> ouch <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">sinen</unclear>
<lb n="21"/>mangelbar unnd bedarff, erstgemelter unser ampt-
<lb n="22"/>man verhoffet durch unser intercedieren <unclear cert="medium" resp="#joint">desto</unclear> <unclear cert="medium" resp="#joint">fürder</unclear>-
<lb n="23"/>licher zur bezahlung kommen moge. <unclear cert="low" resp="#joint">Allso</unclear> hatt ob-
<lb n="24"/>gedachter sin vatter uns umb <unclear cert="low" resp="#joint">fürschrifft</unclear> an üch
<lb n="25"/><unclear cert="medium" resp="#joint">gepaetten</unclear> unnd angelangt. Wan nun <unclear cert="low" resp="#joint">wir</unclear> ge-
<lb n="26"/>melter unseren burgeren <unclear cert="low" resp="#joint">pitt</unclear> unnd <unclear cert="low" resp="#joint">fürbring</unclear> ver-
<lb n="27"/><unclear cert="low" resp="#joint">standen</unclear> d <unclear cert="low" resp="#joint">billigkait</unclear> nit <unclear cert="low" resp="#joint">zewider</unclear> <unclear cert="low" resp="#joint">befunden</unclear> unnd
<lb n="28"/><unclear cert="medium" resp="#joint">darinn</unclear> <unclear cert="medium" resp="#joint">syner</unclear> nit <unclear cert="medium" resp="#joint">ab</unclear> <unclear cert="medium" resp="#joint">syn</unclear> <unclear cert="medium" resp="#joint">koennen</unclear>, so gelangt
<lb n="29"/><unclear cert="low" resp="#joint">derowegen</unclear> unser <unclear cert="low" resp="#joint">fründt</unclear>: unnd <unclear cert="low" resp="#joint">Eydtgnossisch</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">begaeren</unclear> an üch Ir <unclear cert="medium" resp="#joint">woellen</unclear> gemellte <unclear cert="low" resp="#joint">üwere</unclear> <unclear cert="low" resp="#joint">burgere</unclear>
<pb facs="StadtASG_Missive_1609_5842.jpg" n="2"/>
<lb n="31"/>die <unclear cert="low" resp="#joint">not</unclear> <unclear cert="low" resp="#joint">wunden</unclear> <unclear cert="low" resp="#joint">beyds</unclear> <unclear cert="low" resp="#joint">Koler</unclear> <unclear cert="low" resp="#joint">dahier</unclear> <unclear cert="low" resp="#joint">hallten</unclear> und <unclear cert="medium" resp="#joint">vermogen</unclear>,
<lb n="32"/>das sy unsern burgern <unclear cert="medium" resp="#joint">obstet</unclear> <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">houptguot</unclear> <unclear cert="medium" resp="#joint">zinß</unclear>
<lb n="33"/>und kosten <unclear cert="low" resp="#joint">angentz</unclear> <unclear cert="low" resp="#joint">usßrichten</unclear> und <unclear cert="low" resp="#joint">unweigerlich</unclear> <unclear cert="low" resp="#joint">bezalind</unclear>,
<lb n="34"/>daran erwyßende Ir ein <unclear cert="low" resp="#joint">werkh</unclear>, so aller <unclear cert="low" resp="#joint">billigkheit</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">gemaeß</unclear> und <unclear cert="low" resp="#joint">woellend</unclear> wir <unclear cert="low" resp="#joint">soelches</unclear> von der <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">weg</unclear>
<lb n="36"/>umb <unclear cert="medium" resp="#joint">Uech</unclear> und die <unclear cert="medium" resp="#joint">uewern</unclear> <unclear cert="medium" resp="#joint">In</unclear> <unclear cert="medium" resp="#joint">glychem</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">mehren</unclear>
<lb n="37"/>gern beschulden <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">verdienen</unclear>. <unclear cert="low" resp="#joint">Hielfft</unclear> Gott deß
<lb n="38"/>schutz und schirm wir <unclear cert="low" resp="#joint">uech</unclear> sampt uns wol <unclear cert="low" resp="#joint">bevelchen</unclear>
<lb n="39"/>datum <origDate when="1608-07-23" resp="#ner">23. July 1608</origDate>.
<lb n="40"/><orgName role="issuer" resp="#ner">Schultheys unnd rhat
<lb n="41"/>der statt <unclear cert="medium" resp="#joint">Sollothurn</unclear></orgName>
<pb facs="StadtASG_Missive_1609_5843.jpg" n="3"/>
<pb facs="StadtASG_Missive_1609_5844.jpg" n="4"/>
<lb n="42"/>Denn frommen fuersichtigen
<lb n="43"/>ersammen weysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="44"/>meister unnd Rhat der <unclear cert="medium" resp="#joint">Stat</unclear>
<lb n="45"/>Sannt Gallen</orgName> unsern insonders
<lb n="46"/>guoten fruenden unnd <unclear cert="low" resp="#joint">gethruwen</unclear>
<lb n="47"/>lieben Eydtgnossen <unclear cert="low" resp="#joint">etc</unclear>.
</p>
