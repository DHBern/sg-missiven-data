<lb n="75"/><unclear cert="medium" resp="#joint">daß</unclear> sie sich ab etlichen <unclear cert="low" resp="#joint">Juden</unclear> in <placeName ref="stadtasg-places-42" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Pehem</unclear></placeName>, <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">wellichen</unclear>
