    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1694_6201.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">fründtlich</unclear> willig diennst, unnd was wir eeren liebs
<lb n="2"/>unnd guots vermoegend zuovor, from fürsichtig, ersam, wyß,
<lb n="3"/>innsonnders guot fründt, unnd gethrüw lieb <unclear cert="low" resp="#joint">Eydtgnoßen</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Über</unclear> <unclear cert="low" resp="#joint">üwer</unclear> <unclear cert="low" resp="#joint">beide</unclear> <unclear cert="low" resp="#joint">jüngsten</unclear> vom <date resp="#ner"><unclear cert="medium" resp="#joint">22ten</unclear> unnd <unclear cert="medium" resp="#joint">24ten</unclear> <unclear cert="medium" resp="#joint">dißs</unclear></date>, an
<lb n="5"/>unns <unclear cert="low" resp="#joint">beschehne</unclear> <unclear cert="low" resp="#joint">fründtlichen</unclear> schryben, <unclear cert="low" resp="#joint">wüßend</unclear> wir üch
<lb n="6"/>für dißmals annders nit <unclear cert="low" resp="#joint">zuobeantworten</unclear>, dann das wir
<lb n="7"/>unns fürs erst, gegen üch umb <unclear cert="medium" resp="#joint">üwere</unclear> so <unclear cert="low" resp="#joint">runde</unclear> <unclear cert="low" resp="#joint">ufrichtige</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">eydtgnoeßische</unclear> meynung, über den verstand deß innhalts
<lb n="9"/>der <unclear cert="low" resp="#joint">pundtsbriefen</unclear>, unnd anerbieten, by <unclear cert="low" resp="#joint">diseren</unclear> sorglichen,
<lb n="10"/><unclear cert="low" resp="#joint">läuffen</unclear>, gantz eidtgnößisch, unnd zum aller <unclear cert="medium" resp="#joint">fründtlichisten</unclear>,
<lb n="11"/>bedanckend, unnd unns darby hinwider anerbieten <unclear cert="medium" resp="#joint">thuond</unclear>,
<lb n="12"/><unclear cert="medium" resp="#joint">üwer</unclear> söllicher <unclear cert="low" resp="#joint">guothertzigkeit</unclear> <unclear cert="low" resp="#joint">jederzyt</unclear> im besten <unclear cert="low" resp="#joint">zuogedencken</unclear>,
<lb n="13"/>unnd mit gethrüwem <unclear cert="low" resp="#joint">uffsehen</unclear> unnd inn <unclear cert="medium" resp="#joint">anndere</unclear> weg,
<lb n="14"/>unns gegen üch <unclear cert="low" resp="#joint">allewegen</unclear>, als <unclear cert="low" resp="#joint">gethrüwen</unclear>, redlichen, eidt-
<lb n="15"/><unclear cert="medium" resp="#joint">gnoßen</unclear> <unclear cert="medium" resp="#joint">zuostadt</unclear>, <unclear cert="medium" resp="#joint">uff</unclear> allen fal mit der hilff Gottes <unclear cert="low" resp="#joint">zuoerzeigen</unclear>.
<lb n="16"/>Was den <unclear cert="low" resp="#joint">ansehnlichen</unclear> bericht deß <unclear cert="medium" resp="#joint">oesterychischen</unclear> <unclear cert="medium" resp="#joint">durchzüc</unclear>-
<lb n="17"/><unclear cert="medium" resp="#joint">hens</unclear>, unnd <unclear cert="medium" resp="#joint">annders</unclear> mehr <unclear cert="medium" resp="#joint">kriegs</unclear> <unclear cert="medium" resp="#joint">volcks</unclear>, so (<unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">unns</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">fürkhomen</unclear>) nachvolgen sölte, <unclear cert="low" resp="#joint">belanget</unclear>, habent wir
<lb n="19"/>uß demselben, unnd deß <unclear cert="low" resp="#joint">ihn</unclear> so <unclear cert="low" resp="#joint">üch</unclear> von <placeName ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Lindouw</unclear></placeName> <unclear cert="medium" resp="#joint">naher</unclear> <unclear cert="medium" resp="#joint">deßalb</unclear>-
<lb n="20"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="medium" resp="#joint">überschriben</unclear>, <unclear cert="medium" resp="#joint">worden</unclear>, <unclear cert="medium" resp="#joint">verstanden</unclear>, <unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">es</unclear> darmit
<lb n="21"/>ein gstalt, <unclear cert="low" resp="#joint">was</unclear> ir <unclear cert="low" resp="#joint">nebent</unclear> <unclear cert="medium" resp="#joint">den</unclear> auch <unclear cert="low" resp="#joint">danenhar</unclear> <unclear cert="low" resp="#joint">verkundtschaf</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">ter</unclear> <unclear cert="low" resp="#joint">erkhundiget</unclear>, unnd wie ir üch anerbietend, <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">deßen</unclear>,
<lb n="23"/>so ir <unclear cert="low" resp="#joint">diser</unclear> dingen halber <unclear cert="low" resp="#joint">wyther</unclear> inn erfarung bringen,
<lb n="24"/>möchten, auch zuoberichten. Darumb wir nun üch eidt-
<lb n="25"/>gnößisch <unclear cert="low" resp="#joint">fründtlich</unclear> dancksagend, unnd nit <unclear cert="medium" resp="#joint">unnderlaßen</unclear>,
<lb n="26"/><unclear cert="medium" resp="#joint">werdent</unclear>, wann unns <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">fürkhame</unclear>, <unclear cert="medium" resp="#joint">das</unclear> üch <unclear cert="medium" resp="#joint">ze</unclear>-
<lb n="27"/>wüßen, von nöten, üch deßelbigen, <unclear cert="medium" resp="#joint">alßbaldt</unclear> auch <unclear cert="medium" resp="#joint">zuover</unclear>-
<lb n="28"/>stendigen, unnd mit üch alle <unclear cert="medium" resp="#joint">verthrüwliche</unclear> correspondentz
<lb n="29"/><unclear cert="medium" resp="#joint">wyther</unclear> als <unclear cert="medium" resp="#joint">bißhar</unclear> zehalten.
<lb n="30"/><unclear cert="medium" resp="#joint">Sonsten</unclear> was im übrigen die <unclear cert="low" resp="#joint">bewüßte</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Gachnangische</unclear></placeName>
<lb n="31"/>handlung antrifft, von deren wegen, <unclear cert="medium" resp="#joint">ietziger</unclear> zyt aller
<lb n="32"/><unclear cert="low" resp="#joint">drytzehen</unclear> orten <unclear cert="low" resp="#joint">gsante</unclear> zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="low" resp="#joint">versamblert</unclear> sind, <unclear cert="medium" resp="#joint">ist</unclear>
<lb n="33"/><origPlace ref="stadtasg-places-32" cert="medium" resp="#ner">Zürich</origPlace> <origDate resp="#ner"><unclear cert="medium" resp="#joint">26ten</unclear> Junij</origDate>
<pb facs="StadtASG_Missive_1694_6202.jpg" n="2"/>
<lb n="34"/>die sach <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">einer</unclear> fründtlichen verglychung oder
<lb n="35"/><unclear cert="low" resp="#joint">englichen</unclear> erörterung umb die abstraffung <unclear cert="low" resp="#joint">deren</unclear> so
<lb n="36"/><unclear cert="low" resp="#joint">faelbar</unclear> erfunden werdent, gerichtet. Also <unclear cert="low" resp="#joint">das</unclear> wir
<lb n="37"/>hoffen <unclear cert="low" resp="#joint">wellend</unclear>, <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">werde</unclear> die handlung ohn <unclear cert="low" resp="#joint">eewere</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">vornemme</unclear> <unclear cert="low" resp="#joint">wytloeffigheit</unclear> <unclear cert="low" resp="#joint">Inmaßen</unclear> <unclear cert="low" resp="#joint">abgahn</unclear>, <unclear cert="low" resp="#joint">das</unclear> man
<lb n="39"/>derenthalben bald wider <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">rüeewen</unclear> <unclear cert="medium" resp="#joint">kommen</unclear> moege, darzuo
<lb n="40"/>wir Gott den <unclear cert="low" resp="#joint">herren</unclear> bittend, <unclear cert="low" resp="#joint">syn</unclear> gnad unnd <unclear cert="low" resp="#joint">sägen</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">lychen</unclear>, <unclear cert="low" resp="#joint">üch</unclear> sambt <unclear cert="medium" resp="#joint">unns</unclear> Inn synem <unclear cert="medium" resp="#joint">schirm</unclear> <unclear cert="medium" resp="#joint">zuoerhalten</unclear>, unnd
<lb n="42"/>unnser geliebt vatterland vor unglück unnd <unclear cert="low" resp="#joint">unrüew</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">behüeten</unclear>. <unclear cert="low" resp="#joint">Dato</unclear> <origDate when="1610-06-28" resp="#ner">den <unclear cert="low" resp="#joint">28</unclear> <unclear cert="low" resp="#joint">ten</unclear> Junij, Anno 1610</origDate>.
<lb n="44"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister unnd rath
<lb n="45"/>der Statt Zürich</orgName>.
<pb facs="StadtASG_Missive_1694_6203.jpg" n="3"/>
<pb facs="StadtASG_Missive_1694_6204.jpg" n="4"/>
<lb n="46"/>Den frommen fuersichtigen, ehrsamen
<lb n="47"/>wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd <unclear cert="low" resp="#joint">Raht</unclear>,
<lb n="48"/>der statt <unclear cert="medium" resp="#joint">Sannt</unclear> Gallen</orgName>, <unclear cert="low" resp="#joint">unnser</unclear>-
<lb n="49"/><unclear cert="low" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">insonnders</unclear> guoten fruenden, und
<lb n="50"/><unclear cert="low" resp="#joint">getruewen</unclear> lieben Eydtgnossen.
</p>
