    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1922_7157.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündt</unclear>, <unclear cert="low" resp="#joint">nachbarlich</unclear> willig dienst, und <unclear cert="medium" resp="#joint">waß</unclear> wir
<lb n="2"/><unclear cert="medium" resp="#joint">ehren</unclear>, <unclear cert="medium" resp="#joint">liebß</unclear> und guots <unclear cert="medium" resp="#joint">vermoegend</unclear> zuovor, <unclear cert="medium" resp="#joint">fromen</unclear>,
<lb n="3"/>fürsichtigen, <unclear cert="medium" resp="#joint">ehrsamen</unclear> und weisen, <unclear cert="medium" resp="#joint">inßonders</unclear> guoten
<lb n="4"/><unclear cert="medium" resp="#joint">freünden</unclear> und <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Verschinen</unclear> <date resp="#ner">zinstag den <unclear cert="low" resp="#joint">22</unclear>. <unclear cert="low" resp="#joint">te</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">gegenwürtigen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">monats</unclear> Novembris</date> haben wir <unclear cert="low" resp="#joint">euch</unclear> <orgName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">U</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">Eydtgnossen</unclear></orgName>
<lb n="7"/>ihnen durch schreiben zuo <unclear cert="low" resp="#joint">wüssen</unclear> <unclear cert="low" resp="#joint">gethon</unclear>, <unclear cert="low" resp="#joint">warumb</unclear>,
<lb n="8"/><unclear cert="low" resp="#joint">uneröeterte</unclear> <unclear cert="low" resp="#joint">erbschafthandlung</unclear>, betreffende <unclear cert="medium" resp="#joint">unßerß</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">geweßnen</unclear> <unclear cert="medium" resp="#joint">burgers</unclear> <persName resp="#ner">Samuel <unclear cert="medium" resp="#joint">Zaidererß</unclear></persName> seligen <unclear cert="medium" resp="#joint">letst</unclear>
<lb n="10"/>verstorbnen <unclear cert="low" resp="#joint">kindts</unclear> <unclear cert="low" resp="#joint">zeitliche</unclear> <unclear cert="low" resp="#joint">verlaßenschaft</unclear>, wir <unclear cert="medium" resp="#joint">vor</unclear>
<lb n="11"/>dem <unclear cert="medium" resp="#joint">nechstvorstehenden</unclear> <date resp="#ner">heiligen <unclear cert="low" resp="#joint">wienächt</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">fest</unclear></date> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">koennen</unclear> zuo <unclear cert="low" resp="#joint">endtschaft</unclear> bringen, <unclear cert="low" resp="#joint">guoter</unclear> hoffnung,
<lb n="13"/><unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">daßselbige</unclear> schreiben wol werde <unclear cert="medium" resp="#joint">eÿngeliffert</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">worden</unclear> <unclear cert="medium" resp="#joint">seÿn</unclear>.
<lb n="15"/><unclear cert="medium" resp="#joint">Volgends</unclear> <unclear cert="medium" resp="#joint">tags</unclear> ist die <unclear cert="medium" resp="#joint">eüwere</unclear> weiland <persName resp="#ner">Fridli <unclear cert="medium" resp="#joint">Aeblis</unclear></persName>
<lb n="16"/>seligen <unclear cert="medium" resp="#joint">verlaßne</unclear> <unclear cert="medium" resp="#joint">witib</unclear>, mit schreiben <unclear cert="medium" resp="#joint">befünderungs=</unclear>
<lb n="17"/>schriben an <unclear cert="medium" resp="#joint">unß</unclear>, alhie angelangt, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">wir</unclear> in
<lb n="18"/>ihrem <unclear cert="low" resp="#joint">fürbringen</unclear>, <unclear cert="low" resp="#joint">samt</unclear> <unclear cert="low" resp="#joint">angeregtem</unclear> <unclear cert="low" resp="#joint">mitgebrachtem</unclear>
<lb n="19"/>schreiben; wie auch <unclear cert="medium" resp="#joint">unßeren</unclear> <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben
<lb n="20"/>stattschreiberen <persName resp="#ner"><unclear cert="medium" resp="#joint">Guldi</unclear></persName>, <unclear cert="medium" resp="#joint">samt</unclear> seinen <unclear cert="medium" resp="#joint">geschwüstrigten</unclear>,
<lb n="21"/>und anderen, <unclear cert="low" resp="#joint">welche</unclear> <unclear cert="low" resp="#joint">dißes</unclear> erb <unclear cert="low" resp="#joint">anzuosprächen</unclear> ver=
<lb n="22"/><unclear cert="medium" resp="#joint">meinen</unclear> <unclear cert="medium" resp="#joint">befuegt</unclear> <unclear cert="medium" resp="#joint">seÿn</unclear>, in ihrem <unclear cert="low" resp="#joint">gegenbericht</unclear> nach
<lb n="23"/><unclear cert="low" resp="#joint">lengß</unclear> <unclear cert="low" resp="#joint">angehört</unclear>.
<lb n="24"/><unclear cert="low" resp="#joint">Wann</unclear> nun <unclear cert="medium" resp="#joint">beid</unclear> <unclear cert="medium" resp="#joint">theil</unclear> sich auf <unclear cert="medium" resp="#joint">unßer</unclear> statt verschriben
<lb n="25"/>recht <unclear cert="medium" resp="#joint">referieren</unclear>, und aber wir so wol auß <unclear cert="medium" resp="#joint">eüweren</unclear>
<lb n="26"/>an <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">abgangnem</unclear> schreiben, <unclear cert="medium" resp="#joint">alß</unclear> auch auß der <unclear cert="medium" resp="#joint">frauwen</unclear>,
<lb n="27"/><unclear cert="medium" resp="#joint">beschechnem</unclear> <unclear cert="medium" resp="#joint">fürbringen</unclear> <unclear cert="medium" resp="#joint">müeßend</unclear> abnemen, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">frauw</unclear>, und wol so bald Ihr <orgName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">U</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">Eydtgnossen</unclear></orgName>
<lb n="29"/>selbst, was <unclear cert="low" resp="#joint">daßselbige</unclear> <unclear cert="low" resp="#joint">außweiße</unclear>, und <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">halte</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">vileicht</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">etwaß</unclear> <unclear cert="low" resp="#joint">ungleich</unclear> <unclear cert="low" resp="#joint">möchten</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">underrichtet</unclear> worden <unclear cert="low" resp="#joint">seÿen</unclear>; welches in <unclear cert="medium" resp="#joint">welchem</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">andere</unclear> oberkeiten erbrecht <unclear cert="low" resp="#joint">hindan</unclear> <unclear cert="low" resp="#joint">außbedingt</unclear>
<lb n="33"/>und mit solchem <unclear cert="medium" resp="#joint">underschied</unclear> vorbehalten ist, <unclear cert="medium" resp="#joint">daß</unclear>
<pb facs="StadtASG_Missive_1922_7158.jpg" n="2"/>
<lb n="34"/>wie und wo solliche erbfaell, wie die in unserem erb-
<lb n="35"/>recht <unclear cert="low" resp="#joint">nacheinanderen</unclear> <unclear cert="low" resp="#joint">gesezt</unclear> sind, ander leüt dann bur-
<lb n="36"/>ger gegen burger <unclear cert="low" resp="#joint">antrifft</unclear>, wie dann die erbschafft
<lb n="37"/>in disem fahl, an <unclear cert="low" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">orthen</unclear> <unclear cert="low" resp="#joint">allen</unclear>-
<lb n="38"/><unclear cert="low" resp="#joint">halben</unclear> gegen unseren burgeren gehalten, und dessen
<lb n="39"/><unclear cert="low" resp="#joint">gleüblich</unclear> <unclear cert="low" resp="#joint">urkhund</unclear> <unclear cert="low" resp="#joint">erscheint</unclear> <unclear cert="low" resp="#joint">wirt</unclear>, <unclear cert="low" resp="#joint">alßdann</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">soelle</unclear> es beÿ uns auch also gehalten werden.
<lb n="41"/>So haben wir nit woellen ermanglen, <unclear cert="low" resp="#joint">eüch</unclear> <orgName ref="stadtasg-actors-1123" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">U</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>.
<lb n="42"/><unclear cert="low" resp="#joint">Eidtgenoßen</unclear></orgName>, deßen hiemit widerumb (: inmaßen vor
<lb n="43"/>disem zum theil auch <unclear cert="low" resp="#joint">beschehen</unclear> :) und zwar <unclear cert="low" resp="#joint">dißmal</unclear> <unclear cert="low" resp="#joint">umb</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">deütlicher</unclear> (: wie albereit gehoert ist :) zube-
<lb n="45"/>richten.
<lb n="46"/>Sidmalen dann krafft dißers unsers habenden alten
<lb n="47"/>stattrechtens, aller hafft auf dem gegenrecht
<lb n="48"/><unclear cert="low" resp="#joint">beruowet</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">namen</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">dem</unclear>: Wann gegenwürtiger fall beÿ eüch in
<lb n="49"/>euwerem land were beschehen, ob dann <unclear cert="low" resp="#joint">euwere</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">landtmaenin</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Fridli</unclear> <unclear cert="low" resp="#joint">Ueblis</unclear></persName> <unclear cert="low" resp="#joint">wittib</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="51"/><unclear cert="low" resp="#joint">storbenen</unclear> <unclear cert="low" resp="#joint">kinds</unclear> <unclear cert="low" resp="#joint">großmuoter</unclear> <unclear cert="low" resp="#joint">vom</unclear> <unclear cert="low" resp="#joint">muoter</unclear> <unclear cert="low" resp="#joint">maag</unclear>, den
<lb n="52"/>freünden und verwandten vom vatter <unclear cert="low" resp="#joint">maag</unclear> (: <unclear cert="low" resp="#joint">wenn</unclear>
<lb n="53"/>dieselbe auch euwere landtleüt weren :) in der
<lb n="54"/>erbschafft vorgezogen; und so füro künfftig unsere
<lb n="55"/>burger in wolgemeltem euwerem land <unclear cert="low" resp="#joint">zuoerben</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">hetten</unclear>, daß <unclear cert="low" resp="#joint">alßdann</unclear> <unclear cert="low" resp="#joint">unsere</unclear> burger
<lb n="57"/><unclear cert="low" resp="#joint">großvaetter</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">groß</unclear>-
<lb n="58"/><unclear cert="low" resp="#joint">muoteren</unclear>,
<lb n="59"/><unclear cert="low" resp="#joint">vom</unclear> <unclear cert="low" resp="#joint">muoter</unclear> <unclear cert="low" resp="#joint">maag</unclear>, <unclear cert="low" resp="#joint">euweren</unclear> <unclear cert="low" resp="#joint">landtleüten</unclear> <unclear cert="low" resp="#joint">vom</unclear> vatter
<lb n="60"/>maag in gleichem grad und <unclear cert="low" resp="#joint">linj</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">gebluets</unclear>, wie
<lb n="61"/><unclear cert="low" resp="#joint">gemelter</unclear> unser stattschreiber und
<lb n="62"/>mithaffte in gegenwürtigem fall <unclear cert="low" resp="#joint">sind</unclear>, und gleich also
<lb n="63"/>gleicher gstalt fürgesezt und vorgezogen wurden,
<lb n="64"/><unclear cert="low" resp="#joint">inmaßen</unclear> <unclear cert="low" resp="#joint">euwere</unclear> <unclear cert="low" resp="#joint">landtmaenin</unclear> <unclear cert="low" resp="#joint">anjezo</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">unseren</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">vorgezogen</unclear> <unclear cert="low" resp="#joint">zuowerden</unclear> begeren thuot:
<lb n="66"/>Alß haben wir ihro auferlegt, abschrifft und glaub-
<lb n="67"/>würdig schein und urkund <unclear cert="low" resp="#joint">euwers</unclear> <unclear cert="low" resp="#joint">verschreibnen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">bißhar</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">geübten</unclear> <unclear cert="low" resp="#joint">landtrechtens</unclear>,
<lb n="69"/>und wie es in gleichem fall, beÿ eüch im gegen-
<lb n="70"/>rechten gegen den unseren gehalten werde, <unclear cert="low" resp="#joint">auß</unclear>-
<pb facs="StadtASG_Missive_1922_7159.jpg" n="3"/>
<lb n="71"/><unclear cert="low" resp="#joint">zuebringen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">uns</unclear>, <unclear cert="low" resp="#joint">auf</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">donstag</unclear> nach <unclear cert="low" resp="#joint">Hilarii</unclear>, <unclear cert="low" resp="#joint">das</unclear>
<lb n="72"/><unclear cert="low" resp="#joint">nechsteingeheden</unclear>. 1615.
<lb n="73"/>jars</date> (welchen tag wir
<lb n="74"/>hiemit zur eroerterung
<lb n="75"/>deß geschäfts hiemit
<lb n="76"/>ernennt haben.)
<lb n="77"/><unclear cert="low" resp="#joint">besiglet</unclear> <unclear cert="low" resp="#joint">aufzulegen</unclear>.
<lb n="78"/>Welches wir euch unseren getreüwen lieben <orgName role="recipient" resp="#ner">Eydtgnossen</orgName>
<lb n="79"/>hiemit auch <unclear cert="low" resp="#joint">zuewüssen</unclear> thun, auch darbey sie der freundt-
<lb n="80"/>schafft, wie die unseren dem verstorbnen kind verwandt sind,
<lb n="81"/>als namlich daß unsers stattschreibers vatter, und
<lb n="82"/><persName resp="#ner">Samuel Laderers</persName> mueter rechte leibliche geschwüstrigte
<lb n="83"/>gewesen, zu <unclear cert="low" resp="#joint">besserer</unclear> <unclear cert="low" resp="#joint">nachrichtung</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">ebenmessig</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="84"/><unclear cert="low" resp="#joint">ständigen</unclear> <unclear cert="low" resp="#joint">wellen</unclear>.
<lb n="85"/><unclear cert="low" resp="#joint">Nach</unclear> <unclear cert="low" resp="#joint">dem</unclear> nun <unclear cert="low" resp="#joint">mehegedachte</unclear> <unclear cert="low" resp="#joint">witib</unclear> disen angeregten
<lb n="86"/>schein und urkund vor uns wirt fuergewisen haben,
<lb n="87"/>so moegen und wellend Ihr u. g. l. <orgName role="recipient" resp="#ner">Eydtgnossen</orgName>
<lb n="88"/>uns gantzlich und wol zuetrawen, daß
<lb n="89"/>wir der <unclear cert="low" resp="#joint">eüweren</unclear> <unclear cert="low" resp="#joint">Landtmaennin</unclear> wider billigkeit und recht nichts
<lb n="90"/>werden begegnen, sonder alles das jehnige werden
<lb n="91"/>widerfahren lassen, was ihro nach außweisung
<lb n="92"/>angeregts unsers stattrechtens und von aller
<lb n="93"/>billigkeit wegen zuegehoerig seyn wirt; darunder
<lb n="94"/>dann auch dem innhalt der <unclear cert="low" resp="#joint">pundtsbrieffen</unclear>
<lb n="95"/>(<unclear cert="low" resp="#joint">darauf</unclear> in <unclear cert="low" resp="#joint">eüwerem</unclear> <unclear cert="low" resp="#joint">schreiben</unclear> <unclear cert="low" resp="#joint">anregung</unclear> <unclear cert="low" resp="#joint">geschicht</unclear>)
<lb n="96"/><unclear cert="low" resp="#joint">zuewider</unclear> und <unclear cert="low" resp="#joint">entgegen</unclear> <unclear cert="low" resp="#joint">gar</unclear> <unclear cert="low" resp="#joint">gantzlich</unclear> nichts solle
<lb n="97"/>fuergehn; als die, nebend anderem, auch außtrucken-
<lb n="98"/>lich zue dem end aufgerichtet und geschworen sind, daß
<lb n="99"/>jeder theil bey seinem landt- und stattrechten
<lb n="100"/>geschirmt und gehandthabet werden solle.
<lb n="101"/>Und worinnen wir euch u. g. l. <orgName role="recipient" resp="#ner">Eydtgnossen</orgName>,
<lb n="102"/>und den ihrigen, wir in die und ander weg, allen
<lb n="103"/>eydtgnoßischen willen, ehr, freündschafft und
<lb n="104"/>dienstwilligkeit, zue fordtpflantzung der bishar
<lb n="105"/>beharreten gueten verstendtnus, koennen erzeigen,
<lb n="106"/>darzu erbieten wir uns so willig, als wir
<lb n="107"/>wünschen daß Gott der allmächtig uns
<lb n="108"/>beiderseits in friedlichem wolstand lange zeit
<lb n="109"/>welle erhalten. Datum den <origDate when="1614" resp="#ner">24. <unclear cert="low" resp="#joint">t</unclear>. novembris
<lb n="110"/>a.o 1614</origDate>.
<lb n="111"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und <unclear cert="low" resp="#joint">rath</unclear> <unclear cert="low" resp="#joint">etc</unclear>.</orgName>
<lb n="112"/>An die von <orgName ref="stadtasg-actors-502" cert="medium" role="recipient" resp="#ner">Glarus</orgName>.
<pb facs="StadtASG_Missive_1922_7160.jpg" n="4"/>
<lb n="113"/>[]
</p>
