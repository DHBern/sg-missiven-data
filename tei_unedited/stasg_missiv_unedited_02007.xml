<pb facs="StadtASG_Missive_2007_7489.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unßer</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear> willig <unclear cert="medium" resp="#joint">dienßt</unclear>, und was wir
<lb n="2"/><unclear cert="medium" resp="#joint">mehr</unclear> ehren liebs und <unclear cert="medium" resp="#joint">guets</unclear> vermögen, <unclear cert="medium" resp="#joint">zuvor</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">fürsichtige</unclear>, <unclear cert="medium" resp="#joint">ehrsame</unclear>, und <unclear cert="medium" resp="#joint">weiße</unclear>, <unclear cert="medium" resp="#joint">beßonders</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">freünd</unclear> und <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">nachbaurn</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Göstern</unclear> <unclear cert="medium" resp="#joint">abents</unclear> ist ein <unclear cert="low" resp="#joint">Sülzischer</unclear> <unclear cert="low" resp="#joint">fendrich</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">hieher</unclear> <unclear cert="low" resp="#joint">gelangt</unclear>, <unclear cert="low" resp="#joint">welcher</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">fürweißung</unclear>
<lb n="7"/>der <unclear cert="medium" resp="#joint">patenten</unclear>, so <unclear cert="medium" resp="#joint">wir</unclear> in der <unclear cert="medium" resp="#joint">eil</unclear> <unclear cert="medium" resp="#joint">lautt</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">inschluß</unclear> <unclear cert="medium" resp="#joint">abcopirn</unclear> <unclear cert="medium" resp="#joint">laßen</unclear>, <unclear cert="medium" resp="#joint">umb</unclear> den <unclear cert="medium" resp="#joint">umb</unclear>-
<lb n="9"/>schlag angehalten. Demnach <unclear cert="medium" resp="#joint">aber</unclear> <unclear cert="medium" resp="#joint">unßer</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">ambtstragender</unclear> burgermaister <unclear cert="medium" resp="#joint">ine</unclear>
