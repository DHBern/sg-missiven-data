<lb n="12"/><unclear cert="medium" resp="#joint">beschiden</unclear>, ist er <unclear cert="medium" resp="#joint">doch</unclear> nit <unclear cert="medium" resp="#joint">erschinen</unclear>, sonder
<lb n="13"/>mit <unclear cert="low" resp="#joint">ungedult</unclear> <unclear cert="low" resp="#joint">alßbald</unclear> <unclear cert="low" resp="#joint">fort</unclear> <unclear cert="low" resp="#joint">naher</unclear>
<lb n="14"/><placeName ref="stadtasg-places-243" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Merspurg</unclear></placeName> gezogen, und <unclear cert="medium" resp="#joint">fangen</unclear> an etliche
<lb n="15"/>knecht sich <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">zuezeigen</unclear>, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">mainung</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">naher</unclear> <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Roschach</unclear></placeName> <unclear cert="low" resp="#joint">überzueschiffen</unclear>, die aber
<lb n="17"/><unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="medium" resp="#joint">bißher</unclear>, <unclear cert="medium" resp="#joint">uffgehalten</unclear> <unclear cert="medium" resp="#joint">worden</unclear>, welches
<lb n="18"/>wir <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">abermaln</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">nachrichtung</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">verthreülich</unclear> <unclear cert="low" resp="#joint">anfuegen</unclear> <unclear cert="low" resp="#joint">wöllen</unclear>, <unclear cert="low" resp="#joint">dero</unclear>-
<lb n="20"/><unclear cert="low" resp="#joint">selben</unclear> <unclear cert="low" resp="#joint">pleiben</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">zu</unclear> allen <unclear cert="medium" resp="#joint">nachbarlichen</unclear>
<lb n="21"/>diensten <unclear cert="low" resp="#joint">beraitwillig</unclear>, <unclear cert="low" resp="#joint">Götlichen</unclear> <unclear cert="low" resp="#joint">obhalt</unclear>
