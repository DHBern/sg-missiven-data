    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2602_10095.jpg" n="1"/>
<lb n="1"/>Unser freündt, nachbarlich willig dienst
<lb n="2"/>und gruoß, zuvor, edler ehrenvester weiser, be-
<lb n="3"/>sonders lieber herr <unclear cert="low" resp="#joint">landtvogt</unclear>, guoter freündt
<lb n="4"/>und nachbar.
<lb n="5"/>Was seins ambtsangehoerige, die ehrbare teütschelche
<lb n="6"/>drei gemeindts und <unclear cert="low" resp="#joint">hoeff</unclear> <placeName ref="stadtasg-places-116" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Margretha</unclear></placeName>, <placeName ref="stadtasg-places-295" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Thal</unclear></placeName>,
<lb n="7"/><unclear cert="low" resp="#joint">Undergraffen</unclear> und <placeName ref="stadtasg-places-362" cert="medium" resp="#ner">Lochbach</placeName> uff <placeName ref="stadtasg-places-348" cert="medium" resp="#ner">St. Joachimo</placeName>
<lb n="8"/>betreffende <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">gewonlichen</unclear> <unclear cert="low" resp="#joint">wein</unclear> <unclear cert="low" resp="#joint">lauff</unclear>, <unclear cert="low" resp="#joint">beschwärdt</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">weiß</unclear> <unclear cert="low" resp="#joint">füerbracht</unclear>, haben wir uß deß <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">ihrent</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">wegen</unclear> an uns abgangnem schreiben mit mehrerm
<lb n="11"/>verstanden, und gleichwol mit etwas befrembdung
<lb n="12"/>verstanden.
<lb n="13"/>Nun koennen wir dem herren nachbarlich wolmei-
<lb n="14"/>nung nit bergen, daß wir uns <date resp="#ner">a° 1618.</date> mit
<lb n="15"/><unclear cert="low" resp="#joint">welchen</unclear> <unclear cert="low" resp="#joint">vergleich</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">oberen</unclear> <unclear cert="low" resp="#joint">vier</unclear> <unclear cert="low" resp="#joint">hoeffen</unclear> <placeName ref="stadtasg-places-11" cert="medium" resp="#ner">Altstetten</placeName>, <placeName ref="stadtasg-places-122" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Marbach</unclear></placeName>,
<lb n="16"/><unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">Eidtgnossen</unclear>, <unclear cert="low" resp="#joint">die</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Regierende</unclear> <unclear cert="low" resp="#joint">orth</unclear> <unclear cert="low" resp="#joint">deß</unclear> <orgName ref="stadtasg-actors-514" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rin</unclear>- <unclear cert="low" resp="#joint">Bernang</unclear></orgName> und <placeName ref="stadtasg-places-119" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Balgach</unclear></placeName>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">neüwen</unclear> <orgName resp="#ner"><unclear cert="low" resp="#joint">wein</unclear>-
<lb n="18"/><unclear cert="low" resp="#joint">thals</unclear></orgName>, <unclear cert="low" resp="#joint">füer</unclear> <unclear cert="low" resp="#joint">zimlich</unclear>, <unclear cert="low" resp="#joint">bil</unclear>-
<lb n="19"/><unclear cert="low" resp="#joint">lig</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unverweißlich</unclear> <unclear cert="low" resp="#joint">lauffs</unclear> <unclear cert="low" resp="#joint">halber</unclear>, von neüwem, uf. <date resp="#ner">25. jahr</date> verglichen
<lb n="20"/><unclear cert="low" resp="#joint">erkennt</unclear>, und <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">biß</unclear> <date resp="#ner">6. jahren</date> her, uns jederzeit <unclear cert="low" resp="#joint">eines</unclear> <unclear cert="low" resp="#joint">gebüerlichen</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">confirmiert</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">unklagbaren</unclear> <unclear cert="low" resp="#joint">lauffs</unclear> in aller freündtligkeit ver-
<lb n="22"/><unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">fürnembliche</unclear> <unclear cert="low" resp="#joint">mandata</unclear> <unclear cert="low" resp="#joint">einbaren</unclear> <unclear cert="low" resp="#joint">koennen</unclear>, <unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">verschinen</unclear> <date resp="#ner">1625. jahr</date>,
<lb n="23"/><unclear cert="low" resp="#joint">gleichsamb</unclear> <unclear cert="low" resp="#joint">uferzoge</unclear>. hat es sich etwas gestossen, daran aber wir beym
<lb n="24"/>wenigsten kein schuld tragen, sonder unßern wir
<lb n="25"/>gegen den abgesandten der gedachten vier <unclear cert="low" resp="#joint">hoeffen</unclear>
<lb n="26"/>und <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">entgegen</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">massen</unclear> <unclear cert="low" resp="#joint">erclärt</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">eingelassen</unclear>, daß
<lb n="27"/><unclear cert="low" resp="#joint">geschickte</unclear> sie wol hetten daran koennen muessen, und sich
<lb n="28"/>deß costens gar nit bedoeffen, weil aber
<lb n="29"/>sie wider unsern willen, so gar strackh und ein-
<lb n="30"/>lendig darruf getrungen, haben wirs ohn gschehen
<lb n="31"/>lassen muessen, wir hoffen aber es werde
<lb n="32"/>ob gott will, so bald nit mehr darzuo
<lb n="33"/>komen, sondern uns, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">vorhar</unclear> <unclear cert="low" resp="#joint">beschehen</unclear>,
<lb n="34"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">einanderen</unclear> in aller <unclear cert="low" resp="#joint">freündligkeit</unclear> <unclear cert="low" resp="#joint">vergleichen</unclear>
<lb n="35"/>und <unclear cert="low" resp="#joint">meniglich</unclear> sich <unclear cert="low" resp="#joint">da</unclear>- <unclear cert="low" resp="#joint">koennen</unclear>. <unclear cert="low" resp="#joint">Das</unclear> <unclear cert="low" resp="#joint">begehren</unclear> <unclear cert="low" resp="#joint">aber</unclear> der
<lb n="36"/><unclear cert="low" resp="#joint">ran</unclear> <unclear cert="low" resp="#joint">ersettige</unclear>.
<pb facs="StadtASG_Missive_2602_10096.jpg" n="2"/>
<lb n="37"/>gesagter <unclear cert="low" resp="#joint">Andern</unclear> <unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">tochter</unclear> belangende, hetten
<lb n="38"/>wir zwar wol <unclear cert="medium" resp="#joint">gehoft</unclear> und <unclear cert="medium" resp="#joint">vermeint</unclear>, sie <unclear cert="low" resp="#joint">wurd</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">by</unclear> dem vrthel haben ersettigen lassen, und
<lb n="40"/><unclear cert="low" resp="#joint">fehrner</unclear> <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">vrthel</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">verglich</unclear> <unclear cert="low" resp="#joint">halten</unclear> und
<lb n="42"/><unclear cert="low" resp="#joint">leben</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">orhts</unclear> <unclear cert="low" resp="#joint">kein</unclear> <unclear cert="low" resp="#joint">neuwerung</unclear> <unclear cert="low" resp="#joint">sonderstohn</unclear> <unclear cert="low" resp="#joint">fuerzu</unclear>-
<lb n="44"/><unclear cert="low" resp="#joint">nemmen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">darmit</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">wiewohl</unclear> <unclear cert="low" resp="#joint">aber</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">freuendt</unclear> nach-
<lb n="47"/>barlich ersuechend, er wolle sie dahin vermanen
<lb n="48"/>daß si es von ihrem intention <unclear cert="low" resp="#joint">abstende</unclear>,
<lb n="49"/><unclear cert="low" resp="#joint">mir</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">solcher</unclear> <unclear cert="low" resp="#joint">vrthl</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">bruhen</unclear> <unclear cert="low" resp="#joint">mechten</unclear> <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="51"/>so <unclear cert="low" resp="#joint">fehr</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">ihrne</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="53"/><unclear cert="low" resp="#joint">fehr</unclear> <unclear cert="low" resp="#joint">hin</unclear>
<lb n="54"/>und aber sie wider <unclear cert="low" resp="#joint">verhoffen</unclear>, <unclear cert="low" resp="#joint">nochmals</unclear> <unclear cert="low" resp="#joint">daruf</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">wurde</unclear> wollen verharren, sind wir erbuetig sie
<lb n="56"/><unclear cert="low" resp="#joint">vf</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">eidts</unclear>, <unclear cert="low" resp="#joint">wo</unclear>,
<lb n="57"/><unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">getultet</unclear> <unclear cert="low" resp="#joint">wirt</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">beschwerd</unclear>, worinnen sie sich beschwerdt
<lb n="59"/>befinden wurdet, gern selbst <unclear cert="low" resp="#joint">anzuhören</unclear>, und
<lb n="60"/><unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">wohl</unclear> mit <unclear cert="low" resp="#joint">gebuerendem</unclear> bscheidt begegnen,
<lb n="61"/>das <unclear cert="low" resp="#joint">wolten</unclear> wir dem herrn zu seiner ambts-
<lb n="62"/>angehörig nachrichtet nit bergen, und verbleiben
<lb n="63"/>demselben zu aller <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">nachbarschaft</unclear> wol
<lb n="64"/><unclear cert="low" resp="#joint">zugethun</unclear>, <unclear cert="low" resp="#joint">domit</unclear> uns <unclear cert="low" resp="#joint">samptlich</unclear> dem lieben
<lb n="65"/>Gott befelhende. dath den <origDate when="1626" resp="#ner">24 <unclear cert="low" resp="#joint">El</unclear>. Junij
<lb n="66"/>1626</origDate>.
<lb n="67"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und <unclear cert="medium" resp="#joint">rhat</unclear>
<lb n="68"/>der statt Sant Gallen</orgName>.
<lb n="69"/>Dem edlen ehrenuesten weisen
<lb n="70"/><persName role="recipient" resp="#ner">Balthasar von Ott</persName> deß rhats
<lb n="71"/>zu <placeName ref="stadtasg-places-72" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Vnderwalden</unclear></placeName>, <unclear cert="low" resp="#joint">landtuogt</unclear> im <unclear cert="low" resp="#joint">vndern</unclear>
<lb n="72"/><unclear cert="medium" resp="#joint">vnd</unclear> obern <placeName ref="stadtasg-places-64" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rhinthal</unclear></placeName>, <unclear cert="low" resp="#joint">vnserm</unclear> besonders
<lb n="73"/>lieben herren <unclear cert="medium" resp="#joint">vnd</unclear> nachbaren.
<pb facs="StadtASG_Missive_2602_10097.jpg" n="3"/>
<lb n="74"/><unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">dise</unclear> nachbarliche verständtnuß, und ußspruch <unclear cert="low" resp="#joint">deß</unclear>
<lb n="75"/><unclear cert="low" resp="#joint">weinkauffs</unclear> <unclear cert="low" resp="#joint">zwischen</unclear> <unclear cert="low" resp="#joint">unß</unclear> und den mehrgehoerten vier obern
<lb n="76"/>hoeffen, khein nüews sonder ein alts, und wir beid theil
<lb n="77"/><unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">ihnen</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="78"/><unclear cert="low" resp="#joint">füert</unclear> <unclear cert="low" resp="#joint">un</unclear>
<lb n="79"/>derselben jecz in die <unclear cert="low" resp="#joint">anderthalbhundert</unclear> und mehr jahr
<lb n="80"/>mit einanderen genoßt haben, und sich die andern hoeff
<lb n="81"/>desselben oft ersettig und <unclear cert="low" resp="#joint">vernüegt</unclear> <unclear cert="low" resp="#joint">müßen</unclear>, <unclear cert="low" resp="#joint">sozmal</unclear>
<lb n="82"/><unclear cert="low" resp="#joint">unß</unclear> an <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">wein</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">jahr</unclear> den <unclear cert="low" resp="#joint">costen</unclear>, nach
<lb n="83"/><unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">lauff</unclear>, <unclear cert="low" resp="#joint">bißheär</unclear> <unclear cert="low" resp="#joint">erstatten</unclear> <unclear cert="low" resp="#joint">müeßen</unclear> <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="84"/><unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">5</unclear> <unclear cert="low" resp="#joint">bcz</unclear>. <unclear cert="low" resp="#joint">neher</unclear> <unclear cert="low" resp="#joint">geltn</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="85"/><unclear cert="low" resp="#joint">wie</unclear> den herren
<pb facs="StadtASG_Missive_2602_10098.jpg" n="4"/>
<lb n="86"/><origDate when="1626-06-24" resp="#ner">24. juny 1626</origDate>. an h. landvogt im
<lb n="87"/><placeName ref="stadtasg-places-64" cert="medium" resp="#ner">Rhinthal</placeName> betref. diß weinlauff.
</p>
