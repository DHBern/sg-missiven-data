<lb n="26"/><unclear cert="medium" resp="#joint">spüeren</unclear>. <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">furpitt</unclear> genossen haben. <unclear cert="low" resp="#joint">Das</unclear> <unclear cert="low" resp="#joint">stadt</unclear>
