<lb n="31"/>unnser <unclear cert="medium" resp="#joint">verwarrt</unclear> unnd geben. <origDate when="1563" cert="medium" resp="#ner">uff den <unclear cert="medium" resp="#joint">letsten</unclear> tag <unclear cert="medium" resp="#joint">July</unclear>.
<lb n="32"/>anno etc. <unclear cert="medium" resp="#joint">lxiii</unclear>.</origDate>
<lb n="33"/><unclear cert="medium" resp="#joint">U</unclear>. W.
<lb n="34"/><unclear cert="medium" resp="#joint">Den</unclear> Stett unnd Lannden der <unclear cert="medium" resp="#joint">hochgeachten</unclear>
<lb n="35"/><unclear cert="medium" resp="#joint">unnser</unclear> <orgName ref="stadtasg-actors-750" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoschaft</unclear> rath und <unclear cert="medium" resp="#joint">sanndt</unclear>
