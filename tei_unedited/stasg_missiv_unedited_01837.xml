    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1837_6817.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freundtlich</unclear> dienst unnd <unclear cert="medium" resp="#joint">waß</unclear> wir
<lb n="2"/><unclear cert="medium" resp="#joint">liebs</unclear> unnd guets <unclear cert="medium" resp="#joint">vermoegen</unclear> <unclear cert="medium" resp="#joint">zuevor</unclear>, Edel, From,
<lb n="3"/>Ehrnvest, <unclear cert="medium" resp="#joint">Fuersich</unclear> und <unclear cert="medium" resp="#joint">weiß</unclear>, <unclear cert="medium" resp="#joint">insunders</unclear> liebe
<lb n="4"/>unnd guete <unclear cert="medium" resp="#joint">Freund</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Eß</unclear> hat vor <unclear cert="medium" resp="#joint">aim</unclear> <unclear cert="medium" resp="#joint">jar</unclear> ungefahr ain <unclear cert="medium" resp="#joint">weberknap</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">so</unclear> sich <persName resp="#ner"><unclear cert="low" resp="#joint">Sebastian</unclear> <unclear cert="low" resp="#joint">Horger</unclear></persName> genant, welcher
<lb n="7"/><unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. burger auch diser zeit in derselben
<lb n="8"/><unclear cert="medium" resp="#joint">stat</unclear> sein soll, unsers burgers <persName resp="#ner">Barthlome
<lb n="9"/><unclear cert="low" resp="#joint">Appolonia</unclear></persName> <unclear cert="low" resp="#joint">gnant</unclear>, <unclear cert="low" resp="#joint">Schedlers</unclear> tochter <unclear cert="medium" resp="#joint">geschwengert</unclear>, und ir ain
<lb n="10"/>kind befolhen, <unclear cert="medium" resp="#joint">folgents</unclear> darvon gezogen,
<lb n="11"/>und sie mit dem kind ohn allen abtrag <unclear cert="medium" resp="#joint">sizen</unclear>
<lb n="12"/>lassen, Wann es dann <unclear cert="medium" resp="#joint">ain</unclear> sehr <unclear cert="medium" resp="#joint">arme</unclear>
<lb n="13"/>tochter, die von vater und <unclear cert="medium" resp="#joint">mueter</unclear> deß
<lb n="14"/><unclear cert="medium" resp="#joint">wenigest</unclear> nit <unclear cert="medium" resp="#joint">zuegewarten</unclear>, sonder sich mit
<lb n="15"/>disem kind deß <unclear cert="medium" resp="#joint">heyligen</unclear> <unclear cert="medium" resp="#joint">allmuessens</unclear>
<lb n="16"/>behelfen <unclear cert="medium" resp="#joint">muessen</unclear>, <unclear cert="medium" resp="#joint">Alß</unclear> haben ire eltern
<lb n="17"/>unß ganz <unclear cert="medium" resp="#joint">flehenlich</unclear> gebeten, <unclear cert="medium" resp="#joint">bej</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>.
<lb n="18"/><unclear cert="medium" resp="#joint">nachbaurlich</unclear> zue <unclear cert="medium" resp="#joint">intercedieren</unclear>, damit sie
<lb n="19"/><unclear cert="medium" resp="#joint">bemeltem</unclear> irem <unclear cert="medium" resp="#joint">burgern</unclear> alles <unclear cert="medium" resp="#joint">ernsts</unclear> <unclear cert="medium" resp="#joint">ver=</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">schaften</unclear>, daß er <unclear cert="medium" resp="#joint">daß</unclear> von ime <unclear cert="medium" resp="#joint">erzeugte</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">kind</unclear> zue sich nemen und <unclear cert="medium" resp="#joint">alimentieren</unclear>,
<lb n="22"/>ir auch der <unclear cert="medium" resp="#joint">schwechung</unclear> halber <unclear cert="medium" resp="#joint">gebuerend</unclear>
<lb n="23"/>abtrag thun, oder sich sonsten mit ihr
<lb n="24"/>nach der billichait <unclear cert="medium" resp="#joint">fuer</unclear> <unclear cert="medium" resp="#joint">alleß</unclear> vertragen
<lb n="25"/><unclear cert="medium" resp="#joint">woelle</unclear>, Welches ir bit wir dann nit
<lb n="26"/><unclear cert="medium" resp="#joint">fuer</unclear> <unclear cert="medium" resp="#joint">unzimblich</unclear> gehalten.
<lb n="27"/><unclear cert="medium" resp="#joint">Derowegen</unclear> gelangt an <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. unser
<pb facs="StadtASG_Missive_1837_6818.jpg" n="2"/>
<lb n="28"/>ganz freundtlichs biten, sie woellen von
<lb n="29"/>ambts und obrigkait wegen, <unclear cert="low" resp="#joint">mergedach</unclear>-
<lb n="30"/>tem <persName resp="#ner">Herger</persName> alles ernsts verschaffen, sich di-
<lb n="31"/>ser sachen halber mit obgenanter unserer
<lb n="32"/>burgerin , <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">verhuetung</unclear> anderer unge-
<lb n="33"/>legenhait fuerderlich guetlich abzuefinden und
<lb n="34"/>zueverglichen, daß seind wir in andere
<lb n="35"/>weg <unclear cert="low" resp="#joint">freundtlich</unclear> <unclear cert="low" resp="#joint">zuebeschulden</unclear>, auch <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="36"/><unclear cert="low" resp="#joint">beineben</unclear> <unclear cert="low" resp="#joint">jederzeit</unclear> <unclear cert="low" resp="#joint">angeneme</unclear> dienst zueerwei-
<lb n="37"/>sen urbitig. Datum den <origDate when="1613-04-17" resp="#ner">17. aprilis. a° 1613</origDate>.
<lb n="38"/><orgName ref="stadtasg-actors-533" cert="medium" role="issuer" resp="#ner">Burgermaister unnd
<lb n="39"/>rathe zu Kempten</orgName>.
<pb facs="StadtASG_Missive_1837_6819.jpg" n="3"/>
<pb facs="StadtASG_Missive_1837_6820.jpg" n="4"/>
<lb n="40"/>Den edlen, frommen, <unclear cert="low" resp="#joint">vösten</unclear>, fürsichtigen, <unclear cert="low" resp="#joint">er</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">samen</unclear> und weisen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermaistern</unclear>
<lb n="42"/>und <unclear cert="medium" resp="#joint">Rathe</unclear> der <unclear cert="medium" resp="#joint">stat</unclear> <unclear cert="medium" resp="#joint">Sanct</unclear> Gallen</orgName>,
<lb n="43"/>unsern insonders lieben und <unclear cert="medium" resp="#joint">gueten</unclear>
<lb n="44"/><unclear cert="medium" resp="#joint">freünden</unclear>.
</p>
