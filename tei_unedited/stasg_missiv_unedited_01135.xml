<lb n="46"/>auch dahin weisen, und sich hierinnen der-
<lb n="47"/>massen erzaigen, damit der <unclear cert="low" resp="#joint">unser</unclear> seinem
<lb n="48"/><unclear cert="low" resp="#joint">unzweifclichem</unclear> verhoffen, auch der <unclear cert="medium" resp="#joint">lieben</unclear>
<lb n="49"/>billichgait nach, <unclear cert="low" resp="#joint">diser</unclear> unser <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">zum</unclear> <unclear cert="low" resp="#joint">besten</unclear>
<lb n="50"/>gemainten <unclear cert="medium" resp="#joint">fürschrifft</unclear>, <unclear cert="medium" resp="#joint">würcklich</unclear> ge-
<lb n="51"/><unclear cert="low" resp="#joint">nossen</unclear> <unclear cert="low" resp="#joint">zuhaben</unclear> <unclear cert="low" resp="#joint">spüren</unclear>, und sich <unclear cert="medium" resp="#joint">beriemen</unclear>
