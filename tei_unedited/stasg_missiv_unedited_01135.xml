<lb n="53"/>wir in dergleichen und mehrerm <unclear cert="medium" resp="#joint">zuetragenden</unclear>
<lb n="54"/>fällenn <unclear cert="medium" resp="#joint">frünndtwillig</unclear> <unclear cert="medium" resp="#joint">zubeschulden</unclear> und
<lb n="55"/>zuverdienen, datum den <origDate when="1582-07-31" cert="medium" resp="#ner">31 <unclear cert="low" resp="#joint">julii</unclear> anno <unclear cert="medium" resp="#joint">82</unclear></origDate>
<lb n="56"/><orgName ref="stadtasg-actors-604" cert="medium" role="issuer" resp="#ner">Burgermaister und Rath
<lb n="57"/>zuo Memmingen</orgName>.
<pb facs="StadtASG_Missive_1135_3671.jpg" n="3"/>
