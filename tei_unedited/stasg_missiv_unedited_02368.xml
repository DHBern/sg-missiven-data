    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2368_9075.jpg" n="1"/>
<lb n="1"/>Unser fründtlichen willig dienst, samet waß wir Eeren liebs
<lb n="2"/>und guots vermoegen zuovor, from fürsichtig ersam
<lb n="3"/>wiß insonders guot und getrüw lieb Eydtgnoßen.
<lb n="4"/>Wir vernemen mit <unclear cert="low" resp="#joint">sueßter</unclear> <unclear cert="low" resp="#joint">erfröwung</unclear> von unsern
<lb n="5"/>jüngst zuo <placeName ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Lindouw</unclear></placeName> <unclear cert="low" resp="#joint">ghabten</unclear> <unclear cert="low" resp="#joint">gsandten</unclear>, herren
<lb n="6"/><persName resp="#ner"><unclear cert="low" resp="#joint">Adaam</unclear> <unclear cert="low" resp="#joint">Boenningen</unclear></persName>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">herren</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Friderich</unclear> <unclear cert="low" resp="#joint">Lussi</unclear></persName>,
<lb n="7"/><unclear cert="low" resp="#joint">Nüw</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">alt</unclear> <unclear cert="low" resp="#joint">landtaman</unclear>, <unclear cert="low" resp="#joint">bericht</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">verständiget</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">gstalt</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">derselbigen</unclear> <unclear cert="low" resp="#joint">ire</unclear> <unclear cert="low" resp="#joint">hin</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">reiß</unclear>, <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">alten</unclear> <unclear cert="low" resp="#joint">besten</unclear> <unclear cert="low" resp="#joint">fründen</unclear>,
<lb n="10"/>auch <unclear cert="low" resp="#joint">gethrüwen</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">Eidtgnoßen</unclear>, <unclear cert="low" resp="#joint">hochen</unclear> <unclear cert="low" resp="#joint">Eeren</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">großen</unclear> <unclear cert="low" resp="#joint">Eeren</unclear>, <unclear cert="low" resp="#joint">nebendt</unclear> <unclear cert="low" resp="#joint">darsetzüng</unclear> <unclear cert="low" resp="#joint">großes</unclear> <unclear cert="low" resp="#joint">kostens</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">syge</unclear> <unclear cert="low" resp="#joint">wisen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">erzeigt</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">koennendt</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">erachten</unclear>, daß der glichen wollmeinung sich
<lb n="14"/>so <unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">erstrecken</unclear> <unclear cert="low" resp="#joint">mege</unclear>, <unclear cert="low" resp="#joint">daß</unclear> der unserigen in-
<lb n="15"/>khomendt, harumben dann <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unseren</unclear>
<lb n="16"/>lieben <unclear cert="low" resp="#joint">Eidtgnoßen</unclear> <unclear cert="low" resp="#joint">großen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">fründtlichen</unclear> <unclear cert="low" resp="#joint">danckh</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">sagendt</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">bester</unclear> <unclear cert="low" resp="#joint">Eidtgnoeßischer</unclear> <unclear cert="low" resp="#joint">liebe</unclear>, <unclear cert="low" resp="#joint">uff</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">fründts</unclear> <unclear cert="low" resp="#joint">erclärendt</unclear>, <unclear cert="low" resp="#joint">Ihn</unclear> <unclear cert="low" resp="#joint">widrigen</unclear> <unclear cert="low" resp="#joint">faall</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unseren</unclear> lieben Eidtgnoßen alle beste angenäm
<lb n="20"/>dienst zuo wisen, wo nun wir unß begirenden
<lb n="21"/>anlaßes erwhoren haben.
<lb n="22"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">gethrüwen</unclear> lieben <unclear cert="low" resp="#joint">Eidtgnoßen</unclear> haben <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">zuo</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">dießen</unclear> <unclear cert="low" resp="#joint">leidigen</unclear> und <unclear cert="low" resp="#joint">thüren</unclear> <unclear cert="low" resp="#joint">ziten</unclear>, <unclear cert="low" resp="#joint">dießen</unclear> <unclear cert="low" resp="#joint">anordnung</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">fürsechung</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">gemeinen</unclear> <unclear cert="low" resp="#joint">landen</unclear> <unclear cert="low" resp="#joint">loblichen</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">Eidtgnoßschaft</unclear> <unclear cert="low" resp="#joint">angsteet</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">daraff</unclear> publicieren laßen,
<lb n="26"/>daß kein anckhen, käß ziger und derglichen ge-
<lb n="27"/><unclear cert="low" resp="#joint">schmier</unclear>, <unclear cert="low" resp="#joint">ussert</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">landt</unclear> <unclear cert="low" resp="#joint">geferggenndt</unclear> <unclear cert="low" resp="#joint">noch</unclear> In
<lb n="28"/>in <unclear cert="low" resp="#joint">einichen</unclear> <unclear cert="low" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">verkaufft</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">soelle</unclear>, <unclear cert="low" resp="#joint">eß</unclear> sy <unclear cert="low" resp="#joint">dan</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">sach</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">köüffer</unclear> <unclear cert="low" resp="#joint">allerägen</unclear> <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">Eidtsch</unclear> <unclear cert="low" resp="#joint">statt</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">erlobt</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">soelich</unclear> <unclear cert="low" resp="#joint">geschmir</unclear> <unclear cert="low" resp="#joint">anderist</unclear> wo nit,
<lb n="31"/>dann <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">Eidtgnoßische</unclear> <unclear cert="low" resp="#joint">märckht</unclear> <unclear cert="low" resp="#joint">füeren</unclear> <unclear cert="low" resp="#joint">verkauffen</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">verbruchen</unclear>, und <unclear cert="low" resp="#joint">andergstalt</unclear> <unclear cert="low" resp="#joint">niemanden</unclear> zuo kauffen
<lb n="33"/>ken, da dann wir <unclear cert="low" resp="#joint">ghofft</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">Ieden</unclear> <unclear cert="low" resp="#joint">syen</unclear> <unclear cert="low" resp="#joint">Eidt</unclear>
<lb n="34"/>und glüpt betrachten, und <unclear cert="low" resp="#joint">soelichem</unclear> gnuog <unclear cert="low" resp="#joint">beschehen</unclear>
<pb facs="StadtASG_Missive_2368_9076.jpg" n="2"/>
<lb n="35"/>soellen, do wuerdendt wir <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">gaegentheill</unclear> <unclear cert="low" resp="#joint">verstaend</unclear>-
<lb n="36"/><unclear cert="low" resp="#joint">igendt</unclear>, das solliches uberfhueren, dem gnad <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">eüch</unclear>
<lb n="37"/>unsern lieben Eidtgnossen billigen oberkheijt unnd
<lb n="38"/>landes ußzuegen beschaehen. Da doch wir woll,
<lb n="39"/>glauben moegendt, das solliches alles ohne vorwüssen
<lb n="40"/>euwer unser lieben Eidtgnossen beschaehen, fürnaem-
<lb n="41"/>lichen aber baeten wir liebe Eidtgnossen iro dissere
<lb n="42"/>nachfrag ze halten, daß <unclear cert="low" resp="#joint">Haubtman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear> <unclear cert="low" resp="#joint">Meijer</unclear></persName>
<lb n="43"/>sambt andern mit <unclear cert="low" resp="#joint">intresierten</unclear> <unclear cert="low" resp="#joint">uß</unclear> <placeName ref="stadtasg-places-199" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Toggkenburg</unclear></placeName>
<lb n="44"/><unclear cert="low" resp="#joint">Maendendt</unclear> <unclear cert="low" resp="#joint">wilchen</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">euwrij</unclear> <unclear cert="low" resp="#joint">wochen</unclear> <unclear cert="low" resp="#joint">gefüert</unclear>
<lb n="45"/>haben, denselbigen wider unß bij geschwornen glübt
<lb n="46"/>hocher thüwr soellend verkaufft <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">gefertigend</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">sijn</unclear> <unclear cert="low" resp="#joint">soel</unclear>. <unclear cert="low" resp="#joint">Wan</unclear> dann nun in derglichen dingen <unclear cert="low" resp="#joint">uffsehens</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">zethuen</unclear> <unclear cert="low" resp="#joint">woll</unclear> von noeten, also gelangt und ist ann
<lb n="49"/>eüch unser lieb Eidtgnossen. Unser fründtlich ann-
<lb n="50"/>suechen die woellendt, hierinen solliche anordnung ver-
<lb n="51"/>schaffen, unnd <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">derglichen</unclear> für und ankhon Kaeüffern
<lb n="52"/>zusechen und uffsecher zebstellen erforschen, ob sij
<lb n="53"/>sollichen dingen <unclear cert="low" resp="#joint">nachkhomen</unclear>, <unclear cert="low" resp="#joint">doran</unclear> <unclear cert="low" resp="#joint">man</unclear> <unclear cert="low" resp="#joint">sollem</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">vorhaben</unclear> unß <unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">verstaendigen</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">beschwaert</unclear> zu
<lb n="55"/>sin, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">dann</unclear> wir <unclear cert="low" resp="#joint">ohne</unclear> diß zu eüch unseren
<lb n="56"/>lieben Eidtgnossen unß alles guotten versechendt.
<lb n="57"/>Woellendt dorbij eüch unser lieb <unclear cert="low" resp="#joint">Eidtgnossen</unclear> <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">disem</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">botten</unclear> <unclear cert="low" resp="#joint">unbendt</unclear> <unclear cert="low" resp="#joint">erwartende</unclear> <unclear cert="low" resp="#joint">wilfaerigen</unclear> <unclear cert="low" resp="#joint">ant</unclear>-
<lb n="59"/><unclear cert="low" resp="#joint">wurt</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">sametlichen</unclear> <unclear cert="low" resp="#joint">dem</unclear> lieben Gott
<lb n="60"/>woll beuehlen datij <origDate when="1622" resp="#ner">8 tag Nouembris 1622</origDate>
<lb n="61"/><orgName ref="stadtasg-actors-502" cert="medium" role="issuer" resp="#ner">Landtamman und gantzen gsessnen
<lb n="62"/>Rath zu Glaruß</orgName>.
<pb facs="StadtASG_Missive_2368_9077.jpg" n="3"/>
<pb facs="StadtASG_Missive_2368_9078.jpg" n="4"/>
<lb n="63"/><unclear cert="medium" resp="#joint">Denen</unclear> frommen <unclear cert="medium" resp="#joint">fuersichtigen</unclear> <unclear cert="medium" resp="#joint">ersammen</unclear>
<lb n="64"/>wysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear> und <unclear cert="medium" resp="#joint">Rhathe</unclear>
<lb n="65"/>der Statt <unclear cert="medium" resp="#joint">Sanct</unclear> Gallen</orgName>, <unclear cert="medium" resp="#joint">unse=</unclear>
<lb n="66"/><unclear cert="medium" resp="#joint">rnen</unclear> <unclear cert="medium" resp="#joint">innsonders</unclear> guoten <unclear cert="medium" resp="#joint">fruenden</unclear>,
<lb n="67"/>unnd <unclear cert="medium" resp="#joint">gethruwen</unclear> lieben Eydtgnossen.
</p>
