        <body>
<p>
<pb facs="StadtASG_Missive_1603_5817.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">fründtlich</unclear>, willig <unclear cert="medium" resp="#joint">dinnst</unclear>, sampt was wir
<lb n="2"/><unclear cert="low" resp="#joint">ehren</unclear>, liebs unnd <unclear cert="low" resp="#joint">guets</unclear> vermögen <unclear cert="medium" resp="#joint">zuevor</unclear>, <unclear cert="low" resp="#joint">From</unclear>,
<lb n="3"/>Fürsichtig, <unclear cert="low" resp="#joint">Ehrsamm</unclear>, <unclear cert="low" resp="#joint">Wyß</unclear>, Innsonders <unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">Fründt</unclear>
<lb n="4"/>unnd <unclear cert="low" resp="#joint">gethrüw</unclear> lieb Eydtgnossen.
<lb n="5"/>Unnser <unclear cert="low" resp="#joint">gethrüwer</unclear> lieber burger <persName resp="#ner">Heinrich <unclear cert="low" resp="#joint">Schlosser</unclear></persName>,
<lb n="6"/>hat uns in <unclear cert="low" resp="#joint">underthanigkeit</unclear> berichten lassen, wie
<lb n="7"/><unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">abgeloffner</unclear> <unclear cert="medium" resp="#joint">zytt</unclear> euwerm burger <persName resp="#ner">Caspar
<lb n="8"/><unclear cert="low" resp="#joint">Moser</unclear></persName>, als <unclear cert="low" resp="#joint">bevolmächtigen</unclear> <persName resp="#ner">Anwaldt</persName> auch <unclear cert="medium" resp="#joint">euwers</unclear> burgers
<lb n="9"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Gabriel</unclear> <unclear cert="medium" resp="#joint">Billwillers</unclear></persName>. über die summa und <unclear cert="low" resp="#joint">usstanndt</unclear>,
<lb n="10"/>so er <persName resp="#ner"><unclear cert="low" resp="#joint">Moser</unclear></persName> <unclear cert="low" resp="#joint">ermeltem</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Billwiller</unclear></persName> schuldig <unclear cert="medium" resp="#joint">gewessen</unclear>,
<lb n="11"/>15. fl. und etlich <unclear cert="low" resp="#joint">krützer</unclear> <unclear cert="low" resp="#joint">ahn</unclear> <unclear cert="low" resp="#joint">bahrem</unclear> gelt <unclear cert="low" resp="#joint">erstattet</unclear>,
<lb n="12"/>welliches er <unclear cert="low" resp="#joint">innammen</unclear> seines principalen empfangen
<lb n="13"/>unnd widerumb <unclear cert="low" resp="#joint">zuebezallen</unclear> versprochen, wann aber
<lb n="14"/>er, weder von <unclear cert="low" resp="#joint">ermeltem</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Billwyler</unclear></persName> noch <unclear cert="low" resp="#joint">imme</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Moser</unclear></persName>,
<lb n="15"/>über <unclear cert="low" resp="#joint">villfaltigs</unclear> <unclear cert="low" resp="#joint">beschehen</unclear> <unclear cert="low" resp="#joint">guettlichs</unclear> <unclear cert="low" resp="#joint">erforderen</unclear>, biß
<lb n="16"/><unclear cert="low" resp="#joint">dato</unclear> nit bezalt noch <unclear cert="medium" resp="#joint">zue</unclear> seinem <unclear cert="low" resp="#joint">usstandt</unclear> gelangen mögen,
<lb n="17"/><unclear cert="medium" resp="#joint">seye</unclear> <unclear cert="medium" resp="#joint">er</unclear> verursacht, <unclear cert="low" resp="#joint">andere</unclear> <unclear cert="low" resp="#joint">mittel</unclear> <unclear cert="low" resp="#joint">zue</unclear> inbringung
<lb n="18"/>deß seinigen <unclear cert="medium" resp="#joint">fürzuenemmen</unclear>, <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">derohalben</unclear> <unclear cert="medium" resp="#joint">under</unclear>-
<lb n="19"/><unclear cert="medium" resp="#joint">thänig</unclear> gebetten, wir <unclear cert="low" resp="#joint">wölten</unclear> <unclear cert="low" resp="#joint">ime</unclear> mit unnserem für-
<lb n="20"/><unclear cert="low" resp="#joint">schryben</unclear> <unclear cert="low" resp="#joint">ahn</unclear> <unclear cert="low" resp="#joint">eüch</unclear>, <unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">zue</unclear> desto <unclear cert="medium" resp="#joint">fürderlicher</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">ußzallung</unclear> <unclear cert="medium" resp="#joint">befürderet</unclear> werden <unclear cert="medium" resp="#joint">möchte</unclear>, <unclear cert="medium" resp="#joint">erschindlich</unclear> sein,
<lb n="22"/>unnd <unclear cert="medium" resp="#joint">wyl</unclear> uns sollich sein <unclear cert="low" resp="#joint">pitt</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">unzimblich</unclear> sein bedunckht,
<lb n="23"/>haben wir <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">dasselbig</unclear> <unclear cert="low" resp="#joint">destoweniger</unclear> <unclear cert="low" resp="#joint">verweigeren</unclear>
<lb n="24"/>wöllen, Gelangt <unclear cert="medium" resp="#joint">derohalben</unclear> <unclear cert="medium" resp="#joint">ahn</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> unnser
<lb n="25"/><unclear cert="medium" resp="#joint">fründt</unclear> unnd <unclear cert="low" resp="#joint">eydtgnösisch</unclear> <unclear cert="low" resp="#joint">ersuchen</unclear>, <unclear cert="low" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">wöllert</unclear> von ober-
<lb n="26"/><unclear cert="low" resp="#joint">keit</unclear> unnd <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">sach</unclear> <unclear cert="low" resp="#joint">billigkeit</unclear> wegen, <unclear cert="medium" resp="#joint">obberüerte</unclear> <unclear cert="medium" resp="#joint">eüwere</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">burgere</unclear> dahin <unclear cert="low" resp="#joint">wyssen</unclear>, <unclear cert="medium" resp="#joint">daß</unclear> sy mehrbemelten,
<lb n="28"/><unclear cert="medium" resp="#joint">unnseren</unclear> <unclear cert="medium" resp="#joint">burger</unclear>, umb seinen <unclear cert="medium" resp="#joint">usstandt</unclear>, <unclear cert="medium" resp="#joint">ohne</unclear> <unclear cert="medium" resp="#joint">lengeren</unclear>
<lb n="29"/>unnd <unclear cert="medium" resp="#joint">ferneren</unclear> <unclear cert="medium" resp="#joint">umbtrib</unclear>, <unclear cert="medium" resp="#joint">ußrichten</unclear> und <unclear cert="medium" resp="#joint">bezallen</unclear> <unclear cert="medium" resp="#joint">thüend</unclear>,
<lb n="30"/>unnd <unclear cert="medium" resp="#joint">eüch</unclear> gegen <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">also</unclear> <unclear cert="medium" resp="#joint">erzeigen</unclear>, <unclear cert="medium" resp="#joint">das</unclear> <unclear cert="medium" resp="#joint">er</unclear> diser <unclear cert="medium" resp="#joint">unnser</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">fürschrifft</unclear> <unclear cert="medium" resp="#joint">früchtbarlich</unclear> <unclear cert="medium" resp="#joint">genossen</unclear> haben, <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">werckh</unclear> befinden
<lb n="32"/><unclear cert="low" resp="#joint">möge</unclear>, Als wir <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">dann</unclear> sollichs woll <unclear cert="low" resp="#joint">anthrauwend</unclear>,
<pb facs="StadtASG_Missive_1603_5818.jpg" n="2"/>
<lb n="33"/>unnd uns hiebey anerbotten woellendten, sollichs
<lb n="34"/>umb üch unnd die <unclear cert="low" resp="#joint">üweren</unclear> <unclear cert="low" resp="#joint">jhegebenheit</unclear> widerumb
<lb n="35"/>zebeschulden. Der bewahr Gottes uns damit
<lb n="36"/>befehlendt. Datum den. <origDate when="1608-04-04" resp="#ner"><unclear cert="low" resp="#joint">18</unclear>. <unclear cert="low" resp="#joint">4</unclear>. Aprilis.
<lb n="37"/>Anno. 1608</origDate>.
<lb n="38"/><orgName ref="stadtasg-actors-28" cert="medium" role="issuer" resp="#ner">Burgermeister und Rath
<lb n="39"/>der Statt <unclear cert="medium" resp="#joint">Schaffhusen</unclear></orgName>.
<pb facs="StadtASG_Missive_1603_5819.jpg" n="3"/>
<pb facs="StadtASG_Missive_1603_5820.jpg" n="4"/>
<lb n="40"/>Den <unclear cert="medium" resp="#joint">fromen</unclear>, fürsichtigen,
<lb n="41"/>ehrsammen, <unclear cert="low" resp="#joint">wyßen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="42"/>meister unnd Rath der statt
<lb n="43"/>Sant Gallen</orgName>, <unclear cert="medium" resp="#joint">unnseren</unclear> in-
<lb n="44"/><unclear cert="low" resp="#joint">sonders</unclear> guoten fründen unnd
<lb n="45"/>gethrüwen lieben Eydtgnossen <unclear cert="low" resp="#joint">etc</unclear>.
</p>
