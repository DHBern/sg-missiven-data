<p>
<pb facs="StadtASG_Missive_2448_9437.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear> willig dienst, und was wir <unclear cert="medium" resp="#joint">ehren</unclear>
<lb n="2"/>liebs und <unclear cert="low" resp="#joint">guets</unclear> <unclear cert="low" resp="#joint">vermogend</unclear>, zuvor, <unclear cert="low" resp="#joint">Edle</unclear>, Veste, Fromme
<lb n="3"/><unclear cert="low" resp="#joint">Fuersichtige</unclear>, <unclear cert="low" resp="#joint">Ersame</unclear> und <unclear cert="low" resp="#joint">Weyse</unclear>, insonders <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">Freünde</unclear>
<lb n="4"/>und <unclear cert="low" resp="#joint">getrewe</unclear> liebe Eydtgnossen.
<lb n="5"/>Dieselben werden auß dem schreiben, so wir <unclear cert="low" resp="#joint">Ihrem</unclear> under=
<lb n="6"/>thanen, <persName resp="#ner"><unclear cert="medium" resp="#joint">Hanßen</unclear> <unclear cert="low" resp="#joint">Scheyfelbergern</unclear></persName> von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Ybischweyl</unclear></placeName>, <unclear cert="medium" resp="#joint">verschlossen</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">zuegestelt</unclear>, mit <unclear cert="low" resp="#joint">mehrerm</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear>, waß <unclear cert="medium" resp="#joint">zwüschendt</unclear> <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="8"/>und dem unseren <persName resp="#ner">Othmar <unclear cert="low" resp="#joint">Appenzellern</unclear></persName> <unclear cert="low" resp="#joint">Ihrer</unclear> langge=
<lb n="9"/><unclear cert="low" resp="#joint">werdten</unclear> differentz halben <unclear cert="medium" resp="#joint">vor</unclear> unß <unclear cert="medium" resp="#joint">heüt</unclear> dato <unclear cert="low" resp="#joint">fuergeloffen</unclear>,
<lb n="10"/>da wir <unclear cert="medium" resp="#joint">dan</unclear> <unclear cert="medium" resp="#joint">ueserem</unclear> <unclear cert="medium" resp="#joint">theil</unclear> <unclear cert="medium" resp="#joint">des</unclear> unseren, <unclear cert="medium" resp="#joint">fuergestelte</unclear> kundt=
<lb n="11"/>schafften, uff <unclear cert="medium" resp="#joint">sein</unclear> so gar <unclear cert="low" resp="#joint">trungenlich</unclear> <unclear cert="low" resp="#joint">underthänig</unclear> anhalten
<lb n="12"/>umb <unclear cert="medium" resp="#joint">vermeidung</unclear> <unclear cert="medium" resp="#joint">willen</unclear> <unclear cert="medium" resp="#joint">grösseren</unclear> <unclear cert="medium" resp="#joint">unkostens</unclear>, verhört,
<lb n="13"/>namblich die <unclear cert="low" resp="#joint">jehnigen</unclear>, so in <unclear cert="medium" resp="#joint">unserer</unclear> jurisdiction <unclear cert="low" resp="#joint">gesässen</unclear>,
<lb n="14"/><unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="medium" resp="#joint">nie</unclear> <unclear cert="low" resp="#joint">verhört</unclear> worden, <unclear cert="medium" resp="#joint">bey</unclear> <unclear cert="medium" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">uffgehebten</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">eydten</unclear>, die anderen aber so schon vor <unclear cert="low" resp="#joint">disem</unclear>, in gegen=
<lb n="16"/>würtiger sach <unclear cert="low" resp="#joint">khundtschafft</unclear> gesagt, und <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. und <unclear cert="low" resp="#joint">Erl</unclear>.
<lb n="17"/><unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">deren</unclear> depositiones <unclear cert="medium" resp="#joint">zuvor</unclear> allbereit <unclear cert="low" resp="#joint">ueberschriben</unclear>
<lb n="18"/>worden, haben wir bey <unclear cert="medium" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">ußsagen</unclear> verbleiben, <unclear cert="medium" resp="#joint">ihnen</unclear>
<lb n="19"/>aber selbige <unclear cert="medium" resp="#joint">nachmahls</unclear> <unclear cert="low" resp="#joint">fuerlässen</unclear> und befragen <unclear cert="low" resp="#joint">lassen</unclear>,
<lb n="20"/>ob deme also <unclear cert="medium" resp="#joint">seye</unclear> oder nit, die <unclear cert="medium" resp="#joint">übrigen</unclear> drey
<lb n="21"/><unclear cert="low" resp="#joint">gezeügen</unclear> aber, weil <unclear cert="medium" resp="#joint">sie</unclear> nit <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">burger</unclear>,
<lb n="22"/>sondern <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">amt</unclear> <placeName ref="stadtasg-places-413" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Grüeningen</unclear></placeName> <unclear cert="low" resp="#joint">gesässen</unclear>, haben wir
<lb n="23"/><unclear cert="low" resp="#joint">zwar</unclear> nit <unclear cert="low" resp="#joint">beeydiget</unclear>, aber ihnen <unclear cert="low" resp="#joint">sasten</unclear> mit ernst
<lb n="24"/>zuegesprochen <unclear cert="medium" resp="#joint">reini</unclear> <unclear cert="medium" resp="#joint">warheit</unclear> <unclear cert="medium" resp="#joint">anzezeigen</unclear>, solcher gestalt,
<lb n="25"/><unclear cert="medium" resp="#joint">wan</unclear> <unclear cert="medium" resp="#joint">ferners</unclear> ihnen, der <unclear cert="medium" resp="#joint">eydt</unclear> <unclear cert="medium" resp="#joint">uffgelegt</unclear> <unclear cert="medium" resp="#joint">wurde</unclear>
<lb n="26"/>daß sie ihre <unclear cert="medium" resp="#joint">ußsagen</unclear> darmit erhalten <unclear cert="medium" resp="#joint">mögindt</unclear>.
<pb facs="StadtASG_Missive_2448_9438.jpg" n="2"/>
<lb n="27"/>Dieweil nun der <unclear cert="low" resp="#joint">unserige</unclear>, <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">Ihnen</unclear> <unclear cert="low" resp="#joint">zbeiden</unclear>
<lb n="28"/>theilen <unclear cert="medium" resp="#joint">geoeffneten</unclear> <unclear cert="low" resp="#joint">bscheidt</unclear>, verstanden, daß die sach zuo
<lb n="29"/><unclear cert="medium" resp="#joint">endtlichem</unclear> <unclear cert="low" resp="#joint">untsched</unclear> für ein <unclear cert="low" resp="#joint">Ersames</unclear> <unclear cert="low" resp="#joint">Gricht</unclear> zuo <placeName ref="stadtasg-places-413" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Grueningen</unclear></placeName>
<lb n="30"/>remittiert <unclear cert="low" resp="#joint">sige</unclear>, <unclear cert="medium" resp="#joint">hat</unclear> er uns underthenigs fleißes <unclear cert="low" resp="#joint">ersuechen</unclear> laßen
<lb n="31"/>wir welten ihme nit allein solcher <unclear cert="low" resp="#joint">zügen</unclear> ußsagen zuo sinem
<lb n="32"/>Rechten in schrift gnedig und <unclear cert="low" resp="#joint">günstig</unclear> zuostellen, sonder auch dar=
<lb n="33"/>neben an <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. und <unclear cert="low" resp="#joint">Ers</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">W</unclear>. mit <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">nohmaligen</unclear>
<lb n="34"/>intercession <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">behilfflich</unclear> sin. Wann dann
<lb n="35"/>wir sinem <unclear cert="medium" resp="#joint">Gegentheil</unclear> dem <persName resp="#ner">Hansen <unclear cert="low" resp="#joint">Schuehebregen</unclear></persName>, <unclear cert="medium" resp="#joint">waß</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">abgeordnete</unclear> <unclear cert="low" resp="#joint">Metzger</unclear> in der <unclear cert="medium" resp="#joint">besichtigung</unclear> der <unclear cert="low" resp="#joint">Kalbfehlen</unclear>
<lb n="37"/>befunden auch in schrift verschloßen mitgetheilt. So haben
<lb n="38"/>wir dem <unclear cert="low" resp="#joint">unseren</unclear> in sinem <unclear cert="low" resp="#joint">unseres</unclear> erachtens <unclear cert="medium" resp="#joint">billichmeßig</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">bgern</unclear> <unclear cert="low" resp="#joint">glichergstalten</unclear> nit zuo wider sin wellen. Derohalben
<lb n="40"/><unclear cert="low" resp="#joint">überschickhen</unclear> E. <unclear cert="low" resp="#joint">W</unclear>. und Ers. F. W. wir <unclear cert="low" resp="#joint">obangezogne</unclear> ver=
<lb n="41"/><unclear cert="medium" resp="#joint">hoerte</unclear> <unclear cert="low" resp="#joint">zügen</unclear> sagen sub lit. A. B. C. hiemit verschloßen zuo,
<lb n="42"/>Mit dem angehenckhten gantz <unclear cert="low" resp="#joint">fründtlichen</unclear> und <unclear cert="low" resp="#joint">Eydtgnoeßischen</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">ersuechen</unclear> und <unclear cert="medium" resp="#joint">pitten</unclear>, <unclear cert="medium" resp="#joint">die</unclear> wellen den <unclear cert="medium" resp="#joint">unseren</unclear> (als <unclear cert="low" resp="#joint">welchen</unclear>,
<lb n="44"/><unclear cert="low" resp="#joint">wo</unclear> <unclear cert="low" resp="#joint">er</unclear> wurde zuo <unclear cert="low" resp="#joint">rugg</unclear> geworffen, welches aber ob Gott will
<lb n="45"/>nit <unclear cert="medium" resp="#joint">gschechen</unclear> <unclear cert="medium" resp="#joint">wirt</unclear>, in <placeName resp="#ner"><unclear cert="low" resp="#joint">Newbeit</unclear></placeName> ußschriben, gar <unclear cert="low" resp="#joint">ins</unclear> <unclear cert="medium" resp="#joint">verderben</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">muoeßte</unclear>, wie dann <unclear cert="medium" resp="#joint">sini</unclear> <unclear cert="low" resp="#joint">Gegenparthy</unclear>, als uns <unclear cert="low" resp="#joint">fürkhomt</unclear>
<lb n="47"/>sich <unclear cert="medium" resp="#joint">verlauten</unclear> laßen, daß sie <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">dise</unclear> sach so vil zuo setzen
<lb n="48"/>begeren, daß weder der <unclear cert="low" resp="#joint">unserige</unclear>, <unclear cert="low" resp="#joint">noh</unclear> sini gantze <unclear cert="low" resp="#joint">fründtschaft</unclear>
<lb n="49"/>solches nit werden ertragen moegen) <unclear cert="low" resp="#joint">dergstalten</unclear> laßen
<lb n="50"/>in gnaden befohlen <unclear cert="medium" resp="#joint">sin</unclear>, daß sie es <unclear cert="low" resp="#joint">bii</unclear> <unclear cert="low" resp="#joint">Ihren</unclear> <unclear cert="medium" resp="#joint">vorigen</unclear>
<lb n="51"/><unclear cert="medium" resp="#joint">loeblich</unclear> <unclear cert="low" resp="#joint">gfaßneten</unclear>, unnd <unclear cert="low" resp="#joint">Ihrem</unclear> vogt zuo <placeName ref="stadtasg-places-413" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Grueningen</unclear></placeName> <unclear cert="medium" resp="#joint">uberschri=</unclear>
<lb n="52"/><unclear cert="medium" resp="#joint">benen</unclear>
<pb facs="StadtASG_Missive_2448_9439.jpg" n="3"/>
<lb n="53"/><unclear cert="low" resp="#joint">benen</unclear> <unclear cert="low" resp="#joint">gnedigen</unclear> resolution und <unclear cert="low" resp="#joint">befehlch</unclear> <unclear cert="low" resp="#joint">beruewen</unclear>, unnd
<lb n="54"/>nachmahls <unclear cert="low" resp="#joint">verschaffen</unclear> <unclear cert="medium" resp="#joint">wellindt</unclear>, daß <unclear cert="low" resp="#joint">söliche</unclear> in <unclear cert="low" resp="#joint">würckhliche</unclear>
<lb n="55"/>execution gelangen, <unclear cert="medium" resp="#joint">und</unclear> also ieder <unclear cert="low" resp="#joint">menigklichen</unclear> von dißer
<lb n="56"/><unclear cert="low" resp="#joint">muehseligen</unclear> sach, <unclear cert="medium" resp="#joint">endtlich</unclear> ab, und <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">ruowen</unclear> geholffen
<lb n="57"/>werden möge, unnd hierinnen, so wohl gegenwürtige, alß
<lb n="58"/>auch vorgehende unßere, ihme unßerem burger <unclear cert="medium" resp="#joint">zum</unclear> besten
<lb n="59"/><unclear cert="medium" resp="#joint">gemeinte</unclear> intercessiones (darauff wir unß umb <unclear cert="medium" resp="#joint">mehrer</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">kürtze</unclear> willen referiren) <unclear cert="low" resp="#joint">günstig</unclear> und eydtgnößisch
<lb n="61"/>respectriren. Daß begeren wir, <unclear cert="medium" resp="#joint">gegen</unclear> E. <unclear cert="low" resp="#joint">Wht</unclear>. und
<lb n="62"/>Erl. F. Wht. und den <unclear cert="low" resp="#joint">ihrigen</unclear> in gleichen und anderen be-
<lb n="63"/><unclear cert="low" resp="#joint">gebnen</unclear> <unclear cert="low" resp="#joint">glegenheiten</unclear>, <unclear cert="low" resp="#joint">zuerkennen</unclear>, und ihne sonsten
<lb n="64"/>alle eydtgnößische fründtschafft und dienst <unclear cert="low" resp="#joint">zuerzeigen</unclear>,
<lb n="65"/>mit hilff deß Allmechtigen, in <unclear cert="low" resp="#joint">deßben</unclear> <unclear cert="medium" resp="#joint">schutz</unclear> unnd
<lb n="66"/><unclear cert="low" resp="#joint">schirm</unclear> wir unß <unclear cert="medium" resp="#joint">beiderseiths</unclear> in treüwen <unclear cert="low" resp="#joint">befohlen</unclear> <unclear cert="low" resp="#joint">thuondt</unclear>.
<lb n="67"/>Datum den <origDate when="1625" resp="#ner"><unclear cert="low" resp="#joint">4</unclear> <unclear cert="low" resp="#joint">t</unclear>. novembris <unclear cert="medium" resp="#joint">a°</unclear> <unclear cert="low" resp="#joint">1625</unclear></origDate>.
<lb n="68"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">B</unclear>. und R. der
<lb n="69"/>stadt St. Gallen</orgName>.
<lb n="70"/>An <origPlace ref="stadtasg-places-32" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Zürich</unclear></origPlace>.
