<lb n="24"/><unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ingleichem</unclear> zue <unclear cert="low" resp="#joint">angenemer</unclear> <unclear cert="low" resp="#joint">freundt</unclear>-
