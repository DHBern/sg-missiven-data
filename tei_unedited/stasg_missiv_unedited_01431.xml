<p>
<pb facs="StadtASG_Missive_1431_5115.jpg" n="1"/>
<lb n="1"/>Unnser freündtlich willig <unclear cert="low" resp="#joint">deinnst</unclear> <unclear cert="low" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">Eersamen</unclear>
<lb n="2"/>unnd weisen, <unclear cert="low" resp="#joint">beßonndern</unclear> lieben unnd guotten
<lb n="3"/>freündt,
<lb n="4"/>Wir haben <unclear cert="medium" resp="#joint">kurz</unclear> <unclear cert="medium" resp="#joint">verschiner</unclear> <unclear cert="medium" resp="#joint">zeit</unclear> ain <unclear cert="low" resp="#joint">maleficzige</unclear> per=
<lb n="5"/>son, der sich <unclear cert="low" resp="#joint">Theiß</unclear> <unclear cert="low" resp="#joint">Precher</unclear> von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Lußwein</unclear></placeName> <unclear cert="medium" resp="#joint">genenndt</unclear>,
<lb n="6"/><unclear cert="medium" resp="#joint">fennckhlichen</unclear> <unclear cert="medium" resp="#joint">einziehen</unclear>, unnd <unclear cert="medium" resp="#joint">ihne</unclear> <unclear cert="medium" resp="#joint">bekhanndter</unclear> <unclear cert="medium" resp="#joint">viler</unclear>
<lb n="7"/>seiner <unclear cert="medium" resp="#joint">diebställen</unclear> halben, <unclear cert="low" resp="#joint">justificieren</unclear> unnd ab=
