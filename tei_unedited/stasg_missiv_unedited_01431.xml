<lb n="13"/>Nun will <unclear cert="medium" resp="#joint">unns</unclear> <unclear cert="medium" resp="#joint">fürkhommen</unclear>, daß <unclear cert="medium" resp="#joint">sich</unclear> <unclear cert="medium" resp="#joint">etlich</unclear>
<lb n="14"/>derselben, <unclear cert="medium" resp="#joint">hinüber</unclear> <unclear cert="medium" resp="#joint">inns</unclear> <placeName ref="stadtasg-places-287" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schweizer</unclear> <unclear cert="medium" resp="#joint">lanndt</unclear></placeName> <unclear cert="medium" resp="#joint">be=</unclear>
<lb n="15"/>geben, Damit dann uff solch <unclear cert="medium" resp="#joint">bößes</unclear> ge=
