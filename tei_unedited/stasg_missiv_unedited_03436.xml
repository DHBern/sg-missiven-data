<lb n="10"/><unclear cert="medium" resp="#joint">Wann</unclear> aber die <unclear cert="medium" resp="#joint">christliche</unclear> kirche, <unclear cert="medium" resp="#joint">und</unclear> ein <unclear cert="medium" resp="#joint">jede</unclear> absonderlich, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">wie</unclear> der monad, <unclear cert="medium" resp="#joint">vielen</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">veraenderungen</unclear> <unclear cert="medium" resp="#joint">unterworffen</unclear>, und unsere vorfahren, auch <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">selbsten</unclear>, bald <unclear cert="medium" resp="#joint">dießes</unclear> <unclear cert="medium" resp="#joint">baldt</unclear>
