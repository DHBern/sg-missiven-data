<lb n="21"/><unclear cert="medium" resp="#joint">erlanget</unclear>, aber mit uns einhalb stund <unclear cert="medium" resp="#joint">wegs</unclear> von der <unclear cert="low" resp="#joint">stadt</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Bockenheimb</unclear></placeName> <unclear cert="low" resp="#joint">inn</unclear>
