<p>
<pb facs="StadtASG_Missive_3436_13685.jpg" n="1"/>
<lb n="1"/>Gottes <unclear cert="medium" resp="#joint">gnadt</unclear>, <unclear cert="medium" resp="#joint">friedt</unclear>, <unclear cert="medium" resp="#joint">unndt</unclear> <unclear cert="medium" resp="#joint">seegen</unclear> <unclear cert="medium" resp="#joint">zuvor</unclear>: <unclear cert="medium" resp="#joint">Beliebte</unclear> <unclear cert="medium" resp="#joint">bruedere</unclear>
