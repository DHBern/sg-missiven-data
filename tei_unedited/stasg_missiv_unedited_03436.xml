<lb n="3"/>Es kann <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Lh</unclear>. <unclear cert="medium" resp="#joint">nicht</unclear> <unclear cert="medium" resp="#joint">unerkandt</unclear> seyn, daß <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">dieser</unclear> <unclear cert="medium" resp="#joint">stadt</unclear> <placeName ref="stadtasg-places-114" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Chur</unclear></placeName> <unclear cert="medium" resp="#joint">Christus</unclear> der Herr
