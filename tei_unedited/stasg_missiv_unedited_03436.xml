<lb n="13"/><unclear cert="medium" resp="#joint">lauter</unclear> gnaden erhalten.
<lb n="14"/>Ob <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">schon</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">krieg</unclear>, <unclear cert="low" resp="#joint">pest</unclear>, <unclear cert="low" resp="#joint">hunger</unclear>, und andere <unclear cert="medium" resp="#joint">ungelegenheyten</unclear>, <unclear cert="medium" resp="#joint">an</unclear> der <unclear cert="medium" resp="#joint">zahl</unclear> <unclear cert="medium" resp="#joint">sehr</unclear>
