<lb n="19"/><unclear cert="medium" resp="#joint">mueßen</unclear>; <unclear cert="medium" resp="#joint">andere</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">gefahr</unclear> <unclear cert="medium" resp="#joint">dießer</unclear> <unclear cert="medium" resp="#joint">truebseeligen</unclear> <unclear cert="medium" resp="#joint">zeiten</unclear> <unclear cert="medium" resp="#joint">zuentfliehen</unclear>, <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">hiesiger</unclear>
