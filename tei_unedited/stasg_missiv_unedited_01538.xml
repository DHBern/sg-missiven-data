<lb n="52"/><unclear cert="low" resp="#joint">notwendiger</unclear> <unclear cert="low" resp="#joint">unnderhaltung</unclear> <unclear cert="low" resp="#joint">khome</unclear> und <unclear cert="medium" resp="#joint">gereiche</unclear> <unclear cert="medium" resp="#joint">welten</unclear>
<lb n="53"/>wir <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">eüer</unclear> begeren in <unclear cert="low" resp="#joint">antwurth</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">verhalten</unclear>,
