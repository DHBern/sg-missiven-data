<lb n="55"/>datum den <origDate when="1609-02-07" resp="#ner">7. <unclear cert="medium" resp="#joint">februarij</unclear> <unclear cert="medium" resp="#joint">a°</unclear> <unclear cert="medium" resp="#joint">1609</unclear></origDate>
