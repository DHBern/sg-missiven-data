<lb n="34"/>dieselben und unß <unclear cert="medium" resp="#joint">zuomal</unclear> <unclear cert="medium" resp="#joint">gotlicher</unclear> <unclear cert="medium" resp="#joint">protection</unclear> <unclear cert="medium" resp="#joint">befelhd</unclear>.
<lb n="35"/><unclear cert="medium" resp="#joint">dath</unclear> den <origDate when="1604-02-20" resp="#ner"><unclear cert="medium" resp="#joint">20</unclear>. februarij <unclear cert="low" resp="#joint">Stuo</unclear>. <unclear cert="low" resp="#joint">Vet</unclear>. Anno <unclear cert="low" resp="#joint">1604</unclear></origDate>.
<lb n="36"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Schulthayß</unclear> und rath der
<lb n="37"/>Statt <unclear cert="low" resp="#joint">dießenhoh</unclear></orgName>.
<pb facs="StadtASG_Missive_1538_5565.jpg" n="3"/>
<lb n="38"/>Unser <unclear cert="medium" resp="#joint">fr</unclear>. willig dienst und alles liebs und guots zuvor,
<lb n="39"/><unclear cert="medium" resp="#joint">fromm</unclear> <unclear cert="medium" resp="#joint">fuersichtig</unclear> <unclear cert="medium" resp="#joint">eersam</unclear> und <unclear cert="low" resp="#joint">wiß</unclear> innsonnders liebe
<lb n="40"/><unclear cert="low" resp="#joint">gottgunde</unclear> <unclear cert="low" resp="#joint">fründt</unclear>. Was <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">eüwer</unclear>
<lb n="41"/>burgerin <persName resp="#ner"><unclear cert="medium" resp="#joint">Uell</unclear> <unclear cert="medium" resp="#joint">Werdhin</unclear></persName> halber fründtlich zuogeschriben,
<lb n="42"/><unclear cert="low" resp="#joint">daß</unclear> haben wir <unclear cert="low" resp="#joint">ordenlich</unclear> empfangen, und <unclear cert="medium" resp="#joint">innhalts</unclear>
<lb n="43"/><unclear cert="medium" resp="#joint">ablesende</unclear> vernomen, und <unclear cert="low" resp="#joint">daruf</unclear> <unclear cert="low" resp="#joint">unß</unclear> und <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">zgefallen</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">baldt</unclear> nach irer tochter <persName resp="#ner"><unclear cert="low" resp="#joint">Margaretha</unclear></persName> <unclear cert="low" resp="#joint">unnsers</unclear> burgers
