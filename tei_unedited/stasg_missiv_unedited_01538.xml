<lb n="47"/>hat sich <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">erclhaert</unclear>. <unclear cert="low" resp="#joint">Wiewoln</unclear> die <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">selbs</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">iren</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">alten</unclear> <unclear cert="low" resp="#joint">khranckhen</unclear> <unclear cert="low" resp="#joint">mann</unclear> <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">hülff</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">fürschub</unclear> <unclear cert="low" resp="#joint">hochbe</unclear>-
<lb n="49"/><unclear cert="low" resp="#joint">dürfftig</unclear> <unclear cert="low" resp="#joint">were</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wülle</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">iedoch</unclear> <unclear cert="low" resp="#joint">desienigen</unclear> in <unclear cert="medium" resp="#joint">eüerm</unclear> <unclear cert="medium" resp="#joint">schriben</unclear>
<lb n="50"/><unclear cert="medium" resp="#joint">anngezogenem</unclear> <unclear cert="medium" resp="#joint">guetlins</unclear> sich gern und freywillig <unclear cert="low" resp="#joint">verzeihen</unclear>
