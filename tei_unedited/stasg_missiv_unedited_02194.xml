<p>
<pb facs="StadtASG_Missive_2194_8259.jpg" n="1"/>
<lb n="1"/>Unnser freünd: nachparlich und guetwill=
<lb n="2"/>ig diennst zuvor, fürsichtige, ersame, wei=
<lb n="3"/>se, besonders liebe fründ und guette
<lb n="4"/>nachparn.
<lb n="5"/>Wir zweifeln nit, es werde eüch die <unclear cert="low" resp="#joint">ganz</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">unnothsam</unclear> <unclear cert="low" resp="#joint">einreißennde</unclear> <unclear cert="low" resp="#joint">geschwinde</unclear>
<lb n="7"/>und <unclear cert="low" resp="#joint">nunmehr</unclear> <unclear cert="low" resp="#joint">unerschwingcliche</unclear> <unclear cert="low" resp="#joint">gelts</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">staigerunge</unclear>, an gold: und <unclear cert="low" resp="#joint">silber</unclear> <unclear cert="low" resp="#joint">sorten</unclear>,
<lb n="9"/>nit verborgen sein.
<lb n="10"/>Wan dan nun hierdurch nichts anders
<lb n="11"/>dan ganz beschwerlicher <unclear cert="low" resp="#joint">erfolg</unclear>, und
<lb n="12"/><unclear cert="low" resp="#joint">unwiderbringenlicher</unclear> <unclear cert="low" resp="#joint">schaden</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">ge=</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">wartten</unclear>, <unclear cert="low" resp="#joint">deme</unclear> wir <unclear cert="low" resp="#joint">unnsers</unclear> <unclear cert="low" resp="#joint">theils</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">undergebenen</unclear> <unclear cert="low" resp="#joint">orten</unclear>, <unclear cert="low" resp="#joint">souil</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">müglichen</unclear> <unclear cert="low" resp="#joint">vorzeebauen</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">unger=</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">naigt</unclear> <unclear cert="low" resp="#joint">weeren</unclear>.
<lb n="17"/><unclear cert="low" resp="#joint">Deß</unclear> <unclear cert="low" resp="#joint">haben</unclear> wir keinen umbgang
<lb n="18"/>nemmen kuenden, eüch deßhalb freünd:
<lb n="19"/>nachparlichen zuezeeschriben. Mit
<lb n="20"/>freünd: nachparlicher pitt und ersuechen,
<lb n="21"/>da ir wider angedeüte beschwer=
<lb n="22"/>nuß, waß <unclear cert="low" resp="#joint">mittel</unclear> <unclear cert="low" resp="#joint">gesuocht</unclear>, <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">orts</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">ordnung</unclear> oder <unclear cert="low" resp="#joint">taxation</unclear> <unclear cert="low" resp="#joint">aufger=</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">icht</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">weß</unclear>, <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">weich</unclear> <unclear cert="low" resp="#joint">weie</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">hoech</unclear> <unclear cert="low" resp="#joint">gold</unclear>: und <unclear cert="low" resp="#joint">silber</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">beÿ</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">gangbar</unclear>, nachparlich zebe=
<lb n="27"/>richten und <unclear cert="low" resp="#joint">zeauisirn</unclear> <unclear cert="low" resp="#joint">unbeschwert</unclear>
<lb n="28"/>sein wellen.
<lb n="29"/><unclear cert="low" resp="#joint">Steen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">hinwiderumb</unclear> mit <unclear cert="low" resp="#joint">eüch</unclear>
<lb n="30"/>die lanng gepflogene guette nach=
<lb n="31"/><unclear cert="low" resp="#joint">parschaft</unclear> <unclear cert="low" resp="#joint">fortzeepflannzen</unclear> <unclear cert="low" resp="#joint">guotwil=</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">lig</unclear> <unclear cert="low" resp="#joint">erbiettens</unclear> <unclear cert="low" resp="#joint">Actum</unclear> den <origDate when="1620-02-14" resp="#ner">14. Febr. <unclear cert="low" resp="#joint">1620</unclear></origDate>.
<lb n="33"/><unclear cert="low" resp="#joint">Anwalt</unclear> <unclear cert="low" resp="#joint">der</unclear> <orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">haubtman=</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">schaft</unclear> <unclear cert="low" resp="#joint">burgermaister</unclear>
<lb n="35"/>und <unclear cert="low" resp="#joint">rath</unclear> der statt Costanz</orgName>.
<pb facs="StadtASG_Missive_2194_8260.jpg" n="2"/>
<pb facs="StadtASG_Missive_2194_8261.jpg" n="3"/>
<pb facs="StadtASG_Missive_2194_8262.jpg" n="4"/>
<lb n="36"/><unclear cert="medium" resp="#joint">Denen</unclear> <unclear cert="medium" resp="#joint">fuersichtigen</unclear>, <unclear cert="medium" resp="#joint">ehrsamen</unclear> und <unclear cert="medium" resp="#joint">weisen</unclear>,
<lb n="37"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und <unclear cert="medium" resp="#joint">Rhat</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">S</unclear>. Gallen</orgName>,
<lb n="38"/><unclear cert="medium" resp="#joint">unnseren</unclear> <unclear cert="medium" resp="#joint">besonders</unclear> lieben <unclear cert="medium" resp="#joint">freuenden</unclear> und
<lb n="39"/><unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">nachbarn</unclear>.
<lb n="40"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
