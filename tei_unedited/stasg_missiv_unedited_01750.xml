<lb n="6"/><unclear cert="low" resp="#joint">schlacht</unclear>. Unnd mir underthenig <unclear cert="low" resp="#joint">zeverstohn</unclear> <unclear cert="low" resp="#joint">geben</unclear>.
<lb n="7"/>Wie <unclear cert="low" resp="#joint">das</unclear> er unnd seine <unclear cert="low" resp="#joint">mitthafften</unclear>, <unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">gethailten</unclear>
