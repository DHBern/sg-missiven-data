<lb n="1"/><unclear cert="low" resp="#joint">Edle</unclear>, <unclear cert="low" resp="#joint">fromme</unclear>, <unclear cert="low" resp="#joint">erenveste</unclear>, <unclear cert="low" resp="#joint">fürsichtig</unclear> <unclear cert="low" resp="#joint">weiße</unclear>, <unclear cert="low" resp="#joint">insonders</unclear>
