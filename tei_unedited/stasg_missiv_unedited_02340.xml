<p>
<pb facs="StadtASG_Missive_2340_8959.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freundtlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear>
<lb n="2"/>zuvor, <unclear cert="low" resp="#joint">Ehrnveste</unclear>, <unclear cert="low" resp="#joint">Fuersichtige</unclear> <unclear cert="low" resp="#joint">Eerbare</unclear>
<lb n="3"/>und weise, besonders liebe und <unclear cert="low" resp="#joint">guote</unclear>
<lb n="4"/>Freündt.
<lb n="5"/>Deroselben widerbeantwortliche inter-
<lb n="6"/>cessionales, beruerende ihren angehoerig
<lb n="7"/><unclear cert="low" resp="#joint">burger</unclear> <persName resp="#ner">Ferdinand <unclear cert="low" resp="#joint">Felen</unclear></persName>, sambt den
<lb n="8"/><unclear cert="medium" resp="#joint">beÿlag</unclear>, haben wir <unclear cert="low" resp="#joint">verschinen</unclear> <unclear cert="low" resp="#joint">tagen</unclear>,
<lb n="9"/>empfangen, und <unclear cert="low" resp="#joint">ablesendt</unclear> <unclear cert="low" resp="#joint">guotßame</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">verstanden</unclear>, auch nit ermanglet,
<lb n="11"/>den <unclear cert="low" resp="#joint">unserigen</unclear> <unclear cert="low" resp="#joint">solches</unclear> zu seiner erinner-
<lb n="12"/>ung, <unclear cert="low" resp="#joint">alßbaldt</unclear> <unclear cert="low" resp="#joint">einhendigen</unclear> <unclear cert="low" resp="#joint">zulassen</unclear>,
<lb n="13"/>welcher hierauf wider vor uns erschinen,
<lb n="14"/><unclear cert="low" resp="#joint">seinen</unclear> gegenbricht <unclear cert="low" resp="#joint">gethun</unclear>, und
<lb n="15"/>substanzlich aber auf sein <persName resp="#ner"><unclear cert="low" resp="#joint">Felen</unclear></persName> <unclear cert="low" resp="#joint">per</unclear>-
<lb n="16"/><unclear cert="low" resp="#joint">sonliche</unclear> <unclear cert="low" resp="#joint">einstellung</unclear> und <unclear cert="low" resp="#joint">gegenwuor</unclear>-
<lb n="17"/>tigkeit <unclear cert="low" resp="#joint">getrungen</unclear>, und
<lb n="18"/><unclear cert="medium" resp="#joint">deßwegen</unclear> an E. E. W. F. W. umb
<lb n="19"/>unser <unclear cert="low" resp="#joint">anderwertige</unclear> <unclear cert="low" resp="#joint">fuerschrift</unclear>,
<lb n="20"/><unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">allein</unclear> den <unclear cert="medium" resp="#joint">ihrigen</unclear> <unclear cert="medium" resp="#joint">oberkeitlich</unclear>
<lb n="21"/>dahin <unclear cert="low" resp="#joint">zuvermoegen</unclear>, sonders ihnen
<lb n="22"/><unclear cert="low" resp="#joint">beeden</unclear> <unclear cert="low" resp="#joint">gleich</unclear> <unclear cert="low" resp="#joint">einen</unclear> tag <unclear cert="low" resp="#joint">zubestimen</unclear>,
<lb n="23"/>gantz <unclear cert="low" resp="#joint">eynstendig</unclear> gebetten.
<lb n="24"/><unclear cert="medium" resp="#joint">Wiewol</unclear> nun E. E. W. <unclear cert="low" resp="#joint">F</unclear>. W. für
<lb n="25"/><unclear cert="low" resp="#joint">ihne</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Felen</unclear></persName> <unclear cert="low" resp="#joint">gethunes</unclear> intercedieren,
<lb n="26"/>in dem daß er die sach durch <unclear cert="low" resp="#joint">die</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">eingebrachter</unclear> <unclear cert="low" resp="#joint">schrift</unclear> be-
<lb n="28"/><unclear cert="low" resp="#joint">nambsete</unclear> <unclear cert="low" resp="#joint">Persohn</unclear>, oder ein <unclear cert="low" resp="#joint">andern</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">qualificierte</unclear> anwald, vor <unclear cert="medium" resp="#joint">unsern</unclear>
<pb facs="StadtASG_Missive_2340_8960.jpg" n="2"/>
<lb n="30"/><unclear cert="medium" resp="#joint">iren</unclear> <unclear cert="medium" resp="#joint">respectivè</unclear> <unclear cert="medium" resp="#joint">Vettern</unclear>
<lb n="31"/>der <unclear cert="low" resp="#joint">thayls</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Beßbüehl</unclear></placeName>. Weil
<lb n="32"/>aber <unclear cert="low" resp="#joint">dises</unclear> procedieren <unclear cert="low" resp="#joint">unserm</unclear> Statt
<lb n="33"/>satzungen und <unclear cert="medium" resp="#joint">ordnungen</unclear> <unclear cert="medium" resp="#joint">strackhs</unclear>
<lb n="34"/><unclear cert="medium" resp="#joint">zuwider</unclear> laufft, <unclear cert="medium" resp="#joint">uberdiß</unclear> <unclear cert="medium" resp="#joint">wir</unclear> den
<lb n="35"/>handel <unclear cert="low" resp="#joint">ohnediß</unclear> so gestaltet befindt, daß
<lb n="36"/><unclear cert="low" resp="#joint">deß</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Halers</unclear></persName> <unclear cert="low" resp="#joint">persöhnliche</unclear> <unclear cert="low" resp="#joint">praesenz</unclear> zu <unclear cert="low" resp="#joint">schleiniger</unclear> <unclear cert="low" resp="#joint">eroerterung</unclear> und
<lb n="37"/><unclear cert="low" resp="#joint">abschneidung</unclear> <unclear cert="low" resp="#joint">weitlaeuffigkeit</unclear>, <unclear cert="low" resp="#joint">ne</unclear>-
<lb n="38"/><unclear cert="low" resp="#joint">ben</unclear> ihme <persName resp="#ner"><unclear cert="low" resp="#joint">Haler</unclear></persName> besorgender <unclear cert="low" resp="#joint">unkoestung</unclear>
<lb n="39"/>vil mehr fruchtbarlich und
<lb n="40"/><unclear cert="low" resp="#joint">gedeylich</unclear> sein <unclear cert="low" resp="#joint">werde</unclear>, weder aber
<lb n="41"/>wann man <unclear cert="medium" resp="#joint">dergleich</unclear> <unclear cert="medium" resp="#joint">anwald</unclear>-
<lb n="42"/><unclear cert="medium" resp="#joint">schafften</unclear> sich gebrauchen wurde.
<lb n="43"/>Deßhalben wir dem <unclear cert="medium" resp="#joint">Anfangen</unclear>
<lb n="44"/><unclear cert="medium" resp="#joint">seiner</unclear> <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">unzimliche</unclear> Pitt ge-
<lb n="45"/>willfahret, und <persName resp="#ner">Haler</persName>
<lb n="46"/><unclear cert="low" resp="#joint">darauff</unclear> ihme <unclear cert="low" resp="#joint">baide</unclear> <unclear cert="low" resp="#joint">newe</unclear> Rechts-
<lb n="47"/>tag <unclear cert="low" resp="#joint">bestimbt</unclear>, bestimmen und er-
<lb n="48"/><unclear cert="low" resp="#joint">nennen</unclear> ihme <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">auff</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">Mon</unclear>-
<lb n="49"/><unclear cert="low" resp="#joint">tags</unclear> <unclear cert="low" resp="#joint">Mentag</unclear> <unclear cert="low" resp="#joint">den</unclear> andern <unclear cert="low" resp="#joint">nechst</unclear>-
<lb n="50"/><unclear cert="low" resp="#joint">angehenden</unclear> <unclear cert="low" resp="#joint">Monats</unclear> tag Julij</date> <unclear cert="low" resp="#joint">alts</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">Calenders</unclear> alhie vor <unclear cert="low" resp="#joint">unserm</unclear> Statt-
<lb n="52"/><unclear cert="medium" resp="#joint">gricht</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> daselbst-
<lb n="53"/><unclear cert="low" resp="#joint">hi</unclear> <unclear cert="low" resp="#joint">dise</unclear> Rechtssach <unclear cert="medium" resp="#joint">ghoerig</unclear>, und albe-
<lb n="54"/><unclear cert="low" resp="#joint">reit</unclear> <unclear cert="low" resp="#joint">Rechtsanhengig</unclear> gemacht ist.
<lb n="55"/><unclear cert="low" resp="#joint">Gelangt</unclear> dem allem nach an E. E.
<lb n="56"/>W. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">G</unclear>. unser <unclear cert="low" resp="#joint">freundtlichs</unclear>
<lb n="57"/>begern und <unclear cert="low" resp="#joint">ersuechen</unclear>, dieselben
<pb facs="StadtASG_Missive_2340_8961.jpg" n="3"/>
<lb n="58"/><unclear cert="medium" resp="#joint">geliebe</unclear> <unclear cert="medium" resp="#joint">nit</unclear> allein <unclear cert="low" resp="#joint">mehrermeltem</unclear>
<lb n="59"/>ihrem <unclear cert="low" resp="#joint">angehoerigen</unclear> <unclear cert="low" resp="#joint">burgern</unclear>, disen
<lb n="60"/><unclear cert="medium" resp="#joint">ernanten</unclear> tag <unclear cert="low" resp="#joint">anzekünden</unclear>, sonder
<lb n="61"/><unclear cert="low" resp="#joint">darbeij</unclear> auch <unclear cert="low" resp="#joint">nohmalen</unclear> mit allem
<lb n="62"/><unclear cert="low" resp="#joint">oberkeitlichem</unclear> <unclear cert="medium" resp="#joint">ernst</unclear> <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">gebürr</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">dergstalt</unclear> <unclear cert="low" resp="#joint">anzeweißen</unclear>, daß er
<lb n="64"/>sich <unclear cert="medium" resp="#joint">nunmehr</unclear> ohne ferners <unclear cert="low" resp="#joint">ußbleiben</unclear>
<lb n="65"/>vor obgemeltem <unclear cert="medium" resp="#joint">unsers</unclear> <unclear cert="medium" resp="#joint">stattgrichts</unclear>
<lb n="66"/><unclear cert="medium" resp="#joint">weder</unclear> <unclear cert="medium" resp="#joint">persoendlih</unclear> erscheine und stelle,
<lb n="67"/>sein <unclear cert="low" resp="#joint">gethanes</unclear> <unclear cert="low" resp="#joint">versprechen</unclear> und das recht <unclear cert="low" resp="#joint">angefangener</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">noher</unclear> <unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">ußüebe</unclear>.
<lb n="69"/>Das <unclear cert="low" resp="#joint">gereiht</unclear> zu <unclear cert="low" resp="#joint">befuerderung</unclear> der
<lb n="70"/>justici, und wir <unclear cert="low" resp="#joint">sind</unclear> <unclear cert="low" resp="#joint">es</unclear> umb
<lb n="71"/>E. E. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">Fr</unclear>. <unclear cert="low" resp="#joint">Nl</unclear>. in <unclear cert="low" resp="#joint">glihen</unclear>
