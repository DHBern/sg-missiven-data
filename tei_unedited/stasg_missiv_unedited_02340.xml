<lb n="76"/><origDate when="1622" resp="#ner">den. <unclear cert="low" resp="#joint">22ten</unclear>. <unclear cert="medium" resp="#joint">junij</unclear>. 1622.</origDate>
<lb n="77"/><unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>.
<lb n="78"/>d. <unclear cert="low" resp="#joint">w</unclear>. <unclear cert="low" resp="#joint">guete</unclear>
<lb n="79"/>An statt <placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Costanz</unclear></placeName>.
