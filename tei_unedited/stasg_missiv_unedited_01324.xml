<lb n="25"/><unclear cert="medium" resp="#joint">lichem</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> <unclear cert="low" resp="#joint">treülich</unclear> <unclear cert="low" resp="#joint">befelhende</unclear>. Datum den <origDate when="1595" resp="#ner">8.ten Novembris
