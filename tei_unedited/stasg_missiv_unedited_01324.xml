<lb n="1"/><unclear cert="low" resp="#joint">Unßer</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear> und <unclear cert="low" resp="#joint">nachpuerlich</unclear> willig dienst sampt
<lb n="2"/>was wir <unclear cert="medium" resp="#joint">ehren</unclear> liebs und <unclear cert="low" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermögend</unclear> zuvor, <unclear cert="low" resp="#joint">fromm</unclear>
<lb n="3"/>fürsichtig ehrsam <unclear cert="low" resp="#joint">weyß</unclear> insonders <unclear cert="low" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">fründ</unclear> und ge=
<lb n="4"/><unclear cert="low" resp="#joint">trewwe</unclear> lieb <unclear cert="low" resp="#joint">nachpueren</unclear>. Wir sind <unclear cert="low" resp="#joint">unzwyffels</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">ohne</unclear>, ir <unclear cert="low" resp="#joint">habend</unclear> <unclear cert="low" resp="#joint">üch</unclear> noch wol <unclear cert="low" resp="#joint">zuerinnern</unclear>, <unclear cert="medium" resp="#joint">welcher</unclear> ge=
<lb n="6"/>stalt, wir <unclear cert="low" resp="#joint">unß</unclear> etliche <unclear cert="low" resp="#joint">malen</unclear> <unclear cert="low" resp="#joint">bejdersejts</unclear> gegen <unclear cert="medium" resp="#joint">und</unclear>,
<lb n="7"/>mit ein <unclear cert="low" resp="#joint">andern</unclear> von wegen der <unclear cert="low" resp="#joint">erbfählen</unclear> verglichen
<lb n="8"/>wöllen, <unclear cert="medium" resp="#joint">so</unclear> auch <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">selbiges</unclear> darumb <unclear cert="medium" resp="#joint">offter</unclear> <unclear cert="medium" resp="#joint">malen</unclear> <unclear cert="medium" resp="#joint">tag</unclear>
