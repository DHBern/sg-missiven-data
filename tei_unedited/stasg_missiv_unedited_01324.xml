<lb n="16"/><unclear cert="low" resp="#joint">andern</unclear> der <unclear cert="low" resp="#joint">erbfählen</unclear> halben, <unclear cert="low" resp="#joint">vereinbaren</unclear> <unclear cert="low" resp="#joint">köntend</unclear>,
