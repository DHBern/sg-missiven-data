<lb n="7"/>umb <unclear cert="medium" resp="#joint">bescheinung</unclear> ihrer <unclear cert="low" resp="#joint">grechtsaminen</unclear>, <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">erneüwerung</unclear>
<lb n="8"/>unnd <unclear cert="medium" resp="#joint">bestätigung</unclear> <unclear cert="medium" resp="#joint">ihrer</unclear> der <unclear cert="medium" resp="#joint">darueber</unclear> habenden <unclear cert="low" resp="#joint">briefen</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">anzuehalten</unclear>, <unclear cert="low" resp="#joint">das</unclear> habend <unclear cert="medium" resp="#joint">wir</unclear> auß <unclear cert="medium" resp="#joint">seinem</unclear> den <date resp="#ner">14. <unclear cert="medium" resp="#joint">diß</unclear></date>
<lb n="10"/>an uns <unclear cert="medium" resp="#joint">abgfloßnen</unclear> <unclear cert="medium" resp="#joint">schreiben</unclear>, <unclear cert="medium" resp="#joint">mit</unclear> <unclear cert="medium" resp="#joint">mehrem</unclear> <unclear cert="medium" resp="#joint">vernomen</unclear>:
<lb n="11"/>haben <unclear cert="medium" resp="#joint">auch</unclear> nit <unclear cert="medium" resp="#joint">ermanglen</unclear> <unclear cert="medium" resp="#joint">wöllen</unclear>, <unclear cert="medium" resp="#joint">daßelbig</unclear> den <unclear cert="low" resp="#joint">un</unclear>-
