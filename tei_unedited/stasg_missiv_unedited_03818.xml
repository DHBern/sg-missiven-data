<lb n="27"/>an die <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">gesuecht</unclear>, oder begert worden: <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear>
<lb n="28"/>den <unclear cert="medium" resp="#joint">herren</unclear> <unclear cert="medium" resp="#joint">wir</unclear>, in der <unclear cert="medium" resp="#joint">unserigen</unclear> namen hiemit <unclear cert="medium" resp="#joint">früendt</unclear>-
