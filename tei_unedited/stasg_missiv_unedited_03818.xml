<lb n="13"/><unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">communiciren</unclear>: die habend unß <unclear cert="medium" resp="#joint">hirauf</unclear> <unclear cert="medium" resp="#joint">gehorsambst</unclear>
<lb n="14"/>berichtet, <unclear cert="medium" resp="#joint">ds</unclear> <unclear cert="medium" resp="#joint">ihren</unclear> der <unclear cert="medium" resp="#joint">mehre</unclear> <unclear cert="medium" resp="#joint">theil</unclear> <unclear cert="medium" resp="#joint">ihre</unclear> <unclear cert="medium" resp="#joint">torggelrecht</unclear>
