<lb n="31"/><unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">brieff</unclear> <unclear cert="low" resp="#joint">aufrichte</unclear> <unclear cert="low" resp="#joint">werde</unclear>, <unclear cert="low" resp="#joint">damahlß</unclear> <unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">habende</unclear>
