<p>
<pb facs="StadtASG_Missive_3818_15399.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">früendt</unclear> nachbarlich willig dienst, unnd <unclear cert="medium" resp="#joint">früendt</unclear>-
<lb n="2"/><unclear cert="medium" resp="#joint">lichen</unclear> <unclear cert="medium" resp="#joint">grueß</unclear> <unclear cert="medium" resp="#joint">zuevor</unclear>, <unclear cert="medium" resp="#joint">Eerend</unclear>- <unclear cert="medium" resp="#joint">Ehrnvester</unclear>, unnd <unclear cert="medium" resp="#joint">Weiser</unclear>, be-
<lb n="3"/>sonders <unclear cert="medium" resp="#joint">lieber</unclear> Herr Landtvogt, <unclear cert="medium" resp="#joint">guetter</unclear> <unclear cert="medium" resp="#joint">früendt</unclear> <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">Nachbar</unclear>.
<lb n="5"/>Was den <unclear cert="medium" resp="#joint">herren</unclear> <unclear cert="medium" resp="#joint">Nachbarn</unclear> <unclear cert="medium" resp="#joint">verursachet</unclear> habe, <unclear cert="low" resp="#joint">uunser</unclear> <unclear cert="low" resp="#joint">burger</unclear>,
