<lb n="6"/>lieb <unclear cert="low" resp="#joint">Eidtgenoßen</unclear>.
<lb n="7"/><unclear cert="low" resp="#joint">Uber</unclear> üwer <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">fründtliches</unclear> <unclear cert="low" resp="#joint">er</unclear>-
