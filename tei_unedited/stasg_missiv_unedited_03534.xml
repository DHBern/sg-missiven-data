<lb n="10"/>der, <unclear cert="medium" resp="#joint">jener</unclear> zuo <unclear cert="medium" resp="#joint">Morsee</unclear>, <unclear cert="medium" resp="#joint">dißer</unclear> aber Inn <unclear cert="medium" resp="#joint">Ihrer</unclear>
