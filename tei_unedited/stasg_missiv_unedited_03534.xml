<lb n="3"/><unclear cert="medium" resp="#joint">ung</unclear> <unclear cert="medium" resp="#joint">eines</unclear> <unclear cert="medium" resp="#joint">fridsamen</unclear> und <unclear cert="low" resp="#joint">freüdenrychen</unclear> ge-
<lb n="4"/><unclear cert="medium" resp="#joint">sunden</unclear> <unclear cert="medium" resp="#joint">Nüwen</unclear> <unclear cert="medium" resp="#joint">Jahrs</unclear>, <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="medium" resp="#joint">Fromb</unclear>, Fürsichtig,
