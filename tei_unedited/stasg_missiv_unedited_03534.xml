<lb n="12"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="medium" resp="#joint">Kaufflüthen</unclear> nit geringen <unclear cert="low" resp="#joint">beschwerd</unclear> <unclear cert="low" resp="#joint">unlangst</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">ufgerichten</unclear> <unclear cert="low" resp="#joint">nüwen</unclear> <unclear cert="low" resp="#joint">zöllen</unclear>, <unclear cert="low" resp="#joint">durch</unclear> schryben, <unclear cert="medium" resp="#joint">Eidt</unclear>-
