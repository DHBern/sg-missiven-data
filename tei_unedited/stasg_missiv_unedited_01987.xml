<p>
<pb facs="StadtASG_Missive_1987_7405.jpg" n="1"/>
<lb n="1"/>Unser freündtlich <unclear cert="medium" resp="#joint">willig</unclear> <unclear cert="low" resp="#joint">dinnst</unclear>, unnd was wir
<lb n="2"/>liebs unnd guots vermögend, <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">Fromer</unclear> <unclear cert="medium" resp="#joint">Edler</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">vester</unclear> unnd <unclear cert="low" resp="#joint">Weiser</unclear>, Insonnders lieber Herr Lanndt-
<lb n="4"/>vogt, <unclear cert="low" resp="#joint">guoter</unclear> Freündt unnd Nachbar.
<lb n="5"/><unclear cert="medium" resp="#joint">Der</unclear> <unclear cert="medium" resp="#joint">erzeigten</unclear> <unclear cert="medium" resp="#joint">Ehren</unclear>, wie auch der freündtnachbar-
<lb n="6"/>lichen <unclear cert="medium" resp="#joint">willfahrung</unclear>, bey <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">getreüwen</unclear>
<lb n="7"/>lieben <unclear cert="low" resp="#joint">MitRhat</unclear> unnd Underburgermeister <persName resp="#ner">Jacob <unclear cert="medium" resp="#joint">Allgö</unclear>-
<lb n="8"/><unclear cert="medium" resp="#joint">wern</unclear></persName> und <persName resp="#ner"><unclear cert="low" resp="#joint">Josue</unclear> <unclear cert="low" resp="#joint">Keßlern</unclear></persName> <unclear cert="low" resp="#joint">Grichtschreibern</unclear>, (die uns
<lb n="9"/><unclear cert="medium" resp="#joint">solches</unclear> nicht <unclear cert="low" resp="#joint">genuogsam</unclear> <unclear cert="low" resp="#joint">anruemen</unclear> <unclear cert="low" resp="#joint">können</unclear>), <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">ihrer</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">Ihrer</unclear> <unclear cert="low" resp="#joint">Relation</unclear> <unclear cert="low" resp="#joint">werbung</unclear>, wegen <unclear cert="medium" resp="#joint">ainer</unclear> <unclear cert="medium" resp="#joint">von</unclear> gefangnen, begegnet,
<lb n="11"/><unclear cert="medium" resp="#joint">thuond</unclear> wir <unclear cert="medium" resp="#joint">unns</unclear> gegen Eüch <unclear cert="medium" resp="#joint">gar</unclear> freündt-
<lb n="12"/>nachbarlichen bedanckhen. Unnd <unclear cert="medium" resp="#joint">schickhen</unclear>
<lb n="13"/>Eüch hiemit den begerten Revers <unclear cert="low" resp="#joint">zueligend</unclear> zu, <unclear cert="medium" resp="#joint">Im</unclear>
<lb n="14"/>fall nun derselb nach <unclear cert="medium" resp="#joint">eüwerem</unclear> gefallen, <unclear cert="low" resp="#joint">werdend</unclear>
<lb n="15"/>ihr ihne behalten, wo aber nit, <unclear cert="medium" resp="#joint">wöllendt</unclear> ihne
<lb n="16"/><unclear cert="low" resp="#joint">solchen</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">verbesseren</unclear> unnd unns wider <unclear cert="low" resp="#joint">zuoschickhen</unclear>, solle
<lb n="17"/>alßdann derselbig nach <unclear cert="medium" resp="#joint">eüwerem</unclear> <unclear cert="medium" resp="#joint">belieben</unclear> <unclear cert="medium" resp="#joint">ver</unclear>-
<lb n="18"/>fertiget werden. FreündtNachbar-
<lb n="19"/>lich <unclear cert="medium" resp="#joint">Pittende</unclear> unsern abgeordneten
<lb n="20"/><unclear cert="medium" resp="#joint">Demnach</unclear> so haben wir <unclear cert="low" resp="#joint">anjero</unclear> <unclear cert="low" resp="#joint">sollen</unclear> Ulrich <unclear cert="low" resp="#joint">Ruchen</unclear>.
<lb n="21"/>und <persName resp="#ner"><unclear cert="medium" resp="#joint">Joseph</unclear> <unclear cert="low" resp="#joint">Wildinen</unclear></persName> <unclear cert="low" resp="#joint">Stattknecht</unclear> abgeordnet
<lb n="22"/>die <unclear cert="medium" resp="#joint">gefangne</unclear> <unclear cert="medium" resp="#joint">abzuholen</unclear>, freündtnachbarlich
<lb n="23"/><unclear cert="medium" resp="#joint">Pittend</unclear>, ihnen die selbig an <unclear cert="low" resp="#joint">gebürenden</unclear> <unclear cert="low" resp="#joint">ortt</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">überlifferen</unclear> zulassen, unnd hierinn
<lb n="25"/><unclear cert="low" resp="#joint">hiemit</unclear> alle <unclear cert="low" resp="#joint">guote</unclear> anleitung <unclear cert="low" resp="#joint">zugeben</unclear>. Waß
<lb n="26"/>nun für <unclear cert="medium" resp="#joint">Unkhosten</unclear> <unclear cert="medium" resp="#joint">ufgehen</unclear> <unclear cert="medium" resp="#joint">möchte</unclear>, <unclear cert="medium" resp="#joint">haben</unclear> wir
<lb n="27"/>ihnen <unclear cert="low" resp="#joint">ge</unclear>- <unclear cert="low" resp="#joint">neben</unclear> <unclear cert="low" resp="#joint">disen</unclear> <unclear cert="low" resp="#joint">zueentrichten</unclear>, <unclear cert="low" resp="#joint">bevolch</unclear>-
<lb n="28"/><unclear cert="low" resp="#joint">wechen</unclear> sy <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">Nachberlich</unclear> <unclear cert="low" resp="#joint">gehall</unclear>- In <unclear cert="low" resp="#joint">allem</unclear> <unclear cert="low" resp="#joint">gantzern</unclear> <unclear cert="low" resp="#joint">wolhernamen</unclear> <unclear cert="low" resp="#joint">gnueg</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">ten</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">masßen</unclear> <unclear cert="low" resp="#joint">zaiger</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">niemand</unclear> <unclear cert="low" resp="#joint">geboret</unclear> <unclear cert="low" resp="#joint">sye</unclear>, daß begeren wir umb
<lb n="30"/><unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">wens</unclear> zuo <unclear cert="low" resp="#joint">klagen</unclear> <unclear cert="low" resp="#joint">gehebt</unclear> <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">hinwiderumb</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">zuetragende</unclear> <unclear cert="low" resp="#joint">occasion</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">Wellches</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">hiebey</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">ungen</unclear> <unclear cert="low" resp="#joint">bereitwillig</unclear> <unclear cert="low" resp="#joint">zuverdinen</unclear>, <unclear cert="low" resp="#joint">biß</unclear> wir Gott <unclear cert="low" resp="#joint">biten</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">zedencken</unclear>, <unclear cert="low" resp="#joint">etc</unclear>. <unclear cert="low" resp="#joint">Er</unclear> <unclear cert="low" resp="#joint">es</unclear> samptlich in seinen <unclear cert="medium" resp="#joint">gnedig</unclear> schutz und schirm
<lb n="33"/>erhalten <unclear cert="low" resp="#joint">wölle</unclear>. Datum den <origDate when="1618-04-27" resp="#ner"><unclear cert="low" resp="#joint">27</unclear>. Aprilis <unclear cert="medium" resp="#joint">Ao</unclear> <unclear cert="medium" resp="#joint">1618</unclear></origDate>.
<lb n="34"/><orgName role="issuer" resp="#ner">B. u <unclear cert="low" resp="#joint">Rhat</unclear> d</orgName>
<lb n="35"/><unclear cert="medium" resp="#joint">Uechern</unclear> <persName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Ulrich</unclear> <unclear cert="medium" resp="#joint">Ruchen</unclear></persName> und <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Statt St. Gallen</placeName>.
<lb n="36"/><persName resp="#ner"><unclear cert="low" resp="#joint">Wildinen</unclear></persName> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">befelchen</unclear>.
<pb facs="StadtASG_Missive_1987_7406.jpg" n="2"/>
<pb facs="StadtASG_Missive_1987_7407.jpg" n="3"/>
<pb facs="StadtASG_Missive_1987_7408.jpg" n="4"/>
<lb n="37"/>An H. <persName role="issuer" resp="#ner">Ulrich Tschudi</persName> <unclear cert="low" resp="#joint">Ldvogt</unclear> im <placeName ref="stadtasg-places-64" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rheinthal</unclear></placeName>
<lb n="38"/><origDate when="1616-04-13" resp="#ner">13. aprilis 1616</origDate> weg liferung etlicher
<lb n="39"/>gefangner ud gegebnen revers.
</p>
