    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1535_5553.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">fründtlich</unclear> willig dienst, unnd was wir
<lb n="2"/><unclear cert="low" resp="#joint">eern</unclear> liebs und guots <unclear cert="low" resp="#joint">vermuegen</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">Edler</unclear> vester
<lb n="3"/><unclear cert="medium" resp="#joint">unndt</unclear> <unclear cert="medium" resp="#joint">weiser</unclear>, innsonders <unclear cert="low" resp="#joint">günstiger</unclear> lieber herr undt
<lb n="4"/><unclear cert="medium" resp="#joint">fründt</unclear>.
<lb n="5"/>Nachdem <unclear cert="medium" resp="#joint">unlangsten</unclear> <persName resp="#ner">Hans <unclear cert="low" resp="#joint">Bornhauser</unclear></persName> von <placeName resp="#ner"><unclear cert="low" resp="#joint">Weersteten</unclear></placeName>,
<lb n="6"/>in der landtgraffschafft <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Turgaew</unclear></placeName> gelegen, <unclear cert="low" resp="#joint">zeiger</unclear> diß, sich
<lb n="7"/><unclear cert="low" resp="#joint">unlangsten</unclear> in unserm spital <unclear cert="low" resp="#joint">verpfruendet</unclear>, und an iezo
<lb n="8"/>willens ist, <unclear cert="medium" resp="#joint">sein</unclear> <unclear cert="medium" resp="#joint">aermuetlin</unclear>, <unclear cert="medium" resp="#joint">zur</unclear> bezahlung <unclear cert="medium" resp="#joint">ermelter</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">pfruendt</unclear> alhero <unclear cert="low" resp="#joint">zuezüehen</unclear>, hat er uns underthenig ge-
<lb n="10"/><unclear cert="low" resp="#joint">beten</unclear> (damit er desto <unclear cert="low" resp="#joint">sicherer</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">seinen</unclear> khomen moege)
<lb n="11"/>wir <unclear cert="low" resp="#joint">wolten</unclear> ime mit unser <unclear cert="low" resp="#joint">fürschrifft</unclear>, an den herren
<lb n="12"/><unclear cert="low" resp="#joint">behülfflich</unclear> erscheinen, <unclear cert="medium" resp="#joint">gueter</unclear> <unclear cert="medium" resp="#joint">zueversicht</unclear>, er derselbigen
<lb n="13"/>wol geniessen werde.
<lb n="14"/><unclear cert="low" resp="#joint">Wann</unclear> wir unns nun wol zue <unclear cert="low" resp="#joint">erinderen</unclear>, das nit allein
<lb n="15"/>die statt <placeName ref="stadtasg-places-29" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Frawenfeldt</unclear></placeName> vor gar vil jaren, <unclear cert="medium" resp="#joint">sonderen</unclear> auch
<lb n="16"/>die landtgraffschafft <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Turgaew</unclear></placeName> bei <unclear cert="low" resp="#joint">khürzen</unclear> jaren sich
<lb n="17"/>mit unser statt, dahin <unclear cert="low" resp="#joint">vereindt</unclear> und verglichen, das alle
<lb n="18"/>diejenigen personen so <unclear cert="low" resp="#joint">uß</unclear> der landtgraffschafft <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Turgaew</unclear></placeName>
<lb n="19"/>in unnser statt unnd <unclear cert="low" resp="#joint">gricht</unclear> <unclear cert="low" resp="#joint">alheroziehen</unclear>, und dann die-
<lb n="20"/><unclear cert="low" resp="#joint">ienigen</unclear> so <unclear cert="low" resp="#joint">uß</unclear> unnser statt unnd <unclear cert="medium" resp="#joint">gricht</unclear> in die landt-
<lb n="21"/>graffschafft <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Turgaew</unclear></placeName> ziehen <unclear cert="medium" resp="#joint">woellen</unclear>, ohne <unclear cert="medium" resp="#joint">einichen</unclear> <unclear cert="low" resp="#joint">abzuge</unclear>
<lb n="22"/>allen passiret und frei gelassen werden. Und <unclear cert="low" resp="#joint">weilen</unclear>
<lb n="23"/>nun solches bis dato von beiden <unclear cert="medium" resp="#joint">theilen</unclear> also <unclear cert="medium" resp="#joint">continuieret</unclear>
<lb n="24"/>unnd gehalten worden. wellen wir <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">gennz</unclear>-
<lb n="25"/>lich getroesten unnd versehen, <unclear cert="medium" resp="#joint">der</unclear> herr werde <unclear cert="medium" resp="#joint">obgedachten</unclear>
<pb facs="StadtASG_Missive_1535_5554.jpg" n="2"/>
<lb n="26"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Bornhauser</unclear></persName>, in ansehung <unclear cert="medium" resp="#joint">obgemelter</unclear> vergleichunge
<lb n="27"/><unclear cert="medium" resp="#joint">ohne</unclear> <unclear cert="medium" resp="#joint">entgelth</unclear>. unnd <unclear cert="medium" resp="#joint">ohne</unclear> erlegung <unclear cert="medium" resp="#joint">einiches</unclear> <unclear cert="medium" resp="#joint">abzugs</unclear>
<lb n="28"/><unclear cert="medium" resp="#joint">hinziehen</unclear>, unnd kainer hindernuß <unclear cert="medium" resp="#joint">passiren</unclear> <unclear cert="medium" resp="#joint">lasßen</unclear>.
<lb n="29"/>Das <unclear cert="medium" resp="#joint">steth</unclear> <unclear cert="medium" resp="#joint">unns</unclear> neben <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">Bornhauser</unclear>, <unclear cert="medium" resp="#joint">uff</unclear> alle für=
<lb n="30"/><unclear cert="medium" resp="#joint">fallendte</unclear> <unclear cert="medium" resp="#joint">gelegenhait</unclear> freündtlich, unnd <unclear cert="medium" resp="#joint">eidtgnößisch</unclear> zuo
<lb n="31"/>verdienen, <unclear cert="low" resp="#joint">goettlicher</unclear> <unclear cert="low" resp="#joint">bewahr</unclear> <unclear cert="low" resp="#joint">unß</unclear> beneben <unclear cert="medium" resp="#joint">samethlich</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">bevelhendt</unclear>. Datum den <origDate when="1607-01-29" resp="#ner">29. januarij <unclear cert="medium" resp="#joint">ao</unclear> 1607</origDate>.
<lb n="33"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> unnd <unclear cert="medium" resp="#joint">rath</unclear>
<lb n="34"/>der statt Sant Gallen</orgName> <unclear cert="low" resp="#joint">ss</unclear>.
<lb n="35"/>Dem edlen <unclear cert="low" resp="#joint">und</unclear> vesten <persName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Anthoni</unclear> <unclear cert="medium" resp="#joint">Schmid</unclear></persName>
<lb n="36"/>deß raths zuo Urij <unclear cert="medium" resp="#joint">ud</unclear> <unclear cert="medium" resp="#joint">der</unclear> zeit <unclear cert="medium" resp="#joint">Lvogt</unclear> im
<lb n="37"/><placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Nidren</unclear> und <unclear cert="medium" resp="#joint">Obren</unclear> <unclear cert="medium" resp="#joint">Turgoew</unclear></placeName> <unclear cert="medium" resp="#joint">unserm</unclear>
<lb n="38"/>sonders <unclear cert="medium" resp="#joint">günstige</unclear> lieben herren
<lb n="39"/>unndt freündt.
</p>
