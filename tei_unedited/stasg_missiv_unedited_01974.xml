        <body>
<p>
<pb facs="StadtASG_Missive_1974_7357.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> fründtlich willig dienst und <unclear cert="medium" resp="#joint">grueß</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">sampt</unclear> <unclear cert="medium" resp="#joint">wz</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">eeren</unclear> liebs und guots <unclear cert="medium" resp="#joint">vermoegend</unclear>
<lb n="3"/>zuovor, fromm fürsichtig wyß insonders <unclear cert="medium" resp="#joint">guote</unclear>
<lb n="4"/>fründ und <unclear cert="medium" resp="#joint">getrüwe</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">Eid</unclear>: und <unclear cert="medium" resp="#joint">Pundts</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">gnoßen</unclear>.
<lb n="6"/><unclear cert="medium" resp="#joint">Üwer</unclear> schryben und <unclear cert="medium" resp="#joint">dancksagung</unclear> <unclear cert="medium" resp="#joint">waegen</unclear> <unclear cert="medium" resp="#joint">der</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">üwerigen</unclear> mit <unclear cert="medium" resp="#joint">ire</unclear> <unclear cert="medium" resp="#joint">Fr</unclear>: <unclear cert="medium" resp="#joint">Gst</unclear>. <unclear cert="medium" resp="#joint">us</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Safoy</unclear></placeName> inter
<lb n="8"/><unclear cert="medium" resp="#joint">essierenden</unclear> <unclear cert="medium" resp="#joint">burgeren</unclear>, hand wir zuo <unclear cert="medium" resp="#joint">guotem</unclear> <unclear cert="medium" resp="#joint">empfan</unclear>,
<lb n="9"/>gen, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">darus</unclear> <unclear cert="low" resp="#joint">ermeßen</unclear>, <unclear cert="low" resp="#joint">das</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">wenige</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">von</unclear> uns <unclear cert="medium" resp="#joint">beschehen</unclear>, <unclear cert="medium" resp="#joint">danckbaren</unclear> wider
<lb n="11"/>fahren ist also <unclear cert="medium" resp="#joint">sollend</unclear> wir <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">dz</unclear> <unclear cert="medium" resp="#joint">feerner</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">nach</unclear> <unclear cert="medium" resp="#joint">unserem</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear> zuo continuieren
<lb n="13"/><unclear cert="medium" resp="#joint">hiemit</unclear> <unclear cert="medium" resp="#joint">erbietten</unclear>, wie es an <unclear cert="medium" resp="#joint">sonderbarem</unclear> <unclear cert="medium" resp="#joint">verseh</unclear>,
<lb n="14"/><unclear cert="medium" resp="#joint">nen</unclear> so hievon in <unclear cert="low" resp="#joint">bestes</unclear> <unclear cert="low" resp="#joint">gethon</unclear> <unclear cert="low" resp="#joint">feerner</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">er</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">manglen</unclear>. <unclear cert="low" resp="#joint">Andtreffend</unclear> <unclear cert="low" resp="#joint">aber</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">stattschryber</unclear>, <unclear cert="low" resp="#joint">koennend</unclear> <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">u</unclear> <unclear cert="low" resp="#joint">g</unclear> <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
<lb n="17"/>und <unclear cert="low" resp="#joint">Pundtsgnoßen</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">yrem</unclear> <unclear cert="low" resp="#joint">wyßen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">verstand</unclear> <unclear cert="low" resp="#joint">erachten</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">schwaerlich</unclear> <unclear cert="low" resp="#joint">waegen</unclear> <unclear cert="low" resp="#joint">teglich</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">obligenden</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nüwlich</unclear> <unclear cert="low" resp="#joint">infallenden</unclear> <unclear cert="low" resp="#joint">geschaefften</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">fürkomme</unclear>, <unclear cert="low" resp="#joint">selbigen</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">uns</unclear> und in die <unclear cert="medium" resp="#joint">froembde</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">zelaßen</unclear>, <unclear cert="medium" resp="#joint">nüt</unclear> desto weniger <unclear cert="medium" resp="#joint">angesahen</unclear> <unclear cert="medium" resp="#joint">üwer</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">stathliche</unclear> <unclear cert="medium" resp="#joint">intercession</unclear>, und deren <unclear cert="medium" resp="#joint">interessierenden</unclear>
<lb n="23"/><unclear cert="medium" resp="#joint">instendige</unclear> supplication, hand wir <unclear cert="medium" resp="#joint">dis</unclear> <unclear cert="medium" resp="#joint">einmahl</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">gestattet</unclear> und vergünstiget. <unclear cert="low" resp="#joint">Verner</unclear> aber
<lb n="25"/><unclear cert="medium" resp="#joint">uochßen</unclear> <unclear cert="medium" resp="#joint">sollend</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">hinderblyben</unclear> so lang sich <unclear cert="low" resp="#joint">solte</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">verwyllen</unclear>, <unclear cert="low" resp="#joint">unangesahen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">u</unclear> <unclear cert="low" resp="#joint">g</unclear> <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
<lb n="27"/>und den <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">vermoegens</unclear> <unclear cert="low" resp="#joint">zudienen</unclear> gneigt.
<pb facs="StadtASG_Missive_1974_7358.jpg" n="2"/>
<lb n="28"/><unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">berait</unclear> <unclear cert="low" resp="#joint">daraß</unclear> <unclear cert="low" resp="#joint">us</unclear> <unclear cert="low" resp="#joint">grosser</unclear> <unclear cert="low" resp="#joint">ungelägenhait</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">schwaerlich</unclear> <unclear cert="low" resp="#joint">gefallen</unclear>, <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">stattschrybers</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">rais</unclear> der <unclear cert="low" resp="#joint">gestalt</unclear> in zeinwilligen. Wyl
<lb n="31"/>aber <unclear cert="low" resp="#joint">die</unclear> in <unclear cert="low" resp="#joint">uwerem</unclear> <unclear cert="low" resp="#joint">schryben</unclear> <unclear cert="low" resp="#joint">vertroeste</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">zit</unclear> <unclear cert="low" resp="#joint">dergschaefft</unclear> nun mehr hin und laufft,
<lb n="33"/>und sovil als veroerteret sye, wellend wir noch
<lb n="34"/>etwz zyt hindan gsetzt, unserer grossen be
<lb n="35"/><unclear cert="low" resp="#joint">schwerdt</unclear> <unclear cert="low" resp="#joint">geduld</unclear> <unclear cert="low" resp="#joint">tragen</unclear>, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">hoffende</unclear> <unclear cert="low" resp="#joint">uwer</unclear> ver
<lb n="36"/>troestung gemaeß beschächen, und der unser bald
<lb n="37"/>widerumb sich in sin dienst instellen werde.
<lb n="38"/>Sonsten wann es sich wytter in die <unclear cert="low" resp="#joint">zytt</unclear> <unclear cert="low" resp="#joint">erstreken</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">woelte</unclear>, <unclear cert="low" resp="#joint">waere</unclear> <unclear cert="low" resp="#joint">us</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">mueglich</unclear> <unclear cert="low" resp="#joint">unsers</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">stattschrybers</unclear> <unclear cert="low" resp="#joint">ferners</unclear> <unclear cert="low" resp="#joint">zeermanglen</unclear>. <unclear cert="low" resp="#joint">Wo</unclear> wir
<lb n="41"/>sonsten in disen und andren sachen, ferner
<lb n="42"/>uch und den uwrigen alle Eidgnoessische frund
<lb n="43"/>schfft, gunst und hielff bewyßen koennen, wer-
<lb n="44"/>dend ir us alzyt gantz willig und ohnge-
<lb n="45"/>spardt finden. Des allmaechtigen Gottes
<lb n="46"/>gnaedigen beschirmung us allersyt gantz
<lb n="47"/>flyssig befelhende. Datum <origPlace ref="stadtasg-places-69" cert="medium" resp="#ner">Lucern</origPlace>
<lb n="48"/><origDate when="1615" resp="#ner">den 19. <unclear cert="low" resp="#joint">t</unclear>. <unclear cert="low" resp="#joint">10bris</unclear> <unclear cert="low" resp="#joint">Ao</unclear> 1615</origDate>.
<lb n="49"/><orgName role="issuer" resp="#ner">Schultheiß und rath
<lb n="50"/>der statt Lucern</orgName>
<pb facs="StadtASG_Missive_1974_7359.jpg" n="3"/>
<pb facs="StadtASG_Missive_1974_7360.jpg" n="4"/>
<lb n="51"/><unclear cert="medium" resp="#joint">Denen</unclear> frommen <unclear cert="medium" resp="#joint">fuernemmen</unclear> <unclear cert="medium" resp="#joint">fuer</unclear>
<lb n="52"/><unclear cert="medium" resp="#joint">sichtigen</unclear> und <unclear cert="medium" resp="#joint">wyßen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="53"/><unclear cert="medium" resp="#joint">meisteren</unclear> und <unclear cert="medium" resp="#joint">Rhatt</unclear> der Statt St:
<lb n="54"/>Gallen</orgName>. <unclear cert="medium" resp="#joint">Unseren</unclear> insonders <unclear cert="medium" resp="#joint">guotten</unclear>
<lb n="55"/>fründen. und getrüwen lieben
<lb n="56"/><unclear cert="medium" resp="#joint">Eidtgnossen</unclear>.
</p>
