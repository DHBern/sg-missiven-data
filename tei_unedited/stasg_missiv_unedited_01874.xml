<lb n="10"/>haben. Dann <unclear cert="low" resp="#joint">dieweil</unclear> im <orgName ref="stadtasg-actors-559" cert="medium" resp="#ner">Reich</orgName> in <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">müntzwë=</unclear>
