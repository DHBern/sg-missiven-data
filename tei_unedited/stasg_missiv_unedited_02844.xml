<pb facs="StadtASG_Missive_2844_11172.jpg" n="4"/>
<lb n="60"/>Denen <unclear cert="low" resp="#joint">ersamen</unclear> <unclear cert="low" resp="#joint">weysen</unclear>, <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">lieben</unclear>
