<lb n="82"/><unclear cert="medium" resp="#joint">komen</unclear> <unclear cert="medium" resp="#joint">werde</unclear>. <unclear cert="medium" resp="#joint">Auch</unclear> ist einer <unclear cert="medium" resp="#joint">e</unclear>. statt <placeName ref="stadtasg-places-13" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Bern</unclear></placeName> <unclear cert="medium" resp="#joint">underthan</unclear>.
<lb n="83"/>so nit <unclear cert="medium" resp="#joint">under</unclear> der <unclear cert="medium" resp="#joint">zaal</unclear> der <unclear cert="medium" resp="#joint">abgeschükten</unclear> <unclear cert="medium" resp="#joint">soldaten</unclear> <unclear cert="medium" resp="#joint">gwesen</unclear>,
