<lb n="29"/><unclear cert="low" resp="#joint">wahrhafften</unclear> <unclear cert="low" resp="#joint">beschaffenheit</unclear> <unclear cert="low" resp="#joint">mehrberuerten</unclear> <unclear cert="low" resp="#joint">tyrannischen</unclear> <unclear cert="low" resp="#joint">cainischen</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">handels</unclear> <unclear cert="low" resp="#joint">zebrichten</unclear>, Mit <unclear cert="medium" resp="#joint">fründtlicher</unclear> pitt, <unclear cert="medium" resp="#joint">sölchem</unclear> <unclear cert="medium" resp="#joint">vollkommnen</unclear>
<lb n="31"/>glauben <unclear cert="low" resp="#joint">zuezesetzen</unclear> unnd allen <unclear cert="medium" resp="#joint">widerwärtigen</unclear> informationen
<lb n="32"/><unclear cert="low" resp="#joint">vorzezüchen</unclear>, Unnd so wir ouch <unclear cert="medium" resp="#joint">zur</unclear> <unclear cert="medium" resp="#joint">extreemitet</unclear>, <unclear cert="medium" resp="#joint">wie</unclear> wol-
<lb n="33"/><unclear cert="medium" resp="#joint">befuegter</unclear> <unclear cert="medium" resp="#joint">rach</unclear> <unclear cert="medium" resp="#joint">schryten</unclear> <unclear cert="medium" resp="#joint">muestend</unclear>, uns <unclear cert="medium" resp="#joint">dannzemalen</unclear> als den
<pb facs="StadtASG_Missive_2935_11538.jpg" n="2"/>
<lb n="34"/>hoechst verletzten, unnd belaeidigten, trost: unnd hilflich, krafft <unclear cert="low" resp="#joint">Puendten</unclear>,
<lb n="35"/><unclear cert="low" resp="#joint">beyzuospringen</unclear>, <unclear cert="low" resp="#joint">Inmaßen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">keines</unclear> widrigen versehen, unnd
<lb n="36"/>Gott den allmaechtigen bettend, er unser geliebt <unclear cert="low" resp="#joint">vatterland</unclear> mit
<lb n="37"/>gnaedigen augen ansehen, die unruewigen bluotgirigen gmueter demen,
<lb n="38"/>unnd ob <unclear cert="low" resp="#joint">euech</unclear> <unclear cert="low" resp="#joint">fuerter</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">Gnaden</unclear> <unclear cert="low" resp="#joint">zewalten</unclear> <unclear cert="low" resp="#joint">geruohen</unclear> <unclear cert="low" resp="#joint">welle</unclear>. <unclear cert="low" resp="#joint">Datt</unclear>
<lb n="39"/><origDate when="1632" resp="#ner"><unclear cert="low" resp="#joint">28.a</unclear> <unclear cert="low" resp="#joint">Septemb</unclear>: 1632</origDate>.
<lb n="40"/><orgName ref="stadtasg-actors-514" cert="medium" role="issuer" resp="#ner">Schultheiß, unnd Raht der Statt
<lb n="41"/>Bern</orgName>.
<pb facs="StadtASG_Missive_2935_11539.jpg" n="3"/>
<lb n="42"/><unclear cert="low" resp="#joint">Substantzlicher</unclear> <unclear cert="low" resp="#joint">bericht</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">der</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Cluß</unclear></placeName>
<lb n="43"/><unclear cert="low" resp="#joint">vergangnen</unclear> <unclear cert="low" resp="#joint">mordhandlung</unclear>.
<lb n="44"/><unclear cert="low" resp="#joint">Als</unclear> ein statt <placeName ref="stadtasg-places-13" cert="medium" resp="#ner">Bern</placeName> mit und neben andern mit der statt <placeName ref="stadtasg-places-411" cert="medium" resp="#ner">Muell-
<lb n="45"/>husen</placeName> verbuendeten, sich eines zusatzes dahin von gegenwuertigen ge-
<lb n="46"/>farlichen laeuffen wegen, verglichen, unnd ihre zaal uber uff die
<lb n="47"/>straaß geschickt. Sind dieselben neben irem fuehrer dem lutenambt
<lb n="48"/>von <placeName ref="stadtasg-places-68" cert="medium" resp="#ner">Stein</placeName>, in der Cluß Solothurner gebiets, alda starcke schiltwachten
<lb n="49"/>allbereit angestellt <unclear cert="low" resp="#joint">gewesen</unclear> (.<unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">sij</unclear> umb den <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">zug</unclear> <unclear cert="low" resp="#joint">fruendt</unclear>-
<lb n="50"/>lich angehalten.) zu ruck gewisen, derwegen uff disers bericht
<lb n="51"/>ein statt Bern iren eijdgnoßen zuo <placeName ref="stadtasg-places-49" cert="medium" resp="#ner">Solothurn</placeName>, disen uffhalt re-
<lb n="52"/>presentiert, unnd umb oeffnung deß passes und freijen ungehinderten
<lb n="53"/>zug der irigen schrifftlich gebaetten, so aber dergstalten ußgschlagen,
<lb n="54"/>das nach <unclear cert="low" resp="#joint">deme</unclear> <unclear cert="low" resp="#joint">ermelter</unclear> <unclear cert="low" resp="#joint">fuehrer</unclear> <unclear cert="low" resp="#joint">zeverstehn</unclear> <unclear cert="low" resp="#joint">begaert</unclear>, <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">fuerruckhen</unclear>
