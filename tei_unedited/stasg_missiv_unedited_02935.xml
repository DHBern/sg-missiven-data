<lb n="76"/>der <unclear cert="medium" resp="#joint">lebens</unclear> gefahr <unclear cert="medium" resp="#joint">entrunnen</unclear>, unnd <unclear cert="medium" resp="#joint">wann</unclear> die <unclear cert="medium" resp="#joint">schütz</unclear> nit <unclear cert="low" resp="#joint">zefrue</unclear>
