    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1302_4457.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">früntlich</unclear> willig dienst, sampt
<lb n="2"/>was wir liebs <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">guots</unclear> <unclear cert="medium" resp="#joint">vermögen</unclear>
<lb n="3"/>zuvor, fromb, ersam, <unclear cert="medium" resp="#joint">wyß</unclear>, besonders
<lb n="4"/><unclear cert="medium" resp="#joint">guot</unclear> <unclear cert="medium" resp="#joint">fründt</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">getrüw</unclear> lieb
<lb n="5"/><orgName role="recipient" resp="#ner">Eydtgnossen</orgName>,
<lb n="6"/><unclear cert="medium" resp="#joint">Unß</unclear> hat unnser burger <persName resp="#ner">Martin
<lb n="7"/><unclear cert="medium" resp="#joint">Eininger</unclear></persName> <unclear cert="medium" resp="#joint">Inn</unclear> <unclear cert="medium" resp="#joint">unnderthänigkheit</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">clagendt</unclear> <unclear cert="medium" resp="#joint">zuerkennen</unclear> geben, welcher=
<lb n="9"/>massen er vor der <unclear cert="medium" resp="#joint">zyt</unclear> <unclear cert="medium" resp="#joint">üweren</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">burgern</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Lütolffen</unclear> <unclear cert="medium" resp="#joint">Zollikofern</unclear></placeName>,
<lb n="11"/>ein pferdt, umb <unclear cert="medium" resp="#joint">sybenzig</unclear> drey
<lb n="12"/>sonnen <unclear cert="medium" resp="#joint">kronnen</unclear> <unclear cert="medium" resp="#joint">zuekhauffen</unclear> geben,
<lb n="13"/>welche er Ime <unclear cert="medium" resp="#joint">gethonen</unclear> <unclear cert="medium" resp="#joint">seinem</unclear> ver=
<lb n="14"/><unclear cert="medium" resp="#joint">sprechen</unclear> nach, <unclear cert="medium" resp="#joint">langest</unclear> erlegen <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">bezallen</unclear> <unclear cert="medium" resp="#joint">söllen</unclear>, <unclear cert="medium" resp="#joint">diewyl</unclear> er aber
<lb n="16"/>(ungeachtet seines bißanhero gepfloge-
<lb n="17"/>nen <unclear cert="low" resp="#joint">stillstandts</unclear>) <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">einicher</unclear> <unclear cert="low" resp="#joint">würkhlicher</unclear>
<lb n="18"/>bezallung gelangen <unclear cert="medium" resp="#joint">mögen</unclear>, <unclear cert="medium" resp="#joint">were</unclear> sein
<lb n="19"/><unclear cert="medium" resp="#joint">unnderthäniges</unclear> bitten, wir <unclear cert="medium" resp="#joint">wölten</unclear>
<lb n="20"/>Ime mit unnser Intercession bey
<lb n="21"/><unclear cert="medium" resp="#joint">üch</unclear>, <unclear cert="medium" resp="#joint">deren</unclear> er <unclear cert="medium" resp="#joint">würckhlich</unclear> zuege-
<lb n="22"/><unclear cert="medium" resp="#joint">niessen</unclear> habe, <unclear cert="medium" resp="#joint">gültsam</unclear> <unclear cert="medium" resp="#joint">erscheinen</unclear>,
<lb n="23"/>welch sein zimlich begeren, wir Ime
<lb n="24"/>nicht <unclear cert="medium" resp="#joint">zueweygeren</unclear> <unclear cert="medium" resp="#joint">gewüst</unclear>,
<lb n="25"/>Wann nun billich ein Jede oberkheit
<lb n="26"/>der andern, Inn solchen <unclear cert="medium" resp="#joint">unnd</unclear> mehrern
<lb n="27"/><unclear cert="low" resp="#joint">fählen</unclear>, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gebür</unclear> nach, beholffen sein
<lb n="28"/>soll, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">unnß</unclear> gleichwol <unclear cert="medium" resp="#joint">nit</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">zwyffelt</unclear>, Ir von <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">einen</unclear> Jeden,
<lb n="30"/><unclear cert="medium" resp="#joint">wa</unclear> <unclear cert="medium" resp="#joint">zue</unclear> er <unclear cert="medium" resp="#joint">befuogt</unclear>, <unclear cert="medium" resp="#joint">oberkheitliche</unclear> <unclear cert="medium" resp="#joint">handt</unclear>-
<pb facs="StadtASG_Missive_1302_4458.jpg" n="2"/>
<lb n="31"/><unclear cert="low" resp="#joint">raichung</unclear> <unclear cert="low" resp="#joint">zuethuen</unclear> gesinnet, so ist doch
<lb n="32"/><unclear cert="low" resp="#joint">uff</unclear> deß unsern <unclear cert="low" resp="#joint">trungenlichs</unclear> <unclear cert="low" resp="#joint">anrueffen</unclear>,
<lb n="33"/>unser <unclear cert="low" resp="#joint">freundtlich</unclear> <unclear cert="low" resp="#joint">gesinnen</unclear> <unclear cert="low" resp="#joint">undt</unclear> er-
<lb n="34"/>suochen, Ir wöllen mit <unclear cert="low" resp="#joint">obrigkeitlichem</unclear>
<lb n="35"/>ernst <unclear cert="low" resp="#joint">ernstbesagten</unclear> <unclear cert="low" resp="#joint">euwern</unclear> <unclear cert="low" resp="#joint">burgeren</unclear>
<lb n="36"/>dahin <unclear cert="low" resp="#joint">hallten</unclear> unndt vermögen, damit
<lb n="37"/>er <unclear cert="low" resp="#joint">eemelten</unclear> seinen Creditorn, umb
<lb n="38"/>seinen <unclear cert="low" resp="#joint">unvargoltnen</unclear> <unclear cert="low" resp="#joint">ußsteenden</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">khauffschilling</unclear>, fürderlich unndt ohne
<lb n="40"/>ferneren <unclear cert="low" resp="#joint">umbtrib</unclear>, <unclear cert="low" resp="#joint">gentzlich</unclear> bezallen,
<lb n="41"/><unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">unklagbar</unclear> machen thuege, unndt
<lb n="42"/><unclear cert="low" resp="#joint">eüch</unclear> sonsten gegen dem unsern inn
<lb n="43"/>alle nottwendige weg so <unclear cert="low" resp="#joint">wilfärig</unclear>
<lb n="44"/>erzeigen, alls unser <unclear cert="medium" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">guett</unclear>
<lb n="45"/>vertrauwen zue eüch steth, unndt Ir
<lb n="46"/><unclear cert="low" resp="#joint">hinnwider</unclear> den <unclear cert="low" resp="#joint">euwern</unclear> gern <unclear cert="low" resp="#joint">gethon</unclear> unndt
<lb n="47"/>sehen wolten, daran beschicht die
<lb n="48"/><unclear cert="low" resp="#joint">gebür</unclear>, unndt <unclear cert="low" resp="#joint">seyendt</unclear> <unclear cert="medium" resp="#joint">eß</unclear> umb <unclear cert="low" resp="#joint">eüch</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">unsre</unclear> getrüwen lieben <orgName resp="#ner"><unclear cert="low" resp="#joint">Eydtgnossen</unclear></orgName>,
<lb n="50"/>anderen <unclear cert="low" resp="#joint">begebenden</unclear> <unclear cert="low" resp="#joint">fählen</unclear>, <unclear cert="low" resp="#joint">freundt</unclear>:
<lb n="51"/><unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">guetwilliglich</unclear> <unclear cert="low" resp="#joint">zuerwideren</unclear>,
<lb n="52"/>erbiettig, datum den <origDate when="1593-12-29" resp="#ner"><unclear cert="low" resp="#joint">29</unclear>. Decembris
<lb n="53"/>anno 1593</origDate>.
<lb n="54"/><persName role="issuer" resp="#ner">Niclaus Schultheis</persName> <orgName ref="stadtasg-actors-530" cert="medium" role="issuer" resp="#ner">burger-
<lb n="55"/>meister unndt der rath
<lb n="56"/>der statt Basell</orgName>.
<pb facs="StadtASG_Missive_1302_4459.jpg" n="3"/>
<pb facs="StadtASG_Missive_1302_4460.jpg" n="4"/>
<lb n="57"/>Den <unclear cert="medium" resp="#joint">fromen</unclear>, ersamen, <unclear cert="low" resp="#joint">wysen</unclear>,
<lb n="58"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> unnd <unclear cert="medium" resp="#joint">Rhatt</unclear>
<lb n="59"/>der statt St. Gallen</orgName> un-
<lb n="60"/><unclear cert="low" resp="#joint">seren</unclear> <unclear cert="low" resp="#joint">innsonnders</unclear> <unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">fründt</unclear>
<lb n="61"/>unnd getrüwen lieb Eydtgnossen.
</p>
