<lb n="33"/><unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">sichere</unclear> und gantz <unclear cert="medium" resp="#joint">gewiße</unclear> <unclear cert="medium" resp="#joint">warnung</unclear>, <unclear cert="medium" resp="#joint">wog</unclear> ich <unclear cert="medium" resp="#joint">mehr</unclear>
