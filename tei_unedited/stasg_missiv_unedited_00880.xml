    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_880_2497.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freündtlich</unclear> willig diennst <unclear cert="medium" resp="#joint">zuovor</unclear>. Er-
<lb n="2"/>samen unnd weisen, lieben unnd <unclear cert="low" resp="#joint">guoten</unclear> <unclear cert="low" resp="#joint">freünd</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. schreiben, unnd <unclear cert="medium" resp="#joint">begern</unclear>, betreffendt
<lb n="4"/>iren <unclear cert="medium" resp="#joint">gefanngnen</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Christan</unclear> <unclear cert="medium" resp="#joint">Muellern</unclear></persName> von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Dizingen</unclear></placeName>,
<lb n="5"/>haben wir allenthalben, in unnser herrschafft
<lb n="6"/><placeName ref="stadtasg-places-77" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Neuravenspurg</unclear></placeName>, darinnen <placeName ref="stadtasg-places-36" cert="medium" resp="#ner">Roggenzell</placeName> ge-
<lb n="7"/>legen, durch <unclear cert="low" resp="#joint">unnsern</unclear> vogt, unnd <unclear cert="medium" resp="#joint">amptleüte</unclear>,
<lb n="8"/>daselbst fleissige, unnd <unclear cert="low" resp="#joint">notwenndige</unclear> <unclear cert="low" resp="#joint">erkhundig</unclear>-
<lb n="9"/>ung gethon, aber gar nit befinden <unclear cert="low" resp="#joint">kinden</unclear>, das
<lb n="10"/>sich <unclear cert="medium" resp="#joint">dhain</unclear> <unclear cert="medium" resp="#joint">sellche</unclear> sach, unnd hanndlung, wie
<lb n="11"/><unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">gefanngner</unclear> anzaigt, der enden <unclear cert="medium" resp="#joint">nie</unclear> <unclear cert="medium" resp="#joint">zuoge</unclear>-
<lb n="12"/>tragen. <unclear cert="medium" resp="#joint">Wissen</unclear> auch in <unclear cert="low" resp="#joint">gannzer</unclear> herrschafft
<lb n="13"/><unclear cert="medium" resp="#joint">dhain</unclear> <unclear cert="medium" resp="#joint">solliche</unclear> <unclear cert="medium" resp="#joint">behausung</unclear> noch person, so dergleichen
<lb n="14"/><unclear cert="low" resp="#joint">Schuochgirt</unclear> machen solle. <unclear cert="low" resp="#joint">Gleichwol</unclear> ist nit weit
<lb n="15"/>von der herrschafft <unclear cert="low" resp="#joint">Neuravenspurg</unclear>, in des
<lb n="16"/>edlen unnd vesten, <persName resp="#ner">Hannsen <unclear cert="medium" resp="#joint">vom</unclear> <unclear cert="medium" resp="#joint">Stainachstains</unclear></persName>
<lb n="17"/>zuo <placeName ref="stadtasg-places-8" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Amptzell</unclear></placeName>, herrschafft, ain schlecht <unclear cert="low" resp="#joint">heüslin</unclear>, in
<lb n="18"/>ainem wald, <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">unnsere</unclear> amptleüt, wissen
<lb n="19"/>nit, durch <unclear cert="low" resp="#joint">wän</unclear> es <unclear cert="low" resp="#joint">bewont</unclear>, unnd <unclear cert="medium" resp="#joint">besässen</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">würdet</unclear>. Unnd dieweil sich die <unclear cert="low" resp="#joint">namen</unclear> Roggen-
<lb n="21"/>zell, unnd <unclear cert="low" resp="#joint">Amptzell</unclear>, vast <unclear cert="medium" resp="#joint">mitainandern</unclear> ver-
<lb n="22"/>gleichen, <unclear cert="low" resp="#joint">möchte</unclear> sich <unclear cert="medium" resp="#joint">vileicht</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">gefanng</unclear>-
<lb n="23"/>ner an <unclear cert="medium" resp="#joint">sollichen</unclear> wenig <unclear cert="medium" resp="#joint">unnderschidlichen</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">namen</unclear> <unclear cert="medium" resp="#joint">geirrt</unclear>, unnd <unclear cert="medium" resp="#joint">Amptzell</unclear> gemaint haben,
<lb n="25"/>das wir <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. unnsern lieben unnd <unclear cert="medium" resp="#joint">guoten</unclear> <unclear cert="low" resp="#joint">freünd</unclear>
<lb n="26"/>auff ir <unclear cert="medium" resp="#joint">begern</unclear>, <unclear cert="low" resp="#joint">für</unclear> bericht anzaigen wellen, und
<lb n="27"/>derselben in <unclear cert="low" resp="#joint">mererm</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear>, unnd nach-
<lb n="28"/>pürlich lieb und dienst zuoerzaigen, sind wir
<lb n="29"/>mit willen genaigt. Datum <origDate when="1566" cert="medium" resp="#ner">den 10
<lb n="30"/>apprilis, anno etc. 66</origDate>.
<lb n="31"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermaister</unclear> und <unclear cert="medium" resp="#joint">rathe</unclear>
<lb n="32"/>der statt <unclear cert="low" resp="#joint">Lindow</unclear></orgName>,
<pb facs="StadtASG_Missive_880_2498.jpg" n="2"/>
<pb facs="StadtASG_Missive_880_2499.jpg" n="3"/>
<pb facs="StadtASG_Missive_880_2500.jpg" n="4"/>
<lb n="33"/>Den ersamen und weisen. <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="34"/>und rate der statt Sannt Gallen</orgName>. <unclear cert="medium" resp="#joint">Unßern</unclear>
<lb n="35"/>lieben unnd guoten <unclear cert="low" resp="#joint">frunden</unclear>
</p>
