<lb n="3"/><unclear cert="medium" resp="#joint">sonders</unclear> guot <unclear cert="medium" resp="#joint">freünd</unclear>, und <unclear cert="low" resp="#joint">gethreüw</unclear> <unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">Eydtgnoßen</unclear>.
