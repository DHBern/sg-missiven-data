<lb n="8"/><unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">byliggender</unclear> abschrifft <unclear cert="low" resp="#joint">zuovernemmen</unclear>; die <unclear cert="medium" resp="#joint">wyl</unclear> er nun lybs
<lb n="9"/>halber sich <unclear cert="medium" resp="#joint">beschwerd</unclear> befunden, <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. und <unclear cert="medium" resp="#joint">beyden</unclear>
