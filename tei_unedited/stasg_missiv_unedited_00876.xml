<lb n="41"/>vleiß. nachparlichen <unclear cert="medium" resp="#joint">zebeschulden</unclear>. und <unclear cert="medium" resp="#joint">zuverdienen</unclear>,
<lb n="42"/>Datum den. <origDate when="1555-11-21" cert="medium" resp="#ner">21. Novembris anno etc 55</origDate>
<lb n="43"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> unnd
<lb n="44"/>Rath der Statt <unclear cert="low" resp="#joint">Lindaw</unclear></orgName>,
<pb facs="StadtASG_Missive_876_2483.jpg" n="3"/>
<pb facs="StadtASG_Missive_876_2484.jpg" n="4"/>
<lb n="45"/>Den ersamen unnd weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister
