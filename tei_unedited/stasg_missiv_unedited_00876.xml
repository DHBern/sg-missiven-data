<p>
<pb facs="StadtASG_Missive_876_2481.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freundtlich</unclear> willig diennst <unclear cert="medium" resp="#joint">zuovor</unclear>. Ersamen.
<lb n="2"/>unnd weisen lieben. unnd guoten <unclear cert="low" resp="#joint">freund</unclear>, unnser
<lb n="3"/>burger <persName resp="#ner">Hanns <unclear cert="low" resp="#joint">Hartman</unclear></persName>. <unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">vogt</unclear> weilund
<lb n="4"/><unclear cert="medium" resp="#joint">unnsers</unclear> burgers Ludwigen Ritters <unclear cert="medium" resp="#joint">säligen</unclear>. ver=
<lb n="5"/><unclear cert="low" resp="#joint">laßner</unclear> kindern. berichtet unns. wie seinen vogt
<lb n="6"/>kindern. In E. E. <unclear cert="low" resp="#joint">wst</unclear>. Statt. von <unclear cert="medium" resp="#joint">Irem</unclear> <unclear cert="medium" resp="#joint">äni</unclear>. ain erb=
<lb n="7"/>fal <unclear cert="medium" resp="#joint">zuogestannden</unclear>. <unclear cert="medium" resp="#joint">Dovan</unclear> E. E. <unclear cert="low" resp="#joint">wst</unclear>. burger
<lb n="8"/><persName resp="#ner">Hainrich Ritter</persName>. ain summa gelts <unclear cert="low" resp="#joint">eingenomen</unclear>,
<lb n="9"/>der <unclear cert="medium" resp="#joint">maÿnung</unclear> dieselbig umb <unclear cert="medium" resp="#joint">gebürrende</unclear> verzinß=
<lb n="10"/>ung. <unclear cert="medium" resp="#joint">beÿ</unclear> hannden <unclear cert="medium" resp="#joint">zuobehalten</unclear>. <unclear cert="medium" resp="#joint">deß</unclear> er <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">burg</unclear>.
<lb n="11"/><unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">vogt</unclear>. <unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="low" resp="#joint">gleichwol</unclear> bewilligt. doch <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gestalt</unclear>.
<lb n="12"/>das er <unclear cert="medium" resp="#joint">des</unclear> <unclear cert="medium" resp="#joint">gnoegsamlich</unclear> umb zinß. unnd <unclear cert="low" resp="#joint">hauptguot</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">versichere</unclear>. darmit wann der kinder <unclear cert="low" resp="#joint">ains</unclear>.
<lb n="14"/>oder mer. <unclear cert="medium" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">begerten</unclear>. das er das <unclear cert="low" resp="#joint">haubt</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">guot</unclear> widerumben <unclear cert="low" resp="#joint">zuohannden</unclear> bringen <unclear cert="medium" resp="#joint">muge</unclear>,
<lb n="16"/>so hab <unclear cert="medium" resp="#joint">Ime</unclear> aber. Hainrich Ritter. <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">sölliche</unclear> <unclear cert="low" resp="#joint">verschrib=</unclear>
<lb n="17"/>ung <unclear cert="low" resp="#joint">zuogeschickt</unclear>. darmit die kinder gar nit ver=
