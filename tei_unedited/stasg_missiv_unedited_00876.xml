<lb n="30"/>müge. Derohalben. unnd darmit dann
<lb n="31"/><unclear cert="low" resp="#joint">bemelter</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Hartman</unclear></persName>. <unclear cert="low" resp="#joint">sollchen</unclear> seiner <unclear cert="low" resp="#joint">vogtknidner</unclear>
