<lb n="11"/>22. <unclear cert="low" resp="#joint">kreützer</unclear> <unclear cert="low" resp="#joint">aestimiert</unclear>, <unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">schwall</unclear>
<lb n="12"/>nicht ins landt gebracht werde,
<lb n="13"/>unnd <unclear cert="low" resp="#joint">dieweil</unclear> so <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">fl</unclear>. <unclear cert="low" resp="#joint">g</unclear>.
