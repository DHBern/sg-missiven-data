<lb n="18"/><unclear cert="low" resp="#joint">habend</unclear> <unclear cert="low" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">w</unclear>. <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">fürer</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">buerger</unclear>-
