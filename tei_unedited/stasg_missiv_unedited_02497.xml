<lb n="53"/><unclear cert="low" resp="#joint">anderst</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">bewandt</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">dan</unclear> wie <unclear cert="low" resp="#joint">erholt</unclear>. <unclear cert="low" resp="#joint">Ebenmeßig</unclear> mit den pfenning
