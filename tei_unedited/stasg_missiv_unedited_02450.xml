<lb n="3"/><unclear cert="low" resp="#joint">Fuersichtig</unclear>, <unclear cert="medium" resp="#joint">Ehrsamm</unclear> unnd <unclear cert="low" resp="#joint">wiß</unclear>, Inßonders <unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">frundt</unclear> unnd
