<lb n="14"/><unclear cert="medium" resp="#joint">benannte</unclear> <unclear cert="medium" resp="#joint">stuckh</unclear> <unclear cert="medium" resp="#joint">tuech</unclear>, von dem supplicanten
<lb n="15"/>empfangen, sich <unclear cert="medium" resp="#joint">allso</unclear> damit inn <unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="medium" resp="#joint">schuldt</unclear>
<lb n="16"/>(alls an eim <unclear cert="medium" resp="#joint">freÿen</unclear> <unclear cert="medium" resp="#joint">ofnen</unclear> <unclear cert="medium" resp="#joint">jafrmarckht</unclear> gemacht)
<lb n="17"/>gegeben, <unclear cert="low" resp="#joint">demnach</unclear> <unclear cert="medium" resp="#joint">sich</unclear> solchs nit angenomen,
<lb n="18"/>sonder diser sachen sich entschlagen haben <unclear cert="low" resp="#joint">solte</unclear>,
<lb n="19"/>und ime <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">unserigen</unclear> <unclear cert="medium" resp="#joint">ueber</unclear> <unclear cert="medium" resp="#joint">das</unclear>, <unclear cert="medium" resp="#joint">schon</unclear> ein
