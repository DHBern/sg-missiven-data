<lb n="21"/>die begerte <unclear cert="medium" resp="#joint">fuerschrift</unclear> nit verwaigern
<lb n="22"/>noch abschlagen <unclear cert="medium" resp="#joint">moegen</unclear>.
<lb n="23"/>Und gelangt demnach an E. E. W. <unclear cert="low" resp="#joint">unnser</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">freundtlich</unclear> nachbarlich bitt, <unclear cert="medium" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">wolte</unclear>
