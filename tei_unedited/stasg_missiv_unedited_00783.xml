<lb n="31"/><unclear cert="medium" resp="#joint">uich</unclear> <unclear cert="medium" resp="#joint">unnser</unclear> gantz <unclear cert="medium" resp="#joint">fruntlichs</unclear> <unclear cert="medium" resp="#joint">bitten</unclear>, unnd <unclear cert="medium" resp="#joint">ansynnen</unclear>
<lb n="32"/>ir wellend von <unclear cert="low" resp="#joint">oberkeit</unclear> wegen <unclear cert="low" resp="#joint">solch</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">ofgedachten</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">anligen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">unnserschriben</unclear>, <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">frunden</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="34"/><unclear cert="low" resp="#joint">wanten</unclear> <unclear cert="low" resp="#joint">furbringen</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">anzaigen</unclear> <unclear cert="low" resp="#joint">volgends</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">inen</unclear>, <unclear cert="low" resp="#joint">geg</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">genantem</unclear> <unclear cert="low" resp="#joint">maister</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Georgen</unclear></persName> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">hintergang</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">burg</unclear>-
<lb n="36"/><unclear cert="low" resp="#joint">schaft</unclear> <unclear cert="low" resp="#joint">werben</unclear>. Unnd dieselbig <unclear cert="medium" resp="#joint">burgschaft</unclear> <unclear cert="medium" resp="#joint">verschreib</unclear>-
<lb n="37"/><unclear cert="medium" resp="#joint">ung</unclear>, <unclear cert="medium" resp="#joint">soverr</unclear> ir <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">vermogen</unclear> <unclear cert="low" resp="#joint">sy</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Magdalena</unclear> <unclear cert="low" resp="#joint">Rotsch</unclear></persName>
<lb n="38"/><unclear cert="low" resp="#joint">bei</unclear> <unclear cert="low" resp="#joint">uich</unclear> <unclear cert="low" resp="#joint">seige</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> ir <unclear cert="low" resp="#joint">geschefften</unclear> <unclear cert="low" resp="#joint">bei</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">am</unclear> <unclear cert="low" resp="#joint">besten</unclear>
<lb n="39"/>allain <unclear cert="medium" resp="#joint">darumben</unclear> <unclear cert="medium" resp="#joint">gesandten</unclear> botten zukomen lassen,
<lb n="40"/>damit wir maister <persName resp="#ner"><unclear cert="low" resp="#joint">Georgen</unclear></persName> <unclear cert="low" resp="#joint">seins</unclear> <unclear cert="low" resp="#joint">artzet</unclear> <unclear cert="low" resp="#joint">lons</unclear>, und
