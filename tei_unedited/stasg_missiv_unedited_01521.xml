        <body>
<p>
<pb facs="StadtASG_Missive_1521_5483.jpg" n="1"/>
<lb n="1"/>Von <unclear cert="medium" resp="#joint">gottes</unclear> <unclear cert="medium" resp="#joint">gnaden</unclear> <persName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Wilhelm</unclear></persName> <unclear cert="medium" resp="#joint">hertzogk</unclear>
<lb n="2"/>zu <placeName ref="stadtasg-places-415" cert="medium" resp="#ner">Braunschweig</placeName> <unclear cert="medium" resp="#joint">unndt</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Lueneburgk</unclear></placeName> etc.
<lb n="3"/><unclear cert="medium" resp="#joint">Unsern</unclear> gnedigen <unclear cert="low" resp="#joint">gruß</unclear> <unclear cert="low" resp="#joint">gonstigen</unclear> <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">geneigten</unclear> <unclear cert="low" resp="#joint">willen</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">ersame</unclear> weise, <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">besondere</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Es</unclear> <unclear cert="low" resp="#joint">hatt</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">rahtt</unclear> <unclear cert="low" resp="#joint">unndt</unclear> lieber <unclear cert="low" resp="#joint">getreuwer</unclear>,
<lb n="6"/>doctor <persName resp="#ner"><unclear cert="low" resp="#joint">Rütger</unclear> <unclear cert="low" resp="#joint">Rulantt</unclear></persName> <unclear cert="low" resp="#joint">underthenigk</unclear> <unclear cert="low" resp="#joint">zuuberstehen</unclear>
<lb n="7"/>geben, was <unclear cert="medium" resp="#joint">gestaldt</unclear> ihr <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">diesem</unclear> in den <unclear cert="low" resp="#joint">bude</unclear>-
<lb n="8"/>rischen ihm <unclear cert="medium" resp="#joint">anbevolenen</unclear> <unclear cert="medium" resp="#joint">sachen</unclear>, <unclear cert="medium" resp="#joint">schleunigs</unclear> recht <unclear cert="low" resp="#joint">het</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">tett</unclear> <unclear cert="low" resp="#joint">wiederfahren</unclear> lassen, <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">wehre</unclear> <unclear cert="low" resp="#joint">dan</unclear> die
<lb n="10"/>sache <unclear cert="low" resp="#joint">sowheitt</unclear> bracht <unclear cert="low" resp="#joint">wurdten</unclear>, daß ihr den <unclear cert="low" resp="#joint">einen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">theill</unclear> der debitorn <unclear cert="medium" resp="#joint">gewisse</unclear> <unclear cert="medium" resp="#joint">frist</unclear> zur bezahlung
<lb n="12"/><unclear cert="medium" resp="#joint">praefigiret</unclear> <unclear cert="medium" resp="#joint">unndt</unclear> angesetzet <unclear cert="low" resp="#joint">hettett</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">nuhe</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">abgeferttigter</unclear> <unclear cert="low" resp="#joint">anwaldt</unclear> der bezahlung <unclear cert="low" resp="#joint">gewerttigk</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">wol</unclear>-
<lb n="14"/>len, <unclear cert="medium" resp="#joint">hetten</unclear> sie allerley exceptiones, welche doch
<lb n="15"/><unclear cert="low" resp="#joint">zuvor</unclear> <unclear cert="low" resp="#joint">albereitt</unclear> von euch <unclear cert="low" resp="#joint">verworffen</unclear>, unndt
<lb n="16"/><unclear cert="low" resp="#joint">dehren</unclear> sie sich in dem vertrags <unclear cert="medium" resp="#joint">selbsten</unclear> begeben,
<lb n="17"/><unclear cert="low" resp="#joint">einzuwenden</unclear> unndt also einen <unclear cert="low" resp="#joint">arrest</unclear> auff die
<lb n="18"/>schuldige summen <unclear cert="low" resp="#joint">zubegrehen</unclear>, nicht <unclear cert="low" resp="#joint">gescheuet</unclear>,
<lb n="19"/><unclear cert="low" resp="#joint">Weill</unclear> ihr dan <unclear cert="low" resp="#joint">darauff</unclear> einen <unclear cert="low" resp="#joint">bescheidt</unclear> <unclear cert="low" resp="#joint">eroeffnet</unclear>
<lb n="20"/>unndt abermals einen <unclear cert="low" resp="#joint">newen</unclear> <unclear cert="low" resp="#joint">termin</unclear>, in welchem
<lb n="21"/>das geldt bey euch hinderlegt werden soll, an-
<lb n="22"/>gesetzet, unndt aber ehr sich befürchtet <unclear cert="medium" resp="#joint">thuett</unclear>,
<lb n="23"/><unclear cert="medium" resp="#joint">es</unclear> möchte wegen anlegung <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">arrests</unclear> aller-
<lb n="24"/><unclear cert="medium" resp="#joint">lej</unclear> <unclear cert="medium" resp="#joint">weittleufftigkeitt</unclear> <unclear cert="medium" resp="#joint">causiret</unclear> <unclear cert="medium" resp="#joint">unndt</unclear> dardurch
<lb n="25"/><unclear cert="medium" resp="#joint">vieleicht</unclear> <unclear cert="medium" resp="#joint">verursachett</unclear> werden, das <unclear cert="low" resp="#joint">ehr</unclear> <unclear cert="low" resp="#joint">wied</unclear>.
<lb n="26"/>in der <unclear cert="low" resp="#joint">persohn</unclear> hinauff kommen müste, <unclear cert="medium" resp="#joint">welchs</unclear>
<lb n="27"/>uns, <unclear cert="low" resp="#joint">dieweill</unclear> wir seiner <unclear cert="low" resp="#joint">persohn</unclear> nicht so <unclear cert="low" resp="#joint">lange</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">entrathen</unclear> <unclear cert="low" resp="#joint">konnen</unclear>, <unclear cert="low" resp="#joint">zum</unclear> <unclear cert="low" resp="#joint">höchsten</unclear> beschwerlich
<pb facs="StadtASG_Missive_1521_5484.jpg" n="2"/>
<lb n="29"/><unclear cert="medium" resp="#joint">fallen</unclear> <unclear cert="low" resp="#joint">wolt</unclear>, So haben wir nicht umbgehen <unclear cert="low" resp="#joint">koennen</unclear>
<lb n="30"/>solchs an euch gelangen zu <unclear cert="medium" resp="#joint">laßen</unclear>, <unclear cert="medium" resp="#joint">undt</unclear> in gnaden
<lb n="31"/>vor <unclear cert="low" resp="#joint">ihn</unclear> zu <unclear cert="medium" resp="#joint">intercediren</unclear>, das Ihr die sachen
<lb n="32"/>wie biß dahero, also auch <unclear cert="low" resp="#joint">noch</unclear> dahin richten
<lb n="33"/><unclear cert="low" resp="#joint">wolten</unclear>, damitt <unclear cert="medium" resp="#joint">weittleufftigkeitt</unclear> <unclear cert="medium" resp="#joint">verhuetett</unclear>
<lb n="34"/><unclear cert="medium" resp="#joint">undt</unclear> <unclear cert="medium" resp="#joint">unsre</unclear> <unclear cert="medium" resp="#joint">abscheie</unclear> <unclear cert="medium" resp="#joint">undt</unclear> <unclear cert="medium" resp="#joint">darauf</unclear> von euch
<lb n="35"/>confirmirte <unclear cert="low" resp="#joint">vertraege</unclear>, bej <unclear cert="low" resp="#joint">wierden</unclear> erhalten, <unclear cert="low" resp="#joint">undt</unclear>
<lb n="36"/>mitt der execution verfahren werden moege,
<lb n="37"/><unclear cert="low" resp="#joint">Dasselbe</unclear> seindt wir gegen euch undt die <unclear cert="medium" resp="#joint">eueren</unclear>
<lb n="38"/><unclear cert="medium" resp="#joint">auf</unclear> zutragende <unclear cert="medium" resp="#joint">faelle</unclear>, in gnaden <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">erkennen</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">geneigtt</unclear>, <unclear cert="low" resp="#joint">Dat</unclear>. <unclear cert="low" resp="#joint">uf</unclear> unserm <unclear cert="medium" resp="#joint">hauß</unclear> <origPlace resp="#ner"><unclear cert="medium" resp="#joint">Harburgk</unclear></origPlace>
<lb n="40"/><origDate when="1606" resp="#ner">den 30. <unclear cert="medium" resp="#joint">8bris</unclear> Anno 1606</origDate>
<lb n="41"/><persName role="issuer" resp="#ner">Willhelm <unclear cert="medium" resp="#joint">hertzogk</unclear></persName>
<lb n="42"/>zu B. unnd L. <unclear cert="medium" resp="#joint">mpp</unclear>.
<pb facs="StadtASG_Missive_1521_5485.jpg" n="3"/>
<pb facs="StadtASG_Missive_1521_5486.jpg" n="4"/>
<lb n="43"/>Den Edlen, <unclear cert="low" resp="#joint">Eerenvesten</unclear>, <unclear cert="low" resp="#joint">Fuersichtigen</unclear>, <unclear cert="low" resp="#joint">Eersamen</unclear> unnd
<lb n="44"/><unclear cert="low" resp="#joint">Weysen</unclear>, <unclear cert="low" resp="#joint">Unseren</unclear> Insonders guoten <unclear cert="low" resp="#joint">Frunden</unclear>, Burger-
<lb n="45"/><unclear cert="low" resp="#joint">meistern</unclear>, <unclear cert="low" resp="#joint">Schullheis</unclear>, <unclear cert="low" resp="#joint">Landtamann</unclear> Unnd <unclear cert="low" resp="#joint">Rhat</unclear> der Statt
