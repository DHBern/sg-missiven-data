<lb n="18"/><unclear cert="low" resp="#joint">bstendigen</unclear> <unclear cert="low" resp="#joint">stattfriden</unclear> (<unclear cert="low" resp="#joint">welchen</unclear> <unclear cert="low" resp="#joint">Goetliche</unclear> <unclear cert="low" resp="#joint">all</unclear>-
