<lb n="40"/>offenbaren und gerechten sach in belde geholffen werden
<lb n="41"/>solt, jedoch so vrei unß selbß nit <unclear cert="low" resp="#joint">hinden</unclear>, <unclear cert="low" resp="#joint">sonderen</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">hochstnotwendigen</unclear> <unclear cert="low" resp="#joint">werckhs</unclear> <unclear cert="low" resp="#joint">befürderung</unclear>,
