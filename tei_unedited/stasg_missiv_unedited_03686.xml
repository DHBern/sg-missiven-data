<lb n="47"/>solle. Alß haben wir solches <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">vertraue</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">lich</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">notificieren</unclear> nit <unclear cert="low" resp="#joint">underlaßßen</unclear> <unclear cert="low" resp="#joint">künden</unclear>, die
<lb n="49"/><unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">ungleichem</unclear> <unclear cert="low" resp="#joint">vermerckhen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">die</unclear>-
<lb n="50"/><unclear cert="low" resp="#joint">selbe</unclear> wir abermalen mit gegenwertigem ußgeben
<lb n="51"/>behelligen, und <unclear cert="low" resp="#joint">bej</unclear> <unclear cert="low" resp="#joint">widerumb</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">darlehen</unclear> <unclear cert="low" resp="#joint">f</unclear> <unclear cert="low" resp="#joint">1000</unclear> <unclear cert="low" resp="#joint">R</unclear>.
<lb n="52"/><unclear cert="low" resp="#joint">hochdienstlichen</unclear> <unclear cert="low" resp="#joint">fleißßes</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear> thuen.
<lb n="53"/>Und <unclear cert="low" resp="#joint">sintemahl</unclear> <unclear cert="low" resp="#joint">diße</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">wolgerathen</unclear> <unclear cert="low" resp="#joint">hochstnot</unclear>-
<lb n="54"/><unclear cert="low" resp="#joint">wendige</unclear> <unclear cert="low" resp="#joint">abordnung</unclear>, <unclear cert="low" resp="#joint">zuo</unclear> widerbringung friedlichen
