<p>
<pb facs="StadtASG_Missive_2118_7933.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig dienst, und was wir ehren,
<lb n="2"/><unclear cert="medium" resp="#joint">liebs</unclear> und guots <unclear cert="medium" resp="#joint">vermüegen</unclear>, zuovor, Edlen, Vesten,
<lb n="3"/><unclear cert="medium" resp="#joint">Fromen</unclear>, Fürsichtigen, Ersamen und Weisen,
<lb n="4"/><unclear cert="medium" resp="#joint">insonders</unclear> guoten <unclear cert="medium" resp="#joint">freünden</unclear> und <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben
<lb n="5"/><unclear cert="medium" resp="#joint">Eidtgnossen</unclear>.
<lb n="6"/>Nach dem <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">getreüwe</unclear> liebe <unclear cert="low" resp="#joint">mitburger</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">weiland</unclear> <unclear cert="low" resp="#joint">herren</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> Schlumpfen</persName> seligen
<lb n="8"/>erben, <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Vt</unclear>. und <unclear cert="medium" resp="#joint">Fr</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. <unclear cert="medium" resp="#joint">ansehenlicher</unclear>
<lb n="9"/>promotorialen <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">underschidenliche</unclear> ständ
<lb n="10"/>abermals bedürfftig sind, haben wir, auf
<lb n="11"/>ihr <unclear cert="medium" resp="#joint">gehorsamliches</unclear> <unclear cert="medium" resp="#joint">ersuochen</unclear>, unserm auch lieben
<lb n="12"/>und <unclear cert="medium" resp="#joint">getreüwen</unclear> stattschreiber <persName resp="#ner">Melchior <unclear cert="medium" resp="#joint">Guldin</unclear></persName>
<lb n="13"/><unclear cert="medium" resp="#joint">anbefolhen</unclear>, solches <unclear cert="medium" resp="#joint">geschäfft</unclear> vor <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Vt</unclear>. und
<lb n="14"/><unclear cert="medium" resp="#joint">Fr</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. anzubringen und <unclear cert="medium" resp="#joint">zuverrichten</unclear>.
<lb n="15"/>Und gelangt <unclear cert="medium" resp="#joint">darauf</unclear> an dieselben unser <unclear cert="medium" resp="#joint">gantz</unclear>
<lb n="16"/>freündtlich, und <unclear cert="medium" resp="#joint">eidtgnosisches</unclear> <unclear cert="medium" resp="#joint">bitten</unclear>, sie
<lb n="17"/><unclear cert="medium" resp="#joint">wollen</unclear> <unclear cert="medium" resp="#joint">ihne</unclear> in <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">werbung</unclear> <unclear cert="low" resp="#joint">nit</unclear> allein
<lb n="18"/><unclear cert="medium" resp="#joint">gern</unclear> <unclear cert="medium" resp="#joint">vernemen</unclear>, sondern auch <unclear cert="medium" resp="#joint">ihme</unclear> <unclear cert="medium" resp="#joint">darinnen</unclear>
<lb n="19"/>mit so freündtlichem und <unclear cert="low" resp="#joint">wolgeneigtem</unclear> günstigen
<lb n="20"/><unclear cert="medium" resp="#joint">bescheid</unclear> <unclear cert="medium" resp="#joint">begegnen</unclear>, wie <unclear cert="medium" resp="#joint">eben</unclear> in diser sach
<lb n="21"/>vor disem <unclear cert="low" resp="#joint">mehr</unclear> <unclear cert="low" resp="#joint">rhuemlich</unclear> <unclear cert="low" resp="#joint">beschehen</unclear>,
<lb n="22"/><unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Vt</unclear>. und <unclear cert="medium" resp="#joint">Fr</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. wir <unclear cert="medium" resp="#joint">nach=</unclear>
<lb n="23"/>malen <unclear cert="medium" resp="#joint">freündtlichen</unclear> <unclear cert="medium" resp="#joint">eidtgnosischen</unclear> <unclear cert="medium" resp="#joint">danckh</unclear>
<lb n="24"/>wüssen, und solches alles umb sie
<lb n="25"/><unclear cert="medium" resp="#joint">unsere</unclear> getreüw lieb <unclear cert="medium" resp="#joint">Eidtgnossen</unclear> mit gantz
<lb n="26"/><unclear cert="medium" resp="#joint">geneigtem</unclear> <unclear cert="medium" resp="#joint">unverdrossnem</unclear> willen widerumb
<lb n="27"/>zubeschulden und zuverdienen begeren.
<lb n="28"/><unclear cert="medium" resp="#joint">Thuond</unclear> darmit sie und uns <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> des Aller=
<lb n="29"/><unclear cert="medium" resp="#joint">hoechsten</unclear> in <unclear cert="medium" resp="#joint">treüwen</unclear> <unclear cert="medium" resp="#joint">wol</unclear> <unclear cert="medium" resp="#joint">befelhen</unclear>. <unclear cert="medium" resp="#joint">Date</unclear>
<lb n="30"/><origDate when="1619" resp="#ner">den. <unclear cert="low" resp="#joint">22</unclear>. <unclear cert="low" resp="#joint">t</unclear>. <unclear cert="low" resp="#joint">Februarij</unclear> <unclear cert="low" resp="#joint">Ao</unclear> <unclear cert="low" resp="#joint">1619</unclear></origDate>.
<lb n="31"/><unclear cert="low" resp="#joint">B</unclear> <unclear cert="low" resp="#joint">u</unclear> rath
<lb n="32"/><unclear cert="low" resp="#joint">An</unclear> <unclear cert="low" resp="#joint">die</unclear> statt <orgName ref="stadtasg-actors-575" cert="medium" role="recipient" resp="#ner">Lucern</orgName>.
<pb facs="StadtASG_Missive_2118_7934.jpg" n="2"/>
<lb n="33"/>Unser <unclear cert="medium" resp="#joint">freundtlich</unclear> willig dienst, und was wir
<lb n="34"/><unclear cert="medium" resp="#joint">ehren</unclear> liebs und <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear>, <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="medium" resp="#joint">Edler</unclear>,
<lb n="35"/><unclear cert="medium" resp="#joint">Vester</unclear>, <unclear cert="medium" resp="#joint">Frommer</unclear>, <unclear cert="medium" resp="#joint">Fuersichtiger</unclear>, <unclear cert="medium" resp="#joint">Ersamer</unclear>, und
<lb n="36"/><unclear cert="medium" resp="#joint">Weiser</unclear>, Insonders <unclear cert="medium" resp="#joint">gueter</unclear> freunden und ge-
<lb n="37"/><unclear cert="medium" resp="#joint">treuewer</unclear> <unclear cert="medium" resp="#joint">lieber</unclear> <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>.
<lb n="38"/><unclear cert="medium" resp="#joint">Welcher</unclear> <unclear cert="medium" resp="#joint">massen</unclear> <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">getreuewe</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">mit</unclear>-
<lb n="39"/><unclear cert="medium" resp="#joint">burgere</unclear> die <unclear cert="medium" resp="#joint">Edler</unclear> <unclear cert="medium" resp="#joint">Vester</unclear> <unclear cert="medium" resp="#joint">herren</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Joachim</unclear></persName>, <unclear cert="medium" resp="#joint">Lo</unclear>-
<lb n="40"/><unclear cert="medium" resp="#joint">renz</unclear>, und <persName resp="#ner"><unclear cert="medium" resp="#joint">David</unclear></persName> die <unclear cert="medium" resp="#joint">Zolikoffer</unclear>, <unclear cert="medium" resp="#joint">gebruedere</unclear>,
<lb n="41"/><unclear cert="medium" resp="#joint">von</unclear> und zuo <placeName resp="#ner">Alten Klingen</placeName>, <unclear cert="medium" resp="#joint">von</unclear> ihrer <unclear cert="medium" resp="#joint">gemeinen</unclear>
<lb n="42"/>handels <unclear cert="medium" resp="#joint">gesellschafft</unclear> und <unclear cert="medium" resp="#joint">deroselben</unclear> <unclear cert="medium" resp="#joint">obligenden</unclear>
<lb n="43"/><unclear cert="medium" resp="#joint">gschaefften</unclear> wegen, <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. und <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Lbt</unclear>.
<lb n="44"/><unclear cert="low" resp="#joint">ansehenlicher</unclear> <unclear cert="low" resp="#joint">Intercessionschrifften</unclear>, an under-
<lb n="45"/><unclear cert="medium" resp="#joint">schidliche</unclear> <unclear cert="medium" resp="#joint">Staend</unclear> in <placeName ref="stadtasg-places-131" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Franckhreich</unclear></placeName> <unclear cert="medium" resp="#joint">beduerfftig</unclear>
<lb n="46"/><unclear cert="medium" resp="#joint">seyen</unclear>, das werden sie von <unclear cert="medium" resp="#joint">zeigeren</unclear> diß
<lb n="47"/>ihrem deßhalb bestellten Agenten mit <unclear cert="medium" resp="#joint">mehrerem</unclear>
<lb n="48"/>haben <unclear cert="low" resp="#joint">zuvernemen</unclear>.
<lb n="49"/>Und <unclear cert="medium" resp="#joint">dieweil</unclear> sie dann verhofft, diser <unclear cert="medium" resp="#joint">unserer</unclear>
<lb n="50"/><unclear cert="medium" resp="#joint">fuerschrifft</unclear> an <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. und <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Lbt</unclear>. zuo <unclear cert="low" resp="#joint">obbe</unclear>-
<lb n="51"/><unclear cert="low" resp="#joint">gegnetem</unclear> <unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">intent</unclear> <unclear cert="low" resp="#joint">fruchtbarlich</unclear> <unclear cert="low" resp="#joint">zugeniessen</unclear>.
<lb n="52"/>So haben wir <unclear cert="medium" resp="#joint">ihnen</unclear> <unclear cert="medium" resp="#joint">dieselbige</unclear> umb sovil
<lb n="53"/>desto lieber mittheilen <unclear cert="medium" resp="#joint">wollen</unclear>, <unclear cert="medium" resp="#joint">dieweil</unclear>
<lb n="54"/>wir <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. und <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Lbt</unclear>. <unclear cert="low" resp="#joint">meniglich</unclear> zuo
<lb n="55"/>aller <unclear cert="low" resp="#joint">wollfart</unclear> <unclear cert="low" resp="#joint">zubefuerderen</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">ganz</unclear> <unclear cert="low" resp="#joint">geneigt</unclear>
<lb n="56"/>wüssen.
<lb n="57"/><unclear cert="medium" resp="#joint">Gelangt</unclear> derowegen an dieselben unser <unclear cert="medium" resp="#joint">freundt</unclear>-
<lb n="58"/>lich <unclear cert="medium" resp="#joint">Eydtgnossisches</unclear> <unclear cert="medium" resp="#joint">bitten</unclear>, <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">wolle</unclear>
<lb n="59"/>dise werbung in solcher gestalt <unclear cert="medium" resp="#joint">annemen</unclear>,
<lb n="60"/>damit die <unclear cert="medium" resp="#joint">Sollicitanten</unclear>, in derselben <unclear cert="medium" resp="#joint">guenstige</unclear>
<lb n="61"/>und <unclear cert="low" resp="#joint">guetwillige</unclear> <unclear cert="low" resp="#joint">willfahrung</unclear>
<lb n="62"/>finden <unclear cert="medium" resp="#joint">moegen</unclear>.
<lb n="63"/>Das <unclear cert="medium" resp="#joint">begeren</unclear> umb <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. und <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Lbt</unclear>. wir
<lb n="64"/>mit allem <unclear cert="medium" resp="#joint">Eydtgnossischen</unclear> willen, <unclear cert="medium" resp="#joint">bests</unclear> unsers
<lb n="65"/><unclear cert="low" resp="#joint">vermoegens</unclear>, <unclear cert="low" resp="#joint">hinwiderumb</unclear> <unclear cert="low" resp="#joint">zubeschulden</unclear>, und <unclear cert="medium" resp="#joint">zu</unclear>-
