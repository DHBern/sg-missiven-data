<lb n="67"/><unclear cert="medium" resp="#joint">Allmacht</unclear> zuo <unclear cert="medium" resp="#joint">bestendiger</unclear> <unclear cert="medium" resp="#joint">wolfart</unclear> in <unclear cert="medium" resp="#joint">treuewen</unclear>
<lb n="68"/><unclear cert="medium" resp="#joint">An</unclear> die <unclear cert="medium" resp="#joint">Statt</unclear> <orgName ref="stadtasg-actors-503" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Zuerich</unclear></orgName>. <unclear cert="medium" resp="#joint">befelchen</unclear>. Datum den. <origDate when="1619" resp="#ner">24. <unclear cert="medium" resp="#joint">t</unclear>. <unclear cert="medium" resp="#joint">Febr</unclear>. 1619</origDate>.
