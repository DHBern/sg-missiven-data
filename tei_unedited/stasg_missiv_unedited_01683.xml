<lb n="2"/><unclear cert="low" resp="#joint">gen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">durchzug</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">die</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydtgnoschafft</unclear></orgName> <unclear cert="low" resp="#joint">mitgetheilt</unclear>.
<lb n="3"/>Unser <unclear cert="low" resp="#joint">frunttlich</unclear> <unclear cert="low" resp="#joint">willig</unclear> <unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">zuovor</unclear> <unclear cert="low" resp="#joint">fuersichtigen</unclear> <unclear cert="low" resp="#joint">ersamen</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">undt</unclear> weisen, besonderß lieben guoten freundt und
<lb n="5"/>nachburen.
<lb n="6"/>Waß <persName resp="#ner">E. E. W.</persName> wir vor disem, und <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">daruff</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">jetzo</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">schwebender</unclear> <unclear cert="low" resp="#joint">leuffen</unclear>, nachbarlich zuo geschriben,
<lb n="8"/>auch darbey zuo beden theilen, <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">erhaltung</unclear> <unclear cert="low" resp="#joint">fernerer</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">guoter</unclear> <unclear cert="low" resp="#joint">nachbarsch</unclear> <unclear cert="low" resp="#joint">corrspondentz</unclear> <unclear cert="low" resp="#joint">verglichen</unclear>,
<lb n="10"/>und verheißen worden, daß mann namblich alles
<lb n="11"/>daß jennig waß weiter deßhalben in erfarung gebracht
<lb n="12"/>werden möchte, ein andern vertraulich <unclear cert="low" resp="#joint">communicirn</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">avißirn</unclear> <unclear cert="low" resp="#joint">wölle</unclear>, <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">alles</unclear> <persName resp="#ner">E. E. W.</persName>
<lb n="14"/>ohne zwiffel wol zuo erinnern haben.
<lb n="15"/>Nun seindt wir jetzo bey <unclear cert="low" resp="#joint">glaubwurdigen</unclear> in <unclear cert="low" resp="#joint">erfarung</unclear> <unclear cert="low" resp="#joint">kommen</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
