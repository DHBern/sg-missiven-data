<lb n="54"/>habent, <unclear cert="medium" resp="#joint">fuer</unclear> unnser <unclear cert="medium" resp="#joint">stim</unclear> darby <unclear cert="medium" resp="#joint">ouch</unclear> bewenden <unclear cert="medium" resp="#joint">laßend</unclear>,
