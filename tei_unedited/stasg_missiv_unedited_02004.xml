<lb n="49"/>ordnung und <unclear cert="medium" resp="#joint">bevelch</unclear> <unclear cert="medium" resp="#joint">gethann</unclear>, das <unclear cert="medium" resp="#joint">disere</unclear> zyt <unclear cert="medium" resp="#joint">keinem</unclear>
<lb n="50"/><unclear cert="medium" resp="#joint">froembden</unclear> <unclear cert="medium" resp="#joint">kriegsvolckh</unclear> den <unclear cert="medium" resp="#joint">paß</unclear> durch <unclear cert="medium" resp="#joint">unnsere</unclear>
