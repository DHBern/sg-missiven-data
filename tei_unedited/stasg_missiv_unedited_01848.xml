<p>
<pb facs="StadtASG_Missive_1848_6861.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freüntlich</unclear> willig dienst, und was wir ehren
<lb n="2"/>liebs und guots <unclear cert="medium" resp="#joint">vermoegend</unclear> zuovor, <unclear cert="medium" resp="#joint">edler</unclear>, <unclear cert="medium" resp="#joint">vester</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">fromen</unclear>, fürsichtigen, <unclear cert="medium" resp="#joint">ehrsamen</unclear> und weisen, in-
<lb n="4"/><unclear cert="medium" resp="#joint">sonders</unclear> guoten <unclear cert="medium" resp="#joint">freünden</unclear>, und <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben
<lb n="5"/>eidtgnossen.
<lb n="6"/>Mit <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">unaußgefüerten</unclear> <unclear cert="low" resp="#joint">gefärden</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Meijer</unclear></persName>,
<lb n="7"/>uf dem <placeName resp="#ner"><unclear cert="medium" resp="#joint">Thierhag</unclear></placeName> in dem <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Turgoew</unclear></placeName> <unclear cert="medium" resp="#joint">wonende</unclear>, <unclear cert="medium" resp="#joint">beiden</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">burgern</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Lorentz</unclear> <unclear cert="medium" resp="#joint">Teschlern</unclear></persName> und <persName resp="#ner">Johannes <unclear cert="medium" resp="#joint">Schaihe</unclear>-
<lb n="9"/>man</persName>, wegen <unclear cert="medium" resp="#joint">aigenthuembung</unclear> ihrer <unclear cert="medium" resp="#joint">beider</unclear> ehr-
<lb n="10"/><unclear cert="medium" resp="#joint">frauwen</unclear> <unclear cert="medium" resp="#joint">vätter</unclear>- und <unclear cert="medium" resp="#joint">mueterlichen</unclear> <unclear cert="medium" resp="#joint">erbguots</unclear>, <unclear cert="medium" resp="#joint">umb</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">gelt</unclear>, werden dieselben <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">zaigern</unclear> diß so wol
<lb n="12"/>und mit <unclear cert="medium" resp="#joint">mehrern</unclear> <unclear cert="medium" resp="#joint">vernemen</unclear>; als sie (<unclear cert="medium" resp="#joint">unsers</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">erachtens</unclear>.) <unclear cert="medium" resp="#joint">vor</unclear> disem <unclear cert="medium" resp="#joint">ebenmessig</unclear> <unclear cert="medium" resp="#joint">werden</unclear> ver-
<lb n="14"/><unclear cert="medium" resp="#joint">nomen</unclear> haben, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Meijer</unclear></persName> gegen dem <unclear cert="low" resp="#joint">freijen</unclear>
