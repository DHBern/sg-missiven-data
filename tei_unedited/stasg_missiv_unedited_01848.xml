<lb n="16"/>standen <unclear cert="medium" resp="#joint">hatte</unclear>, <unclear cert="medium" resp="#joint">wan</unclear> durch <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">vt</unclear>. und <unclear cert="low" resp="#joint">f</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">wht</unclear>.
<lb n="17"/>durch billiche <unclear cert="medium" resp="#joint">mitel</unclear> <unclear cert="medium" resp="#joint">ihme</unclear> <unclear cert="medium" resp="#joint">Meijer</unclear> nit <unclear cert="medium" resp="#joint">darvor</unclear> gewesen
