<lb n="36"/>besagtem <unclear cert="medium" resp="#joint">hern</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Buochern</unclear></persName>, oder dem <unclear cert="low" resp="#joint">Ruoblj</unclear>
