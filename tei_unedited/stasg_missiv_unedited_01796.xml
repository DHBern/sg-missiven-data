    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1796_6637.jpg" n="1"/>
<lb n="1"/>Unsere freundtliche undt willige dienste zuvorn, Erbare, Fuersichtige undt Wolweise, besonders guenstige guete
<lb n="2"/>Freunde, wir koennen euch auß betruebtem gemuethe nicht verhalten, <unclear cert="low" resp="#joint">welcher</unclear> <unclear cert="low" resp="#joint">maßen</unclear> alhier in unser stadt
<lb n="3"/>den <origDate resp="#ner">21. Augusti stylo veteri juengsthin</origDate>-hinen in der <unclear cert="low" resp="#joint">nacht</unclear> <unclear cert="low" resp="#joint">zwischen</unclear> <unclear cert="low" resp="#joint">zehen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">eilff</unclear> <unclear cert="low" resp="#joint">uhren</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="4"/><unclear cert="low" resp="#joint">hengknueß</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">unversehenes</unclear> <unclear cert="low" resp="#joint">feuer</unclear> <unclear cert="low" resp="#joint">auffgangen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">vermittelß</unclear> <unclear cert="low" resp="#joint">eines</unclear> <unclear cert="low" resp="#joint">erhabenen</unclear> <unclear cert="low" resp="#joint">starcken</unclear> <unclear cert="low" resp="#joint">windes</unclear> <unclear cert="low" resp="#joint">dermaßen</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">oberhand</unclear> <unclear cert="low" resp="#joint">genommen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">ohngefehr</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">achzehen</unclear> <unclear cert="low" resp="#joint">stunden</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">groeste</unclear> und beste theil der <unclear cert="low" resp="#joint">stadt</unclear> <unclear cert="low" resp="#joint">innerhalb</unclear> der
<lb n="6"/><unclear cert="low" resp="#joint">ringkmauren</unclear>, <unclear cert="low" resp="#joint">nebens</unclear> <unclear cert="low" resp="#joint">scheunen</unclear>, <unclear cert="low" resp="#joint">stelle</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">fast</unclear> <unclear cert="low" resp="#joint">dieses</unclear> <unclear cert="low" resp="#joint">jahrs</unclear> <unclear cert="low" resp="#joint">erarndtenen</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">eingebrachten</unclear> <unclear cert="low" resp="#joint">fruechten</unclear>
<lb n="7"/>und <unclear cert="low" resp="#joint">getreydig</unclear> und <unclear cert="low" resp="#joint">fast</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">vorrath</unclear>, <unclear cert="low" resp="#joint">desgleichen</unclear> <unclear cert="low" resp="#joint">beide</unclear> <unclear cert="low" resp="#joint">thuerme</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">gelaeuthe</unclear>, <unclear cert="low" resp="#joint">uhrwerck</unclear> und
<lb n="8"/>gantze <unclear cert="low" resp="#joint">tach</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Oberpfarrkirchen</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">Nicolai</unclear></placeName>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">etliche</unclear> <unclear cert="low" resp="#joint">kornboeden</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">zeugkhauß</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">Töpfferthor</unclear>, <unclear cert="low" resp="#joint">thuerme</unclear> und andere <unclear cert="low" resp="#joint">gemeiner</unclear> <unclear cert="low" resp="#joint">stadt</unclear> <unclear cert="low" resp="#joint">zustehende</unclear> <unclear cert="low" resp="#joint">gebaeude</unclear>, <unclear cert="low" resp="#joint">abgebrennet</unclear> und in die aschen geleget worden,
<lb n="10"/>dadurch wir der rath und unsere buergerschafft in großen schaden, der mit etlichen tonnen goldes nicht zube-
<lb n="11"/>zahlen, gerathen, das <unclear cert="low" resp="#joint">numehr</unclear> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">brandschedigten</unclear> <unclear cert="low" resp="#joint">mitbuergern</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">mueglich</unclear> <unclear cert="low" resp="#joint">ohn</unclear> <unclear cert="low" resp="#joint">frommer</unclear> und <unclear cert="low" resp="#joint">gut</unclear>-
<lb n="12"/><unclear cert="low" resp="#joint">hertziger</unclear> <unclear cert="low" resp="#joint">christen</unclear> <unclear cert="low" resp="#joint">steur</unclear> und <unclear cert="low" resp="#joint">beystand</unclear> <unclear cert="low" resp="#joint">wiederumb</unclear> <unclear cert="low" resp="#joint">auffzubauen</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">schweren</unclear> <unclear cert="low" resp="#joint">mergklichen</unclear> schaden <unclear cert="low" resp="#joint">etzlicher</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">zuuberwinden</unclear>. <unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">deswegen</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">intercession</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">vorschrifft</unclear> <unclear cert="low" resp="#joint">ahn</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">angelanget</unclear>, so haben wir in ansehung ihres unvermuegens, ihrem demuetigen suchen stadt gegeben,
<lb n="15"/>undt ist hierauff ahn euch unsere <unclear cert="low" resp="#joint">freundliche</unclear> <unclear cert="low" resp="#joint">bitte</unclear>, <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">wollet</unclear> <unclear cert="low" resp="#joint">angeregter</unclear> <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">brandbeschedigten</unclear> <unclear cert="low" resp="#joint">buergerschafft</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">jetzigen</unclear> <unclear cert="low" resp="#joint">betruebten</unclear> <unclear cert="low" resp="#joint">zustand</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">erlittenen</unclear> <unclear cert="low" resp="#joint">brandschaden</unclear> <unclear cert="low" resp="#joint">behertzigen</unclear>, und <unclear cert="low" resp="#joint">ihnen</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">christlichen</unclear> <unclear cert="low" resp="#joint">mitleiden</unclear> mit
<lb n="17"/>einer huelfflichen beysteur befoerderlich erscheinen und zu statten kommen, solches wird sonder zweiffel Gott
<lb n="18"/>der almechtige alß vergelter nicht unbelohnet laßen, so werdens es auch unsere brandbeschedigte mitbuer-
<lb n="19"/>gere mit ihrem andechtigen gebeth bey Goetlicher almmacht und <unclear cert="low" resp="#joint">sonsten</unclear> <unclear cert="low" resp="#joint">eussersten</unclear> <unclear cert="low" resp="#joint">vermuegens</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">zuver</unclear>-
<lb n="20"/>dienen sich befleißigen. Undt wir sind es daneben umb <unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">freundlichen</unclear> <unclear cert="low" resp="#joint">zuverschulden</unclear> willig.
<lb n="21"/>Geben unter unserm stadtsecret den <origDate when="1612-09-16" resp="#ner">16. Septembris anno 1612</origDate>.
<lb n="22"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Der rath zue
<lb n="23"/>Northaußen</orgName>.
<pb facs="StadtASG_Missive_1796_6638.jpg" n="2"/>
<lb n="24"/>Denn Erbarn. vorsichtigen undt woll=
<lb n="25"/>weisen Herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear> undt
<lb n="26"/><unclear cert="low" resp="#joint">Rhatt</unclear> zuo S. Gallen</orgName>. <unclear cert="medium" resp="#joint">Unßern</unclear> be=
<lb n="27"/>sonders guenstigen guten <unclear cert="low" resp="#joint">Freunden</unclear>.
<lb n="28"/><unclear cert="low" resp="#joint">Fraencckisch</unclear>.
</p>
