<p>
<pb facs="StadtASG_Missive_700_1707.JPG" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">fruntlich</unclear> willig diennst, sampt was wir
<lb n="2"/>Eeren liebs unnd guots <unclear cert="medium" resp="#joint">vermoegent</unclear> zuovor, from
<lb n="3"/><unclear cert="low" resp="#joint">fursichtig</unclear> wyß. <unclear cert="low" resp="#joint">Innsunders</unclear> <unclear cert="low" resp="#joint">guotenn</unclear> frundt
<lb n="4"/>unnd <unclear cert="low" resp="#joint">getruwenn</unclear> liebenn <unclear cert="low" resp="#joint">Eydtgnossenn</unclear>
<lb n="5"/>Unnser <unclear cert="low" resp="#joint">getruwer</unclear> lieber <unclear cert="low" resp="#joint">Burgermeister</unclear> herr
<lb n="6"/> <persName resp="#ner">Hanns <unclear cert="low" resp="#joint">Ruodolff</unclear> <unclear cert="low" resp="#joint">Lafater</unclear></persName>. Unnd unnser Burger
<lb n="7"/><persName resp="#ner">Marx Stapffer</persName> habenn unns <unclear cert="low" resp="#joint">furbringen</unclear> <unclear cert="low" resp="#joint">lassn</unclear>.
<lb n="8"/>Wie <persName resp="#ner">Heinrich <unclear cert="low" resp="#joint">Graff</unclear></persName> <unclear cert="low" resp="#joint">uwer</unclear> Burger <unclear cert="low" resp="#joint">verschiner</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">zyt</unclear> <unclear cert="low" resp="#joint">tods</unclear> <unclear cert="low" resp="#joint">verscheydenn</unclear>, unnd sy <unclear cert="low" resp="#joint">nebent</unclear> anndern
<lb n="10"/>vermeint <unclear cert="medium" resp="#joint">alda</unclear> <unclear cert="medium" resp="#joint">sines</unclear> verlaßnen <unclear cert="medium" resp="#joint">guotenns</unclear> erben
<lb n="11"/><unclear cert="medium" resp="#joint">zesin</unclear>, <unclear cert="medium" resp="#joint">syge</unclear> <unclear cert="medium" resp="#joint">inen</unclear> von <unclear cert="medium" resp="#joint">ettlichen</unclear> dargegen <unclear cert="medium" resp="#joint">sovil</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">intrag</unclear> <unclear cert="medium" resp="#joint">begegnet</unclear>, das sy achten <unclear cert="medium" resp="#joint">nunmer</unclear> <unclear cert="medium" resp="#joint">nutz</unclear>
<lb n="13"/>annders dann das recht <unclear cert="low" resp="#joint">zebruchen</unclear> sin, deß-
<lb n="14"/><unclear cert="low" resp="#joint">halbenn</unclear> sy iren lieben Bruoder unnd schwagern
<lb n="15"/><persName resp="#ner">Jacob Grafen</persName>, unnd <persName resp="#ner">Heinrichen <unclear cert="low" resp="#joint">Truber</unclear></persName> <unclear cert="medium" resp="#joint">gwalt</unclear>
<lb n="16"/>unnd <unclear cert="low" resp="#joint">Bevelch</unclear> <unclear cert="low" resp="#joint">semlich</unclear> recht Inn <unclear cert="medium" resp="#joint">irem</unclear> unnd
<lb n="17"/>Ir <unclear cert="low" resp="#joint">selbs</unclear> namen <unclear cert="low" resp="#joint">zevolfueren</unclear>, geben, unnd uns
<lb n="18"/><unclear cert="medium" resp="#joint">daruf</unclear> ganntz <unclear cert="low" resp="#joint">fruntlich</unclear> <unclear cert="low" resp="#joint">gepaetten</unclear> Inen mit <unclear cert="low" resp="#joint">fur</unclear>-
<lb n="19"/>schrifft gegen uch <unclear cert="medium" resp="#joint">Erschyeßlich</unclear> zuo sin, <unclear cert="low" resp="#joint">guoter</unclear> hoff-
<lb n="20"/>nung ders wol zuo <unclear cert="low" resp="#joint">geniessen</unclear>, unnd
<lb n="21"/>so wir dann die unnsern zuo <unclear cert="low" resp="#joint">furdern</unclear> ganntz ge-
<lb n="22"/>neigt, lanngt an uch unnser <unclear cert="low" resp="#joint">fruntlich</unclear>
<lb n="23"/>pitt, Ir <unclear cert="medium" resp="#joint">wollent</unclear> gemelten gelopten <unclear cert="medium" resp="#joint">gwalthabern</unclear>
<lb n="24"/>Inn diser <unclear cert="low" resp="#joint">Irer</unclear> sach <unclear cert="medium" resp="#joint">rechtens</unclear>, <unclear cert="medium" resp="#joint">beraten</unclear>, unnd daran
<lb n="25"/>sin, das sy zuo <unclear cert="low" resp="#joint">furderlichem</unclear> unnd <unclear cert="low" resp="#joint">unuerzog</unclear>-
<lb n="26"/>nem rechten komen, unnd inen das <unclear cert="low" resp="#joint">glangn</unclear>
<lb n="27"/>sy <unclear cert="low" resp="#joint">fuog</unclear> unnd recht habenn <unclear cert="low" resp="#joint">verlanng</unclear>, <unclear cert="low" resp="#joint">wie</unclear>
<lb n="28"/>wir dann <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">hierzuo</unclear> geneigt, unnd willig
<lb n="29"/>sin <unclear cert="low" resp="#joint">wussent</unclear>, unnd <unclear cert="low" resp="#joint">uch</unclear> harinn <unclear cert="low" resp="#joint">unnserm</unclear>
<lb n="30"/>sunders <unclear cert="low" resp="#joint">vertruwen</unclear> nach, <unclear cert="low" resp="#joint">bewijsen</unclear>, stat uns
<lb n="31"/>uch Inn <unclear cert="low" resp="#joint">semlichem</unclear> unnd annderm <unclear cert="low" resp="#joint">yederzyt</unclear>
<lb n="32"/>ganntz <unclear cert="low" resp="#joint">fruntlich</unclear> zuo <unclear cert="medium" resp="#joint">verdiennen</unclear>, <unclear cert="low" resp="#joint">dat</unclear>
<lb n="33"/>den <origDate resp="#ner"><unclear cert="low" resp="#joint">xxiiiij</unclear> <unclear cert="low" resp="#joint">hoewmonats</unclear> Anno <unclear cert="medium" resp="#joint">d</unclear> lj</origDate>
<lb n="34"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear> unnd rath
<lb n="35"/>der statt <unclear cert="low" resp="#joint">Zurich</unclear></orgName>,
<pb facs="StadtASG_Missive_700_1708.JPG" n="2"/>
<pb facs="StadtASG_Missive_700_1709.JPG" n="3"/>
<pb facs="StadtASG_Missive_700_1710.JPG" n="4"/>
<lb n="36"/>Den fromen <unclear cert="low" resp="#joint">fuersichtigenn</unclear> wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="37"/>meyster unnd Rate, der statt zuo <unclear cert="low" resp="#joint">Sant</unclear>
<lb n="38"/><unclear cert="medium" resp="#joint">Gallenn</unclear></orgName>, unnsern innsonnders guetten,
<lb n="39"/>fruenden und getruewenn liebn Eydgnon.
</p>
