<p>
<pb facs="StadtASG_Missive_988_3007.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Den</unclear> <unclear cert="low" resp="#joint">fursichtigen</unclear> und <unclear cert="low" resp="#joint">eersamen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">burgermaistern</unclear> und <unclear cert="low" resp="#joint">rathe</unclear> der statt <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">Sanct</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></orgName> <unclear cert="low" resp="#joint">unsern</unclear> lieben und <unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">frunden</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">embuetten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">der</unclear> <orgName ref="stadtasg-actors-1187" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">rathgeben</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">statt</unclear> <unclear cert="low" resp="#joint">Augspurg</unclear></orgName> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">frunndtlich</unclear> <unclear cert="low" resp="#joint">willig</unclear> <unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">zuvor</unclear> lieben und <unclear cert="medium" resp="#joint">eersamen</unclear> lieb und <unclear cert="medium" resp="#joint">guotte</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">frund</unclear> wir haben <unclear cert="medium" resp="#joint">e</unclear>. <unclear cert="medium" resp="#joint">wst</unclear>. schreiben <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">beysweg</unclear> <unclear cert="medium" resp="#joint">umb</unclear> die z. <persName resp="#ner"><unclear cert="medium" resp="#joint">Catherina</unclear> <unclear cert="medium" resp="#joint">Hoefstetterin</unclear></persName> <unclear cert="medium" resp="#joint">goetzen</unclear> alles innhalts <unclear cert="medium" resp="#joint">sampt</unclear> <unclear cert="medium" resp="#joint">unsrem</unclear>
<lb n="4"/>und im <unclear cert="medium" resp="#joint">abwesen</unclear> <unclear cert="medium" resp="#joint">unsers</unclear> burgers <persName resp="#ner"><unclear cert="low" resp="#joint">Mathesen</unclear> <unclear cert="low" resp="#joint">Manndex</unclear></persName> <unclear cert="low" resp="#joint">sonns</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Carols</unclear></persName> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">verhandlung</unclear> wie <unclear cert="medium" resp="#joint">ain</unclear> anders im <unclear cert="low" resp="#joint">fellen</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">wegen</unclear>, <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">hauswirtin</unclear> <unclear cert="low" resp="#joint">underhaltung</unclear> <unclear cert="low" resp="#joint">laisten</unclear>. <unclear cert="low" resp="#joint">Was</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">heut</unclear> <unclear cert="low" resp="#joint">dato</unclear> dagegen <unclear cert="medium" resp="#joint">bracht</unclear> <unclear cert="medium" resp="#joint">lais</unclear> innligendts <unclear cert="medium" resp="#joint">zuvernemen</unclear>.
<lb n="6"/><unclear cert="medium" resp="#joint">Darauß</unclear> <unclear cert="medium" resp="#joint">werden</unclear> e. <unclear cert="medium" resp="#joint">wst</unclear>. bald sehen das wir in <unclear cert="medium" resp="#joint">dieweil</unclear> gedachten <persName resp="#ner"><unclear cert="low" resp="#joint">Manndex</unclear></persName> <unclear cert="low" resp="#joint">son</unclear> an ir als <unclear cert="medium" resp="#joint">brüchig</unclear> <unclear cert="medium" resp="#joint">werd</unclear>,
<lb n="7"/><unclear cert="medium" resp="#joint">mitls</unclear> <unclear cert="medium" resp="#joint">erkleren</unclear>, <unclear cert="medium" resp="#joint">veilweniger</unclear> die <unclear cert="medium" resp="#joint">gwandten</unclear>. Es <unclear cert="medium" resp="#joint">ist</unclear> <unclear cert="medium" resp="#joint">hiewer</unclear> <unclear cert="medium" resp="#joint">ons</unclear> dz <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">Manndex</unclear> <unclear cert="low" resp="#joint">sons</unclear> <unclear cert="low" resp="#joint">eeliche</unclear> <unclear cert="low" resp="#joint">khind</unclear> <unclear cert="low" resp="#joint">underhaltung</unclear> <unclear cert="low" resp="#joint">zu</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">selssen</unclear> <unclear cert="low" resp="#joint">verordnet</unclear>, oder <unclear cert="low" resp="#joint">den</unclear> an <unclear cert="low" resp="#joint">Hoefstetteri</unclear> mit <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">unnserlichen</unclear> und <unclear cert="low" resp="#joint">verdorben</unclear> <unclear cert="low" resp="#joint">verfliessen</unclear> <unclear cert="low" resp="#joint">weyb</unclear> <unclear cert="low" resp="#joint">anzunehmen</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">beschweren</unclear> <unclear cert="low" resp="#joint">solle</unclear>, doch <unclear cert="low" resp="#joint">tobs</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Hoefstetterin</unclear></persName> <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">drittlen</unclear> selbs <unclear cert="medium" resp="#joint">oder</unclear> es billich <unclear cert="medium" resp="#joint">mitziehen</unclear> und underhalten <unclear cert="low" resp="#joint">solle</unclear>, <unclear cert="low" resp="#joint">zu</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">welscher</unclear> <unclear cert="low" resp="#joint">handlung</unclear> <unclear cert="low" resp="#joint">ordenliche</unclear> <unclear cert="low" resp="#joint">hilff</unclear> der oberckheit <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">gebür</unclear> <unclear cert="low" resp="#joint">anzesalben</unclear> haben wir <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">wst</unclear>. <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">widerantwurt</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">wollen</unclear> <unclear cert="low" resp="#joint">verhalten</unclear>. <unclear cert="low" resp="#joint">Dena</unclear> wir <unclear cert="low" resp="#joint">frunndtliche</unclear> <unclear cert="low" resp="#joint">dienst</unclear> und angenembs gefallen <unclear cert="medium" resp="#joint">zuerzeigen</unclear> <unclear cert="medium" resp="#joint">gencigt</unclear> und willig.
<lb n="12"/>Datum den <origDate when="1572-05-16" cert="medium" resp="#ner">16. <unclear cert="medium" resp="#joint">maij</unclear> a° <unclear cert="medium" resp="#joint">72</unclear></origDate>.
<pb facs="StadtASG_Missive_988_3008.jpg" n="2"/>
<lb n="13"/>Den ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaistern
<lb n="14"/>und Rathe der statt Sanct Gallen</orgName> unsern
<lb n="15"/>lieben und gueten freunden
