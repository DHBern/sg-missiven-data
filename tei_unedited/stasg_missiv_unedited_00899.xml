<p>
<pb facs="StadtASG_Missive_899_2611.jpg" n="1"/>
<lb n="1"/>Unnser fruntlich willig diennst sampt allem <unclear cert="low" resp="#joint">nachpurlichen</unclear>
<lb n="2"/>willenn was wir <unclear cert="low" resp="#joint">erenn</unclear> liebs unnd guets <unclear cert="medium" resp="#joint">vermogend</unclear> zuovor.
<lb n="3"/>Fromen fursichtigenn ersamen unnd <unclear cert="low" resp="#joint">wisen</unclear>, <unclear cert="low" resp="#joint">Jnsunnders</unclear> gunstig
<lb n="4"/><unclear cert="low" resp="#joint">guett</unclear> frund und <unclear cert="low" resp="#joint">getruwenn</unclear> liebenn <unclear cert="low" resp="#joint">nachpurenn</unclear> wir habend
<lb n="5"/><unclear cert="low" resp="#joint">euwer</unclear> schriben <unclear cert="low" resp="#joint">betreffennede</unclear> <unclear cert="low" resp="#joint">euwers</unclear> <unclear cert="low" resp="#joint">gfanngnen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Clemmens</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Memwegers</unclear></persName> unsers lanntz von <unclear cert="low" resp="#joint">euch</unclear> den <date resp="#ner"><unclear cert="medium" resp="#joint">5</unclear> <unclear cert="medium" resp="#joint">tz</unclear> diß <unclear cert="low" resp="#joint">monedtz</unclear></date>
<lb n="7"/>an uns <unclear cert="low" resp="#joint">ußganngen</unclear> uff hutt den <date resp="#ner"><unclear cert="medium" resp="#joint">7</unclear> <unclear cert="medium" resp="#joint">tz</unclear></date> um mittag empfangen
<lb n="8"/><unclear cert="medium" resp="#joint">selbigs</unclear> <unclear cert="medium" resp="#joint">jnhalt</unclear> <unclear cert="medium" resp="#joint">verstanden</unclear> etc. <unclear cert="medium" resp="#joint">Har</unclear> uber <unclear cert="low" resp="#joint">sollend</unclear> <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">euch</unclear> zuo ver
<lb n="9"/>nemen das er (wie <unclear cert="low" resp="#joint">er</unclear> euch als <unclear cert="low" resp="#joint">euwer</unclear> schriben <unclear cert="low" resp="#joint">anrelt</unclear> <unclear cert="low" resp="#joint">furge</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">geben</unclear>) unsers lanntz und von <unclear cert="low" resp="#joint">erlichen</unclear> <unclear cert="low" resp="#joint">lutten</unclear> <unclear cert="low" resp="#joint">harkomen</unclear> ist
<lb n="11"/><unclear cert="low" resp="#joint">darzuo</unclear> das er mit dem unsern Hoptman <persName resp="#ner"><unclear cert="low" resp="#joint">burckhart</unclear> <unclear cert="low" resp="#joint">saileren</unclear></persName>
<lb n="12"/>und andern mer <unclear cert="low" resp="#joint">unseren</unclear> lanndt die <unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="medium" resp="#joint">by</unclear> <unclear cert="medium" resp="#joint">lib</unclear> und <unclear cert="low" resp="#joint">leben</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">jn</unclear> <unclear cert="low" resp="#joint">verschnen</unclear> <unclear cert="low" resp="#joint">zugen</unclear> und <unclear cert="low" resp="#joint">kriegen</unclear> <unclear cert="low" resp="#joint">gsin</unclear> <unclear cert="low" resp="#joint">sich</unclear> daselbs und so lang
<lb n="14"/>er by uns <unclear cert="medium" resp="#joint">jm</unclear> lannd gewonet aller dingen <unclear cert="low" resp="#joint">fromcklich</unclear>
<lb n="15"/>und wol (<unclear cert="medium" resp="#joint">anderst</unclear> das er <unclear cert="medium" resp="#joint">das</unclear> sin <unclear cert="low" resp="#joint">jn</unclear> der <unclear cert="low" resp="#joint">jugent</unclear> mit <unclear cert="medium" resp="#joint">kriegen</unclear>
<lb n="16"/>und <unclear cert="low" resp="#joint">derglichen</unclear> <unclear cert="low" resp="#joint">verthon</unclear>) gehalten so vil wir von jm wissend
<lb n="17"/>und <unclear cert="medium" resp="#joint">gehoert</unclear>. <unclear cert="medium" resp="#joint">Darnebend</unclear> ist <unclear cert="medium" resp="#joint">es</unclear> <unclear cert="medium" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">jm</unclear> selbs wie er <unclear cert="medium" resp="#joint">nach</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">euwerem</unclear> <unclear cert="low" resp="#joint">schriben</unclear> der <unclear cert="low" resp="#joint">gwerdtz</unclear> und <unclear cert="low" resp="#joint">stuurholtz</unclear> halben <unclear cert="medium" resp="#joint">anzögt</unclear>
<lb n="19"/>war. <unclear cert="low" resp="#joint">Darzuo</unclear> sin <unclear cert="medium" resp="#joint">elichez</unclear> <unclear cert="medium" resp="#joint">schwoester</unclear> <unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">erlich</unclear> <unclear cert="medium" resp="#joint">wib</unclear> (die grossen
<lb n="20"/><unclear cert="low" resp="#joint">jomer</unclear> <unclear cert="low" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">umschwaiffens</unclear>) noch jn <unclear cert="low" resp="#joint">lebenn</unclear>. <unclear cert="low" resp="#joint">Derhalben</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">gunstigenn</unclear> <unclear cert="low" resp="#joint">lieben</unclear> und <unclear cert="low" resp="#joint">guetten</unclear> frund, so wellend wir euch uff
<lb n="22"/><unclear cert="low" resp="#joint">euwer</unclear> <unclear cert="low" resp="#joint">fruntlichs</unclear> und <unclear cert="low" resp="#joint">nachpurlichs</unclear> <unclear cert="low" resp="#joint">begeren</unclear> wie er sich <unclear cert="low" resp="#joint">by</unclear>
<lb n="23"/>uns gehalten, und so vil wir siner handlung <unclear cert="medium" resp="#joint">wüssen</unclear> habenn
<lb n="24"/>bester <unclear cert="low" resp="#joint">mainig</unclear> verstendigt haben und <unclear cert="low" resp="#joint">erputtend</unclear> <unclear cert="low" resp="#joint">uns</unclear> gegen
<lb n="25"/>euch <unclear cert="medium" resp="#joint">herwider</unclear> <unclear cert="medium" resp="#joint">uß</unclear> allem <unclear cert="low" resp="#joint">nachpurlichem</unclear> willenn
<lb n="26"/><unclear cert="low" resp="#joint">jederzitt</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">bewijsen</unclear> sonnders <unclear cert="medium" resp="#joint">wol</unclear> <unclear cert="medium" resp="#joint">gnaigt</unclear>.
<pb facs="StadtASG_Missive_899_2612.jpg" n="2"/>
<lb n="27"/>Hie mit sind <unclear cert="low" resp="#joint">goetlicher</unclear> gnaden gnaden <unclear cert="low" resp="#joint">trüwlich</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">befelchende</unclear>. <unclear cert="low" resp="#joint">Datt</unclear> den <origDate when="1568" cert="medium" resp="#ner">7 tag junij im 68 <unclear cert="medium" resp="#joint">jar</unclear></origDate>.
<lb n="29"/><orgName ref="stadtasg-actors-506" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Lanndtaman</unclear> und
<lb n="30"/>ratt <unclear cert="medium" resp="#joint">zuo</unclear> Appentzell</orgName>.
<pb facs="StadtASG_Missive_899_2613.jpg" n="3"/>
<pb facs="StadtASG_Missive_899_2614.jpg" n="4"/>
<lb n="31"/>Den frommen <unclear cert="low" resp="#joint">fuersichtigen</unclear> <unclear cert="medium" resp="#joint">ersammen</unclear>
<lb n="32"/>unnd wysenn <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">burgermaister</unclear> und <unclear cert="low" resp="#joint">rate</unclear>
<lb n="33"/>der statt <unclear cert="low" resp="#joint">Sannt</unclear> Gallen</orgName>, <unclear cert="low" resp="#joint">unsernn</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">fruenden</unclear> und lieben nachpuren.
</p>
