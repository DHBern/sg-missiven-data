<lb n="1"/><unclear cert="medium" resp="#joint">Unnser</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear>, nachparlich unnd <unclear cert="low" resp="#joint">guot=</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">willig</unclear> <unclear cert="medium" resp="#joint">diennst</unclear> zuovor, <unclear cert="low" resp="#joint">Fürsichtig</unclear>, Ersame
<lb n="3"/>Weise, besonders liebe <unclear cert="low" resp="#joint">freündt</unclear> unnd guete
<lb n="4"/>Nachparn. <unclear cert="low" resp="#joint">Unnß</unclear> <unclear cert="low" resp="#joint">berichtet</unclear> unnser bur=
<lb n="5"/>ger <persName resp="#ner">Eraßmuß Bädinger</persName> gehorsamblich, waß=
<lb n="6"/><unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">todtsveroben</unclear>, <persName resp="#ner">Hannß <unclear cert="low" resp="#joint">Hörn</unclear></persName>, <unclear cert="low" resp="#joint">seiner</unclear> groß=
<lb n="7"/>muetter Schwester Sohn, an erbe <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">abge=</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">leibtn</unclear> <unclear cert="low" resp="#joint">Muetter</unclear> <unclear cert="low" resp="#joint">gschwistrig</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">besagter</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">Muetter</unclear> <unclear cert="low" resp="#joint">statt</unclear>, <unclear cert="low" resp="#joint">beÿ</unclear> Eüch <unclear cert="low" resp="#joint">etwanß</unclear> <unclear cert="low" resp="#joint">erb=</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">schaft</unclear> <unclear cert="low" resp="#joint">zuoerhebens</unclear> <unclear cert="low" resp="#joint">entsteehn</unclear>. Mit unnder=
<lb n="11"/><unclear cert="low" resp="#joint">thäniger</unclear> <unclear cert="low" resp="#joint">Pitt</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">woltn</unclear> ime mit <unclear cert="low" resp="#joint">fürschrift</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">in</unclear> Eüch <unclear cert="low" resp="#joint">erbs</unclear> halb <unclear cert="medium" resp="#joint">befhildlich</unclear> erscheinen, ge=
<lb n="13"/>trawte er deßen wol unnd <unclear cert="low" resp="#joint">ersprießlich</unclear> zu=
<lb n="14"/><unclear cert="low" resp="#joint">genießen</unclear>.
<lb n="15"/><unclear cert="low" resp="#joint">Weilln</unclear> nach <unclear cert="low" resp="#joint">befelung</unclear> mit unnseren <unclear cert="low" resp="#joint">rehten</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">ahgelangt</unclear>, <unclear cert="low" resp="#joint">waßmaßen</unclear> ime <unclear cert="medium" resp="#joint">Bädinger</unclear> <unclear cert="medium" resp="#joint">ohne</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">das</unclear>, Ewerer Statt <unclear cert="medium" resp="#joint">löbliche</unclear> Erbrechten
<lb n="18"/><unclear cert="medium" resp="#joint">hiezuo</unclear> <unclear cert="medium" resp="#joint">furstendig</unclear> <unclear cert="medium" resp="#joint">seÿen</unclear>, <unclear cert="medium" resp="#joint">ine</unclear> der <unclear cert="medium" resp="#joint">erbschaft</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">theilhafttig</unclear> machen, <unclear cert="medium" resp="#joint">Als</unclear> <unclear cert="medium" resp="#joint">haben</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">gepettne</unclear>
<lb n="20"/>Intercession, <unclear cert="low" resp="#joint">weniger</unclear> ime Impetranten
<lb n="21"/>verwaigern wollen.
<lb n="22"/><unclear cert="low" resp="#joint">Pitten</unclear> <unclear cert="low" resp="#joint">unndersuchen</unclear> <unclear cert="low" resp="#joint">Eüch</unclear> demnach freündt:
<lb n="23"/>unnd nachparlich, ir <unclear cert="low" resp="#joint">geruocht</unclear> <unclear cert="low" resp="#joint">sowol</unclear> umb
<lb n="24"/>erstangezogens Ewers Erbrechten, alß <unclear cert="low" resp="#joint">auß</unclear>
<lb n="25"/>unnsers wolgemaindn fürpitts willen, <unclear cert="low" resp="#joint">bedachtn</unclear>
<lb n="26"/><persName resp="#ner"><unclear cert="low" resp="#joint">Bädinger</unclear></persName> zu obangeregter <unclear cert="low" resp="#joint">Erbschaft</unclear>, mit
<pb facs="StadtASG_Missive_1591_5758.jpg" n="2"/>
<lb n="27"/><unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">fürdernus</unclear> <unclear cert="low" resp="#joint">ghenen</unclear>, unnd deß <unclear cert="low" resp="#joint">ußfaß</unclear>
<lb n="28"/>da die <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">innß</unclear> <unclear cert="low" resp="#joint">fürkhommen</unclear> <unclear cert="low" resp="#joint">gestaltsam</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">beschaffen</unclear>, <unclear cert="low" resp="#joint">Ine</unclear> bey <unclear cert="low" resp="#joint">ewerem</unclear> loblichen <unclear cert="low" resp="#joint">Stattgebrauch</unclear>,
<lb n="30"/>ordnung unnd <unclear cert="low" resp="#joint">Erbrecht</unclear> <unclear cert="medium" resp="#joint">verbleiben</unclear> <unclear cert="low" resp="#joint">zulassen</unclear>.
<lb n="31"/><unclear cert="medium" resp="#joint">Syen</unclear> <unclear cert="low" resp="#joint">wür</unclear> <unclear cert="low" resp="#joint">erpiettig</unclear>, nit allein solches umb <unclear cert="medium" resp="#joint">euch</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">anderweg</unclear> <unclear cert="low" resp="#joint">freundt</unclear>: Nachparlichen zubeschulden,
<lb n="33"/><unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">begebenen</unclear> <unclear cert="low" resp="#joint">gegenfahl</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Ewe=</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">rigen</unclear> <unclear cert="low" resp="#joint">Innkhuenfftig</unclear>, allainig nach <unclear cert="low" resp="#joint">unnserer</unclear> Statt
<lb n="35"/>Erbordnung, <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">mitt</unclear> <unclear cert="low" resp="#joint">Eüerthail</unclear>,
<lb n="36"/>gegen selbigen solche <unclear cert="low" resp="#joint">ungeendert</unclear> zehalten, nach
<lb n="37"/><unclear cert="low" resp="#joint">hieigen</unclear> <unclear cert="medium" resp="#joint">Erbrechten</unclear> auch <unclear cert="low" resp="#joint">zuuersehen</unclear>, unnd
<lb n="38"/>mit Eüch <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">alten</unclear> <unclear cert="low" resp="#joint">guotten</unclear> Nachparlichen <unclear cert="low" resp="#joint">bißhero</unclear>
