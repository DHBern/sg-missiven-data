    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1591_5757.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unnser</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear>, nachparlich unnd <unclear cert="low" resp="#joint">guot=</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">willig</unclear> diennst <unclear cert="medium" resp="#joint">zuovor</unclear>, <unclear cert="low" resp="#joint">Fürsichtig</unclear>, Ersame
<lb n="3"/>Weise, besonders liebe <unclear cert="low" resp="#joint">freündt</unclear> unnd guete
<lb n="4"/>Nachparn. <unclear cert="low" resp="#joint">Unnß</unclear> <unclear cert="low" resp="#joint">berichtet</unclear> unnser bur=
<lb n="5"/>ger <persName resp="#ner">Eraßmuß Bädinger</persName> gehorsamblich, waß=
<lb n="6"/><unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">todtsveroben</unclear>, <persName resp="#ner">Hannß <unclear cert="low" resp="#joint">Hörn</unclear></persName>, <unclear cert="low" resp="#joint">seiner</unclear> groß=
<lb n="7"/>muetter Schwester Sohn, an erbe <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">abge=</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">leibtn</unclear> <unclear cert="low" resp="#joint">Muetter</unclear> <unclear cert="low" resp="#joint">gschwistrig</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">besagter</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">Muetter</unclear> <unclear cert="low" resp="#joint">statt</unclear>, <unclear cert="low" resp="#joint">beÿ</unclear> Eüch <unclear cert="low" resp="#joint">etwanß</unclear> <unclear cert="low" resp="#joint">erb=</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">schaft</unclear> <unclear cert="low" resp="#joint">zuoerhebens</unclear> <unclear cert="low" resp="#joint">entsteehn</unclear>. Mit unnder=
<lb n="11"/><unclear cert="low" resp="#joint">thäniger</unclear> <unclear cert="low" resp="#joint">Pitt</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">woltn</unclear> ime <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">fürschrift</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">erbs</unclear> <unclear cert="low" resp="#joint">halb</unclear> <unclear cert="low" resp="#joint">befhildlich</unclear> <unclear cert="low" resp="#joint">erscheinen</unclear>, ge=
<lb n="13"/>trawte er deßen wol unnd ersprießlich zu=
<lb n="14"/>genießen.
<lb n="15"/>Weilln nach befelung mit <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">rehten</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">ahgelangt</unclear>, <unclear cert="low" resp="#joint">waßmaßen</unclear> <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">Bädinger</unclear> <unclear cert="low" resp="#joint">ohne</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">das</unclear>, <unclear cert="low" resp="#joint">Ewerer</unclear> Statt <unclear cert="low" resp="#joint">löbliche</unclear> Erbrechten
<lb n="18"/><unclear cert="low" resp="#joint">hiezuo</unclear> <unclear cert="low" resp="#joint">furstendig</unclear> <unclear cert="low" resp="#joint">seÿen</unclear>, <unclear cert="low" resp="#joint">ine</unclear> der <unclear cert="low" resp="#joint">erbschaft</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">theilhafttig</unclear> <unclear cert="low" resp="#joint">machen</unclear>, <unclear cert="low" resp="#joint">Als</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">gepettne</unclear>
<lb n="20"/>Intercession, weniger ime Impetranten
<lb n="21"/>verwaigern wollen.
<lb n="22"/><unclear cert="low" resp="#joint">Pitten</unclear> <unclear cert="low" resp="#joint">unndersuchen</unclear> <unclear cert="low" resp="#joint">Eüch</unclear> demnach freündt:
<lb n="23"/>unnd nachparlich, ir geruocht sowol umb
<lb n="24"/>erstangezogens Ewers Erbrechten, alß <unclear cert="low" resp="#joint">auß</unclear>
<lb n="25"/>unnsers wolgemaindn fürpitts willen, <unclear cert="low" resp="#joint">bedachtn</unclear>
<lb n="26"/><persName resp="#ner"><unclear cert="low" resp="#joint">Bädinger</unclear></persName> zu obangeregter <unclear cert="low" resp="#joint">Erbschaft</unclear>, mit
<pb facs="StadtASG_Missive_1591_5758.jpg" n="2"/>
<lb n="27"/><unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">fürdernus</unclear> <unclear cert="low" resp="#joint">ghenen</unclear>, unnd deß <unclear cert="low" resp="#joint">ußfaß</unclear>
<lb n="28"/>da die <unclear cert="medium" resp="#joint">sachen</unclear> <unclear cert="medium" resp="#joint">innß</unclear> <unclear cert="medium" resp="#joint">fürkhommen</unclear> <unclear cert="medium" resp="#joint">gestaltsam</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">beschaffen</unclear>, <unclear cert="medium" resp="#joint">Ine</unclear> bey <unclear cert="medium" resp="#joint">ewerem</unclear> loblichen <unclear cert="medium" resp="#joint">Stattgebrauch</unclear>,
<lb n="30"/>ordnung unnd <unclear cert="low" resp="#joint">Erbrecht</unclear> verbleiben <unclear cert="medium" resp="#joint">zulassen</unclear>.
<lb n="31"/>Syen <unclear cert="low" resp="#joint">wür</unclear> <unclear cert="medium" resp="#joint">erpiettig</unclear>, nit allein solches umb euch
<lb n="32"/>in <unclear cert="medium" resp="#joint">anderweg</unclear> <unclear cert="medium" resp="#joint">freundt</unclear>: Nachparlichen <unclear cert="low" resp="#joint">zubeschulden</unclear>,
<lb n="33"/><unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">begebenen</unclear> <unclear cert="low" resp="#joint">gegenfahl</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Ewe=</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">rigen</unclear> <unclear cert="low" resp="#joint">Innkhuenfftig</unclear>, allainig nach <unclear cert="low" resp="#joint">unnserer</unclear> Statt
<lb n="35"/>Erbordnung, <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">mitt</unclear> <unclear cert="low" resp="#joint">Eüerthail</unclear>,
<lb n="36"/>gegen selbigen solche <unclear cert="low" resp="#joint">ungeendert</unclear> zehalten, nach
<lb n="37"/><unclear cert="low" resp="#joint">hieigen</unclear> Erbrechten auch <unclear cert="low" resp="#joint">zuuersehen</unclear>, unnd
<lb n="38"/>mit <unclear cert="medium" resp="#joint">Eüch</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">alten</unclear> <unclear cert="medium" resp="#joint">guotten</unclear> Nachparlichen <unclear cert="medium" resp="#joint">bißhero</unclear>
<lb n="39"/><unclear cert="medium" resp="#joint">gepflegnen</unclear> <unclear cert="medium" resp="#joint">willen</unclear> unnd <unclear cert="medium" resp="#joint">verstandt</unclear>, <unclear cert="medium" resp="#joint">fürbas</unclear> <unclear cert="medium" resp="#joint">freundt</unclear>:
<lb n="40"/>Nachparlichen <unclear cert="medium" resp="#joint">fortzepflanzen</unclear>. <unclear cert="medium" resp="#joint">Goettlicher</unclear>
<lb n="41"/>bewarnuß <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">treülich</unclear> <unclear cert="low" resp="#joint">empfelehendt</unclear>.
<lb n="42"/><origDate when="1604-12-04" resp="#ner">Datum <unclear cert="low" resp="#joint">4</unclear>. Decembris anno 1604.</origDate>
<lb n="43"/>Verwalter der <unclear cert="low" resp="#joint">Hauptmanschafft</unclear>
<lb n="44"/><orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Bürgermeister</unclear> unnd Rath der
<lb n="45"/>Statt <unclear cert="low" resp="#joint">Costannz</unclear></orgName>.
<pb facs="StadtASG_Missive_1591_5759.jpg" n="3"/>
<pb facs="StadtASG_Missive_1591_5760.jpg" n="4"/>
<lb n="46"/><unclear cert="low" resp="#joint">Denen</unclear> fürsichtigen, ersamen, weisen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermei</unclear>-
<lb n="47"/><unclear cert="low" resp="#joint">ster</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> rath zuo St. Gallenn</orgName>, unnsernn besonn-
<lb n="48"/>ders liebenn freünt unnd guettenn nachparnn.
</p>
