<lb n="29"/><unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">geübt</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> vil <unclear cert="medium" resp="#joint">künnder</unclear> <unclear cert="medium" resp="#joint">berwenndt</unclear> <unclear cert="medium" resp="#joint">würdt</unclear>,
<lb n="30"/>so ist demnach an E. <unclear cert="medium" resp="#joint">F</unclear>. E. W. <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">freünndt</unclear>-
<lb n="31"/>lich bitt, <unclear cert="medium" resp="#joint">diesälbige</unclear> <unclear cert="medium" resp="#joint">wöllennd</unclear> <unclear cert="medium" resp="#joint">ihne</unclear> <unclear cert="medium" resp="#joint">für</unclear> ihren
<lb n="32"/><unclear cert="medium" resp="#joint">mitbürger</unclear> <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> annemen, <unclear cert="medium" resp="#joint">unnd</unclear> sich geg <unclear cert="medium" resp="#joint">ihme</unclear>
<lb n="33"/>so <unclear cert="medium" resp="#joint">günstig</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">wilfährig</unclear> erzaig, <unclear cert="medium" resp="#joint">damit</unclear> er
<lb n="34"/><unclear cert="medium" resp="#joint">diser</unclear> <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">fürschrifft</unclear> <unclear cert="medium" resp="#joint">wircklich</unclear> <unclear cert="medium" resp="#joint">genossen</unclear> <unclear cert="medium" resp="#joint">zuo</unclear>-
<lb n="35"/>haben <unclear cert="medium" resp="#joint">spüren</unclear> <unclear cert="medium" resp="#joint">möge</unclear>, <unclear cert="medium" resp="#joint">seindt</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">guotter</unclear> hoffnung,
<lb n="36"/>er werde sich <unclear cert="medium" resp="#joint">uffrecht</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> redlich, <unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">ain</unclear> <unclear cert="medium" resp="#joint">jeder</unclear>
<lb n="37"/><unclear cert="medium" resp="#joint">gegen</unclear> seiner <unclear cert="medium" resp="#joint">oberkhait</unclear> <unclear cert="medium" resp="#joint">zuthon</unclear> schuldig, halten <unclear cert="medium" resp="#joint">und</unclear>
<lb n="38"/>erzaig, das <unclear cert="medium" resp="#joint">begernn</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">wölle</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">umb</unclear> E. <unclear cert="medium" resp="#joint">F</unclear>.
<lb n="39"/>E. W. in gleichem <unclear cert="medium" resp="#joint">unnd</unclear> mererm <unclear cert="medium" resp="#joint">ganntz</unclear> <unclear cert="medium" resp="#joint">freünndtlich</unclear>
<lb n="40"/><unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">guottwillig</unclear> verdienen, datum den <origDate when="1565" cert="medium" resp="#ner">23
<lb n="41"/><unclear cert="medium" resp="#joint">9bris</unclear> <unclear cert="medium" resp="#joint">a°</unclear> 65</origDate>.
