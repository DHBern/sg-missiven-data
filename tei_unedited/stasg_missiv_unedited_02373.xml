<lb n="4"/><unclear cert="medium" resp="#joint">Eydtgnossen</unclear>. Wir <unclear cert="low" resp="#joint">werdend</unclear> berichtet, <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">Ihr</unclear> <unclear cert="medium" resp="#joint">fr</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">gn</unclear>. der <persName resp="#ner">Abbt zuo S. Gallen</persName>, <unclear cert="low" resp="#joint">einiche</unclear> <unclear cert="low" resp="#joint">starcke</unclear> anzal <unclear cert="low" resp="#joint">spannisch</unclear>-
<lb n="6"/>en kriegsvolcks den <unclear cert="low" resp="#joint">paß</unclear> gägen <placeName ref="stadtasg-places-225" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rapperschwyl</unclear></placeName> zuo,
<lb n="7"/><unclear cert="low" resp="#joint">vergünstiget</unclear>, und bewilliget habe. <unclear cert="medium" resp="#joint">Wyln</unclear> dann wir
<lb n="8"/>etwas <unclear cert="low" resp="#joint">derglychen</unclear> uß <unclear cert="low" resp="#joint">jüngsten</unclear> <unclear cert="low" resp="#joint">uwerem</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">zuogethonen</unclear>
