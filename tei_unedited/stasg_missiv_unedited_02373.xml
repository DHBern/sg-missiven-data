<lb n="19"/>Sodann <unclear cert="low" resp="#joint">werdent</unclear> Ir <unclear cert="low" resp="#joint">unber</unclear> lieb Eydtgnossen, <unclear cert="medium" resp="#joint">ohnzwif</unclear>-
<lb n="20"/><unclear cert="medium" resp="#joint">enlich</unclear> <unclear cert="medium" resp="#joint">verstendiget</unclear> worden syn, wie <unclear cert="low" resp="#joint">nunmer</unclear> <unclear cert="low" resp="#joint">unbere</unclear>
