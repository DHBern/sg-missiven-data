<lb n="51"/><unclear cert="low" resp="#joint">R</unclear>. <origPlace ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">lindauischen</unclear></origPlace> <origDate when="1617-12-23" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">13/23</unclear>. <unclear cert="low" resp="#joint">Decembris</unclear> <unclear cert="low" resp="#joint">a°</unclear> 1617.</origDate>
<lb n="52"/>Herr Obrister <persName resp="#ner">Morizen v. Kriechingen</persName> volckh
<lb n="53"/>syen 2000. starckh under 10. fhanen, wegen
<lb n="54"/>ein qurtierung also eingeteilt ziehe
<lb n="55"/>2. fhanen 400. zumal nach- und mit ein-
<lb n="56"/><unclear cert="low" resp="#joint">andern</unclear>
<lb n="57"/><date resp="#ner">Den 10/20.</date> seyen sy zu <placeName resp="#ner">Mundelfingen</placeName>
<lb n="58"/>herren <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Füerstenstein</unclear></placeName> gehörig über-
<lb n="59"/><unclear cert="low" resp="#joint">nachtgwesen</unclear>,
<lb n="60"/><date resp="#ner">Den 11/21.</date> <placeName resp="#ner">Leipfertingen</placeName> daselbsten den
<lb n="61"/><unclear cert="low" resp="#joint">12/22</unclear>. <unclear cert="low" resp="#joint">rasttag</unclear> <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">allwegen</unclear>
<lb n="62"/>am <unclear cert="low" resp="#joint">4</unclear>. <unclear cert="low" resp="#joint">tage</unclear>
<lb n="63"/><date resp="#ner">Den 13/23.</date> <placeName resp="#ner">Aach</placeName>.
<lb n="64"/><date resp="#ner">Den 14/24.</date> <placeName resp="#ner">Bndorff</placeName> und <placeName resp="#ner">Neßelwang</placeName> gehn
<lb n="65"/><placeName ref="stadtasg-places-4" cert="medium" resp="#ner">Üeberling</placeName> gehörig
<lb n="66"/><date resp="#ner">Den 15/25.</date> <placeName ref="stadtasg-places-62" cert="medium" resp="#ner">Salmenschweil</placeName> oder <placeName resp="#ner">Marckhdorff</placeName>
<lb n="67"/><date resp="#ner">Den 16/26.</date> <placeName resp="#ner">Weingearten</placeName> und <placeName ref="stadtasg-places-77" cert="medium" resp="#ner">Ravenspurg</placeName>
<pb facs="StadtASG_Missive_2080_7794.jpg" n="6"/>
<lb n="68"/>Den <date resp="#ner">17/27.</date> daselbst rast.
<lb n="69"/>den <date resp="#ner">18/28.</date> <placeName ref="stadtasg-places-244" cert="medium" resp="#ner">Luetkirch</placeName>
<lb n="70"/>Den <date resp="#ner">19/29.</date> <placeName ref="stadtasg-places-40" cert="medium" resp="#ner">Kempten</placeName> und im <orgName ref="stadtasg-actors-593" cert="medium" resp="#ner">Stifft</orgName>.
<lb n="71"/>Den <date resp="#ner">20/30.</date> <placeName resp="#ner">Nesselwang</placeName>.
<lb n="72"/>Und ziehen herr hauptman von <placeName ref="stadtasg-places-448" cert="medium" resp="#ner">Breisach</placeName>
<lb n="73"/>als Comissarius. und ein Quatiermeister
<lb n="74"/>ein halben oder ganzen tag <unclear cert="low" resp="#joint">vorhr</unclear>. .
<lb n="75"/>Ziehen, wans baeßwetter 5. stundt, sust
<lb n="76"/>6. in 7. stundt armirt, Der troß in
<lb n="77"/>8. großen wagen, alwegen <unclear cert="low" resp="#joint">vorher</unclear>,
<lb n="78"/><unclear cert="low" resp="#joint">Idewist</unclear> <unclear cert="low" resp="#joint">Capitany</unclear>, <unclear cert="low" resp="#joint">Leuetenampt</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Fendrich</unclear></persName>
<lb n="79"/>und Lute eingetheilt, alwegen ein Cr.
<lb n="80"/>welchs haben mießten stets forts.
<lb n="81"/>Der durchzug ist <unclear cert="low" resp="#joint">volgender</unclear>
<lb n="82"/><unclear cert="low" resp="#joint">massen</unclear> <unclear cert="low" resp="#joint">angeordnet</unclear>.
<lb n="83"/><persName resp="#ner"><unclear cert="low" resp="#joint">Hr</unclear>. <unclear cert="low" resp="#joint">Obrister</unclear> <unclear cert="low" resp="#joint">Leuetenampt</unclear> <unclear cert="low" resp="#joint">Ungnad</unclear></persName>. <unclear cert="low" resp="#joint">230</unclear>. <unclear cert="low" resp="#joint">1</unclear>.
