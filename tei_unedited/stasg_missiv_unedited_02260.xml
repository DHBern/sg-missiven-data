    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2260_8571.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">An</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Stuttgardt</unclear></placeName>.
<lb n="2"/><unclear cert="low" resp="#joint">Missiv</unclear>, <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">einer</unclear> <unclear cert="low" resp="#joint">krancken</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">allhir</unclear> <unclear cert="low" resp="#joint">verstorbenen</unclear> <unclear cert="low" resp="#joint">Phersohn</unclear>.
<lb n="4"/>Unser <unclear cert="low" resp="#joint">fründtlich</unclear> <unclear cert="low" resp="#joint">willig</unclear> dienst, zuvor
<lb n="5"/>Ersamen, Ehrnvesten, Fuersichtigen, und wysen,
<lb n="6"/>insonders lieben und gueten Fründen.
<lb n="7"/>Vor uns in <unclear cert="low" resp="#joint">versamletem</unclear>, <orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Raht</unclear></orgName>, <unclear cert="low" resp="#joint">ist</unclear> <unclear cert="low" resp="#joint">erschinen</unclear>
<lb n="8"/><persName resp="#ner"><unclear cert="low" resp="#joint">Barbel</unclear> <unclear cert="low" resp="#joint">Kranichin</unclear></persName>, unsers mitburgers <persName resp="#ner">Melchior
<lb n="9"/>Kranichen</persName> (. der libs schwachheit und kranck-
<lb n="10"/>heit selbs nit erschinen koennen) ehelich huß-
<lb n="11"/>frauw, mit bÿstandt, unsers getrauwen
<lb n="12"/>lieben mitrhats <persName resp="#ner">Thomae Zwilchen</persName>, die
<lb n="13"/>hat uns, demuetig und <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">gehorsamb</unclear> mit
<lb n="14"/>sonderm bedauuren und <unclear cert="low" resp="#joint">hertzenleid</unclear>, <unclear cert="low" resp="#joint">zefür</unclear>-
<lb n="15"/>bringen und zuoerkennen geben lassen,
<lb n="16"/><unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">massen</unclear> <unclear cert="low" resp="#joint">sÿ</unclear> von <persName resp="#ner">Hannß <unclear cert="low" resp="#joint">Geörg</unclear> <unclear cert="low" resp="#joint">Kreußten</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Goldtschmidt</unclear></persName> <unclear cert="low" resp="#joint">eren</unclear> <unclear cert="low" resp="#joint">ange</unclear>-
<lb n="18"/><unclear cert="low" resp="#joint">hoerigen</unclear> <unclear cert="low" resp="#joint">Mitburgern</unclear>
<lb n="19"/>durch eignen botten schrifftlich <unclear cert="low" resp="#joint">berichtet</unclear>
<lb n="20"/>worden, was massen ihr <unclear cert="low" resp="#joint">son</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Daniel</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">Kranich</unclear></persName> <unclear cert="low" resp="#joint">daselbst</unclear> <unclear cert="low" resp="#joint">by</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">Kreußten</unclear> <unclear cert="low" resp="#joint">etlich</unclear> <unclear cert="low" resp="#joint">tag</unclear> in <unclear cert="low" resp="#joint">arbeit</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="23"/><unclear cert="low" resp="#joint">standen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">schwere</unclear> <unclear cert="low" resp="#joint">kranck</unclear>-
<lb n="24"/><unclear cert="low" resp="#joint">heit</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">haubt</unclear> <unclear cert="low" resp="#joint">bloedigkeit</unclear> <unclear cert="low" resp="#joint">gerhaten</unclear>, <unclear cert="low" resp="#joint">diewil</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">ansehen</unclear> <unclear cert="low" resp="#joint">gehebt</unclear>, <unclear cert="low" resp="#joint">alß</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">lang</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">verwi</unclear>-
<lb n="28"/><unclear cert="low" resp="#joint">len</unclear> <unclear cert="low" resp="#joint">hette</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">W</unclear>: <unclear cert="low" resp="#joint">wol</unclear>:
<lb n="29"/><unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">sein</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Kroeßten</unclear></persName> <unclear cert="low" resp="#joint">anhalten</unclear>, <unclear cert="low" resp="#joint">ihne</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Kranichen</unclear></persName>
<lb n="30"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">das</unclear> zuo der glichen kranckhnen Phersohnen
<lb n="31"/>verordtnete Huß tragen, und ihme ordenliche
<lb n="32"/>pfleg und warth schaffen lassen, doch
<lb n="33"/>andrer gestalt nit, dann daß besagten
<lb n="34"/>sin gewesnen meister füer die bezahlung
<lb n="35"/>den Jungen <persName resp="#ner">Daniel Kranich</persName>
<lb n="36"/>krancknen Goldtschmidgesell
<lb n="37"/>betrl. 1621.
<pb facs="StadtASG_Missive_2260_8572.jpg" n="2"/>
<lb n="38"/>alles uf <unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">geseübe</unclear>, <unclear cert="low" resp="#joint">uncostens</unclear>, <unclear cert="low" resp="#joint">buwen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">ehrn</unclear> <unclear cert="low" resp="#joint">erhalten</unclear> <unclear cert="low" resp="#joint">muessen</unclear>. <unclear cert="low" resp="#joint">Wora</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">Jhro</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">zuvorderist</unclear> der zuostandt ihres liebe
<lb n="41"/>sohns von herzen leid, wüntschende, daß sie
<lb n="42"/>ihme <unclear cert="low" resp="#joint">in</unclear> ein <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">hilffliche</unclear> <unclear cert="low" resp="#joint">hand</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">bieten</unclear> <unclear cert="low" resp="#joint">koendten</unclear>, <unclear cert="low" resp="#joint">Es</unclear> <unclear cert="low" resp="#joint">seÿe</unclear> aber die beschaffen-
<lb n="44"/>heit ihres <unclear cert="low" resp="#joint">vermoegens</unclear> <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="45"/><unclear cert="low" resp="#joint">wanndt</unclear>, daß ihro und ihrem krannckhen
<lb n="46"/>eheman unmueglich, ihrem sohn, wie gern sie
<lb n="47"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">wolten</unclear>, in disem seinem zuostand, zuo-
<lb n="48"/>hilff zukoemen. Mit gantz demuetigem
<lb n="49"/>bitten, wir wolten ihro nit allein, dißes
<lb n="50"/>ihres zuostandts und <unclear cert="low" resp="#joint">armuethen</unclear>, <unclear cert="low" resp="#joint">zeügkmuß</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">geben</unclear>, <unclear cert="low" resp="#joint">sonderß</unclear> <unclear cert="low" resp="#joint">auch</unclear> an <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ge</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">w</unclear>.
<lb n="52"/>mit unser intercession, gnedig und <unclear cert="low" resp="#joint">guenstig</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">behilfflich</unclear> <unclear cert="low" resp="#joint">sein</unclear>.
<lb n="54"/><unclear cert="low" resp="#joint">Sitenmalen</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">unß</unclear>, der frawen, und ihres
<lb n="55"/><unclear cert="low" resp="#joint">leibherrn</unclear> <unclear cert="low" resp="#joint">manns</unclear>, <unclear cert="low" resp="#joint">beschaffenheit</unclear> <unclear cert="low" resp="#joint">gnuogsam</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">bekanndt</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wir</unclear> ihren <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">sovil</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">weniger</unclear>, <unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">underthenigen</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">bitten</unclear> und begehren <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">zuowider</unclear> sein <unclear cert="low" resp="#joint">woellen</unclear>.
<lb n="59"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">bezeügen</unclear> <unclear cert="low" resp="#joint">wir</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Melcher</unclear></persName>
<lb n="60"/><unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">alter</unclear> <unclear cert="low" resp="#joint">erlebter</unclear> <unclear cert="low" resp="#joint">kranch</unclear> <unclear cert="low" resp="#joint">sein</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Daniel</unclear> <unclear cert="low" resp="#joint">kranche</unclear></persName> vatter jetz
<lb n="61"/>mann vil <unclear cert="low" resp="#joint">jar</unclear> <unclear cert="low" resp="#joint">lang</unclear> seinem handtwerch nit mehr
<lb n="62"/>und <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">nahrung</unclear> <unclear cert="low" resp="#joint">obligen</unclear> <unclear cert="low" resp="#joint">koennen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">heüt</unclear> <unclear cert="low" resp="#joint">beÿ</unclear> <unclear cert="low" resp="#joint">tag</unclear> mit leibs
<lb n="63"/><unclear cert="low" resp="#joint">eroberen</unclear> <unclear cert="low" resp="#joint">schwachheit</unclear> und <unclear cert="low" resp="#joint">kranckheit</unclear> <unclear cert="low" resp="#joint">uebel</unclear> beladen ist,
<lb n="64"/>ingestalten, daß er und sein haußfrawen
<lb n="65"/>sich wie obgemelt, für sich selbs nit wohl
<pb facs="StadtASG_Missive_2260_8573.jpg" n="3"/>
<lb n="66"/><unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">zuvorderst</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">Spital</unclear> <unclear cert="low" resp="#joint">gnad</unclear>, und dan
<lb n="68"/>auch andere guthertzige leüt hilffliche
<lb n="69"/>handreichung theten. Wie wir dan
<lb n="70"/>eben anjetzo auch bij disem ihres sons
<lb n="71"/>leidigen zustandt, uns zum mitleiden
<lb n="72"/>und <unclear cert="low" resp="#joint">barmhertzigkeit</unclear> <unclear cert="low" resp="#joint">bewegen</unclear>
<lb n="73"/>und ihme <unclear cert="low" resp="#joint">aß</unclear> <unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">Soltz</unclear> <unclear cert="low" resp="#joint">hauß</unclear> <unclear cert="low" resp="#joint">armen</unclear>
<lb n="74"/><unclear cert="low" resp="#joint">leüten</unclear> <unclear cert="low" resp="#joint">f</unclear>. 12. kr geben <unclear cert="low" resp="#joint">lassen</unclear>. <unclear cert="low" resp="#joint">Ge</unclear>-
<lb n="75"/><unclear cert="low" resp="#joint">langt</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> an <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">unser</unclear>
<lb n="76"/><unclear cert="low" resp="#joint">freündtlichs</unclear> <unclear cert="low" resp="#joint">gesinnen</unclear>, <unclear cert="low" resp="#joint">ersuochen</unclear> und <unclear cert="low" resp="#joint">bitten</unclear>
<lb n="77"/>die wellen disem unserem schriben
<lb n="78"/>glauben <unclear cert="low" resp="#joint">zustellen</unclear>, <unclear cert="low" resp="#joint">dißes</unclear> <unclear cert="low" resp="#joint">armen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear>
<lb n="79"/><unclear cert="low" resp="#joint">Kölblins</unclear></persName> <unclear cert="low" resp="#joint">zustandt</unclear> <unclear cert="low" resp="#joint">behertzigen</unclear>, und <unclear cert="low" resp="#joint">auß</unclear>
<lb n="80"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">angebornnen</unclear> <unclear cert="low" resp="#joint">miltigkeit</unclear>,
<lb n="81"/>an gedachtem ihrem Soltz ein werkh
<lb n="82"/>der barmhertzigkeit erweisen,
<lb n="83"/>und <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">thochter</unclear> <unclear cert="low" resp="#joint">sonderen</unclear> mit <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="84"/><unclear cert="low" resp="#joint">aß</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">einem</unclear> <unclear cert="low" resp="#joint">Kranken</unclear> <unclear cert="low" resp="#joint">fremdling</unclear> <unclear cert="low" resp="#joint">bestelt</unclear> <unclear cert="low" resp="#joint">ist</unclear>.
<lb n="85"/>das <unclear cert="low" resp="#joint">beste</unclear> <unclear cert="low" resp="#joint">thun</unclear>, <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">Gott</unclear>
<lb n="86"/><unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">gesundheit</unclear>
<lb n="87"/><unclear cert="low" resp="#joint">helfen</unclear> <unclear cert="low" resp="#joint">würdt</unclear>. <unclear cert="low" resp="#joint">Welches</unclear> <unclear cert="low" resp="#joint">ein</unclear>
<lb n="88"/><unclear cert="low" resp="#joint">werkh</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">wirt</unclear> <unclear cert="low" resp="#joint">unbelonet</unclear>
<lb n="89"/><unclear cert="low" resp="#joint">lassen</unclear>, und <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">sindts</unclear>
<lb n="90"/>umb <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">begebenden</unclear>
<lb n="91"/>und die <unclear cert="low" resp="#joint">irigen</unclear>
<lb n="92"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gleichen</unclear> und andern begebenheiten
<lb n="93"/>widerumb zuerkennen erbietig und willig,
<lb n="94"/>und <unclear cert="low" resp="#joint">thuendt</unclear> <unclear cert="low" resp="#joint">uns</unclear> mit <unclear cert="low" resp="#joint">obgedachtem</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear>
<pb facs="StadtASG_Missive_2260_8574.jpg" n="4"/>
<lb n="95"/>ein
<lb n="96"/>Gott den Allmechtigen als belohner aller guet-
<lb n="97"/>thaten, bei mit ihren demuetigen gebett an zue-
<lb n="98"/>rueffen nit uffhoeren, daß er E. E. W.
<lb n="99"/>diß an Ihrem dochter guetthat und barmhertzigkeit
<lb n="100"/>wesen widerumb in ander weg vergelte
<lb n="101"/>in gueten langwirigen gsund-
<lb n="102"/>allen
<lb n="103"/>heit, und wolstandt
<lb n="104"/>erhalten welle. Uns darmit
<lb n="105"/>samtlichen dem schirm des lieben Gottes
<lb n="106"/>wol beuelhende. Geben den <origDate when="1621-03-22" resp="#ner">22 ten
<lb n="107"/>Martij. A. 1621</origDate>.
<lb n="108"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und R. der
<lb n="109"/>Statt St. Gallen.</orgName>
<lb n="110"/>Den Ehrenvesten Fuersichtig Ehrsamen und Weisen
<lb n="111"/><orgName role="recipient" resp="#ner">Burgermeister und Rhaht der Fuerstlichen
<lb n="112"/>Hopt Statt Stutgart</orgName> unsern Insonders
<lb n="113"/>lieben und gueten Freunden.
</p>
