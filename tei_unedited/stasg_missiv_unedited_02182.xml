<lb n="86"/>Mezger</persName>, so dann seiner <unclear cert="low" resp="#joint">haußfrauwen</unclear>
<lb n="87"/><unclear cert="low" resp="#joint">gnuogsamb</unclear> <unclear cert="low" resp="#joint">bemaechtiget</unclear>, <unclear cert="low" resp="#joint">krafft</unclear> <unclear cert="low" resp="#joint">unßerer</unclear>
