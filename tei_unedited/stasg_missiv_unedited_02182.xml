<pb facs="StadtASG_Missive_2182_8190.jpg" n="4"/>
<lb n="44"/>Den fuersichtigen ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger=
<lb n="45"/>meister und Rhat der Statt St. Gallen</orgName>, unsern
<lb n="46"/>besondern lieben gueten freuenden und nachbarn.
<pb facs="StadtASG_Missive_2182_8191.jpg" n="5"/>
<lb n="47"/>Unser freündtlich dienst zuvor Eersambe, Weyse,
<lb n="48"/>Liebe und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">Freündt</unclear>.
<lb n="49"/>Daß Ihr unß das abliben, weÿlandt eüers
<lb n="50"/>burgers <persName resp="#ner">Hannß <unclear cert="low" resp="#joint">Huobers</unclear></persName> <unclear cert="low" resp="#joint">dochter</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Prisca</unclear></persName> <unclear cert="low" resp="#joint">seelig</unclear>,
<lb n="51"/><unclear cert="low" resp="#joint">unsers</unclear> burger <persName resp="#ner"><unclear cert="low" resp="#joint">Sebastian</unclear> <unclear cert="low" resp="#joint">Metzgers</unclear></persName> <unclear cert="low" resp="#joint">verheürathet</unclear>,
<lb n="52"/>zum <unclear cert="low" resp="#joint">besten</unclear> <unclear cert="low" resp="#joint">zuschriben</unclear>, <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">dato</unclear> deß <date resp="#ner">14.</date> nechst
<lb n="53"/>verwichnen monats 9bris zuo wissen gemacht.
<lb n="54"/>Und <unclear cert="low" resp="#joint">nebet</unclear> <unclear cert="low" resp="#joint">überschickhung</unclear> <unclear cert="low" resp="#joint">inventarij</unclear> <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">vermachens</unclear> <unclear cert="low" resp="#joint">brieffs</unclear>, <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">zeith</unclear>, monats ihme
<lb n="56"/>bestimbt, dessen thuen wir unß freündtlich
<lb n="57"/>bedankhen, habend verwagts, nicht un-
<lb n="58"/>derlassen, gedachtem unserm burger,
<lb n="59"/>zuo <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">wahren</unclear> <unclear cert="low" resp="#joint">nachrichtung</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">schri</unclear>-
