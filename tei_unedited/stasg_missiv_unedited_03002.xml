<lb n="33"/><unclear cert="low" resp="#joint">Abgesanten</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">Jrem</unclear> <unclear cert="low" resp="#joint">muendtlichen</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">wolveredten</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">wirt</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">gnaedig</unclear> <unclear cert="low" resp="#joint">Ju</unclear> <unclear cert="low" resp="#joint">vernemen</unclear>.
<pb facs="StadtASG_Missive_3002_11816.jpg" n="2"/>
<lb n="36"/>woln E. Gdl. hieben beyneb
<lb n="37"/>mit trewen mundigen erhalte,
<lb n="38"/>dero Himehl goettlichß protection
<lb n="39"/>wolbefohlen. Datum den <origDate when="1634-04-04" resp="#ner">17 4.
<lb n="40"/>Aprilis ao 1634</origDate>.
<lb n="41"/><origPlace ref="stadtasg-places-112" cert="medium" resp="#ner">Straßb</origPlace>
<lb n="42"/>f. Excellem
<lb n="43"/>dienstwilligsten
<lb n="44"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister ud Raht
<lb n="45"/>der Statt Snt Gallen</orgName>.
<lb n="46"/>Dem Hoch- und wolgebornen Herren, H. <persName role="recipient" resp="#ner">Heinrichen</persName>,
<lb n="47"/>deß H. Roem. Reichß Erbtruckseßen, Graven
<lb n="48"/>zu <placeName resp="#ner">Wolfegg</placeName>, und freyherren zu <placeName ref="stadtasg-places-107" cert="medium" resp="#ner">Walpurg</placeName>, Herren
<lb n="49"/>zu <placeName resp="#ner">Waldsee</placeName>, <placeName resp="#ner">Zihl</placeName>, und <placeName resp="#ner">Marstetten</placeName>, Roem. Kaiß. Mt.
<lb n="50"/>Raht. Unserm gnedigen Herren.
