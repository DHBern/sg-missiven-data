<lb n="8"/><unclear cert="low" resp="#joint">secretarij</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Doct</unclear>: <unclear cert="low" resp="#joint">Waibels</unclear></persName>
<lb n="9"/><unclear cert="low" resp="#joint">gethanem</unclear> <unclear cert="low" resp="#joint">muendtlichem</unclear> <unclear cert="low" resp="#joint">fuer</unclear>-
