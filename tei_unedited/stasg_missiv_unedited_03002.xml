<lb n="16"/>ein <unclear cert="medium" resp="#joint">behußung</unclear> und wohnung uff
<lb n="17"/>ein <unclear cert="low" resp="#joint">Jeitlang</unclear> <unclear cert="low" resp="#joint">Jubevilgen</unclear>.
<lb n="18"/><unclear cert="low" resp="#joint">Wan</unclear> dann <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Gr</unclear>: <unclear cert="low" resp="#joint">Excell</unclear>:, als <unclear cert="low" resp="#joint">deren</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">Jeziger</unclear> <unclear cert="low" resp="#joint">Juostandt</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">Juvorderst</unclear> <unclear cert="low" resp="#joint">von</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">herzen</unclear> <unclear cert="low" resp="#joint">leidt</unclear>, wir <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">muegliche</unclear>
