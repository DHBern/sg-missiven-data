<p>
<pb facs="StadtASG_Missive_1968_7315.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündt</unclear>-, <unclear cert="low" resp="#joint">nachbarlich</unclear> willig dienst und was wir ehren,
<lb n="2"/>liebs und guots <unclear cert="medium" resp="#joint">vermoegend</unclear> zuovor, frommen, fürsichtigen, ehr-
<lb n="3"/><unclear cert="medium" resp="#joint">samen</unclear> und weisen, <unclear cert="medium" resp="#joint">insonders</unclear> guoten <unclear cert="medium" resp="#joint">freünden</unclear>, und ge-
<lb n="4"/><unclear cert="medium" resp="#joint">treüwen</unclear> lieben <unclear cert="medium" resp="#joint">nachbarn</unclear>.
<lb n="5"/>Eüwer <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">uns</unclear>, wegen <unclear cert="medium" resp="#joint">weiland</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Chrystian</unclear> <unclear cert="medium" resp="#joint">Huijpolts</unclear></persName>
<lb n="6"/>seligen <unclear cert="medium" resp="#joint">hinderlaßnen</unclear> <unclear cert="medium" resp="#joint">sohns</unclear>, abgangen schreiben, haben
<lb n="7"/>wir <unclear cert="medium" resp="#joint">innhalts</unclear> <unclear cert="medium" resp="#joint">verstanden</unclear>, <unclear cert="medium" resp="#joint">fuegen</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> darauf in
<lb n="8"/><unclear cert="low" resp="#joint">antwurt</unclear> <unclear cert="low" resp="#joint">freündt</unclear>-, <unclear cert="low" resp="#joint">nachbarlich</unclear> <unclear cert="low" resp="#joint">zuovernemmen</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">daß</unclear> wir <unclear cert="medium" resp="#joint">beij</unclear> <unclear cert="medium" resp="#joint">uns</unclear>, die <unclear cert="medium" resp="#joint">vatter</unclear>- und <unclear cert="low" resp="#joint">gueterlosen</unclear> <unclear cert="low" resp="#joint">erarmete</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">wiewol</unclear> <unclear cert="low" resp="#joint">diser</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Huipolt</unclear></persName>,
<lb n="11"/><unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">wüssens</unclear>, <unclear cert="low" resp="#joint">keine</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">verwandte</unclear> <unclear cert="low" resp="#joint">mehr</unclear> <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">hat</unclear>.
<lb n="13"/><unclear cert="low" resp="#joint">sofeern</unclear> <unclear cert="low" resp="#joint">sij</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">burgeren</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">sind</unclear>.
<lb n="15"/><unclear cert="low" resp="#joint">kinder</unclear>, <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">befreündten</unclear> und verwandten auf den
<lb n="16"/><unclear cert="medium" resp="#joint">hals</unclear> <unclear cert="medium" resp="#joint">zuolegen</unclear>, <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">brauch</unclear> haben, <unclear cert="low" resp="#joint">sonder</unclear> wir pflegen
<lb n="17"/><unclear cert="medium" resp="#joint">dieselben</unclear> <unclear cert="medium" resp="#joint">in</unclear> unserm spital <unclear cert="low" resp="#joint">uferziehen</unclear> <unclear cert="low" resp="#joint">zuolassen</unclear>.
<lb n="18"/><unclear cert="low" resp="#joint">Ob</unclear> <unclear cert="low" resp="#joint">nun</unclear> gleichwol <unclear cert="medium" resp="#joint">gemeldter</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Chrijstian</unclear> <unclear cert="medium" resp="#joint">Huijpolt</unclear></persName> ein zeit-
<lb n="19"/>lang unser burger gewesen, so <unclear cert="medium" resp="#joint">hat</unclear> er aber jedoch
<lb n="20"/>sich <unclear cert="medium" resp="#joint">der</unclear> gestalt verhalten, <unclear cert="medium" resp="#joint">daß</unclear> er diß sein <unclear cert="medium" resp="#joint">beij</unclear> <unclear cert="medium" resp="#joint">uns</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">gehabtes</unclear> burgerrecht <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">langem</unclear>, und <unclear cert="medium" resp="#joint">ehemalen</unclear> diser
<lb n="22"/><unclear cert="medium" resp="#joint">knab</unclear> an die welt <unclear cert="medium" resp="#joint">kommen</unclear>, <unclear cert="medium" resp="#joint">verwürckt</unclear> und <unclear cert="medium" resp="#joint">verlohren</unclear>,
<lb n="23"/>und also wir <unclear cert="medium" resp="#joint">weder</unclear> <unclear cert="medium" resp="#joint">ihne</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Huijpolt</unclear></persName> noch die seinige,
<lb n="24"/>von <unclear cert="medium" resp="#joint">vilen</unclear> <unclear cert="medium" resp="#joint">jaren</unclear> <unclear cert="medium" resp="#joint">her</unclear>, für <unclear cert="medium" resp="#joint">unsere</unclear> burger nit <unclear cert="medium" resp="#joint">mehr</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">erkennt</unclear> noch gehalten haben, wie dann <unclear cert="low" resp="#joint">erscheint</unclear>,
<lb n="26"/>daß er auch vil jar lang keinen burgerlichen <unclear cert="medium" resp="#joint">sitz</unclear>
<lb n="27"/>noch <unclear cert="medium" resp="#joint">haußhaltung</unclear> <unclear cert="medium" resp="#joint">beij</unclear> <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">nit</unclear> mehr gehabt hat.
<lb n="28"/>Und <unclear cert="medium" resp="#joint">dieweil</unclear> <unclear cert="medium" resp="#joint">dann</unclear> <unclear cert="medium" resp="#joint">dem</unclear> also, so <unclear cert="medium" resp="#joint">koennen</unclear> wir <unclear cert="medium" resp="#joint">uns</unclear>
<lb n="29"/>dises <unclear cert="medium" resp="#joint">knabens</unclear>, als der <unclear cert="medium" resp="#joint">uns</unclear> mit burgerrecht nit zuo-
<lb n="30"/>gethon noch <unclear cert="low" resp="#joint">verwandt</unclear> <unclear cert="low" resp="#joint">ist</unclear>, <unclear cert="low" resp="#joint">bagerter</unclear> gestalt nit <unclear cert="medium" resp="#joint">annemmen</unclear>.
<lb n="31"/>Wir haben <unclear cert="medium" resp="#joint">ihme</unclear> aber <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">erbärmbd</unclear> . <unclear cert="low" resp="#joint">2</unclear> . <unclear cert="low" resp="#joint">gldj</unclear> zuo
<lb n="32"/>einem <unclear cert="medium" resp="#joint">zehrpfenning</unclear> <unclear cert="medium" resp="#joint">verehren</unclear> lassen.
<lb n="33"/><unclear cert="medium" resp="#joint">Wolten</unclear> wir <unclear cert="medium" resp="#joint">eüch</unclear>, <unclear cert="medium" resp="#joint">denen</unclear> wir zuo <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">guoter</unclear> <unclear cert="low" resp="#joint">nach</unclear>-
<lb n="34"/><unclear cert="low" resp="#joint">barschafft</unclear> wol <unclear cert="low" resp="#joint">gemeint</unclear> <unclear cert="low" resp="#joint">verbleiben</unclear>, <unclear cert="low" resp="#joint">antwurtlich</unclear>
<lb n="35"/>nit <unclear cert="medium" resp="#joint">verhalten</unclear>. <unclear cert="medium" resp="#joint">Gottes</unclear> <unclear cert="medium" resp="#joint">obhalt</unclear> <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">damit</unclear> <unclear cert="medium" resp="#joint">zuomal</unclear>
<lb n="36"/>wol <unclear cert="medium" resp="#joint">befelhende</unclear>. <unclear cert="medium" resp="#joint">Datl</unclear> <origDate when="1615-09-18" resp="#ner">den . <unclear cert="low" resp="#joint">18</unclear> . <unclear cert="low" resp="#joint">Septembr</unclear>: <unclear cert="low" resp="#joint">1615</unclear> .</origDate>
<lb n="37"/><orgName ref="stadtasg-actors-718" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">An</unclear> <unclear cert="low" resp="#joint">schultheiß</unclear> und <unclear cert="medium" resp="#joint">raht</unclear> zuo Winterthur</orgName>.
