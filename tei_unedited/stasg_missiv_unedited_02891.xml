<lb n="76"/>die commission durch <unclear cert="low" resp="#joint">dasselbe</unclear> <unclear cert="low" resp="#joint">aufgehebt</unclear> <unclear cert="low" resp="#joint">sein</unclear>) <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">untuechtig</unclear>
<lb n="77"/><unclear cert="low" resp="#joint">verworffen</unclear>, <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">erwegung</unclear> sie bey <unclear cert="low" resp="#joint">derselben</unclear> ihr notturfft
<lb n="78"/>(dahin ihr <unclear cert="low" resp="#joint">begihr</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">verstaeudtnuß</unclear> <unclear cert="low" resp="#joint">meines</unclear> <unclear cert="low" resp="#joint">stueckleins</unclear>
<lb n="79"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">gehoerig</unclear>) bey derselben wol vorbringen werden koennen,
<lb n="80"/>ebenfuehrs dieselbe commission ratificiert, unnd newe
<lb n="81"/>gnedigste beuelch gegeben, dieselbe <unclear cert="low" resp="#joint">vortzuestellen</unclear>.
<lb n="82"/>Ich will auch <unclear cert="low" resp="#joint">unnderthaenig</unclear> nit verhalten, daß mein
