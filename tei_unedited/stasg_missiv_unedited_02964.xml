<lb n="2"/><unclear cert="medium" resp="#joint">zuovor</unclear>. Fromm <unclear cert="medium" resp="#joint">Füersichtig</unclear>, <unclear cert="medium" resp="#joint">Ehrsamm</unclear> wyß, Innsonders guot <unclear cert="medium" resp="#joint">freünd</unclear>, und <unclear cert="medium" resp="#joint">getreüw</unclear>
<lb n="3"/>Lieb <orgName role="recipient" resp="#ner">Eydtgnossen</orgName>.
