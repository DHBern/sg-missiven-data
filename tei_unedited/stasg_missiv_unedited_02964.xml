<lb n="5"/>malen <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Costantz</placeName> sich <unclear cert="medium" resp="#joint">enthalten</unclear> <unclear cert="medium" resp="#joint">thuot</unclear>, <unclear cert="medium" resp="#joint">uns</unclear> durch schryben <unclear cert="medium" resp="#joint">ersuocht</unclear>, <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">paß</unclear>:
