<p>
<pb facs="StadtASG_Missive_1620_5887.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründtlich</unclear> <unclear cert="medium" resp="#joint">willig</unclear> <unclear cert="medium" resp="#joint">dienst</unclear>, sambt was wir liebs
<lb n="2"/>und <unclear cert="low" resp="#joint">guets</unclear> <unclear cert="low" resp="#joint">vermögen</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">from</unclear>, <unclear cert="low" resp="#joint">ersam</unclear>, <unclear cert="low" resp="#joint">fürnem</unclear>, <unclear cert="low" resp="#joint">wys</unclear>, in-
<lb n="3"/>sonders <unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">fründt</unclear>, und <unclear cert="medium" resp="#joint">getrüw</unclear> lieb <unclear cert="medium" resp="#joint">eydtgnossen</unclear>.
<lb n="4"/>Was <unclear cert="medium" resp="#joint">uns</unclear> unser burger, <persName resp="#ner">Jonas <unclear cert="medium" resp="#joint">Schuowürker</unclear></persName>, wegen
<lb n="5"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Jacob</unclear> <unclear cert="medium" resp="#joint">Altherr</unclear></persName>, <unclear cert="medium" resp="#joint">eüwers</unclear> <unclear cert="medium" resp="#joint">gewesnen</unclear> stipendiaten <unclear cert="low" resp="#joint">under</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">thenig</unclear> <unclear cert="low" resp="#joint">gebetten</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">Ihr</unclear> auß <unclear cert="medium" resp="#joint">eingeschlossener</unclear>
<lb n="7"/>seiner supplication ablesendt <unclear cert="low" resp="#joint">fründt</unclear> <unclear cert="low" resp="#joint">eydtgnossisch</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">zeuernemmen</unclear>.
<lb n="9"/><unclear cert="low" resp="#joint">Wan</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">vast</unclear> billich, das er der <unclear cert="low" resp="#joint">laube</unclear> <unclear cert="low" resp="#joint">seiner</unclear>, <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">melten</unclear> <unclear cert="low" resp="#joint">eüwern</unclear> <unclear cert="low" resp="#joint">innhonern</unclear> <unclear cert="low" resp="#joint">eingewilligeten</unclear> bürgschafft
<lb n="11"/>widerumb entlediget, und des für ihne <unclear cert="medium" resp="#joint">außegewechßleten</unclear>
<lb n="12"/>gelts (welches alles <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">seines</unclear> leibs <unclear cert="medium" resp="#joint">verwendet</unclear>) <unclear cert="medium" resp="#joint">wi</unclear>-
<lb n="13"/><unclear cert="medium" resp="#joint">derumben</unclear> <unclear cert="medium" resp="#joint">danckhbarlichen</unclear> bezallt werde.
<lb n="14"/><unclear cert="medium" resp="#joint">Alß</unclear> <unclear cert="medium" resp="#joint">versehen</unclear> wir <unclear cert="low" resp="#joint">uns</unclear>: <unclear cert="low" resp="#joint">Inmaßen</unclear> <unclear cert="low" resp="#joint">wir</unclear> Eüch <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">hiemit</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">fründt</unclear>: <unclear cert="low" resp="#joint">eydtgnossisch</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear>: <unclear cert="low" resp="#joint">Ihr</unclear> in <unclear cert="medium" resp="#joint">bedenckhen</unclear> der
<lb n="16"/>sachen <unclear cert="medium" resp="#joint">billichkheit</unclear>, <unclear cert="medium" resp="#joint">bemelten</unclear> <unclear cert="medium" resp="#joint">Unßern</unclear> <unclear cert="medium" resp="#joint">obrigkheitliche</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">hilffshandt</unclear> <unclear cert="medium" resp="#joint">bietten</unclear> wöllen, damit er, <unclear cert="medium" resp="#joint">wie</unclear> auch
<lb n="18"/>übrige <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">burger</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">sin</unclear> <unclear cert="medium" resp="#joint">Althers</unclear> <unclear cert="medium" resp="#joint">schuldtgläubigere</unclear>,
<lb n="19"/>ohne <unclear cert="medium" resp="#joint">verlengern</unclear> befridiget, und <unclear cert="medium" resp="#joint">also</unclear> <unclear cert="medium" resp="#joint">unßer</unclear> <unclear cert="medium" resp="#joint">auß</unclear> der
<lb n="20"/>gefahr <unclear cert="medium" resp="#joint">angeregter</unclear> verbürgung, <unclear cert="medium" resp="#joint">frey</unclear> werde.
<lb n="21"/><unclear cert="medium" resp="#joint">Zu</unclear> dem <unclear cert="medium" resp="#joint">rest</unclear> <unclear cert="medium" resp="#joint">hierdurch</unclear> die <unclear cert="medium" resp="#joint">gebür</unclear> <unclear cert="medium" resp="#joint">erstattet</unclear> <unclear cert="medium" resp="#joint">würdet</unclear>, <unclear cert="medium" resp="#joint">sind</unclear>
<lb n="22"/>wir <unclear cert="low" resp="#joint">daßelbsten</unclear> <unclear cert="low" resp="#joint">auf</unclear> begebenheit <unclear cert="low" resp="#joint">fründt</unclear>: <unclear cert="low" resp="#joint">eydtgnossisch</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">zebeschulden</unclear> <unclear cert="low" resp="#joint">erbiettig</unclear>. d <origDate when="1608-09-03" resp="#ner"><unclear cert="medium" resp="#joint">3</unclear>. Sept. ao <unclear cert="low" resp="#joint">1608</unclear></origDate>.
<lb n="24"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Remigius</unclear> <unclear cert="low" resp="#joint">Fäsch</unclear></persName> <orgName ref="stadtasg-actors-530" cert="medium" role="issuer" resp="#ner">burgermeister,
<lb n="25"/>und rhat der stat <unclear cert="medium" resp="#joint">Baßell</unclear></orgName>.
<pb facs="StadtASG_Missive_1620_5888.jpg" n="2"/>
<pb facs="StadtASG_Missive_1620_5889.jpg" n="3"/>
<pb facs="StadtASG_Missive_1620_5890.jpg" n="4"/>
<lb n="26"/>Den fromen, ehrsamen weysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Bur-
<lb n="27"/>germeister und Rhat der statt St.
<lb n="28"/>Gallen</orgName>, unsern insonders guotten frün-
<lb n="29"/>den, und <unclear cert="medium" resp="#joint">getrüwen</unclear> lieben Eidgnoßen.
</p>
