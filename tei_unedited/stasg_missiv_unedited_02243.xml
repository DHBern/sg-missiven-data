    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2243_8485.jpg" n="1"/>
<pb facs="StadtASG_Missive_2243_8486.jpg" n="2"/>
<pb facs="StadtASG_Missive_2243_8487.jpg" n="3"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freündt</unclear>, <unclear cert="medium" resp="#joint">nachbarliche</unclear> <unclear cert="medium" resp="#joint">willige</unclear> <unclear cert="medium" resp="#joint">dienest</unclear>,
<lb n="2"/>zuvor, <unclear cert="medium" resp="#joint">Edler</unclear>, <unclear cert="medium" resp="#joint">Gestrenger</unclear>, <unclear cert="medium" resp="#joint">Vester</unclear> und
<lb n="3"/><unclear cert="medium" resp="#joint">Weiser</unclear>, insonders lieber herr <unclear cert="medium" resp="#joint">Landtvogt</unclear>,
<lb n="4"/><unclear cert="medium" resp="#joint">gueter</unclear> freündt und Nachbar.
<lb n="5"/>Daß der herr <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">den</unclear> <date resp="#ner"><unclear cert="medium" resp="#joint">6</unclear> <unclear cert="medium" resp="#joint">ten</unclear> <unclear cert="medium" resp="#joint">octobris</unclear></date>
<lb n="6"/><unclear cert="medium" resp="#joint">jüngsthin</unclear>, an <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">abgangen</unclear> <unclear cert="low" resp="#joint">ersuechschreiben</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">Sachen</unclear> sich <unclear cert="low" resp="#joint">haltendt</unclear> <unclear cert="low" resp="#joint">Entzwüschet</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">Spittals</unclear> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">Nidern</unclear> <unclear cert="low" resp="#joint">Gerichtßknechte</unclear>,
<lb n="9"/><persName resp="#ner"><unclear cert="low" resp="#joint">Lorenzen</unclear> <unclear cert="low" resp="#joint">Hannß</unclear> <unclear cert="low" resp="#joint">Jacoben</unclear> von <unclear cert="medium" resp="#joint">Allmenßberg</unclear></persName>,
<lb n="10"/>und <persName resp="#ner"><unclear cert="medium" resp="#joint">Jacob</unclear> <unclear cert="medium" resp="#joint">Schlatteren</unclear> von <unclear cert="medium" resp="#joint">Bürstenmüli</unclear></persName>,
<lb n="11"/>nicht allein <unclear cert="low" resp="#joint">erstgedachten</unclear> <unclear cert="low" resp="#joint">Schlatter</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">oberkeitßhalber</unclear> und bey <unclear cert="medium" resp="#joint">hoher</unclear> <unclear cert="medium" resp="#joint">straaf</unclear>
<lb n="13"/>dahin <unclear cert="medium" resp="#joint">gewisen</unclear>, daß er <unclear cert="medium" resp="#joint">seinem</unclear> ge=
<lb n="14"/><unclear cert="medium" resp="#joint">thanen</unclear> <unclear cert="medium" resp="#joint">glübd</unclear> statt und <unclear cert="medium" resp="#joint">volcziehung</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">thueye</unclear>, und <unclear cert="low" resp="#joint">seins</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">Statt</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">begangnen</unclear> <unclear cert="low" resp="#joint">frävels</unclear> <unclear cert="low" resp="#joint">halber</unclear> daß
<lb n="17"/><unclear cert="low" resp="#joint">Recht</unclear> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">gebuerendermaaßen</unclear> <unclear cert="low" resp="#joint">uß=</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">uebe</unclear>; <unclear cert="low" resp="#joint">sonder</unclear> auch demnach
<lb n="19"/><unclear cert="low" resp="#joint">us</unclear> <unclear cert="low" resp="#joint">wol=</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">meinender</unclear> gegen <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">tragender</unclear> affection
<lb n="21"/>und <unclear cert="medium" resp="#joint">pflanczender</unclear> guetter Nachbar=
<lb n="22"/><unclear cert="medium" resp="#joint">schaft</unclear> verwilliget, daß <unclear cert="low" resp="#joint">ermelter</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">Schlatter</unclear> <unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">vermainte</unclear> <unclear cert="low" resp="#joint">kundtschaft</unclear>
<lb n="24"/>auch <unclear cert="low" resp="#joint">allhero</unclear> <unclear cert="low" resp="#joint">fueren</unclear>, und <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">ehr</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">stelle</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">dieselbe</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">nit</unclear>, <unclear cert="low" resp="#joint">nichts</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">destoweniger</unclear> <unclear cert="low" resp="#joint">klagendem</unclear> theil sein
<lb n="27"/><unclear cert="medium" resp="#joint">endtlich</unclear> <unclear cert="medium" resp="#joint">Recht</unclear> ertheilt <unclear cert="medium" resp="#joint">wden</unclear> solle.
<lb n="28"/>solches <unclear cert="medium" resp="#joint">alles</unclear> haben wir mit <unclear cert="low" resp="#joint">sonderem</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">belieben</unclear> <unclear cert="low" resp="#joint">vernommen</unclear>.
<pb facs="StadtASG_Missive_2243_8488.jpg" n="4"/>
<lb n="30"/>Obwohlen wir nun <unclear cert="low" resp="#joint">hievuff</unclear> <unclear cert="low" resp="#joint">verhofft</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">solte</unclear> <unclear cert="low" resp="#joint">hievuff</unclear> <unclear cert="low" resp="#joint">mehrermelte</unclear>
<lb n="32"/><persName resp="#ner"><unclear cert="low" resp="#joint">Schlatter</unclear></persName>, <unclear cert="low" resp="#joint">sowohl</unclear> den herren alß
<lb n="33"/>auch unß hyeinnen vß schuldi-
<lb n="34"/>gistem respect, den ufferlegten ober-
<lb n="35"/>keitlichen bevelchen allen treüwen
<lb n="36"/>und gebürenden gehorsamen volg
<lb n="37"/>und statt thun haben. So
<lb n="38"/>habendt wir aber mit nicht <unclear cert="low" resp="#joint">geringen</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">unßerm</unclear> <unclear cert="low" resp="#joint">betauren</unclear> <unclear cert="low" resp="#joint">vernohmen</unclear>, <unclear cert="low" resp="#joint">mußten</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">deßselben</unclear> <unclear cert="low" resp="#joint">trauirige</unclear> <unclear cert="low" resp="#joint">mann</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">claglibell</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">vßsage</unclear>, <unclear cert="low" resp="#joint">sovil</unclear> <unclear cert="low" resp="#joint">erlangen</unclear>, daß
<lb n="43"/><unclear cert="low" resp="#joint">uber</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">obangedeüt</unclear> <unclear cert="low" resp="#joint">ernsthafft</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">schreiben</unclear>, und <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">hieruff</unclear>
<lb n="45"/>ertheilten vrkhundt, ihme nichts desto-
<lb n="46"/>weniger sein <unclear cert="low" resp="#joint">haab</unclear> und <unclear cert="low" resp="#joint">guet</unclear> zu
<lb n="47"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Sommerenfeldt</unclear></placeName> <unclear cert="low" resp="#joint">verpütirt</unclear>, <unclear cert="low" resp="#joint">sonderen</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">zehingelzinß</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">er</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">usßem</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">spithallhie</unclear> <unclear cert="low" resp="#joint">erkaufften</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">pfrundtel</unclear>, <unclear cert="low" resp="#joint">zubetüren</unclear> <unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">solle</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">selben</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">mehrers</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">straffen</unclear>.
<lb n="52"/><unclear cert="low" resp="#joint">Dieweil</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">deßselben</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">spithals</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">amman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Georg</unclear> <unclear cert="low" resp="#joint">Stachelin</unclear></persName>, <unclear cert="low" resp="#joint">beneben</unclear> <unclear cert="low" resp="#joint">andern</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">mitburgern</unclear>, <unclear cert="low" resp="#joint">vor</unclear> unß <unclear cert="low" resp="#joint">erschienen</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear> <unclear cert="low" resp="#joint">ihro</unclear> <unclear cert="low" resp="#joint">unschuldt</unclear>, <unclear cert="low" resp="#joint">auch</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">bißhero</unclear> <unclear cert="low" resp="#joint">zwüschet</unclear> <unclear cert="low" resp="#joint">unßer</unclear>
<lb n="57"/>statt und dem gleich <placeName resp="#ner">Allmensperg</placeName>
<lb n="58"/>in solchen fällen <unclear cert="low" resp="#joint">gebrauchigworden</unclear>,
<lb n="59"/><unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">allein</unclear> umb schirm und <unclear cert="low" resp="#joint">vrkhundt</unclear>
<lb n="60"/>sonder auch umb <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">intercession</unclear>
<pb facs="StadtASG_Missive_2243_8489.jpg" n="5"/>
<lb n="61"/>zuo fuerschrifft, daß sy die ange-
<lb n="62"/>tuewete straaff, in die wir
<lb n="63"/>auß altem herkhommen, (wie es wohl bewußt)
<lb n="64"/>nit allein
<lb n="65"/>auss nachparlicher guotter corre-
<lb n="66"/>spondentz unß umb unser intercession
<lb n="67"/>und fuerschrifft, dero sie fruchtbar-
<lb n="68"/>lich und wohl zugenießen verhofft,
<lb n="69"/>verfallen sein solten, erlassen werden
<lb n="70"/>moecht, an den herren gantz in-
<lb n="71"/>stendig und dienstfleißig gebetten.
<lb n="72"/>Wann nun wir unß anderst nicht wissen
<lb n="73"/>zuerinnern, dann daß by ewerer,
<lb n="74"/>von etlichen jahren hero zwischen unser
<lb n="75"/>langen geuebter
<lb n="76"/>einem gerueft und herren <placeName resp="#ner">Allmansteg</placeName>
<lb n="77"/>diser brauch gehalten worden, daß
<lb n="78"/>uff solche begebende faell, unsere
<lb n="79"/>burger daselbst zuo dem Allmansteg
<lb n="80"/>und hingegen desselben underthanen
<lb n="81"/>allhie in unserer statt sich in khundt-
<lb n="82"/>schafft gestellt, und niemahls we-
<lb n="83"/>wie dann eben er <persName resp="#ner">Schlaetter</persName> jungst
<lb n="84"/>vor disem ebenmessig uf khundt-
<lb n="85"/>schafft mit ihme alher gemaant
<lb n="86"/>es bescheinen lassen.
<lb n="87"/>der eine noch die andere oberkeit
<lb n="88"/>solches verweigert vilweniger uf
<lb n="89"/>verbott mit dergleichen straaff
<lb n="90"/>angesehen worden. Und daß umb
<lb n="91"/>vil destomehr, weil die under-
<lb n="92"/>thanen deß grichts <placeName resp="#ner">Allmansteg</placeName>,
<lb n="93"/>(wie gemelt,) unß wegen unsers spittals
<lb n="94"/>der nidern grichten halber, so wir
<lb n="95"/>da ligen haben, auß mit geluebdt
<lb n="96"/>in gwisser maaß
<lb n="97"/>und aydt verbunden sindt. Und
<lb n="98"/>dahero weder unß noch den guetten
<lb n="99"/>Leuetli, zuo sinn noch gmuet niemahls
<lb n="100"/>khomen, daß der herr sich deßwg.
<pb facs="StadtASG_Missive_2243_8490.jpg" n="6"/>
<pb facs="StadtASG_Missive_2243_8491.jpg" n="7"/>
<lb n="101"/><unclear cert="low" resp="#joint">entgeltte</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">vilmehr</unclear> <unclear cert="low" resp="#joint">obigen</unclear>
<lb n="102"/><unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">warhafften</unclear> bericht, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">ihrer</unclear>
<lb n="103"/><unclear cert="low" resp="#joint">verantwurttung</unclear> <unclear cert="low" resp="#joint">guetten</unclear> <unclear cert="low" resp="#joint">glauben</unclear> <unclear cert="low" resp="#joint">zu</unclear>-
<lb n="104"/><unclear cert="low" resp="#joint">stellen</unclear>, und sie ihrer unwüßenheit, wie
<lb n="105"/>auch unsern
<lb n="106"/><unclear cert="low" resp="#joint">fürschrifft</unclear> <unclear cert="low" resp="#joint">gűnstig</unclear>
<lb n="107"/><unclear cert="low" resp="#joint">gnießen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, und <unclear cert="low" resp="#joint">hiemitt</unclear>
<lb n="108"/><unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">nachbarlichen</unclear>
<lb n="109"/><unclear cert="low" resp="#joint">anerbieten</unclear> nach sich also gegen
<lb n="110"/>disen <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">ehrlichen</unclear> <unclear cert="low" resp="#joint">burgerlichen</unclear>
<lb n="111"/><unclear cert="low" resp="#joint">eingezognen</unclear> <unclear cert="low" resp="#joint">leüthen</unclear>, <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">großgünstig</unclear>
<lb n="112"/>mit erlaßung der angetröwten
<lb n="113"/>straffe erweiße, daß sie diser
<lb n="114"/>unser ihnen zum besten ertheilter
<lb n="115"/>intercession wolgnos zu haben
<lb n="116"/><unclear cert="low" resp="#joint">empfindtlich</unclear> <unclear cert="low" resp="#joint">verspűren</unclear>, <unclear cert="low" resp="#joint">das</unclear>
<lb n="117"/><unclear cert="low" resp="#joint">auch</unclear>, hiemit die erwünschte
<lb n="118"/>guette nachbarschafft erhalten und
<lb n="119"/><unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">weiter</unclear> <unclear cert="low" resp="#joint">continuirt</unclear> und <unclear cert="low" resp="#joint">wolge</unclear>-
<lb n="120"/><unclear cert="low" resp="#joint">pflanget</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">möge</unclear>. Wie
<lb n="121"/>wir dann zuem herren daß
<lb n="122"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unzwyffeliche</unclear>
<lb n="123"/><unclear cert="low" resp="#joint">vertrauwen</unclear> haben, und <unclear cert="low" resp="#joint">hingegen</unclear>
<lb n="124"/><unclear cert="low" resp="#joint">sonderbahres</unclear> <unclear cert="low" resp="#joint">nachbarliches</unclear> <unclear cert="low" resp="#joint">gfallen</unclear>
<lb n="125"/>so <unclear cert="low" resp="#joint">ihm</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">schoß</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">verschűtten</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="126"/><unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">allein</unclear> wie <unclear cert="low" resp="#joint">beßen</unclear> <unclear cert="low" resp="#joint">außem</unclear> <unclear cert="low" resp="#joint">feer</unclear>
<lb n="127"/><unclear cert="low" resp="#joint">uend</unclear> <unclear cert="low" resp="#joint">unwüßenheit</unclear> <unclear cert="low" resp="#joint">begegnet</unclear>, und <unclear cert="low" resp="#joint">sonder</unclear>
<pb facs="StadtASG_Missive_2243_8492.jpg" n="8"/>
<lb n="128"/>deß anerbietens sindt, solchs widerumben zuebeschulden, so es sich
<lb n="129"/>uf alle zuetragende begebende
<lb n="130"/>es sich zuederzeit, occasionen umb sie freundt-nachbarlich
<lb n="131"/>zuerwiedren, geneigtwillig und
<lb n="132"/>erbuetig. Mit hilff deß
<lb n="133"/>hoechsten deme wir uns sam-
<lb n="134"/>mentlichen inn gnaden schutz,
<lb n="135"/>treuielich bevelhendt, Datum
<lb n="136"/>den <origDate when="1620" resp="#ner">Novembris
<lb n="137"/>A° 1620</origDate>.
<lb n="138"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister u. rhatt
<lb n="139"/>der statt St. Gallen</orgName>.
<lb n="140"/>An <persName role="recipient" resp="#ner">H. Lvogt im Thurgoew</persName> 1620.
<lb n="141"/>betr. <persName resp="#ner">H. Stahelini</persName> u. <persName resp="#ner">Almensperg</persName> und
<lb n="142"/><persName resp="#ner">Jacob Schlatter</persName> u. <persName resp="#ner">Erenspruetz</persName>.
</p>
        </body>
    </text>
