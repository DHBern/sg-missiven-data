        <body>
<p>
<pb facs="StadtASG_Missive_2243_8485.jpg" n="1"/>
<pb facs="StadtASG_Missive_2243_8486.jpg" n="2"/>
<pb facs="StadtASG_Missive_2243_8487.jpg" n="3"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündt</unclear>, <unclear cert="medium" resp="#joint">nachbarliche</unclear> <unclear cert="medium" resp="#joint">willige</unclear> <unclear cert="low" resp="#joint">dienest</unclear>,
<lb n="2"/>zuvor, <unclear cert="medium" resp="#joint">Edler</unclear>, <unclear cert="low" resp="#joint">Gestrenger</unclear>, <unclear cert="medium" resp="#joint">Vester</unclear> und
<lb n="3"/><unclear cert="medium" resp="#joint">Weiser</unclear>, insonders lieber herr <unclear cert="medium" resp="#joint">Landtvogt</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">gueter</unclear> freündt und Nachbar.
<lb n="5"/>Daß der herr <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">unser</unclear> den <date resp="#ner"><unclear cert="medium" resp="#joint">6</unclear> <unclear cert="medium" resp="#joint">ten</unclear> octobris</date>
<lb n="6"/><unclear cert="medium" resp="#joint">jüngsthin</unclear>, an <unclear cert="low" resp="#joint">ihne</unclear> abgangen <unclear cert="low" resp="#joint">ersuechschreiben</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">in</unclear> Sachen sich haltendt <unclear cert="medium" resp="#joint">Entzwüschet</unclear>
<lb n="8"/>unsers Spittals allhie <unclear cert="low" resp="#joint">Nidern</unclear> <unclear cert="low" resp="#joint">Gerichtßknechte</unclear>,
<lb n="9"/><persName resp="#ner"><unclear cert="low" resp="#joint">Lorenzen</unclear> <unclear cert="low" resp="#joint">Hannß</unclear> <unclear cert="low" resp="#joint">Jacoben</unclear> von <unclear cert="low" resp="#joint">Allmenßberg</unclear></persName>,
<lb n="10"/>und <persName resp="#ner">Jacob Schlatteren von <unclear cert="low" resp="#joint">Bürstenmüli</unclear></persName>,
<lb n="11"/>nicht allein <unclear cert="low" resp="#joint">erstgedachten</unclear> Schlatter
<lb n="12"/><unclear cert="low" resp="#joint">oberkeitßhalber</unclear> und bey hoher straaf
<lb n="13"/>dahin <unclear cert="low" resp="#joint">gewisen</unclear>, daß er <unclear cert="medium" resp="#joint">seinem</unclear> ge=
<lb n="14"/><unclear cert="low" resp="#joint">thanen</unclear> <unclear cert="low" resp="#joint">glübd</unclear> statt und <unclear cert="low" resp="#joint">volcziehung</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">thueye</unclear>, und <unclear cert="medium" resp="#joint">seins</unclear> <unclear cert="medium" resp="#joint">inn</unclear> unser Statt
<lb n="16"/>begangnen <unclear cert="medium" resp="#joint">frävels</unclear> halber daß
<lb n="17"/><unclear cert="medium" resp="#joint">Recht</unclear> <unclear cert="medium" resp="#joint">allhie</unclear> <unclear cert="medium" resp="#joint">gebuerendermaaßen</unclear> <unclear cert="medium" resp="#joint">uß=</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">uebe</unclear>; <unclear cert="medium" resp="#joint">sonder</unclear> auch demnach
<lb n="19"/>us wol=
<lb n="20"/><unclear cert="low" resp="#joint">meinender</unclear> gegen <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">tragender</unclear> affection
<lb n="21"/>und <unclear cert="low" resp="#joint">pflanczender</unclear> guetter Nachbar=
<lb n="22"/><unclear cert="low" resp="#joint">schaft</unclear> verwilliget, daß <unclear cert="low" resp="#joint">ermelter</unclear>
<lb n="23"/>Schlatter <unclear cert="medium" resp="#joint">seine</unclear> <unclear cert="medium" resp="#joint">vermainte</unclear> <unclear cert="medium" resp="#joint">kundtschaft</unclear>
<lb n="24"/>auch <unclear cert="medium" resp="#joint">allhero</unclear> <unclear cert="medium" resp="#joint">fueren</unclear>, und <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">ehr</unclear>
<lb n="25"/>er stelle <unclear cert="medium" resp="#joint">nun</unclear> <unclear cert="medium" resp="#joint">dieselbe</unclear> <unclear cert="medium" resp="#joint">od</unclear> <unclear cert="medium" resp="#joint">nit</unclear>, nichts
<lb n="26"/><unclear cert="medium" resp="#joint">destoweniger</unclear> <unclear cert="medium" resp="#joint">klagendem</unclear> theil sein
<lb n="27"/>endtlich <unclear cert="low" resp="#joint">Recht</unclear> ertheilt <unclear cert="low" resp="#joint">wden</unclear> solle.
<lb n="28"/>solches alles haben wir mit <unclear cert="medium" resp="#joint">sonderem</unclear>
<lb n="29"/>belieben <unclear cert="low" resp="#joint">vernommen</unclear>.
<pb facs="StadtASG_Missive_2243_8488.jpg" n="4"/>
<lb n="30"/>Obwohlen wir nun <unclear cert="medium" resp="#joint">hievuff</unclear> <unclear cert="medium" resp="#joint">verhofft</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">eß</unclear> <unclear cert="medium" resp="#joint">solte</unclear> <unclear cert="medium" resp="#joint">hievuff</unclear> <unclear cert="medium" resp="#joint">mehrermelte</unclear>
<lb n="32"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Schlatter</unclear></persName>, <unclear cert="medium" resp="#joint">sowohl</unclear> den herren alß
<lb n="33"/>auch unß hyeinnen vß schuldi-
<lb n="34"/>gistem respect, den ufferlegten ober-
<lb n="35"/>keitlichen bevelchen allen treüwen
<lb n="36"/>und gebürenden gehorsamen <unclear cert="low" resp="#joint">volg</unclear>
<lb n="37"/>und statt thun haben. So
<lb n="38"/>habendt wir aber mit nicht <unclear cert="low" resp="#joint">geringen</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">unßerm</unclear> <unclear cert="low" resp="#joint">betauren</unclear> <unclear cert="low" resp="#joint">vernohmen</unclear>, <unclear cert="low" resp="#joint">mußten</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">deßselben</unclear> <unclear cert="low" resp="#joint">trauirige</unclear> <unclear cert="low" resp="#joint">mann</unclear> <unclear cert="low" resp="#joint">durch</unclear> sein
<lb n="41"/><unclear cert="medium" resp="#joint">claglibell</unclear>
<lb n="42"/><unclear cert="medium" resp="#joint">vßsage</unclear>, <unclear cert="medium" resp="#joint">sovil</unclear> <unclear cert="medium" resp="#joint">erlangen</unclear>, daß
<lb n="43"/>uber <unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">obangedeüt</unclear> <unclear cert="medium" resp="#joint">ernsthafft</unclear>
<lb n="44"/>schreiben, und <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">herren</unclear> hieruff
<lb n="45"/>ertheilten <unclear cert="low" resp="#joint">vrkhundt</unclear>, ihme nichts <unclear cert="low" resp="#joint">desto</unclear>-
<lb n="46"/>weniger sein <unclear cert="low" resp="#joint">haab</unclear> und <unclear cert="low" resp="#joint">guet</unclear> zu
<lb n="47"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Sommerenfeldt</unclear></placeName> <unclear cert="low" resp="#joint">verpütirt</unclear>, <unclear cert="low" resp="#joint">sonderen</unclear>
<lb n="48"/>auch <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">zehingelzinß</unclear>, so er
<lb n="49"/><unclear cert="medium" resp="#joint">usßem</unclear> in <unclear cert="medium" resp="#joint">disem</unclear> <unclear cert="medium" resp="#joint">spithallhie</unclear> <unclear cert="medium" resp="#joint">erkaufften</unclear>
<lb n="50"/><unclear cert="medium" resp="#joint">pfrundtel</unclear>, <unclear cert="medium" resp="#joint">zubetüren</unclear> <unclear cert="medium" resp="#joint">worden</unclear> sein
<lb n="51"/>solle, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">selben</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">mehrers</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">straffen</unclear>.
<lb n="52"/>Dieweil dann <unclear cert="low" resp="#joint">deßselben</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">spithals</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">amman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Georg</unclear> <unclear cert="low" resp="#joint">Stachelin</unclear></persName>, <unclear cert="low" resp="#joint">beneben</unclear> <unclear cert="low" resp="#joint">andern</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">mitburgern</unclear>, <unclear cert="low" resp="#joint">vor</unclear> unß <unclear cert="low" resp="#joint">erschienen</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear> <unclear cert="low" resp="#joint">ihro</unclear> <unclear cert="low" resp="#joint">unschuldt</unclear>, auch
<lb n="56"/><unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">bißhero</unclear> <unclear cert="low" resp="#joint">zwüschet</unclear> <unclear cert="low" resp="#joint">unßer</unclear>
<lb n="57"/>statt und dem gleich <placeName resp="#ner">Allmensperg</placeName>
<lb n="58"/>in solchen fällen <unclear cert="medium" resp="#joint">gebrauchigworden</unclear>,
<lb n="59"/><unclear cert="medium" resp="#joint">nicht</unclear> <unclear cert="medium" resp="#joint">allein</unclear> umb <unclear cert="low" resp="#joint">schirm</unclear> und <unclear cert="medium" resp="#joint">vrkhundt</unclear>
<lb n="60"/>sonder auch umb unser <unclear cert="low" resp="#joint">intercession</unclear>
<pb facs="StadtASG_Missive_2243_8489.jpg" n="5"/>
<lb n="61"/>zuo fuerschrifft, daß sy die ange-
<lb n="62"/>tuewete straaff, in die wir
<lb n="63"/>auß altem herkhommen, (wie es wohl bewußt)
<lb n="64"/>nit allein
<lb n="65"/>auss nachparlicher guotter corre-
<lb n="66"/>spondentz unß umb unser intercession
<lb n="67"/>und fuerschrifft, dero sie fruchtbar-
<lb n="68"/>lich und wohl zugenießen verhofft,
<lb n="69"/>verfallen sein solten, erlassen werden
<lb n="70"/>moecht, an den herren gantz in-
<lb n="71"/>stendig und dienstfleißig gebetten.
<lb n="72"/>Wann nun wir unß anderst nicht wissen
<lb n="73"/>zuerinnern, dann daß by ewerer,
<lb n="74"/>von etlichen jahren hero zwischen unser
<lb n="75"/>langen geuebter
<lb n="76"/>einem gerueft und herren <placeName resp="#ner">Allmansteg</placeName>
<lb n="77"/>diser brauch gehalten worden, daß
<lb n="78"/>uff solche begebende faell, unsere
<lb n="79"/>burger daselbst zuo dem Allmansteg
<lb n="80"/>und hingegen desselben underthanen
<lb n="81"/>allhie in unserer statt sich in khundt-
<lb n="82"/>schafft gestellt, und niemahls we-
<lb n="83"/>wie dann eben er <persName resp="#ner">Schlaetter</persName> jungst
<lb n="84"/>vor disem ebenmessig uf khundt-
<lb n="85"/>schafft mit ihme alher gemaant
<lb n="86"/>es bescheinen lassen.
<lb n="87"/>der eine noch die andere oberkeit
<lb n="88"/>solches verweigert vilweniger uf
<lb n="89"/>verbott mit dergleichen straaff
<lb n="90"/>angesehen worden. Und daß umb
<lb n="91"/>vil destomehr, weil die under-
<lb n="92"/>thanen deß grichts <placeName resp="#ner">Allmansteg</placeName>,
<lb n="93"/>(wie gemelt,) unß wegen unsers spittals
<lb n="94"/>der nidern grichten halber, so wir
<lb n="95"/>da ligen haben, auß mit geluebdt
<lb n="96"/>in gwisser maaß
<lb n="97"/>und aydt verbunden sindt. Und
<lb n="98"/>dahero weder unß noch den guetten
<lb n="99"/>Leuetli, zuo sinn noch gmuet niemahls
<lb n="100"/>khomen, daß der herr sich deßwg.
<pb facs="StadtASG_Missive_2243_8490.jpg" n="6"/>
<pb facs="StadtASG_Missive_2243_8491.jpg" n="7"/>
<lb n="101"/><unclear cert="low" resp="#joint">entgeltte</unclear>, sonder <unclear cert="low" resp="#joint">vilmehr</unclear> <unclear cert="low" resp="#joint">obigen</unclear>
<lb n="102"/><unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">warhafften</unclear> bericht, und <unclear cert="medium" resp="#joint">ihrer</unclear>
<lb n="103"/><unclear cert="medium" resp="#joint">verantwurttung</unclear> <unclear cert="medium" resp="#joint">guetten</unclear> glauben zu-
<lb n="104"/>stellen, und sie <unclear cert="medium" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">unwüßenheit</unclear>, wie
<lb n="105"/>auch unsern
<lb n="106"/><unclear cert="low" resp="#joint">fürschrifft</unclear> <unclear cert="low" resp="#joint">gűnstig</unclear>
<lb n="107"/><unclear cert="low" resp="#joint">gnießen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, und <unclear cert="low" resp="#joint">hiemitt</unclear>
<lb n="108"/><unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">nachbarlichen</unclear>
<lb n="109"/>anerbieten nach sich also gegen
<lb n="110"/>disen <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">ehrlichen</unclear> <unclear cert="low" resp="#joint">burgerlichen</unclear>
<lb n="111"/><unclear cert="low" resp="#joint">eingezognen</unclear> <unclear cert="low" resp="#joint">leüthen</unclear>, <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">großgünstig</unclear>
<lb n="112"/>mit erlaßung der <unclear cert="low" resp="#joint">angetröwten</unclear>
<lb n="113"/><unclear cert="low" resp="#joint">straffe</unclear> <unclear cert="low" resp="#joint">erweiße</unclear>, daß <unclear cert="medium" resp="#joint">sie</unclear> <unclear cert="medium" resp="#joint">diser</unclear>
<lb n="114"/><unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">ihnen</unclear> zum besten <unclear cert="low" resp="#joint">ertheilter</unclear>
<lb n="115"/>intercession wolgnos zu haben
<lb n="116"/><unclear cert="low" resp="#joint">empfindtlich</unclear> <unclear cert="low" resp="#joint">verspűren</unclear>, <unclear cert="low" resp="#joint">das</unclear>
<lb n="117"/><unclear cert="low" resp="#joint">auch</unclear>, hiemit die <unclear cert="low" resp="#joint">erwünschte</unclear>
<lb n="118"/><unclear cert="medium" resp="#joint">guette</unclear> nachbarschafft erhalten und
<lb n="119"/><unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">weiter</unclear> continuirt und wolge-
<lb n="120"/>pflanget werden <unclear cert="low" resp="#joint">möge</unclear>. Wie
<lb n="121"/>wir dann <unclear cert="low" resp="#joint">zuem</unclear> <unclear cert="medium" resp="#joint">herren</unclear> daß
<lb n="122"/>und <unclear cert="low" resp="#joint">unzwyffeliche</unclear>
<lb n="123"/>vertrauwen haben, und hingegen
<lb n="124"/><unclear cert="low" resp="#joint">sonderbahres</unclear> <unclear cert="low" resp="#joint">nachbarliches</unclear> <unclear cert="low" resp="#joint">gfallen</unclear>
<lb n="125"/>so <unclear cert="low" resp="#joint">ihm</unclear> <unclear cert="low" resp="#joint">das</unclear> der <unclear cert="low" resp="#joint">schoß</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">verschűtten</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="126"/><unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">allein</unclear> wie <unclear cert="low" resp="#joint">beßen</unclear> <unclear cert="low" resp="#joint">außem</unclear> <unclear cert="low" resp="#joint">feer</unclear>
<lb n="127"/><unclear cert="low" resp="#joint">uend</unclear> <unclear cert="low" resp="#joint">unwüßenheit</unclear> <unclear cert="low" resp="#joint">begegnet</unclear>, und sonder
<pb facs="StadtASG_Missive_2243_8492.jpg" n="8"/>
<lb n="128"/><unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">anerbietens</unclear> <unclear cert="low" resp="#joint">sindt</unclear>, solchs widerumben <unclear cert="low" resp="#joint">zuebeschulden</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="129"/>uf alle <unclear cert="low" resp="#joint">zuetragende</unclear> <unclear cert="low" resp="#joint">begebende</unclear>
<lb n="130"/><unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">zuederzeit</unclear>, <unclear cert="low" resp="#joint">occasionen</unclear> umb <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">freundt-nachbarlich</unclear>
<lb n="131"/><unclear cert="low" resp="#joint">zuerwiedren</unclear>, <unclear cert="low" resp="#joint">geneigtwillig</unclear> und
<lb n="132"/><unclear cert="low" resp="#joint">erbuetig</unclear>. Mit <unclear cert="low" resp="#joint">hilff</unclear> <unclear cert="low" resp="#joint">deß</unclear>
<lb n="133"/><unclear cert="low" resp="#joint">hoechsten</unclear> <unclear cert="low" resp="#joint">deme</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">sam</unclear>-
<lb n="134"/><unclear cert="low" resp="#joint">mentlichen</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">gnaden</unclear> <unclear cert="low" resp="#joint">schutz</unclear>,
<lb n="135"/><unclear cert="low" resp="#joint">treuielich</unclear> <unclear cert="low" resp="#joint">bevelhendt</unclear>, Datum
<lb n="136"/>den <origDate when="1620" resp="#ner">Novembris
<lb n="137"/><unclear cert="low" resp="#joint">A°</unclear> 1620</origDate>.
<lb n="138"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister u. <unclear cert="low" resp="#joint">rhatt</unclear>
<lb n="139"/>der statt St. Gallen</orgName>.
<lb n="140"/><unclear cert="low" resp="#joint">An</unclear> <persName role="recipient" resp="#ner">H. Lvogt im Thurgoew</persName> 1620.
<lb n="141"/><unclear cert="low" resp="#joint">betr</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">H</unclear>. <unclear cert="low" resp="#joint">Stahelini</unclear></persName> <unclear cert="low" resp="#joint">u</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Almensperg</unclear></persName> und
<lb n="142"/><persName resp="#ner">Jacob Schlatter</persName> u. <persName resp="#ner">Erenspruetz</persName>.
</p>
