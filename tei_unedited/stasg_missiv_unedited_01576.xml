        <body>
<p>
<pb facs="StadtASG_Missive_1576_5699.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich willig <unclear cert="low" resp="#joint">dinst</unclear> und grueß ge-
<lb n="2"/><unclear cert="low" resp="#joint">thruew</unclear> lieb Eydt: und <unclear cert="medium" resp="#joint">Pundtsgnoßen</unclear>, <unclear cert="medium" resp="#joint">uewer</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">zwey</unclear> <unclear cert="medium" resp="#joint">underschidenliche</unclear> den <date resp="#ner"><unclear cert="medium" resp="#joint">25.t</unclear> und <unclear cert="low" resp="#joint">26.st</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">gegenwuertigen</unclear> monats</date>, <unclear cert="medium" resp="#joint">datierte</unclear>, und an uns
<lb n="5"/><unclear cert="low" resp="#joint">ußgangne</unclear>, <unclear cert="low" resp="#joint">sambt</unclear> auch bygelegten an <unclear cert="medium" resp="#joint">eir</unclear> <unclear cert="medium" resp="#joint">Ehrsame</unclear>
<lb n="6"/><orgName resp="#ner"><unclear cert="medium" resp="#joint">Rathsgmeindt</unclear>, <unclear cert="medium" resp="#joint">gmeiner</unclear> <unclear cert="medium" resp="#joint">Dryen</unclear> Pündten</orgName>, ab <unclear cert="medium" resp="#joint">der</unclear>
<lb n="7"/><placeName ref="stadtasg-places-51" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">arowischen</unclear> <unclear cert="medium" resp="#joint">Tagsatzung</unclear></placeName> <unclear cert="medium" resp="#joint">beschechne</unclear> schryben, <unclear cert="low" resp="#joint">inuß</unclear>
<lb n="8"/>mitgetheilter Copy und abschrifft, <unclear cert="low" resp="#joint">habent</unclear> wir
<lb n="9"/>wol empfangen, und <unclear cert="low" resp="#joint">neben</unclear> <unclear cert="low" resp="#joint">anderen</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">uß</unclear> denselbigen, <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">fein</unclear> und <unclear cert="medium" resp="#joint">nothürfftig</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">ersehenn</unclear>, das Ir, <unclear cert="low" resp="#joint">unnsere</unclear> <unclear cert="low" resp="#joint">gethruewe</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">liebe</unclear> Eydt: und <unclear cert="medium" resp="#joint">Pundtsgnoßen</unclear>, <unclear cert="medium" resp="#joint">sampt</unclear>
<lb n="13"/>und <unclear cert="low" resp="#joint">sonders</unclear> Iren <unclear cert="low" resp="#joint">Ihenn</unclear> <unclear cert="low" resp="#joint">bißdahero</unclear> <unclear cert="low" resp="#joint">vilfaltig</unclear>
<lb n="14"/>im <unclear cert="medium" resp="#joint">werck</unclear> <unclear cert="medium" resp="#joint">erzeigten</unclear> <unclear cert="medium" resp="#joint">guethertzigen</unclear> willen,
<lb n="15"/>und <unclear cert="medium" resp="#joint">yfer</unclear>, so sy <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">unsers</unclear> <unclear cert="medium" resp="#joint">geliebten</unclear> be-
<lb n="16"/><unclear cert="medium" resp="#joint">khuemerten</unclear> vatterlandts <unclear cert="medium" resp="#joint">zuestandts</unclear> ver-
<lb n="17"/><unclear cert="low" resp="#joint">beßerung</unclear>, <unclear cert="low" resp="#joint">Ehr</unclear> reputation, und wol <unclear cert="low" resp="#joint">herge</unclear>-
<lb n="18"/>brachten <unclear cert="low" resp="#joint">frygheiten</unclear> erhaltung, <unclear cert="low" resp="#joint">unerbietlich</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">tragendt</unclear>, <unclear cert="low" resp="#joint">immerdar</unclear> <unclear cert="low" resp="#joint">vesten</unclear> und <unclear cert="low" resp="#joint">standthafftig</unclear>
<lb n="20"/>continuierent und <unclear cert="medium" resp="#joint">verharrendt</unclear>. Hier-
<lb n="21"/>umb wir <unclear cert="medium" resp="#joint">Ihenn</unclear> <unclear cert="medium" resp="#joint">nachmalen</unclear> <unclear cert="medium" resp="#joint">hochen</unclear> und flyßig
<lb n="22"/><unclear cert="low" resp="#joint">danck</unclear> sagendt, und <unclear cert="medium" resp="#joint">wuenschend</unclear>, der
<lb n="23"/>liebe Gott, <unclear cert="medium" resp="#joint">wende</unclear> alles <unclear cert="medium" resp="#joint">zue</unclear> seinem Lob
<lb n="24"/>und <unclear cert="medium" resp="#joint">algemeinem</unclear> vatterland zum besten.
<lb n="25"/>Diewyl aber diser <unclear cert="low" resp="#joint">im</unclear> obbemelten schryben,
<lb n="26"/><unclear cert="low" resp="#joint">gefaßter</unclear> <unclear cert="low" resp="#joint">entschluß</unclear> und abscheid, <unclear cert="medium" resp="#joint">denen</unclear> <unclear cert="medium" resp="#joint">zuvo</unclear>-
<lb n="27"/><unclear cert="medium" resp="#joint">ußgangnen</unclear> <unclear cert="medium" resp="#joint">abscheiden</unclear> und <unclear cert="low" resp="#joint">erkantnußen</unclear>,
<lb n="28"/><unclear cert="low" resp="#joint">über</unclear> <unclear cert="low" resp="#joint">disere</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">schwebende</unclear> <unclear cert="low" resp="#joint">verwirte</unclear>
<lb n="29"/>sachen, <unclear cert="medium" resp="#joint">etlicher</unclear> <unclear cert="medium" resp="#joint">maßen</unclear> mutiert, und ver-
<lb n="30"/>enderet <unclear cert="low" resp="#joint">worden</unclear>, so <unclear cert="low" resp="#joint">khönen</unclear> wir <unclear cert="low" resp="#joint">hier</unclear>-
<lb n="31"/>über <unclear cert="low" resp="#joint">khein</unclear> <unclear cert="low" resp="#joint">schließliche</unclear> <unclear cert="low" resp="#joint">antwort</unclear>, <unclear cert="low" resp="#joint">unßers</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">theils</unclear> <unclear cert="low" resp="#joint">erfolgen</unclear>, sonder abschrifften <unclear cert="medium" resp="#joint">der</unclear>-
<lb n="33"/>selbigen schryben, an <unclear cert="medium" resp="#joint">die</unclear> <orgName resp="#ner"><unclear cert="medium" resp="#joint">Ehrs</unclear>: <unclear cert="medium" resp="#joint">Räth</unclear> und
<lb n="34"/><unclear cert="medium" resp="#joint">Gmeinden</unclear>, Gemeiner <unclear cert="low" resp="#joint">Dryen</unclear> Pündten</orgName>,
<lb n="35"/>langen, und <unclear cert="medium" resp="#joint">sy</unclear> alles <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">theilhafftig</unclear> machen
<lb n="36"/><unclear cert="medium" resp="#joint">laßen</unclear>, und <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">angestelte</unclear> zyt, namblich
<lb n="37"/>den <date resp="#ner"><unclear cert="low" resp="#joint">14.t</unclear> <unclear cert="low" resp="#joint">nechstkhuenfftigen</unclear> monats Octobris</date>,
<lb n="38"/>derselbigen meinung und <unclear cert="low" resp="#joint">mehr</unclear>, so ein <unclear cert="medium" resp="#joint">jede</unclear>
<lb n="39"/>Gmeind und <unclear cert="low" resp="#joint">Hochgricht</unclear>, durch iren <unclear cert="low" resp="#joint">Ge</unclear>-
<lb n="40"/><unclear cert="low" resp="#joint">sandten</unclear> inn schrifft, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">einer</unclear> Ehrs: <unclear cert="low" resp="#joint">Gmeind</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">Zuefhire</unclear> <unclear cert="low" resp="#joint">wercklichen</unclear>, <unclear cert="low" resp="#joint">alher</unclear> inn <placeName ref="stadtasg-places-114" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Chur</unclear></placeName> <unclear cert="medium" resp="#joint">uffleggen</unclear> <unclear cert="medium" resp="#joint">sol</unclear>,
<pb facs="StadtASG_Missive_1576_5700.jpg" n="2"/>
<lb n="42"/>erwarten, und alß dann uff das beldist, so
<lb n="43"/>ihnen müglich, üch alß unseren getrüwen
<lb n="44"/>lieben Eydt: und Pündtsgnossen, welg=
<lb n="45"/>ewene ehrs. gmeinden rath und <unclear cert="low" resp="#joint">finnnuß</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">gefasten</unclear> <unclear cert="low" resp="#joint">enthsclüß</unclear>, <unclear cert="low" resp="#joint">schriffteich</unclear> <unclear cert="low" resp="#joint">zuogeschikht</unclear>
<lb n="47"/>und <unclear cert="low" resp="#joint">eröffnet</unclear> <unclear cert="low" resp="#joint">werden</unclear>. <unclear cert="low" resp="#joint">Derowegen</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">sitenmahln</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">verborgen</unclear>, <unclear cert="low" resp="#joint">wessen</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">wolgemelte</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">ehrsamen</unclear> <unclear cert="low" resp="#joint">raet</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">gmeinden</unclear>, <unclear cert="low" resp="#joint">über</unclear> <unclear cert="low" resp="#joint">obangeregte</unclear> <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">be=</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">denckhen</unclear>, und sich entchliessen werdden,
<lb n="52"/>so langt unser früntlich pitt, es wellind
<lb n="53"/>unsere getrüwe liebe Eydt: und Pündts=
<lb n="54"/>gnossen, Iinzwitt ihre alberit depu=
<lb n="55"/>tierten ehren gsandten, biß uff ferneren
<lb n="56"/>bscheid, zuo vermÿdung vergebeidlicher un=
<lb n="57"/>costungen, müÿ und arbeit, instellen und
<lb n="58"/>abschaffen. Inßunders diewÿl, inn dem
<lb n="59"/>iüngsten, an üch unser getrüw lieb Eydt:
<lb n="60"/>und Pündtsgnossen, abgangen entschluß
<lb n="61"/>schrÿben, der mehrern der ehrs. gmeinden
<lb n="62"/>halb, etwas mißverstand vermischt.
<lb n="63"/>Wellicher aber dem weßen nach, nit
<lb n="64"/>ußtruckenlich und <unclear cert="low" resp="#joint">specificierlich</unclear> <unclear cert="low" resp="#joint">selbiger</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">zÿt</unclear> <unclear cert="low" resp="#joint">berüert</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">namlichen</unclear>
<lb n="66"/><unclear cert="low" resp="#joint">gmein</unclear> <unclear cert="low" resp="#joint">drÿg</unclear> <unclear cert="low" resp="#joint">Pündt</unclear> <unclear cert="low" resp="#joint">erstmahls</unclear> sich uff
<lb n="67"/>üwere gütige underhandlung berüfft,
<lb n="68"/>und ihenen rath zuofolgen, sich <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">zÿt</unclear>
<lb n="69"/>anerbotten, und nachmaalen anerbietig
<lb n="70"/>sÿnd, dann inn ußgnoemnen
<lb n="71"/>mehren voh der ehrs. gmeinden, deß=
<lb n="72"/>selbigen punctens kein <unclear cert="low" resp="#joint">andütung</unclear> <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="73"/><unclear cert="low" resp="#joint">meldung</unclear> <unclear cert="low" resp="#joint">beschehen</unclear>, <unclear cert="low" resp="#joint">verhoffentlich</unclear> <unclear cert="low" resp="#joint">aber</unclear>
<lb n="74"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">khünfftigen</unclear> <unclear cert="low" resp="#joint">beschehen</unclear> <unclear cert="low" resp="#joint">werde</unclear>.
<lb n="75"/><unclear cert="low" resp="#joint">Hiemit</unclear> <unclear cert="low" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">gnaden</unclear> uns <unclear cert="low" resp="#joint">süm</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="76"/>samptlich bevehlende. Dactum und mit
<lb n="77"/>unser getrüwen lieben Pündtsgnossen
<lb n="78"/>der statt <placeName ref="stadtasg-places-114" cert="medium" resp="#ner">Chur</placeName> <unclear cert="low" resp="#joint">secrett</unclear> <unclear cert="low" resp="#joint">insigel</unclear> <unclear cert="low" resp="#joint">verschlossen</unclear>,
<lb n="79"/><origDate when="1607" resp="#ner">den letsten monatstag septembris. Anno
<lb n="80"/>1607</origDate>.
<lb n="81"/>Die haeüpter der drÿen
<lb n="82"/>Pündten zuo Chur bÿein=
<lb n="83"/>anderen versampt,
<lb n="84"/>An <orgName ref="stadtasg-actors-503" cert="medium" role="recipient" resp="#ner">burgermeister und rath d statt Zürich</orgName>.
</p>
