<p>
<pb facs="StadtASG_Missive_1576_5699.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich willig <unclear cert="low" resp="#joint">dinst</unclear> und grueß ge-
<lb n="2"/><unclear cert="low" resp="#joint">thruew</unclear> lieb Eydt: und <unclear cert="medium" resp="#joint">Pundtsgnoßen</unclear>, <unclear cert="medium" resp="#joint">uewer</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">zwey</unclear> <unclear cert="medium" resp="#joint">underschidenliche</unclear> den <date resp="#ner"><unclear cert="medium" resp="#joint">25.t</unclear> und <unclear cert="low" resp="#joint">26.st</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">gegenwuertigen</unclear> monats</date>, <unclear cert="low" resp="#joint">datierte</unclear>, und an uns
<lb n="5"/><unclear cert="low" resp="#joint">ußgangne</unclear>, <unclear cert="low" resp="#joint">sambt</unclear> auch bygelegten an eir <unclear cert="low" resp="#joint">Ehrsame</unclear>
<lb n="6"/><orgName resp="#ner"><unclear cert="low" resp="#joint">Rathsgmeindt</unclear>, <unclear cert="low" resp="#joint">gmeiner</unclear> <unclear cert="low" resp="#joint">Dryen</unclear> Pündten</orgName>, ab <unclear cert="low" resp="#joint">der</unclear>
<lb n="7"/><placeName ref="stadtasg-places-51" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">arowischen</unclear> <unclear cert="low" resp="#joint">Tagsatzung</unclear></placeName> <unclear cert="low" resp="#joint">beschechne</unclear> schryben, <unclear cert="low" resp="#joint">inuß</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">mitgetheilter</unclear> <unclear cert="medium" resp="#joint">Copy</unclear> und abschrifft, <unclear cert="low" resp="#joint">habent</unclear> wir
<lb n="9"/>wol empfangen, und <unclear cert="medium" resp="#joint">neben</unclear> <unclear cert="medium" resp="#joint">anderen</unclear>,
<lb n="10"/>uß denselbigen, <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">fein</unclear> und <unclear cert="low" resp="#joint">nothürfftig</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">ersehenn</unclear>, das Ir, <unclear cert="medium" resp="#joint">unnsere</unclear> <unclear cert="medium" resp="#joint">gethruewe</unclear>
<lb n="12"/>liebe Eydt: und <unclear cert="low" resp="#joint">Pundtsgnoßen</unclear>, <unclear cert="low" resp="#joint">sampt</unclear>
<lb n="13"/>und sonders Iren <unclear cert="low" resp="#joint">Ihenn</unclear> <unclear cert="low" resp="#joint">bißdahero</unclear> vilfaltig
<lb n="14"/>im <unclear cert="low" resp="#joint">werck</unclear> <unclear cert="low" resp="#joint">erzeigten</unclear> <unclear cert="low" resp="#joint">guethertzigen</unclear> willen,
<lb n="15"/>und yfer, so sy <unclear cert="low" resp="#joint">zue</unclear> unsers <unclear cert="low" resp="#joint">geliebten</unclear> be-
<lb n="16"/><unclear cert="low" resp="#joint">khuemerten</unclear> vatterlandts <unclear cert="low" resp="#joint">zuestandts</unclear> ver-
<lb n="17"/><unclear cert="medium" resp="#joint">beßerung</unclear>, <unclear cert="medium" resp="#joint">Ehr</unclear> reputation, und <unclear cert="medium" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">herge</unclear>-
<lb n="18"/><unclear cert="medium" resp="#joint">brachten</unclear> <unclear cert="low" resp="#joint">frygheiten</unclear> <unclear cert="medium" resp="#joint">erhaltung</unclear>, <unclear cert="low" resp="#joint">unerbietlich</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">tragendt</unclear>, <unclear cert="low" resp="#joint">immerdar</unclear> <unclear cert="low" resp="#joint">vesten</unclear> und <unclear cert="low" resp="#joint">standthafftig</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">continuierent</unclear> und <unclear cert="low" resp="#joint">verharrendt</unclear>. Hier-
<lb n="21"/>umb wir <unclear cert="medium" resp="#joint">Ihenn</unclear> <unclear cert="medium" resp="#joint">nachmalen</unclear> <unclear cert="medium" resp="#joint">hochen</unclear> und flyßig
<lb n="22"/><unclear cert="low" resp="#joint">danck</unclear> sagendt, und <unclear cert="medium" resp="#joint">wuenschend</unclear>, der
<lb n="23"/>liebe Gott, <unclear cert="low" resp="#joint">wende</unclear> alles zue seinem Lob
<lb n="24"/>und <unclear cert="low" resp="#joint">algemeinem</unclear> vatterland zum besten.
<lb n="25"/><unclear cert="medium" resp="#joint">Diewyl</unclear> <unclear cert="medium" resp="#joint">aber</unclear> <unclear cert="medium" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">obbemelten</unclear> schryben,
<lb n="26"/><unclear cert="low" resp="#joint">gefaßter</unclear> <unclear cert="low" resp="#joint">entschluß</unclear> und abscheid, <unclear cert="medium" resp="#joint">denen</unclear> <unclear cert="medium" resp="#joint">zuvo</unclear>-
<lb n="27"/><unclear cert="medium" resp="#joint">ußgangnen</unclear> abscheiden und <unclear cert="medium" resp="#joint">erkantnußen</unclear>,
<lb n="28"/><unclear cert="medium" resp="#joint">über</unclear> <unclear cert="medium" resp="#joint">disere</unclear> <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">schwebende</unclear> <unclear cert="medium" resp="#joint">verwirte</unclear>
<lb n="29"/>sachen, etlicher <unclear cert="low" resp="#joint">maßen</unclear> mutiert, und ver-
<lb n="30"/><unclear cert="medium" resp="#joint">enderet</unclear> <unclear cert="low" resp="#joint">worden</unclear>, so <unclear cert="low" resp="#joint">khönen</unclear> wir <unclear cert="medium" resp="#joint">hier</unclear>-
<lb n="31"/>über <unclear cert="low" resp="#joint">khein</unclear> <unclear cert="low" resp="#joint">schließliche</unclear> <unclear cert="low" resp="#joint">antwort</unclear>, <unclear cert="low" resp="#joint">unßers</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">theils</unclear> <unclear cert="medium" resp="#joint">erfolgen</unclear>, sonder abschrifften der-
<lb n="33"/>selbigen schryben, an <unclear cert="medium" resp="#joint">die</unclear> <orgName resp="#ner"><unclear cert="medium" resp="#joint">Ehrs</unclear>: <unclear cert="medium" resp="#joint">Räth</unclear> und
<lb n="34"/><unclear cert="medium" resp="#joint">Gmeinden</unclear>, Gemeiner <unclear cert="low" resp="#joint">Dryen</unclear> Pündten</orgName>,
<lb n="35"/>langen, und <unclear cert="medium" resp="#joint">sy</unclear> alles <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">theilhafftig</unclear> machen
<lb n="36"/><unclear cert="medium" resp="#joint">laßen</unclear>, und <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">angestelte</unclear> zyt, namblich
<lb n="37"/>den <date resp="#ner"><unclear cert="low" resp="#joint">14.t</unclear> <unclear cert="low" resp="#joint">nechstkhuenfftigen</unclear> monats Octobris</date>,
<lb n="38"/>derselbigen meinung und <unclear cert="low" resp="#joint">mehr</unclear>, so ein <unclear cert="medium" resp="#joint">jede</unclear>
<lb n="39"/>Gmeind und <unclear cert="low" resp="#joint">Hochgricht</unclear>, durch iren <unclear cert="medium" resp="#joint">Ge</unclear>-
<lb n="40"/><unclear cert="medium" resp="#joint">sandten</unclear> inn schrifft, <unclear cert="medium" resp="#joint">wie</unclear> einer Ehrs: <unclear cert="medium" resp="#joint">Gmeind</unclear>
<lb n="41"/><unclear cert="medium" resp="#joint">Zuefhire</unclear> <unclear cert="medium" resp="#joint">wercklichen</unclear>, <unclear cert="medium" resp="#joint">alher</unclear> inn <placeName ref="stadtasg-places-114" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Chur</unclear></placeName> <unclear cert="medium" resp="#joint">uffleggen</unclear> <unclear cert="medium" resp="#joint">sol</unclear>,
<pb facs="StadtASG_Missive_1576_5700.jpg" n="2"/>
<lb n="42"/><unclear cert="low" resp="#joint">erwarten</unclear>, und alß dann uff das <unclear cert="low" resp="#joint">beldist</unclear>, so
<lb n="43"/><unclear cert="low" resp="#joint">ihnen</unclear> müglich, <unclear cert="low" resp="#joint">üch</unclear> alß unseren <unclear cert="low" resp="#joint">getrüwen</unclear>
<lb n="44"/>lieben Eydt: und Pündtsgnossen, welg=
<lb n="45"/>ewene ehrs. gmeinden rath und <unclear cert="low" resp="#joint">finnnuß</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">gefasten</unclear> <unclear cert="low" resp="#joint">enthsclüß</unclear>, <unclear cert="low" resp="#joint">schriffteich</unclear> <unclear cert="low" resp="#joint">zuogeschikht</unclear>
<lb n="47"/>und <unclear cert="low" resp="#joint">eröffnet</unclear> <unclear cert="low" resp="#joint">werden</unclear>. <unclear cert="low" resp="#joint">Derowegen</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">sitenmahln</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">verborgen</unclear>, <unclear cert="low" resp="#joint">wessen</unclear> sich
