<lb n="73"/><unclear cert="medium" resp="#joint">meldung</unclear> <unclear cert="medium" resp="#joint">beschehen</unclear>, <unclear cert="medium" resp="#joint">verhoffentlich</unclear> aber
<lb n="74"/>im <unclear cert="low" resp="#joint">khünfftigen</unclear> <unclear cert="low" resp="#joint">beschehen</unclear> <unclear cert="low" resp="#joint">werde</unclear>.
<lb n="75"/><unclear cert="low" resp="#joint">Hiemit</unclear> Gottes gnaden uns <unclear cert="medium" resp="#joint">süm</unclear> <unclear cert="medium" resp="#joint">unß</unclear>
