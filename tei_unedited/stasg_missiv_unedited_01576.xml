<lb n="50"/><unclear cert="low" resp="#joint">gmeinden</unclear>, <unclear cert="low" resp="#joint">über</unclear> <unclear cert="low" resp="#joint">obangeregte</unclear> <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">be=</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">denckhen</unclear>, und sich <unclear cert="low" resp="#joint">entchliessen</unclear> <unclear cert="low" resp="#joint">werdden</unclear>,
<lb n="52"/>so langt unser <unclear cert="low" resp="#joint">früntlich</unclear> pitt, es wellind
<lb n="53"/><unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">getrüwe</unclear> liebe Eydt: und <unclear cert="low" resp="#joint">Pündts=</unclear>
<lb n="54"/>gnossen, Iinzwitt ihre alberit depu=
<lb n="55"/>tierten ehren gsandten, biß uff ferneren
<lb n="56"/>bscheid, zuo vermÿdung vergebeidlicher un=
<lb n="57"/>costungen, müÿ und arbeit, <unclear cert="low" resp="#joint">instellen</unclear> und
<lb n="58"/><unclear cert="low" resp="#joint">abschaffen</unclear>. <unclear cert="low" resp="#joint">Inßunders</unclear> <unclear cert="low" resp="#joint">diewÿl</unclear>, inn dem
<lb n="59"/><unclear cert="low" resp="#joint">iüngsten</unclear>, an üch unser <unclear cert="low" resp="#joint">getrüw</unclear> lieb Eydt:
<lb n="60"/>und <unclear cert="low" resp="#joint">Pündtsgnossen</unclear>, abgangen <unclear cert="low" resp="#joint">entschluß</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">schrÿben</unclear>, der <unclear cert="low" resp="#joint">mehrern</unclear> der <unclear cert="low" resp="#joint">ehrs</unclear>. <unclear cert="low" resp="#joint">gmeinden</unclear>
<lb n="62"/>halb, etwas mißverstand <unclear cert="low" resp="#joint">vermischt</unclear>.
<lb n="63"/><unclear cert="low" resp="#joint">Wellicher</unclear> aber dem <unclear cert="low" resp="#joint">weßen</unclear> nach, nit
<lb n="64"/><unclear cert="low" resp="#joint">ußtruckenlich</unclear> und <unclear cert="medium" resp="#joint">specificierlich</unclear> <unclear cert="medium" resp="#joint">selbiger</unclear>
<lb n="65"/><unclear cert="medium" resp="#joint">zÿt</unclear> <unclear cert="medium" resp="#joint">berüert</unclear> <unclear cert="medium" resp="#joint">worden</unclear>, das <unclear cert="medium" resp="#joint">namlichen</unclear>
<lb n="66"/><unclear cert="medium" resp="#joint">gmein</unclear> <unclear cert="medium" resp="#joint">drÿg</unclear> <unclear cert="medium" resp="#joint">Pündt</unclear> <unclear cert="medium" resp="#joint">erstmahls</unclear> sich uff
<lb n="67"/><unclear cert="low" resp="#joint">üwere</unclear> <unclear cert="low" resp="#joint">gütige</unclear> <unclear cert="low" resp="#joint">underhandlung</unclear> <unclear cert="low" resp="#joint">berüfft</unclear>,
<lb n="68"/>und <unclear cert="low" resp="#joint">ihenen</unclear> <unclear cert="low" resp="#joint">rath</unclear> <unclear cert="low" resp="#joint">zuofolgen</unclear>, sich <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">zÿt</unclear>
<lb n="69"/>anerbotten, und <unclear cert="low" resp="#joint">nachmaalen</unclear> <unclear cert="low" resp="#joint">anerbietig</unclear>
<lb n="70"/><unclear cert="low" resp="#joint">sÿnd</unclear>, dann inn <unclear cert="low" resp="#joint">ußgnoemnen</unclear>
<lb n="71"/><unclear cert="low" resp="#joint">mehren</unclear> <unclear cert="low" resp="#joint">voh</unclear> der ehrs. gmeinden, deß=
