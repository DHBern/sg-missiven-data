    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2272_8617.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">fründt</unclear>- <unclear cert="medium" resp="#joint">nachparlich</unclear> willig dienst <unclear cert="medium" resp="#joint">zuovor</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">Fuersichtig</unclear> <unclear cert="medium" resp="#joint">Eersamb</unclear> und <unclear cert="medium" resp="#joint">weyß</unclear>, <unclear cert="medium" resp="#joint">besonders</unclear> liebe
<lb n="3"/><unclear cert="medium" resp="#joint">fründ</unclear> und <unclear cert="low" resp="#joint">nachbarn</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">schreiben</unclear> <unclear cert="low" resp="#joint">de</unclear> dato <date resp="#ner">10. diß</date>, haben wir <unclear cert="medium" resp="#joint">inn</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">unserer</unclear> <unclear cert="medium" resp="#joint">auf</unclear> <unclear cert="medium" resp="#joint">heüt</unclear> <unclear cert="medium" resp="#joint">deßwegen</unclear> <unclear cert="medium" resp="#joint">extraordinariè</unclear> <unclear cert="medium" resp="#joint">gehalt</unclear>-
<lb n="6"/>nen <unclear cert="low" resp="#joint">versamblung</unclear> <unclear cert="low" resp="#joint">hören</unclear> <unclear cert="low" resp="#joint">verlesen</unclear>, und <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">darauff</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">alßbald</unclear> <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">Mitrhatsfründ</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Amadeo</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">Eggolt</unclear></persName>, <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">betrifft</unclear>, <unclear cert="low" resp="#joint">fürhalten</unclear> lassen, der
<lb n="9"/>hat nun hierüber berichtet:
<lb n="10"/>Das <unclear cert="medium" resp="#joint">angegebner</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Jacob</unclear> <unclear cert="medium" resp="#joint">Schoch</unclear></persName> von <placeName ref="stadtasg-places-65" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Herisow</unclear></placeName> <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">Eggolt</unclear>, <unclear cert="low" resp="#joint">seins</unclear> <unclear cert="low" resp="#joint">behalts</unclear>, <unclear cert="low" resp="#joint">bey</unclear> 10. <unclear cert="medium" resp="#joint">wochen</unclear> <unclear cert="medium" resp="#joint">her</unclear> <unclear cert="medium" resp="#joint">ohnge</unclear>-
<lb n="12"/><unclear cert="medium" resp="#joint">fahrlich</unclear>, etwas <unclear cert="medium" resp="#joint">Taler</unclear> gegen der Statt <placeName ref="stadtasg-places-114" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Cuhr</unclear></placeName> drey-
<lb n="13"/><unclear cert="medium" resp="#joint">baetznern</unclear> (dann <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">Bischoffs</unclear>, wie auch die <unclear cert="low" resp="#joint">Halden</unclear>-
<lb n="14"/><unclear cert="low" resp="#joint">steiner</unclear> <unclear cert="low" resp="#joint">dreybaetzner</unclear> <unclear cert="low" resp="#joint">gemeingkhliger</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">sollen</unclear>)
<lb n="15"/><unclear cert="low" resp="#joint">zuverwechßlen</unclear>, <unclear cert="low" resp="#joint">freywillig</unclear> <unclear cert="low" resp="#joint">angebotten</unclear> und
<lb n="16"/>gebracht; auch <unclear cert="medium" resp="#joint">letstlich</unclear> vermeldt, wann er
<lb n="17"/><unclear cert="low" resp="#joint">mehr</unclear> <unclear cert="low" resp="#joint">müntz</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">vorrath</unclear> gehabt <unclear cert="low" resp="#joint">hette</unclear>, <unclear cert="low" resp="#joint">wie</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">fuernemme</unclear> <unclear cert="low" resp="#joint">Summ</unclear> er <unclear cert="low" resp="#joint">wolte</unclear> <unclear cert="low" resp="#joint">bekommen</unclear> haben;
<lb n="19"/>Auff <unclear cert="medium" resp="#joint">welches</unclear> Er <persName resp="#ner"><unclear cert="medium" resp="#joint">Eggolt</unclear></persName> <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">Schochen</unclear> <unclear cert="medium" resp="#joint">nunmehr</unclear>
<lb n="20"/>zu 2. <unclear cert="medium" resp="#joint">od</unclear>. 3. <unclear cert="medium" resp="#joint">mahlen</unclear> ettlich 100. <unclear cert="low" resp="#joint">f</unclear>. an solch-en
<lb n="21"/><unclear cert="medium" resp="#joint">dreybaetznern</unclear> <unclear cert="medium" resp="#joint">füegeschossen</unclear> und <unclear cert="medium" resp="#joint">anvertraut</unclear>,
<lb n="22"/>wie <unclear cert="low" resp="#joint">offt</unclear>, <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">wiech</unclear> <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">summen</unclear> er <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">Schochen</unclear> <unclear cert="low" resp="#joint">jedesmahlß</unclear> <unclear cert="low" resp="#joint">abgewechßelt</unclear>: <unclear cert="low" resp="#joint">Chönne</unclear> <unclear cert="low" resp="#joint">er</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">darumben</unclear> nicht eigentlich anzeigen oder
<lb n="25"/><unclear cert="medium" resp="#joint">wüssen</unclear>; <unclear cert="medium" resp="#joint">dieweil</unclear> er <persName resp="#ner"><unclear cert="medium" resp="#joint">Schoch</unclear></persName> nicht <unclear cert="medium" resp="#joint">allein</unclear> sey,
<pb facs="StadtASG_Missive_2272_8618.jpg" n="2"/>
<lb n="26"/>welcher ihme sölche dreybäczner gegen talern
<lb n="27"/>abwechßle; sondern andere mehr, so uß-
<lb n="28"/>ländische scheiniche deßhalber zuo ihne kommen.
<lb n="29"/>Ja so gar <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">kaufstübleins</unclear> alhie fürgeseczte selbs,
<lb n="30"/>wann sie <unclear cert="low" resp="#joint">müncz</unclear> <unclear cert="low" resp="#joint">bedürfftig</unclear> <unclear cert="low" resp="#joint">gewesen</unclear>, <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">Eggd</unclear>-
<lb n="31"/><unclear cert="low" resp="#joint">ten</unclear> <unclear cert="low" resp="#joint">sölche</unclear> <unclear cert="low" resp="#joint">dreybäczner</unclear>, <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">grobe</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">abge</unclear>-
<lb n="32"/>nommen. Daß er allso jede <unclear cert="low" resp="#joint">sölche</unclear> <unclear cert="low" resp="#joint">verwechß</unclear>-
<lb n="33"/><unclear cert="low" resp="#joint">lung</unclear> nicht uffschreiben oder sonderbahr be-
<lb n="34"/>halten <unclear cert="low" resp="#joint">können</unclear>.
<lb n="35"/><unclear cert="low" resp="#joint">Wiewol</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">nun</unclear>, <unclear cert="low" resp="#joint">unsers</unclear> theils, nichts liebers
<lb n="36"/>sehen oder wüntschen wölten, dann dz <unclear cert="low" resp="#joint">dem</unclear>-
<lb n="37"/><unclear cert="low" resp="#joint">eingrißnen</unclear> <unclear cert="low" resp="#joint">leidigen</unclear> <unclear cert="low" resp="#joint">müncz</unclear> <unclear cert="low" resp="#joint">ohnwesen</unclear> <unclear cert="low" resp="#joint">vmb</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">etwaß</unclear> remediert und die <unclear cert="low" resp="#joint">sach</unclear> <unclear cert="low" resp="#joint">derentwegen</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">leidenlichen</unclear> stand gestellet werden möchte.
<lb n="40"/>Sobefünden wir doch inn der erfahrunng
<lb n="41"/>je lenger ie mehr, daß sölch werckh allein,
<lb n="42"/>ohne zuothuon und <unclear cert="low" resp="#joint">mitverhelffung</unclear>, wonicht
<lb n="43"/>aller doch <unclear cert="low" resp="#joint">ettlicher</unclear> <unclear cert="low" resp="#joint">nechstbenachbarten</unclear> <unclear cert="low" resp="#joint">reichß</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">ständ</unclear> und der größern handelßstätt, zuoerheben
<lb n="45"/>vmb ohnmüglich seige. Dahero wir auch biß-
<lb n="46"/>hero wider unsern willen, <unclear cert="low" resp="#joint">vails</unclear>, so unß
<lb n="47"/>nit lieb, <unclear cert="low" resp="#joint">für</unclear> und <unclear cert="low" resp="#joint">nachsehen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">disen</unclear> zeit
<lb n="48"/>leüfen etwaß mehr alß sonst beschehe indul-
<lb n="49"/>gieren müeßen. Sonderlich aber ist eß dahin
<lb n="50"/>gelangt
<pb facs="StadtASG_Missive_2272_8619.jpg" n="3"/>
<lb n="51"/>gelangt, weil die Eydgnoßische guete dreÿ-
<lb n="52"/>bäzner alhie nicht mehr angetroffen oder gesehen
<lb n="53"/>werden, daß wir der <placeName ref="stadtasg-places-114" cert="medium" resp="#ner">Churer</placeName> dreÿbäzner,
<lb n="54"/>(wiewol die auch ein dreÿfachen differenz
<lb n="55"/>sind, unnd, wegen täglicher steigerung der <unclear cert="low" resp="#joint">gro</unclear>-
<lb n="56"/><unclear cert="low" resp="#joint">ben</unclear> <unclear cert="low" resp="#joint">sorten</unclear>, <unclear cert="low" resp="#joint">nottuolgich</unclear>, auch je leüger je
<lb n="57"/>schlechter werden) uerursachenden mangels
<lb n="58"/>an müntz, gleichsamb nicht gerathen und hier
<lb n="59"/>nicht <unclear cert="low" resp="#joint">gnuegsamb</unclear> <unclear cert="low" resp="#joint">wöhren</unclear> <unclear cert="low" resp="#joint">khönnen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">andero</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">vihl</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Grienninger</unclear></placeName> <unclear cert="low" resp="#joint">dreÿbäzner</unclear> (welche auß
<lb n="61"/><placeName ref="stadtasg-places-108" cert="medium" resp="#ner">Schwaaben</placeName> unnd <placeName resp="#ner">Franckhenland</placeName> khommen, unnd
<lb n="62"/>allenthalben umb uns herumb gangbar sind)
<lb n="63"/>nicht <unclear cert="low" resp="#joint">allzue</unclear> <unclear cert="low" resp="#joint">heüffig</unclear> alhie eingeschlaicht werden.
<lb n="64"/>Darbeÿ wir gleichwol <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="65"/>ihres an sich selbs loblichen fürhabens halber,
<lb n="66"/>weder maaß noch ordnung gegeben haben <unclear cert="low" resp="#joint">wöllen</unclear>.
<lb n="67"/><unclear cert="low" resp="#joint">Wolten</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Fht</unclear>. <unclear cert="low" resp="#joint">wir</unclear>, <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">begertem</unclear> bericht, im
<lb n="68"/>herkhommen uertrawen nicht uerhalten, unnd
<lb n="69"/>bleiben Inen darneben mit gueter freündt-
<lb n="70"/>unnd nachparschafft jederzeit wol beÿgethan,
<lb n="71"/>datum, den <origDate when="1621-06-14" resp="#ner">14. Junii a° 1621</origDate>
<lb n="72"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermeister unnd
<lb n="73"/>Rhat der Statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_2272_8620.jpg" n="4"/>
<lb n="74"/>Den fürsichtigen ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="75"/>meister und Rhat der statt St. Gallen</orgName> unsern
<lb n="76"/>besondern lieben <unclear cert="medium" resp="#joint">fründen</unclear> und nachbarn.
</p>
