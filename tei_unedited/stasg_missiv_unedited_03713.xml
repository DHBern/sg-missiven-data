<lb n="23"/>einen solchen schaden und <unclear cert="low" resp="#joint">ufflauffen</unclear> <unclear cert="low" resp="#joint">gesezt</unclear> <unclear cert="low" resp="#joint">worden</unclear>,
<lb n="24"/><unclear cert="low" resp="#joint">also</unclear>, und damit wir unß umb etwas widererholen,
<lb n="25"/>und <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">gemeine</unclear> <unclear cert="low" resp="#joint">stattwesen</unclear> <unclear cert="low" resp="#joint">vorab</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">रूehe</unclear> in
<lb n="26"/>bessere uffnemung bringen möchten, haben wir <unclear cert="low" resp="#joint">etliche</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">getrewe</unclear> <unclear cert="low" resp="#joint">patrioten</unclear>, unß hierinnen mit einem
<lb n="28"/><unclear cert="low" resp="#joint">leÿdenlichen</unclear> nachbarlichen <unclear cert="low" resp="#joint">Mitleiden</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">gratifi</unclear>-
<lb n="29"/><unclear cert="low" resp="#joint">cieren</unclear> <unclear cert="low" resp="#joint">hochfleißig</unclear> <unclear cert="low" resp="#joint">ersuocht</unclear> und gebetten, und zue
<lb n="30"/>dem ende beÿ letster gelegenheit <unclear cert="low" resp="#joint">erwenten</unclear> <unclear cert="low" resp="#joint">20</unclear> <unclear cert="low" resp="#joint">diß</unclear>,
<lb n="31"/><unclear cert="low" resp="#joint">unserem</unclear> lieben Mitburger H. <persName resp="#ner">Martin Schmaltzen</persName>,
<pb facs="StadtASG_Missive_3713_14912.jpg" n="2"/>
<lb n="32"/><unclear cert="low" resp="#joint">Welchermaßen</unclear> <unclear cert="low" resp="#joint">es</unclear> in <unclear cert="low" resp="#joint">Eüwer</unclear> <unclear cert="low" resp="#joint">geliebten</unclear> <unclear cert="low" resp="#joint">nachber</unclear>-
<lb n="33"/><unclear cert="low" resp="#joint">schafft</unclear> <unclear cert="low" resp="#joint">beraitz</unclear> <unclear cert="low" resp="#joint">stehed</unclear>, <unclear cert="low" resp="#joint">anbevolhen</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="34"/><unclear cert="low" resp="#joint">gegenwürtig</unclear> <unclear cert="low" resp="#joint">Credit</unclear> <unclear cert="low" resp="#joint">schreiben</unclear> <unclear cert="low" resp="#joint">zeüberreichen</unclear>
<lb n="35"/>und <unclear cert="low" resp="#joint">dieselbe</unclear> <unclear cert="low" resp="#joint">nohmaln</unclear> <unclear cert="low" resp="#joint">deßto</unclear> <unclear cert="low" resp="#joint">trewhertzhafftigist</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">zueersuechen</unclear> und <unclear cert="low" resp="#joint">zebitten</unclear>, ob Sie unß mit
<lb n="37"/><unclear cert="low" resp="#joint">leichterlich</unclear> <unclear cert="low" resp="#joint">gebetner</unclear> <unclear cert="low" resp="#joint">hülffbetraechtigem</unclear> <unclear cert="low" resp="#joint">darlihen</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">1000</unclear>. <unclear cert="low" resp="#joint">Dcaten</unclear>, <unclear cert="low" resp="#joint">od</unclear> 1500 fl biß <date resp="#ner">st Martinie</date> fründt,
<lb n="39"/>Ehr, burgrechtlihen, unserß zehöchst lob und <unclear cert="low" resp="#joint">danckh</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">gleüch</unclear> <unclear cert="low" resp="#joint">erlangten</unclear>, <unclear cert="low" resp="#joint">deßto</unclear> <unclear cert="low" resp="#joint">ehe</unclear> <unclear cert="low" resp="#joint">ersprießlh</unclear> <unclear cert="low" resp="#joint">Componiertn</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">fridtlihn</unclear> <unclear cert="low" resp="#joint">Vertragßes</unclear>, <unclear cert="low" resp="#joint">ehend</unclear> <unclear cert="low" resp="#joint">Nachbarlh</unclear> <unclear cert="low" resp="#joint">zuegra</unclear>-
<lb n="42"/><unclear cert="low" resp="#joint">tificieren</unclear> <unclear cert="low" resp="#joint">Iro</unclear> <unclear cert="low" resp="#joint">belieben</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">wolten</unclear>, <unclear cert="low" resp="#joint">Seÿen</unclear> <unclear cert="low" resp="#joint">würdß</unclear>
