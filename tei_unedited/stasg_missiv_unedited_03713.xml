<p>
<pb facs="StadtASG_Missive_3713_14911.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freundtliche</unclear> <unclear cert="low" resp="#joint">willige</unclear> <unclear cert="low" resp="#joint">dienst</unclear>, und <unclear cert="low" resp="#joint">was</unclear> wir
<lb n="2"/>ehren liebs und <unclear cert="low" resp="#joint">guots</unclear> <unclear cert="low" resp="#joint">vermoegen</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">Edle</unclear>, <unclear cert="low" resp="#joint">Veste</unclear>, <unclear cert="low" resp="#joint">Fromme</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">Ehrenveste</unclear>, <unclear cert="low" resp="#joint">Fürsichtige</unclear>, <unclear cert="low" resp="#joint">Ersame</unclear> und <unclear cert="low" resp="#joint">Weyse</unclear>, <unclear cert="low" resp="#joint">be</unclear>-
<lb n="4"/><unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">großg</unclear>. <unclear cert="low" resp="#joint">Herren</unclear>, <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">Freündt</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Auß</unclear> <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">hochtringenden</unclear> <unclear cert="low" resp="#joint">ursachen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">wir</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">jungst</unclear> <unclear cert="low" resp="#joint">abermalen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">erst</unclear> <unclear cert="low" resp="#joint">verwichnen</unclear>
<lb n="7"/><date resp="#ner"><unclear cert="low" resp="#joint">freytag</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">20</unclear>. <unclear cert="low" resp="#joint">diß</unclear></date>, <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">unserem</unclear> <placeName ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Lindawer</unclear></placeName>
<lb n="8"/><unclear cert="low" resp="#joint">ordinari</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">eynkaüffung</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">1000</unclear>. <unclear cert="low" resp="#joint">malter</unclear> <unclear cert="low" resp="#joint">kheren</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">dienstlich</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">hochflehenlich</unclear> <unclear cert="low" resp="#joint">ersuocht</unclear> und gebetten,
<lb n="10"/>das <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">auß</unclear> unsern <unclear cert="low" resp="#joint">underschiedlichen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">an</unclear> die <unclear cert="low" resp="#joint">abgelaßnen</unclear> <unclear cert="low" resp="#joint">ersuochungsschreiben</unclear>, und <unclear cert="low" resp="#joint">der</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">unßrigen</unclear> <unclear cert="low" resp="#joint">hievorgestrigen</unclear> <unclear cert="low" resp="#joint">beschehnen</unclear> <unclear cert="low" resp="#joint">Persohnlichen</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">abordnung</unclear>, <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">Mehrem</unclear> <unclear cert="low" resp="#joint">vernommen</unclear> haben, <unclear cert="low" resp="#joint">dahin</unclear>
<lb n="14"/>wir unß geliebter kürze halber nochmalen
<lb n="15"/>referieren.
<lb n="16"/>Weil wir dann <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">hoffnung</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">Gott</unclear> haben,
<lb n="17"/>es werde nach allbereit erlangtem hochen rath,
<lb n="18"/>friden, und <unclear cert="low" resp="#joint">guotem</unclear> <unclear cert="low" resp="#joint">burgerlichem</unclear> <unclear cert="low" resp="#joint">verstandt</unclear>, <unclear cert="low" resp="#joint">fürohin</unclear>
