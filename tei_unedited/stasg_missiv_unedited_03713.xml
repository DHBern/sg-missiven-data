<lb n="47"/><unclear cert="low" resp="#joint">anbefohlne</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">Bürgerschafft</unclear> (<unclear cert="low" resp="#joint">nebenz</unclear> <unclear cert="low" resp="#joint">künfftig</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">guetigern</unclear> <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">bezahlung</unclear>) <unclear cert="low" resp="#joint">Inn</unclear> <unclear cert="low" resp="#joint">Jeder</unclear> <unclear cert="low" resp="#joint">begebenheit</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">Nachbarlh</unclear> <unclear cert="low" resp="#joint">zuebeschuldn</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">zumaln</unclear> <unclear cert="low" resp="#joint">olhn</unclear>
<lb n="50"/>in Jmer werenden unaußleßen angedenckhen
