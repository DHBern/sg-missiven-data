    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1807_6691.jpg" n="1"/>
<lb n="1"/>Unser freündt: Nachbarlich und guetwillige
<lb n="2"/>dienst zuvor, Fuersichtige, Ersame, weise, besonde-
<lb n="3"/>liebe freündt unnd guete Nachbarn.
<lb n="4"/>Was Ihr an <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">uf</unclear> anhalten <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear> <unclear cert="low" resp="#joint">Heinricher</unclear></persName>,
<lb n="5"/><unclear cert="low" resp="#joint">deßgleichen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear> <unclear cert="low" resp="#joint">Thomaß</unclear></persName>, und mitverwandten,
<lb n="6"/>glaeübiger, uwern Burger, unserm Burger <persName resp="#ner">Hannß Schuinz</persName>
<lb n="7"/>von <unclear cert="low" resp="#joint">Christoph</unclear> <unclear cert="low" resp="#joint">Thomaß</unclear> unnd <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">Haußfrawen</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">uberschickhten</unclear> <unclear cert="low" resp="#joint">wahrnenß</unclear> <unclear cert="low" resp="#joint">halben</unclear>, <unclear cert="low" resp="#joint">schriftlichen</unclear> <unclear cert="low" resp="#joint">gelang</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">laßen</unclear>, Daß haben wir mit mehrerm verstanden,
<lb n="10"/>Auch <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">Stataman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear> <unclear cert="low" resp="#joint">Bufflern</unclear></persName> <unclear cert="low" resp="#joint">ferners</unclear>
<lb n="11"/>mündtlichen vernommen, Nach solchem weil
<lb n="12"/>gedachter Hannß <unclear cert="low" resp="#joint">Schuinz</unclear>, <unclear cert="low" resp="#joint">derzeit</unclear> alhie sich nit
<lb n="13"/>befindt, sein Schuinzen Ehfrawen uff die alten sachen
<lb n="14"/>in beÿsein herren Bufflers, durch <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">verordnete</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">herodstallen</unclear>, <unclear cert="low" resp="#joint">waß</unclear> von <unclear cert="low" resp="#joint">Thomaßschen</unclear> <unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="low" resp="#joint">Schuinzen</unclear>
<lb n="16"/>und Ihro seiner Ehfrawen herab gesandt worden,
<lb n="17"/>mit ernst befragen laßen, die hatt angezeigt,
<lb n="18"/>daß alle solche sachen albereit widerumb einge-
<lb n="19"/>schlagen unnd nacher <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName> verschafft, wie
<lb n="20"/>beÿ Ihnen mehrers nit <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">beÿligende</unclear> <unclear cert="low" resp="#joint">Verzeichnuß</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">vermag</unclear>, von <unclear cert="low" resp="#joint">Thomaßschen</unclear> <unclear cert="low" resp="#joint">zugeschikht</unclear> worden.
<lb n="22"/>Welches alles Sÿe mit Imloben an <unclear cert="low" resp="#joint">aÿdßstatt</unclear> be-
<lb n="23"/>staettiget, wie dann Ihr von <unclear cert="low" resp="#joint">ehegedachtem</unclear> herren
<lb n="24"/>Bufflern, welcher der sachen selbs <unclear cert="low" resp="#joint">beÿgewohnt</unclear>, auß-
<lb n="25"/>fhürlichen bericht woll zuvernemen haben,
<pb facs="StadtASG_Missive_1807_6692.jpg" n="2"/>
<lb n="26"/><unclear cert="low" resp="#joint">Wolten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">freunnd</unclear>: <unclear cert="low" resp="#joint">nachbarlich</unclear> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">antwortt</unclear> <unclear cert="low" resp="#joint">anfüegen</unclear>, <unclear cert="low" resp="#joint">denen</unclear> wir in gleichen
<lb n="28"/>unnd andern <unclear cert="low" resp="#joint">fähln</unclear> <unclear cert="low" resp="#joint">angeneme</unclear> <unclear cert="low" resp="#joint">dienst</unclear>, <unclear cert="low" resp="#joint">und</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">nachbarschafft</unclear> <unclear cert="low" resp="#joint">zuerweisen</unclear>, <unclear cert="low" resp="#joint">iederzeit</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">beharlich</unclear> unnd <unclear cert="low" resp="#joint">guetwillig</unclear> <unclear cert="low" resp="#joint">erbiettent</unclear> <unclear cert="low" resp="#joint">sein</unclear>,
<lb n="31"/>Actum <origDate when="1572-12-15" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">denn</unclear> . 15 . Decembris <unclear cert="low" resp="#joint">ao</unclear> <unclear cert="low" resp="#joint">etc</unclear>. <unclear cert="low" resp="#joint">72</unclear></origDate> .
<lb n="32"/>Verwalter d haubtmanschafft
<lb n="33"/><orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner">burgermaister und rath der
<lb n="34"/>statt Costantz</orgName>.
<pb facs="StadtASG_Missive_1807_6693.jpg" n="3"/>
<lb n="35"/>Verzaichnus
<lb n="36"/>Was nach <unclear cert="low" resp="#joint">anzaig</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Hannß</unclear> <unclear cert="low" resp="#joint">Schuechen</unclear></persName> <unclear cert="low" resp="#joint">von</unclear>
<lb n="37"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Effringen</unclear></placeName>, <persName resp="#ner"><unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="low" resp="#joint">Schuechen</unclear></persName> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">Ime</unclear>,
<lb n="38"/><unclear cert="low" resp="#joint">vs</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear> <unclear cert="low" resp="#joint">Kramers</unclear></persName> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">seiner</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">haußfrauwen</unclear> <unclear cert="low" resp="#joint">naher</unclear> <placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Costantz</unclear></placeName> <unclear cert="low" resp="#joint">zu</unclear>-
<lb n="40"/><unclear cert="low" resp="#joint">geschikht</unclear> <unclear cert="low" resp="#joint">worden</unclear>.
<lb n="41"/><unclear cert="low" resp="#joint">Ain</unclear> <unclear cert="low" resp="#joint">vnder</unclear> <unclear cert="low" resp="#joint">bött</unclear>.
<lb n="42"/><unclear cert="low" resp="#joint">Ain</unclear> <unclear cert="low" resp="#joint">barchetin</unclear> <unclear cert="low" resp="#joint">däkhbött</unclear>.
<lb n="43"/><unclear cert="low" resp="#joint">Itm</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">behaltt</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">ainn</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">zehen</unclear> <unclear cert="low" resp="#joint">küsse</unclear>, <unclear cert="low" resp="#joint">klain</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">groß</unclear>.
<lb n="45"/><unclear cert="low" resp="#joint">Ain</unclear> <unclear cert="low" resp="#joint">Rotte</unclear> <unclear cert="low" resp="#joint">gulten</unclear>.
<lb n="46"/><unclear cert="low" resp="#joint">zehen</unclear> <unclear cert="low" resp="#joint">dichlachen</unclear>.
<lb n="47"/><unclear cert="low" resp="#joint">Neün</unclear> <unclear cert="low" resp="#joint">silberne</unclear> <unclear cert="low" resp="#joint">becherlin</unclear>, wegen vmb. 90 loth.
<lb n="48"/><unclear cert="low" resp="#joint">Fünffzehen</unclear> <unclear cert="low" resp="#joint">Zini</unclear> <unclear cert="low" resp="#joint">schüßlin</unclear>.
<lb n="49"/><unclear cert="low" resp="#joint">zwey</unclear> <unclear cert="low" resp="#joint">dutzet</unclear> <unclear cert="low" resp="#joint">Englisch</unclear> <unclear cert="low" resp="#joint">Zini</unclear> <unclear cert="low" resp="#joint">thäller</unclear>.
<lb n="50"/><unclear cert="low" resp="#joint">Letzlichen</unclear>, <unclear cert="low" resp="#joint">weilen</unclear> <unclear cert="low" resp="#joint">herr</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Techler</unclear></persName>, <unclear cert="low" resp="#joint">ebermaffen</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">wüßen</unclear> <unclear cert="low" resp="#joint">tuochen</unclear> anzug gethon, hatt hieuß <persName resp="#ner">Schuechen</persName>
<lb n="52"/>gleichfals mit dem Anloben erhalten, dz solche
<lb n="53"/>weüß tuoch Ime zuegehörig.
<pb facs="StadtASG_Missive_1807_6694.jpg" n="4"/>
<pb facs="StadtASG_Missive_1807_6695.jpg" n="5"/>
<pb facs="StadtASG_Missive_1807_6696.jpg" n="6"/>
<lb n="54"/>Denen Fuersichtigen, Ersamen unnd weisen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="55"/>maister unnd Rath <unclear cert="low" resp="#joint">zue</unclear> St. Gallen</orgName>, unsern besond=
<lb n="56"/>ers lieben Freund unnd <unclear cert="low" resp="#joint">guetten</unclear> <unclear cert="low" resp="#joint">Nachbarn</unclear>.
<lb n="57"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
