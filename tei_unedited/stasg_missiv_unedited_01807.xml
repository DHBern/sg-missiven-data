<lb n="50"/><unclear cert="low" resp="#joint">Letzlichen</unclear>, <unclear cert="low" resp="#joint">weilen</unclear> herr <persName resp="#ner"><unclear cert="low" resp="#joint">Techler</unclear></persName>, <unclear cert="low" resp="#joint">ebermaffen</unclear>
