<lb n="54"/>berichts in <unclear cert="low" resp="#joint">widerandtworth</unclear> <unclear cert="medium" resp="#joint">lenger</unclear> <unclear cert="low" resp="#joint">nitt</unclear> <unclear cert="medium" resp="#joint">vorhalten</unclear>,
<lb n="55"/>unnd <unclear cert="medium" resp="#joint">seindt</unclear> <unclear cert="medium" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">guette</unclear> <unclear cert="medium" resp="#joint">bestendige</unclear> nach=
<lb n="56"/>barschafft <unclear cert="low" resp="#joint">zuoerweißen</unclear>, <unclear cert="low" resp="#joint">gantz</unclear> willig, <unclear cert="low" resp="#joint">allß</unclear> ge=
<lb n="57"/>naigt. Datum <unclear cert="medium" resp="#joint">den</unclear> <origDate when="1611-09-05" resp="#ner"><unclear cert="medium" resp="#joint">5</unclear>. Septembris
