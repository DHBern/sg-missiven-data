<lb n="34"/>und <unclear cert="low" resp="#joint">hochschedlichen</unclear> <unclear cert="low" resp="#joint">Ufsclag</unclear> gemacht, <unclear cert="medium" resp="#joint">das</unclear> <unclear cert="medium" resp="#joint">Reiche</unclear>,
<lb n="35"/><unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">arme</unclear>, <unclear cert="medium" resp="#joint">frembde</unclear>, unnd <unclear cert="low" resp="#joint">heimsche</unclear>, sonderlich
<lb n="36"/>aber die <unclear cert="low" resp="#joint">Ienigen</unclear>, die das gantz Jahr uf den besten,
<lb n="37"/>oder <unclear cert="low" resp="#joint">hoechsten</unclear> <unclear cert="low" resp="#joint">marckht</unclear> <unclear cert="low" resp="#joint">dingckh</unclear> <unclear cert="low" resp="#joint">Korn</unclear> <unclear cert="low" resp="#joint">essen</unclear>, hoch-
<lb n="38"/>lich entgelten, unnd empfinden <unclear cert="low" resp="#joint">muessen</unclear>.
<lb n="39"/><unclear cert="low" resp="#joint">Dieweil</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">zweiflen</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ehr</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="40"/>werden <unclear cert="low" resp="#joint">abgedachten</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Wetzlers</unclear></persName> <unclear cert="low" resp="#joint">hochschedlich</unclear>-
<lb n="41"/>en <unclear cert="low" resp="#joint">uberfharen</unclear>, selbsten ein <unclear cert="low" resp="#joint">schuldgdig</unclear> <unclear cert="low" resp="#joint">miß</unclear>-
<lb n="42"/>fallen tragen, auch <unclear cert="low" resp="#joint">dabey</unclear> <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">leichtlich</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">erlernen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">abnemmen</unclear> <unclear cert="low" resp="#joint">khunden</unclear>, das er
<lb n="44"/>ein <unclear cert="low" resp="#joint">vil</unclear> <unclear cert="low" resp="#joint">hohere</unclear> <unclear cert="low" resp="#joint">straf</unclear> <unclear cert="low" resp="#joint">verdient</unclear> <unclear cert="low" resp="#joint">hette</unclear>, <unclear cert="low" resp="#joint">Wollen</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">inen</unclear> gegen <unclear cert="medium" resp="#joint">derselben</unclear> nachparlichen er-
<lb n="46"/><unclear cert="low" resp="#joint">pieten</unclear>, <unclear cert="low" resp="#joint">Inordenlich</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">nit</unclear> allein <unclear cert="low" resp="#joint">zuer</unclear> schuld-
<lb n="47"/>igen abrichtung <unclear cert="low" resp="#joint">angeregter</unclear> <unclear cert="low" resp="#joint">38</unclear>. <unclear cert="low" resp="#joint">lb</unclear>. <unclear cert="low" resp="#joint">h</unclear>. <unclear cert="low" resp="#joint">straf</unclear>,
<lb n="48"/><unclear cert="low" resp="#joint">weisen</unclear>, unnd halten, sonder auch das er sich
<lb n="49"/><unclear cert="low" resp="#joint">hinfuero</unclear> <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">bescheidenlicher</unclear>, unnd er-
<lb n="50"/><unclear cert="medium" resp="#joint">dachtlicher</unclear> mit <unclear cert="medium" resp="#joint">reden</unclear>, unnd <unclear cert="low" resp="#joint">einkhaufung</unclear> der
<lb n="51"/>fruchten erzeigen wolle, mit <unclear cert="low" resp="#joint">Oberkheitlich</unclear>-
<lb n="52"/>em ernst <unclear cert="low" resp="#joint">befelhen</unclear> unnd <unclear cert="low" resp="#joint">uferlegen</unclear>. <unclear cert="low" resp="#joint">Wolt</unclear>-
<lb n="53"/>en <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Ehr</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. zue <unclear cert="low" resp="#joint">grundtlichem</unclear> gegen-
