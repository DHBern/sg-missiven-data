<lb n="31"/><unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">Iren</unclear> <unclear cert="low" resp="#joint">Bairischen</unclear> <unclear cert="low" resp="#joint">kasten</unclear> <unclear cert="low" resp="#joint">bogs</unclear>, <unclear cert="low" resp="#joint">darmalen</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">zwen</unclear> <unclear cert="low" resp="#joint">f</unclear>. <unclear cert="low" resp="#joint">xr</unclear>. <unclear cert="low" resp="#joint">k</unclear>. <unclear cert="low" resp="#joint">hoeser</unclear>, alß <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">acht</unclear> <unclear cert="low" resp="#joint">tag</unclear> <unclear cert="low" resp="#joint">darvor</unclear>
