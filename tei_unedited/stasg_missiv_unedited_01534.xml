<lb n="4"/><unclear cert="medium" resp="#joint">ermaßen</unclear> in <unclear cert="low" resp="#joint">dero</unclear>, an <unclear cert="medium" resp="#joint">deß</unclear> hochwürdigen, <unclear cert="medium" resp="#joint">unsers</unclear> <unclear cert="medium" resp="#joint">gnedigen</unclear>
