        <body>
<p>
<pb facs="StadtASG_Missive_2917_11459.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich willig dienst, sambt was wir ehren, <unclear cert="medium" resp="#joint">liebe</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegend</unclear>, <unclear cert="medium" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">From</unclear>, Fürsichtig, <unclear cert="medium" resp="#joint">Ehrsam</unclear>
<lb n="3"/>Wyß, <unclear cert="medium" resp="#joint">Innsonders</unclear> <unclear cert="medium" resp="#joint">guet</unclear> fründ und <unclear cert="medium" resp="#joint">getrüw</unclear> lieb <unclear cert="medium" resp="#joint">Eidtgnoßen</unclear>.
<lb n="4"/><unclear cert="medium" resp="#joint">Uns</unclear> ist üwer schryben von widerbringern diß zuo recht <unclear cert="medium" resp="#joint">yn</unclear>-
<lb n="5"/><unclear cert="medium" resp="#joint">gelifferet</unclear> worden, <unclear cert="medium" resp="#joint">thuend</unclear> unns <unclear cert="medium" resp="#joint">beuordrist</unclear> umb die <unclear cert="medium" resp="#joint">comuni</unclear>-
<lb n="6"/>cation der üch <unclear cert="medium" resp="#joint">yngelangten</unclear> <unclear cert="medium" resp="#joint">zytungen</unclear> <unclear cert="medium" resp="#joint">Eidtgnoßisch</unclear> be-
<lb n="7"/><unclear cert="medium" resp="#joint">danken</unclear> und <unclear cert="medium" resp="#joint">Gott</unclear> bitten, Er <unclear cert="medium" resp="#joint">Irer</unclear> <unclear cert="medium" resp="#joint">Koen</unclear>. <unclear cert="medium" resp="#joint">Mt</unclear>. inn <placeName ref="stadtasg-places-248" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schwed</unclear>-
<lb n="8"/><unclear cert="medium" resp="#joint">en</unclear></placeName> waaffen <unclear cert="medium" resp="#joint">ferner</unclear> mit gnaden <unclear cert="medium" resp="#joint">dergstalt</unclear> <unclear cert="medium" resp="#joint">seegnen</unclear> <unclear cert="medium" resp="#joint">wolle</unclear>,
<lb n="9"/>damit der ein zyt har <unclear cert="medium" resp="#joint">eben</unclear> vast <unclear cert="medium" resp="#joint">betrüebten</unclear> <unclear cert="medium" resp="#joint">kirchen</unclear> <unclear cert="medium" resp="#joint">Christi</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">wider</unclear> <unclear cert="medium" resp="#joint">herfür</unclear> geholffen, dieselb recht <unclear cert="medium" resp="#joint">grüen</unclear>, und der
<lb n="11"/><unclear cert="medium" resp="#joint">widerpart</unclear> <unclear cert="medium" resp="#joint">tyranischer</unclear> <unclear cert="medium" resp="#joint">gwalt</unclear> <unclear cert="medium" resp="#joint">gedembt</unclear> werden <unclear cert="medium" resp="#joint">moege</unclear>.
<lb n="12"/><unclear cert="medium" resp="#joint">Das</unclear> demnach Ir unnser <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">für</unclear> die <unclear cert="medium" resp="#joint">üwerm</unclear> <unclear cert="medium" resp="#joint">jüngst</unclear>
<lb n="13"/>zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="medium" resp="#joint">gehebten</unclear> <unclear cert="medium" resp="#joint">Ehrengsandten</unclear> <unclear cert="medium" resp="#joint">bewüßter</unclear> handlung
<lb n="14"/>halber <unclear cert="medium" resp="#joint">erzeigte</unclear> befürderung üch so fast <unclear cert="medium" resp="#joint">bedankend</unclear>, <unclear cert="medium" resp="#joint">were</unclear>
<lb n="15"/>es solcher <unclear cert="medium" resp="#joint">danksagung</unclear> <unclear cert="medium" resp="#joint">unvonnoeten</unclear>, <unclear cert="medium" resp="#joint">angesehen</unclear>, wir
<lb n="16"/><orgName resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoßen</unclear></orgName> inn derglychen und anderen <unclear cert="medium" resp="#joint">fürfallenheiten</unclear>
<lb n="17"/>ein <unclear cert="medium" resp="#joint">anderen</unclear> beholffen <unclear cert="medium" resp="#joint">zcsind</unclear>, uns schuldig wüßend, und
<lb n="18"/>auch das <unclear cert="medium" resp="#joint">wenige</unclear> zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> mit <unclear cert="medium" resp="#joint">guetem</unclear> willen <unclear cert="medium" resp="#joint">beschech</unclear>-
<lb n="19"/>en ist. Da wir hieby <unclear cert="medium" resp="#joint">unnserm</unclear> <unclear cert="medium" resp="#joint">hievor</unclear> von ange-
<lb n="20"/><unclear cert="medium" resp="#joint">düteter</unclear> handlung wegen zuo <placeName ref="stadtasg-places-14" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Inßbrugg</unclear></placeName> <unclear cert="medium" resp="#joint">geweßnen</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">stattlaeuffer</unclear> üwerm begehren nach <unclear cert="medium" resp="#joint">anbeuolchen</unclear> habend
<lb n="22"/>sich <unclear cert="medium" resp="#joint">unverlengt</unclear> zuo üch <unclear cert="medium" resp="#joint">zuouerfüegen</unclear> und von dannen
<lb n="23"/>die <unclear cert="medium" resp="#joint">reiß</unclear> <unclear cert="medium" resp="#joint">naher</unclear> bemelten <placeName ref="stadtasg-places-14" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Inßbrugg</unclear></placeName> <unclear cert="medium" resp="#joint">fürzenemmen</unclear>.
<lb n="24"/>Dann üch <unclear cert="medium" resp="#joint">unnseren</unclear> <unclear cert="medium" resp="#joint">getrüwen</unclear> lieben <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoßen</unclear></orgName> an-
<lb n="25"/><unclear cert="medium" resp="#joint">genembheit</unclear>, dienst und <unclear cert="medium" resp="#joint">gfallens</unclear> <unclear cert="medium" resp="#joint">zuoerwyßen</unclear>, sind wir
<lb n="26"/>so <unclear cert="medium" resp="#joint">urbietig</unclear> <unclear cert="medium" resp="#joint">und</unclear> willig, als wir <unclear cert="medium" resp="#joint">Gott</unclear> den <unclear cert="medium" resp="#joint">hern</unclear> bittend,
<lb n="27"/>er ob unns sambtlich mit synen <unclear cert="medium" resp="#joint">ferneren</unclear> gnaden ze-
<lb n="28"/>halten <unclear cert="medium" resp="#joint">gruoche</unclear>. Datum den <origDate when="1632-05-28" resp="#ner">28ten <unclear cert="medium" resp="#joint">Maii</unclear> <unclear cert="medium" resp="#joint">A°</unclear>. 1632</origDate>.
<lb n="29"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und Rath
<lb n="30"/>der statt Zürich</orgName>.
<pb facs="StadtASG_Missive_2917_11460.jpg" n="2"/>
<pb facs="StadtASG_Missive_2917_11461.jpg" n="3"/>
<pb facs="StadtASG_Missive_2917_11462.jpg" n="4"/>
<lb n="31"/>Den frommen <unclear cert="low" resp="#joint">fuersichtigen</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">ehrsamen</unclear> <unclear cert="low" resp="#joint">wyßen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeist</unclear>-
<lb n="33"/><unclear cert="low" resp="#joint">er</unclear> und Rath der Statt S. <unclear cert="low" resp="#joint">Gall</unclear>-
<lb n="34"/><unclear cert="low" resp="#joint">en</unclear></orgName>, <unclear cert="low" resp="#joint">unseren</unclear> innsonders
<lb n="35"/>guoten fruenden und gethruewen
<lb n="36"/>lieben Eydtgnossen.
</p>
