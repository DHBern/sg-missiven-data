<pb facs="StadtASG_Missive_2147_8048.jpg" n="4"/>
<lb n="81"/>An <unclear cert="low" resp="#joint">Ußroden</unclear> <origPlace ref="stadtasg-places-8" cert="medium" resp="#ner">Appenzell</origPlace>
