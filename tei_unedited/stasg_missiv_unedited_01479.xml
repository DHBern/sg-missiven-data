<lb n="67"/>Wölliches E. E. F. E. W. <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">antwuerdt</unclear> <unclear cert="low" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">obgemelt</unclear>,
