<p>
<pb facs="StadtASG_Missive_2892_11367.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> fründtlich willig dienst, sambt was wir ehren liebs und guots vermögend,
<lb n="2"/><unclear cert="medium" resp="#joint">zuovor</unclear>, fromm fürsichtig, <unclear cert="low" resp="#joint">ehrsam</unclear> <unclear cert="low" resp="#joint">wyß</unclear> <unclear cert="low" resp="#joint">insonders</unclear> <unclear cert="low" resp="#joint">guot</unclear> <unclear cert="low" resp="#joint">fründ</unclear>, und <unclear cert="low" resp="#joint">getrüw</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">eidgnoßen</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">üwere</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">religions</unclear> <unclear cert="low" resp="#joint">gnoßen</unclear> zuo <placeName ref="stadtasg-places-73" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Glaruß</unclear></placeName> ein
<lb n="5"/>schryben an uns die übrigen evangelischen <unclear cert="medium" resp="#joint">ort</unclear> <unclear cert="medium" resp="#joint">gmeinlich</unclear> abgehn <unclear cert="medium" resp="#joint">laßen</unclear>,
<lb n="6"/><unclear cert="medium" resp="#joint">darinn</unclear> sy <unclear cert="medium" resp="#joint">ires</unclear> gegen iren <unclear cert="low" resp="#joint">mitlandtlüten</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">religion</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="7"/>noch <unclear cert="low" resp="#joint">haltenden</unclear> <unclear cert="low" resp="#joint">bevogtigungsspanns</unclear> <unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">gmeinen</unclear> <unclear cert="low" resp="#joint">raths</unclear> pflegen
<lb n="8"/><unclear cert="medium" resp="#joint">tuond</unclear>. Haben wir üch <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">deßen</unclear> durch <unclear cert="low" resp="#joint">cöplichen</unclear> <unclear cert="low" resp="#joint">yn</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">schluß</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">teilhafft</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">machen</unclear> nit <unclear cert="low" resp="#joint">umbgang</unclear> <unclear cert="low" resp="#joint">nemmen</unclear> <unclear cert="low" resp="#joint">söllen</unclear>, <unclear cert="low" resp="#joint">üch</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">üwerer</unclear> meinung <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guotachtens</unclear> <unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">eintweders</unclear> gegen besagten
<lb n="11"/><unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">eid</unclear>: und <unclear cert="low" resp="#joint">religions</unclear> <unclear cert="low" resp="#joint">gnoßen</unclear> <unclear cert="low" resp="#joint">von</unclear> <placeName ref="stadtasg-places-73" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Glaruß</unclear></placeName>, <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">eidgnößisch</unclear> zuo
<lb n="12"/><unclear cert="medium" resp="#joint">erkleren</unclear> zehaben. <unclear cert="medium" resp="#joint">In</unclear> <unclear cert="medium" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">tuond</unclear> wir uns <unclear cert="low" resp="#joint">sambtlich</unclear> <unclear cert="low" resp="#joint">göttlicher</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">beschirmung</unclear> wol <unclear cert="low" resp="#joint">empfehlen</unclear>. <unclear cert="low" resp="#joint">Actum</unclear> <unclear cert="low" resp="#joint">den</unclear> <origDate when="1632" resp="#ner"><unclear cert="low" resp="#joint">9</unclear>. <unclear cert="low" resp="#joint">t</unclear> februarii <unclear cert="medium" resp="#joint">a°</unclear> <unclear cert="medium" resp="#joint">1632</unclear></origDate>
<lb n="14"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und rath
<lb n="15"/>der statt Zürich</orgName>.
<pb facs="StadtASG_Missive_2892_11368.jpg" n="2"/>
<pb facs="StadtASG_Missive_2892_11369.jpg" n="3"/>
<pb facs="StadtASG_Missive_2892_11370.jpg" n="4"/>
<lb n="16"/>Den frommen fuersichtigen, ehrsamen
<lb n="17"/>wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und Rath der
<lb n="18"/>Stadt St. Gallen</orgName>. Unseren insonders
<lb n="19"/><unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">fruenden</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">getruewen</unclear> lieben
<lb n="20"/>Eidtgnoßen.
</p>
