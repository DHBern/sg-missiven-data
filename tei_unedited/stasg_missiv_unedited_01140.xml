<lb n="51"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Wilderer</unclear></persName> <unclear cert="medium" resp="#joint">ain</unclear> <unclear cert="medium" resp="#joint">dienstmagdt</unclear> so <unclear cert="low" resp="#joint">zuuor</unclear> neben ime im
<lb n="52"/>Grieß gedient, <unclear cert="low" resp="#joint">ain</unclear> kind <unclear cert="low" resp="#joint">geben</unclear>. Unnd er <unclear cert="medium" resp="#joint">Wilderer</unclear>
<lb n="53"/>sy <unclear cert="medium" resp="#joint">zeügin</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">ainer</unclear> <unclear cert="medium" resp="#joint">gfätteren</unclear> genommen. Unnd <unclear cert="medium" resp="#joint">also</unclear>
<lb n="54"/>er <unclear cert="medium" resp="#joint">Wilderer</unclear> söllich kind uff sich <unclear cert="low" resp="#joint">alß</unclear> den vatter,
<lb n="55"/>touffen lassen. Und <unclear cert="medium" resp="#joint">sy</unclear> <unclear cert="medium" resp="#joint">zeügin</unclear> <unclear cert="medium" resp="#joint">deß</unclear> kindts touffgotten
<lb n="56"/><unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">seye</unclear> Katharina <unclear cert="medium" resp="#joint">gehaissen</unclear> wordenn.
<lb n="57"/><persName resp="#ner">Hainrich Aberlin</persName> <unclear cert="low" resp="#joint">spittalmaister</unclear> <unclear cert="low" resp="#joint">sagt</unclear>, <unclear cert="low" resp="#joint">das</unclear> an der
