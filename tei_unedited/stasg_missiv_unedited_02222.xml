<p>
<pb facs="StadtASG_Missive_2222_8397.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freundtlich</unclear> willig dienst <unclear cert="medium" resp="#joint">zuovor</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">Fuersichtigen</unclear>, <unclear cert="medium" resp="#joint">Ehrsamen</unclear> und <unclear cert="medium" resp="#joint">Weisen</unclear>, be-
<lb n="3"/>sonders liebe <unclear cert="medium" resp="#joint">Freundt</unclear> und <unclear cert="low" resp="#joint">Nachbarn</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">abermaliges</unclear> <unclear cert="low" resp="#joint">den</unclear> <date resp="#ner">16. diß abgangen</date>
<lb n="5"/><unclear cert="medium" resp="#joint">vertraulich</unclear> <unclear cert="medium" resp="#joint">schreiben</unclear>, und <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">gethone</unclear> <unclear cert="low" resp="#joint">guote</unclear> auisation,
<lb n="6"/>was sich <unclear cert="medium" resp="#joint">verners</unclear> in den <unclear cert="medium" resp="#joint">Puendten</unclear> begeben,
<lb n="7"/>ist uns wol <unclear cert="medium" resp="#joint">zuokomen</unclear>, <unclear cert="medium" resp="#joint">darfuer</unclear> wir uns,
<lb n="8"/>wie allweg <unclear cert="medium" resp="#joint">freundt</unclear> nachbarlich <unclear cert="medium" resp="#joint">thuen</unclear> <unclear cert="medium" resp="#joint">bedancken</unclear>,
<lb n="9"/>und weil <unclear cert="medium" resp="#joint">diser</unclear> <unclear cert="medium" resp="#joint">laidige</unclear> handel <unclear cert="low" resp="#joint">besorglich</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">weiters</unclear> <unclear cert="low" resp="#joint">außbrechen</unclear> <unclear cert="low" resp="#joint">moechte</unclear>, und den <unclear cert="medium" resp="#joint">benachbarte</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">obgelegen</unclear>, <unclear cert="medium" resp="#joint">darauff</unclear> <unclear cert="medium" resp="#joint">wachende</unclear> <unclear cert="medium" resp="#joint">augen</unclear> <unclear cert="medium" resp="#joint">zehaben</unclear>,
<lb n="12"/><unclear cert="medium" resp="#joint">alß</unclear> bitten wir, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">vormals</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">wollen</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">fuerters</unclear> solche auisation continuieren,
<lb n="14"/><unclear cert="medium" resp="#joint">das</unclear> <unclear cert="medium" resp="#joint">sein</unclear> wir <unclear cert="medium" resp="#joint">ebenmeßig</unclear> uff allen <unclear cert="low" resp="#joint">fuerfall</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">zethuon</unclear> <unclear cert="low" resp="#joint">erbietig</unclear>, und <unclear cert="medium" resp="#joint">verbleiben</unclear> <unclear cert="medium" resp="#joint">Jnen</unclear> <unclear cert="medium" resp="#joint">zuo</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">guoter</unclear> nachbarlichen <unclear cert="medium" resp="#joint">vertraulichkait</unclear> be-
<lb n="17"/><unclear cert="medium" resp="#joint">harrlichen</unclear> <unclear cert="medium" resp="#joint">beigethon</unclear>, datum <origDate when="1620-07-21" resp="#ner"><unclear cert="medium" resp="#joint">21</unclear>. <unclear cert="medium" resp="#joint">Julij</unclear>.
<lb n="18"/><unclear cert="medium" resp="#joint">a.o</unclear> 1620.</origDate>
<lb n="19"/><orgName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> und Rhat
<lb n="20"/>der Statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_2222_8398.jpg" n="2"/>
<pb facs="StadtASG_Missive_2222_8399.jpg" n="3"/>
<pb facs="StadtASG_Missive_2222_8400.jpg" n="4"/>
<lb n="21"/>Den fürsichtigen ersamen und <unclear cert="medium" resp="#joint">weysen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="22"/>maister und <unclear cert="medium" resp="#joint">Rhat</unclear> der statt St. Gallen</orgName> unsern
<lb n="23"/><unclear cert="medium" resp="#joint">besonders</unclear> lieben <unclear cert="low" resp="#joint">freünden</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">nachbaurn</unclear>.
<lb n="24"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
