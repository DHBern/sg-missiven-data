<lb n="17"/>collecta von sonderbaren <unclear cert="medium" resp="#joint">rysteren</unclear> <unclear cert="medium" resp="#joint">guothertzig</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">uffgehebt</unclear> <unclear cert="medium" resp="#joint">worden</unclear> ist. Darfür wir unß gegen
<lb n="19"/>E. E. W. wie ouch <unclear cert="medium" resp="#joint">denen</unclear> sonderbaren <unclear cert="medium" resp="#joint">herren</unclear>,
<lb n="20"/>in unser unnd unser lieben kilchgnoßen
