<lb n="4"/><unclear cert="low" resp="#joint">alhar</unclear> zuo <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="medium" resp="#joint">verfuegt</unclear> der <unclear cert="medium" resp="#joint">ehrwürdige</unclear> wolge-
<lb n="5"/><unclear cert="low" resp="#joint">lerte</unclear> herr, unser lieber und gueter <unclear cert="low" resp="#joint">fründt</unclear> <persName resp="#ner">Bartholo-
<lb n="6"/><unclear cert="low" resp="#joint">meues</unclear> <unclear cert="low" resp="#joint">Anhorn</unclear></persName>, diener des <unclear cert="low" resp="#joint">göttlichens</unclear> wort in
<lb n="7"/><placeName ref="stadtasg-places-12" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Meienfeldt</unclear></placeName>, sampt <unclear cert="medium" resp="#joint">einem</unclear> <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">abgesanten</unclear>
<lb n="8"/>botten, wölcher unß <unclear cert="low" resp="#joint">uberantwortet</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="9"/>fründtliches schryben, und darnebennt zuo unser
<lb n="10"/><unclear cert="low" resp="#joint">gethreüwen</unclear> lieben <unclear cert="low" resp="#joint">grichts</unclear> und <unclear cert="low" resp="#joint">kilchgnoßen</unclear>
