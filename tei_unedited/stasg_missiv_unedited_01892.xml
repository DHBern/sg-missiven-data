<lb n="22"/><unclear cert="low" resp="#joint">gnößisch</unclear> <unclear cert="low" resp="#joint">thunde</unclear> <unclear cert="medium" resp="#joint">bedancken</unclear>, den <unclear cert="low" resp="#joint">allmechtigen</unclear>
<lb n="23"/>Gott, dem <unclear cert="low" resp="#joint">sölches</unclear> zuo ehren beschicht, bittende,
<lb n="24"/>das er <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">uwer</unclear> <unclear cert="low" resp="#joint">lobl</unclear>. statt und <unclear cert="medium" resp="#joint">regiment</unclear>
