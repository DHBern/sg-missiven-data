<p>
<pb facs="StadtASG_Missive_1502_5409.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Wolgeachter</unclear>, wolgeborner, <unclear cert="low" resp="#joint">gnediger</unclear> herr,
<lb n="2"/>e. <unclear cert="medium" resp="#joint">gn</unclear>. <unclear cert="medium" resp="#joint">seÿen</unclear> unser <unclear cert="low" resp="#joint">vhleissig</unclear> willig dienst
<lb n="3"/>mit <unclear cert="low" resp="#joint">erbiertung</unclear> aller ehren <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">gnediger</unclear>
<lb n="4"/>herr. Nachdem e. <unclear cert="medium" resp="#joint">gn</unclear>.
<lb n="5"/>im <unclear cert="medium" resp="#joint">jüngstvergnern</unclear> <unclear cert="medium" resp="#joint">monat</unclear> <date resp="#ner"><unclear cert="medium" resp="#joint">Martzen</unclear></date>, <unclear cert="medium" resp="#joint">unsern</unclear>
<lb n="6"/>damalen zu <placeName ref="stadtasg-places-49" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Solothurn</unclear></placeName> (<unclear cert="medium" resp="#joint">eines</unclear> <unclear cert="medium" resp="#joint">andern</unclear> <unclear cert="medium" resp="#joint">gscheftes</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">halber</unclear>) <unclear cert="medium" resp="#joint">fürgereiseten</unclear> <unclear cert="medium" resp="#joint">rhatsgsandten</unclear>, alß
<lb n="8"/>dieselben, auß <unclear cert="medium" resp="#joint">unserm</unclear> befelch, <unclear cert="medium" resp="#joint">beÿ</unclear> e. <unclear cert="medium" resp="#joint">gn</unclear>.
<lb n="9"/>wegen der <unclear cert="low" resp="#joint">verfallnen</unclear> <unclear cert="low" resp="#joint">außstehenden</unclear> bezalungen
<lb n="10"/><unclear cert="low" resp="#joint">dienstvhleißig</unclear> angehalten, disen gnedigen
<lb n="11"/><unclear cert="medium" resp="#joint">bescheid</unclear> <unclear cert="low" resp="#joint">erfolgen</unclear> lassen, daß e. <unclear cert="medium" resp="#joint">gn</unclear>. unß
<lb n="12"/><unclear cert="low" resp="#joint">dessen</unclear> in <unclear cert="medium" resp="#joint">kuertze</unclear>, und <unclear cert="low" resp="#joint">namlich</unclear> <unclear cert="low" resp="#joint">ungfher</unclear> in
<lb n="13"/><date resp="#ner"><unclear cert="low" resp="#joint">dreÿen</unclear> <unclear cert="low" resp="#joint">wochen</unclear></date>, <unclear cert="low" resp="#joint">schriftlich</unclear> <unclear cert="low" resp="#joint">wöllen</unclear> <unclear cert="low" resp="#joint">anfüegen</unclear>,
<lb n="14"/>die <unclear cert="medium" resp="#joint">angeregten</unclear> <unclear cert="medium" resp="#joint">bezalungen</unclear>,
<lb n="15"/><unclear cert="medium" resp="#joint">zuoerheben</unclear> und abzufordern, beschriben
<lb n="16"/><unclear cert="low" resp="#joint">wöllen</unclear>. Und <unclear cert="medium" resp="#joint">aber</unclear> <unclear cert="medium" resp="#joint">von</unclear> e. <unclear cert="medium" resp="#joint">gn</unclear>. unß
<lb n="17"/>deßhalb noch <unclear cert="low" resp="#joint">bißhar</unclear> <unclear cert="medium" resp="#joint">nüts</unclear> <unclear cert="low" resp="#joint">angefüegt</unclear> worden. <unclear cert="low" resp="#joint">Alß</unclear>
<lb n="18"/>bitten e. <unclear cert="medium" resp="#joint">gn</unclear>. wir hiemit zum <unclear cert="low" resp="#joint">vhleissigisten</unclear>,
<lb n="19"/>unß <unclear cert="medium" resp="#joint">zu</unclear> keinem <unclear cert="low" resp="#joint">ungueten</unclear> <unclear cert="low" resp="#joint">zuvermerckhen</unclear>,
<lb n="20"/>daß wir <unclear cert="medium" resp="#joint">vrsach</unclear> genomen, dieselben hie-
<lb n="21"/>durch diß <unclear cert="medium" resp="#joint">schriben</unclear> <unclear cert="low" resp="#joint">zuermanen</unclear>, daß <unclear cert="medium" resp="#joint">sÿ</unclear>
<lb n="22"/>unser in gnaden eingedenckh sein <unclear cert="medium" resp="#joint">wöllen</unclear>,
<lb n="23"/>damit unß <unclear cert="low" resp="#joint">obangedeüter</unclear> bezalungen
<lb n="24"/>halber, gleiche gunst und <unclear cert="medium" resp="#joint">willfharung</unclear> (wie
<lb n="25"/>andern <unclear cert="medium" resp="#joint">orten</unclear> loblicher <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eidgnoschafft</unclear></orgName>) begegnen,
<lb n="26"/><unclear cert="low" resp="#joint">on</unclear> <unclear cert="low" resp="#joint">lengern</unclear> <unclear cert="low" resp="#joint">aufzug</unclear> und widerfaren <unclear cert="low" resp="#joint">möge</unclear>. Und wir <unclear cert="medium" resp="#joint">darbeÿ</unclear>
<lb n="27"/>e. <unclear cert="medium" resp="#joint">gn</unclear>. <unclear cert="medium" resp="#joint">guter</unclear> affection hiebey destomehr
<lb n="28"/><unclear cert="medium" resp="#joint">versicheret</unclear> werden, auch dero <unclear cert="low" resp="#joint">hiefür</unclear> <unclear cert="low" resp="#joint">vhleißigen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">danckh</unclear> sagen mögen. <unclear cert="low" resp="#joint">Inmassen</unclear> gegen
<lb n="30"/>e. <unclear cert="medium" resp="#joint">gn</unclear>. wir mit unsern willigen diensten
<lb n="31"/><unclear cert="medium" resp="#joint">unß</unclear> geneigt begeren <unclear cert="low" resp="#joint">erfinden</unclear> <unclear cert="low" resp="#joint">zulassen</unclear>.
<lb n="32"/>Alß wir gott <unclear cert="medium" resp="#joint">für</unclear> e. <unclear cert="medium" resp="#joint">gn</unclear>. und <unclear cert="medium" resp="#joint">derselben</unclear>
<lb n="33"/><unclear cert="medium" resp="#joint">wollstand</unclear> von hertzen bitten, und darmit
<lb n="34"/>unß zu e. <unclear cert="medium" resp="#joint">gn</unclear>. (dero schriftliche antwurt
<lb n="35"/>wir ohnverlengt <unclear cert="low" resp="#joint">erwarten</unclear>) in <unclear cert="low" resp="#joint">treüwen</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">befelch</unclear> <unclear cert="low" resp="#joint">thund</unclear>. Dat. <origDate when="1606" resp="#ner">26. <unclear cert="medium" resp="#joint">d</unclear>. maji anno 1606</origDate>.
<lb n="37"/>e. <unclear cert="medium" resp="#joint">gn</unclear>. dienstwillige <orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">b. u. r. d. st. <unclear cert="low" resp="#joint">st</unclear>. <unclear cert="low" resp="#joint">gl</unclear>.</orgName>
<lb n="38"/>Dem hochgeachten <unclear cert="medium" resp="#joint">wolgebornen</unclear> herren,
<lb n="39"/>herrn <persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">N</unclear>. <unclear cert="low" resp="#joint">Ammann</unclear></persName>, <unclear cert="low" resp="#joint">kü</unclear>. <unclear cert="low" resp="#joint">Mt</unclear>. <unclear cert="low" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-131" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Franckhrich</unclear></placeName>
<lb n="40"/><unclear cert="low" resp="#joint">und</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Navarren</unclear></placeName> <unclear cert="low" resp="#joint">ambassadoren</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">lob</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">licher</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidgnoschafft</unclear></orgName>, <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">gned</unclear>. <unclear cert="low" resp="#joint">herrn</unclear>.
<lb n="42"/><unclear cert="low" resp="#joint">ref</unclear>. <unclear cert="low" resp="#joint">herrn</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Schb</unclear>.</persName> <unclear cert="low" resp="#joint">und</unclear>
<pb facs="StadtASG_Missive_1502_5410.jpg" n="2"/>
<lb n="43"/>An <unclear cert="low" resp="#joint">frantzoesischen</unclear> Ambassadorn zuo <placeName ref="stadtasg-places-49" cert="medium" resp="#ner">Solo-
<lb n="44"/>thurn</placeName>, <origDate when="1606-05-26" resp="#ner">26. <unclear cert="medium" resp="#joint">Maij</unclear> 1606</origDate>.
</p>
