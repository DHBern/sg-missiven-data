<pb facs="StadtASG_Missive_881_2501.JPG" n="1"/>
<lb n="1"/>Min <unclear cert="low" resp="#joint">fruenttlichen</unclear> gruos, mitt <unclear cert="low" resp="#joint">erbiettung</unclear> alles guots zuovor. From <unclear cert="low" resp="#joint">edel</unclear>, vest,
<lb n="2"/>fuersichtig wyß, <unclear cert="medium" resp="#joint">jnsunders</unclear> guenstig lieb herren, und guott fruendt. Als
<lb n="3"/>dan der <unclear cert="medium" resp="#joint">tresorier</unclear> <unclear cert="medium" resp="#joint">alhar</unclear> gen <placeName ref="stadtasg-places-49" cert="medium" resp="#ner">Solenthurn</placeName> mitt dem gelt der pensionen
<lb n="4"/>ist <unclear cert="low" resp="#joint">ankhomen</unclear>, hab ich <unclear cert="medium" resp="#joint">nitt</unclear> wellen underlaßen, <unclear cert="low" resp="#joint">uech</unclear> des <unclear cert="low" resp="#joint">unverzogenlich</unclear>
<lb n="5"/>zuberichten, von wegen der <unclear cert="medium" resp="#joint">großen</unclear> begirde, so die <unclear cert="medium" resp="#joint">allercristenlichoste</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">kueng</unclear>. <unclear cert="medium" resp="#joint">mt</unclear>. hatt, <unclear cert="medium" resp="#joint">uech</unclear> <unclear cert="medium" resp="#joint">zuebenuegen</unclear> umb dz <unclear cert="low" resp="#joint">jhenig</unclear> so man <unclear cert="low" resp="#joint">uech</unclear> schuldig, unnd
<lb n="7"/><unclear cert="medium" resp="#joint">och</unclear> <unclear cert="medium" resp="#joint">zueentrichten</unclear> versprochen. <unclear cert="medium" resp="#joint">Und</unclear> diewyl (<unclear cert="medium" resp="#joint">vermog</unclear> des <unclear cert="low" resp="#joint">abscheydts</unclear> der <unclear cert="low" resp="#joint">zue</unclear>
<lb n="8"/><placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> ist <unclear cert="low" resp="#joint">ußgangen</unclear> als man <unclear cert="medium" resp="#joint">jn</unclear> der <unclear cert="medium" resp="#joint">vereynung</unclear> <unclear cert="medium" resp="#joint">gehandlett</unclear>) abgeredt
<lb n="9"/><unclear cert="medium" resp="#joint">worden</unclear>, dz man <unclear cert="medium" resp="#joint">uech</unclear> <unclear cert="medium" resp="#joint">jn</unclear> <unclear cert="medium" resp="#joint">disem</unclear> <unclear cert="medium" resp="#joint">lxvjen</unclear> <unclear cert="medium" resp="#joint">jhar</unclear> zwo <unclear cert="medium" resp="#joint">pension</unclear> <unclear cert="medium" resp="#joint">solle</unclear> bezalen, als
