<lb n="11"/>umb dis <date resp="#ner"><unclear cert="low" resp="#joint">lxvjen</unclear></date> jar. Von deßwegen <unclear cert="medium" resp="#joint">wellen</unclear> <unclear cert="medium" resp="#joint">uech</unclear> <unclear cert="medium" resp="#joint">gfallen</unclear> <unclear cert="medium" resp="#joint">uwer</unclear>
