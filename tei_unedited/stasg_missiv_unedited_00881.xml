<lb n="17"/><origDate when="1566-04-29" resp="#ner">den <unclear cert="medium" resp="#joint">29ten</unclear> <unclear cert="medium" resp="#joint">Aprillis</unclear> <unclear cert="medium" resp="#joint">1566</unclear></origDate>.
