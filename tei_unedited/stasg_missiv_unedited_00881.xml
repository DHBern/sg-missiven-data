<lb n="21"/>dz jr <unclear cert="low" resp="#joint">uewere</unclear> quittantzen also <unclear cert="low" resp="#joint">uffrichten</unclear> oder allein blanck <unclear cert="medium" resp="#joint">harschicken</unclear> <unclear cert="medium" resp="#joint">etc</unclear>.
<lb n="22"/><unclear cert="medium" resp="#joint">Wytter</unclear> <unclear cert="medium" resp="#joint">welle</unclear> <unclear cert="medium" resp="#joint">uech</unclear> ouch gfallen <unclear cert="low" resp="#joint">uwere</unclear> bottschafft <unclear cert="low" resp="#joint">eynn</unclear> gemeyne quitantz
