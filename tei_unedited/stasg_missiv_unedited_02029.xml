    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2029_7577.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freuendt</unclear>- <unclear cert="low" resp="#joint">nachbarlich</unclear> willig dienst und grueß zuvor,
<lb n="2"/><unclear cert="low" resp="#joint">edler</unclear> <unclear cert="low" resp="#joint">vester</unclear>, <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">lieber</unclear> <unclear cert="low" resp="#joint">Herr</unclear> <unclear cert="low" resp="#joint">Vogt</unclear>, <unclear cert="low" resp="#joint">guter</unclear> <unclear cert="low" resp="#joint">freuend</unclear>
<lb n="3"/>und nachbar.
<lb n="4"/><unclear cert="medium" resp="#joint">Uns</unclear> hat unser burger <persName resp="#ner">Hanns <unclear cert="low" resp="#joint">Tobler</unclear></persName> der <unclear cert="low" resp="#joint">mezger</unclear> <unclear cert="low" resp="#joint">under</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">thenig</unclear> berichtet, welcher <unclear cert="medium" resp="#joint">maßen</unclear> <unclear cert="medium" resp="#joint">euwer</unclear> <unclear cert="medium" resp="#joint">amptsan</unclear>-
<lb n="6"/><unclear cert="medium" resp="#joint">gehoeriger</unclear> <persName resp="#ner">Hanns <unclear cert="medium" resp="#joint">Scherr</unclear></persName> <persName resp="#ner"><unclear cert="medium" resp="#joint">Vli</unclear> <unclear cert="medium" resp="#joint">Scherren</unclear></persName> <unclear cert="medium" resp="#joint">sohn</unclear> von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Schoehershub</unclear></placeName>
<lb n="7"/>(<unclear cert="medium" resp="#joint">welchen</unclear> er <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">zeits</unclear> zu <unclear cert="medium" resp="#joint">einem</unclear> knecht ange-
<lb n="8"/><unclear cert="low" resp="#joint">nomen</unclear>) <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">stat</unclear> daß er <unclear cert="medium" resp="#joint">ihme</unclear> <unclear cert="medium" resp="#joint">treuwen</unclear> dienst leisten
<lb n="9"/><unclear cert="medium" resp="#joint">soelen</unclear>, <unclear cert="medium" resp="#joint">ihme</unclear> sein <unclear cert="medium" resp="#joint">dochter</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Otilia</unclear></persName> <unclear cert="medium" resp="#joint">verfelt</unclear> und <unclear cert="medium" resp="#joint">geschwaengert</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">inmaßen</unclear> dann sie diser tagen <unclear cert="low" resp="#joint">eines</unclear> <unclear cert="low" resp="#joint">kinds</unclear> <unclear cert="low" resp="#joint">niderkomen</unclear>,
<lb n="11"/>weil nun <unclear cert="medium" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Hanns</unclear> <unclear cert="medium" resp="#joint">Scherr</unclear></persName> sich <unclear cert="medium" resp="#joint">sol</unclear> in
<lb n="12"/><unclear cert="medium" resp="#joint">krieg</unclear> begeben haben, <unclear cert="medium" resp="#joint">were</unclear> er bedacht das kind sein
<lb n="13"/><persName resp="#ner">Hanns <unclear cert="medium" resp="#joint">Scherren</unclear></persName> <unclear cert="medium" resp="#joint">eltern</unclear> oder verwandten <unclear cert="low" resp="#joint">zueber</unclear>-
<lb n="14"/><unclear cert="low" resp="#joint">schickhen</unclear>, <unclear cert="low" resp="#joint">sintenmal</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">kinds</unclear> <unclear cert="low" resp="#joint">mueter</unclear>, leibs <unclear cert="medium" resp="#joint">halber</unclear>,
<lb n="15"/>nit beschaffen, daß sie es <unclear cert="medium" resp="#joint">auferziehen</unclear> <unclear cert="medium" resp="#joint">koendte</unclear>,
<lb n="16"/>und er <persName resp="#ner"><unclear cert="medium" resp="#joint">Hanns</unclear> <unclear cert="medium" resp="#joint">Tobler</unclear></persName> auch nit bedacht, wie ers
<lb n="17"/>dann nit schuldig, zu sich <unclear cert="low" resp="#joint">zunemen</unclear>. Under-
<lb n="18"/>thenig bittende, <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">wolten</unclear> <unclear cert="medium" resp="#joint">ihme</unclear> hierzu
<lb n="19"/>mit unser <unclear cert="medium" resp="#joint">fuerschrift</unclear> an <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Vst</unclear>. <unclear cert="low" resp="#joint">guenstig</unclear> <unclear cert="low" resp="#joint">huelffbar</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">erscheinen</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">Welche</unclear> <unclear cert="low" resp="#joint">bitt</unclear> wir nit <unclear cert="medium" resp="#joint">woellen</unclear> verweigern, <unclear cert="medium" resp="#joint">ursachen</unclear>,
<lb n="22"/>daß <unclear cert="low" resp="#joint">dieweil</unclear> billich, daß die <unclear cert="medium" resp="#joint">vaetter</unclear>, oder
<lb n="23"/><unclear cert="medium" resp="#joint">dero</unclear> <unclear cert="medium" resp="#joint">anverwandten</unclear> sich solcher kindern <unclear cert="low" resp="#joint">annemen</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">soelen</unclear>.
<lb n="25"/><unclear cert="low" resp="#joint">Gelangt</unclear> darauf an <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Vst</unclear>. unser <unclear cert="medium" resp="#joint">freuendt</unclear>- <unclear cert="medium" resp="#joint">nach</unclear>-
<lb n="26"/><unclear cert="medium" resp="#joint">barlichs</unclear> ersuchen, <unclear cert="medium" resp="#joint">Sie</unclear> <unclear cert="medium" resp="#joint">geruhen</unclear>, <unclear cert="medium" resp="#joint">brieffsweiser</unclear>
<lb n="27"/>die hand (so es die <unclear cert="medium" resp="#joint">noturfft</unclear> <unclear cert="medium" resp="#joint">wirt</unclear> erfordern)
<pb facs="StadtASG_Missive_2029_7578.jpg" n="2"/>
<lb n="28"/>von oberkeits wegen, in gstalten zebieten
<lb n="29"/>daß sie diser unser fürschrifft gnossen ze-
<lb n="30"/>haben, uns ruehmen moegen.
<lb n="31"/>Dahingegen E. Vst. freündtschafft und an-
<lb n="32"/>genemme dienst zeerzeigen, seijen wir
<lb n="33"/>urbuetigk willig. Dat. den. <origDate when="1616" resp="#ner">24. t.
<lb n="34"/>Augusti Ao. 1616</origDate>.
<lb n="35"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und Rahte</orgName>
<lb n="36"/>Dem Edlen Vesten, hochgeehrten, <persName role="recipient" resp="#ner">Bernhardt Bod-
<lb n="37"/>marn</persName>, fr: Bischoffl: <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Cost</placeName>: Raht, und Obervogt
<lb n="38"/>zuo <placeName ref="stadtasg-places-5" cert="medium" resp="#ner">Arbon</placeName>, unserem lieben herren, guoten
<lb n="39"/>freünd und nachbarn.
</p>
