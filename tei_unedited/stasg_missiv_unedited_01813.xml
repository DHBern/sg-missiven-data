<p>
<pb facs="StadtASG_Missive_1813_6729.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündtnachbaurlich</unclear> willig dienst
<lb n="2"/>und <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">liebs</unclear> und guts vermögend
<lb n="3"/>zuvor. Edel, vest, ehrenvest, fürsichtig und <unclear cert="low" resp="#joint">wiß</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">besonders</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">freünde</unclear> und <unclear cert="low" resp="#joint">nachburn</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">W</unclear>. an uns abgangen schriben,
<lb n="6"/><unclear cert="low" resp="#joint">sampt</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">inligenden</unclear> <unclear cert="low" resp="#joint">müntzsorten</unclear>, haben
<lb n="7"/>wir wohl empfangen, und darauß deroselb
<lb n="8"/>wohlmeinend <unclear cert="low" resp="#joint">nachburlich</unclear> <unclear cert="low" resp="#joint">willen</unclear>, <unclear cert="low" resp="#joint">deßen</unclear>
<lb n="9"/>wir <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">derselb</unclear> <unclear cert="low" resp="#joint">freündtnachbaurlich</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">bedanckh</unclear> <unclear cert="low" resp="#joint">thund</unclear>, <unclear cert="low" resp="#joint">sowol</unclear> <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">gstalten</unclear>
<lb n="11"/>die eingeschloßne müntzsorten in <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
<lb n="12"/><unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">statt</unclear> <unclear cert="low" resp="#joint">ingeschlichen</unclear>, <unclear cert="low" resp="#joint">weßen</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">zethun</unclear>, <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">deroselb</unclear> <unclear cert="low" resp="#joint">etwas</unclear> moderation,
<lb n="14"/>taxation, oder <unclear cert="low" resp="#joint">verbotts</unclear> <unclear cert="low" resp="#joint">fürnemmen</unclear>, <unclear cert="low" resp="#joint">und</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear> <unclear cert="low" resp="#joint">mögen</unclear> <unclear cert="low" resp="#joint">verstendigt</unclear>, <unclear cert="low" resp="#joint">wie</unclear>
<lb n="16"/>es <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">geschickten</unclear> <unclear cert="low" resp="#joint">müntzsorten</unclear> <unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">by</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">uns</unclear> gehalten, und ob wir deßwegen <unclear cert="low" resp="#joint">was</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">ordnung</unclear> <unclear cert="low" resp="#joint">zemachen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">fürzenemmen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">entschloßen</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">auch</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">nachburlich</unclear> <unclear cert="low" resp="#joint">zebrichten</unclear> <unclear cert="low" resp="#joint">begern</unclear>, mit
<lb n="21"/><unclear cert="low" resp="#joint">merm</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>.
<lb n="22"/><unclear cert="low" resp="#joint">Konnend</unclear> <unclear cert="low" resp="#joint">hieruff</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="23"/><unclear cert="low" resp="#joint">freündtnachburlich</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">bergen</unclear>, <unclear cert="low" resp="#joint">dz</unclear> wir
<lb n="24"/>vor langest die <placeName ref="stadtasg-places-407" cert="medium" resp="#ner">Mantuanische</placeName> taler
<lb n="25"/>so vormalß uf der einen seiten ein
<lb n="26"/><unclear cert="low" resp="#joint">ander</unclear> <unclear cert="low" resp="#joint">schlag</unclear> <unclear cert="low" resp="#joint">namlich</unclear> mit einem schiltlin
<lb n="27"/>gantz und gar verbotten, und <unclear cert="low" resp="#joint">über</unclear> <unclear cert="low" resp="#joint">bschehen</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">versuchen</unclear> <unclear cert="low" resp="#joint">beÿ</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">selbigen</unclear> <unclear cert="low" resp="#joint">gelaßen</unclear>. <unclear cert="low" resp="#joint">Deßgleichen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">jüngst</unclear> <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">14</unclear> <unclear cert="low" resp="#joint">tag</unclear> <unclear cert="low" resp="#joint">verschinen</unclear>, <unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">obeermelt</unclear>
<pb facs="StadtASG_Missive_1813_6730.jpg" n="2"/>
<lb n="30"/><unclear cert="low" resp="#joint">eingeraissenen</unclear> <unclear cert="low" resp="#joint">straff</unclear> <unclear cert="low" resp="#joint">eingestellt</unclear>, der andern
<lb n="31"/><unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">aber</unclear> (<unclear cert="low" resp="#joint">ußgnomen</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">3</unclear>. <unclear cert="low" resp="#joint">bl</unclear>: <unclear cert="low" resp="#joint">ß</unclear> <placeName ref="stadtasg-places-32" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">zuerch</unclear></placeName>
<lb n="32"/>und <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">halbbatzen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">behemsch</unclear> <unclear cert="low" resp="#joint">groschen</unclear>) <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">uff</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">bißhero</unclear> <unclear cert="low" resp="#joint">kein</unclear> <unclear cert="low" resp="#joint">gwißheit</unclear> <unclear cert="low" resp="#joint">nachrichtung</unclear> <unclear cert="low" resp="#joint">gehabt</unclear> <unclear cert="low" resp="#joint">worde</unclear>.
<lb n="34"/>Damit aber <unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">kauffleüt</unclear> auch
<lb n="35"/>nicht eingefuehrt werden, haben <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">ermanglet</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">feiltrager</unclear> <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">zebescheiden</unclear>, sie die von
<lb n="37"/>E: V: E: <unclear cert="low" resp="#joint">Wlt</unclear>. W: <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">uberschickten</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">sechen</unclear> lassen,
<lb n="38"/>und mit allem ernst <unclear cert="low" resp="#joint">vermahent</unclear>, <unclear cert="low" resp="#joint">dergleichen</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">muentz</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">wenigsten</unclear> <unclear cert="low" resp="#joint">keine</unclear> <unclear cert="low" resp="#joint">anzenemen</unclear>, und so
<lb n="40"/><unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">iemands</unclear> <unclear cert="low" resp="#joint">solche</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">woltte</unclear>, <unclear cert="low" resp="#joint">alßbalde</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">minem</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">burgermeister</unclear> <unclear cert="low" resp="#joint">anzezeigen</unclear>, damit
<lb n="42"/>man sich <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">verheilhafftig</unclear> <unclear cert="low" resp="#joint">persohn</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">zeverhalten</unclear> <unclear cert="low" resp="#joint">wuesste</unclear>, <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">bedacht</unclear> <unclear cert="low" resp="#joint">sind</unclear>,
<lb n="44"/><unclear cert="low" resp="#joint">weil</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gemeine</unclear> <unclear cert="low" resp="#joint">mann</unclear>, <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">schlech</unclear>-
<lb n="45"/><unclear cert="low" resp="#joint">ten</unclear> <unclear cert="low" resp="#joint">gwins</unclear> <unclear cert="low" resp="#joint">wurde</unclear> <unclear cert="low" resp="#joint">hoechlich</unclear> <unclear cert="low" resp="#joint">darmit</unclear> <unclear cert="low" resp="#joint">beschwerdt</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">werden</unclear>, gentzlich <unclear cert="low" resp="#joint">zuverbietten</unclear>, <unclear cert="low" resp="#joint">woellen</unclear> auch
<lb n="47"/>biß <unclear cert="low" resp="#joint">kunfftigen</unclear> morgen, alle kauff und <unclear cert="low" resp="#joint">handerleit</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">erfordern</unclear>, und <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">mehrgedachte</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">sorten</unclear>, <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">inß</unclear> <unclear cert="low" resp="#joint">land</unclear> <unclear cert="low" resp="#joint">zefuehren</unclear> mit <unclear cert="low" resp="#joint">allem</unclear> <unclear cert="low" resp="#joint">ernst</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">verwarnen</unclear>. <unclear cert="low" resp="#joint">Wir</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">auch</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">underlassen</unclear> <unclear cert="low" resp="#joint">alßbalde</unclear> <unclear cert="low" resp="#joint">2</unclear>. <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">unsers</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">rhats</unclear> <unclear cert="low" resp="#joint">mittel</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">nachburn</unclear>, <unclear cert="low" resp="#joint">dem</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">prelaten</unclear> <unclear cert="low" resp="#joint">abzuordnen</unclear>, und <unclear cert="low" resp="#joint">nebend</unclear> <unclear cert="low" resp="#joint">ubergab</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">eins</unclear> <unclear cert="low" resp="#joint">musters</unclear>, (<unclear cert="low" resp="#joint">allso</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">ende</unclear> <unclear cert="low" resp="#joint">ihren</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">Frl</unclear>: <unclear cert="low" resp="#joint">Gn</unclear>. <unclear cert="low" resp="#joint">fuerzewisen</unclear> <unclear cert="low" resp="#joint">selbs</unclear> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">behalten</unclear>)
<lb n="56"/><unclear cert="low" resp="#joint">zueunderreden</unclear>. <unclear cert="low" resp="#joint">Was</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">bscheid</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">erfolgen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">ervolgen</unclear>, <unclear cert="low" resp="#joint">da</unclear> sie darmit
<lb n="58"/>ferner fuerzenemen gesinnet sein werden,
<lb n="59"/><unclear cert="low" resp="#joint">daz</unclear> <unclear cert="low" resp="#joint">woellen</unclear> <unclear cert="low" resp="#joint">wir</unclear> E: V: E: und <unclear cert="low" resp="#joint">Wlt</unclear>. <unclear cert="low" resp="#joint">W</unclear> (<unclear cert="low" resp="#joint">beneben</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">uberschickung</unclear> der <unclear cert="low" resp="#joint">sorten</unclear>) <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">empfangnen</unclear> <unclear cert="low" resp="#joint">bscheid</unclear> <unclear cert="low" resp="#joint">alßbald</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">freündt</unclear> nachbarlich avisieren.
<pb facs="StadtASG_Missive_1813_6731.jpg" n="3"/>
<lb n="62"/>E. V. F. W. E. W.
<lb n="63"/>Welches wir hiemit uff dero frundtlich
<lb n="64"/>zuschriben begerter maaßen freündtnachbur
<lb n="65"/>lich ze verstaendigen nicht unterlaßen, zumal
<lb n="66"/>dieselbe freündnachburlich bitten woellen,
<lb n="67"/>in solcher guter nachburlicher correspondenz
<lb n="68"/>noch fürbas ze continuiren. Was wir
<lb n="69"/>danj derselben hin gegben vuer aller frundtschaft,
<lb n="70"/>buirlichs willens, angenemmer gefelliger
<lb n="71"/>liebe erwisen unnd erzeigen khündt, solt
<lb n="72"/>es anerbotten, unß aber Gott der herr,
<lb n="73"/>bitten wir, sambtlich in sinem goettlichen
<lb n="74"/>schutz unnd schirm lengerhin gnedigkhlich
<lb n="75"/>erhalten welle. Datum den <origDate when="1613-02-03" resp="#ner">3t
<lb n="76"/>febr. a° etc. 1613</origDate>.
<lb n="77"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. unnd rhat der
<lb n="78"/>statt St. Gallen</orgName>.
<lb n="79"/>Den herren verwalter <orgName role="issuer" resp="#ner">der haupt
<lb n="80"/>manschaft, b. und rhat der
<lb n="81"/>statt Costantz</orgName>.
<pb facs="StadtASG_Missive_1813_6732.jpg" n="4"/>
<lb n="82"/>An <origPlace ref="stadtasg-places-7" cert="medium" resp="#ner">Costanz</origPlace> <origDate when="1613-02-03" resp="#ner">3. Febr. 1613.</origDate>
<lb n="83"/><unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">muentzwercks</unclear>.
</p>
