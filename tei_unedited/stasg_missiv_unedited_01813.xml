<lb n="11"/>die <unclear cert="low" resp="#joint">eingeschloßne</unclear> <unclear cert="low" resp="#joint">müntzsorten</unclear> in <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
