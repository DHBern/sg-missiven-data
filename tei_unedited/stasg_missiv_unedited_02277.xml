<lb n="104"/>nung <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">zubeqüemen</unclear>, dann <unclear cert="low" resp="#joint">wo</unclear> <unclear cert="low" resp="#joint">söches</unclear> <unclear cert="low" resp="#joint">Iren</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">gellt</unclear> <unclear cert="low" resp="#joint">und</unclear>
