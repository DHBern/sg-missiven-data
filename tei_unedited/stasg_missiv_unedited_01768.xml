        <body>
<p>
<pb facs="StadtASG_Missive_1768_6525.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">frueünd</unclear>: <unclear cert="low" resp="#joint">nachparlich</unclear> und <unclear cert="low" resp="#joint">guot</unclear>-
<lb n="2"/>willige <unclear cert="medium" resp="#joint">dienst</unclear>, zuvor, Fuersichtige Er-
<lb n="3"/><unclear cert="medium" resp="#joint">same</unclear> <unclear cert="low" resp="#joint">Weijße</unclear> <unclear cert="low" resp="#joint">besunders</unclear> liebe <unclear cert="low" resp="#joint">frueünd</unclear>
<lb n="4"/>und <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="medium" resp="#joint">nachparn</unclear>,
<lb n="5"/><unclear cert="medium" resp="#joint">Uff</unclear> ewer an <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">Ewer</unclear> <unclear cert="low" resp="#joint">burgerin</unclear>
<lb n="6"/><persName resp="#ner">Catharina <unclear cert="medium" resp="#joint">Nägin</unclear></persName>, und <unclear cert="medium" resp="#joint">Jres</unclear> mit <unclear cert="low" resp="#joint">jren</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">Khindern</unclear> getroffnen Contracts halber,
<lb n="8"/><unclear cert="low" resp="#joint">gthon</unclear> <unclear cert="low" resp="#joint">frueünd</unclear>: nachparlich schreiben,
<lb n="9"/><unclear cert="low" resp="#joint">Sohlln</unclear> wir <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">frueünd</unclear>: nachpar-
<lb n="10"/>lichen nit <unclear cert="medium" resp="#joint">verhalten</unclear>, dz <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">uns</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">Ewermaßen</unclear> als <unclear cert="medium" resp="#joint">jhr</unclear>, <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">entgeg</unclear>
<lb n="12"/>sein laßen <unclear cert="low" resp="#joint">woellen</unclear>, da gedachte <unclear cert="low" resp="#joint">nägin</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">Jren</unclear> <unclear cert="low" resp="#joint">ehelijplichen</unclear> <unclear cert="low" resp="#joint">Khindern</unclear>, die von
<lb n="14"/><unclear cert="low" resp="#joint">unßerm</unclear> burger <persName resp="#ner">Jacob <unclear cert="medium" resp="#joint">Wüßerrei</unclear></persName> <unclear cert="medium" resp="#joint">seelig</unclear>,
<lb n="15"/>seiner <unclear cert="medium" resp="#joint">maß</unclear> <unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">gotte</unclear> <unclear cert="medium" resp="#joint">Sijbenhundert</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">Guldin</unclear>, <unclear cert="medium" resp="#joint">fürderlich</unclear>, und mit <unclear cert="low" resp="#joint">angezog</unclear>-
<lb n="17"/>nem beding, <unclear cert="low" resp="#joint">hrueszegeben</unclear> <unclear cert="low" resp="#joint">gewillt</unclear>,
<lb n="18"/>Werden <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">sije</unclear> <unclear cert="medium" resp="#joint">Muotter</unclear> und <unclear cert="low" resp="#joint">Khinder</unclear>,
<lb n="19"/><unclear cert="low" resp="#joint">solche</unclear> in <unclear cert="medium" resp="#joint">ijberkhomnuß</unclear> <unclear cert="medium" resp="#joint">züvollzihen</unclear>
<lb n="20"/>wißen,
<lb n="21"/><unclear cert="low" resp="#joint">Welches</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">eüch</unclear> Loco <unclear cert="low" resp="#joint">Recepisse</unclear> <unclear cert="low" resp="#joint">frueünd</unclear>:
<lb n="22"/>nachparlichen <unclear cert="low" resp="#joint">anfueg</unclear> <unclear cert="low" resp="#joint">woellen</unclear>, <unclear cert="low" resp="#joint">Ver</unclear>-
<lb n="23"/><unclear cert="low" resp="#joint">bleib</unclear> <unclear cert="low" resp="#joint">daneb</unclear> <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">angenemen</unclear> dienst
<lb n="24"/>und <unclear cert="medium" resp="#joint">guoter</unclear> nachparschaft, beharrlich wil-
<lb n="25"/>lig und <unclear cert="medium" resp="#joint">erbietig</unclear>. Datum den
<lb n="26"/><origDate when="1612-05-30" resp="#ner">30ten <unclear cert="medium" resp="#joint">Maij</unclear> ao 1612</origDate>.
<lb n="27"/>Verwalter d <unclear cert="low" resp="#joint">haubt</unclear>-
<lb n="28"/><unclear cert="low" resp="#joint">manschaft</unclear>, <orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner">Burger-
<lb n="29"/><unclear cert="medium" resp="#joint">meister</unclear> und Rath d
<lb n="30"/>Statt <unclear cert="low" resp="#joint">Costantz</unclear></orgName>,
<pb facs="StadtASG_Missive_1768_6526.jpg" n="2"/>
<lb n="31"/>[]
<pb facs="StadtASG_Missive_1768_6527.jpg" n="3"/>
<pb facs="StadtASG_Missive_1768_6528.jpg" n="4"/>
<lb n="32"/>Den
<lb n="33"/>fürsichtigen ersamen <unclear cert="medium" resp="#joint">unnd</unclear> weysen,
<lb n="34"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und Rath zue St. Gallen</orgName>,
<lb n="35"/>unsern besonders lieben <unclear cert="low" resp="#joint">freundt</unclear> und <unclear cert="low" resp="#joint">gute</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">nachbaurn</unclear>.
</p>
