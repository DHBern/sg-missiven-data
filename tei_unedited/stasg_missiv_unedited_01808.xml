    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1808_6697.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="medium" resp="#joint">frünntlich</unclear> willig dienst, <unclear cert="medium" resp="#joint">sampt</unclear> <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">wir</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">Eren</unclear>, <unclear cert="medium" resp="#joint">Liebs</unclear>, unnd <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermögennt</unclear> zuovor, Fromm
<lb n="3"/><unclear cert="medium" resp="#joint">Fuersichtig</unclear> <unclear cert="medium" resp="#joint">Ersamm</unclear>, Wyß, <unclear cert="medium" resp="#joint">Innsonders</unclear> guot <unclear cert="medium" resp="#joint">Frünndt</unclear>
<lb n="4"/>unnd gethrüw Lieb <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eydgnoßen</unclear></orgName>.
<lb n="5"/><unclear cert="medium" resp="#joint">Waß</unclear> Ihr zuo <unclear cert="medium" resp="#joint">unnderschydenlichen</unclear> <unclear cert="medium" resp="#joint">mahlen</unclear>, wegen der <unclear cert="medium" resp="#joint">anvord</unclear>-
<lb n="6"/><unclear cert="medium" resp="#joint">erung</unclear> <unclear cert="medium" resp="#joint">unnsers</unclear> <unclear cert="medium" resp="#joint">Burgers</unclear> <unclear cert="medium" resp="#joint">haupt</unclear>: <persName resp="#ner"><unclear cert="medium" resp="#joint">Hannß</unclear> <unclear cert="medium" resp="#joint">Schwallers</unclear></persName>, uff
<lb n="7"/><unclear cert="medium" resp="#joint">üwere</unclear> burger die Schärer gemeinlich, unnd <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">stalten</unclear> die hinderhaltung <unclear cert="medium" resp="#joint">seiner</unclear> <unclear cert="medium" resp="#joint">obligation</unclear> <unclear cert="medium" resp="#joint">beschryben</unclear>,
<lb n="9"/>unnd <unclear cert="medium" resp="#joint">daß</unclear> darumb die <unclear cert="medium" resp="#joint">noth</unclear> <unclear cert="medium" resp="#joint">thuet</unclear> <unclear cert="medium" resp="#joint">ervorderen</unclear>, diser
<lb n="10"/><unclear cert="medium" resp="#joint">strÿttigkeit</unclear> <unclear cert="medium" resp="#joint">uff</unclear> daß <unclear cert="low" resp="#joint">fuerderlichst</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">ußtrag</unclear> <unclear cert="low" resp="#joint">zuogeben</unclear>,
<lb n="11"/>Darumb dann <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">denn</unclear> <date resp="#ner">11. <unclear cert="medium" resp="#joint">Januarij</unclear> <unclear cert="medium" resp="#joint">Ao</unclear>. 1613.</date> diß
<lb n="12"/>alten <unclear cert="medium" resp="#joint">Callenders</unclear>, er Inn der <unclear cert="medium" resp="#joint">Persohn</unclear>, oder durch einen
<lb n="13"/><unclear cert="medium" resp="#joint">vollmechtigen</unclear> <unclear cert="medium" resp="#joint">annwaldt</unclear>, vor <unclear cert="medium" resp="#joint">üwerem</unclear> <unclear cert="medium" resp="#joint">stadt</unclear> <unclear cert="medium" resp="#joint">gericht</unclear> <unclear cert="medium" resp="#joint">zuerscheinen</unclear>,
<lb n="14"/>unnd <unclear cert="medium" resp="#joint">deß</unclear> hanndels <unclear cert="low" resp="#joint">ußtrag</unclear> <unclear cert="low" resp="#joint">zuerwartten</unclear>, <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">zuogeschryben</unclear>,
<lb n="15"/><unclear cert="low" resp="#joint">habendt</unclear> wir mit <unclear cert="medium" resp="#joint">mehrerem</unclear> verstannden, unnd nit
<lb n="16"/><unclear cert="medium" resp="#joint">ermanngelt</unclear>, <unclear cert="medium" resp="#joint">denn</unclear> <unclear cert="medium" resp="#joint">bestimpten</unclear> tag, <unclear cert="medium" resp="#joint">Ihme</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Schwallern</unclear></persName>
<lb n="17"/>nach <unclear cert="low" resp="#joint">üwerem</unclear> <unclear cert="low" resp="#joint">begeren</unclear> <unclear cert="low" resp="#joint">föermblich</unclear> <unclear cert="low" resp="#joint">anzukhünden</unclear>, Unnd
<lb n="18"/><unclear cert="low" resp="#joint">tragendt</unclear> <unclear cert="low" resp="#joint">kheinen</unclear> <unclear cert="low" resp="#joint">zwyfel</unclear> so er nit an <unclear cert="medium" resp="#joint">lybsblödigkheit</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">vonn</unclear> <unclear cert="medium" resp="#joint">Gott</unclear> <unclear cert="medium" resp="#joint">denn</unclear> <unclear cert="medium" resp="#joint">Allmechtigen</unclear> <unclear cert="medium" resp="#joint">heimgesuocht</unclear>, <unclear cert="medium" resp="#joint">Er</unclear> selbs
<lb n="20"/><unclear cert="medium" resp="#joint">Persönlich</unclear>, <unclear cert="medium" resp="#joint">entlich</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">Ußtrag</unclear> <unclear cert="medium" resp="#joint">deß</unclear> hanndels sich <unclear cert="low" resp="#joint">gestelt</unclear> <unclear cert="low" resp="#joint">hete</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">Diewyl</unclear> unnd aber diß mahlen <unclear cert="low" resp="#joint">zuerscheinen</unclear> <unclear cert="low" resp="#joint">Ihme</unclear> nit
<lb n="22"/><unclear cert="medium" resp="#joint">müglich</unclear>, hat er <unclear cert="medium" resp="#joint">Zeigern</unclear> diß, <unclear cert="low" resp="#joint">Denn</unclear> <unclear cert="low" resp="#joint">Edlen</unclear>, <unclear cert="low" resp="#joint">Eerenvesten</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">Fürnemmen</unclear>, unnd <unclear cert="medium" resp="#joint">Wyßen</unclear> <unclear cert="medium" resp="#joint">hr</unclear>: <persName resp="#ner"><unclear cert="medium" resp="#joint">Cäsparn</unclear> <unclear cert="medium" resp="#joint">Freüwlin</unclear></persName>
<lb n="24"/><unclear cert="medium" resp="#joint">vonn</unclear> <placeName ref="stadtasg-places-73" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Glaruß</unclear></placeName> <unclear cert="medium" resp="#joint">zuo</unclear> seinem <unclear cert="medium" resp="#joint">vollmechtigen</unclear> <unclear cert="medium" resp="#joint">anwaldt</unclear>, <unclear cert="medium" resp="#joint">seine</unclear>
<lb n="25"/>sachen <unclear cert="medium" resp="#joint">ann</unclear> <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">Orth</unclear>, Inn <unclear cert="medium" resp="#joint">seinem</unclear> <unclear cert="medium" resp="#joint">namen</unclear>, <unclear cert="medium" resp="#joint">luth</unclear> <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">übergebnen</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">schrifftlichen</unclear> <unclear cert="medium" resp="#joint">Gwalts</unclear>, <unclear cert="medium" resp="#joint">Demme</unclear> wir auch ein <unclear cert="low" resp="#joint">Ußzug</unclear>,
<pb facs="StadtASG_Missive_1808_6698.jpg" n="2"/>
<lb n="27"/><unclear cert="low" resp="#joint">einbeziehung</unclear> der <unclear cert="low" resp="#joint">schulden</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">Stattrichters</unclear> <unclear cert="low" resp="#joint">zuogestelt</unclear>,
<lb n="28"/>nach bestem verstand und vermögen zuoverwalten, und hierin
<lb n="29"/>sein persohn, alß ob er <unclear cert="low" resp="#joint">gegenwirtig</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">augen</unclear> <unclear cert="low" resp="#joint">zuover</unclear>-
<lb n="30"/><unclear cert="low" resp="#joint">tretten</unclear>, <unclear cert="low" resp="#joint">erbetten</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">verordnet</unclear>. <unclear cert="low" resp="#joint">Dieweilen</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">und</unclear> aber die Jungen Schärer, so inn der obligation, so wol
<lb n="32"/>alß die alten verschriben, khein annder mittel sich <unclear cert="low" resp="#joint">ußzuo</unclear>-
<lb n="33"/><unclear cert="low" resp="#joint">schwingen</unclear> (<unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">er</unclear> vermeint) nit wüßen, dann daß gemelter
<lb n="34"/><persName resp="#ner">Schmelz</persName> alhie zue <placeName ref="stadtasg-places-293" cert="medium" resp="#ner">Cronen</placeName>, da zwüschen ihnen denn partheyen
<lb n="35"/>deß zinnßes, und nit deß haubtguets wegen stryt gehalten,
<lb n="36"/>Er vermeldet so sein <unclear cert="low" resp="#joint">zinnß</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">ins</unclear> <unclear cert="low" resp="#joint">khünfftig</unclear> richtig erlegt,
<lb n="37"/>achte er deßen nützit, wär ihme dennselbigen jerlich thüe
<lb n="38"/>bezahlen. Uß welchen worten nit erscheinen thuet, daß
<lb n="39"/>darumb eüwere burger die Jungen Schärer der <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">sprach</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">und</unclear> obligation gegen dem unsern sollen ledig, und erloßen
<lb n="41"/>sein, <unclear cert="low" resp="#joint">Sonnders</unclear> <unclear cert="low" resp="#joint">wyl</unclear> <unclear cert="low" resp="#joint">wort</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">werckh</unclear> <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">unnser</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">ergangen</unclear>, die obligation unnd <unclear cert="low" resp="#joint">lifferung</unclear> <unclear cert="low" resp="#joint">zins</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">haubtguets</unclear> auch <unclear cert="low" resp="#joint">alher</unclear> <unclear cert="low" resp="#joint">thüet</unclear> <unclear cert="low" resp="#joint">luthen</unclear>, <unclear cert="low" resp="#joint">Wann</unclear> die eüwern deßwegen
<lb n="44"/>etwaß rechtuertigung mit dem <unclear cert="low" resp="#joint">unnsern</unclear> <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">zuonemmen</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">vorhabens</unclear>, unnd darumb sein obligation <unclear cert="low" resp="#joint">unzit</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">uß</unclear>-
<lb n="46"/><unclear cert="low" resp="#joint">trag</unclear> <unclear cert="low" resp="#joint">hanndels</unclear> hinder <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">verbliben</unclear>, <unclear cert="low" resp="#joint">Pittendt</unclear> wir <unclear cert="low" resp="#joint">euch</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">wellendt</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">erzelten</unclear> <unclear cert="low" resp="#joint">gründen</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">ursachen</unclear>, Da wort, und werckh sich verloffen, so allen eidt-
<lb n="49"/>gnößischen rechten, derselben gwonheiten ähnlich, und gemäß
<lb n="50"/><unclear cert="low" resp="#joint">uůbsocht</unclear>, <unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">unnsern</unclear> vor <unclear cert="low" resp="#joint">diserm</unclear> <unclear cert="low" resp="#joint">Stab</unclear> <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">redt</unclear>,
<lb n="51"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">anntwurt</unclear> <unclear cert="low" resp="#joint">zuogeben</unclear> <unclear cert="low" resp="#joint">oberkheitlich</unclear> <unclear cert="low" resp="#joint">vermögen</unclear>,
<lb n="52"/><unclear cert="low" resp="#joint">Inn</unclear> rechten gebürlich zuo procediern, unnd denn ußtrag
<lb n="53"/>dßelbigen erwarten, Da ihr vergwüst sein sollendt
<lb n="54"/>daß inen guet schleinig unnd fürderlich recht gehalten,
<pb facs="StadtASG_Missive_1808_6699.jpg" n="3"/>
<lb n="55"/>und wider die billigkeit nuetzit begegnen noch widerfahren solle,
<lb n="56"/>Waß nun die obligation deren sich der unnser mehrmahlen er-
<lb n="57"/>clagt, daß selbige ihme hinderhalten, anblangen thuet, solche
<lb n="58"/>aber annder gstalt nit dann uff der Schaerern anhalten
<lb n="59"/>unntzit zue ußtrag hanndels lut uwer schribens,
<lb n="60"/>hinder uch verblybt, unnd nun wir nit wüßen
<lb n="61"/>ob gemelte <unclear cert="low" resp="#joint">Schaerer</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">annderen</unclear> <unclear cert="low" resp="#joint">gruenden</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">ursachen</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">ledig</unclear> <unclear cert="low" resp="#joint">zuesein</unclear> <unclear cert="low" resp="#joint">vermeinen</unclear> (<unclear cert="low" resp="#joint">wyl</unclear> <unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">unnß</unclear> nit ver-
<lb n="63"/>meltet worden) oder allein umb der worten, so allhie ergangen,
<lb n="64"/>uß der obligation <unclear cert="low" resp="#joint">zuentwichen</unclear> <unclear cert="low" resp="#joint">vorhabens</unclear>, <unclear cert="low" resp="#joint">Alßdann</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">finden</unclear>, daß der unnser umb der worten so allhie
<lb n="66"/>ergangen, bey <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">recht</unclear> <unclear cert="low" resp="#joint">nemmen</unclear>, sonnders vill mehr
<lb n="67"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">gegentheyl</unclear>, <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">ort</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">recht</unclear> <unclear cert="low" resp="#joint">verlaßen</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">hochsten</unclear> <unclear cert="low" resp="#joint">gradt</unclear>, unnd <unclear cert="low" resp="#joint">eeren</unclear> <unclear cert="low" resp="#joint">ruerig</unclear> <unclear cert="low" resp="#joint">zuegeben</unclear> die uweren
<lb n="69"/>schuldig, und verbunden sein sollendt, derowegen
<lb n="70"/>auß die obligation nit hinderhalten, sonnders zue befuerder-
<lb n="71"/>ung <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">rechtmaeßigen</unclear> <unclear cert="low" resp="#joint">ansprach</unclear> <unclear cert="low" resp="#joint">zeigeren</unclear> <unclear cert="low" resp="#joint">diß</unclear> seinem
<lb n="72"/>anwaldt, ohne alle entgeltnuß solle hinuß geben, und zue
<lb n="73"/>seinen hannden gestelt werden, Langt derow
<lb n="74"/>wegen an <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">A</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">frundtlich</unclear> <unclear cert="low" resp="#joint">pitt</unclear>
<lb n="75"/>ihr wellend nit allein offtgesagte obligation dem unnseren
<lb n="76"/>widerumb zuekhommen laßen, sonnders auch zeigeren diß
<lb n="77"/>alle oberkheitliche befuerderung erzeigen, wie <unclear cert="low" resp="#joint">wir</unclear> dann
<lb n="78"/><unclear cert="low" resp="#joint">ungezweiffelter</unclear> <unclear cert="low" resp="#joint">hoffnung</unclear> <unclear cert="low" resp="#joint">seindt</unclear>, <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">wichtigkeit</unclear>
<lb n="79"/><unclear cert="low" resp="#joint">dißers</unclear> <unclear cert="low" resp="#joint">hanndels</unclear> <unclear cert="low" resp="#joint">erdueren</unclear> <unclear cert="low" resp="#joint">werdendt</unclear>, unnd <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">unnseren</unclear>
<lb n="80"/><unclear cert="low" resp="#joint">wozue</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">gueffug</unclear> <unclear cert="low" resp="#joint">und</unclear> recht <unclear cert="low" resp="#joint">hat</unclear> <unclear cert="low" resp="#joint">fuerderlich</unclear> verholffen sein
<lb n="81"/>Solches seind wir inn allen begebenden gelegenheiten
<lb n="82"/>umb uch ganntz frundt und eidtgnosßisch, widerumb zue-
<lb n="83"/>verdienen bereit, und willig, <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">hielff</unclear> <unclear cert="low" resp="#joint">Gott</unclear>, der <unclear cert="low" resp="#joint">welle</unclear>
<lb n="84"/><unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">samptlich</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">protection</unclear> <unclear cert="low" resp="#joint">gnedig</unclear> <unclear cert="low" resp="#joint">erhalten</unclear>
<lb n="85"/><unclear cert="low" resp="#joint">datt</unclear>. <origDate when="1617-01-11" resp="#ner">11. Januarij Anno 1617</origDate>.
<lb n="86"/><orgName ref="stadtasg-actors-944" cert="medium" role="issuer" resp="#ner">Schultheiß und Rath
<lb n="87"/>der Statt Sollothurn</orgName>.
<pb facs="StadtASG_Missive_1808_6700.jpg" n="4"/>
<lb n="88"/><unclear cert="medium" resp="#joint">Denn</unclear> frommen <unclear cert="medium" resp="#joint">fuersichtigen</unclear> ersam=
<lb n="89"/>men <unclear cert="medium" resp="#joint">weyßen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd Rath
<lb n="90"/>der statt <unclear cert="medium" resp="#joint">Sannct</unclear> Gallen</orgName> unnsern
<lb n="91"/><unclear cert="medium" resp="#joint">innsonnders</unclear> <unclear cert="medium" resp="#joint">gueten</unclear> freünden unnd
<lb n="92"/><unclear cert="medium" resp="#joint">gethrüewen</unclear> lieben <unclear cert="medium" resp="#joint">eydtgnoßen</unclear>.
</p>
