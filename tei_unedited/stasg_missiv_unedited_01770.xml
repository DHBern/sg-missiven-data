    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1770_6533.jpg" n="1"/>
<lb n="1"/>Unser frundtlich willig diennst und gruoß zuvor,
<lb n="2"/>fuersichtig, ersam und weiß, insonnders liebe und guete
<lb n="3"/><unclear cert="low" resp="#joint">frundt</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">Ewer</unclear> <unclear cert="low" resp="#joint">underm</unclear> <date resp="#ner">5. <unclear cert="low" resp="#joint">Martij</unclear></date> <unclear cert="low" resp="#joint">nechst</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">abgangene</unclear> schrei-
<lb n="5"/>ben, haben wir <unclear cert="low" resp="#joint">bißanhero</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">recht</unclear> <unclear cert="low" resp="#joint">empfangen</unclear>,
<lb n="6"/><unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">denselbigen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Dorotheen</unclear> <unclear cert="low" resp="#joint">Basthardin</unclear></persName> <unclear cert="low" resp="#joint">kunigewerbter</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">todts</unclear> verfahren, und an deren <unclear cert="low" resp="#joint">verlaßenschafft</unclear>
<lb n="8"/><persName resp="#ner"><unclear cert="low" resp="#joint">Othmar</unclear> <unclear cert="low" resp="#joint">Basthardt</unclear></persName>, <unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">hiebvor</unclear> <unclear cert="low" resp="#joint">geworbner</unclear> <unclear cert="low" resp="#joint">hinden</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">uß</unclear>, <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">khinder</unclear>, <unclear cert="low" resp="#joint">im</unclear> fahl <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">leben</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">erben</unclear> sein <unclear cert="low" resp="#joint">wurden</unclear>, <unclear cert="low" resp="#joint">ablesendt</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>, <unclear cert="low" resp="#joint">Weül</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Othmar</unclear> <unclear cert="low" resp="#joint">Basthardt</unclear></persName> bey <unclear cert="low" resp="#joint">uns</unclear>, <unclear cert="low" resp="#joint">ungevehrlichen</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">bij</unclear> 11. jahren oder lengr, etlicher außgeschlagener
<lb n="13"/>schmach: und ehrenrueerigen redten, und darauß endt-
<lb n="14"/>sprungnen processos halben, außgetretten, <unclear cert="low" resp="#joint">nund</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">außer</unclear> <unclear cert="low" resp="#joint">lanndt</unclear>, <unclear cert="low" resp="#joint">lauth</unclear> <unclear cert="low" resp="#joint">danckhandtwehig</unclear> gezogen.
<lb n="16"/>Auß wier dazumahlen gehabte <unclear cert="low" resp="#joint">khundt</unclear> <unclear cert="low" resp="#joint">gstorben</unclear>,
<lb n="17"/><unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">weib</unclear> auch sich <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">freibwere</unclear> <unclear cert="low" resp="#joint">diennstberait</unclear>,
<lb n="18"/><unclear cert="low" resp="#joint">behaltet</unclear>. <unclear cert="low" resp="#joint">Alß</unclear> <unclear cert="low" resp="#joint">künden</unclear> <unclear cert="low" resp="#joint">wir</unclear> nit wißen, wans es
<lb n="19"/>seiner persohn halber füer ein beschaffenheit habe,
<lb n="20"/>So wir <unclear cert="low" resp="#joint">euch</unclear>, <unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">disem</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">willfahren</unclear> <unclear cert="low" resp="#joint">erpietig</unclear>, <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">andtwortt</unclear> <unclear cert="low" resp="#joint">begertt</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">pergen</unclear> <unclear cert="low" resp="#joint">wollen</unclear>. <unclear cert="low" resp="#joint">Geben</unclear> <unclear cert="low" resp="#joint">den</unclear> <origDate resp="#ner"><unclear cert="low" resp="#joint">12</unclear>.
<lb n="23"/><unclear cert="low" resp="#joint">junij</unclear> anno 612</origDate>.
<lb n="24"/><orgName ref="stadtasg-actors-58" cert="medium" role="issuer" resp="#ner">Buergermaister und rath dr
<lb n="25"/>statt Ravenspuerg</orgName>.
<pb facs="StadtASG_Missive_1770_6534.jpg" n="2"/>
<pb facs="StadtASG_Missive_1770_6535.jpg" n="3"/>
<pb facs="StadtASG_Missive_1770_6536.jpg" n="4"/>
<lb n="26"/>Den fursichtigen eersamen und weysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="27"/>und Rath der Statt St. Gallen</orgName> <unclear cert="low" resp="#joint">unsern</unclear> insonders lieb und
<lb n="28"/>gueten freunden.
</p>
