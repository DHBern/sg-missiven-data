<lb n="27"/>gelegen, üch <unclear cert="low" resp="#joint">beuolch</unclear>- zehin <unclear cert="medium" resp="#joint">lassenn</unclear>, unnd <unclear cert="low" resp="#joint">dermast</unclear>
