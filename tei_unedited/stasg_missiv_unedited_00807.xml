<lb n="25"/><unclear cert="medium" resp="#joint">pitt</unclear>, <unclear cert="medium" resp="#joint">genannten</unclear> <unclear cert="medium" resp="#joint">unnsern</unclear> <unclear cert="low" resp="#joint">mittraath</unclear>, <unclear cert="low" resp="#joint">günnstlich</unclear> <unclear cert="low" resp="#joint">zeuer=</unclear>
