<p>
<pb facs="StadtASG_Missive_807_2175.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">frünttlich</unclear> willig dinst, mit erbiettung
<lb n="2"/>alles liebs unnd <unclear cert="medium" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">beuor</unclear>, fromen, <unclear cert="low" resp="#joint">erenueste</unclear>,
<lb n="3"/>fürsichtigen wiysen, innsonders guotten fründt, unnd
<lb n="4"/>gethrüwen lieben <unclear cert="medium" resp="#joint">Eydtgnossenn</unclear>. Wir sind
<lb n="5"/>durch <unclear cert="low" resp="#joint">unnsere</unclear> <unclear cert="low" resp="#joint">gsanndten</unclear>, so wir uff iunngst=
<lb n="6"/><unclear cert="low" resp="#joint">gehaltnem</unclear> tag, zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Badenn</unclear> <unclear cert="medium" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">Ergow</unclear></placeName> <unclear cert="low" resp="#joint">ghabt</unclear>, <unclear cert="medium" resp="#joint">neben</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">annderm</unclear> verstendigt worden, dz <unclear cert="medium" resp="#joint">ir</unclear> <unclear cert="medium" resp="#joint">innamen</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">gemeiner</unclear> <orgName ref="stadtasg-actors-28" cert="medium" resp="#ner">Eydtgnossen</orgName>, <unclear cert="low" resp="#joint">ettlicher</unclear> mitt der <orgName ref="stadtasg-actors-56" cert="medium" resp="#ner">Statt Costantz</orgName>
<lb n="9"/><unclear cert="low" resp="#joint">spenigen</unclear> sachen halber, <unclear cert="low" resp="#joint">dieselbige</unclear> <unclear cert="low" resp="#joint">zeeroerttern</unclear>, unnd
<lb n="10"/><unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">frünttlicher</unclear> <unclear cert="medium" resp="#joint">nachpürlicher</unclear> <unclear cert="low" resp="#joint">verglychung</unclear> <unclear cert="low" resp="#joint">zebringe</unclear>-
<lb n="11"/>gen <placeName ref="stadtasg-places-325" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eruetzlingen</unclear></placeName> <unclear cert="low" resp="#joint">abgeferttiget</unclear> sin <unclear cert="low" resp="#joint">soellendt</unclear>. Unnd
<lb n="12"/><unclear cert="low" resp="#joint">diewyl</unclear> <unclear cert="medium" resp="#joint">dann</unclear> <unclear cert="medium" resp="#joint">deß</unclear> von denen von Costantz <unclear cert="low" resp="#joint">langst</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">uffgerichten</unclear>, unnd nach und nach, <unclear cert="low" resp="#joint">ihe</unclear> <unclear cert="low" resp="#joint">lennger</unclear>, <unclear cert="low" resp="#joint">ihe</unclear> mer
<lb n="14"/><unclear cert="low" resp="#joint">gesteigerten</unclear>, zolls wegen, ouch hanndlung fürgenomen
<lb n="15"/>wirtt, habendt wir disen unnsern lieben mitt=
<lb n="16"/>raath, abgesanndt, mitt üch, diser sachen halb, frünt=
<lb n="17"/><unclear cert="low" resp="#joint">tliche</unclear> <unclear cert="low" resp="#joint">redt</unclear> <unclear cert="low" resp="#joint">zehaltenn</unclear>, unnd was <unclear cert="low" resp="#joint">soellicher</unclear> zoll, nitt
<lb n="18"/>unns, unnd unnsern <unclear cert="low" resp="#joint">bygelegnen</unclear> <unclear cert="medium" resp="#joint">nachpuren</unclear>, allein,
<lb n="19"/>sonnder ouch <unclear cert="medium" resp="#joint">gemeiner</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoßschafft</unclear></orgName>, <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">allerley</unclear>
