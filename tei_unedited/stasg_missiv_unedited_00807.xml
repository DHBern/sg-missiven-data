<lb n="21"/><unclear cert="low" resp="#joint">anderm</unclear>, dem gemeinen <unclear cert="medium" resp="#joint">mann</unclear>, <unclear cert="medium" resp="#joint">nottwendigen</unclear> <unclear cert="medium" resp="#joint">dingen</unclear>,
<lb n="22"/><unclear cert="low" resp="#joint">bschwerdt</unclear>, unnd nachteil <unclear cert="low" resp="#joint">ierlich</unclear> <unclear cert="low" resp="#joint">gepere</unclear>. Ouch wie dise
<lb n="23"/><unclear cert="low" resp="#joint">zollsteigerung</unclear>, nach, unnd nach <unclear cert="low" resp="#joint">uffgwachßen</unclear>, <unclear cert="low" resp="#joint">luthern</unclear>
