<p>
<pb facs="StadtASG_Missive_2051_7677.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Missiv</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">antwortt</unclear>.
<lb n="2"/>Hochgeacht, <unclear cert="medium" resp="#joint">edel</unclear>, gestreng, <unclear cert="low" resp="#joint">from</unclear>, <unclear cert="low" resp="#joint">vest</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">ehrenvest</unclear>, fürsichtig <unclear cert="low" resp="#joint">ersam</unclear> und weise, <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Vstrg</unclear>.
<lb n="4"/>und <unclear cert="medium" resp="#joint">Wht</unclear>. <unclear cert="medium" resp="#joint">seyen</unclear> <unclear cert="medium" resp="#joint">unser</unclear> freündtlich willig dienst, und
<lb n="5"/>was wir ehren liebs und <unclear cert="medium" resp="#joint">guts</unclear> vermögend <unclear cert="medium" resp="#joint">zuvor</unclear>,
<lb n="6"/>günstige <unclear cert="low" resp="#joint">hochgeehrte</unclear> <unclear cert="low" resp="#joint">herren</unclear>, <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">vertrauwte</unclear> <unclear cert="low" resp="#joint">gute</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">freünd</unclear>, und <unclear cert="medium" resp="#joint">getreüwe</unclear> liebe eidtgnossen,
<lb n="8"/>Was uns, von <unclear cert="low" resp="#joint">unsrer</unclear> <unclear cert="low" resp="#joint">gemeinen</unclear> unser statt und <unclear cert="medium" resp="#joint">burgersch=</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">afft</unclear> wegen, <unclear cert="medium" resp="#joint">erneüwerung</unclear> <unclear cert="medium" resp="#joint">der</unclear> regalien bey
<lb n="10"/>der <unclear cert="low" resp="#joint">Rö</unclear>. <unclear cert="low" resp="#joint">Keis</unclear>. <unclear cert="low" resp="#joint">Mt</unclear>. nachmalen ob= und <unclear cert="medium" resp="#joint">ange=</unclear>
<lb n="11"/>legen, das haben wir <unclear cert="medium" resp="#joint">anbefolhen</unclear>, dem hochge=
<lb n="12"/><unclear cert="medium" resp="#joint">lerten</unclear>, unserm <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben <unclear cert="medium" resp="#joint">stattartzt</unclear>
<lb n="13"/>und <unclear cert="low" resp="#joint">mitraht</unclear>, <unclear cert="low" resp="#joint">doctor</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Sebastian</unclear> <unclear cert="low" resp="#joint">Schobingern</unclear></persName>,
<lb n="14"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Vstrg</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Wht</unclear>. mit <unclear cert="medium" resp="#joint">mehrerm</unclear> <unclear cert="medium" resp="#joint">fürzubringen</unclear>,
<lb n="15"/>Da gelangt an sie unser freündtliches <unclear cert="medium" resp="#joint">eidtgnossischs</unclear>
<lb n="16"/>bitten, sie <unclear cert="medium" resp="#joint">wöllen</unclear> <unclear cert="medium" resp="#joint">ihne</unclear> nit allein <unclear cert="medium" resp="#joint">geren</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">anhören</unclear>, <unclear cert="medium" resp="#joint">sonderen</unclear> <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="medium" resp="#joint">seine</unclear> werbung
<lb n="18"/>ihme mit <unclear cert="medium" resp="#joint">möglichost</unclear> <unclear cert="medium" resp="#joint">willfährigem</unclear> <unclear cert="medium" resp="#joint">bescheid</unclear>
<lb n="19"/>begegnen. <unclear cert="medium" resp="#joint">Wie</unclear> wir das gut <unclear cert="medium" resp="#joint">ver=</unclear>
<lb n="20"/>trauwen ohne das haben. Das <unclear cert="medium" resp="#joint">begeren</unclear>
<lb n="21"/>wir mit <unclear cert="medium" resp="#joint">eidtgnossischem</unclear> willen und <unclear cert="medium" resp="#joint">gemüet</unclear>
<lb n="22"/>jederzeit <unclear cert="low" resp="#joint">hinwiderumb</unclear> <unclear cert="low" resp="#joint">zuverdienen</unclear>.
<lb n="23"/><unclear cert="low" resp="#joint">Göttlicher</unclear> <unclear cert="low" resp="#joint">bewahr</unclear> uns zumal wol <unclear cert="medium" resp="#joint">befolhende</unclear>.
<lb n="24"/>Datum <origDate when="1637" resp="#ner">den. 30.ten <unclear cert="low" resp="#joint">Maji</unclear> <unclear cert="low" resp="#joint">Ao</unclear>. <unclear cert="low" resp="#joint">1637</unclear>.</origDate>
<lb n="25"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">B</unclear>. und <unclear cert="medium" resp="#joint">raht</unclear></orgName>
<lb n="26"/>Den hochgeachten, edlen, gestrengen, <unclear cert="medium" resp="#joint">fromen</unclear>,
<lb n="27"/>vesten, ehrenvesten, fürsichtigen, ersamen und
<lb n="28"/>weisen, <unclear cert="medium" resp="#joint">der</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">orten</unclear> <unclear cert="medium" resp="#joint">loblicher</unclear> <unclear cert="medium" resp="#joint">Eidtgnoschafft</unclear></orgName>
<lb n="29"/><unclear cert="medium" resp="#joint">fürtreffenlichen</unclear> <unclear cert="medium" resp="#joint">rahtsbotten</unclear>, <unclear cert="medium" resp="#joint">unseren</unclear> insonders
<lb n="30"/><unclear cert="medium" resp="#joint">wolvertrauwten</unclear> <unclear cert="medium" resp="#joint">guten</unclear> <unclear cert="medium" resp="#joint">freünden</unclear> und <unclear cert="medium" resp="#joint">getreüwen</unclear>
<lb n="31"/>lieben eidtgnossen.
<pb facs="StadtASG_Missive_2051_7678.jpg" n="2"/>
<lb n="32"/>Unser fründtlich willig dienst, und was
<lb n="33"/>wir ehren liebs und guets vermoegend, zuvor
<lb n="34"/>edler, vester, fromen, fürsichtigen, eersamen
<lb n="35"/>und weisen, insonders gueten fründen
<lb n="36"/>und getrüwen lieben Eidtgnossen.
<lb n="37"/><unclear cert="low" resp="#joint">Was</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">&amp;</unclear> ut in forma <unclear cert="low" resp="#joint">precedenti</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">mutatis</unclear> <unclear cert="low" resp="#joint">mutandis</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">videl</unclear>. <unclear cert="low" resp="#joint">pro</unclear> E. Vesteg. und <unclear cert="low" resp="#joint">Wht</unclear>., <unclear cert="low" resp="#joint">ponatur</unclear> E. <unclear cert="low" resp="#joint">Vst</unclear>.
<lb n="40"/>und <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="41"/><unclear cert="low" resp="#joint">An</unclear> <orgName ref="stadtasg-actors-514" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Schultheiß</unclear> und <unclear cert="low" resp="#joint">Raht</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">Bern</unclear></orgName>.
</p>
