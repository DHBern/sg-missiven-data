<lb n="42"/>so <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">nothwändigem</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> und erhaltung unsers geliebten,
<lb n="43"/>vatterlands, und von Gott <unclear cert="medium" resp="#joint">empfangnen</unclear> lyblichen <unclear cert="medium" resp="#joint">und</unclear>
