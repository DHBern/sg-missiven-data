<p>
<pb facs="StadtASG_Missive_2513_9689.jpg" n="1"/>
<lb n="1"/>Unser fründtlich willig <unclear cert="low" resp="#joint">diennst</unclear> <unclear cert="low" resp="#joint">sambt</unclear> was wir <unclear cert="low" resp="#joint">eheren</unclear> liebs und
<lb n="2"/>guots <unclear cert="medium" resp="#joint">vermoegend</unclear> zuvor, fromm fürsichtig, <unclear cert="medium" resp="#joint">eersam</unclear> wyß <unclear cert="medium" resp="#joint">in</unclear>-
<lb n="3"/><unclear cert="medium" resp="#joint">sonders</unclear> guot fründt und <unclear cert="low" resp="#joint">getrüw</unclear> lieb <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>, <unclear cert="low" resp="#joint">wellicher</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">massen</unclear> das <unclear cert="low" resp="#joint">jüngst</unclear> inn die <placeName resp="#ner"><unclear cert="low" resp="#joint">Pündt</unclear></placeName> <unclear cert="low" resp="#joint">gezogene</unclear> kriegs <unclear cert="low" resp="#joint">volck</unclear>
<lb n="5"/>sich der <unclear cert="medium" resp="#joint">herrschafft</unclear> <placeName ref="stadtasg-places-12" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Meyenfeldt</unclear></placeName>, <placeName resp="#ner"><unclear cert="medium" resp="#joint">Steig</unclear></placeName> und anderer orten,
<lb n="6"/>und <unclear cert="low" resp="#joint">sidtthero</unclear> inn den <placeName resp="#ner"><unclear cert="low" resp="#joint">Pündten</unclear></placeName> mit der hilff <unclear cert="medium" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">wid</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">rumb</unclear> <unclear cert="low" resp="#joint">bemechtiget</unclear>, <unclear cert="low" resp="#joint">deßna</unclear> <unclear cert="medium" resp="#joint">werdent</unclear> <unclear cert="low" resp="#joint">Ir</unclear> unser lieb <unclear cert="medium" resp="#joint">Eydt</unclear>-
<lb n="8"/>gnossen <unclear cert="low" resp="#joint">zwyffels</unclear> ohn <unclear cert="low" resp="#joint">inn</unclear> mehr <unclear cert="low" resp="#joint">guoten</unclear> bericht empfangen
<lb n="9"/>haben. <unclear cert="low" resp="#joint">Wann</unclear> dann <unclear cert="low" resp="#joint">vermuotlich</unclear>, das es <unclear cert="medium" resp="#joint">darby</unclear> nit <unclear cert="low" resp="#joint">verbleiben</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">sonders</unclear> diß <unclear cert="medium" resp="#joint">eben</unclear> <unclear cert="low" resp="#joint">jetz</unclear> <unclear cert="low" resp="#joint">beschechne</unclear> <unclear cert="low" resp="#joint">gschefft</unclear> vil gefahrliche wyt-
<lb n="11"/><unclear cert="low" resp="#joint">loüffigkeiten</unclear> <unclear cert="low" resp="#joint">verursachen</unclear>, und <unclear cert="medium" resp="#joint">zuo</unclear> einem nüwen <unclear cert="medium" resp="#joint">krieg</unclear> <unclear cert="low" resp="#joint">geraten</unclear>
<lb n="12"/>werde, wie dann das <unclear cert="low" resp="#joint">uffbot</unclear> (<unclear cert="medium" resp="#joint">empfangnem</unclear> bricht nach) inn
<lb n="13"/>den <placeName ref="stadtasg-places-91" cert="medium" resp="#ner">ober <unclear cert="low" resp="#joint">oesterrychischen</unclear> landen</placeName> biß <unclear cert="low" resp="#joint">gëgen</unclear> <placeName ref="stadtasg-places-99" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Tyrol</unclear></placeName> <unclear cert="medium" resp="#joint">schon</unclear> be-
<lb n="14"/><unclear cert="low" resp="#joint">schächen</unclear>, und <unclear cert="medium" resp="#joint">des</unclear> <unclear cert="medium" resp="#joint">landts</unclear> <unclear cert="medium" resp="#joint">ußgschoßne</unclear> volck inn <unclear cert="low" resp="#joint">zimblicher</unclear>
<lb n="15"/>anzahl <unclear cert="medium" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">anzug</unclear> <unclear cert="medium" resp="#joint">naher</unclear> <unclear cert="medium" resp="#joint">Pündten</unclear> syn sol, und also zuobe-
<lb n="16"/>sorgen, das hierdurch <unclear cert="medium" resp="#joint">gemeiner</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eydtgnoschafft</orgName>, <unclear cert="medium" resp="#joint">sonderlich</unclear>
<lb n="17"/>aber uns <unclear cert="low" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">Evangelischen</unclear> Orten ouch allerley <unclear cert="medium" resp="#joint">übel</unclear>
<lb n="18"/>und ungemach <unclear cert="low" resp="#joint">zuogezogen</unclear>, und <unclear cert="medium" resp="#joint">villicht</unclear> <unclear cert="low" resp="#joint">fyendtlich</unclear> <unclear cert="low" resp="#joint">zuogesetzt</unclear>
<lb n="19"/>werden <unclear cert="medium" resp="#joint">moechte</unclear>, So will die <unclear cert="low" resp="#joint">hoche</unclear> <unclear cert="low" resp="#joint">unvermydenliche</unclear> <unclear cert="medium" resp="#joint">not</unclear>-
<lb n="20"/><unclear cert="low" resp="#joint">turfft</unclear> <unclear cert="low" resp="#joint">erforderen</unclear>, das wir uns <unclear cert="medium" resp="#joint">abermaln</unclear> <unclear cert="medium" resp="#joint">zesamen</unclear> <unclear cert="medium" resp="#joint">thüegint</unclear>
<lb n="21"/>und uns mit einanderen <unclear cert="low" resp="#joint">eijgentlich</unclear> und <unclear cert="low" resp="#joint">schlißlich</unclear> <unclear cert="low" resp="#joint">underredind</unclear>,
