<lb n="23"/>Orten der Eydtgnoschafft <unclear cert="low" resp="#joint">inbrächen</unclear> und uns <unclear cert="low" resp="#joint">zuosetzen</unclear> <unclear cert="low" resp="#joint">welte</unclear>,
<lb n="24"/>mit was <unclear cert="medium" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">einem</unclear> <unclear cert="medium" resp="#joint">kriegs</unclear> <unclear cert="low" resp="#joint">heer</unclear> und <unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">starck</unclear> man
