<lb n="61"/><unclear cert="low" resp="#joint">willfaerigung</unclear> <unclear cert="low" resp="#joint">seün</unclear> <unclear cert="low" resp="#joint">moechte</unclear>: <unclear cert="low" resp="#joint">Dann</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">derselben</unclear>, <unclear cert="low" resp="#joint">alles</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">jenig</unclear>, was ihnen lieb, gefellig
