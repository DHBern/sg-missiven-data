<p>
<pb facs="StadtASG_Missive_2187_8219.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">freündt</unclear>: <unclear cert="low" resp="#joint">nachbaurlich</unclear> willig dienst zuvor, fürsichtig
<lb n="2"/>ersam und weiß, <unclear cert="medium" resp="#joint">besonders</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">freünd</unclear> und guete
<lb n="3"/><unclear cert="medium" resp="#joint">nachbaurn</unclear>.
<lb n="4"/>Was <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">ft</unclear>. <unclear cert="low" resp="#joint">wst</unclear>. uns, wegen unsers <unclear cert="low" resp="#joint">statthauptmans</unclear>
<lb n="5"/><persName resp="#ner"><unclear cert="low" resp="#joint">Matthias</unclear> <unclear cert="low" resp="#joint">Polen</unclear></persName> (<unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">rhats</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">besserer</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">wahrung</unclear> ihrer statt <unclear cert="medium" resp="#joint">zuegebrauchen</unclear> <unclear cert="medium" resp="#joint">begehrn</unclear>) <unclear cert="medium" resp="#joint">vertraw</unclear>-
<lb n="7"/>lich <unclear cert="medium" resp="#joint">zuegeschriben</unclear>: <unclear cert="medium" resp="#joint">das</unclear> haben wir <unclear cert="medium" resp="#joint">ablesend</unclear> wol
<lb n="8"/>vernommen.
<lb n="9"/>Und <unclear cert="low" resp="#joint">sollen</unclear> <unclear cert="low" resp="#joint">hierauff</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">ft</unclear>. <unclear cert="low" resp="#joint">wst</unclear>. uns <unclear cert="medium" resp="#joint">sicherlich</unclear> <unclear cert="medium" resp="#joint">glaüben</unclear>,
<lb n="10"/>das <unclear cert="medium" resp="#joint">denselben</unclear>, <unclear cert="medium" resp="#joint">inn</unclear> disem und <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">zuewillfahren</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">wir</unclear> gantz <unclear cert="medium" resp="#joint">begirig</unclear> und geneigt.
<lb n="12"/>Demnach aber er unser <unclear cert="medium" resp="#joint">statthauptmann</unclear> <unclear cert="medium" resp="#joint">albereit</unclear> vor
<lb n="13"/>disem, zue <unclear cert="low" resp="#joint">zweyen</unclear> <unclear cert="low" resp="#joint">underschidlichen</unclear> <unclear cert="low" resp="#joint">mahlen</unclear> <unclear cert="low" resp="#joint">vonn</unclear> <unclear cert="low" resp="#joint">den</unclear>
<lb n="14"/><orgName resp="#ner"><unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">vonn</unclear> <unclear cert="low" resp="#joint">Steinarw</unclear></orgName>, <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">berhatschlagung</unclear> fortificationen,
<lb n="15"/><unclear cert="medium" resp="#joint">erfordert</unclear>, und aber ein solches (<unclear cert="medium" resp="#joint">auß</unclear> <unclear cert="medium" resp="#joint">gwissen</unclear> <unclear cert="medium" resp="#joint">ursachen</unclear>,
<lb n="16"/><unclear cert="medium" resp="#joint">abgelainet</unclear> worden (<unclear cert="medium" resp="#joint">also</unclear> <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">ungnad</unclear> auff <unclear cert="medium" resp="#joint">ihn</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">gewohrfen</unclear>: Und nun <unclear cert="medium" resp="#joint">eben</unclear> <unclear cert="medium" resp="#joint">dis</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">statthaupt</unclear>-
<lb n="18"/>man auch wegen <unclear cert="low" resp="#joint">herrn</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Graf</unclear> <unclear cert="low" resp="#joint">Friderichs</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Solms</unclear></persName>,
<lb n="19"/><unclear cert="low" resp="#joint">der</unclear> <orgName ref="stadtasg-actors-771" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Evangelischen</unclear> <unclear cert="low" resp="#joint">Union</unclear></orgName> <unclear cert="low" resp="#joint">oberstens</unclear>, (so <unclear cert="medium" resp="#joint">im</unclear> <date resp="#ner">Octobris <unclear cert="medium" resp="#joint">jüngst</unclear></date>-
<lb n="20"/><unclear cert="medium" resp="#joint">hin</unclear> <unclear cert="medium" resp="#joint">hie</unclear> gewesen, und mit <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">Polen</unclear> conversation ge-
<lb n="21"/><unclear cert="medium" resp="#joint">pflogen</unclear>) <unclear cert="medium" resp="#joint">bei</unclear> <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">benachbaurten</unclear> <unclear cert="medium" resp="#joint">inn</unclear> grossen ver-
<lb n="22"/>dacht eingelauffen: Alls <unclear cert="low" resp="#joint">seind</unclear> <unclear cert="low" resp="#joint">wir</unclear> nicht
<lb n="23"/>wenig sorgfältig, es möchte er unser <unclear cert="medium" resp="#joint">statthauptman</unclear>,
<lb n="24"/>durch <unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="medium" resp="#joint">fürnemmende</unclear> reiß (welche, <unclear cert="low" resp="#joint">unserer</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">eignen</unclear> <unclear cert="low" resp="#joint">burgerschafft</unclear> halber, nicht <unclear cert="medium" resp="#joint">heimblich</unclear> <unclear cert="medium" resp="#joint">beschehen</unclear>
<lb n="26"/>oder <unclear cert="medium" resp="#joint">verschwigen</unclear> <unclear cert="medium" resp="#joint">bleiben</unclear> <unclear cert="medium" resp="#joint">mag</unclear>) noch <unclear cert="medium" resp="#joint">mehrern</unclear>
