<lb n="25"/>nuß <unclear cert="medium" resp="#joint">angeregter</unclear> by üch <unclear cert="medium" resp="#joint">Im</unclear> <unclear cert="medium" resp="#joint">müntzen</unclear> <unclear cert="medium" resp="#joint">haltender</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">ordnung</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">khomen</unclear> <unclear cert="medium" resp="#joint">laßen</unclear> <unclear cert="medium" resp="#joint">hierunder</unclear> deß <unclear cert="medium" resp="#joint">einen</unclear> unnd
<lb n="27"/><unclear cert="medium" resp="#joint">anderen</unclear> <unclear cert="medium" resp="#joint">halber</unclear> <unclear cert="medium" resp="#joint">desto</unclear> mehr unnd <unclear cert="medium" resp="#joint">beßere</unclear> nach-
<lb n="28"/>richtung <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">haben</unclear>, <unclear cert="low" resp="#joint">Das</unclear> <unclear cert="low" resp="#joint">gereicht</unclear> <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">zu</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydtgnöß</unclear></orgName>-
<lb n="29"/><unclear cert="low" resp="#joint">ischer</unclear> fründtschafft unnd gfallen, so wir <unclear cert="medium" resp="#joint">umb</unclear> üch
<lb n="30"/><unclear cert="medium" resp="#joint">hinwider</unclear> <unclear cert="medium" resp="#joint">fründtlich</unclear> <unclear cert="medium" resp="#joint">zebeschulden</unclear> <unclear cert="medium" resp="#joint">geneigt</unclear> sind, <unclear cert="low" resp="#joint">unß</unclear>
<lb n="31"/>unnd <unclear cert="low" resp="#joint">sambtlich</unclear> damit <unclear cert="medium" resp="#joint">Göttlichen</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> <unclear cert="medium" resp="#joint">bevelchend</unclear>.
<lb n="32"/>Datum den <origDate when="1621" resp="#ner"><unclear cert="medium" resp="#joint">11.ten</unclear> <unclear cert="medium" resp="#joint">Januarij</unclear> Anno 1621</origDate>.
<lb n="33"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister unnd Rath
<lb n="34"/>der Statt Zürich</orgName>.
