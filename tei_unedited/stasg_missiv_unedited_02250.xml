<lb n="12"/><unclear cert="medium" resp="#joint">gesehen</unclear>, <unclear cert="medium" resp="#joint">Waß</unclear> nun daselbst <unclear cert="medium" resp="#joint">verhandlet</unclear> unnd ver-
<lb n="13"/><unclear cert="medium" resp="#joint">gächen</unclear> <unclear cert="medium" resp="#joint">werden</unclear> mag, <unclear cert="medium" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">werdent</unclear> <unclear cert="medium" resp="#joint">Ihr</unclear> unnd <unclear cert="medium" resp="#joint">andere</unclear>
