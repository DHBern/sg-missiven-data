<lb n="23"/><unclear cert="medium" resp="#joint">derwegen</unclear> <unclear cert="medium" resp="#joint">an</unclear> üch <unclear cert="medium" resp="#joint">unnser</unclear> fründtlich <unclear cert="medium" resp="#joint">pitt</unclear> <unclear cert="medium" resp="#joint">Ihr</unclear> <unclear cert="medium" resp="#joint">wel</unclear>-
