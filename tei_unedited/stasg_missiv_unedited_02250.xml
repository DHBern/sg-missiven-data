<lb n="1"/><unclear cert="medium" resp="#joint">Unnser</unclear> fründtlich willig <unclear cert="medium" resp="#joint">dinst</unclear>, unnd was wir
<lb n="2"/><unclear cert="medium" resp="#joint">ehren</unclear> liebs unnd guots vermögend, <unclear cert="medium" resp="#joint">sambt</unclear> <unclear cert="medium" resp="#joint">wünsch</unclear>-
