<lb n="5"/><unclear cert="medium" resp="#joint">sonders</unclear> guot fründt, unnd <unclear cert="medium" resp="#joint">gethrüw</unclear> lieb <unclear cert="low" resp="#joint">Eydtgnoß</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">en</unclear>. Uff <unclear cert="medium" resp="#joint">unnserer</unclear> lieben <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">der</unclear> Statt <placeName ref="stadtasg-places-69" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Lucern</unclear></placeName> <unclear cert="medium" resp="#joint">begehren</unclear> von wegen deß <unclear cert="medium" resp="#joint">jetzig</unclear>-
<lb n="8"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="medium" resp="#joint">beschwerlichen</unclear> <unclear cert="medium" resp="#joint">unruwigen</unclear> <unclear cert="medium" resp="#joint">müntzwesens</unclear> unnd
<lb n="9"/><unclear cert="low" resp="#joint">täglicher</unclear> <unclear cert="low" resp="#joint">steigerung</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">gelts</unclear> Ist ein <unclear cert="medium" resp="#joint">zesamenkunfft</unclear>
<lb n="10"/>von <unclear cert="medium" resp="#joint">Ihnen</unclear> unnd <unclear cert="low" resp="#joint">unß</unclear>, <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">unnsern</unclear> lieben <unclear cert="medium" resp="#joint">Eydt</unclear>-
