<lb n="64"/><orgName role="issuer" resp="#ner">Burgermeister <unclear cert="medium" resp="#joint">und</unclear>
<lb n="65"/>Rath der <unclear cert="medium" resp="#joint">stat</unclear> <unclear cert="medium" resp="#joint">Kempten</unclear></orgName>.
<pb facs="StadtASG_Missive_2609_10128.jpg" n="4"/>
<lb n="66"/>Den Frommen, Vesten, Ehrnvesten und
<lb n="67"/>Weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und Rath
<lb n="68"/>der Statt S. Gallen</orgName>, unsern sonders
<lb n="69"/>lieben Herrn und <unclear cert="low" resp="#joint">Freünden</unclear>.
