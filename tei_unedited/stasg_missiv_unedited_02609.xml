<lb n="28"/>weil <unclear cert="medium" resp="#joint">beij</unclear> allen <unclear cert="medium" resp="#joint">staenden</unclear> und <unclear cert="medium" resp="#joint">staetten</unclear> der
<lb n="29"/>mangel an gelt <unclear cert="medium" resp="#joint">dister</unclear> zeit <unclear cert="medium" resp="#joint">geklagt</unclear> <unclear cert="medium" resp="#joint">wirdt</unclear>,
<lb n="30"/>dahero wir auch <unclear cert="medium" resp="#joint">unsre</unclear> <unclear cert="medium" resp="#joint">anbefolhene</unclear>
