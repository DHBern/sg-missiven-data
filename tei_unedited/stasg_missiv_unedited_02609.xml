<lb n="61"/>in <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">schutz</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">allerhöchsten</unclear> gantz <unclear cert="medium" resp="#joint">treulich</unclear>
