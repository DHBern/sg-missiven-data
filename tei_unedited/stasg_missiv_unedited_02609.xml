<lb n="36"/>erlangen <unclear cert="medium" resp="#joint">koenden</unclear>, sonder <unclear cert="medium" resp="#joint">muessen</unclear> in sorgen
<lb n="37"/>stehen: Ir <unclear cert="low" resp="#joint">frtl</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">moechten</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">betroehungen</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">ins</unclear> werckh <unclear cert="medium" resp="#joint">sezen</unclear>, und <unclear cert="medium" resp="#joint">etwan</unclear> unß
<lb n="39"/>und der <unclear cert="medium" resp="#joint">posteritet</unclear> ain solliche <unclear cert="medium" resp="#joint">beschwerdt</unclear>
<lb n="40"/><unclear cert="medium" resp="#joint">zuefueegen</unclear>, die wol <unclear cert="medium" resp="#joint">nimermer</unclear> ab-
<lb n="41"/><unclear cert="medium" resp="#joint">zuewenden</unclear> und <unclear cert="medium" resp="#joint">zuebeclagen</unclear> were:
<lb n="42"/>Wir aber nit <unclear cert="medium" resp="#joint">zweiflen</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. <unclear cert="medium" resp="#joint">seijen</unclear>
<lb n="43"/><unclear cert="medium" resp="#joint">beij</unclear> gemainer <unclear cert="medium" resp="#joint">irer</unclear> statt <unclear cert="medium" resp="#joint">aerario</unclear>,
<lb n="44"/>von Gott dem <unclear cert="medium" resp="#joint">allmaechtigen</unclear> mit sollicher
<lb n="45"/><unclear cert="medium" resp="#joint">baarschafft</unclear> <unclear cert="medium" resp="#joint">gesegnet</unclear>, daß <unclear cert="medium" resp="#joint">sij</unclear> <unclear cert="medium" resp="#joint">unß</unclear> in
<lb n="46"/>sollichem <unclear cert="medium" resp="#joint">hoechstgefaerlichen</unclear> <unclear cert="medium" resp="#joint">zuestand</unclear>
<lb n="47"/>mit acht: oder <unclear cert="medium" resp="#joint">zehentausent</unclear> gulden
<lb n="48"/>wol <unclear cert="medium" resp="#joint">zuhilf</unclear> komen <unclear cert="medium" resp="#joint">koenden</unclear> und <unclear cert="medium" resp="#joint">moegen</unclear>.
<lb n="49"/><unclear cert="medium" resp="#joint">Derowegen</unclear> so gelangt an <unclear cert="medium" resp="#joint">sij</unclear> unser
<pb facs="StadtASG_Missive_2609_10127.jpg" n="3"/>
<lb n="50"/>gantz <unclear cert="medium" resp="#joint">freundtlichs</unclear> und <unclear cert="medium" resp="#joint">hochfleissigs</unclear> <unclear cert="medium" resp="#joint">biten</unclear>
<lb n="51"/><unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">wöllen</unclear>, <unclear cert="medium" resp="#joint">unserem</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">inen</unclear> habenden
<lb n="52"/>grossen <unclear cert="medium" resp="#joint">vertrauen</unclear> nach, unß <unclear cert="medium" resp="#joint">ain</unclear> <unclear cert="medium" resp="#joint">solche</unclear>
<lb n="53"/><unclear cert="medium" resp="#joint">summa</unclear>, gegen <unclear cert="medium" resp="#joint">gnugsamer</unclear> <unclear cert="medium" resp="#joint">versicherung</unclear>,
<lb n="54"/>und umb <unclear cert="medium" resp="#joint">gebürend</unclear> interesse, <unclear cert="medium" resp="#joint">auf</unclear> ain an-
<lb n="55"/>zal <unclear cert="medium" resp="#joint">jar</unclear>, nachbarlich <unclear cert="medium" resp="#joint">fürstreckhen</unclear>, <unclear cert="medium" resp="#joint">und</unclear>
