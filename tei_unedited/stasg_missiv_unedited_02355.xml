<p>
<pb facs="StadtASG_Missive_2355_9021.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">frünttlich</unclear> gruoß, sampt was wir liebs und
<lb n="2"/>guots vermögend, <unclear cert="medium" resp="#joint">zuovor</unclear>, fromm, fürsichtig, <unclear cert="low" resp="#joint">ehrsam</unclear>, <unclear cert="low" resp="#joint">wÿß</unclear>,
<lb n="3"/>insonders <unclear cert="medium" resp="#joint">guott</unclear> fründt, und getrüw lieb <unclear cert="low" resp="#joint">Eÿdtgnossen</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Obwol</unclear> wir <unclear cert="low" resp="#joint">zwar</unclear> <unclear cert="low" resp="#joint">üweren</unclear> burger und metzger, <persName resp="#ner"><unclear cert="medium" resp="#joint">Cuonradt</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">Rainer</unclear></persName> und <persName resp="#ner"><unclear cert="low" resp="#joint">Hannß</unclear> <unclear cert="low" resp="#joint">Appenzeller</unclear></persName>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">betrahtung</unclear> <unclear cert="low" resp="#joint">deß</unclear> mangels
<lb n="6"/>und <unclear cert="low" resp="#joint">clambs</unclear> <unclear cert="low" resp="#joint">vÿches</unclear>, der sich <unclear cert="low" resp="#joint">je</unclear> mehr und mehr <unclear cert="low" resp="#joint">eröugt</unclear>, wie
<lb n="7"/>wir üch den <unclear cert="medium" resp="#joint">8</unclear> diß <unclear cert="medium" resp="#joint">wÿtleüftiger</unclear> zuogeschriben, <unclear cert="medium" resp="#joint">angeregt</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">erkaufft</unclear> <unclear cert="medium" resp="#joint">vÿch</unclear> <unclear cert="medium" resp="#joint">abzuotrÿben</unclear> <unclear cert="medium" resp="#joint">anlaß</unclear> und <unclear cert="low" resp="#joint">fuog</unclear> <unclear cert="low" resp="#joint">gehept</unclear> hettend,
<lb n="9"/>so habendt wir doch <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">üwer</unclear> intercedieren und <unclear cert="low" resp="#joint">zügnuß</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">söliches</unclear> <unclear cert="low" resp="#joint">nienen</unclear> <unclear cert="low" resp="#joint">andersthin</unclear> dann <unclear cert="medium" resp="#joint">in</unclear> <unclear cert="medium" resp="#joint">üwer</unclear> statt ver-
<lb n="11"/>metzg wollind, einen jeden anlaß zwentzig haupt vÿchs
<lb n="12"/>für diß mahl hinder <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">uffzekauffen</unclear>, <unclear cert="low" resp="#joint">verwilliget</unclear> und zu-
<lb n="13"/>gelass, üch aber <unclear cert="low" resp="#joint">dabÿ</unclear> <unclear cert="low" resp="#joint">fründt</unclear>: <unclear cert="low" resp="#joint">Eÿdt</unclear>: <unclear cert="low" resp="#joint">ersuch</unclear> <unclear cert="low" resp="#joint">wollen</unclear>, <unclear cert="low" resp="#joint">den</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">üweren</unclear> <unclear cert="low" resp="#joint">derglÿch</unclear> patenten wie <unclear cert="low" resp="#joint">dise</unclear>, alß <unclear cert="low" resp="#joint">welche</unclear> uff für-
<lb n="15"/>kauff heiter <unclear cert="low" resp="#joint">dütend</unclear>, in dem darinn vermeldet <unclear cert="low" resp="#joint">würt</unclear> dz
<lb n="16"/><unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">zwar</unclear> ir <unclear cert="low" resp="#joint">erkauffend</unclear> <unclear cert="low" resp="#joint">vÿch</unclear>, <unclear cert="medium" resp="#joint">nirgends</unclear> <unclear cert="low" resp="#joint">andersthin</unclear> dann in
<lb n="17"/>üwer statt <unclear cert="low" resp="#joint">vermetzg</unclear>, aber <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">sölichs</unclear> <unclear cert="low" resp="#joint">verbringt</unclear>,
<lb n="18"/><unclear cert="medium" resp="#joint">anderen</unclear> <unclear cert="medium" resp="#joint">üwern</unclear> <unclear cert="low" resp="#joint">verburgerten</unclear> <unclear cert="medium" resp="#joint">an</unclear> die <unclear cert="low" resp="#joint">handt</unclear> <unclear cert="low" resp="#joint">geb</unclear> und ver-
<lb n="19"/>kauff wollindt, hiedurch aber gar <unclear cert="low" resp="#joint">lÿchtlich</unclear> <unclear cert="low" resp="#joint">gefärd</unclear> <unclear cert="medium" resp="#joint">verüebt</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">werden</unclear> kan, <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">zertheillen</unclear>, dann <unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">lut</unclear> <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">ußgangnen</unclear>
<lb n="21"/>mandaten <unclear cert="medium" resp="#joint">hindersich</unclear> <unclear cert="medium" resp="#joint">gestelt</unclear> <unclear cert="medium" resp="#joint">wurdt</unclear>, und <unclear cert="low" resp="#joint">diewÿll</unclear> dann er-
<lb n="22"/><unclear cert="low" resp="#joint">nanter</unclear> <unclear cert="medium" resp="#joint">üwer</unclear> burger <persName resp="#ner"><unclear cert="low" resp="#joint">Rainer</unclear></persName> <unclear cert="medium" resp="#joint">in</unclear> der üch <unclear cert="medium" resp="#joint">fürgelegten</unclear>, <unclear cert="low" resp="#joint">un</unclear>-
<lb n="23"/>und <unclear cert="low" resp="#joint">überschikten</unclear> supplication selbs <unclear cert="low" resp="#joint">bekent</unclear>, <unclear cert="low" resp="#joint">se</unclear> <unclear cert="low" resp="#joint">haupt</unclear> <unclear cert="low" resp="#joint">vÿch</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">an</unclear> die <unclear cert="low" resp="#joint">frömbde</unclear> verkaufft, und also <unclear cert="low" resp="#joint">fürkauff</unclear> <unclear cert="low" resp="#joint">triben</unclear> zehaben,
<lb n="25"/>so <unclear cert="medium" resp="#joint">habendt</unclear> wir ime auferlegt, dieselbig zuo <unclear cert="low" resp="#joint">vertröst</unclear> der
<lb n="26"/>hoffnung er sich deß nützig zuo beschwären hab werde. <unclear cert="low" resp="#joint">Diß</unclear> <unclear cert="low" resp="#joint">wolt</unclear>
<lb n="27"/>wir üch <unclear cert="low" resp="#joint">besser</unclear> meinung nit <unclear cert="low" resp="#joint">bergen</unclear>, und <unclear cert="low" resp="#joint">blib</unclear> <unclear cert="low" resp="#joint">demselben</unclear> <unclear cert="low" resp="#joint">allezeit</unclear> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="28"/>fründtschafft erzeügung gantz geneigt wir hiemit <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> <unclear cert="medium" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">befelhende</unclear>.
<lb n="30"/>Datum <origDate when="1622-10-22" resp="#ner">22. octobris <unclear cert="medium" resp="#joint">1622</unclear></origDate>. <orgName ref="stadtasg-actors-514" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Schultheiß</unclear> und rath
<lb n="31"/>der statt <unclear cert="low" resp="#joint">Bärn</unclear></orgName>.
<pb facs="StadtASG_Missive_2355_9022.jpg" n="2"/>
<pb facs="StadtASG_Missive_2355_9023.jpg" n="3"/>
<pb facs="StadtASG_Missive_2355_9024.jpg" n="4"/>
<lb n="32"/>Den <unclear cert="medium" resp="#joint">fromen</unclear>, fürsichtigen
<lb n="33"/>ehrsamen, <unclear cert="low" resp="#joint">wÿßen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister
<lb n="34"/>und <unclear cert="medium" resp="#joint">Raht</unclear> der Statt St. Gallen</orgName>
<lb n="35"/>unsern insonders <unclear cert="low" resp="#joint">guoten</unclear> fründen,
