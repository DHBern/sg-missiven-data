<lb n="10"/>habind, damit solcher zuo <unclear cert="medium" resp="#joint">guoter</unclear> <unclear cert="medium" resp="#joint">endschafft</unclear> (wie <unclear cert="medium" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">beschehen</unclear>) <unclear cert="low" resp="#joint">khomen</unclear>
