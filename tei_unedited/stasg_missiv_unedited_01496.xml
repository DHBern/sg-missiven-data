<lb n="7"/>der <unclear cert="low" resp="#joint">lenge</unclear> nach <unclear cert="low" resp="#joint">verßtendiget</unclear>, wie das <unclear cert="low" resp="#joint">ir</unclear>, in <unclear cert="low" resp="#joint">dißerm</unclear> handel, <unclear cert="low" resp="#joint">üwern</unclear>
