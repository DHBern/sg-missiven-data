<p>
<pb facs="StadtASG_Missive_2559_9883.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">freundtlich</unclear> willig diennst zuvor, Fürsichtigen, <unclear cert="medium" resp="#joint">Er</unclear>-
<lb n="2"/><unclear cert="medium" resp="#joint">samen</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> Weisen, besonders lieben <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">Freunndt</unclear>.
<lb n="3"/>Derselben <unclear cert="medium" resp="#joint">schreiben</unclear> <unclear cert="medium" resp="#joint">weegen</unclear> unnsers <unclear cert="medium" resp="#joint">gewessten</unclear> <unclear cert="medium" resp="#joint">Burgers</unclear>
<lb n="4"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Friderichen</unclear> <unclear cert="medium" resp="#joint">Heissen</unclear></persName> sel. den <date resp="#ner">22.ten <unclear cert="medium" resp="#joint">Julii</unclear></date> an unns <unclear cert="medium" resp="#joint">abgang</unclear>
<lb n="5"/>haben <unclear cert="medium" resp="#joint">wür</unclear> recht empfangen, <unclear cert="medium" resp="#joint">unnd</unclear> nicht <unclear cert="medium" resp="#joint">unnderlassen</unclear>, <unclear cert="medium" resp="#joint">also</unclear>-
<lb n="6"/>bald <unclear cert="low" resp="#joint">darauf</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">hiesige</unclear> <unclear cert="low" resp="#joint">verlassenschafft</unclear> <unclear cert="low" resp="#joint">zusecretiren</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">volgends</unclear> auch <unclear cert="low" resp="#joint">zuinventiren</unclear>. <unclear cert="low" resp="#joint">Dweil</unclear> sich nun gar ein
<lb n="8"/><unclear cert="medium" resp="#joint">schlechtes</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> gantz nichts von <unclear cert="medium" resp="#joint">gerberwahren</unclear> <unclear cert="medium" resp="#joint">befindet</unclear>,
<lb n="9"/><unclear cert="medium" resp="#joint">unnd</unclear> sein <unclear cert="low" resp="#joint">Ehewürtin</unclear> <unclear cert="low" resp="#joint">uber</unclear> <unclear cert="low" resp="#joint">verschußer</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear> <unclear cert="low" resp="#joint">bestendig</unclear>
