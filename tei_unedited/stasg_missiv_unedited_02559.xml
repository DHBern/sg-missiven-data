<lb n="19"/>sich gehabt, <unclear cert="medium" resp="#joint">erloest</unclear>, in gemeine <unclear cert="low" resp="#joint">massam</unclear>, wie <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">gebuert</unclear>,
