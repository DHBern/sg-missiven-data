<lb n="16"/>Da nun <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. Burger auch darzue <unclear cert="low" resp="#joint">zusprechen</unclear> haben,
<lb n="17"/><unclear cert="medium" resp="#joint">unnd</unclear> daß <unclear cert="medium" resp="#joint">Jenige</unclear> <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">Si</unclear> auß den <unclear cert="medium" resp="#joint">verkhaufften</unclear> <unclear cert="medium" resp="#joint">dreien</unclear>
