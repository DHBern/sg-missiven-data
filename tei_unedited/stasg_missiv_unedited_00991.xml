<p>
<pb facs="StadtASG_Missive_991_3017.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">fruendtlich</unclear> willig diennst mit <unclear cert="medium" resp="#joint">erpiettung</unclear> aller
<lb n="2"/>eeren unnd guett zuevoran, from, fuersichtig, ersam, wyß,
<lb n="3"/>innsonnders <unclear cert="low" resp="#joint">guetten</unclear> fruend unnd <unclear cert="low" resp="#joint">gethruwen</unclear>, lieben
<lb n="4"/><orgName ref="stadtasg-actors-750" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Eydgnossen</unclear></orgName>, es ist vor unns <unclear cert="low" resp="#joint">erschinen</unclear>, unnser
<lb n="5"/>lieber <unclear cert="low" resp="#joint">gethruwer</unclear> <persName resp="#ner">Jacob Götz vonn Huefenn</persName>, in unnser
<lb n="6"/>Lanndtgraffschafft <unclear cert="low" resp="#joint">Thurgoew</unclear> unnd anzeigt, demnach
<lb n="7"/>vor khurtz zytt <persName resp="#ner">Barbara <unclear cert="low" resp="#joint">Aengnerin</unclear></persName> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">saeligen</unclear>,
<lb n="8"/>lieben <unclear cert="low" resp="#joint">hußfrowen</unclear>, <unclear cert="low" resp="#joint">vonn</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Catherina</unclear> <unclear cert="low" resp="#joint">Vewillerin</unclear></persName>, in uwer
<lb n="9"/>statt <unclear cert="low" resp="#joint">einenn</unclear> <unclear cert="low" resp="#joint">erbfal</unclear> gefallen, <unclear cert="medium" resp="#joint">denn</unclear> sy ouch <unclear cert="medium" resp="#joint">zue</unclear> theil <unclear cert="medium" resp="#joint">en=</unclear>
<lb n="10"/>pfanngen nach <unclear cert="low" resp="#joint">luch</unclear> uwer Statt <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sannt</unclear> Gallen</placeName> <unclear cert="low" resp="#joint">erbrecht</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">wellicher</unclear> <unclear cert="low" resp="#joint">inen</unclear> aber <unclear cert="low" resp="#joint">menthails</unclear> von <unclear cert="low" resp="#joint">uech</unclear> widerumb aber=
<lb n="12"/><unclear cert="low" resp="#joint">kenndt</unclear> worden, <unclear cert="low" resp="#joint">vonn</unclear> <unclear cert="low" resp="#joint">waegen</unclear> das sin <unclear cert="low" resp="#joint">gegentheil</unclear> ver=
<lb n="13"/><unclear cert="low" resp="#joint">meine</unclear>, das <unclear cert="low" resp="#joint">söllich</unclear> erb nach der Lanndtgraffschafft <placeName ref="stadtasg-places-103" cert="medium" resp="#ner">Thur=
<lb n="14"/><unclear cert="medium" resp="#joint">goew</unclear></placeName> unnd nit nach uwer statt erbrecht <unclear cert="low" resp="#joint">sölte</unclear> <unclear cert="low" resp="#joint">getheilt</unclear>
<lb n="15"/>werden, welliches <unclear cert="low" resp="#joint">im</unclear> aber <unclear cert="low" resp="#joint">beschwaerlich</unclear>. Unnd
<lb n="16"/><unclear cert="low" resp="#joint">deßhalb</unclear> so <unclear cert="low" resp="#joint">waer</unclear> sin ganntz unnderthenig dinstlich bit,
<lb n="17"/>an unns wir <unclear cert="low" resp="#joint">woelten</unclear> <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">unnseren</unclear> ge=
<lb n="18"/><unclear cert="low" resp="#joint">thruwen</unclear> lieben <unclear cert="low" resp="#joint">Eydgnossen</unclear> mit <unclear cert="low" resp="#joint">fuergschrifft</unclear> <unclear cert="low" resp="#joint">erschießlich</unclear>
<lb n="19"/>sin, damit er by <unclear cert="low" resp="#joint">uwer</unclear> statt erbrecht geschuetzt geschirmpt
<lb n="20"/>unnd <unclear cert="low" resp="#joint">ime</unclear> wie <unclear cert="medium" resp="#joint">denn</unclear> annderen der <persName resp="#ner">Cathrina <unclear cert="low" resp="#joint">Vewillerin</unclear></persName>
<lb n="21"/>erben, vonn irem haab unnd guett möchte verlanngen
<lb n="22"/>gevolgen unnd werden, das <unclear cert="low" resp="#joint">begaere</unclear> er umb <unclear cert="low" resp="#joint">unns</unclear>
<lb n="23"/>in aller unnderthenigkeit zuverdienen. Unnd
<lb n="24"/>so wir nuo gemeltem <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Götzen</unclear></persName> inn <unclear cert="low" resp="#joint">söllichem</unclear> <unclear cert="low" resp="#joint">sinem</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">begaerenn</unclear> unnd <unclear cert="low" resp="#joint">bit</unclear> verstannden, habend wir ime
<lb n="26"/>söllichs nit <unclear cert="low" resp="#joint">weigeren</unclear> <unclear cert="low" resp="#joint">kuenen</unclear>. <unclear cert="low" resp="#joint">Hieruf</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">gelangt</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">hiemit</unclear> an <unclear cert="low" resp="#joint">uch</unclear> unnser <unclear cert="low" resp="#joint">gethruw</unclear> lieb <orgName role="recipient" resp="#ner">Eydtgnossenn</orgName>,
<lb n="28"/>unnser <unclear cert="medium" resp="#joint">ganntz</unclear> fruendtlich eydtgnössisch <unclear cert="low" resp="#joint">bitt</unclear> unnd
<lb n="29"/><unclear cert="low" resp="#joint">begaeren</unclear>, ir <unclear cert="medium" resp="#joint">woellent</unclear> gedachten <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Goetzen</unclear></persName>, by sinem
<pb facs="StadtASG_Missive_991_3018.jpg" n="2"/>
<lb n="30"/>erlangten, unnd nach üwer statt <unclear cert="low" resp="#joint">erbrächten</unclear>, (wie
<lb n="31"/>allenthalb brüchig) <unclear cert="medium" resp="#joint">gnedigclich</unclear> <unclear cert="medium" resp="#joint">blyben</unclear> lassen, <unclear cert="low" resp="#joint">inne</unclear>
<lb n="32"/>by <unclear cert="low" resp="#joint">demselbigen</unclear> <unclear cert="low" resp="#joint">handthaben</unclear>, <unclear cert="low" resp="#joint">schützen</unclear> unnd <unclear cert="low" resp="#joint">schirmen</unclear>,
<lb n="33"/>unnd ime dasselbig nit <unclear cert="medium" resp="#joint">widerumb</unclear> <unclear cert="medium" resp="#joint">abknnen</unclear>, oder
<lb n="34"/><unclear cert="low" resp="#joint">gnuß</unclear> zugeben <unclear cert="low" resp="#joint">wysen</unclear>, <unclear cert="low" resp="#joint">diewyl</unclear> söllicher <unclear cert="low" resp="#joint">erbfal</unclear>
<lb n="35"/>by <unclear cert="low" resp="#joint">üch</unclear> inn der statt unnder <unclear cert="medium" resp="#joint">üwerem</unclear> erbrecht, unnd
<lb n="36"/>nit in der lanndtgrafschaft <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Thurgöw</unclear></placeName> gefallen ist,
<lb n="37"/>unnd was ime nach <unclear cert="medium" resp="#joint">meregedachts</unclear> üwer statt erbrecht
<lb n="38"/><unclear cert="low" resp="#joint">gehoeren</unclear> unnd werden möchte. der <unclear cert="medium" resp="#joint">billigheit</unclear> nach
<lb n="39"/>gnedig unnd günstig <unclear cert="low" resp="#joint">verfolgen</unclear>, unnd werden lassen,
<lb n="40"/>das <unclear cert="low" resp="#joint">statt</unclear> unns umb üch <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">annder</unclear> <unclear cert="medium" resp="#joint">wäg</unclear> guoter <unclear cert="medium" resp="#joint">thrüwer</unclear>
<lb n="41"/>eydtgnossischer meinung zu beschulden, und zuverdienen,
<lb n="42"/>datum unnd mit des <unclear cert="low" resp="#joint">ehrnvesten</unclear> <unclear cert="low" resp="#joint">fürnemmen</unclear> unnd
<lb n="43"/>wysen, <unclear cert="low" resp="#joint">unnsers</unclear> <unclear cert="low" resp="#joint">getrüwen</unclear> lieben lanndtvogts zu
<lb n="44"/><placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden inn</placeName> Ergöw, <persName resp="#ner"><unclear cert="low" resp="#joint">Bartholome</unclear> <unclear cert="low" resp="#joint">Jäggels</unclear></persName> <unclear cert="low" resp="#joint">des</unclear> raths <unclear cert="low" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-70" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Ury</unclear></placeName>.
<lb n="45"/><unclear cert="low" resp="#joint">eigenen</unclear> <unclear cert="low" resp="#joint">innsigel</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">nammen</unclear> unnser aller <unclear cert="low" resp="#joint">verschlossen</unclear>,
<lb n="46"/><origDate when="1573-06-06" resp="#ner">den <unclear cert="medium" resp="#joint">6</unclear>. Junii: anno: 1573.</origDate>
<lb n="47"/><unclear cert="low" resp="#joint">Von</unclear> <unclear cert="low" resp="#joint">stett</unclear> unnd <orgName ref="stadtasg-actors-750" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">lenndern</unclear> der siben <unclear cert="medium" resp="#joint">orthen</unclear> unnser
<lb n="48"/><unclear cert="medium" resp="#joint">eydtgnosschaft</unclear> <unclear cert="medium" resp="#joint">räth</unclear> unnd <unclear cert="low" resp="#joint">sanndtbotten</unclear></orgName> diser <unclear cert="medium" resp="#joint">zyth</unclear>
<lb n="49"/><unclear cert="medium" resp="#joint">mit</unclear> <unclear cert="medium" resp="#joint">bevelch</unclear> unnd <unclear cert="medium" resp="#joint">vollem</unclear> gwalt unnser aller herren
<lb n="50"/>unnd <unclear cert="medium" resp="#joint">obren</unclear> uff dem tag der <unclear cert="low" resp="#joint">jarrechnung</unclear> zu <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName>
<lb n="51"/>inn <placeName ref="stadtasg-places-266" cert="medium" resp="#ner">Ergöw</placeName>. versampt.
<pb facs="StadtASG_Missive_991_3019.jpg" n="3"/>
<pb facs="StadtASG_Missive_991_3020.jpg" n="4"/>
<lb n="52"/><unclear cert="low" resp="#joint">Denn</unclear> frommen fürsichtigen unnd wyßen.
<lb n="53"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd rath der statt Sannt
