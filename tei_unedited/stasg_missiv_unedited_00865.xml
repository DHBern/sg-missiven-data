<p>
<pb facs="StadtASG_Missive_865_2429.jpg" n="1"/>
<lb n="1"/>Unnser freündtlich <unclear cert="medium" resp="#joint">dienst</unclear>, zuvor, Fürsichtigen,
<lb n="2"/><unclear cert="medium" resp="#joint">Ersamenn</unclear> <unclear cert="medium" resp="#joint">Weisen</unclear>, besunder lieben und <unclear cert="medium" resp="#joint">guetten</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">freündt</unclear>, <unclear cert="medium" resp="#joint">Eüwer</unclear> schreiben, <unclear cert="medium" resp="#joint">deßsen</unclear> <unclear cert="medium" resp="#joint">datum</unclear>, <unclear cert="medium" resp="#joint">den</unclear>
<lb n="4"/><date resp="#ner"><unclear cert="medium" resp="#joint">3</unclear>. <unclear cert="medium" resp="#joint">Jetzgegen</unclear> <unclear cert="medium" resp="#joint">Monats</unclear> <unclear cert="medium" resp="#joint">Julij</unclear></date>, haben wir <unclear cert="low" resp="#joint">Innhallts</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">vemmerckht</unclear>. <unclear cert="low" resp="#joint">Geben</unclear> <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">darauff</unclear> <unclear cert="low" resp="#joint">nachbarlich</unclear> <unclear cert="low" resp="#joint">zu</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">vernemmen</unclear>. Das wir den <unclear cert="medium" resp="#joint">verschinen</unclear> <unclear cert="medium" resp="#joint">früeling</unclear> <unclear cert="medium" resp="#joint">her</unclear>,
<lb n="7"/><unclear cert="medium" resp="#joint">allerlai</unclear> <unclear cert="medium" resp="#joint">einsechens</unclear>, bei <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">Maistern</unclear> <unclear cert="medium" resp="#joint">metzg</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">handtwerchs</unclear> <unclear cert="medium" resp="#joint">gethon</unclear>, damit <unclear cert="medium" resp="#joint">der</unclear> Auffschlag <unclear cert="medium" resp="#joint">verhuet</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">werden</unclear> möcht. Wie wir aber <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">feijchtem</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">guettem</unclear> <unclear cert="low" resp="#joint">flaisch</unclear> <unclear cert="low" resp="#joint">allerhanndt</unclear> mangel <unclear cert="medium" resp="#joint">gehabt</unclear>, und
<lb n="11"/><unclear cert="medium" resp="#joint">darneben</unclear> <unclear cert="medium" resp="#joint">glaübweürdig</unclear> bericht worden, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">ettliche</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">Ort</unclear> umb unns, <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">d</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">aijdtgnoschafft</unclear></orgName>, das
<lb n="13"/><unclear cert="medium" resp="#joint">flaisch</unclear>, <unclear cert="medium" resp="#joint">beijm</unclear> <unclear cert="medium" resp="#joint">Pfundt</unclear>, <unclear cert="medium" resp="#joint">höcher</unclear> <unclear cert="medium" resp="#joint">alls</unclear> <unclear cert="medium" resp="#joint">bij</unclear> unns, zuver-
<lb n="14"/><unclear cert="medium" resp="#joint">kaüffen</unclear> <unclear cert="medium" resp="#joint">zuegelaßsen</unclear>, Haben <unclear cert="medium" resp="#joint">wir</unclear> unsern <unclear cert="medium" resp="#joint">Maistern</unclear>,
<lb n="15"/>so das <unclear cert="medium" resp="#joint">Rind</unclear>, und <unclear cert="low" resp="#joint">Küe</unclear> <unclear cert="low" resp="#joint">flaisch</unclear> <unclear cert="low" resp="#joint">verkaüffen</unclear>, auch be-
<lb n="16"/>willigt, das <unclear cert="low" resp="#joint">pfundt</unclear>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">guetten</unclear> <placeName ref="stadtasg-places-287" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schweijtzer</unclear></placeName>, <unclear cert="low" resp="#joint">od</unclear>
<lb n="17"/><placeName ref="stadtasg-places-41" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Unger</unclear></placeName> <unclear cert="low" resp="#joint">Ochsenflaisch</unclear>, umb <unclear cert="low" resp="#joint">ailf</unclear> <unclear cert="low" resp="#joint">haller</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">werung</unclear>,
<lb n="18"/>so lang es <unclear cert="medium" resp="#joint">Inen</unclear> <unclear cert="medium" resp="#joint">glegen</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> das <unclear cert="medium" resp="#joint">geringer</unclear> <unclear cert="medium" resp="#joint">flaisch</unclear>,
<lb n="19"/>so <unclear cert="low" resp="#joint">gleichwol</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">Ochsen</unclear> <unclear cert="low" resp="#joint">weren</unclear>, umb <unclear cert="medium" resp="#joint">fünff</unclear> <unclear cert="medium" resp="#joint">pfening</unclear>
<lb n="20"/>und noch <unclear cert="medium" resp="#joint">nächer</unclear>, <unclear cert="medium" resp="#joint">nachdem</unclear> es <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">Schätzer</unclear>, <unclear cert="medium" resp="#joint">für</unclear> <unclear cert="medium" resp="#joint">guet</unclear>
