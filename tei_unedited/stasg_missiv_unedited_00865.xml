<lb n="22"/><unclear cert="low" resp="#joint">Rindflaisch</unclear> <unclear cert="low" resp="#joint">auch</unclear> in gleichem <unclear cert="medium" resp="#joint">gellt</unclear>, die <unclear cert="medium" resp="#joint">Lungken</unclear>
<lb n="23"/>und <unclear cert="low" resp="#joint">leberen</unclear>, <unclear cert="low" resp="#joint">vom</unclear> <unclear cert="low" resp="#joint">grossen</unclear> <unclear cert="low" resp="#joint">vich</unclear>, ußwegen, und
<lb n="24"/><unclear cert="medium" resp="#joint">weijtters</unclear> <unclear cert="medium" resp="#joint">nicht</unclear>, dann <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">Magen</unclear> und <unclear cert="medium" resp="#joint">Affter</unclear>-
<lb n="25"/><unclear cert="medium" resp="#joint">darm</unclear>, <unclear cert="medium" resp="#joint">sy</unclear> <unclear cert="medium" resp="#joint">wie</unclear> von <unclear cert="medium" resp="#joint">allterher</unclear>, <unclear cert="medium" resp="#joint">ijedes</unclear> <unclear cert="medium" resp="#joint">stuck</unclear> umb sechs
<lb n="26"/><unclear cert="medium" resp="#joint">pfening</unclear>, und ain <unclear cert="medium" resp="#joint">grüene</unclear> <unclear cert="medium" resp="#joint">zungen</unclear>, umb ain <unclear cert="low" resp="#joint">batzen</unclear>,
<lb n="27"/><unclear cert="low" resp="#joint">verkauffen</unclear> <unclear cert="low" resp="#joint">müessen</unclear>, Die <unclear cert="medium" resp="#joint">füeß</unclear> <unclear cert="medium" resp="#joint">aber</unclear> und die
<lb n="28"/><unclear cert="medium" resp="#joint">Kuttlen</unclear>, <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">Rindern</unclear> und <unclear cert="medium" resp="#joint">Küeen</unclear>, <unclear cert="medium" resp="#joint">sij</unclear> den <unclear cert="medium" resp="#joint">Kuttlern</unclear>,
<lb n="29"/>neben den <unclear cert="medium" resp="#joint">Kuttlen</unclear> <unclear cert="medium" resp="#joint">zuverkaüffen</unclear> geben, <unclear cert="medium" resp="#joint">Welche</unclear>
<pb facs="StadtASG_Missive_865_2430.jpg" n="2"/>
<lb n="30"/>dann die, <unclear cert="medium" resp="#joint">innsonderhait</unclear>, an ainem aignen ort, wie
<lb n="31"/><unclear cert="medium" resp="#joint">von</unclear> alterher <unclear cert="low" resp="#joint">verkauffen</unclear>, ain <unclear cert="medium" resp="#joint">fueß</unclear>, umb vier, <unclear cert="low" resp="#joint">fünff</unclear>,
<lb n="32"/>sechs, od Neün <unclear cert="medium" resp="#joint">pfening</unclear>, nach dem er ist. So
<lb n="33"/>haben wir neben dem <unclear cert="low" resp="#joint">auch</unclear>, <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">maistern</unclear> und <unclear cert="low" resp="#joint">metzgern</unclear>
<lb n="34"/>das <unclear cert="low" resp="#joint">schaffflaisch</unclear>, <unclear cert="low" resp="#joint">vergünnt</unclear> und zugelassen, <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">nitt</unclear>
<lb n="35"/>lenger, <unclear cert="medium" resp="#joint">alls</unclear> <unclear cert="medium" resp="#joint">es</unclear> unns <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">gelegen</unclear>, <unclear cert="low" resp="#joint">vonn</unclear> den <unclear cert="medium" resp="#joint">guoten</unclear>
<lb n="36"/>schaffen, das <unclear cert="low" resp="#joint">pfundt</unclear> umb <unclear cert="low" resp="#joint">ailf</unclear> haller, aber von den
<lb n="37"/>schlechten schaffen, das <unclear cert="low" resp="#joint">pfundt</unclear> umb <unclear cert="low" resp="#joint">fünff</unclear> <unclear cert="medium" resp="#joint">pfening</unclear>,
<lb n="38"/>wie vorher, und ain <unclear cert="medium" resp="#joint">pfundt</unclear> <unclear cert="medium" resp="#joint">späckh</unclear>, umb acht <unclear cert="medium" resp="#joint">pfening</unclear>,
<lb n="39"/>ain schaff od <unclear cert="low" resp="#joint">kitzi</unclear> kopff, umb sechs <unclear cert="medium" resp="#joint">pfening</unclear>, der-
<lb n="40"/><unclear cert="medium" resp="#joint">glychen</unclear> ain <unclear cert="low" resp="#joint">kröß</unclear> und gestell, yedes auch umb sechs
<lb n="41"/><unclear cert="medium" resp="#joint">pfening</unclear>, zugeben, Aber das kalbflaisch, so der
<lb n="42"/><unclear cert="low" resp="#joint">zeyten</unclear> wenig <unclear cert="low" resp="#joint">uffgehawen</unclear>, und <unclear cert="low" resp="#joint">vermetzget</unclear> <unclear cert="low" resp="#joint">würt</unclear>,
<lb n="43"/><unclear cert="low" resp="#joint">plybt</unclear> by altem <unclear cert="low" resp="#joint">verkauff</unclear> und gellt, Namlich ain
<lb n="44"/><unclear cert="medium" resp="#joint">pfundt</unclear> desselben flaischs, umb fünff <unclear cert="medium" resp="#joint">pfening</unclear>,
<lb n="45"/>ain <unclear cert="low" resp="#joint">kalbs</unclear> <unclear cert="low" resp="#joint">kopff</unclear>, umb ain batzen, ain gestell umb
<lb n="46"/>siben <unclear cert="low" resp="#joint">kreützer</unclear>, ain <unclear cert="low" resp="#joint">kröß</unclear> umb <unclear cert="low" resp="#joint">Neün</unclear> <unclear cert="medium" resp="#joint">pfening</unclear>, und
<lb n="47"/>die vier <unclear cert="low" resp="#joint">kalbsfüeß</unclear>, umb sechs <unclear cert="medium" resp="#joint">pfening</unclear>, Neben dem
<lb n="48"/>lieben <unclear cert="medium" resp="#joint">fründt</unclear>, <unclear cert="medium" resp="#joint">Wyl</unclear> unsere <unclear cert="medium" resp="#joint">Maister</unclear>, yetzo <unclear cert="medium" resp="#joint">etliche</unclear>
<lb n="49"/><unclear cert="medium" resp="#joint">Vunger</unclear> ochsen bringen, haben wir denselben, <unclear cert="medium" resp="#joint">diewyl</unclear>
<lb n="50"/>sy by unns <unclear cert="low" resp="#joint">vermetzgen</unclear>, sy <unclear cert="medium" resp="#joint">züerhalten</unclear>, <unclear cert="medium" resp="#joint">waiden</unclear>
<lb n="51"/>verordnet, <unclear cert="medium" resp="#joint">Sollichs</unclear> wir <unclear cert="low" resp="#joint">füch</unclear> <unclear cert="low" resp="#joint">uff</unclear> eüwer
<lb n="52"/>zuschreiben, nitt wöllen verhalten, und <unclear cert="low" resp="#joint">sindt</unclear> <unclear cert="low" resp="#joint">füch</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">nachbürliche</unclear> dienst zuerweisen, <unclear cert="low" resp="#joint">yederzeyt</unclear> gantz <unclear cert="medium" resp="#joint">gnaigt</unclear>,
<lb n="54"/>Dat den <origDate when="1564-07-08" resp="#ner">8. Julij Anno 1564</origDate>.
<lb n="55"/><orgName ref="stadtasg-actors-587" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Verwallter</unclear> der <unclear cert="low" resp="#joint">Haübtmanschafft</unclear>,
