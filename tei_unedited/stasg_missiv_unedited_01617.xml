<p>
<pb facs="StadtASG_Missive_1617_5871.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freüntlich</unclear> willig dienst, und was wir <unclear cert="medium" resp="#joint">eeren</unclear> liebs und
<lb n="2"/><unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear>, <unclear cert="low" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">fromme</unclear> <unclear cert="medium" resp="#joint">fuersichtige</unclear>, <unclear cert="low" resp="#joint">eersame</unclear> und <unclear cert="low" resp="#joint">wyse</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">innsonders</unclear> <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">freündt</unclear> und <unclear cert="low" resp="#joint">getreuwen</unclear> <unclear cert="low" resp="#joint">lieebe</unclear> Nachbaren; <unclear cert="low" resp="#joint">Diewyl</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">uff</unclear> die <unclear cert="low" resp="#joint">vilfaeltige</unclear> <unclear cert="low" resp="#joint">verlümbdung</unclear>, so über den unseren Daniel
<lb n="5"/><unclear cert="low" resp="#joint">Schmiden</unclear>, deß <unclear cert="low" resp="#joint">haexenwerckhs</unclear> halben, in <unclear cert="low" resp="#joint">unserem</unclear> landt und an <unclear cert="medium" resp="#joint">anderen</unclear>
<lb n="6"/>orthen ergangen, <unclear cert="low" resp="#joint">allerleij</unclear> <unclear cert="low" resp="#joint">khundtschafften</unclear> und <unclear cert="low" resp="#joint">berycht</unclear> <unclear cert="low" resp="#joint">inzenemmen</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">vonnoethen</unclear> sein <unclear cert="medium" resp="#joint">wil</unclear>, habend wir nit underlassen <unclear cert="medium" resp="#joint">sollen</unclear>, <unclear cert="low" resp="#joint">eüch</unclear> durch
<lb n="8"/>diß schriben, <unclear cert="low" resp="#joint">freündtlichen</unclear> <unclear cert="low" resp="#joint">zeersuechen</unclear>, ir <unclear cert="medium" resp="#joint">wöllind</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">befuerderung</unclear>
<lb n="9"/>disers unseren billichen vorhabens, <unclear cert="low" resp="#joint">üweren</unclear> angehoerigen N: <persName resp="#ner"><unclear cert="low" resp="#joint">Zobleren</unclear></persName>
<lb n="10"/><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">mezger</unclear>, so vor <unclear cert="low" resp="#joint">etlichen</unclear> jaren, sambt <unclear cert="medium" resp="#joint">einem</unclear> jungen knaben
<lb n="11"/><unclear cert="low" resp="#joint">rüthers</unclear> <unclear cert="low" resp="#joint">hueb</unclear>, <unclear cert="low" resp="#joint">eines</unclear> <unclear cert="low" resp="#joint">abendß</unclear> <unclear cert="low" resp="#joint">spaet</unclear>, bij <unclear cert="low" resp="#joint">ime</unclear> <persName resp="#ner">Daniel <unclear cert="low" resp="#joint">Schmiden</unclear></persName>
<lb n="12"/><unclear cert="medium" resp="#joint">im</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Aeschemoß</unclear></placeName>, die <unclear cert="low" resp="#joint">nachtherberg</unclear> schwaerlich <unclear cert="medium" resp="#joint">erbetten</unclear> moegen, und
<lb n="13"/>nach mitternacht, <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">sein</unclear> gheiß, sollen hinweg <unclear cert="medium" resp="#joint">ziechen</unclear>; das aber <unclear cert="low" resp="#joint">inen</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="medium" resp="#joint">schnees</unclear> nit <unclear cert="medium" resp="#joint">müglich</unclear> <unclear cert="low" resp="#joint">gsein</unclear>, sonder widerumb <unclear cert="low" resp="#joint">hinder</unclear> <unclear cert="low" resp="#joint">sich</unclear> ge=
<lb n="15"/><unclear cert="low" resp="#joint">khert</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">ermeltes</unclear> <unclear cert="low" resp="#joint">Daniels</unclear> <unclear cert="medium" resp="#joint">huß</unclear>, und alda domahlen allerleij
<lb n="16"/>seijtenspil sollen gehoert haben; <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">gschwornen</unclear> <unclear cert="low" resp="#joint">eijdt</unclear>, <unclear cert="low" resp="#joint">wie</unclear> sich
<lb n="17"/>in <unclear cert="low" resp="#joint">solchen</unclear> sachen <unclear cert="medium" resp="#joint">gebürt</unclear>, <unclear cert="medium" resp="#joint">befragen</unclear> lassen; und <unclear cert="low" resp="#joint">dan</unclear> sein <unclear cert="medium" resp="#joint">sag</unclear>, oder
<lb n="18"/>was sich alda, oder <unclear cert="low" resp="#joint">sunsten</unclear> <unclear cert="low" resp="#joint">dessethalben</unclear> befinden <unclear cert="low" resp="#joint">wirt</unclear>, unß ein=
<lb n="19"/><unclear cert="low" resp="#joint">geends</unclear> <unclear cert="low" resp="#joint">schrifftlichen</unclear> <unclear cert="low" resp="#joint">verschlossen</unclear> <unclear cert="low" resp="#joint">zueschickhen</unclear>, damit wir unß
<lb n="20"/>weitter gebürender maassen <unclear cert="low" resp="#joint">zůverhalten</unclear> <unclear cert="low" resp="#joint">wüssen</unclear> <unclear cert="low" resp="#joint">moegind</unclear>.
<lb n="21"/>Das <unclear cert="low" resp="#joint">stath</unclear> <unclear cert="low" resp="#joint">unß</unclear> umb eüch, neben dem, das ihr es von deß
<lb n="22"/>rechten wegen <unclear cert="low" resp="#joint">guetwillig</unclear> <unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="medium" resp="#joint">werden</unclear>, <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">gelegenheit</unclear>, in
<lb n="23"/>solich und ander weg, freündt: <unclear cert="medium" resp="#joint">nachbarlichen</unclear> <unclear cert="low" resp="#joint">zůbeschulden</unclear>;
<lb n="24"/>und thuend <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">beijneben</unclear> samtblich göttlicher <unclear cert="low" resp="#joint">bewarung</unclear>
<lb n="25"/>wolbefelchen, datum den. <origDate when="1608" resp="#ner">25. <unclear cert="low" resp="#joint">ejst</unclear> Augusti. <unclear cert="medium" resp="#joint">A°</unclear>: 1608</origDate>
<lb n="26"/><orgName ref="stadtasg-actors-506" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Lanndtamann</unclear> und <unclear cert="medium" resp="#joint">Raath</unclear>
