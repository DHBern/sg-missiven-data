<p>
<pb facs="StadtASG_Missive_2623_10177.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> freündtlich willig dienst und was wir <unclear cert="medium" resp="#joint">eh</unclear>-
<lb n="2"/>ren, liebs und <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear> <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="medium" resp="#joint">fromen</unclear>,
<lb n="3"/>fürsichtigen, <unclear cert="medium" resp="#joint">eersamen</unclear> und weisen, <unclear cert="medium" resp="#joint">innsonders</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">freünde</unclear>, und <unclear cert="medium" resp="#joint">getreüwen</unclear>, lieben <unclear cert="medium" resp="#joint">Eüdtgnoßen</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Eß</unclear> habend unß <unclear cert="medium" resp="#joint">unßere</unclear> <unclear cert="medium" resp="#joint">getreüwe</unclear> liebe <unclear cert="low" resp="#joint">mit</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">rhaet</unclear> <unclear cert="low" resp="#joint">herr</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Felix</unclear> <unclear cert="low" resp="#joint">Zublin</unclear></persName>, <unclear cert="low" resp="#joint">schaffner</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Ampts</unclear>
<lb n="7"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sant</unclear> <unclear cert="low" resp="#joint">Catherinae</unclear></placeName>, und <unclear cert="medium" resp="#joint">herr</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Hanß</unclear> <unclear cert="medium" resp="#joint">Ebneter</unclear></persName> <unclear cert="medium" resp="#joint">pfand</unclear>-
<lb n="8"/><unclear cert="medium" resp="#joint">meister</unclear>, so dann auch unßer <unclear cert="low" resp="#joint">angehoeriger</unclear>
