<lb n="10"/><unclear cert="low" resp="#joint">nen</unclear> <unclear cert="low" resp="#joint">gegeben</unclear>, <unclear cert="low" resp="#joint">welcher</unclear> <unclear cert="low" resp="#joint">gestalten</unclear> <unclear cert="low" resp="#joint">eüwer</unclear> <unclear cert="low" resp="#joint">burger</unclear>
<lb n="11"/><persName resp="#ner"><unclear cert="low" resp="#joint">Samuel</unclear> <unclear cert="low" resp="#joint">Wide</unclear></persName>, ihnen samptlich und <unclear cert="low" resp="#joint">jedem</unclear> <unclear cert="low" resp="#joint">In</unclear>-
<lb n="12"/>sonderheit <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">namhaffte</unclear> <unclear cert="low" resp="#joint">suma</unclear> <unclear cert="low" resp="#joint">gelts</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">ab</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">kauffte</unclear> <unclear cert="low" resp="#joint">leinwatwahren</unclear> (<unclear cert="low" resp="#joint">vermoege</unclear> <unclear cert="low" resp="#joint">beüligender</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">verzeichnuß</unclear>) <unclear cert="low" resp="#joint">zethun</unclear> <unclear cert="low" resp="#joint">schuldig</unclear> <unclear cert="low" resp="#joint">seÿe</unclear>, und <unclear cert="low" resp="#joint">solche</unclear> <unclear cert="low" resp="#joint">schon</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">albereit</unclear> vor anderthalb jaren <unclear cert="medium" resp="#joint">erlegen</unclear> und be-
<lb n="16"/>zahlen sollen, <unclear cert="medium" resp="#joint">wie</unclear> aber <unclear cert="medium" resp="#joint">ihme</unclear> <unclear cert="medium" resp="#joint">auff</unclear> sein <unclear cert="low" resp="#joint">jederzeit</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">vilfaltiges</unclear> <unclear cert="low" resp="#joint">Pitten</unclear>, <unclear cert="low" resp="#joint">Jmerzu</unclear> <unclear cert="low" resp="#joint">umbs</unclear> <unclear cert="low" resp="#joint">besten</unclear> <unclear cert="low" resp="#joint">willen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">zugesehen</unclear>; <unclear cert="low" resp="#joint">dieweil</unclear> aber sie <unclear cert="low" resp="#joint">glaubwürdig</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">berichtet</unclear> <unclear cert="low" resp="#joint">worden</unclear>, das seine sachen <unclear cert="low" resp="#joint">nitzar</unclear> im
<lb n="20"/><unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">terminis</unclear>, <unclear cert="medium" resp="#joint">gestalten</unclear> dann er mit <unclear cert="medium" resp="#joint">anne</unclear>-
