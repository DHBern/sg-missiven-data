<p>
<pb facs="StadtASG_Missive_2613_10137.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">früntlich</unclear> willig dienst, sambt was wir ehren liebs
<lb n="2"/>und guots vermögend <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="medium" resp="#joint">From</unclear>, Fürsichtig, <unclear cert="medium" resp="#joint">Ehrsam</unclear>
<lb n="3"/>Wyß, Innsonders guot fründ und <unclear cert="medium" resp="#joint">gethrüw</unclear> lieb Eidt-
<lb n="4"/><unclear cert="medium" resp="#joint">gnoßen</unclear>. <unclear cert="medium" resp="#joint">Was</unclear> für <unclear cert="medium" resp="#joint">eine</unclear> <unclear cert="medium" resp="#joint">werbung</unclear>, von <unclear cert="medium" resp="#joint">unseren</unclear>
<lb n="5"/>lieben gethrüwen, den <orgName resp="#ner"><unclear cert="medium" resp="#joint">vier</unclear> <unclear cert="medium" resp="#joint">Undern</unclear> <unclear cert="medium" resp="#joint">Rhyntalischen</unclear> <unclear cert="medium" resp="#joint">Gmeind</unclear>-
<lb n="6"/><unclear cert="medium" resp="#joint">en</unclear></orgName>, durch <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">Abgesante</unclear>, <unclear cert="low" resp="#joint">beträffend</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Jrerlichen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">wyülouff</unclear>, <unclear cert="low" resp="#joint">underschidlich</unclear> <unclear cert="low" resp="#joint">an</unclear> uns <unclear cert="medium" resp="#joint">beschehen</unclear>, ouch <unclear cert="medium" resp="#joint">was</unclear> maßen
<lb n="8"/>wir uns <unclear cert="low" resp="#joint">hierüber</unclear> <unclear cert="low" resp="#joint">anfhänglich</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">gharen</unclear> <unclear cert="low" resp="#joint">erkleet</unclear>
<lb n="9"/>und <unclear cert="low" resp="#joint">erlüteret</unclear>, <unclear cert="low" resp="#joint">Deßen</unclear> <unclear cert="low" resp="#joint">wirt</unclear> üch <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">üwer</unclear>
<lb n="10"/>lieber <unclear cert="low" resp="#joint">Mitrath</unclear> <unclear cert="low" resp="#joint">Herr</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Thomas</unclear> <unclear cert="low" resp="#joint">Zwicker</unclear></persName> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">meherem</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">zebrichten</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">wüßen</unclear>. <unclear cert="low" resp="#joint">Diewylen</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">gsayter</unclear>
