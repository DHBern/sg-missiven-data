<lb n="17"/>so <unclear cert="medium" resp="#joint">lang</unclear> <unclear cert="medium" resp="#joint">Ynstellen</unclear>, biß üch <unclear cert="low" resp="#joint">hierzuo</unclear> rechtlich ouch <unclear cert="low" resp="#joint">verkündt</unclear> syn
