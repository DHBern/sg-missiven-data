        <body>
<p>
<pb facs="StadtASG_Missive_2159_8091.jpg" n="1"/>
<lb n="1"/>Unser freundt: nachparlich willig dienst,
<lb n="2"/>und waß wir liebs und guets <unclear cert="low" resp="#joint">vermoegen</unclear>, zuvor,
<lb n="3"/><unclear cert="low" resp="#joint">fuersichtige</unclear>, <unclear cert="low" resp="#joint">ehrsame</unclear>, und <unclear cert="low" resp="#joint">weise</unclear>, insonders
<lb n="4"/><unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">freundt</unclear>, und <unclear cert="low" resp="#joint">getreüwe</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">nachparn</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Waß</unclear> unß <unclear cert="low" resp="#joint">dißes</unclear> <unclear cert="low" resp="#joint">durchziehenden</unclear> Spanischen kriegs=
<lb n="6"/><unclear cert="low" resp="#joint">volckhs</unclear> <unclear cert="low" resp="#joint">halben</unclear>, <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">vertraeüwliche</unclear> <unclear cert="low" resp="#joint">avisi</unclear> <unclear cert="low" resp="#joint">zue=</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">komen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">haben</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">St</unclear>: <unclear cert="low" resp="#joint">Wht</unclear>:</orgName> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">ynschluß</unclear>
<lb n="8"/>mit mehrerm <unclear cert="medium" resp="#joint">glaubwürdig</unclear> <unclear cert="medium" resp="#joint">zuevernemmen</unclear>.
<lb n="9"/>Und wiewol <unclear cert="medium" resp="#joint">unß</unclear> nit zweiflet, <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">St</unclear>: <unclear cert="low" resp="#joint">Wht</unclear>:
<lb n="10"/>werden <unclear cert="medium" resp="#joint">dißes</unclear> <unclear cert="medium" resp="#joint">Spanischen</unclear> <unclear cert="medium" resp="#joint">durchzugs</unclear> halben,
<lb n="11"/>ohne <unclear cert="low" resp="#joint">daß</unclear>, <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">wüßenschaft</unclear> <unclear cert="low" resp="#joint">haben</unclear>, in ansehung daß
<lb n="12"/><unclear cert="low" resp="#joint">daßselbig</unclear> <unclear cert="low" resp="#joint">volckh</unclear> nit <unclear cert="low" resp="#joint">weit</unclear> von ihrer Statt auß=
<lb n="13"/><unclear cert="low" resp="#joint">lendet</unclear>. <unclear cert="low" resp="#joint">Nichtsdestoweniger</unclear> haben wir nit
<lb n="14"/>ermanglen <unclear cert="low" resp="#joint">woellen</unclear>, umb fortpflanzung
<lb n="15"/>willen gueter nachparlicher vertraeüwlicher
<lb n="16"/>correspondenz, solchen auch freundt=
<lb n="17"/><unclear cert="medium" resp="#joint">nachparlich</unclear> <unclear cert="medium" resp="#joint">ze'comunicieren</unclear>, und darby
<lb n="18"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">St</unclear>: <unclear cert="low" resp="#joint">Wht</unclear>:</orgName> <unclear cert="low" resp="#joint">zeverstendigen</unclear> <unclear cert="low" resp="#joint">deß</unclear> tumults,
<lb n="19"/>welcher sich <date resp="#ner">gestrigs tags zwüschent 2. und
<lb n="20"/>3. uhren nachmittag</date> beym Schwanen alda
<lb n="21"/><unclear cert="low" resp="#joint">unsre</unclear> <unclear cert="low" resp="#joint">nachparn</unclear> die <unclear cert="medium" resp="#joint">Ußroodischen</unclear> <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">landts</unclear> <placeName ref="stadtasg-places-8" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Aebtzell</unclear></placeName>
<lb n="22"/>ein <unclear cert="low" resp="#joint">wacht</unclear> <unclear cert="low" resp="#joint">angestellt</unclear>, umb <unclear cert="low" resp="#joint">zueverhueten</unclear>, daß
<lb n="23"/>diß Spanisch <unclear cert="low" resp="#joint">khindlin</unclear> nit in ihr land <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">daselbst</unclear> <unclear cert="low" resp="#joint">habende</unclear> <unclear cert="low" resp="#joint">bruggen</unclear> <unclear cert="low" resp="#joint">passieren</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">koenne</unclear>, begeben hat. Dann <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">anfangs</unclear> <unclear cert="low" resp="#joint">ungefehr</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">50</unclear>.
<lb n="25"/><unclear cert="low" resp="#joint">dißer</unclear> Spanischen soldaten, an den <unclear cert="low" resp="#joint">grenzen</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">ankomen</unclear>, haben sie sich <unclear cert="low" resp="#joint">enethalb</unclear> dem tobel
<lb n="27"/><unclear cert="low" resp="#joint">nidergelegt</unclear>, <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">andre</unclear> auch <unclear cert="low" resp="#joint">zu'ihnen</unclear> komen
<lb n="28"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">gemacher</unclear>
<pb facs="StadtASG_Missive_2159_8092.jpg" n="2"/>
<lb n="29"/>also ihrer <unclear cert="medium" resp="#joint">ungefahr</unclear>, <unclear cert="medium" resp="#joint">biß</unclear> in die .300. soldaten
<lb n="30"/><unclear cert="low" resp="#joint">daruon</unclear> <unclear cert="low" resp="#joint">ungefahr</unclear> .<unclear cert="low" resp="#joint">100</unclear>.
<lb n="31"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">roß</unclear> <unclear cert="low" resp="#joint">sindt</unclear> <unclear cert="low" resp="#joint">versamlet</unclear>. <unclear cert="low" resp="#joint">Welche</unclear> sich <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">posto</unclear> <unclear cert="low" resp="#joint">ersehen</unclear>,
<lb n="32"/><unclear cert="low" resp="#joint">alsowerche</unclear> die soldaten mit gewalt hindurch tringen
<lb n="33"/><unclear cert="low" resp="#joint">haben</unclear> die <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">thurnblaser</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">wortzeichen</unclear> <unclear cert="low" resp="#joint">stück</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">tobel</unclear> <unclear cert="low" resp="#joint">schiessen</unclear>. <unclear cert="low" resp="#joint">Die</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">solches</unclear>
<lb n="37"/>nicht <unclear cert="low" resp="#joint">beschehen</unclear> <unclear cert="low" resp="#joint">lassen</unclear> <unclear cert="low" resp="#joint">wollen</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">jedoch</unclear> <unclear cert="low" resp="#joint">thuenlich</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">geacht</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">brugg</unclear> <unclear cert="low" resp="#joint">abzuowerffen</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">geschehen</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">angehendts</unclear> <unclear cert="low" resp="#joint">ettliche</unclear> <unclear cert="low" resp="#joint">trau</unclear>-
<lb n="42"/><unclear cert="low" resp="#joint">schüz</unclear> hinder sich lauffen lassen, da
<lb n="43"/>dann <unclear cert="low" resp="#joint">angendts</unclear> sturm lassen durchs gantze land
<lb n="44"/>geschlagen, woruff von stundan ein große
<lb n="45"/>anzahl volcks mit ihren armis vorhanden
<lb n="46"/>gewesen, und der wacht <unclear cert="low" resp="#joint">zuogeilt</unclear>. Welches
<lb n="47"/><unclear cert="medium" resp="#joint">als</unclear> <unclear cert="medium" resp="#joint">solches</unclear> die <unclear cert="medium" resp="#joint">Spanier</unclear> <unclear cert="low" resp="#joint">ersehen</unclear>, daß der
<lb n="48"/><unclear cert="low" resp="#joint">gwalt</unclear> vorhanden, <unclear cert="medium" resp="#joint">sindt</unclear> sie widerumb
<lb n="49"/><unclear cert="medium" resp="#joint">zurugkh</unclear> gewichen, und sich auf ihren ver-
<lb n="50"/>ordneten weeg begeben. Sonsten, wie
<lb n="51"/>wir von unsern alßbald dahin <unclear cert="medium" resp="#joint">gesandten</unclear>
<lb n="52"/><unclear cert="medium" resp="#joint">posten</unclear>, <unclear cert="low" resp="#joint">vernomen</unclear>, seye das landtvolckh
<lb n="53"/>so <unclear cert="low" resp="#joint">eiferig</unclear> gewesen, daß man sie kaum
<lb n="54"/><unclear cert="medium" resp="#joint">inhalten</unclear> <unclear cert="medium" resp="#joint">moegen</unclear>, daß sie nichts <unclear cert="low" resp="#joint">thetlichs</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">fuergenommen</unclear>.
<lb n="56"/><unclear cert="low" resp="#joint">Welches</unclear> wir <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">f</unclear>. <unclear cert="low" resp="#joint">w</unclear>.
<lb n="57"/><unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">willen</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="58"/>wohl <unclear cert="low" resp="#joint">erachten</unclear> <unclear cert="low" resp="#joint">koennen</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">in</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">sorgen</unclear> <unclear cert="low" resp="#joint">stehn</unclear> <unclear cert="low" resp="#joint">moechte</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">unberichtet</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">lassen</unclear>
<lb n="61"/>wollen, was wir nun <unclear cert="low" resp="#joint">unseres</unclear> theils dißes durchzugs
<lb n="62"/>halber ferners <unclear cert="low" resp="#joint">vernemmen</unclear> und <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">erfahrung</unclear> <unclear cert="low" resp="#joint">bringen</unclear> werden
<lb n="63"/><unclear cert="low" resp="#joint">soll</unclear> <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">wht</unclear>. <unclear cert="low" resp="#joint">allzeit</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">tag</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">nacht</unclear> <unclear cert="low" resp="#joint">ungespart</unclear> <unclear cert="low" resp="#joint">einiger</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">kosten</unclear>, <unclear cert="low" resp="#joint">berichtet</unclear> <unclear cert="low" resp="#joint">werden</unclear>.
<lb n="65"/><unclear cert="low" resp="#joint">Hiemit</unclear>
<lb n="66"/>uns allerseits <unclear cert="low" resp="#joint">gottes</unclear> <unclear cert="low" resp="#joint">gnedig</unclear> <unclear cert="low" resp="#joint">schirm</unclear> wol <unclear cert="low" resp="#joint">befelhende</unclear>. <unclear cert="low" resp="#joint">Geben</unclear>
<lb n="67"/><origDate when="1619" resp="#ner">den .29ten. octobris .1619.</origDate>
<lb n="68"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und rath
<lb n="69"/>der statt Sant Gallen</orgName>.
<pb facs="StadtASG_Missive_2159_8093.jpg" n="3"/>
<pb facs="StadtASG_Missive_2159_8094.jpg" n="4"/>
</p>
