<lb n="33"/><unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">beschehe</unclear> dann <unclear cert="low" resp="#joint">ds</unclear> <unclear cert="low" resp="#joint">etwa</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">froembde</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">fruecht</unclear> damit <unclear cert="low" resp="#joint">verfuehrt</unclear> <unclear cert="low" resp="#joint">werde</unclear>, <unclear cert="low" resp="#joint">welche</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">aber</unclear>
<lb n="35"/><origDate resp="#ner"><unclear cert="low" resp="#joint">23</unclear> <unclear cert="low" resp="#joint">Junij</unclear></origDate>.
<pb facs="StadtASG_Missive_3821_15412.jpg" n="2"/>
<lb n="36"/>ihnen den <unclear cert="low" resp="#joint">schifleüthen</unclear> <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">wahren</unclear> <unclear cert="low" resp="#joint">undersagt</unclear>, <unclear cert="low" resp="#joint">wir</unclear>
