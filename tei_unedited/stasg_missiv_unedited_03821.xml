<lb n="38"/>oberkheiten zu <placeName ref="stadtasg-places-185" cert="medium" resp="#ner">Schafhusen</placeName> und <placeName ref="stadtasg-places-68" cert="medium" resp="#ner">Stain am Rhin</placeName>
<lb n="39"/>underm <date resp="#ner">2. Martii diß jars</date>, geschriben, und <unclear cert="low" resp="#joint">ersucht</unclear>,
<lb n="40"/>dz <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">verhütung</unclear> <unclear cert="low" resp="#joint">allerlay</unclear>
