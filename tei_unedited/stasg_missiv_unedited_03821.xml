<lb n="22"/><unclear cert="low" resp="#joint">zewueßen</unclear> <unclear cert="low" resp="#joint">ist</unclear>, <unclear cert="low" resp="#joint">ds</unclear> <unclear cert="low" resp="#joint">unßers</unclear> <unclear cert="low" resp="#joint">theil</unclear> <unclear cert="low" resp="#joint">halben</unclear> <unclear cert="low" resp="#joint">habender</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">uraltn</unclear> <unclear cert="low" resp="#joint">satzungen</unclear> nach, <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">solchs</unclear> <unclear cert="low" resp="#joint">zuthun</unclear>, <unclear cert="low" resp="#joint">sie</unclear>
<lb n="24"/>nit <unclear cert="low" resp="#joint">gebuert</unclear>, <unclear cert="low" resp="#joint">welche</unclear> <unclear cert="low" resp="#joint">vermoegen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> in der
<lb n="25"/><unclear cert="low" resp="#joint">nachbarschaft</unclear> das bey straaf leibs und <unclear cert="low" resp="#joint">guotz</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">kein</unclear> <unclear cert="low" resp="#joint">kornfueher</unclear>, so burger ist, <unclear cert="low" resp="#joint">keines</unclear> <unclear cert="low" resp="#joint">korn</unclear> <unclear cert="low" resp="#joint">kauf</unclear>
<lb n="27"/>thun, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">denselbn</unclear> an froembde und andern
<lb n="28"/><unclear cert="low" resp="#joint">orth</unclear> <unclear cert="low" resp="#joint">fuehren</unclear>, sonder auf unsern freyen wo=
<lb n="29"/>chen <unclear cert="low" resp="#joint">merckt</unclear>, <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">verkhaufen</unclear> und distrahiern solle,
<lb n="30"/>Sie geben aber uns darneben <unclear cert="low" resp="#joint">zuverstehn</unclear>, <unclear cert="low" resp="#joint">ds</unclear> die
<lb n="31"/><placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Roschacher</unclear></placeName> und <persName resp="#ner">Steiner</persName> schiffleuth mit hin aller=
