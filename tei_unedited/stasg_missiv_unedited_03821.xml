<lb n="14"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">guots</unclear> <unclear cert="low" resp="#joint">unsren</unclear> <unclear cert="low" resp="#joint">Eydgnoeßische</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">unser</unclear> statt, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">eydgnoeßische</unclear> <unclear cert="low" resp="#joint">nachbarschaft</unclear> er-
