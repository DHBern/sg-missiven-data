<lb n="17"/><unclear cert="low" resp="#joint">werde</unclear>.
<lb n="18"/>Wann aber, <unclear cert="low" resp="#joint">wlg</unclear>. <unclear cert="low" resp="#joint">h</unclear>. <unclear cert="low" resp="#joint">obrister</unclear>, uns die
<lb n="19"/><unclear cert="low" resp="#joint">obgemelte</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">kornfueher</unclear> bestendig <unclear cert="low" resp="#joint">fuergeb</unclear>,
<lb n="20"/><unclear cert="low" resp="#joint">ds</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">solchs</unclear> <unclear cert="low" resp="#joint">weder</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">sie</unclear>, <unclear cert="low" resp="#joint">noch</unclear> die <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">nie</unclear>-
