<lb n="24"/><unclear cert="low" resp="#joint">vormals</unclear> <unclear cert="low" resp="#joint">auch</unclear> befinde; habend wir <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">underlaßen</unclear> <unclear cert="low" resp="#joint">woellen</unclear>,
<lb n="25"/>gefangen gewesen <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">nachbarlich</unclear>
