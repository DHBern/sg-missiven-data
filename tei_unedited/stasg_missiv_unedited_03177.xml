<lb n="3"/><unclear cert="low" resp="#joint">gestrenger</unclear> <unclear cert="low" resp="#joint">vester</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">weiser</unclear>, <unclear cert="low" resp="#joint">besonders</unclear> <unclear cert="low" resp="#joint">lieber</unclear> <unclear cert="low" resp="#joint">herr</unclear>
