<lb n="5"/><unclear cert="low" resp="#joint">Wir</unclear> habend uf gesterigen tag ainen der sich genennet
<lb n="6"/><persName resp="#ner">Joerg Trautman</persName> von <placeName resp="#ner"><unclear cert="low" resp="#joint">Schoenenburg</unclear></placeName> <unclear cert="low" resp="#joint">obflachen</unclear> <unclear cert="low" resp="#joint">in</unclear> der <unclear cert="low" resp="#joint">herr</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">schaft</unclear>, <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">begangnen</unclear> <unclear cert="low" resp="#joint">missethaten</unclear>, <unclear cert="low" resp="#joint">iustificieren</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">lassen</unclear>, der <unclear cert="low" resp="#joint">hat</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">ggesellen</unclear>
