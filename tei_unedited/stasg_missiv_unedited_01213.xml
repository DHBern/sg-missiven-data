<p>
<pb facs="StadtASG_Missive_1213_4011.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freundtlich</unclear> willig <unclear cert="medium" resp="#joint">dinnst</unclear> <unclear cert="low" resp="#joint">zuuor</unclear>, Ersamen, unnd
<lb n="2"/><unclear cert="low" resp="#joint">weyßen</unclear>, lieben unnd guoten <unclear cert="low" resp="#joint">freundt</unclear>, <unclear cert="low" resp="#joint">Auß</unclear> <unclear cert="low" resp="#joint">was</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">vrsachen</unclear>, wir <unclear cert="low" resp="#joint">vnnsers</unclear> Burgers <persName resp="#ner"><unclear cert="low" resp="#joint">Misael</unclear> <unclear cert="low" resp="#joint">Roeschels</unclear></persName> ge=
<lb n="4"/>meinen <unclear cert="low" resp="#joint">glaubigern</unclear>, <unclear cert="low" resp="#joint">einen</unclear> Allgemeinen <unclear cert="medium" resp="#joint">Rechtstag</unclear>,
<lb n="5"/><unclear cert="medium" resp="#joint">Ernenntt</unclear> unnd Angesetzt, das haben Ewer Ersam
<lb n="6"/><unclear cert="low" resp="#joint">weyßheit</unclear> <unclear cert="low" resp="#joint">auoßem</unclear> <unclear cert="low" resp="#joint">beyverwartten</unclear> <unclear cert="low" resp="#joint">Edict</unclear> <unclear cert="low" resp="#joint">zuover=</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">nemen</unclear>, <unclear cert="low" resp="#joint">Dieweil</unclear> dann <unclear cert="low" resp="#joint">Eettliche</unclear> E. E. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">Burgere</unclear>
<lb n="8"/>deßhalben auch <unclear cert="low" resp="#joint">Interessiert</unclear> sein, unnd zuo bemelts
<lb n="9"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Roeschels</unclear></persName> haab unnd guott <unclear cert="low" resp="#joint">vorderung</unclear> unnd <unclear cert="medium" resp="#joint">Zuosprach</unclear>
<lb n="10"/>haben <unclear cert="low" resp="#joint">moechten</unclear>, So <unclear cert="low" resp="#joint">pitten</unclear> wir sie <unclear cert="low" resp="#joint">ganntz</unclear> <unclear cert="low" resp="#joint">freundt=</unclear>
<lb n="11"/>lich, die woellen sollich <unclear cert="low" resp="#joint">Edict</unclear> <unclear cert="low" resp="#joint">Irem</unclear> habenden ge=
<lb n="12"/><unclear cert="low" resp="#joint">brauch</unclear> nach, bey Inen an <unclear cert="low" resp="#joint">gewoennden</unclear> <unclear cert="low" resp="#joint">Ortten</unclear> <unclear cert="low" resp="#joint">offendt=</unclear>
<lb n="13"/>lich <unclear cert="low" resp="#joint">Aufschlagen</unclear>, unnd Publicieren <unclear cert="medium" resp="#joint">laßen</unclear>, darmit
<lb n="14"/><unclear cert="medium" resp="#joint">an</unclear> seinem Rechten <unclear cert="low" resp="#joint">niemanndts</unclear> <unclear cert="low" resp="#joint">verkuertzt</unclear> werde,
<lb n="15"/>noch sich der <unclear cert="low" resp="#joint">vnwissenheit</unclear> <unclear cert="low" resp="#joint">zuobeklagen</unclear> <unclear cert="low" resp="#joint">vrsach</unclear> hab,
<lb n="16"/>Das begern wir <unclear cert="medium" resp="#joint">vmb</unclear> E. E. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">Iederzeitt</unclear>
<lb n="17"/>guottwillig unnd <unclear cert="low" resp="#joint">freundtlich</unclear> <unclear cert="low" resp="#joint">zuuerdienen</unclear>, <unclear cert="low" resp="#joint">Datt</unclear>
<lb n="18"/><origDate when="1587" cert="medium" resp="#ner">den <unclear cert="low" resp="#joint">xij</unclear> <unclear cert="low" resp="#joint">Septembris</unclear> Anno 87.</origDate>
<lb n="19"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermeister unnd <unclear cert="medium" resp="#joint">Rathe</unclear>
<lb n="20"/>der Statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_1213_4012.jpg" n="2"/>
<lb n="21"/>[]
<pb facs="StadtASG_Missive_1213_4013.jpg" n="3"/>
<pb facs="StadtASG_Missive_1213_4014.jpg" n="4"/>
<lb n="22"/>Den ersamen unnd weyßen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister,
<lb n="23"/>unnd Rathe, der Statt <unclear cert="medium" resp="#joint">Sannt</unclear> Gallen</orgName>, unnsern
