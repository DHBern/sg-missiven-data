<lb n="1"/><unclear cert="low" resp="#joint">Unsern</unclear> <unclear cert="low" resp="#joint">freündt</unclear>, <unclear cert="low" resp="#joint">willig</unclear> dienst <unclear cert="medium" resp="#joint">zuuor</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">Ehrsamer</unclear>, <unclear cert="medium" resp="#joint">weiser</unclear>, lieber und
<lb n="3"/><unclear cert="medium" resp="#joint">guoter</unclear> <unclear cert="medium" resp="#joint">freündt</unclear>.
<lb n="4"/><unclear cert="medium" resp="#joint">Eüwer</unclear> an <unclear cert="medium" resp="#joint">unß</unclear> sub dato, <date resp="#ner"><unclear cert="medium" resp="#joint">10/20</unclear>. <unclear cert="medium" resp="#joint">jüngst</unclear></date>-
<lb n="5"/><unclear cert="medium" resp="#joint">verwichnen</unclear> monats <unclear cert="low" resp="#joint">maÿ</unclear>, <unclear cert="low" resp="#joint">abgang</unclear>
<lb n="6"/>schreiben, unsers <unclear cert="medium" resp="#joint">geliebten</unclear> <unclear cert="medium" resp="#joint">mitrhats</unclear>
<lb n="7"/>und <unclear cert="medium" resp="#joint">zunfftmeisters</unclear> <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Rainers</unclear></persName>
<lb n="8"/><unclear cert="low" resp="#joint">sae</unclear>. <unclear cert="low" resp="#joint">hinderlaßens</unclear> <unclear cert="low" resp="#joint">erb</unclear> <unclear cert="low" resp="#joint">betreffende</unclear>,
<lb n="9"/>habend wir wol empfangen, und
<lb n="10"/>den innhalt <unclear cert="low" resp="#joint">deßelbigen</unclear> <unclear cert="low" resp="#joint">ablesend</unclear>
<lb n="11"/>wol <unclear cert="low" resp="#joint">verstand</unclear>: <unclear cert="low" resp="#joint">Obwolen</unclear>
<lb n="12"/>wir nun <unclear cert="medium" resp="#joint">wuenschen</unclear> <unclear cert="medium" resp="#joint">moechten</unclear>, daß
<lb n="13"/>ihr, an statt <unclear cert="low" resp="#joint">eüwerer</unclear> lieben <unclear cert="medium" resp="#joint">ehe</unclear>-
<lb n="14"/><unclear cert="medium" resp="#joint">haußfrauwen</unclear>, <unclear cert="medium" resp="#joint">zuo</unclear> vor <unclear cert="low" resp="#joint">angeregter</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">Rainerischen</unclear> <unclear cert="low" resp="#joint">erbschafft</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">verfolgung</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">etlich</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">jar</unclear> <unclear cert="low" resp="#joint">ußgestandnen</unclear> <unclear cert="low" resp="#joint">truebselig</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">keit</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">herzen</unclear> <unclear cert="low" resp="#joint">leid</unclear> <unclear cert="low" resp="#joint">ist</unclear>, <unclear cert="low" resp="#joint">hetten</unclear> <unclear cert="low" resp="#joint">koennen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">gelangen</unclear>, jedoch aber, <unclear cert="medium" resp="#joint">weilen</unclear>
<lb n="19"/>ein <unclear cert="low" resp="#joint">linien</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">statt</unclear> <unclear cert="low" resp="#joint">naeher</unclear>, die sich vor <unclear cert="medium" resp="#joint">disem</unclear>
<lb n="20"/>wegen <unclear cert="medium" resp="#joint">dises</unclear> <unclear cert="medium" resp="#joint">erbfahls</unclear> <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">angemeldet</unclear>,
<lb n="21"/><unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">besagte</unclear> <unclear cert="medium" resp="#joint">Eüwer</unclear> <unclear cert="medium" resp="#joint">haußfrauw</unclear>
<lb n="22"/>ist, <unclear cert="medium" resp="#joint">abgewisen</unclear> worden, so <unclear cert="medium" resp="#joint">koennen</unclear>
<lb n="23"/>wir <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">gar</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">weit</unclear>
<lb n="24"/>in <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">gebluet</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">interessiert</unclear>; <unclear cert="low" resp="#joint">deßwegen</unclear>, <unclear cert="low" resp="#joint">vermoeg</unclear> <unclear cert="low" resp="#joint">unserer</unclear>
