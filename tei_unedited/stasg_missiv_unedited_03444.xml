<lb n="32"/><unclear cert="medium" resp="#joint">Gott</unclear> den <unclear cert="medium" resp="#joint">Allmechtigen</unclear> <unclear cert="medium" resp="#joint">pittende</unclear>,
<lb n="33"/>Er <unclear cert="medium" resp="#joint">woelle</unclear> <unclear cert="medium" resp="#joint">eüch</unclear>, in <unclear cert="low" resp="#joint">Eüwerm</unclear> <unclear cert="low" resp="#joint">exilio</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">ander</unclear> <unclear cert="low" resp="#joint">werts</unclear> <unclear cert="low" resp="#joint">gnedigclich</unclear> <unclear cert="low" resp="#joint">ergezen</unclear>,
<lb n="35"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">deßen</unclear> gnedigen <unclear cert="medium" resp="#joint">schuz</unclear> undt
