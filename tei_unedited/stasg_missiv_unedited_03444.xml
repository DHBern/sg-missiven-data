<lb n="28"/><unclear cert="low" resp="#joint">gern</unclear> <unclear cert="low" resp="#joint">wirs</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">ihnen</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">gemelt</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">gonnen</unclear> <unclear cert="low" resp="#joint">moechten</unclear>.) nit admittiert <unclear cert="medium" resp="#joint">werden</unclear>,
<lb n="30"/>welches wir <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">eüwerm</unclear> be-
