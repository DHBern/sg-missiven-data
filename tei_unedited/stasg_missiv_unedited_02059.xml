<lb n="18"/><unclear cert="low" resp="#joint">dochter</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">noch</unclear> in leben, <unclear cert="low" resp="#joint">ehelich</unclear> <unclear cert="low" resp="#joint">erzeügt</unclear>, &amp;.
<lb n="19"/><unclear cert="low" resp="#joint">Als</unclear> aber <unclear cert="medium" resp="#joint">ermelter</unclear> <persName resp="#ner">Mattheis <unclear cert="medium" resp="#joint">Zebel</unclear></persName> ge-
<lb n="20"/>nant <unclear cert="low" resp="#joint">Hüeß</unclear> wegen <unclear cert="medium" resp="#joint">begangner</unclear> <unclear cert="medium" resp="#joint">mißenthat</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">auß</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">Statt</unclear> <unclear cert="medium" resp="#joint">verwißen</unclear>, hat er sich <unclear cert="low" resp="#joint">under</unclear> der
<lb n="22"/><unclear cert="low" resp="#joint">hersch</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Bregentz</unclear></placeName> <unclear cert="low" resp="#joint">uffgehalten</unclear>, in wenig zeit <unclear cert="medium" resp="#joint">er</unclear>-
