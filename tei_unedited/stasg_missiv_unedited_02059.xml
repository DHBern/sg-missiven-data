<lb n="24"/>oder auß <placeName resp="#ner"><unclear cert="low" resp="#joint">Tÿrol</unclear></placeName> <unclear cert="low" resp="#joint">dißen</unclear> <unclear cert="medium" resp="#joint">Knaben</unclear>, und <unclear cert="low" resp="#joint">villeicht</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">andere</unclear> <unclear cert="low" resp="#joint">Kinder</unclear> mehr, <unclear cert="low" resp="#joint">bekhomen</unclear> <unclear cert="low" resp="#joint">&amp;</unclear>. <unclear cert="low" resp="#joint">Wol</unclear>-
<lb n="26"/>aber <unclear cert="low" resp="#joint">weilen</unclear> weder der vatter noch sein
<lb n="27"/><unclear cert="low" resp="#joint">letzte</unclear> Haußfraw, so noch alhie in leben, <unclear cert="medium" resp="#joint">da</unclear>-
<lb n="28"/>malen <unclear cert="medium" resp="#joint">verburgert</unclear> <unclear cert="medium" resp="#joint">gewest</unclear>, <unclear cert="medium" resp="#joint">wier</unclear> auch
<lb n="29"/><persName resp="#ner"><unclear cert="low" resp="#joint">Bredtüng</unclear></persName> <unclear cert="low" resp="#joint">ibis</unclear> <unclear cert="low" resp="#joint">fux</unclear>.
<pb facs="StadtASG_Missive_2059_7708.jpg" n="2"/>
<lb n="30"/><unclear cert="low" resp="#joint">dieser</unclear> <unclear cert="low" resp="#joint">knaben</unclear> alls ein <unclear cert="low" resp="#joint">ehrverletzer</unclear> alß wenig
<lb n="31"/>fuer sich verbuergen koendte, sollemen am
<lb n="32"/>allerwenigisten, bei so gewandten dingen
<lb n="33"/>in loco non commissi delicti <unclear cert="medium" resp="#joint">poeniern</unclear> und
<lb n="34"/><unclear cert="medium" resp="#joint">abstrafen</unclear> <unclear cert="medium" resp="#joint">kuendte</unclear>, sonder E. E. F. W. waer=
<lb n="35"/>umb <unclear cert="low" resp="#joint">hie</unclear> <unclear cert="low" resp="#joint">gebuehrender</unclear> <unclear cert="low" resp="#joint">abstrafung</unclear> <unclear cert="low" resp="#joint">uber=</unclear>
<lb n="36"/>senden wollen, <unclear cert="low" resp="#joint">deren</unclear> aber <unclear cert="low" resp="#joint">weder</unclear> diß
<lb n="37"/><unclear cert="low" resp="#joint">anzunemen</unclear> sich <unclear cert="low" resp="#joint">beschwerdt</unclear>, mit <unclear cert="low" resp="#joint">vermelden</unclear>,
<lb n="38"/>das er <unclear cert="low" resp="#joint">weitern</unclear> befelch nicht hab, den
<lb n="39"/>ihne alher zefueren. Welchs haben wir
<lb n="40"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">statt</unclear> und des landts <unclear cert="low" resp="#joint">gerechtigkeit</unclear>
<lb n="41"/>und E. E. F. E. W. an stat hiemit berichten
<lb n="42"/>wellen.
<lb n="43"/>Thuen uns beschließlich gegen E. E. F. W.
<lb n="44"/>dieses nachbarlichen corespondentz und avi=
<lb n="45"/>sierens gantz freundtlich bedanckhen,
<lb n="46"/>zumahl erbietend, da wir denselben
<lb n="47"/>auf alle <unclear cert="low" resp="#joint">fähl</unclear> <unclear cert="low" resp="#joint">was</unclear> angenembs und
<lb n="48"/>dienstlichs erweisen <unclear cert="low" resp="#joint">kuendten</unclear>, das sy uns
<lb n="49"/>nach <unclear cert="low" resp="#joint">mueglichkeit</unclear> zum besten haben sollen,
<lb n="50"/><unclear cert="low" resp="#joint">hiemit</unclear> uns aller sits gottes gnaden befelchen.
<lb n="51"/>Geben den <origDate when="1617-08-05" resp="#ner">5. Augusti a° 1617</origDate>.
<lb n="52"/><orgName ref="stadtasg-actors-63" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Stataman</unclear> und rhat
