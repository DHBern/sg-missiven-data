<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">freundtlich</unclear> willig dienst <unclear cert="low" resp="#joint">zuvoir</unclear>, <unclear cert="low" resp="#joint">Fromm</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">Eerenvest</unclear>, <unclear cert="low" resp="#joint">Ersame</unclear>, Fuersichtig, ersam <unclear cert="low" resp="#joint">Weÿse</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">besonders</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> herren <unclear cert="low" resp="#joint">guette</unclear> <unclear cert="low" resp="#joint">Freundt</unclear> <unclear cert="medium" resp="#joint">und</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">Nachbarn</unclear>.
<lb n="5"/>Wier haben E. E. <unclear cert="low" resp="#joint">F</unclear>. W. schreiben, sambt <unclear cert="medium" resp="#joint">seinem</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">einschluß</unclear> wol <unclear cert="low" resp="#joint">endtfangen</unclear>, <unclear cert="low" resp="#joint">inhalts</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>,
<lb n="7"/>so <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">auch</unclear> daß <unclear cert="low" resp="#joint">hiehero</unclear> <unclear cert="low" resp="#joint">geliferten</unclear> <unclear cert="low" resp="#joint">Knaben</unclear> <unclear cert="low" resp="#joint">aüs</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">sag</unclear> <unclear cert="low" resp="#joint">vernomen</unclear>, <unclear cert="low" resp="#joint">darvon</unclear> <unclear cert="low" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">weniuger</unclear> <unclear cert="low" resp="#joint">nicht</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="low" resp="#joint">künden</unclear>, <unclear cert="low" resp="#joint">dan</unclear> gebührende inquisition
<lb n="10"/><unclear cert="medium" resp="#joint">hierüber</unclear> <unclear cert="low" resp="#joint">fürzunemen</unclear>, <unclear cert="low" resp="#joint">Alda</unclear> <unclear cert="medium" resp="#joint">wier</unclear> be-
<lb n="11"/><unclear cert="low" resp="#joint">fünden</unclear>, <unclear cert="medium" resp="#joint">daß</unclear> nicht <unclear cert="medium" resp="#joint">ohne</unclear> <unclear cert="medium" resp="#joint">daß</unclear> vor <unclear cert="low" resp="#joint">ungefehr</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">10</unclear>. jahr <persName resp="#ner"><unclear cert="low" resp="#joint">Mattheis</unclear> <unclear cert="low" resp="#joint">Zebel</unclear></persName>, mit dem <unclear cert="medium" resp="#joint">übernamen</unclear>
<lb n="13"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Hüeß</unclear></persName> genant, ein <unclear cert="medium" resp="#joint">zimmerman</unclear> <unclear cert="medium" resp="#joint">alhie</unclear> <unclear cert="medium" resp="#joint">aß</unclear> <unclear cert="medium" resp="#joint">daß</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">burgerrecht</unclear> <unclear cert="medium" resp="#joint">gangen</unclear> und die <unclear cert="low" resp="#joint">Nachstewr</unclear> er-
<lb n="15"/><unclear cert="low" resp="#joint">legt</unclear>, <unclear cert="low" resp="#joint">deme</unclear> <unclear cert="low" resp="#joint">selbst</unclear> sich alhie mit <unclear cert="low" resp="#joint">einer</unclear> <unclear cert="low" resp="#joint">Verkherten</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">Eelichen</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">nie</unclear> weder <unclear cert="low" resp="#joint">burger</unclear> noch <unclear cert="low" resp="#joint">hindersäß</unclear>
