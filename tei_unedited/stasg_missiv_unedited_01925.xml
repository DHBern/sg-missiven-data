<p>
<pb facs="StadtASG_Missive_1925_7169.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freuendtlich</unclear> willig dienst und was wir ehren
<lb n="2"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">wuenschung</unclear> <unclear cert="low" resp="#joint">eines</unclear> liebs und guots <unclear cert="low" resp="#joint">vermoegend</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">fromen</unclear>, <unclear cert="low" resp="#joint">fuer</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">glueckseeligen</unclear> <unclear cert="low" resp="#joint">neüwen</unclear> <unclear cert="low" resp="#joint">sichtigen</unclear> <unclear cert="low" resp="#joint">ehrsamen</unclear> und weisen, insonders guoten
<lb n="4"/><unclear cert="low" resp="#joint">jars</unclear>, <unclear cert="low" resp="#joint">freünden</unclear> und <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben Eydtgnossen.
<lb n="5"/>Wiewol wir, in unserm an sie <unclear cert="medium" resp="#joint">juengst</unclear> <unclear cert="medium" resp="#joint">abgangnen</unclear>
<lb n="6"/>schreiben; zuo <unclear cert="medium" resp="#joint">eroerterung</unclear> der <unclear cert="medium" resp="#joint">spänigen</unclear> <unclear cert="medium" resp="#joint">erbsach</unclear>,
<lb n="7"/>sich <unclear cert="medium" resp="#joint">haltende</unclear>, <unclear cert="medium" resp="#joint">entzwueschet</unclear> <unclear cert="medium" resp="#joint">üwerer</unclear> <unclear cert="medium" resp="#joint">landtsmänin</unclear>,
<lb n="8"/><unclear cert="medium" resp="#joint">weiland</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Fridlij</unclear> <unclear cert="medium" resp="#joint">Eblins</unclear></persName> <unclear cert="medium" resp="#joint">säligen</unclear> wittiben, an einem,
<lb n="9"/>und <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">stattschreiber</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">mithafften</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">an</unclear> dem <unclear cert="medium" resp="#joint">andern</unclear> theil, den nechsten <date resp="#ner"><unclear cert="medium" resp="#joint">donstag</unclear> nach
<lb n="11"/><unclear cert="medium" resp="#joint">Hilarij</unclear> <unclear cert="medium" resp="#joint">nechsteingehenden</unclear> <unclear cert="medium" resp="#joint">monats</unclear> <unclear cert="medium" resp="#joint">Januarii</unclear></date>
<lb n="12"/>zuo <unclear cert="medium" resp="#joint">einem</unclear> <unclear cert="medium" resp="#joint">rechtstag</unclear> <unclear cert="medium" resp="#joint">ernambset</unclear>, <unclear cert="medium" resp="#joint">Sidmalen</unclear>
<lb n="13"/>aber uns nit allein andere <unclear cert="medium" resp="#joint">verhinderliche</unclear> <unclear cert="medium" resp="#joint">gschäfft</unclear> <unclear cert="medium" resp="#joint">fuer</unclear>-, <unclear cert="medium" resp="#joint">sonder</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">nebend</unclear> <unclear cert="medium" resp="#joint">zuogleich</unclear> auch die <unclear cert="low" resp="#joint">vorstehende</unclear> <unclear cert="low" resp="#joint">Eydtgnosische</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">zuosamenkunfft</unclear> <unclear cert="low" resp="#joint">aller</unclear> orten und <unclear cert="low" resp="#joint">Zugewandten</unclear>
<lb n="16"/>zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Baden</unclear></placeName>, gleich <unclear cert="low" resp="#joint">eben</unclear> <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">dieselbige</unclear> zeit <unclear cert="medium" resp="#joint">einge</unclear>-
<lb n="17"/>fallen, <unclear cert="low" resp="#joint">daß</unclear> also die <unclear cert="medium" resp="#joint">angeregte</unclear> <unclear cert="medium" resp="#joint">erbhand</unclear>-
<lb n="18"/>lung auf disen <unclear cert="medium" resp="#joint">bestimbten</unclear> tag, <unclear cert="medium" resp="#joint">keinen</unclear> <unclear cert="medium" resp="#joint">fortgang</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">gewünnen</unclear> kan, So haben wir die sach
<lb n="20"/>allein umb .8. tag <unclear cert="medium" resp="#joint">ferrner</unclear> <unclear cert="medium" resp="#joint">verschoben</unclear>, und hier-
<lb n="21"/>zuo <unclear cert="medium" resp="#joint">einen</unclear> andern tag <unclear cert="medium" resp="#joint">ernennt</unclear>, namlich den
<lb n="22"/><unclear cert="medium" resp="#joint">anderen</unclear> donstag nach <unclear cert="medium" resp="#joint">Hilarij</unclear>; <unclear cert="medium" resp="#joint">wirdt</unclear> <unclear cert="medium" resp="#joint">seijn</unclear>,
<lb n="23"/>der <date resp="#ner"><unclear cert="low" resp="#joint">sechsundzwentzigste</unclear> <unclear cert="low" resp="#joint">vorerzelts</unclear> <unclear cert="low" resp="#joint">monats</unclear>
<lb n="24"/>tag <unclear cert="medium" resp="#joint">Januarii</unclear> <unclear cert="medium" resp="#joint">alten</unclear> <unclear cert="medium" resp="#joint">calenders</unclear></date>, Und
<lb n="25"/><unclear cert="medium" resp="#joint">hierauf</unclear> nit <unclear cert="medium" resp="#joint">ermanglen</unclear> <unclear cert="medium" resp="#joint">wollen</unclear>, <unclear cert="medium" resp="#joint">eüch</unclear>
<lb n="26"/>unsern <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">anzufuegen</unclear>, <unclear cert="low" resp="#joint">freündt</unclear>-
<lb n="27"/>lich <unclear cert="medium" resp="#joint">bittende</unclear>, <unclear cert="medium" resp="#joint">unbeschwerdt</unclear> <unclear cert="medium" resp="#joint">zuseijn</unclear>, <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">es</unclear> <unclear cert="medium" resp="#joint">ihrer</unclear>
<lb n="28"/><unclear cert="medium" resp="#joint">landtsmänin</unclear>, zuo ihrer nachrichtung, auch
<lb n="29"/><unclear cert="medium" resp="#joint">wüssenhafft</unclear> <unclear cert="medium" resp="#joint">zumachen</unclear>. Und thuond <unclear cert="medium" resp="#joint">darbij</unclear>
<lb n="30"/>uns <unclear cert="medium" resp="#joint">sambtlich</unclear> dem <unclear cert="medium" resp="#joint">schirm</unclear> Gottes in <unclear cert="medium" resp="#joint">treüwen</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">bevelchen</unclear>. <origDate when="1614-12-28" resp="#ner">Datum den .28. <unclear cert="low" resp="#joint">tag</unclear> <unclear cert="low" resp="#joint">decembr</unclear>. <unclear cert="low" resp="#joint">1614</unclear></origDate>
<lb n="32"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">B</unclear>. <unclear cert="low" resp="#joint">u</unclear> <unclear cert="low" resp="#joint">r</unclear>. <unclear cert="low" resp="#joint">st</unclear> <unclear cert="low" resp="#joint">sang</unclear></orgName>
<lb n="33"/>An <orgName ref="stadtasg-actors-502" cert="medium" role="recipient" resp="#ner">die von Glarus</orgName>.
<pb facs="StadtASG_Missive_1925_7170.jpg" n="2"/>
<lb n="34"/>[]
</p>
