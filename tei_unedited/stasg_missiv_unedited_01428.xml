<lb n="55"/><unclear cert="medium" resp="#joint">unuerhindert</unclear> <unclear cert="medium" resp="#joint">leernen</unclear> lassen, Unnd <unclear cert="medium" resp="#joint">uwer</unclear> statt sich
<lb n="56"/>gegen <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">unnserenn</unclear> Inn <unclear cert="low" resp="#joint">sölchem</unclear> fhall so Nachpürlich
<lb n="57"/>unnd günstig <unclear cert="medium" resp="#joint">erzeijgen</unclear> <unclear cert="medium" resp="#joint">bewijsen</unclear> unnd hallten, Das <unclear cert="medium" resp="#joint">er</unclear>
<lb n="58"/><unclear cert="medium" resp="#joint">gespüren</unclear> unnser <unclear cert="low" resp="#joint">fürschrifft</unclear> <unclear cert="low" resp="#joint">woll</unclear> unnd <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">guottem</unclear>
