    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1652_6017.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freüntlich</unclear> willig dienst und <unclear cert="medium" resp="#joint">grueß</unclear> <unclear cert="medium" resp="#joint">zuvor</unclear>,
<lb n="2"/>edler <unclear cert="medium" resp="#joint">ehrenvester</unclear> und <unclear cert="medium" resp="#joint">weiser</unclear>, <unclear cert="medium" resp="#joint">insonders</unclear> <unclear cert="medium" resp="#joint">lieber</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">Herr</unclear> <unclear cert="medium" resp="#joint">Landtvogt</unclear>, gueter <unclear cert="medium" resp="#joint">freünd</unclear> und nachbar.
<lb n="4"/>Eüwer <unclear cert="low" resp="#joint">widerantwürtlich</unclear> <unclear cert="low" resp="#joint">freündt-nachbarlich</unclear>
<lb n="5"/>schreiben, betreffende die <unclear cert="medium" resp="#joint">tractation</unclear> deß weinlauffs,
<lb n="6"/>zwüschend unß und <unclear cert="low" resp="#joint">eüwrer</unclear> <unclear cert="low" resp="#joint">амptsverwaltung</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">zuegehoerigen</unclear> <unclear cert="low" resp="#joint">vier</unclear> <unclear cert="low" resp="#joint">obern</unclear> <unclear cert="low" resp="#joint">Hoeffen</unclear> deß <placeName ref="stadtasg-places-64" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Reinthals</unclear></placeName>, habend
<lb n="8"/>wir <unclear cert="medium" resp="#joint">angehoert</unclear>, und darauß verstanden daß
<lb n="9"/>die gemelten <unclear cert="medium" resp="#joint">vier</unclear> <unclear cert="medium" resp="#joint">Hoeff</unclear> ob <unclear cert="low" resp="#joint">der</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Furth</unclear></placeName> die <unclear cert="low" resp="#joint">vor</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">halten</unclear>, <unclear cert="low" resp="#joint">aufgerichte</unclear> brieff und sigel diß jars noch <unclear cert="medium" resp="#joint">kraefftig</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">seijen</unclear>, <unclear cert="medium" resp="#joint">derowegen</unclear> <unclear cert="medium" resp="#joint">sÿ</unclear> mit unß den wein=
<lb n="12"/>lauff <unclear cert="low" resp="#joint">fuernigs</unclear> jars <unclear cert="medium" resp="#joint">nach</unclear> innhalt derselben,
<lb n="13"/>und wie bißher <unclear cert="medium" resp="#joint">breüchig</unclear> gewesen <unclear cert="medium" resp="#joint">zubeschliessen</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">begeren</unclear>, darneben aber <unclear cert="medium" resp="#joint">inen</unclear> <unclear cert="medium" resp="#joint">gefallen</unclear> lassen,
<lb n="15"/>sich mit unß, künfftigs jars <unclear cert="medium" resp="#joint">deßwegen</unclear> von <unclear cert="medium" resp="#joint">neüwem</unclear> <unclear cert="medium" resp="#joint">zueersprechen</unclear>
<lb n="16"/>und <unclear cert="medium" resp="#joint">zueunderreden</unclear>, <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">derhalben</unclear> <unclear cert="medium" resp="#joint">zeit</unclear> und
<lb n="17"/><unclear cert="medium" resp="#joint">malstat</unclear> <unclear cert="medium" resp="#joint">zuenamsen</unclear> <unclear cert="medium" resp="#joint">unserm</unclear> <unclear cert="medium" resp="#joint">guetbedunckhen</unclear>
<lb n="18"/>heimgestellt haben <unclear cert="medium" resp="#joint">wellen</unclear> <unclear cert="medium" resp="#joint">etc</unclear>.
<lb n="19"/><unclear cert="medium" resp="#joint">Darauf</unclear> <unclear cert="medium" resp="#joint">bedanckhend</unclear> wir unß <unclear cert="low" resp="#joint">fürserst</unclear> gegen
<lb n="20"/><unclear cert="medium" resp="#joint">eüch</unclear>, <unclear cert="medium" resp="#joint">eüwerer</unclear> <unclear cert="medium" resp="#joint">darunder</unclear> <unclear cert="medium" resp="#joint">angewendten</unclear> <unclear cert="medium" resp="#joint">müe</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">gantz</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear>, und <unclear cert="medium" resp="#joint">sidmalen</unclear> der <unclear cert="medium" resp="#joint">vier</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">Hoeffen</unclear> meinung <unclear cert="medium" resp="#joint">obvermerckhter</unclear> <unclear cert="medium" resp="#joint">gestalt</unclear> beschaffen,
<lb n="23"/>so lassend wir unß dieselbigen auch nit <unclear cert="medium" resp="#joint">zue</unclear> wider
<lb n="24"/>sein, sonder <unclear cert="medium" resp="#joint">moegend</unclear> wol <unclear cert="medium" resp="#joint">leiden</unclear>, daß auf dz
<lb n="25"/><unclear cert="medium" resp="#joint">fuernig</unclear> jar der lauff nach <unclear cert="medium" resp="#joint">vermoeg</unclear> aufgerichter
<lb n="26"/>vergleichung <unclear cert="medium" resp="#joint">beschlossen</unclear> werde. <unclear cert="medium" resp="#joint">Wir</unclear> <unclear cert="medium" resp="#joint">hetten</unclear>
<lb n="27"/>auch, wann der <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">Statschreiber</unclear> <unclear cert="low" resp="#joint">jüngstlich</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> deßhalben nit <unclear cert="medium" resp="#joint">angeredet</unclear> <unclear cert="medium" resp="#joint">hette</unclear>, <unclear cert="medium" resp="#joint">dise</unclear> be=
<lb n="29"/><unclear cert="medium" resp="#joint">schechne</unclear> <unclear cert="medium" resp="#joint">ermanung</unclear> nit für die hand genomen,
<pb facs="StadtASG_Missive_1652_6018.jpg" n="2"/>
<lb n="30"/>in betrachtung, <unclear cert="medium" resp="#joint">wir</unclear> in der von den herren <unclear cert="low" resp="#joint">Eydt</unclear>-
<lb n="31"/>gnossen über die <unclear cert="low" resp="#joint">abgeredte</unclear>
<lb n="32"/>vergleichung <unclear cert="low" resp="#joint">ertailten</unclear> confirmation wol befinden
<lb n="33"/>daß die brieff daß <date resp="#ner"><unclear cert="low" resp="#joint">heurig</unclear> jar</date> noch <unclear cert="low" resp="#joint">krefftig</unclear> sind.
<lb n="34"/>Aber auß deß herren <unclear cert="low" resp="#joint">gegebnem</unclear> anlaß habend
<lb n="35"/>wir <unclear cert="low" resp="#joint">gemuetmaßet</unclear> die vier höff möchten vileicht
<lb n="36"/>die jar von der zeit an rechnen, alß die ver-
<lb n="37"/>gleichung alhie in der <placeName ref="stadtasg-places-143" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">fürstlichen</unclear> <unclear cert="medium" resp="#joint">Pfalz</unclear></placeName> <unclear cert="low" resp="#joint">abgeredt</unclear>
<lb n="38"/>worden, welches fast <unclear cert="low" resp="#joint">ain</unclear> jar vor der
<lb n="39"/><orgName resp="#ner">herren <unclear cert="low" resp="#joint">Eydtgnossen</unclear></orgName> <unclear cert="low" resp="#joint">bestetigung</unclear> beschehen,
<lb n="40"/>und selbiger rechnung nach es <unclear cert="low" resp="#joint">anjezo</unclear> am end <unclear cert="low" resp="#joint">were</unclear>. Der-
<lb n="41"/>halben wir der mehrgedachten vier höffen
<lb n="42"/><unclear cert="medium" resp="#joint">mainung</unclear> und verstand <unclear cert="low" resp="#joint">zuerfaren</unclear> <unclear cert="low" resp="#joint">begeret</unclear>:
<lb n="43"/>und aber an irer <unclear cert="low" resp="#joint">erklerung</unclear> unß wol er-
<lb n="44"/><unclear cert="low" resp="#joint">seetigen</unclear> mögen. Sind auch <unclear cert="low" resp="#joint">genaigt</unclear>, <unclear cert="low" resp="#joint">uffs</unclear>
<lb n="45"/><date resp="#ner">künfftig jar</date> ( gliebts Gott ) unß mit inen
<lb n="46"/>weiter <unclear cert="low" resp="#joint">zuersprechen</unclear>, und wo müglich freundt-
<lb n="47"/>nachbarlich zuvergleichen, auch inen mit
<lb n="48"/>glegenheit zeit und malstat, bey <unclear cert="medium" resp="#joint">gueter</unclear>
<lb n="49"/>früer zeit <unclear cert="low" resp="#joint">zuvor</unclear> <unclear cert="low" resp="#joint">anzukünden</unclear>, sy sich
<lb n="50"/>darnach zuverhalten <unclear cert="medium" resp="#joint">wüßen</unclear> mögen. Und
<lb n="51"/>also unsers <unclear cert="low" resp="#joint">tails</unclear> alles daß <unclear cert="low" resp="#joint">jennig</unclear> thuen,
<lb n="52"/>waß zu <unclear cert="low" resp="#joint">gueter</unclear> nachbarlicher <unclear cert="medium" resp="#joint">verstendtnuß</unclear>
<lb n="53"/>fürstendig sein mag, welches wir
<lb n="54"/>inen <unclear cert="low" resp="#joint">gleichsfalß</unclear> <unclear cert="low" resp="#joint">auch</unclear> wol vertrauwen <unclear cert="medium" resp="#joint">thünd</unclear>.
<lb n="55"/>Waß dann den zu <placeName ref="stadtasg-places-116" cert="medium" resp="#ner">S. Margreten</placeName> angesezten
<lb n="56"/>vgleichungstag betreffend daß weggelt da-
<lb n="57"/>selbsten, anlangt, ist unß derselbig auf
<lb n="58"/><date resp="#ner">künfftigen mentag</date> ( andrer wichtigen
<pb facs="StadtASG_Missive_1652_6019.jpg" n="3"/>
<lb n="59"/><unclear cert="low" resp="#joint">gschaeften</unclear> halber) <unclear cert="low" resp="#joint">zubesuohen</unclear> <unclear cert="low" resp="#joint">unmüglich</unclear>, bittend
<lb n="60"/>derhalben <unclear cert="low" resp="#joint">freündtlich</unclear> denselben <unclear cert="medium" resp="#joint">abzuostellen</unclear>, und
<lb n="61"/><unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">ungfar</unclear> .10. oder .14. tg. später
<lb n="62"/>zuoernamßen, wollen wir alßdann den=
<lb n="63"/>selben gern <unclear cert="low" resp="#joint">besuohen</unclear> lassen, und den <unclear cert="low" resp="#joint">sachen</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">zuoguter</unclear> endtschaft (mag es sein) <unclear cert="low" resp="#joint">abhelffen</unclear>.
<lb n="65"/>Wolten wir <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">zufreündtlich</unclear> nit bergen, und
<lb n="66"/>bleiben <unclear cert="low" resp="#joint">eüch</unclear> zu angenemer <unclear cert="low" resp="#joint">diensterzeigüng</unclear>
<lb n="67"/>jederzeit willig. <unclear cert="low" resp="#joint">Götlicher</unclear> obhalt unß damit
<lb n="68"/>zumal wol bevelchende. Datum <origDate when="1609" resp="#ner">den .22. tg.
<lb n="69"/>Augusti Ao 1609</origDate>.
<lb n="70"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B und Rhate</orgName> etc
<lb n="71"/>Dem Edlen <unclear cert="low" resp="#joint">Ehrnvesten</unclear> und Weisen <persName role="issuer" resp="#ner">Christoph
<lb n="72"/>Schorno</persName>, deß Rhats <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-287" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schweiz</unclear></placeName>, der zeit Landtvogt
<lb n="73"/>im <placeName ref="stadtasg-places-64" cert="medium" resp="#ner">Rheintal</placeName>, unserm <unclear cert="low" resp="#joint">jnsonders</unclear> lieben
<lb n="74"/>Herren, guoten <unclear cert="low" resp="#joint">freünd</unclear> und <unclear cert="low" resp="#joint">nachbarn</unclear>.
<pb facs="StadtASG_Missive_1652_6020.jpg" n="4"/>
<lb n="75"/><unclear cert="medium" resp="#joint">Dem</unclear> <unclear cert="medium" resp="#joint">h</unclear>. <orgName role="recipient" resp="#ner">Landtvogt <unclear cert="medium" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">Reinthal</unclear></orgName>, <persName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Christoff</unclear>
<lb n="76"/><unclear cert="medium" resp="#joint">Schorno</unclear></persName> v. <placeName ref="stadtasg-places-287" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schweiz</unclear></placeName> <origDate when="1609-08-22" resp="#ner">22. Augusti 1609</origDate>.
<lb n="77"/>betref <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">weinkauf</unclear>.
</p>
