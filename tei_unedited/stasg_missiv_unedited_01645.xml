<lb n="43"/>ansehen <unclear cert="medium" resp="#joint">gstaltßame</unclear> der sachen <unclear cert="medium" resp="#joint">Iro</unclear> <unclear cert="medium" resp="#joint">dasselbig</unclear> zuo <unclear cert="low" resp="#joint">halb</unclear> <unclear cert="low" resp="#joint">guet</unclear>
