<lb n="34"/>Das der gedachten Fraw <persName resp="#ner"><unclear cert="low" resp="#joint">Cleophe</unclear> <unclear cert="low" resp="#joint">Roedorfin</unclear></persName> drey <unclear cert="low" resp="#joint">Schwoesteren</unclear>,
