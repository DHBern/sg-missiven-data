        <body>
<p>
<pb facs="StadtASG_Missive_2073_7757.jpg" n="1"/>
<lb n="1"/>Hoch, und <unclear cert="low" resp="#joint">Wohlgeborner</unclear> <unclear cert="low" resp="#joint">Grave</unclear>, gnedig
<lb n="2"/>Herre und Nachber, E. <unclear cert="low" resp="#joint">Gdn</unclear>. <unclear cert="low" resp="#joint">syen</unclear> <unclear cert="low" resp="#joint">unsere</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">frtlich</unclear> <unclear cert="low" resp="#joint">gar</unclear> ganz geneigte und <unclear cert="low" resp="#joint">guotwillige</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">dienst</unclear> und was wir ehren liebs und
<lb n="5"/>guots vermoegend, zuvor.
<lb n="6"/><unclear cert="low" resp="#joint">Was</unclear> <unclear cert="low" resp="#joint">andres</unclear>, <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">getruwen</unclear> <unclear cert="low" resp="#joint">liebe</unclear> Mit-
<lb n="7"/><unclear cert="low" resp="#joint">burgere</unclear> <unclear cert="low" resp="#joint">Weylande</unclear> <unclear cert="low" resp="#joint">Hr</unclear>. <persName resp="#ner">Georg <unclear cert="low" resp="#joint">Zwickers</unclear></persName>
<lb n="8"/>und seines sohns <persName resp="#ner">Philipp Zwickers</persName> beed selig erben,
<lb n="9"/>abermahlen gehorsamlich erlangt und <unclear cert="low" resp="#joint">gebtten</unclear>
<lb n="10"/>dz haben wir E. <unclear cert="low" resp="#joint">Gdn</unclear>. von <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">getrüwen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">Stattschriber</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Melchior</unclear> <unclear cert="low" resp="#joint">Guldin</unclear></persName> und <unclear cert="low" resp="#joint">mehrers</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">gndg</unclear> <unclear cert="low" resp="#joint">zu</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">vernemen</unclear>.
<lb n="14"/><unclear cert="low" resp="#joint">Gelangt</unclear> <unclear cert="low" resp="#joint">demnach</unclear> <unclear cert="low" resp="#joint">an</unclear> E. Gd. unser <unclear cert="low" resp="#joint">disß</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">nachbarliche</unclear> <unclear cert="low" resp="#joint">ersuochen</unclear> <unclear cert="low" resp="#joint">u</unclear>. bitt, sie <unclear cert="low" resp="#joint">wellen</unclear>
<lb n="16"/>ihnen <unclear cert="low" resp="#joint">demselben</unclear> <unclear cert="low" resp="#joint">mit</unclear> allein gnedige audienz ertheilen
<lb n="17"/>sdn auch uf sein <unclear cert="low" resp="#joint">underthonige</unclear> <unclear cert="low" resp="#joint">werbung</unclear>,
<lb n="18"/>mit gnedigem bescheidt <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">willfarig</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">bescheidt</unclear> <unclear cert="low" resp="#joint">begegnen</unclear>. Wie <unclear cert="low" resp="#joint">deß</unclear> zu E.
<lb n="20"/>Gd. unser wie <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">ufricht</unclear> <unclear cert="low" resp="#joint">nachbar</unclear>-
<lb n="21"/><unclear cert="low" resp="#joint">lich</unclear> <unclear cert="low" resp="#joint">vertrauwen</unclear> <unclear cert="low" resp="#joint">staht</unclear>.
<lb n="22"/><unclear cert="low" resp="#joint">begehramb</unclear> E. <unclear cert="low" resp="#joint">Gd</unclear>. wir <unclear cert="low" resp="#joint">hinwiderumb</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">wo</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ie</unclear> <unclear cert="low" resp="#joint">koenen</unclear>, mit <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">dienstge</unclear>-
<lb n="24"/>neigten willen u. gemuet zuerwidern.
<lb n="25"/>Datum den <origDate when="1614-11-14" resp="#ner">14ten Novembris ao 1614</origDate>.
<lb n="26"/>E. Gdn.
<lb n="27"/>dienstwillige
<lb n="28"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. u. R. dr Statt St Gallen</orgName>
<lb n="29"/>Dem Hoch, und <unclear cert="low" resp="#joint">Wohlgebornen</unclear> <unclear cert="low" resp="#joint">Graven</unclear> <unclear cert="low" resp="#joint">u</unclear>. Herren, Herren,
<lb n="30"/><persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Casparn</unclear></persName>, <unclear cert="low" resp="#joint">Graven</unclear> <unclear cert="low" resp="#joint">zn</unclear> <placeName ref="stadtasg-places-213" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Hohen</unclear> <unclear cert="low" resp="#joint">Embs</unclear></placeName> <placeName resp="#ner"><unclear cert="low" resp="#joint">Gallara</unclear></placeName> und <placeName ref="stadtasg-places-31" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Vaduz</unclear></placeName>
<lb n="31"/><unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">gd</unclear> <unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">Nachbarn</unclear>.
<pb facs="StadtASG_Missive_2073_7758.jpg" n="2"/>
<pb facs="StadtASG_Missive_2073_7759.jpg" n="3"/>
