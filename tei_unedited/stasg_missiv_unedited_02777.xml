<p>
<pb facs="StadtASG_Missive_2777_10845.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> fründtlich willig dienst und was wir ehren liebs
<lb n="2"/>und guots <unclear cert="medium" resp="#joint">vermoegent</unclear> zuovor, <unclear cert="medium" resp="#joint">from</unclear>, fürsichtig, ehrsam, <unclear cert="medium" resp="#joint">wyß</unclear>,
<lb n="3"/>insonders guot fründ und gethrüw lieb <unclear cert="medium" resp="#joint">Eydtgnoßen</unclear>.
<lb n="4"/>Welcher <unclear cert="medium" resp="#joint">gestalten</unclear> <unclear cert="medium" resp="#joint">ir</unclear> <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">vertruwlich</unclear> zuogelangt-
<lb n="5"/>en <unclear cert="low" resp="#joint">waarnusen</unclear> <unclear cert="low" resp="#joint">avisen</unclear> nit <unclear cert="medium" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">teilhafft</unclear> <unclear cert="medium" resp="#joint">gemachet</unclear>, <unclear cert="medium" resp="#joint">sonderen</unclear>
<lb n="6"/>uns daby auch by <unclear cert="medium" resp="#joint">diseren</unclear> <unclear cert="medium" resp="#joint">seltzamen</unclear> und <unclear cert="medium" resp="#joint">geschwinden</unclear> <unclear cert="medium" resp="#joint">löuffen</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">umb</unclear> ein guot <unclear cert="medium" resp="#joint">Eydtgnoeßisch</unclear> <unclear cert="medium" resp="#joint">uffsehen</unclear> uff üch und uff <unclear cert="low" resp="#joint">fürfall</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">ende</unclear> <unclear cert="low" resp="#joint">not</unclear> <unclear cert="low" resp="#joint">und</unclear> trostlichen <unclear cert="medium" resp="#joint">bysprung</unclear> fründtlich <unclear cert="medium" resp="#joint">ersuochend</unclear>,
<lb n="9"/>das habend <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">üwerem</unclear> schryben und <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">byschluß</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>. Worüber <unclear cert="medium" resp="#joint">wir</unclear> uns dann
<lb n="11"/><unclear cert="medium" resp="#joint">zuovorderist</unclear> <unclear cert="medium" resp="#joint">gegen</unclear> <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">unseren</unclear> gethrüwen lieben <unclear cert="medium" resp="#joint">Eydt</unclear>-
<lb n="12"/><unclear cert="medium" resp="#joint">gnoßen</unclear> der communication <unclear cert="medium" resp="#joint">berüerter</unclear> <unclear cert="medium" resp="#joint">avisen</unclear> <unclear cert="medium" resp="#joint">Eydt</unclear>-
<lb n="13"/><unclear cert="medium" resp="#joint">gnoeßisch</unclear> <unclear cert="medium" resp="#joint">bedanckend</unclear>, mit fründtlicher bitt, <unclear cert="medium" resp="#joint">so</unclear> <unclear cert="medium" resp="#joint">uns</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">jennigen</unclear> <unclear cert="medium" resp="#joint">orten</unclear> <unclear cert="medium" resp="#joint">hierinnbe</unclear> <unclear cert="medium" resp="#joint">fehrners</unclear> <unclear cert="medium" resp="#joint">ynlangen</unclear> <unclear cert="medium" resp="#joint">moechte</unclear>,
<lb n="15"/>fürbaß <unclear cert="medium" resp="#joint">wyter</unclear> <unclear cert="medium" resp="#joint">zuoberichten</unclear> <unclear cert="medium" resp="#joint">unbeschwerdt</unclear> <unclear cert="medium" resp="#joint">syn</unclear> <unclear cert="medium" resp="#joint">wellint</unclear>, wie
<lb n="16"/>wir dann <unclear cert="low" resp="#joint">dene</unclear> <unclear cert="low" resp="#joint">hinwiderumb</unclear> <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">halber</unclear> so <unclear cert="medium" resp="#joint">uns</unclear> be-
<lb n="17"/><unclear cert="medium" resp="#joint">richtswürdige</unclear> <unclear cert="medium" resp="#joint">ynkommen</unclear> <unclear cert="medium" resp="#joint">moechte</unclear>, <unclear cert="medium" resp="#joint">ebenermaßen</unclear> <unclear cert="medium" resp="#joint">gegen</unclear> <unclear cert="medium" resp="#joint">üch</unclear>
<lb n="18"/>zethuond <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">guotwillig</unclear> <unclear cert="low" resp="#joint">anerbietend</unclear>. <unclear cert="low" resp="#joint">Und</unclear>
<lb n="19"/>so <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">angedüte</unclear> <unclear cert="medium" resp="#joint">avisen</unclear> auch <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">bedunckens</unclear> in <unclear cert="low" resp="#joint">den</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">wind</unclear> <unclear cert="low" resp="#joint">zeschlachen</unclear> <unclear cert="low" resp="#joint">sonderen</unclear> wol <unclear cert="medium" resp="#joint">ynn</unclear> <unclear cert="medium" resp="#joint">obacht</unclear> <unclear cert="medium" resp="#joint">zenemmen</unclear> sind, ge-
<lb n="21"/><unclear cert="medium" resp="#joint">stalten</unclear> dann <unclear cert="medium" resp="#joint">selbige</unclear> uns <unclear cert="medium" resp="#joint">fürkomender</unclear> maßen durch aller-
<lb n="22"/>hand <unclear cert="low" resp="#joint">umbständ</unclear> <unclear cert="low" resp="#joint">bestetiget</unclear> werden wöllend, als soll
<lb n="23"/>ein <unclear cert="medium" resp="#joint">sölliches</unclear> uns diser <unclear cert="medium" resp="#joint">orten</unclear> <unclear cert="medium" resp="#joint">allersyts</unclear> uff <unclear cert="medium" resp="#joint">sonder</unclear> <unclear cert="medium" resp="#joint">guoter</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">huot</unclear> und <unclear cert="low" resp="#joint">wachsamkeit</unclear> zehalten billich <unclear cert="medium" resp="#joint">verursachen</unclear>,
<lb n="25"/>da wir dann <unclear cert="medium" resp="#joint">hieby</unclear> <unclear cert="medium" resp="#joint">üwer</unclear> <unclear cert="medium" resp="#joint">unserer</unclear> gethrüwen lieben
<lb n="26"/><orgName resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoßen</unclear></orgName> <unclear cert="medium" resp="#joint">begeren</unclear> nach <unclear cert="medium" resp="#joint">keins</unclear> wegs <unclear cert="medium" resp="#joint">ermanglen</unclear> <unclear cert="medium" resp="#joint">werdent</unclear>,
<lb n="27"/>uff üch nit <unclear cert="medium" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">gethrüwes</unclear> <unclear cert="medium" resp="#joint">uffsicht</unclear> zehaben, sondern auch
<pb facs="StadtASG_Missive_2777_10846.jpg" n="2"/>
<lb n="28"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">fahl</unclear> der noth (so <unclear cert="medium" resp="#joint">doch</unclear> der <unclear cert="medium" resp="#joint">guetige</unclear> Gott mit <unclear cert="medium" resp="#joint">gnaden</unclear> ab-
<lb n="29"/><unclear cert="low" resp="#joint">waenden</unclear> <unclear cert="low" resp="#joint">welle</unclear>) <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">beßtmüglicher</unclear> <unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">redlicher</unclear> und <unclear cert="medium" resp="#joint">trost</unclear>-
<lb n="30"/><unclear cert="medium" resp="#joint">licher</unclear> <unclear cert="medium" resp="#joint">beysprung</unclear> <unclear cert="medium" resp="#joint">zethuend</unclear> und üch (<unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">zuo</unclear> unns ver-
<lb n="31"/><unclear cert="low" resp="#joint">sechen</unclear> <unclear cert="low" resp="#joint">soellend</unclear>) <unclear cert="low" resp="#joint">keins</unclear> <unclear cert="low" resp="#joint">waegs</unclear> zelaßen, sonder unns <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">üch</unclear> zu-
<lb n="32"/>verhalten wie es <unclear cert="low" resp="#joint">getrüewen</unclear> <unclear cert="low" resp="#joint">ufrichten</unclear> <unclear cert="low" resp="#joint">eydt</unclear>- und <unclear cert="medium" resp="#joint">Rellig</unclear>-
<lb n="33"/><unclear cert="medium" resp="#joint">ionsgnoßen</unclear> inn <unclear cert="medium" resp="#joint">allwaeg</unclear> <unclear cert="medium" resp="#joint">anstaendig</unclear> ist, alles mit <unclear cert="low" resp="#joint">hilff</unclear> <unclear cert="low" resp="#joint">deß</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">hoechsten</unclear>, inn deßen <unclear cert="medium" resp="#joint">beschirmung</unclear> wir unns <unclear cert="medium" resp="#joint">sambtlich</unclear>
<lb n="35"/><unclear cert="medium" resp="#joint">wol</unclear> empfelchend, <unclear cert="medium" resp="#joint">dato</unclear> den <origDate when="1629-11-04" resp="#ner">4ten Novembris <unclear cert="medium" resp="#joint">ao</unclear>. <unclear cert="medium" resp="#joint">1629</unclear></origDate>.
<lb n="36"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und Rath
