<p>
<pb facs="StadtASG_Missive_2549_9843.jpg" n="1"/>
<lb n="1"/>Unser fründt- nachbarlich willig dienst,
<lb n="2"/>und was wir ehren, liebs und guots ver-
<lb n="3"/>moegendt zuovor, Fromme, Fuersichtige, Er-
<lb n="4"/>same und Weyse, insonders guote Fründt
<lb n="5"/>und <unclear cert="low" resp="#joint">getreüwe</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">Nachbarn</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Was</unclear> <unclear cert="low" resp="#joint">ihr</unclear> zuo gunst eüwer lieben landt-
<lb n="7"/>leüten <persName resp="#ner">Jacob</persName>, <persName resp="#ner">Jerg</persName> und <persName resp="#ner">Larencen</persName> den Schwen-
<lb n="8"/>neren, <unclear cert="low" resp="#joint">weylandt</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">gewestnen</unclear> bur-
<lb n="9"/>gers und <unclear cert="low" resp="#joint">spittelpfründners</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Joß</unclear> <unclear cert="low" resp="#joint">Kuerers</unclear></persName>
<lb n="10"/><unclear cert="low" resp="#joint">s</unclear>: <unclear cert="low" resp="#joint">angemasten</unclear> <unclear cert="low" resp="#joint">erben</unclear>, <unclear cert="low" resp="#joint">vor</unclear> disem fründt-
<lb n="11"/>nachbarlich geschriben und begert, das
<lb n="12"/>habendt wir ablesendt vernomen, auch
<lb n="13"/>hierauff, und deroselben abgesanten
<lb n="14"/>und <unclear cert="low" resp="#joint">anderer</unclear> <unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">mitterben</unclear> mündtlich
<lb n="15"/>anlangen und ersuochen nicht ermanglet,
<lb n="16"/>gedachts Joß Kuerers s: verlaßenschafft
<lb n="17"/>alles ernsts nachzuoforschen, auch deßwegen
<lb n="18"/>einen unseren burger gar in unser fron-
<lb n="19"/>fest und gefangenschafft zuo legen, ob doch
<lb n="20"/>etwas zuo erkundigen und <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">finden</unclear> <unclear cert="low" resp="#joint">sin</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">moechte</unclear>, aber anders nichts in erfahrung
<lb n="22"/>bringen <unclear cert="low" resp="#joint">koennen</unclear>, <unclear cert="low" resp="#joint">welche</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">spitel</unclear>-
<lb n="23"/><unclear cert="low" resp="#joint">woelblin</unclear> <unclear cert="low" resp="#joint">gh</unclear>: dann das ein frauw
<lb n="24"/>allhie, <unclear cert="low" resp="#joint">ohnwissendt</unclear> <unclear cert="low" resp="#joint">ihres</unclear> <unclear cert="low" resp="#joint">ehemans</unclear>, <unclear cert="low" resp="#joint">ihme</unclear>
<pb facs="StadtASG_Missive_2549_9844.jpg" n="2"/>
<lb n="25"/><persName resp="#ner"><unclear cert="low" resp="#joint">Josen</unclear> <unclear cert="low" resp="#joint">s</unclear>.</persName> als sie ein hochzeiterin gewest,
<lb n="26"/>etwas lohns schuldig worden, und das
<lb n="27"/>under dem praetext, als <unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">vatter</unclear> <unclear cert="low" resp="#joint">s</unclear>.
<lb n="28"/>ihro das iehnige, was sie entlehnet, weliches
<lb n="29"/>dann <unclear cert="low" resp="#joint">mehrentheils</unclear> deß <unclear cert="low" resp="#joint">vatters</unclear> <unclear cert="low" resp="#joint">kleider</unclear>,
<lb n="30"/><unclear cert="low" resp="#joint">lohne</unclear> sein solle, zur heüratgut gegeben,
<lb n="31"/>warumb sie dann <unclear cert="low" resp="#joint">wol</unclear> von ihme <persName resp="#ner">Josen s.</persName>
<lb n="32"/>zue andernmahl für unser Statt gricht
<lb n="33"/>gerechtet, und <unclear cert="low" resp="#joint">endtlich</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">dann</unclear> gedachter
<lb n="34"/><unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">vatter</unclear> <unclear cert="low" resp="#joint">s</unclear>. <unclear cert="low" resp="#joint">todts</unclear> <unclear cert="low" resp="#joint">verblichen</unclear> <unclear cert="low" resp="#joint">gewest</unclear>, für
<lb n="35"/>uns remittiert, aber <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">mehrgedachtem</unclear>
<lb n="36"/><persName resp="#ner"><unclear cert="low" resp="#joint">Josen</unclear> <unclear cert="low" resp="#joint">s</unclear>.</persName> der <unclear cert="low" resp="#joint">sach</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">nachgesetzt</unclear>, noch
<lb n="37"/>iemahlen vor uns klagt worden. Also
<lb n="38"/>das es auch nicht so gar gewiß mit der-
<lb n="39"/>selben schuldt ist.
<lb n="40"/><unclear cert="low" resp="#joint">Dieweil</unclear> dann die sach dergestalt bschaffen.
<lb n="41"/>daß gedachter <persName resp="#ner">Claeußlin Thürn s.</persName> mehr
<lb n="42"/>schuldig, <unclear cert="low" resp="#joint">weder</unclear> <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">haab</unclear> <unclear cert="low" resp="#joint">erloest</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">gehußet</unclear> <unclear cert="low" resp="#joint">worden</unclear>, so haben wir <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">guet</unclear>
<lb n="44"/> <unclear cert="low" resp="#joint">vertruwlichen</unclear> <unclear cert="low" resp="#joint">nachburen</unclear> solches <unclear cert="low" resp="#joint">zuo</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">nachrichtung</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">verhalten</unclear> <unclear cert="low" resp="#joint">woellen</unclear>, <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">etwas</unclear>
<lb n="47"/>in <unclear cert="low" resp="#joint">ertheilung</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">urkünden</unclear> <unclear cert="low" resp="#joint">unbstaendig</unclear>
<pb facs="StadtASG_Missive_2549_9845.jpg" n="3"/>
<lb n="48"/><unclear cert="low" resp="#joint">erfolgen</unclear> <unclear cert="low" resp="#joint">woelle</unclear>, <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">demnach</unclear> <unclear cert="low" resp="#joint">selbs</unclear> zu-
<lb n="49"/><unclear cert="low" resp="#joint">versehen</unclear>. Und <unclear cert="low" resp="#joint">verbleiben</unclear> in
<lb n="50"/><unclear cert="low" resp="#joint">sunst</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. und <unclear cert="low" resp="#joint">Fründtsch</unclear>. <unclear cert="low" resp="#joint">zu</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">angenemmen</unclear> <unclear cert="low" resp="#joint">nachbarlichen</unclear> <unclear cert="low" resp="#joint">diensten</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">erbuettig</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">geneigt</unclear>. <unclear cert="low" resp="#joint">Uns</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">sambtlich</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">treuwen</unclear> <unclear cert="low" resp="#joint">schirm</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">wolbevelchende</unclear>. <unclear cert="low" resp="#joint">Datum</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">den</unclear> <origDate when="1621-06-24" resp="#ner"><unclear cert="low" resp="#joint">24</unclear>. <unclear cert="low" resp="#joint">Junij</unclear> <unclear cert="low" resp="#joint">st</unclear>. <unclear cert="low" resp="#joint">n</unclear>. <unclear cert="low" resp="#joint">a°</unclear> <unclear cert="low" resp="#joint">1621</unclear></origDate>.
<lb n="56"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">B</unclear>. <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Rhatt</unclear></orgName>.
<lb n="57"/><unclear cert="low" resp="#joint">An</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Reg</unclear>. <orgName ref="stadtasg-actors-506" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Ldtamman</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Rhät</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">Abbenzell</unclear></orgName>.
