    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1433_5125.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unßer</unclear> fründtlich nachbuirlich guetwillig
<lb n="2"/>dienst und <unclear cert="low" resp="#joint">gruoß</unclear> <unclear cert="low" resp="#joint">zuvor</unclear> vesten frommen
<lb n="3"/>fürsichtigen <unclear cert="low" resp="#joint">whisen</unclear> sonders <unclear cert="low" resp="#joint">guinstigen</unclear> heren
<lb n="4"/><unclear cert="low" resp="#joint">gueten</unclear> fründen und lieben <unclear cert="medium" resp="#joint">nachbaurn</unclear>,
<lb n="5"/>Was zwüschen <unclear cert="medium" resp="#joint">hern</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Zacharias</unclear> <unclear cert="low" resp="#joint">Buirgern</unclear></persName>, und <persName resp="#ner"><unclear cert="medium" resp="#joint">Rudolff</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Crümlern</unclear></persName>, <unclear cert="medium" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">streitigen</unclear> sach wegen, <unclear cert="low" resp="#joint">muind</unclear>
<lb n="7"/>und schrifftlich verhandlet, und <unclear cert="low" resp="#joint">entlich</unclear> uß
<lb n="8"/><unclear cert="low" resp="#joint">eüwern</unclear> <unclear cert="low" resp="#joint">schriben</unclear> verstanden, worauff es
<lb n="9"/><unclear cert="medium" resp="#joint">angesteldt</unclear> <unclear cert="low" resp="#joint">sige</unclear>, oder <unclear cert="low" resp="#joint">erwinden</unclear> solle.
<lb n="10"/>das würdt <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">zomal</unclear>, <unclear cert="low" resp="#joint">best</unclear> selbsten <unclear cert="medium" resp="#joint">inn</unclear>
<lb n="11"/>wüssen sein,
<lb n="12"/><unclear cert="medium" resp="#joint">Under</unclear> <unclear cert="medium" resp="#joint">dißem</unclear> vermerckhen wir, Ihr <unclear cert="medium" resp="#joint">haben</unclear> von
<lb n="13"/><unclear cert="low" resp="#joint">unßern</unclear> abgesandten, <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">sach</unclear> halb <unclear cert="medium" resp="#joint">verstanden</unclear>,
<lb n="14"/>als ob wir <unclear cert="low" resp="#joint">eüch</unclear> die sach heim gesezt haben
<lb n="15"/>sollen, anzusezen, wo <unclear cert="low" resp="#joint">Ihr</unclear> deß <unclear cert="low" resp="#joint">falks</unclear>
<lb n="16"/>rechtlich <unclear cert="low" resp="#joint">zuerörtern</unclear> <unclear cert="low" resp="#joint">ungesuech</unclear> <unclear cert="low" resp="#joint">machen</unclear>,
<lb n="17"/>Weil aber <unclear cert="low" resp="#joint">nu</unclear> solches, <unclear cert="low" resp="#joint">unßer</unclear> meinung nit
<lb n="18"/><unclear cert="low" resp="#joint">geweßen</unclear>, und so es unßer abgesandte
<lb n="19"/>uff <unclear cert="low" resp="#joint">diße</unclear> meinung <unclear cert="medium" resp="#joint">verrichtet</unclear>, ist nit
<lb n="20"/>ein geringer <unclear cert="medium" resp="#joint">mißverstand</unclear> <unclear cert="medium" resp="#joint">darunter</unclear> <unclear cert="medium" resp="#joint">geloffen</unclear>,
<lb n="21"/><unclear cert="medium" resp="#joint">inmaßen</unclear> die abgesandten sich solcher ver-
<lb n="22"/>richtung nit <unclear cert="medium" resp="#joint">erinnern</unclear> <unclear cert="medium" resp="#joint">könden</unclear>,
<lb n="23"/>haben wir <unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="medium" resp="#joint">für</unclear> dißmahl, nit underlaßen
<lb n="24"/><unclear cert="low" resp="#joint">wöllen</unclear>, <unclear cert="low" resp="#joint">eüch</unclear> solchen <unclear cert="medium" resp="#joint">mißverstand</unclear> unßers <unclear cert="low" resp="#joint">theils</unclear>
<pb facs="StadtASG_Missive_1433_5126.jpg" n="2"/>
<lb n="25"/>bei <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">abgewürckten</unclear>, und im <unclear cert="low" resp="#joint">gebeü</unclear>, für <unclear cert="low" resp="#joint">beß</unclear>-
<lb n="26"/>und beßern abgesandte, es es yedoch nit <unclear cert="low" resp="#joint">unser</unclear>,
<lb n="27"/>noch der <unclear cert="low" resp="#joint">abgesandten</unclear> <unclear cert="low" resp="#joint">verstand</unclear> <unclear cert="low" resp="#joint">gewesen</unclear>, die
<lb n="28"/>sach <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">maß</unclear> <unclear cert="low" resp="#joint">anzustellen</unclear>, <unclear cert="low" resp="#joint">notturfftige</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">endtschuldigung</unclear> <unclear cert="low" resp="#joint">fürzuwenden</unclear>,
<lb n="30"/>Und <unclear cert="medium" resp="#joint">seind</unclear> der <unclear cert="medium" resp="#joint">getrösten</unclear> hoffnung, es
<lb n="31"/><unclear cert="low" resp="#joint">werde</unclear> die <unclear cert="low" resp="#joint">zwüschen</unclear> eüch, und <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">uffge</unclear>-
<lb n="32"/>richte <unclear cert="low" resp="#joint">nachbaürliche</unclear> <unclear cert="low" resp="#joint">vergleüchung</unclear>, und
<lb n="33"/>vertrag, inn <unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">weßen</unclear> und <unclear cert="low" resp="#joint">anseh</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">unverletzlich</unclear> <unclear cert="low" resp="#joint">verpleiben</unclear>
<lb n="35"/>Und von eüch <unclear cert="low" resp="#joint">fürgewendter</unclear> <unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">bei</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">gnedigen</unclear> <unclear cert="low" resp="#joint">fürsten</unclear> und herren
<lb n="37"/>her <unclear cert="low" resp="#joint">bischoff</unclear> zue <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Costanz</placeName>, kain andres
<lb n="38"/>nit <unclear cert="low" resp="#joint">eründen</unclear> werden sein,
<lb n="39"/>Wie es aber im <unclear cert="low" resp="#joint">besten</unclear>, und <unclear cert="low" resp="#joint">dergleüch</unclear> <unclear cert="low" resp="#joint">solches</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">verstanden</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">solte</unclear>, da ihr es
<lb n="41"/>anderst dan wir vermainend, main
<lb n="42"/>solt, alde er anstande an sein uff zü-
<lb n="43"/>laüff. Wöllend wir, erst ange-
<lb n="44"/>zelter maßen unsre erkleung gethue
<lb n="45"/>und <unclear cert="low" resp="#joint">beweüß</unclear> <unclear cert="low" resp="#joint">zethuen</unclear>, <unclear cert="low" resp="#joint">unß</unclear> die <unclear cert="low" resp="#joint">noturfft</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wir</unclear> eüch <unclear cert="low" resp="#joint">wölches</unclear> <unclear cert="low" resp="#joint">hinin</unclear> handlen
<lb n="47"/><unclear cert="low" resp="#joint">laßend</unclear>, <unclear cert="low" resp="#joint">vorbehalten</unclear> haben.
<lb n="48"/>Unß versehend ihr werden kains andern, nit
<pb facs="StadtASG_Missive_1433_5127.jpg" n="3"/>
<lb n="49"/>gedacht, <unclear cert="medium" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">gesinnet</unclear> sein, <unclear cert="medium" resp="#joint">und</unclear> solch unser
<lb n="50"/><unclear cert="medium" resp="#joint">endtschuldigung</unclear> im besten vermerckhen
<lb n="51"/><unclear cert="low" resp="#joint">Freünd</unclear> und <unclear cert="low" resp="#joint">nachberlich</unclear> pittend, ir, <unclear cert="medium" resp="#joint">uns</unclear>
<lb n="52"/>hierüber <unclear cert="low" resp="#joint">eüwere</unclear> meinung <unclear cert="low" resp="#joint">schriftlich</unclear> ver-
<lb n="53"/><unclear cert="low" resp="#joint">stendigen</unclear> <unclear cert="low" resp="#joint">wöllen</unclear>
<lb n="54"/>Das begeren wir aller <unclear cert="low" resp="#joint">freünd</unclear>, und nach-
<lb n="55"/>berschafft halb, <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">anderst</unclear> als <unclear cert="medium" resp="#joint">bisher</unclear>.
<lb n="56"/><unclear cert="low" resp="#joint">guettwillig</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">verdienen</unclear>
<lb n="57"/><unclear cert="medium" resp="#joint">Actum</unclear> <origDate resp="#ner">30 junii <unclear cert="low" resp="#joint">a°</unclear> 603</origDate>.
<lb n="58"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Aman</unclear>, und rath
<lb n="59"/><unclear cert="medium" resp="#joint">der</unclear> statt <unclear cert="low" resp="#joint">Arben</unclear></orgName>.
<pb facs="StadtASG_Missive_1433_5128.jpg" n="4"/>
<lb n="60"/>Denen edlen vesten frommen fürsichtigen unnd
<lb n="61"/><unclear cert="medium" resp="#joint">weisen</unclear> <unclear cert="low" resp="#joint">hern</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> und <unclear cert="medium" resp="#joint">Raath</unclear>
<lb n="62"/>der statt Sanct Gallen</orgName> <unclear cert="medium" resp="#joint">unsern</unclear> sonders
<lb n="63"/>günstigen lieben <unclear cert="low" resp="#joint">hern</unclear> guotten fründen
<lb n="64"/>und <unclear cert="low" resp="#joint">nachburn</unclear>,
</p>
