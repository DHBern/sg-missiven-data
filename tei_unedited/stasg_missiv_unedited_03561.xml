<lb n="22"/><unclear cert="medium" resp="#joint">lÿb</unclear> und <unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">zubegeben</unclear> haben, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">welcher</unclear>
