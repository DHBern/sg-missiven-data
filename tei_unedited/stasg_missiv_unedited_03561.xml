<lb n="30"/><unclear cert="low" resp="#joint">hafft</unclear> machen und <unclear cert="medium" resp="#joint">bÿnebents</unclear> <unclear cert="medium" resp="#joint">Eÿdtgnoßisch</unclear> <unclear cert="medium" resp="#joint">ersuechen</unclear>
