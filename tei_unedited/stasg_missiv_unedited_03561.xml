<p>
<pb facs="StadtASG_Missive_3561_14209.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freündtlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear>, sampt <unclear cert="medium" resp="#joint">waß</unclear> wir
<lb n="2"/><unclear cert="medium" resp="#joint">ehren</unclear> liebs und <unclear cert="medium" resp="#joint">guets</unclear> vermögend <unclear cert="medium" resp="#joint">zuvor</unclear>, Fromm,
<lb n="3"/>Fürsichtig, <unclear cert="medium" resp="#joint">Ehrsam</unclear>, <unclear cert="medium" resp="#joint">wyß</unclear>, Innsonders <unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">freündt</unclear>
<lb n="4"/>und <unclear cert="medium" resp="#joint">getreüw</unclear> lieb <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoßen</unclear></orgName>.
<lb n="5"/>Nachdem wir <unclear cert="medium" resp="#joint">uß</unclear> der relation <unclear cert="medium" resp="#joint">unßerer</unclear> uff
<lb n="6"/><unclear cert="low" resp="#joint">Jüngst</unclear> <unclear cert="low" resp="#joint">Badischer</unclear> <unclear cert="low" resp="#joint">Jahr</unclear> <unclear cert="low" resp="#joint">rechnung</unclear> <unclear cert="low" resp="#joint">gehapter</unclear> <unclear cert="low" resp="#joint">Eheren</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">gesandten</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear> <unclear cert="low" resp="#joint">müeßen</unclear>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">maßen</unclear>
<lb n="8"/>der <unclear cert="low" resp="#joint">freÿe</unclear> und unverhinderliche <unclear cert="medium" resp="#joint">wandle</unclear> <unclear cert="medium" resp="#joint">unßer</unclear>
<lb n="9"/>der <unclear cert="medium" resp="#joint">Evangelischen</unclear> <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eÿdtgnoßen</unclear></orgName>, <unclear cert="medium" resp="#joint">Jm</unclear> <unclear cert="medium" resp="#joint">Meiländisch</unclear>-
<lb n="10"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="medium" resp="#joint">Stado</unclear> <unclear cert="medium" resp="#joint">ungeachtet</unclear> <unclear cert="medium" resp="#joint">angewändter</unclear> <unclear cert="medium" resp="#joint">müheÿ</unclear> <unclear cert="medium" resp="#joint">und</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">gebruchter</unclear> <unclear cert="medium" resp="#joint">mitlen</unclear> <unclear cert="medium" resp="#joint">bißher</unclear> nit erlangt <unclear cert="medium" resp="#joint">werden</unclear>
<lb n="12"/>mögen, hat es <unclear cert="medium" resp="#joint">unß</unclear> nit <unclear cert="low" resp="#joint">unziptig</unclear> <unclear cert="low" resp="#joint">verursacht</unclear>
<lb n="13"/>daß billiche <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">rächt</unclear> <unclear cert="low" resp="#joint">nunmehr</unclear> auch an
<lb n="14"/>die hand <unclear cert="low" resp="#joint">zenemmen</unclear>, und habend <unclear cert="medium" resp="#joint">derowägen</unclear> <unclear cert="medium" resp="#joint">uff</unclear>
<lb n="15"/>den <unclear cert="medium" resp="#joint">Jehnigen</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Meiländeren</unclear></placeName>, so <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">mahlen</unclear> <unclear cert="low" resp="#joint">Jnn</unclear> <unclear cert="low" resp="#joint">unß</unclear>-
<lb n="16"/>er Statt sich <unclear cert="low" resp="#joint">befinden</unclear>, <unclear cert="low" resp="#joint">unßere</unclear> meinung <unclear cert="medium" resp="#joint">albereit</unclear>
