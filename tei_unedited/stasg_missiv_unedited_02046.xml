    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2046_7659.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig dienst und gruoß, zuvor,
<lb n="2"/>Ehrwürdiger Edler und <unclear cert="low" resp="#joint">Hochgelehrter</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">lieber</unclear> <unclear cert="low" resp="#joint">Herr</unclear> und Freünd.
<lb n="4"/>Uff deß hochwürdigen Fürsten und Herren,
<lb n="5"/>herren <persName resp="#ner">Jacoben Bischoffen zuo Costantz</persName>, herren
<lb n="6"/>der <placeName ref="stadtasg-places-183" cert="medium" resp="#ner">Reichenauw</placeName> und <placeName ref="stadtasg-places-270" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Oeningen</unclear></placeName> <unclear cert="low" resp="#joint">unsers</unclear>
<lb n="7"/>gnedigen Herren, jüngstervolgten bevelch,
<lb n="8"/>hetten wir unß versehen, man hette mit
<lb n="9"/><persName resp="#ner">Jörg Herren von Riggig</persName> wider unser
<lb n="10"/>burgerin <persName resp="#ner">Barbara Schlumpfin</persName> für-
<lb n="11"/>genomnem unformlichem Process still-
<lb n="12"/>stand gehalten. Dieweil aber
<lb n="13"/>diß nit geschicht, und <unclear cert="low" resp="#joint">unangesechen</unclear> (daß
<lb n="14"/>wir dem Landtvogt im <placeName ref="stadtasg-places-64" cert="medium" resp="#ner">Reintal</placeName> sein Maximam
<lb n="15"/>negieren, vil <unclear cert="low" resp="#joint">weniger</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ehrw</unclear>. gestendig sind,
<lb n="16"/>daß sie <unclear cert="low" resp="#joint">gemelte</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">burgerin</unclear>
<lb n="17"/>für <unclear cert="low" resp="#joint">eüwer</unclear> geistlich Gricht weder
<lb n="18"/>zuo citieren noch wider sie procedieren zuo-
<lb n="19"/>lassen einigen weg befüegt seyen)
<lb n="20"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">proceß</unclear> <unclear cert="low" resp="#joint">weiter</unclear> <unclear cert="low" resp="#joint">wil</unclear> <unclear cert="low" resp="#joint">fürgenommen</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">werden</unclear>. So haben wir zeigern diß
<lb n="22"/>unserm Stattschreiber uferlegt, E. Ehrw.
<lb n="23"/>unsern deßhalb <unclear cert="low" resp="#joint">gefaßten</unclear> <unclear cert="low" resp="#joint">entschluß</unclear> <unclear cert="low" resp="#joint">ferner</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">zeeröffnen</unclear>, den E. Ehrw. von unß und
<lb n="25"/>ihm in unguotem nit wöllen vermerckhen.
<lb n="26"/>Datum den <origDate when="1617-05-23" resp="#ner">13. <unclear cert="low" resp="#joint">23</unclear>. <unclear cert="low" resp="#joint">Maii</unclear> <unclear cert="low" resp="#joint">1617</unclear></origDate>
<lb n="27"/><orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner">B. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">R</unclear>.</orgName>
<lb n="28"/><unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">Ehrwürdigen</unclear> <unclear cert="low" resp="#joint">Edlen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Hochgelehrten</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">Herrn</unclear> <persName role="issuer" resp="#ner">Johann <unclear cert="low" resp="#joint">Haußman</unclear></persName> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Rechten</unclear> <unclear cert="low" resp="#joint">Doctorn</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Bisch</unclear>. <unclear cert="low" resp="#joint">Cost</unclear>. <unclear cert="low" resp="#joint">Raht</unclear>, <unclear cert="low" resp="#joint">Vicario</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Officiali</unclear> <unclear cert="low" resp="#joint">zuo</unclear>
<lb n="31"/><placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Costantz</unclear></placeName>, <unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">Herrn</unclear>.
<lb n="32"/><unclear cert="low" resp="#joint">Costantz</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">an</unclear> h. <persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Johan</unclear></persName> <unclear cert="low" resp="#joint">h</unclear>.
<pb facs="StadtASG_Missive_2046_7660.jpg" n="2"/>
<lb n="34"/><unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">bischoffl</unclear>. <unclear cert="low" resp="#joint">Officialn</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Costantz</unclear></placeName> <unclear cert="low" resp="#joint">hr</unclear>. <unclear cert="low" resp="#joint">Dr</unclear>.
<lb n="35"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Johann</unclear> <unclear cert="low" resp="#joint">Hausmann</unclear></persName>. <unclear cert="low" resp="#joint">1617</unclear>. <unclear cert="low" resp="#joint">13</unclear>. <unclear cert="low" resp="#joint">Maii</unclear>.
</p>
