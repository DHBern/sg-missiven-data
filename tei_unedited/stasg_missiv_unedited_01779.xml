<lb n="28"/>desto geneigter sein werden. <unclear cert="medium" resp="#joint">Do</unclear> <unclear cert="medium" resp="#joint">dan</unclear> wir
<lb n="29"/><unclear cert="low" resp="#joint">ihnen</unclear> <unclear cert="low" resp="#joint">uuf</unclear> begebenheit, widerumb <unclear cert="medium" resp="#joint">eher</unclear>, <unclear cert="medium" resp="#joint">freünd</unclear>-
