<lb n="61"/><unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">geduldt</unclear>, unnd <unclear cert="low" resp="#joint">daß</unclear> wir <unclear cert="low" resp="#joint">diseer</unclear> <unclear cert="low" resp="#joint">summa</unclear> <unclear cert="low" resp="#joint">nun</unclear>
