<p>
<pb facs="StadtASG_Missive_1779_6567.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freundtliche</unclear> <unclear cert="low" resp="#joint">willige</unclear> <unclear cert="low" resp="#joint">dienst</unclear> unnd <unclear cert="medium" resp="#joint">was</unclear> <unclear cert="medium" resp="#joint">wir</unclear>
<lb n="2"/>ehren liebs unnd <unclear cert="medium" resp="#joint">guots</unclear> vermoegend, <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">Wolg</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">eacht</unclear>, <unclear cert="low" resp="#joint">Edel</unclear>, <unclear cert="low" resp="#joint">Vest</unclear>, Fuersichtig, <unclear cert="low" resp="#joint">Eersam</unclear>, weiß, sonders
<lb n="4"/><unclear cert="medium" resp="#joint">liebe</unclear> Herren unnd <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">Freünd</unclear>.
<lb n="5"/>Nachdem dieselben <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">zühanden</unclear> <unclear cert="medium" resp="#joint">gmeiner</unclear> unser
<lb n="6"/>statt, <unclear cert="low" resp="#joint">bej</unclear> den <unclear cert="medium" resp="#joint">Jhnen</unclear> <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">Jhren</unclear> <unclear cert="medium" resp="#joint">vorgestrekten</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">viertausend</unclear> <unclear cert="medium" resp="#joint">sonnenkronen</unclear>, <unclear cert="medium" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">abledigunng</unclear>
