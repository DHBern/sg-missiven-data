<lb n="11"/><unclear cert="low" resp="#joint">den</unclear></date> <unclear cert="low" resp="#joint">ersten</unclear> <unclear cert="low" resp="#joint">Junii</unclear> diß Jars verfallnen <unclear cert="low" resp="#joint">zinß</unclear>, <unclear cert="low" resp="#joint">züthun</unclear> schuldig ver-
<lb n="12"/><unclear cert="low" resp="#joint">bleiben</unclear>, haben wir unseren <unclear cert="low" resp="#joint">getreüwen</unclear> lieben
<lb n="13"/>mitburger <persName resp="#ner">Christoph <unclear cert="medium" resp="#joint">Sallenmueller</unclear></persName> <unclear cert="medium" resp="#joint">zeigern</unclear> diß
