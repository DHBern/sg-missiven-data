    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2040_7621.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edel</unclear>, <unclear cert="low" resp="#joint">ernvest</unclear>, <unclear cert="low" resp="#joint">from</unclear>, <unclear cert="low" resp="#joint">vest</unclear>, <unclear cert="low" resp="#joint">fuersichtig</unclear>, <unclear cert="low" resp="#joint">ersam</unclear> und
<lb n="2"/>weiße, besonders liebe herren, guete freuend und
<lb n="3"/>nachbarn, den selben <unclear cert="low" resp="#joint">seigen</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">freuendtnachbar</unclear>-
<lb n="4"/>lich dienst und gruoß zuvor.
<lb n="5"/>Wir sollen den herren nicht verhalten, wie daß ver-
<lb n="6"/>schinen freitag abentß, einer, wegen ungepürlichen
<lb n="7"/>reden und darauß geschöpften argwons, bej unß
<lb n="8"/>in verhaft genomen worden, und alß wir jne
<lb n="9"/>notturftiglich examiniert, hat er ußgeben, er
<lb n="10"/>heiß <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Waehlicher</unclear></persName>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Margrafen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">land</unclear></placeName> <unclear cert="low" resp="#joint">bej</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Haußach</unclear></placeName> <unclear cert="low" resp="#joint">einem</unclear> <unclear cert="low" resp="#joint">Marcktflecken</unclear> <unclear cert="low" resp="#joint">gepürtig</unclear>,
<lb n="12"/>und <unclear cert="low" resp="#joint">zue</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Landeck</unclear></placeName> ein halb stund <unclear cert="low" resp="#joint">darvon</unclear> <unclear cert="low" resp="#joint">seig</unclear> er
<lb n="13"/><unclear cert="low" resp="#joint">burger</unclear>, <unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">alters</unclear> <unclear cert="low" resp="#joint">bej</unclear> <unclear cert="low" resp="#joint">33</unclear>. <unclear cert="low" resp="#joint">jaren</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">weilen</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">nun</unclear> mehr in 2. jaren nie daheimbsch, sonder
<lb n="15"/>hin und wider, sonderlich in dem <placeName resp="#ner"><unclear cert="low" resp="#joint">Schweitzer</unclear>-
<lb n="16"/>land</placeName> und <unclear cert="low" resp="#joint">letstlichen</unclear> zue <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sanct Gallen</placeName> sich <unclear cert="low" resp="#joint">uffge</unclear>-
<lb n="17"/>halten, hab er (weilen er seines handtwerckhs
<lb n="18"/>ein heftemacher seig) bei <persName resp="#ner"><unclear cert="low" resp="#joint">Balthasar</unclear> <unclear cert="low" resp="#joint">Stauder</unclear></persName>
<lb n="19"/>zue bemeltem <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sanct Gallen</placeName> <unclear cert="low" resp="#joint">gewerchet</unclear>, darnach
<lb n="20"/>sich ein guete zeit in <unclear cert="low" resp="#joint">ainem</unclear> <unclear cert="low" resp="#joint">wirtshauß</unclear> <unclear cert="low" resp="#joint">uff</unclear> sein
<lb n="21"/><unclear cert="low" resp="#joint">pfenning</unclear> <unclear cert="low" resp="#joint">uffgehalten</unclear>, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">wirt</unclear> <unclear cert="low" resp="#joint">heiße</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Othm</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">mar</unclear> <unclear cert="low" resp="#joint">Spieß</unclear></persName>: So hab er auch <unclear cert="low" resp="#joint">allda</unclear>, <unclear cert="low" resp="#joint">einen</unclear>,
<lb n="23"/><persName resp="#ner"><unclear cert="low" resp="#joint">Adam</unclear> <unclear cert="low" resp="#joint">Wecker</unclear></persName> <unclear cert="low" resp="#joint">genant</unclear> (so under <unclear cert="low" resp="#joint">daß</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">wirtshauß</unclear> gehörig sein solle) daß handtwerckh
<lb n="25"/>aber nit gar: und sein weib nadel zue-
<lb n="26"/>machen gelehrnet, etc. Mit fernerm begeren,
<lb n="27"/>daß man der enden, <unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">ehrlichen</unclear> <unclear cert="low" resp="#joint">handelß</unclear>
<pb facs="StadtASG_Missive_2040_7622.jpg" n="2"/>
<lb n="28"/>und wandels und <unclear cert="low" resp="#joint">ufrichtigen</unclear> <unclear cert="low" resp="#joint">verhaltens</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">gnuogsamen</unclear> <unclear cert="low" resp="#joint">bricht</unclear> <unclear cert="low" resp="#joint">werde</unclear> <unclear cert="low" resp="#joint">künnden</unclear> <unclear cert="low" resp="#joint">bfinden</unclear>.
<lb n="30"/><unclear cert="low" resp="#joint">Dhweyl</unclear> <unclear cert="low" resp="#joint">wir</unclear> dann <unclear cert="low" resp="#joint">eigentlichen</unclear> und <unclear cert="low" resp="#joint">warhafften</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">bricht</unclear> der <unclear cert="low" resp="#joint">warheit</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">stür</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">gerechtigkeit</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">jrig</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">unschuldigen</unclear>
<lb n="33"/>aber <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">sinig</unclear> <unclear cert="low" resp="#joint">bschehe</unclear>, <unclear cert="low" resp="#joint">hochnotwendig</unclear>,
<lb n="34"/><unclear cert="low" resp="#joint">demnach</unclear> gelangt <unclear cert="low" resp="#joint">an</unclear> E. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="35"/>unser dienstfrüntt- und nachbarlich Er-
<lb n="36"/>suochen und bitt, die <unclear cert="low" resp="#joint">welle</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">stür</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">warheit</unclear> <unclear cert="low" resp="#joint">obangezogne</unclear> <unclear cert="low" resp="#joint">beede</unclear> <unclear cert="low" resp="#joint">klag</unclear>, die <unclear cert="low" resp="#joint">er</unclear>-
<lb n="38"/><unclear cert="low" resp="#joint">nante</unclear> <unclear cert="low" resp="#joint">personen</unclear> <unclear cert="low" resp="#joint">allererst</unclear> <unclear cert="low" resp="#joint">berüeren</unclear>, <unclear cert="low" resp="#joint">deß</unclear>-
<lb n="39"/>und aber die klag bißharo verschlossen über-
<lb n="40"/>senden. Sölches wie es sich in <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">glichen</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">fälen</unclear> <unclear cert="low" resp="#joint">gezymbt</unclear>, <unclear cert="low" resp="#joint">sind</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">umb</unclear> die <unclear cert="low" resp="#joint">herren</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">früntt</unclear> <unclear cert="low" resp="#joint">nachbarlich</unclear> <unclear cert="low" resp="#joint">zebeschulden</unclear> <unclear cert="low" resp="#joint">erbuettig</unclear>.
<lb n="43"/><unclear cert="low" resp="#joint">Unß</unclear> <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">sitts</unclear> <unclear cert="low" resp="#joint">göttlicher</unclear> <unclear cert="low" resp="#joint">allmacht</unclear> be-
<lb n="44"/>felende. Datum den <origDate when="1617-02-19" resp="#ner">19. Februarij a° 1617</origDate>.
<lb n="45"/><orgName role="issuer" resp="#ner">Stataman und Rhat
<lb n="46"/>der Statt Veltkirch</orgName>.
<pb facs="StadtASG_Missive_2040_7623.jpg" n="3"/>
<pb facs="StadtASG_Missive_2040_7624.jpg" n="4"/>
<lb n="47"/>Den <unclear cert="low" resp="#joint">edlen</unclear>, <unclear cert="low" resp="#joint">ehrnvesten</unclear>, fürsichtigen, <unclear cert="low" resp="#joint">er</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">samen</unclear> und weysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister und
<lb n="49"/>rhat der statt Sanct Gallen</orgName>, unsern
<lb n="50"/>besonders lieben <unclear cert="low" resp="#joint">herren</unclear>, <unclear cert="low" resp="#joint">guoten</unclear> freünden <unclear cert="low" resp="#joint">und</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">nachbaurn</unclear>.
<lb n="52"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sanct</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
