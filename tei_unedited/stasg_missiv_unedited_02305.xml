<lb n="28"/><unclear cert="medium" resp="#joint">bißharo</unclear> <unclear cert="medium" resp="#joint">erhaltnen</unclear> <unclear cert="medium" resp="#joint">ehren</unclear> unnd guoten <unclear cert="medium" resp="#joint">namens</unclear> <unclear cert="medium" resp="#joint">notturfft</unclear>
