<lb n="30"/><unclear cert="medium" resp="#joint">oberkeitliche</unclear> <unclear cert="medium" resp="#joint">pflicht</unclear> unnd die billigkeit <unclear cert="medium" resp="#joint">erforderet</unclear>,
