<lb n="20"/>und <unclear cert="low" resp="#joint">fürderlich</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">verhelffen</unclear>, sonderb.
<lb n="21"/>gnedig gewogen, und geneigt sein <unclear cert="low" resp="#joint">wißendt</unclear>
<lb n="22"/>so <unclear cert="low" resp="#joint">habendt</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">jedoch</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">unsren</unclear> <unclear cert="low" resp="#joint">hochen</unclear>
