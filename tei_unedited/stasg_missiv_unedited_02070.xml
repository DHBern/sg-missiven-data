<p>
<pb facs="StadtASG_Missive_2070_7745.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Hochwuerdig</unclear> <unclear cert="low" resp="#joint">Hochgebornner</unclear> <unclear cert="low" resp="#joint">Fuerst</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">gnediger</unclear> <unclear cert="low" resp="#joint">Herr</unclear> und <unclear cert="low" resp="#joint">Nachbar</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Fg</unclear>.
<lb n="3"/><unclear cert="low" resp="#joint">seyen</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">nachbarlich</unclear> <unclear cert="low" resp="#joint">ganz</unclear> <unclear cert="low" resp="#joint">geneigt</unclear>
<lb n="4"/>und <unclear cert="low" resp="#joint">guetwillige</unclear> dienst, und was wir
<lb n="5"/>ehren liebs und guets vermoegendt, zuvor.
<lb n="6"/>Was an uns etliche unsere getreue
<lb n="7"/>liebe mitburger, wegen ihrer und
<lb n="8"/><unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">vogtsverwandten</unclear>, an <unclear cert="low" resp="#joint">weilundt</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">hern</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Geörgen</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Rait</unclear></persName>, <unclear cert="low" resp="#joint">gewesnen</unclear> <unclear cert="low" resp="#joint">Fuerstl</unclear>.
<lb n="10"/><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallischen</unclear> <unclear cert="low" resp="#joint">obervogts</unclear> <unclear cert="low" resp="#joint">ze</unclear> <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Roschach</unclear></placeName>, und
<lb n="11"/><unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">Sohns</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Philipp</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Rait</unclear></persName> <unclear cert="low" resp="#joint">haab</unclear> und guet,
<lb n="12"/>habenden schuldtforderungen, gehorsamlich
<lb n="13"/><unclear cert="low" resp="#joint">hinderlassnen</unclear>
<lb n="14"/>gelangen lassen, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">habendt</unclear> <unclear cert="low" resp="#joint">E</unclear>.
<lb n="15"/><unclear cert="low" resp="#joint">Fg</unclear>. <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">hiebeyligender</unclear> <unclear cert="low" resp="#joint">Ihrer</unclear> uns
<lb n="16"/>deßhalben ueberreichten supplication mehrern
<lb n="17"/>inhalts gnedig zuvernemmen.
<lb n="18"/>Und <unclear cert="low" resp="#joint">obwohlen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Fg</unclear>. <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">daß</unclear>
