<lb n="60"/><unclear cert="low" resp="#joint">dri</unclear> <unclear cert="low" resp="#joint">batzen</unclear> und <unclear cert="low" resp="#joint">Eüwern</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">stüwrn</unclear> <unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="low" resp="#joint">sollen</unclear>.
