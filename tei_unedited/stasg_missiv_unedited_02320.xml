        <body>
<p>
<pb facs="StadtASG_Missive_2320_8853.jpg" n="1"/>
<lb n="1"/>St. g. fl. Unser freündt, nachbarliche willig dienst,
<lb n="2"/>und waß wir ehren liebs und guets Ver,
<lb n="3"/>moegendt, zuvor. Fromme, Fürsichtige, Er-
<lb n="4"/>same und Weise, Insonnders guette Freündt
<lb n="5"/>und getreuwe liebe Nachbarn.
<lb n="6"/>Uß derselben Nachbarlichen schreiben, haben
<lb n="7"/>wir ablesend vernommen, waß gstaltn
<lb n="8"/>sie berichtet worden sein sollen, daß die
<lb n="9"/><orgName resp="#ner">Eidtgnoeßischen</orgName> gantz und halbe dickhe von den
<lb n="10"/>unserigen gleichwol außgegeben, und aber
<lb n="11"/>hingegen in dem gesetzten valore nicht mehr
<lb n="12"/>angenommen werden wollen, mit freündt,
<lb n="13"/>nachbarlichem ersuochen dieweilen bei den unsern
<lb n="14"/>Fuergeben gschehen, wir die solche gantze ud halbe
<lb n="15"/>dickhe inen und ußerhalb unserer Statt und
<lb n="16"/>Grichte außtreibendt, dz sie dieselben ouch
<lb n="17"/>abgnoedten moechtn also, biß uff weitere Vglich widerumb
<lb n="18"/>annemmen sollendt.
<lb n="19"/>Hieruff koennendt wir E. w. freündt, nach-
<lb n="20"/>barlicher wolmeinung nicht bergen daß
<lb n="21"/>wir unß nicht zuentsinnen, das wir
<lb n="22"/>der Eidtgnoßischen gantz und halben dickhen
<lb n="23"/>wegn eeiniche enderung in unserr Statt
<lb n="24"/>etwas uffs oder endrung fuergenommen, sonnder dieselben sindt
<lb n="25"/>beiden bißhero umb die 20. ud 10 k. geng
<lb n="26"/>ud geb geweßen, wie noch. Allein
<pb facs="StadtASG_Missive_2320_8854.jpg" n="2"/>
<lb n="27"/>nachdem das <unclear cert="low" resp="#joint">silber</unclear> <unclear cert="low" resp="#joint">käm</unclear>, <unclear cert="low" resp="#joint">das</unclear> Ihr ußspargen,
<lb n="28"/>gmein lieb <orgName ref="stadtasg-actors-750" cert="medium" role="recipient" resp="#ner">Eydgnoßen</orgName> und <unclear cert="low" resp="#joint">Nachburen</unclear>, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Statt</unclear>
<lb n="29"/><placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schaffhusen</unclear></placeName>, <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Thaler</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">vier</unclear> <unclear cert="low" resp="#joint">guldi</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">gsezt</unclear>, und <unclear cert="low" resp="#joint">Ihre</unclear> <unclear cert="low" resp="#joint">halbe</unclear> <unclear cert="low" resp="#joint">dicken</unclear> <unclear cert="low" resp="#joint">demselben</unclear>
<lb n="31"/>so der schlag mit den
<lb n="32"/>halben dicken wie die
<lb n="33"/>gantz haben.
<lb n="34"/><unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">ußbringt</unclear> und <unclear cert="low" resp="#joint">Müntzen</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">solle</unclear>.
<lb n="35"/><unclear cert="low" resp="#joint">Haben</unclear> <unclear cert="low" resp="#joint">wir</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">bald</unclear> <unclear cert="low" resp="#joint">dergleichen</unclear> <unclear cert="low" resp="#joint">halben</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">dicken</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">gebraucht</unclear> <unclear cert="low" resp="#joint">worden</unclear>,
<lb n="37"/>(<unclear cert="low" resp="#joint">Inmaßen</unclear> <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">nützer</unclear> <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">ist</unclear>) <unclear cert="low" resp="#joint">solche</unclear> <unclear cert="low" resp="#joint">ungeféhrlich</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">eigner</unclear> <unclear cert="low" resp="#joint">Mißverwaltnus</unclear> <unclear cert="low" resp="#joint">verbieten</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">laßen</unclear>. Und <unclear cert="low" resp="#joint">diewil</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">vilen</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">gering</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">gehalts</unclear> <unclear cert="low" resp="#joint">ußwigt</unclear> <unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="low" resp="#joint">über</unclear> 9 <unclear cert="low" resp="#joint">lot</unclear> <unclear cert="low" resp="#joint">wol</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">befunden</unclear>, <unclear cert="low" resp="#joint">dieselben</unclear> damit der gemeine
<lb n="42"/>Mann (der <unclear cert="low" resp="#joint">underscheid</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Müntz</unclear> <unclear cert="low" resp="#joint">nüt</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">erfahrt</unclear>,) <unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> beschwert werde,
<lb n="44"/>durch ein <unclear cert="low" resp="#joint">offentliches</unclear> <unclear cert="low" resp="#joint">rueff</unclear> <unclear cert="low" resp="#joint">widerum</unclear>,
<lb n="45"/><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">neüwen</unclear> <unclear cert="low" resp="#joint">schafhuseren</unclear> <unclear cert="low" resp="#joint">verbotten</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, die
<lb n="46"/><unclear cert="low" resp="#joint">gantze</unclear>
<lb n="47"/>die <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schafhuser</unclear></placeName> <unclear cert="low" resp="#joint">dicken</unclear> <unclear cert="low" resp="#joint">aber</unclear>, ob glich,
<lb n="48"/>wol dieselben an betrugt geringer
<lb n="49"/>dan vor disen, so haben wirs doch
<lb n="50"/>nüt gar <unclear cert="low" resp="#joint">abgschätzt</unclear>, sonder <unclear cert="low" resp="#joint">allein</unclear>, <unclear cert="low" resp="#joint">9</unclear> <unclear cert="low" resp="#joint">kr</unclear> <unclear cert="low" resp="#joint">1</unclear> <unclear cert="low" resp="#joint">d</unclear>
<lb n="51"/>der schwell <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">vorthäffthaftige</unclear> <unclear cert="low" resp="#joint">Leüt</unclear> <unclear cert="low" resp="#joint">nüt</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">laster</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">ingeschlichen</unclear> <unclear cert="low" resp="#joint">werde</unclear>, <unclear cert="low" resp="#joint">mengklich</unclear> <unclear cert="low" resp="#joint">warnen</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">Und</unclear> wollen wir mit
<lb n="55"/><unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">Gewicht</unclear>, so <unclear cert="low" resp="#joint">neüwern</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">Marckt</unclear> <unclear cert="low" resp="#joint">Schafhuser</unclear> <unclear cert="low" resp="#joint">geschall</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">Machen</unclear>. <unclear cert="low" resp="#joint">Der</unclear> <unclear cert="low" resp="#joint">Gestalten</unclear>
<lb n="58"/>das <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Eüwergen</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">demselben</unclear> <unclear cert="low" resp="#joint">Neüwen</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">dri</unclear> <unclear cert="low" resp="#joint">batzen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Eüwern</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">stüwrn</unclear> <unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="low" resp="#joint">sollen</unclear>.
<lb n="62"/><unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">welchen</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">keim</unclear> <unclear cert="low" resp="#joint">ußwechs</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">5</unclear>. <unclear cert="low" resp="#joint">ß</unclear>. <unclear cert="low" resp="#joint">zu</unclear> geben. <unclear cert="low" resp="#joint">Jedoch</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">anhang</unclear>,
<lb n="64"/><unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">niemands</unclear> <unclear cert="low" resp="#joint">künfftigs</unclear> <unclear cert="low" resp="#joint">gezwungen</unclear>, <unclear cert="low" resp="#joint">sonder</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">menigklichen</unclear> <unclear cert="low" resp="#joint">fry</unclear> <unclear cert="low" resp="#joint">stehn</unclear> <unclear cert="low" resp="#joint">solle</unclear>.
