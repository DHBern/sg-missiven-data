<lb n="44"/><unclear cert="low" resp="#joint">durch</unclear> ein offentliches rueff widerum,
<lb n="45"/>den neüwen schafhuseren verbotten laßen, die
<lb n="46"/><unclear cert="low" resp="#joint">gantze</unclear>
<lb n="47"/>die <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schafhuser</unclear></placeName> <unclear cert="low" resp="#joint">dicken</unclear> aber, ob glich,
<lb n="48"/>wol dieselben an betrugt geringer
<lb n="49"/>dan vor disen, so <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wirs</unclear> doch
<lb n="50"/><unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="medium" resp="#joint">gar</unclear> <unclear cert="low" resp="#joint">abgschätzt</unclear>, sonder allein, <unclear cert="low" resp="#joint">9</unclear> <unclear cert="low" resp="#joint">kr</unclear> <unclear cert="low" resp="#joint">1</unclear> <unclear cert="low" resp="#joint">d</unclear>
<lb n="51"/>der schwell durch vorthäffthaftige Leüt nüt
<lb n="52"/>laster
<lb n="53"/>ingeschlichen werde, <unclear cert="low" resp="#joint">mengklich</unclear> <unclear cert="low" resp="#joint">warnen</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">Und</unclear> wollen wir mit
<lb n="55"/><unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">Gewicht</unclear>, so <unclear cert="low" resp="#joint">neüwern</unclear>
