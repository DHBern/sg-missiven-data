<lb n="2"/>und <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ehren</unclear> liebs und <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">Ver</unclear>,
