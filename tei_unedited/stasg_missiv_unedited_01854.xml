<p>
<pb facs="StadtASG_Missive_1854_6885.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründt</unclear>, <unclear cert="medium" resp="#joint">nachburlich</unclear> willig diennst unnd
<lb n="2"/><unclear cert="low" resp="#joint">gruoß</unclear> zuovor, <unclear cert="low" resp="#joint">Ersamen</unclear>, <unclear cert="low" resp="#joint">fürnemmen</unclear> unnd weisen,
<lb n="3"/>sonders lieben <unclear cert="medium" resp="#joint">herren</unclear> <unclear cert="medium" resp="#joint">guoten</unclear> <unclear cert="medium" resp="#joint">fründt</unclear> und nachbur.
<lb n="4"/>Demnach die <unclear cert="medium" resp="#joint">spännige</unclear> und <unclear cert="medium" resp="#joint">strittige</unclear> <unclear cert="medium" resp="#joint">ehesach</unclear> <unclear cert="medium" resp="#joint">ent</unclear>-
<lb n="5"/><unclear cert="medium" resp="#joint">zwüschet</unclear> dem <unclear cert="low" resp="#joint">üwerigen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jörgen</unclear> <unclear cert="low" resp="#joint">Heren</unclear></persName>, und unser
<lb n="6"/>burgerin <persName resp="#ner">Barbara Heinrich <unclear cert="low" resp="#joint">Schlumpffen</unclear></persName> <unclear cert="low" resp="#joint">ehelicher</unclear>
<lb n="7"/>dochter, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">unsern</unclear> getrüwen lieben eidtgnossen,
<lb n="8"/>der regierenden orthen <placeName resp="#ner">der herrschafft <unclear cert="medium" resp="#joint">Rinekh</unclear></placeName> <unclear cert="medium" resp="#joint">herren</unclear>,
<lb n="9"/>gesandten zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="medium" resp="#joint">verordneten</unclear> <unclear cert="medium" resp="#joint">herren</unclear> <unclear cert="medium" resp="#joint">richtern</unclear>, durch
<lb n="10"/><unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">guetigen</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">by</unclear> <unclear cert="medium" resp="#joint">beden</unclear> <unclear cert="medium" resp="#joint">theilen</unclear> <unclear cert="medium" resp="#joint">angenommnen</unclear>
<lb n="11"/>spruch, hingelegt unnd verglichen, unnd neben
<lb n="12"/><unclear cert="medium" resp="#joint">Richtern</unclear> und <unclear cert="medium" resp="#joint">herren</unclear> <unclear cert="medium" resp="#joint">landtschreibers</unclear> <unclear cert="medium" resp="#joint">taxt</unclear> gebür,
<lb n="13"/>dem <unclear cert="low" resp="#joint">Heren</unclear> an seinem <unclear cert="medium" resp="#joint">erlittenen</unclear> <unclear cert="medium" resp="#joint">costen</unclear> funff-
<lb n="14"/>hundert guldin <unclear cert="medium" resp="#joint">gesprochen</unclear> worden, da-
<lb n="15"/>mit nun der <unclear cert="medium" resp="#joint">Rüter</unclear> nach <unclear cert="low" resp="#joint">lut</unclear> <unclear cert="low" resp="#joint">dß</unclear> spruchs <unclear cert="medium" resp="#joint">befrei</unclear>-
<lb n="16"/><unclear cert="medium" resp="#joint">diget</unclear> werde, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">wöllen</unclear> ihr bey ihme verschaf-
<lb n="17"/>fen, daß er allhie daß <unclear cert="medium" resp="#joint">gelt</unclear> <unclear cert="medium" resp="#joint">erhebe</unclear>, unnd für
<lb n="18"/>alle <unclear cert="low" resp="#joint">ansprach</unclear> so wohl der ehe, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">erlegten</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">gelts</unclear> <unclear cert="low" resp="#joint">halben</unclear>, nach aller <unclear cert="low" resp="#joint">noturfft</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">unserige</unclear> quitire.
<lb n="20"/><unclear cert="medium" resp="#joint">Sidtmaln</unclear> <unclear cert="medium" resp="#joint">weil</unclear> <unclear cert="medium" resp="#joint">vermelter</unclear> <unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">burger</unclear> <persName resp="#ner">Heinrich
<lb n="21"/>Schlumpff</persName>, daß <unclear cert="medium" resp="#joint">hoffs</unclear>, oder <unclear cert="low" resp="#joint">zweier</unclear> <unclear cert="low" resp="#joint">theil</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-295" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Thal</unclear></placeName>
<lb n="22"/>für seine beide <unclear cert="low" resp="#joint">döchtern</unclear>, wie <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">berichtet</unclear>, <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">erkaufft</unclear> haben solle, <unclear cert="low" resp="#joint">solches</unclear> aber ohne <unclear cert="medium" resp="#joint">eüwer</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">alß</unclear> ihrer ordenlichen oberkeit und ober-
<lb n="25"/>vögten consens, wüssen unnd bewilligung <unclear cert="medium" resp="#joint">beschehe</unclear>,
<lb n="26"/><unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">heben</unclear> wir <unclear cert="medium" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">mehrermelter</unclear> <unclear cert="low" resp="#joint">beider</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">döchtern</unclear> <unclear cert="low" resp="#joint">daßselbig</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> auff, und ersuochen <unclear cert="medium" resp="#joint">und</unclear>
<pb facs="StadtASG_Missive_1854_6886.jpg" n="2"/>
<lb n="28"/>bitten <unclear cert="medium" resp="#joint">Eüch</unclear> <unclear cert="medium" resp="#joint">freündnachbarlich</unclear>, unß
<lb n="29"/><unclear cert="medium" resp="#joint">deßweegen</unclear> ein <unclear cert="low" resp="#joint">urkundt</unclear> <unclear cert="low" resp="#joint">zuezeüberschiken</unclear>,
<lb n="30"/>damit <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">künfftig</unclear> <unclear cert="medium" resp="#joint">derglichen</unclear> <unclear cert="medium" resp="#joint">stann</unclear> vermit-
<lb n="31"/>ten bleiben mögen. Daran beschicht <unclear cert="medium" resp="#joint">unß</unclear>,
<lb n="32"/><unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">Eüch</unclear> <unclear cert="medium" resp="#joint">freind</unclear>- <unclear cert="medium" resp="#joint">undt</unclear> <unclear cert="medium" resp="#joint">nachbarlichs</unclear> <unclear cert="medium" resp="#joint">gfallen</unclear>
<lb n="33"/><unclear cert="medium" resp="#joint">denen</unclear> wir zu jeder zeit <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">guter</unclear> nachbarschafft
<lb n="34"/><unclear cert="medium" resp="#joint">freündschafft</unclear> und allen angenemen diensten
<lb n="35"/>wohl gewogen verbleiben, <unclear cert="low" resp="#joint">Lufft</unclear> Gott, <unclear cert="medium" resp="#joint">d</unclear>
<lb n="36"/>halte ob <unclear cert="low" resp="#joint">unß</unclear> allen. Datum den <origDate when="1613-07-13" resp="#ner"><unclear cert="low" resp="#joint">13t</unclear>
<lb n="37"/>Julii <unclear cert="low" resp="#joint">A°</unclear> <unclear cert="low" resp="#joint">etc</unclear> 1613</origDate>.
<lb n="38"/><orgName ref="stadtasg-actors-629" cert="medium" role="issuer" resp="#ner">Statthalter <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">Raht</unclear>
<lb n="39"/>der Statt <unclear cert="medium" resp="#joint">Sanct</unclear> Gallen</orgName>.,.
<pb facs="StadtASG_Missive_1854_6887.jpg" n="3"/>
<pb facs="StadtASG_Missive_1854_6888.jpg" n="4"/>
<lb n="40"/><unclear cert="medium" resp="#joint">Dem</unclear> frommen, ehrenvesten unnd weysen, Vogl
<lb n="41"/><persName role="recipient" resp="#ner">Luxen Riser</persName>, deß rhahts zuo <placeName ref="stadtasg-places-10" cert="medium" resp="#ner">Zug</placeName>, lanndtvogt
<lb n="42"/>im <placeName ref="stadtasg-places-64" cert="medium" resp="#ner">Rhinthal</placeName>, unserm sonders lieben <unclear cert="low" resp="#joint">guoten</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">fruendt</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">nachpuren</unclear>.
</p>
