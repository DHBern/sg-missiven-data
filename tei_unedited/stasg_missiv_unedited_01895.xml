<lb n="7"/><unclear cert="low" resp="#joint">Comuniciert</unclear>, <unclear cert="low" resp="#joint">thünd</unclear> wir <unclear cert="medium" resp="#joint">unns</unclear> gegen üch gantz fründt=
<lb n="8"/>lich <unclear cert="low" resp="#joint">bedancken</unclear>. <unclear cert="low" resp="#joint">Heten</unclear> <unclear cert="low" resp="#joint">moegen</unclear> <unclear cert="low" resp="#joint">lyden</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">der</unclear>
