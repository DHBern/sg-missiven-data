<lb n="17"/><unclear cert="medium" resp="#joint">So</unclear> sollen <unclear cert="medium" resp="#joint">auch</unclear> die 3. <unclear cert="low" resp="#joint">orth</unclear> <placeName ref="stadtasg-places-70" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Uri</unclear></placeName>, <placeName ref="stadtasg-places-287" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schweiz</unclear></placeName>
