<lb n="19"/>statt <placeName ref="stadtasg-places-225" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rappersschwil</unclear></placeName> <unclear cert="low" resp="#joint">gelegt</unclear> haben,
<lb n="20"/><unclear cert="low" resp="#joint">zu</unclear> waß <unclear cert="low" resp="#joint">endt</unclear> <unclear cert="low" resp="#joint">sye</unclear> aber solches <unclear cert="low" resp="#joint">bescheh</unclear>,
<lb n="21"/>ist unß noch unbewußt, im fall
<lb n="22"/>aber wir diß und <unclear cert="medium" resp="#joint">anders</unclear> halben
<lb n="23"/><unclear cert="medium" resp="#joint">weiters</unclear> und <unclear cert="medium" resp="#joint">ferners</unclear> in <unclear cert="low" resp="#joint">erfahrung</unclear>
