<lb n="25"/><unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">unfehlbar</unclear> berichten, <unclear cert="medium" resp="#joint">dan</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">derselben</unclear> <unclear cert="medium" resp="#joint">alte</unclear> <unclear cert="medium" resp="#joint">dahero</unclear> <unclear cert="medium" resp="#joint">erspürte</unclear> <unclear cert="medium" resp="#joint">continuirende</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">guete</unclear> nachbarliche <unclear cert="medium" resp="#joint">vertrauwligkeit</unclear>
<pb facs="StadtASG_Missive_2155_8078.jpg" n="2"/>
