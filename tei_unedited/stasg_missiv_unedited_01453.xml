<lb n="7"/><persName resp="#ner">Lienhardt <unclear cert="medium" resp="#joint">Kellen</unclear></persName>, <unclear cert="medium" resp="#joint">clagendt</unclear> <unclear cert="medium" resp="#joint">fürtragen</unclear> lassen, Nach-
