<lb n="3"/><unclear cert="low" resp="#joint">fürsichtig</unclear> ersam <unclear cert="low" resp="#joint">wyß</unclear>, insonders <unclear cert="low" resp="#joint">guot</unclear> fründt
<lb n="4"/><unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">getrüw</unclear> lieb <orgName resp="#ner">Eydtgnossen</orgName>.
<lb n="5"/><unclear cert="low" resp="#joint">Vor</unclear> <unclear cert="low" resp="#joint">uns</unclear> ist <unclear cert="low" resp="#joint">erschinen</unclear> <unclear cert="low" resp="#joint">euwer</unclear> <unclear cert="low" resp="#joint">lieber</unclear> burger <persName resp="#ner"><unclear cert="medium" resp="#joint">Jacob</unclear>
