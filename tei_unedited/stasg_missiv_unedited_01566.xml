<lb n="40"/>so <unclear cert="medium" resp="#joint">habent</unclear> wir <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">ernstlicher</unclear> betrachtung diß
<lb n="41"/><unclear cert="low" resp="#joint">Pündtnerischen</unclear> gscheffts unnd <unclear cert="low" resp="#joint">gstaltsame</unclear> gegen=
<lb n="42"/><unclear cert="medium" resp="#joint">würtiger</unclear> <unclear cert="low" resp="#joint">züt</unclear>, <unclear cert="medium" resp="#joint">loüffen</unclear> unnd <unclear cert="low" resp="#joint">gfahrligkeit</unclear>, <unclear cert="medium" resp="#joint">dißmalen</unclear>
