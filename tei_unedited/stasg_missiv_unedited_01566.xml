<lb n="25"/><unclear cert="low" resp="#joint">hallten</unclear>. <unclear cert="low" resp="#joint">Unßer</unclear> <unclear cert="low" resp="#joint">Eydtgnoßen</unclear> von <placeName ref="stadtasg-places-73" cert="medium" resp="#ner">Glaruß</placeName>
