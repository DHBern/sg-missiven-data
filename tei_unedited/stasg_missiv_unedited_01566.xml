<lb n="4"/>unnd <unclear cert="low" resp="#joint">getrüw</unclear> lieb <unclear cert="low" resp="#joint">Eydtgnoßen</unclear>. Es
<lb n="5"/>sind uff die <unclear cert="medium" resp="#joint">abscheid</unclear> <unclear cert="low" resp="#joint">jüngstgehalltner</unclear> <unclear cert="low" resp="#joint">Badischer</unclear> tag-
<lb n="6"/><unclear cert="low" resp="#joint">leistung</unclear>, betreffent <unclear cert="low" resp="#joint">unßerer</unclear> Eydt: und <unclear cert="low" resp="#joint">Pündts</unclear>-
