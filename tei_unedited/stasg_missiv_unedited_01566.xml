<lb n="8"/><unclear cert="medium" resp="#joint">zwüschelber</unclear> <unclear cert="medium" resp="#joint">angeschlagenn</unclear> <unclear cert="medium" resp="#joint">kriegischen</unclear> <unclear cert="medium" resp="#joint">ufbruch</unclear>, <unclear cert="medium" resp="#joint">unß</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">dißer</unclear> tagen, nach unnd nach, <unclear cert="low" resp="#joint">iem</unclear> mehr die <unclear cert="low" resp="#joint">stimmen</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">mehrtheils</unclear> Orten und Zugewandten, inkommen,
<lb n="11"/><unclear cert="medium" resp="#joint">welliche</unclear> deß <unclear cert="medium" resp="#joint">mehrentheils</unclear> dahin <unclear cert="low" resp="#joint">lutend</unclear>, wann
<lb n="12"/><unclear cert="low" resp="#joint">älle</unclear> Ort der <unclear cert="low" resp="#joint">Eydtgnoßschafft</unclear> und dero Zugewandte
<lb n="13"/>gemeinlich sich zuo <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">angesehnen</unclear> kriegs <unclear cert="low" resp="#joint">zug</unclear> <unclear cert="low" resp="#joint">ze</unclear> be-
<lb n="14"/>geben gesinnet <unclear cert="low" resp="#joint">sÿgind</unclear>, so wöllind sÿ sich von den
<lb n="15"/>selben nit <unclear cert="low" resp="#joint">absünderen</unclear>. Von <unclear cert="medium" resp="#joint">unßeren</unclear> Eydt-
<lb n="16"/><unclear cert="low" resp="#joint">gnoßen</unclear> zuo <placeName ref="stadtasg-places-70" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Urij</unclear></placeName> habent <unclear cert="low" resp="#joint">wir</unclear> uff <unclear cert="medium" resp="#joint">gestrigen</unclear> abent
<lb n="17"/>ein <unclear cert="medium" resp="#joint">schrÿben</unclear> empfangen, <unclear cert="medium" resp="#joint">darinn</unclear> <unclear cert="medium" resp="#joint">sÿ</unclear> <unclear cert="medium" resp="#joint">ires</unclear> theils
<lb n="18"/><unclear cert="low" resp="#joint">dißeren</unclear> <unclear cert="low" resp="#joint">ufbruch</unclear> <unclear cert="low" resp="#joint">abtschlahend</unclear>, wie ir <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">bÿligender</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">copÿ</unclear> <unclear cert="low" resp="#joint">ires</unclear> <unclear cert="low" resp="#joint">schrÿbens</unclear> <unclear cert="low" resp="#joint">zevernemmen</unclear>. <unclear cert="low" resp="#joint">Unßere</unclear>
