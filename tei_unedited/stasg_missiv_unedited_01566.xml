<lb n="37"/><unclear cert="medium" resp="#joint">gethan</unclear>, unnd denen nach gebür, <unclear cert="medium" resp="#joint">so</unclear> <unclear cert="medium" resp="#joint">vil</unclear> <unclear cert="medium" resp="#joint">menschlich</unclear> und
<lb n="38"/><unclear cert="low" resp="#joint">müglich</unclear>, <unclear cert="low" resp="#joint">wüther</unclear> <unclear cert="low" resp="#joint">gerathen</unclear>, unnd geholfen <unclear cert="medium" resp="#joint">werde</unclear>,
