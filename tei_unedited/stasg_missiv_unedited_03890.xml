<p>
<pb facs="StadtASG_Missive_3890_15699.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unßere</unclear> <unclear cert="medium" resp="#joint">freundtlich</unclear> willige dienst zuvor, Edel, <unclear cert="medium" resp="#joint">Vöst</unclear>, Fürsich-
<lb n="2"/><unclear cert="low" resp="#joint">tig</unclear>, <unclear cert="low" resp="#joint">Ersamb</unclear> und <unclear cert="medium" resp="#joint">Weiße</unclear>, <unclear cert="medium" resp="#joint">inßonders</unclear> liebe <unclear cert="medium" resp="#joint">Herrn</unclear> und <unclear cert="medium" resp="#joint">guote</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">Freündt</unclear>.
<lb n="4"/>Demnach die <unclear cert="low" resp="#joint">kayl</unclear>. <unclear cert="low" resp="#joint">Executions</unclear> <unclear cert="low" resp="#joint">Comission</unclear> <unclear cert="low" resp="#joint">sich</unclear> nunmehr <unclear cert="medium" resp="#joint">täg</unclear>-
<lb n="5"/><unclear cert="medium" resp="#joint">lich</unclear> <unclear cert="medium" resp="#joint">enden</unclear>: und in <unclear cert="low" resp="#joint">kurzem</unclear> <unclear cert="low" resp="#joint">außsondr</unclear> <unclear cert="low" resp="#joint">bräuchern</unclear> möchte,
<lb n="6"/>wir <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">dannenhero</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">baldt</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Whl</unclear>.
<lb n="7"/>in etwas <unclear cert="medium" resp="#joint">vertrösteten</unclear> <unclear cert="medium" resp="#joint">anlehnungsgelltrn</unclear> <unclear cert="medium" resp="#joint">bedörfften</unclear>
<lb n="8"/>werden, <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">wißen</unclear> <unclear cert="medium" resp="#joint">khönden</unclear>.
<lb n="9"/><unclear cert="medium" resp="#joint">Alß</unclear> <unclear cert="medium" resp="#joint">piten</unclear> <unclear cert="medium" resp="#joint">dieselbe</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">hiemit</unclear> ganz <unclear cert="medium" resp="#joint">vleißigest</unclear>, <unclear cert="medium" resp="#joint">Sye</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">unß</unclear> in <unclear cert="medium" resp="#joint">solchen</unclear> <unclear cert="medium" resp="#joint">nöthen</unclear> nicht <unclear cert="medium" resp="#joint">verlaßen</unclear> <unclear cert="medium" resp="#joint">laßen</unclear>: <unclear cert="medium" resp="#joint">sondr</unclear> mit
<lb n="11"/>einem <unclear cert="medium" resp="#joint">ergübigen</unclear> <unclear cert="medium" resp="#joint">anlehen</unclear> <unclear cert="medium" resp="#joint">willfährig</unclear> <unclear cert="medium" resp="#joint">begegnen</unclear>: auch
<lb n="12"/>mit wie <unclear cert="low" resp="#joint">vilen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Whl</unclear>. <unclear cert="low" resp="#joint">unnß</unclear> an <unclear cert="medium" resp="#joint">handen</unclear> zugehen
<lb n="13"/><unclear cert="medium" resp="#joint">entdschloßen</unclear> schrifftlich berichten <unclear cert="medium" resp="#joint">laßen</unclear> <unclear cert="medium" resp="#joint">wolle</unclear>. <unclear cert="medium" resp="#joint">Daran</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">beschicht</unclear> unß, <unclear cert="medium" resp="#joint">neben</unclear> hohem <unclear cert="medium" resp="#joint">favór</unclear>, sonder <unclear cert="medium" resp="#joint">angenemes</unclear>
<lb n="15"/>gefallen, welches wir in <unclear cert="medium" resp="#joint">begebenheiten</unclear> <unclear cert="medium" resp="#joint">danckhbarlich</unclear>
<lb n="16"/>verdienen und <unclear cert="low" resp="#joint">darbej</unclear> <unclear cert="low" resp="#joint">verpleiben</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Whl</unclear>.
<lb n="18"/><unclear cert="low" resp="#joint">dienstwillige</unclear>
<lb n="19"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Bürgermaister</unclear> und Rath der
<lb n="20"/>Statt <unclear cert="low" resp="#joint">Biberach</unclear></orgName>.
<lb n="21"/><unclear cert="low" resp="#joint">Dath</unclear> <origDate when="1649-02-22" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">22</unclear>. <unclear cert="low" resp="#joint">Febr</unclear>. <unclear cert="low" resp="#joint">4</unclear>. <unclear cert="low" resp="#joint">Martij</unclear> <unclear cert="low" resp="#joint">Ao</unclear>. <unclear cert="low" resp="#joint">1649</unclear></origDate>.
