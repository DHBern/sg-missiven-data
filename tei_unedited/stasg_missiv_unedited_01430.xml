<lb n="39"/>des Almechtigen treülich empfelendt.
<lb n="40"/>Geben <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">unserm</unclear> bischofflich schloß
<lb n="41"/><unclear cert="low" resp="#joint">zuo</unclear> <origPlace ref="stadtasg-places-114" cert="medium" resp="#ner">Chur</origPlace> <origDate when="1603-03-12" resp="#ner">den 12. Martij anno 1603</origDate>.
<lb n="42"/><persName role="issuer" resp="#ner">Joannes Eps Curien</persName>. <unclear cert="low" resp="#joint">Mp</unclear>
