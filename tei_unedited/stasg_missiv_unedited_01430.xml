<lb n="30"/><unclear cert="medium" resp="#joint">nehmen</unclear>, <unclear cert="medium" resp="#joint">moegen</unclear> <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">ursprung</unclear> haben,
<lb n="31"/>und gemacht <unclear cert="low" resp="#joint">sin</unclear> worden, <unclear cert="low" resp="#joint">volgendts</unclear> unß
