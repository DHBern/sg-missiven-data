<lb n="152"/>augusti</date> <persName resp="#ner">Andres Wuerttemberger</persName> der
<lb n="153"/>soldner und <persName resp="#ner">Magdalena Pfeifferin</persName> ein
<lb n="154"/>haußfraw haben <unclear cert="low" resp="#joint">tauffen</unclear> <unclear cert="low" resp="#joint">lassen</unclear> <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">sohn</unclear>
