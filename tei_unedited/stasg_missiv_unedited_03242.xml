<lb n="5"/><unclear cert="low" resp="#joint">Rohan</unclear></persName>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">unßere</unclear> <unclear cert="low" resp="#joint">getrüwen</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">Eyd</unclear> und <unclear cert="medium" resp="#joint">Pundts</unclear>-
