<lb n="7"/><unclear cert="medium" resp="#joint">verschinenen</unclear> <unclear cert="medium" resp="#joint">tagen</unclear>, durch <unclear cert="medium" resp="#joint">underschidene</unclear> schryben fründtlichen
<lb n="8"/>recomendiert, <unclear cert="medium" resp="#joint">Wyßern</unclear> <unclear cert="medium" resp="#joint">diß</unclear>, den <persName resp="#ner"><unclear cert="medium" resp="#joint">Hrn</unclear>. de Serres</persName>, einen
<lb n="9"/><unclear cert="medium" resp="#joint">wolerfahrnen</unclear> <unclear cert="medium" resp="#joint">Evangelischen</unclear> <unclear cert="medium" resp="#joint">Frantzoesischen</unclear> <unclear cert="medium" resp="#joint">Ingenieur</unclear>,
<lb n="10"/>mit <unclear cert="low" resp="#joint">vermelden</unclear>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">fürtreffenlicher</unclear> <unclear cert="low" resp="#joint">proben</unclear> er in <unclear cert="medium" resp="#joint">syner</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">kunst</unclear> albereit <unclear cert="medium" resp="#joint">verrichtet</unclear>, und wie <unclear cert="medium" resp="#joint">berüembt</unclear> er sich dar-
<lb n="12"/>durch gemachet habe. <unclear cert="low" resp="#joint">Wanne</unclear> dann wir unß <unclear cert="medium" resp="#joint">zuoer</unclear>-
<lb n="13"/><unclear cert="medium" resp="#joint">inneren</unclear> <unclear cert="medium" resp="#joint">wüssend</unclear>, daß eben diser man <unclear cert="medium" resp="#joint">bereits</unclear> <unclear cert="medium" resp="#joint">in</unclear> <unclear cert="medium" resp="#joint">verschi</unclear>-
