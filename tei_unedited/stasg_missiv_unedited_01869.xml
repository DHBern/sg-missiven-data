<lb n="1"/><unclear cert="low" resp="#joint">Missiv</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">erschynung</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Taglei</unclear>-
<lb n="2"/><unclear cert="low" resp="#joint">stung</unclear>.
<lb n="3"/>Unser <unclear cert="medium" resp="#joint">fründtlich</unclear> willig dienst, und was wir
<lb n="4"/>ehren, liebs und <unclear cert="medium" resp="#joint">guts</unclear> vermögend, <unclear cert="medium" resp="#joint">zuvor</unclear>,
<lb n="5"/><unclear cert="medium" resp="#joint">Frome</unclear>, Fürsichtig, <unclear cert="medium" resp="#joint">Eersam</unclear> <unclear cert="medium" resp="#joint">wyß</unclear>, <unclear cert="medium" resp="#joint">Jnsonders</unclear> <unclear cert="medium" resp="#joint">gut</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">fründ</unclear>, und <unclear cert="medium" resp="#joint">getrüwe</unclear> lieb <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>.
<lb n="7"/><unclear cert="medium" resp="#joint">Jhr</unclear> <unclear cert="medium" resp="#joint">werdend</unclear> <unclear cert="medium" resp="#joint">us</unclear> <unclear cert="medium" resp="#joint">byligender</unclear> <unclear cert="medium" resp="#joint">Copy</unclear> <unclear cert="medium" resp="#joint">verstehen</unclear>,
<lb n="8"/><unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">was</unclear> <unclear cert="medium" resp="#joint">bewegenden</unclear> Ursachen <unclear cert="medium" resp="#joint">uwer</unclear> und
<lb n="9"/><unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">lieb</unclear> <unclear cert="medium" resp="#joint">Eydtgnossen</unclear> <unclear cert="medium" resp="#joint">dero</unclear> <unclear cert="medium" resp="#joint">Siben</unclear> <unclear cert="medium" resp="#joint">Orthen</unclear>, ein
<lb n="10"/><unclear cert="medium" resp="#joint">gemeine</unclear> <unclear cert="medium" resp="#joint">Tagleistung</unclear> gen <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="medium" resp="#joint">ußschrybend</unclear>,
<lb n="11"/>und was sy <unclear cert="medium" resp="#joint">daruber</unclear> an uns begerend. Wie-
<lb n="12"/>wol nun wir <unclear cert="medium" resp="#joint">vermeint</unclear>, die sachen darumb
<lb n="13"/>sy <unclear cert="medium" resp="#joint">disere</unclear> <unclear cert="medium" resp="#joint">Zusamenkunfft</unclear> angesehen, dieselbige
<lb n="14"/>noch nit erforderten. Noch <unclear cert="low" resp="#joint">nut</unclear> <unclear cert="low" resp="#joint">destoweniger</unclear>,
<lb n="15"/>so sind wir <unclear cert="medium" resp="#joint">gesinnet</unclear>, <unclear cert="medium" resp="#joint">sollichen</unclear> Tag durch <unclear cert="medium" resp="#joint">unsere</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">Ragtsbottschafft</unclear> <unclear cert="medium" resp="#joint">zebesuchen</unclear>, und in <unclear cert="medium" resp="#joint">allen</unclear> <unclear cert="medium" resp="#joint">für</unclear>-
<lb n="17"/>fallenden sachen unser <unclear cert="medium" resp="#joint">bestes</unclear> <unclear cert="medium" resp="#joint">zethund</unclear>, und nach
<lb n="18"/><unclear cert="medium" resp="#joint">gebür</unclear> dahin <unclear cert="medium" resp="#joint">handlen</unclear> <unclear cert="medium" resp="#joint">zehelffen</unclear>, damit <unclear cert="medium" resp="#joint">frid</unclear>,
<lb n="19"/><unclear cert="medium" resp="#joint">ruw</unclear>, einigkeit und <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">wolstand</unclear> unser ge-
<lb n="20"/><unclear cert="medium" resp="#joint">liebten</unclear> <unclear cert="medium" resp="#joint">Vatterlandts</unclear> erhalten <unclear cert="medium" resp="#joint">werde</unclear>, Wie
<lb n="21"/>wir <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">nu</unclear>, <unclear cert="low" resp="#joint">sind</unclear>, <unclear cert="low" resp="#joint">glycher</unclear> meinung auch <unclear cert="medium" resp="#joint">syn</unclear>,
<lb n="22"/>und <unclear cert="medium" resp="#joint">deßhalben</unclear> <unclear cert="medium" resp="#joint">zu</unclear> disem Tag (<unclear cert="medium" resp="#joint">den</unclear> wir nach der
<lb n="23"/><unclear cert="medium" resp="#joint">siben</unclear> <unclear cert="medium" resp="#joint">Orthen</unclear> begeren <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">hiemit</unclear> zewüssen <unclear cert="medium" resp="#joint">thund</unclear>.)
