<lb n="1"/><unclear cert="low" resp="#joint">Edlen</unclear> <unclear cert="medium" resp="#joint">Ehrenvesten</unclear>, Frommen, Für=
<lb n="2"/>sichtigen, <unclear cert="medium" resp="#joint">ouch</unclear> <unclear cert="medium" resp="#joint">Ehrsamen</unclear> und Weisen,
<lb n="3"/>Herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister</orgName>. Inßonders
<lb n="4"/>günstigen Herren, <unclear cert="low" resp="#joint">Wollvertruw=</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">ten</unclear> lieben <unclear cert="low" resp="#joint">Nachparren</unclear> und Eid=
<lb n="6"/><unclear cert="medium" resp="#joint">gnoßen</unclear>. Denselben seyen unßer
<lb n="7"/>fründtlichen gruoß, guotwillige
<lb n="8"/>dienst, ouch <unclear cert="low" resp="#joint">waß</unclear> wir <unclear cert="medium" resp="#joint">liebs</unclear> und
<lb n="9"/><unclear cert="low" resp="#joint">guots</unclear> <unclear cert="medium" resp="#joint">vermöchten</unclear>, <unclear cert="medium" resp="#joint">zuvor</unclear>. Nach
<lb n="10"/>dem <unclear cert="medium" resp="#joint">ungevohr</unclear> <unclear cert="medium" resp="#joint">biß</unclear> <unclear cert="medium" resp="#joint">6</unclear> oder <unclear cert="low" resp="#joint">7</unclear> <unclear cert="low" resp="#joint">wochen</unclear>,
<lb n="11"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Sabina</unclear> <unclear cert="low" resp="#joint">Freypuellerin</unclear></persName>, <unclear cert="low" resp="#joint">weilundt</unclear>
<lb n="12"/><persName resp="#ner"><unclear cert="low" resp="#joint">Christian</unclear> <unclear cert="low" resp="#joint">Freypolts</unclear></persName>, <unclear cert="low" resp="#joint">Ires</unclear> <unclear cert="medium" resp="#joint">burg=</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">ers</unclear>, (<unclear cert="medium" resp="#joint">wellicher</unclear> vor <unclear cert="low" resp="#joint">eim</unclear> <unclear cert="low" resp="#joint">jahr</unclear>
<lb n="14"/>todes <unclear cert="low" resp="#joint">verscheiden</unclear>.) <unclear cert="low" resp="#joint">seligen</unclear> <unclear cert="low" resp="#joint">Ehlich</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">hinderlaßne</unclear> <unclear cert="low" resp="#joint">witfrauw</unclear>, <unclear cert="medium" resp="#joint">alhie</unclear>
<lb n="16"/>mit <unclear cert="low" resp="#joint">tödtlicher</unclear> kranckheit heim=
<lb n="17"/><unclear cert="low" resp="#joint">gesuocht</unclear>, In wellicher <unclear cert="low" resp="#joint">Irer</unclear> kranck=
<lb n="18"/>heit, zeiger diß unser burger <unclear cert="low" resp="#joint">Mr</unclear>.
<lb n="19"/><persName resp="#ner">Rudolff Graab</persName> kantengießer,
<lb n="20"/>uß Christlichem <unclear cert="low" resp="#joint">mitleiden</unclear>, ouch daß
<lb n="21"/>sy Im In <unclear cert="low" resp="#joint">vorschinen</unclear> leidigen <unclear cert="low" resp="#joint">ster=</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">netsloueffen</unclear>, und sonsten, ouch et=
<lb n="23"/>wan mit pflaeg und rath, <unclear cert="low" resp="#joint">zuge=</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">sprungen</unclear>. Sy In 4 wochen lang In
<lb n="25"/>seinem huß <unclear cert="low" resp="#joint">uffalten</unclear>. <unclear cert="low" resp="#joint">Letstlich</unclear> aber
<lb n="26"/>er, ouch <unclear cert="low" resp="#joint">Mr</unclear>. <persName resp="#ner">Hanß <unclear cert="low" resp="#joint">Aberlj</unclear></persName> pfister,
<lb n="27"/>der Iro ein kind <unclear cert="low" resp="#joint">uß</unclear> dem heilligen
<lb n="28"/><unclear cert="low" resp="#joint">touff</unclear> empfangen, und <persName resp="#ner">Hanß Ru=
<lb n="29"/>dolff Echart</persName>, all <unclear cert="low" resp="#joint">unsere</unclear> lieben
<lb n="30"/>burger, (<unclear cert="low" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">denen</unclear> sy <unclear cert="low" resp="#joint">beide</unclear>, In
<lb n="31"/>12. oder 13 <unclear cert="medium" resp="#joint">jar</unclear> lang, woll <unclear cert="low" resp="#joint">erkandt</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">geweßen</unclear> und die <unclear cert="medium" resp="#joint">kein</unclear> <unclear cert="low" resp="#joint">unehr</unclear> jemals
<lb n="33"/>von Inen <unclear cert="low" resp="#joint">erfahren</unclear> <unclear cert="low" resp="#joint">habind</unclear>) <unclear cert="low" resp="#joint">vor</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">erschinen</unclear>, und <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">deßen</unclear> bericht.
<lb n="35"/>Mit ernstlichem <unclear cert="low" resp="#joint">anrueffen</unclear>, sy In
<lb n="36"/><unclear cert="low" resp="#joint">anderweeg</unclear> <unclear cert="low" resp="#joint">zuversorgen</unclear>, und <unclear cert="low" resp="#joint">bemel=</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">tem</unclear> <unclear cert="low" resp="#joint">unßerm</unclear> burger <unclear cert="medium" resp="#joint">abzenemen</unclear>.
<pb facs="StadtASG_Missive_1967_7312.jpg" n="2"/>
<lb n="38"/>wie <unclear cert="low" resp="#joint">beschehen</unclear>. Diewil sy aber <unclear cert="low" resp="#joint">jetzund</unclear>-
<lb n="39"/>er ouch <unclear cert="low" resp="#joint">todes</unclear> <unclear cert="low" resp="#joint">verscheiden</unclear>, und ein jung-
<lb n="40"/>en <unclear cert="medium" resp="#joint">knaben</unclear>, <unclear cert="medium" resp="#joint">hinder</unclear> <unclear cert="low" resp="#joint">iro</unclear> <unclear cert="low" resp="#joint">glaßen</unclear>, (da die
