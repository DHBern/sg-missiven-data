    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1967_7311.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edlen</unclear> Ehrenvesten, <unclear cert="low" resp="#joint">Frommen</unclear>, <unclear cert="low" resp="#joint">Für=</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">sichtigen</unclear>, <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">Ehrsamen</unclear> und Weisen,
<lb n="3"/>Herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister</orgName>. Inßonders
<lb n="4"/>günstigen Herren, Wollvertruw=
<lb n="5"/>ten lieben Nachparren und Eid=
<lb n="6"/>gnoßen. Denselben seyen unßer
<lb n="7"/>fründtlichen gruoß, guotwillige
<lb n="8"/>dienst, ouch waß wir liebs und
<lb n="9"/>guots vermöchten, zuvor. Nach
<lb n="10"/>dem <unclear cert="low" resp="#joint">ungevohr</unclear> <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">6</unclear> oder 7 wochen,
<lb n="11"/><persName resp="#ner">Sabina Freypuellerin</persName>, weilundt
<lb n="12"/><persName resp="#ner">Christian Freypolts</persName>, Ires burg=
<lb n="13"/>ers, (wellicher vor eim jahr
<lb n="14"/>todes verscheiden.) seligen Ehlich
<lb n="15"/>hinderlaßne witfrauw, alhie
<lb n="16"/>mit <unclear cert="low" resp="#joint">tödtlicher</unclear> <unclear cert="low" resp="#joint">kranckheit</unclear> <unclear cert="low" resp="#joint">heim=</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">gesuocht</unclear>, In <unclear cert="low" resp="#joint">wellicher</unclear> <unclear cert="low" resp="#joint">Irer</unclear> <unclear cert="low" resp="#joint">kranck=</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">heit</unclear>, <unclear cert="low" resp="#joint">zeiger</unclear> diß unser burger Mr.
<lb n="19"/><persName resp="#ner">Rudolff <unclear cert="low" resp="#joint">Graab</unclear></persName> <unclear cert="low" resp="#joint">kantengießer</unclear>,
<lb n="20"/><unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">Christlichem</unclear> <unclear cert="low" resp="#joint">mitleiden</unclear>, <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">Im</unclear> In vorschinen leidigen ster=
<lb n="22"/>netsloueffen, und sonsten, ouch <unclear cert="low" resp="#joint">et=</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">wan</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">pflaeg</unclear> und rath, zuge=
<lb n="24"/>sprungen. Sy In <unclear cert="low" resp="#joint">4</unclear> <unclear cert="low" resp="#joint">wochen</unclear> <unclear cert="low" resp="#joint">lang</unclear> <unclear cert="low" resp="#joint">In</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">huß</unclear> <unclear cert="low" resp="#joint">uffalten</unclear>. <unclear cert="low" resp="#joint">Letstlich</unclear> aber
<lb n="26"/><unclear cert="low" resp="#joint">er</unclear>, <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">Mr</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Hanß</unclear> <unclear cert="low" resp="#joint">Aberlj</unclear></persName> <unclear cert="low" resp="#joint">pfister</unclear>,
<lb n="27"/>der Iro ein kind <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">heilligen</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">touff</unclear> <unclear cert="low" resp="#joint">empfangen</unclear>, und <persName resp="#ner"><unclear cert="low" resp="#joint">Hanß</unclear> <unclear cert="low" resp="#joint">Ru=</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">dolff</unclear> <unclear cert="low" resp="#joint">Echart</unclear></persName>, all unsere lieben
<lb n="30"/>burger, (alß denen sy beide, In
<lb n="31"/>12. oder 13 jar lang, woll erkandt
<lb n="32"/>geweßen und die kein unehr jemals
<lb n="33"/>von Inen erfahren habind) vor
<lb n="34"/>unß erschinen, und unß deßen bericht.
<lb n="35"/>Mit ernstlichem anrueffen, sy In
<lb n="36"/>anderweeg zuversorgen, und bemel=
<lb n="37"/>tem unßerm burger <unclear cert="low" resp="#joint">abzenemen</unclear>.
<pb facs="StadtASG_Missive_1967_7312.jpg" n="2"/>
<lb n="38"/><unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">beschehen</unclear>. <unclear cert="low" resp="#joint">Diewil</unclear> sy aber <unclear cert="low" resp="#joint">jetzund</unclear>-
<lb n="39"/>er ouch todes verscheiden, und ein jung-
<lb n="40"/>en knaben, hinder iro glaßen, (da die
<lb n="41"/><unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">4</unclear> <unclear cert="low" resp="#joint">kinder</unclear> <unclear cert="low" resp="#joint">one</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">mer</unclear> in läben
<lb n="42"/>vorhanden syen,) wöllen sy denselben
<lb n="43"/>nach <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName>, in sin heimet und
<lb n="44"/>vatterland füeren, damit er nit et-
<lb n="45"/>wan im bättell- und ellend ufher-
<lb n="46"/>wachsen, sonder zuo einem <unclear cert="low" resp="#joint">biderman</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">ufferzogen</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">möchte</unclear>, gantz ernste-
<lb n="48"/>lich <unclear cert="low" resp="#joint">pitende</unclear>, <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">schriftlich</unclear>.
<lb n="49"/><unclear cert="low" resp="#joint">zeberichten</unclear>, <unclear cert="low" resp="#joint">damit</unclear> diß kind, <unclear cert="low" resp="#joint">sinen</unclear> <unclear cert="low" resp="#joint">ehr</unclear>-
<lb n="50"/><unclear cert="low" resp="#joint">lichen</unclear> <unclear cert="low" resp="#joint">nechsten</unclear> <unclear cert="low" resp="#joint">verwanten</unclear>, <unclear cert="low" resp="#joint">alß</unclear> die
<lb n="51"/>sich deßen anznemmen haben, <unclear cert="low" resp="#joint">zuokom</unclear>-
<lb n="52"/><unclear cert="low" resp="#joint">en</unclear> und in <unclear cert="low" resp="#joint">ehren</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">sinem</unclear> <unclear cert="low" resp="#joint">eignen</unclear>
<lb n="53"/>heil <unclear cert="low" resp="#joint">ufferzogen</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">möge</unclear>. <unclear cert="low" resp="#joint">Wan</unclear>
<lb n="54"/>wir nun diß guotmuetig begähren,
<lb n="55"/>(da wir unß sonsten one daß, der ge-
<lb n="56"/><unclear cert="low" resp="#joint">pür</unclear> <unclear cert="low" resp="#joint">nachverhalten</unclear> <unclear cert="low" resp="#joint">heten</unclear>) <unclear cert="low" resp="#joint">gern</unclear> <unclear cert="low" resp="#joint">an</unclear>-
<lb n="57"/><unclear cert="low" resp="#joint">ghört</unclear>. <unclear cert="low" resp="#joint">Alß</unclear> haben wir üch <unclear cert="low" resp="#joint">deßen</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">hieby</unclear>, <unclear cert="low" resp="#joint">bester</unclear> nachbarlicher und ge-
<lb n="59"/>threuwer eidgnößischer wohl-
<lb n="60"/>meinung <unclear cert="low" resp="#joint">zuberichten</unclear> nit underlaßen
<lb n="61"/>wöllen, mit <unclear cert="low" resp="#joint">sehr</unclear> <unclear cert="low" resp="#joint">wolgemeintem</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">piten</unclear>, <unclear cert="low" resp="#joint">solliches</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">unß</unclear> zum besten
<lb n="63"/><unclear cert="low" resp="#joint">zuverstahn</unclear>. <unclear cert="low" resp="#joint">Herannach</unclear> <unclear cert="low" resp="#joint">gschicht</unclear> Gott
<lb n="64"/>dem allmechtigen, (dene wir üch woll
<lb n="65"/><unclear cert="low" resp="#joint">bevelchen</unclear> <unclear cert="low" resp="#joint">thuond</unclear>) <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">wolgfallen</unclear>,
<lb n="66"/>und staht unß in glichen- und anderen
<lb n="67"/>zuotragenden fälen, widerumb zube-
<lb n="68"/>schulden. Datum den <origDate when="1615" resp="#ner">8 tag septembris anno 1615</origDate>.
<lb n="69"/><orgName ref="stadtasg-actors-718" cert="medium" role="issuer" resp="#ner">Schultheiß und rath der
<lb n="70"/>statt Winterthur</orgName>.
<pb facs="StadtASG_Missive_1967_7313.jpg" n="3"/>
<pb facs="StadtASG_Missive_1967_7314.jpg" n="4"/>
<lb n="71"/>Den <unclear cert="low" resp="#joint">edlen</unclear> <unclear cert="low" resp="#joint">ehrenvesten</unclear>, frommen,
<lb n="72"/><unclear cert="low" resp="#joint">fuersichtigen</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">hoch</unclear> unnd <unclear cert="low" resp="#joint">wol</unclear>-
<lb n="73"/>weisen <unclear cert="low" resp="#joint">herren</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">burgermeister</unclear>
<lb n="74"/><unclear cert="low" resp="#joint">und</unclear> rath der statt Sanct Gallen</orgName>,
<lb n="75"/>unssern insonders <unclear cert="low" resp="#joint">guenstigen</unclear> <unclear cert="low" resp="#joint">herren</unclear>
<lb n="76"/><unclear cert="low" resp="#joint">liebenn</unclear> <unclear cert="low" resp="#joint">freunden</unclear>, unnd <unclear cert="low" resp="#joint">nachparn</unclear>
<lb n="77"/><unclear cert="low" resp="#joint">sampt</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">sonders</unclear>.
</p>
