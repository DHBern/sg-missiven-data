<p>
<pb facs="StadtASG_Missive_2332_8921.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündtlich</unclear> willig <unclear cert="low" resp="#joint">dienste</unclear>, <unclear cert="low" resp="#joint">sambt</unclear> waß <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">Eeren</unclear>, liebs unnd
<lb n="2"/>guets vermoegen, <unclear cert="medium" resp="#joint">Zuvor</unclear> Fromm, Fürsichtig, <unclear cert="medium" resp="#joint">Eersamm</unclear>, wyß, Insonders
<lb n="3"/><unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">freündte</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">getreüw</unclear> lieb <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnossen</unclear></orgName>.
<lb n="4"/><unclear cert="medium" resp="#joint">Von</unclear> <unclear cert="medium" resp="#joint">etwelch</unclear> <unclear cert="medium" resp="#joint">unßern</unclear> <unclear cert="medium" resp="#joint">kaufflüten</unclear>, <unclear cert="medium" resp="#joint">sindt</unclear> wir <unclear cert="low" resp="#joint">gloubhafft</unclear> berichtet,
<lb n="5"/>daß bey <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">unßers</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Veltlin</unclear></placeName> <unclear cert="medium" resp="#joint">Jnnwohnern</unclear> <unclear cert="medium" resp="#joint">vachsgelt</unclear>, <unclear cert="medium" resp="#joint">umb</unclear> die
<lb n="6"/>selbigen zu gering, unnd <unclear cert="low" resp="#joint">daruff</unclear> gestanden, daß <unclear cert="low" resp="#joint">Jn</unclear> die
<lb n="7"/><unclear cert="low" resp="#joint">durchfuehre</unclear> <unclear cert="low" resp="#joint">Jekurtzen</unclear> bedacht <unclear cert="low" resp="#joint">gewësen</unclear> sein solle, <unclear cert="low" resp="#joint">Daruber</unclear> wir
<lb n="8"/>nit ermanglen woellen, die sachen nit allein gründtlich zu
<lb n="9"/><unclear cert="low" resp="#joint">erkündigen</unclear>, sonderen auch <unclear cert="low" resp="#joint">diesselbigen</unclear> so woll durch <unclear cert="medium" resp="#joint">unnßern</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">gesehworenen</unclear> <unclear cert="medium" resp="#joint">Müntzwardeihen</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">bey</unclear> <unclear cert="medium" resp="#joint">unnßern</unclear>
<lb n="11"/>unnd <unclear cert="low" resp="#joint">Eüweren</unclear> G. L. <unclear cert="low" resp="#joint">E</unclear>. der statt <placeName ref="stadtasg-places-32" cert="medium" resp="#ner">Zürich</placeName>, <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">ver=</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">rechstgychich</unclear> <unclear cert="low" resp="#joint">geschworene</unclear> <unclear cert="low" resp="#joint">meisteren</unclear>, Jnsehen unnd probieren
<lb n="13"/>lassen. Wie <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">Jnmassen</unclear> <unclear cert="low" resp="#joint">soellichs</unclear> Just, guet, und <unclear cert="medium" resp="#joint">volkhomen</unclear>,
<lb n="14"/><unclear cert="medium" resp="#joint">wurkchen</unclear> <unclear cert="medium" resp="#joint">Loethig</unclear> <unclear cert="medium" resp="#joint">Jesein</unclear> befunden. <unclear cert="medium" resp="#joint">Unnd</unclear> die <unclear cert="medium" resp="#joint">weyl</unclear> <unclear cert="medium" resp="#joint">dann</unclear>
<lb n="15"/>der sach <unclear cert="medium" resp="#joint">Jm</unclear> grundt der wahrheit und <unclear cert="medium" resp="#joint">also</unclear> <unclear cert="medium" resp="#joint">bschaffen</unclear>.
<lb n="16"/><unclear cert="medium" resp="#joint">Alß</unclear> <unclear cert="medium" resp="#joint">ersuechendt</unclear> wir eüch <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">freündt</unclear>: <orgName resp="#ner"><unclear cert="low" resp="#joint">Eydtgnoessisch</unclear></orgName>
<lb n="17"/>Jhr woellen mit <unclear cert="low" resp="#joint">eüwerem</unclear> Deputierten <unclear cert="low" resp="#joint">Müntzverwaltern</unclear>,
<lb n="18"/><unclear cert="low" resp="#joint">soelchs</unclear> Reden unnd sy dahin von <unclear cert="medium" resp="#joint">unßertwëgen</unclear> <unclear cert="medium" resp="#joint">pittlich</unclear>
<lb n="19"/>vermoegen, daß sy <unclear cert="medium" resp="#joint">künfftiger</unclear> <unclear cert="medium" resp="#joint">zeythen</unclear>, wider <unclear cert="medium" resp="#joint">unnßer</unclear> <unclear cert="medium" resp="#joint">vor=</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">fahren</unclear>, anlaß <unclear cert="medium" resp="#joint">Jrrung</unclear> <unclear cert="medium" resp="#joint">ald</unclear> <unclear cert="medium" resp="#joint">fehlers</unclear> sy <unclear cert="medium" resp="#joint">ersehen</unclear> wuerden,
<lb n="21"/><unclear cert="medium" resp="#joint">daß</unclear> sy <unclear cert="medium" resp="#joint">unnß</unclear> dessen <unclear cert="medium" resp="#joint">freündt</unclear>: <unclear cert="medium" resp="#joint">Eydtgnoessisch</unclear>, <unclear cert="medium" resp="#joint">bestey</unclear> <unclear cert="medium" resp="#joint">Verdische</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">vachsgelt</unclear>. <unclear cert="medium" resp="#joint">Passieren</unclear> unnd <unclear cert="medium" resp="#joint">zuverstendigen</unclear>, <unclear cert="medium" resp="#joint">ohne</unclear> <unclear cert="medium" resp="#joint">beschwärdt</unclear>
<lb n="23"/>sein <unclear cert="medium" resp="#joint">woellindt</unclear>. Daran beschicht die <unclear cert="medium" resp="#joint">billicheit</unclear>. <unclear cert="medium" resp="#joint">Unnd</unclear> <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">unnß</unclear>
<lb n="24"/>lieb und dienstlich. Wir syen <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">solchs</unclear> umb <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="25"/>die <unclear cert="low" resp="#joint">Eüwerigen</unclear>, uff Jede <unclear cert="low" resp="#joint">begebende</unclear> Occasion, mit gleich
<lb n="26"/><unclear cert="low" resp="#joint">mässiger</unclear>
<pb facs="StadtASG_Missive_2332_8922.jpg" n="2"/>
<lb n="27"/><unclear cert="medium" resp="#joint">verhaltung</unclear>, <unclear cert="medium" resp="#joint">fründ</unclear>: <unclear cert="medium" resp="#joint">Eydgnößischer</unclear> <unclear cert="medium" resp="#joint">zuoversicht</unclear>, <unclear cert="medium" resp="#joint">üch</unclear> auch alles
<lb n="28"/>Eydtgnößischen <unclear cert="low" resp="#joint">willen</unclear>, <unclear cert="low" resp="#joint">Eeren</unclear>, <unclear cert="low" resp="#joint">liebs</unclear> und guots <unclear cert="low" resp="#joint">zuobewysen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">sedert</unclear> <unclear cert="low" resp="#joint">erbietig</unclear>, <unclear cert="medium" resp="#joint">geneigt</unclear> unnd guotwillig. <unclear cert="low" resp="#joint">Unnß</unclear> <unclear cert="medium" resp="#joint">damit</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">samenthaft</unclear>, <unclear cert="low" resp="#joint">Goetlicher</unclear> Protection <unclear cert="low" resp="#joint">getrüwlich</unclear> <unclear cert="low" resp="#joint">empfelende</unclear>.
<lb n="31"/>Datum d. <origDate when="1622" resp="#ner">30. <unclear cert="medium" resp="#joint">d</unclear>. Martij Ao 1622</origDate>.
<lb n="32"/><orgName ref="stadtasg-actors-28" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Bürgermeister</unclear> und
<lb n="33"/>Raht der statt <unclear cert="low" resp="#joint">Schaffhußen</unclear></orgName>.
<pb facs="StadtASG_Missive_2332_8923.jpg" n="3"/>
<pb facs="StadtASG_Missive_2332_8924.jpg" n="4"/>
<lb n="34"/>Den frommen, fürsichtigen, <unclear cert="medium" resp="#joint">ehrsamen</unclear>
<lb n="35"/>unnd <unclear cert="low" resp="#joint">weÿßen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister
<lb n="36"/><unclear cert="medium" resp="#joint">und</unclear> Rhat der Statt St. Gallen</orgName> etc.
