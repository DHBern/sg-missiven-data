        <body>
<p>
<pb facs="StadtASG_Missive_2111_7911.jpg" n="1"/>
<lb n="1"/>Unser freündt, nachberlich willig dienst
<lb n="2"/>und was wir liebs und <unclear cert="low" resp="#joint">guets</unclear> <unclear cert="low" resp="#joint">vermoegen</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">zuvor</unclear> Vesten, Ersamen, Fürsichtig
<lb n="4"/>und Weisen, Insonders lieben
<lb n="5"/><unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">freündt</unclear> und Nachburn.
<lb n="6"/>Nachdem unser burger <persName resp="#ner">Cristoff
<lb n="7"/>Denner</persName> verschiner zeit mit seinem
<lb n="8"/>gewesnen Gsellen <persName resp="#ner">Cristoff Kreißer</persName>
<lb n="9"/>von <placeName resp="#ner">Hirschfeldt</placeName> auß <placeName ref="stadtasg-places-398" cert="medium" resp="#ner">Hessen</placeName>, in etwas
<lb n="10"/>stritts und <unclear cert="low" resp="#joint">spans</unclear> <unclear cert="low" resp="#joint">geraten</unclear>, <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">d</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">Gscell</unclear> <unclear cert="low" resp="#joint">seithero</unclear> <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">immer</unclear> <unclear cert="low" resp="#joint">trohet</unclear>,
<lb n="12"/>und ietzo er Denner in <unclear cert="low" resp="#joint">unser</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">gfangenschafft</unclear> <unclear cert="low" resp="#joint">khumen</unclear>.
<lb n="14"/>Wann wir nun umb <unclear cert="low" resp="#joint">d</unclear> sach
<lb n="15"/><unclear cert="low" resp="#joint">wichtigkeit</unclear> <unclear cert="low" resp="#joint">willen</unclear> <unclear cert="low" resp="#joint">ermelts</unclear> <unclear cert="low" resp="#joint">Gsellen</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">notwendig</unclear>, und uns <unclear cert="low" resp="#joint">für</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">khumen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">derselbig</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">nacher</unclear>
<lb n="18"/><placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Costentz</unclear></placeName> <unclear cert="low" resp="#joint">begeben</unclear>, und <unclear cert="low" resp="#joint">daselbst</unclear> <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">dero</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">ahngehoerigen</unclear> <unclear cert="low" resp="#joint">burger</unclear> <unclear cert="low" resp="#joint">eimem</unclear> <unclear cert="low" resp="#joint">suem</unclear> <unclear cert="low" resp="#joint">kriege</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">solle</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">Als</unclear> <unclear cert="low" resp="#joint">gelangt</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="22"/><unclear cert="low" resp="#joint">unser</unclear> freündt <unclear cert="low" resp="#joint">nachberlich</unclear> <unclear cert="low" resp="#joint">pitten</unclear>, <unclear cert="low" resp="#joint">die</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">woellen</unclear> <unclear cert="low" resp="#joint">sament</unclear> <unclear cert="low" resp="#joint">gedachten</unclear> <unclear cert="low" resp="#joint">Gsellen</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">oberkeit</unclear> <unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">zuverlegen</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">ahngeends</unclear> <unclear cert="low" resp="#joint">allhero</unclear> <unclear cert="low" resp="#joint">zeverfuegen</unclear>, <unclear cert="low" resp="#joint">und</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">erwenten</unclear> <unclear cert="low" resp="#joint">span</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">bericht</unclear> <unclear cert="low" resp="#joint">zegeben</unclear>, <unclear cert="low" resp="#joint">Im</unclear> <unclear cert="low" resp="#joint">fahl</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">weigerte</unclear> <unclear cert="low" resp="#joint">weill</unclear> er von <unclear cert="low" resp="#joint">meherer</unclear> <unclear cert="low" resp="#joint">thl</unclear>. <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">grosser</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">frävel</unclear> <unclear cert="low" resp="#joint">bezüchtiget</unclear> <unclear cert="low" resp="#joint">wirdt</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">danne</unclear>
<lb n="29"/>er <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">angeseztes</unclear> <unclear cert="low" resp="#joint">Rechtens</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">Ver</unclear>-
<lb n="30"/><unclear cert="low" resp="#joint">lümbdens</unclear> <unclear cert="low" resp="#joint">hette</unclear>, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">nützet</unclear> <unclear cert="low" resp="#joint">wird</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">thuen</unclear>.
<pb facs="StadtASG_Missive_2111_7912.jpg" n="2"/>
<lb n="32"/>im fall aber er Stettell sich vernerß nitt in-
<lb n="33"/>stellen wirt bedunckt unß Ihne alß dan abermahln
<lb n="34"/>bi seinnem eydt und hechster warheitt zuo
<lb n="35"/>thon sein rechter richter er ist, und von Ihmme
<lb n="36"/>hern wiste, alldieweil er Ihnen ein diener sowohl
<lb n="37"/>alß andren mehrerlei besuocht hette, und
<lb n="38"/>waß dann feürter sein ussag ist eingeschlossen
<lb n="39"/>e. weisheit eben dergestalt allein ubergeschickt werden
<lb n="40"/>fruendt nachbarlich zuo erkhennen
<lb n="41"/>lassen, und dannoch gegen denjhenigen
<lb n="42"/>hatt zuverhalten. deß sie es e. e. vlt.
<lb n="43"/>e. f. e. wlt. wie hinwiderumb fruendt-
<lb n="44"/>nachbarlich zuerwideren guetwillig u. erbietig
<lb n="45"/>unß darmit samptlich Goettes obhalt getrewlich
<lb n="46"/>wohl bevehlende. datum den <origDate when="1618" resp="#ner">7t. novembris
<lb n="47"/>1618</origDate>.
<lb n="48"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und Rhatt
<lb n="49"/>zuo St. Gallen</orgName>.
<lb n="50"/>Den edlen vesten, ehrenvesten, fuersichtigen,
<lb n="51"/>und weisen herrn altten h. haubtman, u.
<lb n="52"/>sthatts, <orgName ref="stadtasg-actors-56" cert="medium" role="recipient" resp="#ner">burgermeister u. rhat der statt
<lb n="53"/>Costentz</orgName>, unseren besonders lieben herren guotten
<lb n="54"/>fruenden u. nachburen.
</p>
