<lb n="6"/>waß <unclear cert="medium" resp="#joint">wir</unclear> sub dato <date resp="#ner"><unclear cert="low" resp="#joint">24ten</unclear> <unclear cert="low" resp="#joint">Maji</unclear></date> <unclear cert="low" resp="#joint">jüngst</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
