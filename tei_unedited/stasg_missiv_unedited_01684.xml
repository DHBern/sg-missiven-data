        <body>
<p>
<pb facs="StadtASG_Missive_1684_6157.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freuendtlich</unclear> willig dienst zuvor,
<lb n="2"/><unclear cert="low" resp="#joint">fuersichtigen</unclear> ehrsamen und weysen,
<lb n="3"/><unclear cert="low" resp="#joint">besonders</unclear> lieben und <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">freuend</unclear>,
<lb n="4"/>Was E. E. W. <unclear cert="medium" resp="#joint">bej</unclear> dero <unclear cert="low" resp="#joint">geliebten</unclear> zunfft-
<lb n="5"/><unclear cert="low" resp="#joint">meister</unclear>, <persName resp="#ner">Heinrich Zinggen</persName>, wegen <unclear cert="low" resp="#joint">sweb</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">bender</unclear> <unclear cert="low" resp="#joint">gefahrlicher</unclear> <unclear cert="low" resp="#joint">laeuffen</unclear>, und <unclear cert="low" resp="#joint">aber</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">mahls</unclear> <unclear cert="low" resp="#joint">fuerkomner</unclear> <unclear cert="low" resp="#joint">zeitungen</unclear> <unclear cert="low" resp="#joint">freuendt</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">nachbarlichen</unclear> <unclear cert="low" resp="#joint">zuegeschriben</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">begert</unclear>, ha-
<lb n="9"/>ben wir empfangen und vernomen,
<lb n="10"/>Wie wir unns <unclear cert="low" resp="#joint">nuhn</unclear>, E. E. W. <unclear cert="low" resp="#joint">freuendt</unclear>-
<lb n="11"/>nachbarlichen <unclear cert="low" resp="#joint">avisiorens</unclear> und <unclear cert="low" resp="#joint">zueschrei</unclear>-
<lb n="12"/>bens, <unclear cert="medium" resp="#joint">darbej</unclear> wir dero <unclear cert="low" resp="#joint">widerholte</unclear> ver-
<lb n="13"/>trawliche <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">correspondentz</unclear> <unclear cert="medium" resp="#joint">gniegsam</unclear>
<lb n="14"/>verspueren, <unclear cert="medium" resp="#joint">zuebedanckhen</unclear>, <unclear cert="medium" resp="#joint">also</unclear> <unclear cert="medium" resp="#joint">sollen</unclear>
<lb n="15"/>E. E. W. unns <unclear cert="low" resp="#joint">in</unclear> gleichen <unclear cert="low" resp="#joint">gueten</unclear> ver-
<lb n="16"/><unclear cert="medium" resp="#joint">trawlichem</unclear> <unclear cert="low" resp="#joint">wesen</unclear> nachbarlich wissen und
<lb n="17"/>befinden.
<lb n="18"/>Betreffend <unclear cert="low" resp="#joint">nuhn</unclear> <unclear cert="medium" resp="#joint">den</unclear> unns zuegeschrib-
<lb n="19"/>nen durchzug und Hispanische <unclear cert="low" resp="#joint">kriegs</unclear>-
<lb n="20"/>expedition, ist unns darvon, auff ver-
<lb n="21"/>trawlich angestelte inquisition, anders
<lb n="22"/>nichts wissent, dann <unclear cert="low" resp="#joint">weylen</unclear> die herr-
<lb n="23"/><unclear cert="medium" resp="#joint">schaft</unclear> <placeName resp="#ner">Venedig</placeName> <unclear cert="medium" resp="#joint">dem</unclear> <persName resp="#ner">Conte Fuentes</persName>, wegen deß
<lb n="24"/><unclear cert="low" resp="#joint">Koenigs</unclear> in <placeName resp="#ner">Hispanien</placeName>, <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">begerten</unclear> paß
<lb n="25"/><unclear cert="low" resp="#joint">verweigert</unclear>, dz dz <unclear cert="low" resp="#joint">geworbne</unclear>, unnd noch
<pb facs="StadtASG_Missive_1684_6158.jpg" n="2"/>
<lb n="26"/><unclear cert="low" resp="#joint">werbende</unclear> <unclear cert="low" resp="#joint">kriegsvolckh</unclear>, <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">fendlin</unclear> <unclear cert="low" resp="#joint">weis</unclear>,
<lb n="27"/><unclear cert="low" resp="#joint">sonnder</unclear> <unclear cert="low" resp="#joint">ploß</unclear>, <unclear cert="low" resp="#joint">nachem</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Meyländischen</unclear></placeName> <unclear cert="low" resp="#joint">stado</unclear>,
<lb n="28"/>uff selbigen musterplaz beschaiden sein,
<lb n="29"/>und solch volckh, durch die <unclear cert="low" resp="#joint">5</unclear>. <unclear cert="low" resp="#joint">O</unclear>. land und
<lb n="30"/>Lemanisch dahin ziehen, dasselbig auch nur,
<lb n="31"/>wider an die frontieren gegen <placeName ref="stadtasg-places-131" cert="medium" resp="#ner">Franckhreich</placeName>
<lb n="32"/>od <placeName ref="stadtasg-places-281" cert="medium" resp="#ner">Burgund</placeName>, und <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">zeteutschem</unclear> <unclear cert="low" resp="#joint">krieg</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">vermeint</unclear> sein solle.
<lb n="34"/>Erst gester bi alheer kommner pottschafft
<lb n="35"/>is anschickhung kommet diser kriegs ex-
<lb n="36"/>pedition halber, von unsers lieben burger-
<lb n="37"/><unclear cert="low" resp="#joint">meisters</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Erasmi</unclear> <unclear cert="low" resp="#joint">Furtenbachs</unclear></persName> <unclear cert="low" resp="#joint">sohn</unclear> <unclear cert="low" resp="#joint">zue</unclear>
<lb n="38"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Bozzen</unclear></placeName>, <unclear cert="low" resp="#joint">eingeschloßner</unclear> <unclear cert="low" resp="#joint">extract</unclear> <unclear cert="low" resp="#joint">alheer</unclear>,
<lb n="39"/><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">wir</unclear> zu <unclear cert="low" resp="#joint">mererem</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="40"/><unclear cert="low" resp="#joint">richt</unclear> <unclear cert="low" resp="#joint">zueschickhen</unclear>, und was wir <unclear cert="low" resp="#joint">dergleich</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">sachen</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">schaden</unclear>, <unclear cert="low" resp="#joint">wider</unclear> un-
<lb n="42"/>ser geliebtes vatterlannd sich ereügen,
<lb n="43"/>und wir erfahren wurden, wellen wir selbi-
<lb n="44"/>ges <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. so <unclear cert="low" resp="#joint">tags</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">nachts</unclear>, <unclear cert="low" resp="#joint">vertraulichen</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">avisiren</unclear>, und berichten.
<lb n="46"/>Und das haben <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">wir</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="47"/><unclear cert="low" resp="#joint">gerte</unclear> <unclear cert="low" resp="#joint">herüber</unclear>, <unclear cert="low" resp="#joint">gleicher</unclear> <unclear cert="low" resp="#joint">gueter</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">wolmeinung</unclear>, <unclear cert="low" resp="#joint">vertraulich</unclear> <unclear cert="low" resp="#joint">zuevermelden</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="49"/>underlassen wellen, <unclear cert="low" resp="#joint">seyen</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">bleiben</unclear>
<pb facs="StadtASG_Missive_1684_6159.jpg" n="3"/>
<lb n="50"/>Extract auß ainem schreiben de <origDate when="1610-06-06" resp="#ner">6 <unclear cert="low" resp="#joint">Junij</unclear> <unclear cert="low" resp="#joint">stilo</unclear> <unclear cert="low" resp="#joint">novo</unclear>
<lb n="51"/>Anno 1610</origDate>. <unclear cert="low" resp="#joint">In</unclear> <origPlace ref="stadtasg-places-431" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Polz</unclear></origPlace> <unclear cert="low" resp="#joint">datierdt</unclear>.
<lb n="52"/><unclear cert="low" resp="#joint">Verschine</unclear> <unclear cert="low" resp="#joint">woch</unclear> hatt der von <persName resp="#ner">Madruz</persName> die patenten von
<lb n="53"/><placeName resp="#ner">Prag</placeName> empfangen, dz er 2 regiment fueßvolckh soll
<lb n="54"/>werben, für den <unclear cert="low" resp="#joint">könig</unclear> <unclear cert="low" resp="#joint">in</unclear> <placeName ref="stadtasg-places-280" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Spa</unclear>.</placeName> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">auf</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">15</unclear> diß <unclear cert="low" resp="#joint">nach</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Trectra</unclear></placeName> so dem Spanier gehörig auf die
<lb n="56"/>musterbläz beschriben und nemen ihren weg durch
<lb n="57"/>daß <placeName ref="stadtasg-places-287" cert="medium" resp="#ner">Schweizerland</placeName> auf <placeName ref="stadtasg-places-89" cert="medium" resp="#ner">Veldkirch</placeName> zu, wohin eß solte
<lb n="58"/>aigentl waißt gott. Und sein solche 2 regiment
<lb n="59"/>schon vast allerdingß beisamen.
<pb facs="StadtASG_Missive_1684_6160.jpg" n="4"/>
<pb facs="StadtASG_Missive_1684_6161.jpg" n="5"/>
<lb n="60"/><unclear cert="low" resp="#joint">sonderß</unclear> <unclear cert="low" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">allwegen</unclear>, allso
<lb n="61"/><unclear cert="medium" resp="#joint">vorthin</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">gueter</unclear> nachbarlicher <unclear cert="low" resp="#joint">beharr</unclear>-
<lb n="62"/><unclear cert="low" resp="#joint">ennder</unclear> <unclear cert="low" resp="#joint">dienstserzaigung</unclear>, ganz wil-
<lb n="63"/>lig und <unclear cert="medium" resp="#joint">genaigt</unclear>. Goettlich <unclear cert="low" resp="#joint">gnaden</unclear> unns
<lb n="64"/><unclear cert="low" resp="#joint">sammptlich</unclear> bevelchend. Datum den <origDate when="1610-06-27" resp="#ner"><unclear cert="medium" resp="#joint">27</unclear>.
<lb n="65"/>Junij anno 1610</origDate>.
<lb n="66"/><orgName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear>
<lb n="67"/>und <unclear cert="low" resp="#joint">gehayme</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">raeth</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">Lindaw</unclear></orgName>.
<pb facs="StadtASG_Missive_1684_6162.jpg" n="6"/>
<lb n="69"/>Den Fuersichtigen, <unclear cert="low" resp="#joint">Eersamen</unclear> und
<lb n="70"/>Weysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> und <unclear cert="medium" resp="#joint">Rhat</unclear>
<lb n="71"/>der Statt Sanct Gallen</orgName>, unsern
<lb n="72"/>besondern lieben und <unclear cert="medium" resp="#joint">guten</unclear> <unclear cert="medium" resp="#joint">freunden</unclear>.
<lb n="73"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sanct Gallen</placeName>.
</p>
