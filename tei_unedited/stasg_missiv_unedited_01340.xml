<p>
<pb facs="StadtASG_Missive_1340_4635.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">freuendtlich</unclear> <unclear cert="low" resp="#joint">nachpeurlichen</unclear> und guetwillig
<lb n="2"/>dienst zuvor, fuersichtigen, ersamen, weisen, be-
<lb n="3"/>sonders lieben gueten <unclear cert="low" resp="#joint">freuendten</unclear> und <unclear cert="low" resp="#joint">nachpeurn</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">Uff</unclear> <unclear cert="low" resp="#joint">euer</unclear> uns von wegen <unclear cert="low" resp="#joint">eur</unclear> <unclear cert="low" resp="#joint">burgerin</unclear> Salome
<lb n="5"/><unclear cert="low" resp="#joint">Voglerterin</unclear> <unclear cert="low" resp="#joint">juegsthen</unclear> <unclear cert="low" resp="#joint">nachpeurliches</unclear> schreiben,
<lb n="6"/>haben ir unsers burgers <persName resp="#ner">Hanß Jacob Bischoffs</persName>
<lb n="7"/><unclear cert="low" resp="#joint">ubergebnen</unclear> schrifftlichen bericht beyligendt
<lb n="8"/>zueverlesen. Welchen wir <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">beynebent</unclear>
