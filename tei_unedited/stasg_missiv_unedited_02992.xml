    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2992_11775.jpg" n="1"/>
<lb n="1"/>Unsere freundtlich willig dienst
<lb n="2"/>zuvor, Ersame und Weise, in-
<lb n="3"/>sonders liebe Herren und <unclear cert="low" resp="#joint">guete</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">freunde</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Welchermassen</unclear> <unclear cert="low" resp="#joint">deiselbe</unclear> zu under-
<lb n="6"/>haltung inligender starckher guar-
<lb n="7"/>nison, und abstattung grosser contri-
<lb n="8"/>butionen, wie <unclear cert="low" resp="#joint">namhaffts</unclear> <unclear cert="low" resp="#joint">euwer</unclear> <unclear cert="low" resp="#joint">Statt</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">hochbeduerfftig</unclear> <unclear cert="low" resp="#joint">sye</unclear> <unclear cert="low" resp="#joint">derowegen</unclear> uns
<lb n="10"/>umb ein anlehen von etlich ß 000.
<lb n="11"/>gegen <unclear cert="low" resp="#joint">gebuerender</unclear> <unclear cert="low" resp="#joint">versicherung</unclear> <unclear cert="low" resp="#joint">freudt</unclear>-
<lb n="12"/>lich ersuecht, daß haben wir
<lb n="13"/>auß ihrem an uns abgangnen schreiben
<lb n="14"/>mit mehrerm vernommen.
<lb n="15"/>Obwohln wir nun mit <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="16"/><unclear cert="low" resp="#joint">angeregts</unclear> <unclear cert="low" resp="#joint">ihres</unclear> <unclear cert="low" resp="#joint">beschwaerlichen</unclear> <unclear cert="low" resp="#joint">zustands</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">christenlichs</unclear> mit-
<lb n="18"/>leiden tragen, und <unclear cert="low" resp="#joint">darneben</unclear> <unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">wueh</unclear>-
<lb n="19"/><unclear cert="low" resp="#joint">sen</unclear> <unclear cert="low" resp="#joint">möchten</unclear>, daß wir dennselben
<lb n="20"/>in <unclear cert="low" resp="#joint">angeregtem</unclear> <unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">ansuechen</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">willfahren</unclear> und <unclear cert="low" resp="#joint">darbei</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">bißhero</unclear> <unclear cert="low" resp="#joint">getragne</unclear> <unclear cert="low" resp="#joint">gute</unclear>
<lb n="23"/>affection <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">werckh</unclear> <unclear cert="low" resp="#joint">erzeigen</unclear> <unclear cert="low" resp="#joint">koenten</unclear>.
<lb n="24"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">wir</unclear> aber wegen der jezt
<lb n="25"/>etlich <unclear cert="low" resp="#joint">jahr</unclear> <unclear cert="low" resp="#joint">hero</unclear> <unclear cert="low" resp="#joint">gewehreten</unclear> <unclear cert="low" resp="#joint">theürung</unclear>,
<lb n="26"/><unclear cert="low" resp="#joint">starckhen</unclear> <unclear cert="low" resp="#joint">beschwaerlichen</unclear> <unclear cert="low" resp="#joint">einlegerung</unclear>
<lb n="27"/>in die nachbarschafft, und <unclear cert="low" resp="#joint">dardurch</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">causierter</unclear> <unclear cert="low" resp="#joint">sperrung</unclear>, <unclear cert="low" resp="#joint">sonderlich</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">geringen</unclear> <unclear cert="low" resp="#joint">abbruchs</unclear> <unclear cert="low" resp="#joint">unsers</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">gwerbs</unclear> und hin gegg taeglich
<lb n="31"/>grosser außgaaben, mit gelt
<lb n="32"/><unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">versehen</unclear>, <unclear cert="low" resp="#joint">derge</unclear>-
<lb n="33"/><unclear cert="low" resp="#joint">stalten</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">wirohnschwerlich</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">hierin</unclear> <unclear cert="low" resp="#joint">gegen</unclear> uns auh
<pb facs="StadtASG_Missive_2992_11776.jpg" n="2"/>
<lb n="34"/>wollte, uß ihrem begern zuo
<lb n="35"/>willfahren.
<lb n="36"/><unclear cert="low" resp="#joint">Alß</unclear> <unclear cert="low" resp="#joint">bitten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">dieselb</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">frdtlich</unclear>,
<lb n="37"/><unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">wolle</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dißer</unclear> <unclear cert="low" resp="#joint">erheblichen</unclear>
<lb n="38"/>ursach für entschuldiget halten, und in <unclear cert="low" resp="#joint">argem</unclear> <unclear cert="low" resp="#joint">nicht</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">vermerckhen</unclear>; <unclear cert="low" resp="#joint">sich</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">zuokünftig</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="41"/>sonst in all andere weg, da sich die
<lb n="42"/>occasion <unclear cert="low" resp="#joint">begeben</unclear> <unclear cert="low" resp="#joint">thete</unclear>, <unclear cert="low" resp="#joint">beliebende</unclear> <unclear cert="low" resp="#joint">diest</unclear>
<lb n="43"/>und <unclear cert="low" resp="#joint">angenemhes</unclear> <unclear cert="low" resp="#joint">gefallen</unclear> <unclear cert="low" resp="#joint">erzeigen</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">könnten</unclear>, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">hiezuo</unclear> so geneigt
<lb n="45"/>willig und anerbietig, alß wir
<lb n="46"/>Gott bitten, dz er sie ihrer beschwerdten
<lb n="47"/>gnedigclich entledigen, und demnach
<lb n="48"/>einnist den <unclear cert="low" resp="#joint">langgewünschten</unclear> <unclear cert="low" resp="#joint">wehrten</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">friden</unclear> <unclear cert="low" resp="#joint">im</unclear> <orgName ref="stadtasg-actors-559" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Reich</unclear> <unclear cert="low" resp="#joint">Teütscher</unclear> <unclear cert="low" resp="#joint">Nation</unclear></orgName> <unclear cert="low" resp="#joint">bschern</unclear>,
<lb n="50"/>und uß samptlich in seinem gnadenreichen
<lb n="51"/>schutz und schirm erhalten wolle. Datum
<lb n="52"/><origDate when="1634-01-28" resp="#ner">den <unclear cert="low" resp="#joint">28ten</unclear> <unclear cert="low" resp="#joint">Januarij</unclear> <unclear cert="low" resp="#joint">a.o</unclear> <unclear cert="low" resp="#joint">1634</unclear></origDate>.
<lb n="53"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und Rhate
<lb n="54"/>der Statt <unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></orgName>.
<lb n="55"/><unclear cert="low" resp="#joint">Denen</unclear> <unclear cert="low" resp="#joint">ehrsamen</unclear> und <unclear cert="low" resp="#joint">weisen</unclear>, <unclear cert="low" resp="#joint">N</unclear>: <unclear cert="low" resp="#joint">N</unclear>:
<lb n="56"/><orgName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und Rhat der
<lb n="57"/>Statt Biberach</orgName>, unßern sonders
<lb n="58"/>lieben herren und guotten fründen.
<lb n="59"/>Biberach.
<pb facs="StadtASG_Missive_2992_11777.jpg" n="3"/>
<pb facs="StadtASG_Missive_2992_11778.jpg" n="4"/>
</p>
