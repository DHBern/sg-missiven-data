        <body>
<p>
<pb facs="StadtASG_Missive_1342_4647.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündlich</unclear> willig dienst <unclear cert="low" resp="#joint">zuovor</unclear>. <unclear cert="low" resp="#joint">Fromm</unclear> fürsichtig
<lb n="2"/><unclear cert="low" resp="#joint">ersam</unclear> unnd <unclear cert="low" resp="#joint">weÿß</unclear>, <unclear cert="low" resp="#joint">insonders</unclear> liebe unnd <unclear cert="low" resp="#joint">guete</unclear> freündt, was
<lb n="3"/>ir unns <persName resp="#ner"><unclear cert="low" resp="#joint">Othmar</unclear> <unclear cert="low" resp="#joint">Ratkaerbs</unclear></persName>, deß <unclear cert="low" resp="#joint">kirsners</unclear>, <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">an=</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">gehörigen</unclear> wegen, vom <date resp="#ner">vierzehenden <unclear cert="medium" resp="#joint">verwichnen</unclear> monats <unclear cert="medium" resp="#joint">julÿ</unclear></date>,
<lb n="5"/><unclear cert="medium" resp="#joint">zuogeschriben</unclear>, das <unclear cert="medium" resp="#joint">haben</unclear> <unclear cert="medium" resp="#joint">wür</unclear> vor ime, <unclear cert="medium" resp="#joint">wolgelütert</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">fürgenommen</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">fügen</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> daruff <unclear cert="medium" resp="#joint">zuovernemen</unclear>, das
<lb n="7"/><unclear cert="low" resp="#joint">ob</unclear> wir gleichwol, <unclear cert="medium" resp="#joint">uss</unclear> <unclear cert="medium" resp="#joint">guethertziger</unclear> <unclear cert="medium" resp="#joint">varendes</unclear> <unclear cert="medium" resp="#joint">zeügks</unclear>, so ime
<lb n="8"/>deßhalben, <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">versiglet</unclear> <unclear cert="low" resp="#joint">urkhundt</unclear>, das er <unclear cert="low" resp="#joint">nün</unclear> <unclear cert="low" resp="#joint">inner</unclear> <unclear cert="low" resp="#joint">zue</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">angehörigen</unclear>, <unclear cert="low" resp="#joint">uffzuonemen</unclear> <unclear cert="low" resp="#joint">gewogen</unclear>, <unclear cert="low" resp="#joint">entpfangen</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wür</unclear> <unclear cert="low" resp="#joint">eüch</unclear> doch <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">allerleÿ</unclear> <unclear cert="low" resp="#joint">bedencklichen</unclear> <unclear cert="low" resp="#joint">ursachen</unclear>, zuo=
<lb n="11"/><unclear cert="low" resp="#joint">zebeantwurten</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">umbgehen</unclear> <unclear cert="low" resp="#joint">wöllen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">fügen</unclear> <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">in</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">derwaerdt</unclear> <unclear cert="low" resp="#joint">zuvernemen</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">albereit</unclear>, <unclear cert="low" resp="#joint">beÿ</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">uff</unclear> und <unclear cert="medium" resp="#joint">an=</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">genomen</unclear>, unnd wie ein jeder <unclear cert="medium" resp="#joint">der</unclear> unsern, <unclear cert="low" resp="#joint">allhieige</unclear> <unclear cert="low" resp="#joint">gabe</unclear> <unclear cert="low" resp="#joint">am</unclear> <unclear cert="low" resp="#joint">huoch</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">thuen</unclear> mueß, <unclear cert="medium" resp="#joint">gelobt</unclear>, geschworen, unnd <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">bürgerecht</unclear> <unclear cert="low" resp="#joint">ver</unclear> ge=
<lb n="15"/><unclear cert="low" resp="#joint">buerdt</unclear> <unclear cert="low" resp="#joint">beüet</unclear>, hinderlegt, auch <unclear cert="low" resp="#joint">stritt</unclear> <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">kirchenbau</unclear> ge=
<lb n="16"/>brauch nach, den kirchgang volzogen, Derwegen,
<lb n="17"/><unclear cert="medium" resp="#joint">weÿl</unclear> <unclear cert="medium" resp="#joint">es</unclear> <unclear cert="medium" resp="#joint">nün</unclear> <unclear cert="medium" resp="#joint">mehe</unclear> <unclear cert="medium" resp="#joint">eim</unclear> von <unclear cert="medium" resp="#joint">nöten</unclear>, sich mit <unclear cert="medium" resp="#joint">seiner</unclear> <unclear cert="medium" resp="#joint">haußfrauwen</unclear>,
<lb n="18"/>in <unclear cert="low" resp="#joint">ordenliche</unclear> <unclear cert="low" resp="#joint">haußhaltung</unclear> <unclear cert="low" resp="#joint">einzuerichten</unclear>, Alls <unclear cert="medium" resp="#joint">gelangt</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">freündlichs</unclear> <unclear cert="medium" resp="#joint">gesinnen</unclear> an <unclear cert="medium" resp="#joint">eüch</unclear>, ime alles das, <unclear cert="low" resp="#joint">sou</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">allein</unclear>
<lb n="20"/>von seinen eltern <unclear cert="medium" resp="#joint">ererbt</unclear>, sonder was ime auch, <unclear cert="low" resp="#joint">sinsten</unclear> <unclear cert="low" resp="#joint">ann</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">seines</unclear> vatters <unclear cert="low" resp="#joint">selligen</unclear> <unclear cert="low" resp="#joint">statt</unclear>, deß <unclear cert="medium" resp="#joint">döyllenischen</unclear>, <unclear cert="medium" resp="#joint">uffgerichten</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">testaments</unclear> <unclear cert="medium" resp="#joint">wegen</unclear>, <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">Gottes</unclear>, ehr unnd billichkeit <unclear cert="low" resp="#joint">wegen</unclear>
<pb facs="StadtASG_Missive_1342_4648.jpg" n="2"/>
<lb n="23"/>zuetraettig, guetiglichen gevolgen zuelassen, hieran erweißt
<lb n="24"/>Ir ein werckh der <unclear cert="low" resp="#joint">billikheit</unclear>, unnd wirdts der almaechtige Gott,
<lb n="25"/>(nebenn dem wir auch <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">euch</unclear>, in dergleichen genaegen,)
<lb n="26"/>zuegebürenderzeit unbelont nit <unclear cert="low" resp="#joint">lassen</unclear>. Damit wir
<lb n="27"/><unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">abernchordnung</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">gewißer</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wölt</unclear> <unclear cert="low" resp="#joint">unnß</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">zöger</unclear> <unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">beschaidenhait</unclear> <unclear cert="low" resp="#joint">auserwüch</unclear> <unclear cert="low" resp="#joint">berüchtten</unclear>, <unclear cert="low" resp="#joint">damit</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">gotts</unclear> <unclear cert="low" resp="#joint">gnaden</unclear>. Datum den <origDate when="1597-09-29" cert="medium" resp="#ner">29. Septem=
<lb n="30"/>bris anno 97</origDate>.
<lb n="31"/><orgName role="issuer" resp="#ner">Burgermaister unnd Rath der statt
<lb n="32"/><unclear cert="low" resp="#joint">Naeuenburg</unclear> im <unclear cert="low" resp="#joint">Preüßgaeuw</unclear></orgName>.
<pb facs="StadtASG_Missive_1342_4649.jpg" n="3"/>
<pb facs="StadtASG_Missive_1342_4650.jpg" n="4"/>
<lb n="33"/>Den fromen, fuersichtigen,
<lb n="34"/>ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister
<lb n="35"/>und <unclear cert="low" resp="#joint">Rhat</unclear> der Statt S: Gallen</orgName>.
<lb n="36"/>unsern insonders lieben und <unclear cert="medium" resp="#joint">guetenn</unclear>
<lb n="37"/>freünden.
</p>
