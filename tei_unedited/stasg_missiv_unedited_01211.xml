    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1211_4003.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freündtlich</unclear> willig <unclear cert="low" resp="#joint">dinst</unclear> zuvor ersamen unnd
<lb n="2"/><unclear cert="low" resp="#joint">weißen</unclear> lieben unnd <unclear cert="low" resp="#joint">guoten</unclear> freündt, wir haben
<lb n="3"/><unclear cert="low" resp="#joint">gemainen</unclear> <unclear cert="low" resp="#joint">weilundt</unclear> unnsers burgers <persName resp="#ner"><unclear cert="medium" resp="#joint">Steffan</unclear> <unclear cert="medium" resp="#joint">Löhers</unclear></persName>
<lb n="4"/><unclear cert="medium" resp="#joint">säligen</unclear> <unclear cert="medium" resp="#joint">schuldglaübigen</unclear>, <unclear cert="medium" resp="#joint">uff</unclear> etlicher derselben <unclear cert="medium" resp="#joint">anhaln</unclear>,
<lb n="5"/>ainen allgemainen <unclear cert="medium" resp="#joint">rechtstag</unclear> <unclear cert="medium" resp="#joint">ernennt</unclear> unnd angesetzt,
<lb n="6"/>wie <unclear cert="low" resp="#joint">Ewer</unclear> <unclear cert="low" resp="#joint">Ersam</unclear> <unclear cert="low" resp="#joint">Weißhait</unclear>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">beiverwarten</unclear> <unclear cert="low" resp="#joint">edict</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">zuvernemen</unclear>. Unnd dieweil dann ettliche E. E. <unclear cert="medium" resp="#joint">W</unclear>.
<lb n="8"/><unclear cert="medium" resp="#joint">burger</unclear>, unnd <unclear cert="low" resp="#joint">fürnemblich</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Cornelleich</unclear></persName> deßhalben
<lb n="9"/>auch interessiert, unnd zu bemelts <unclear cert="low" resp="#joint">Steffan</unclear> <unclear cert="low" resp="#joint">Löhers</unclear> haab unnd
<lb n="10"/><unclear cert="medium" resp="#joint">guot</unclear> <unclear cert="medium" resp="#joint">vorderung</unclear> unnd <unclear cert="medium" resp="#joint">ansprach</unclear> haben <unclear cert="medium" resp="#joint">möchten</unclear>. So
<lb n="11"/><unclear cert="medium" resp="#joint">pitten</unclear> wir <unclear cert="medium" resp="#joint">sie</unclear> ganntz <unclear cert="medium" resp="#joint">freündtlich</unclear> <unclear cert="medium" resp="#joint">sie</unclear> <unclear cert="medium" resp="#joint">wöllen</unclear> sollich <unclear cert="medium" resp="#joint">edict</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">irem</unclear> habenden gebrauch nach, <unclear cert="low" resp="#joint">bei</unclear> inen an <unclear cert="low" resp="#joint">gewonnen</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">ortten</unclear> <unclear cert="low" resp="#joint">offennlich</unclear> <unclear cert="low" resp="#joint">uffschlagen</unclear> unnd publicieren, auch
<lb n="14"/>obgemelttem <unclear cert="medium" resp="#joint">irem</unclear> burger anzaigen lassen. <unclear cert="medium" resp="#joint">darmit</unclear>
<lb n="15"/>an <unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">rechten</unclear> <unclear cert="low" resp="#joint">niemandts</unclear> <unclear cert="low" resp="#joint">verkürtzt</unclear> werde, nach sich
<lb n="16"/>der <unclear cert="medium" resp="#joint">unwissenhait</unclear> <unclear cert="medium" resp="#joint">zubeklagen</unclear> ursach habe. Das
<lb n="17"/>begern wir umb E. E. <unclear cert="low" resp="#joint">Wt</unclear>. <unclear cert="low" resp="#joint">ieder</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">gutwillig</unclear> unnd
<lb n="18"/><unclear cert="medium" resp="#joint">freündtlich</unclear> <unclear cert="medium" resp="#joint">zuverdienen</unclear>. Dat. <origDate when="1587" cert="medium" resp="#ner">den <unclear cert="medium" resp="#joint">16</unclear> <unclear cert="medium" resp="#joint">tag</unclear> <unclear cert="medium" resp="#joint">augusti</unclear>
<lb n="19"/>anno etc. 87.</origDate>
<lb n="20"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermaister <unclear cert="medium" resp="#joint">und</unclear> rath der
<lb n="21"/>statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_1211_4004.jpg" n="2"/>
<pb facs="StadtASG_Missive_1211_4005.jpg" n="3"/>
<pb facs="StadtASG_Missive_1211_4006.jpg" n="4"/>
<lb n="22"/>Den <unclear cert="low" resp="#joint">ersamen</unclear> unnd weysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister,
<lb n="23"/>unnd rathe, der statt <unclear cert="low" resp="#joint">Sannct</unclear> Gallen</orgName>, unnsern
<lb n="24"/>lieben unnd guoten <unclear cert="medium" resp="#joint">freuenden</unclear>.
</p>
