<lb n="7"/>inlag zue rächt empfangen, und den inhalt mit mehrerm
<lb n="8"/>verstanden, thuend unß deßwägen söllicher üwerer
<lb n="9"/>guetwilligkeit nochmalen früntlich bedanken, unnd
<lb n="10"/>so nun <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">hürigen</unclear> <unclear cert="low" resp="#joint">tags</unclear> <unclear cert="low" resp="#joint">verschinen</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">orthen</unclear> <unclear cert="low" resp="#joint">her</unclear>, <unclear cert="low" resp="#joint">deß</unclear>
