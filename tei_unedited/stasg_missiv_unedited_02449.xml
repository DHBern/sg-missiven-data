<p>
<pb facs="StadtASG_Missive_2449_9441.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freundtlich</unclear> willig dienst und <unclear cert="low" resp="#joint">waß</unclear> wir
<lb n="2"/>ehren liebs und guots <unclear cert="medium" resp="#joint">vermoegen</unclear> <unclear cert="medium" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">Edle</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">veste</unclear>, <unclear cert="medium" resp="#joint">fromme</unclear>, <unclear cert="medium" resp="#joint">fürsichtige</unclear>, <unclear cert="medium" resp="#joint">ehrsame</unclear> und <unclear cert="medium" resp="#joint">weise</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">insonders</unclear> <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="medium" resp="#joint">freündt</unclear> und <unclear cert="medium" resp="#joint">getreuwen</unclear> <unclear cert="medium" resp="#joint">liebe</unclear>,
<lb n="5"/><orgName resp="#ner">Eidtgnossen</orgName>.
<lb n="6"/><unclear cert="medium" resp="#joint">Dieselben</unclear> werden uß dem schreiben, so wir <unclear cert="low" resp="#joint">ihrem</unclear>
<lb n="7"/>underthanen <persName resp="#ner"><unclear cert="medium" resp="#joint">hannsen</unclear> <unclear cert="medium" resp="#joint">schüfelbergern</unclear></persName> von <placeName resp="#ner"><unclear cert="medium" resp="#joint">hilschweilen</unclear></placeName>
<lb n="8"/><unclear cert="medium" resp="#joint">verfloßner</unclear> <unclear cert="medium" resp="#joint">tag</unclear> <unclear cert="medium" resp="#joint">zuogestelt</unclear>, mit <unclear cert="low" resp="#joint">mehrem</unclear> <unclear cert="low" resp="#joint">vernommen</unclear>,
<lb n="9"/>waß <unclear cert="low" resp="#joint">zwüschent</unclear> <unclear cert="low" resp="#joint">ihme</unclear> und dem unsern <persName resp="#ner"><unclear cert="low" resp="#joint">Othmarn</unclear></persName>
<lb n="10"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">Altherr</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">Altheren</unclear> <unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">langgewehrten</unclear>
<lb n="13"/>differentz halber, <unclear cert="medium" resp="#joint">für</unclear> <unclear cert="medium" resp="#joint">dato</unclear> <unclear cert="medium" resp="#joint">füergeloffen</unclear>; Da
<lb n="14"/>und <unclear cert="low" resp="#joint">beschweeren</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">vermeidung</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">viller</unclear> <unclear cert="low" resp="#joint">gewohnter</unclear> <unclear cert="low" resp="#joint">un</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">costens</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">ambt</unclear> <placeName ref="stadtasg-places-413" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Gruo</unclear>-
<lb n="19"/><unclear cert="low" resp="#joint">ningen</unclear></placeName> <unclear cert="low" resp="#joint">geseßen</unclear>,
<lb n="20"/>wir den <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">sein</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">füergestelte</unclear> kundtschafften,
<lb n="21"/><unclear cert="medium" resp="#joint">8</unclear>. <unclear cert="medium" resp="#joint">zügen</unclear> <unclear cert="medium" resp="#joint">treügenlich</unclear> <unclear cert="medium" resp="#joint">understendig</unclear> anhalten, verhoert,
<lb n="22"/><unclear cert="medium" resp="#joint">nemlich</unclear> die jenigen so <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">iuristiction</unclear> <unclear cert="low" resp="#joint">geseßen</unclear>
<lb n="23"/>und noch nit verhoert worden, beij <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">uffgehebten</unclear>
<lb n="24"/>Eiden, die andern aber so schon vor disem <unclear cert="low" resp="#joint">kundtschafft</unclear>
<lb n="25"/>in gegenwirtiger sach kundtschafft <unclear cert="medium" resp="#joint">geseit</unclear> und
<lb n="26"/>E. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">F</unclear>. und <unclear cert="low" resp="#joint">W</unclear>. E. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">dero</unclear> depositiones <unclear cert="low" resp="#joint">vor</unclear>,
<lb n="27"/>zuvor <unclear cert="medium" resp="#joint">alberit</unclear> <unclear cert="medium" resp="#joint">uberschriben</unclear>
<lb n="28"/>worden, haben wir <unclear cert="low" resp="#joint">sij</unclear> beij <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">daselbs</unclear> <unclear cert="low" resp="#joint">gethanen</unclear> ußsagen
<lb n="29"/>verbleiben, <unclear cert="low" resp="#joint">ihnen</unclear> aber selbige <unclear cert="low" resp="#joint">nachmahls</unclear> <unclear cert="low" resp="#joint">füerlesen</unclear>
<lb n="30"/>und befragen laßen, ob <unclear cert="low" resp="#joint">deme</unclear> also seije <unclear cert="low" resp="#joint">od</unclear> nit, die
<lb n="31"/><unclear cert="low" resp="#joint">ubrigen</unclear> dreij <unclear cert="low" resp="#joint">Gezügen</unclear> aber, weil sie nit <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">burg</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">haben</unclear> wir <unclear cert="low" resp="#joint">zwar</unclear> nit beeidiget, aber <unclear cert="low" resp="#joint">ihnen</unclear> <unclear cert="low" resp="#joint">sonst</unclear> mit ernst
<lb n="33"/><unclear cert="medium" resp="#joint">zuogesprochen</unclear> <unclear cert="medium" resp="#joint">solchergestalt</unclear> <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">reine</unclear> warheit anzuo-
<lb n="34"/>zeigen, solcher gestalt, wann hernach <unclear cert="low" resp="#joint">ihnen</unclear> der Eidt uffer-
<lb n="35"/>legt wurde, daß sie <unclear cert="low" resp="#joint">ire</unclear> <unclear cert="low" resp="#joint">ihre</unclear> ußsagen darmit erhalten
<lb n="36"/><unclear cert="medium" resp="#joint">moegend</unclear>. Dieweil nun der
<lb n="37"/><unclear cert="low" resp="#joint">wahr</unclear>- <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">klagendtheil</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">unserige</unclear>, durch den <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">beid</unclear> <unclear cert="low" resp="#joint">theilen</unclear> <unclear cert="low" resp="#joint">eroeffneten</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">bscheid</unclear>, verstanden, daß die sach <unclear cert="low" resp="#joint">füer</unclear> ein <unclear cert="medium" resp="#joint">Ehrs</unclear>: <unclear cert="medium" resp="#joint">Gricht</unclear>
<lb n="40"/>zuo <placeName ref="stadtasg-places-413" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Grueningen</unclear></placeName> remittiert seije, hat er unß under-
<lb n="41"/><unclear cert="low" resp="#joint">thenigs</unclear> <unclear cert="low" resp="#joint">fleißes</unclear> ersuochen <unclear cert="medium" resp="#joint">laßen</unclear>, wir <unclear cert="medium" resp="#joint">wollten</unclear> ihme
<lb n="42"/>solcher <unclear cert="medium" resp="#joint">Zügen</unclear> <unclear cert="medium" resp="#joint">ußsagen</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> seinem Rechten in <unclear cert="low" resp="#joint">forma</unclear> gnädig
<lb n="43"/>und <unclear cert="low" resp="#joint">günstig</unclear> zuostellen, wann dann wir
<pb facs="StadtASG_Missive_2449_9442.jpg" n="2"/>
<lb n="44"/><unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">gegentheil</unclear> dem <persName resp="#ner"><unclear cert="medium" resp="#joint">Hueber</unclear></persName> <unclear cert="medium" resp="#joint">erhebt</unclear> <unclear cert="medium" resp="#joint">worden</unclear>,
<lb n="45"/>was <unclear cert="medium" resp="#joint">unsere</unclear> abgeordnete <unclear cert="medium" resp="#joint">mit</unclear>
<lb n="46"/><unclear cert="medium" resp="#joint">raht</unclear> in der <unclear cert="medium" resp="#joint">besichtigung</unclear> der <unclear cert="low" resp="#joint">Kalbsaetzen</unclear> befunden,
<lb n="47"/>auch in <unclear cert="low" resp="#joint">schrifft</unclear> verschloßen mitgetheilt, so haben
<lb n="48"/>wir dem <unclear cert="low" resp="#joint">Kehrern</unclear> in seinem <unclear cert="low" resp="#joint">rechtmeßigen</unclear> <unclear cert="low" resp="#joint">billich</unclear>-
<lb n="49"/><unclear cert="low" resp="#joint">meßigen</unclear> <unclear cert="low" resp="#joint">begern</unclear> gleicher <unclear cert="medium" resp="#joint">gstalt</unclear>
<lb n="50"/>nit <unclear cert="medium" resp="#joint">zuwider</unclear> sein woellen, <unclear cert="low" resp="#joint">Deroohalben</unclear> E. W.
<lb n="51"/>und <unclear cert="medium" resp="#joint">G</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">seind</unclear> <unclear cert="medium" resp="#joint">obangezogne</unclear> verhoerte
<lb n="52"/><unclear cert="medium" resp="#joint">zeugensaag</unclear> hiemit <unclear cert="low" resp="#joint">verschloßen</unclear> <unclear cert="low" resp="#joint">sub</unclear> lit. A. B. C.
<lb n="53"/><unclear cert="low" resp="#joint">zuzefertigen</unclear>, <unclear cert="low" resp="#joint">mit</unclear> dem <unclear cert="low" resp="#joint">angehenckten</unclear>
<lb n="54"/>gantz <unclear cert="medium" resp="#joint">freuendlichen</unclear> und <unclear cert="low" resp="#joint">Eidtgnoesischen</unclear> <unclear cert="low" resp="#joint">ersuochen</unclear>
<lb n="55"/>und <unclear cert="medium" resp="#joint">bitten</unclear>, sie den <unclear cert="low" resp="#joint">Kehrern</unclear>, als welcher
<lb n="56"/>so er <unclear cert="low" resp="#joint">mueßte</unclear> <unclear cert="low" resp="#joint">zurugg</unclear> <unclear cert="low" resp="#joint">liggen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">geworffen</unclear> <unclear cert="low" resp="#joint">wurde</unclear>, in warheit zuschreiben,
<lb n="57"/>gar ins verderben <unclear cert="low" resp="#joint">mueßte</unclear> (<unclear cert="low" resp="#joint">dieweil</unclear> sein
<lb n="58"/><unclear cert="low" resp="#joint">gegnpartij</unclear> sich selbs habe <unclear cert="medium" resp="#joint">verlauten</unclear> laßen,
<lb n="59"/>daß sij <unclear cert="medium" resp="#joint">uf</unclear> dise sach so vil <unclear cert="medium" resp="#joint">zusetzen</unclear> <unclear cert="medium" resp="#joint">begert</unclear>, daß
<lb n="60"/>weder der <unclear cert="low" resp="#joint">Kehrer</unclear> noch sein gantze Freundtschafft
<lb n="61"/>solchs nit werden ertragen moegen) <unclear cert="low" resp="#joint">dergestalten</unclear>
<lb n="62"/>woellen laßen in gnaden <unclear cert="medium" resp="#joint">befolhen</unclear> sein, daß <unclear cert="medium" resp="#joint">gegenwuertige</unclear> wie
<lb n="63"/><unclear cert="low" resp="#joint">zugleich</unclear> <unclear cert="low" resp="#joint">unsre</unclear> <unclear cert="low" resp="#joint">vorgehende</unclear> ihme zum besten <unclear cert="medium" resp="#joint">gemeinte</unclear>
<lb n="64"/>intercessiones so weit <unclear cert="low" resp="#joint">respectieren</unclear>, daß sie
<lb n="65"/>es bij <unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">vorigen</unclear> loblich <unclear cert="low" resp="#joint">gefaßeten</unclear>, und ihrem
<lb n="66"/><unclear cert="low" resp="#joint">Vogt</unclear> zu <placeName ref="stadtasg-places-413" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Grueningen</unclear></placeName> <unclear cert="low" resp="#joint">uberschriebnen</unclear> <unclear cert="medium" resp="#joint">gnedigen</unclear>
<lb n="67"/>resolution und <unclear cert="low" resp="#joint">befelch</unclear> <unclear cert="low" resp="#joint">nochmalen</unclear> be-
<lb n="68"/>wenden <unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="medium" resp="#joint">auch</unclear> verschaffen laßen, daß
<lb n="69"/>solche in <unclear cert="low" resp="#joint">wuerkhliche</unclear> execution gelangen, und
<lb n="70"/>also jedermeniglichem von diser <unclear cert="low" resp="#joint">miehsaligen</unclear> sach
<lb n="71"/>ab. und zu <unclear cert="low" resp="#joint">ruowen</unclear> geholffen werden <unclear cert="medium" resp="#joint">moege</unclear>, das
<lb n="72"/>begern gegen E. <unclear cert="medium" resp="#joint">W</unclear>. und <unclear cert="medium" resp="#joint">G</unclear>. E. W.
<lb n="73"/><unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">von</unclear> deß <unclear cert="medium" resp="#joint">Kehrers</unclear> wegen <unclear cert="medium" resp="#joint">in</unclear> gleich und ande-
<lb n="74"/>rer occasionen mit gantz geneigtem und <unclear cert="low" resp="#joint">Eidtgnoesischen</unclear>
<lb n="75"/>willen widerumb <unclear cert="low" resp="#joint">freuendtlich</unclear> <unclear cert="low" resp="#joint">zeerkhennen</unclear>;
<lb n="76"/>uns <unclear cert="low" resp="#joint">darmit</unclear> <unclear cert="low" resp="#joint">beiderseits</unclear> <unclear cert="low" resp="#joint">Goetlicher</unclear>
<lb n="77"/>protection wol <unclear cert="low" resp="#joint">befelchende</unclear>. Datum den <origDate when="1623-11-24" resp="#ner">24. Novembris
<lb n="78"/><unclear cert="low" resp="#joint">Ao</unclear>. 1623</origDate>.
<lb n="79"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">Raht</unclear>
<lb n="80"/>der Statt Santgallen</orgName>
<lb n="81"/>An die Statt <placeName ref="stadtasg-places-32" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Zuerich</unclear></placeName>.
