        <body>
<p>
<pb facs="StadtASG_Missive_1836_6813.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freiündt</unclear>- <unclear cert="low" resp="#joint">nachbarlich</unclear> willig dienst, und
<lb n="2"/><unclear cert="medium" resp="#joint">waß</unclear> wir ehren liebs und guots vermögend,
<lb n="3"/>zuvor, frommen, fürsichtigen, <unclear cert="medium" resp="#joint">ersammen</unclear> und
<lb n="4"/>weisen, insonders <unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">freiünden</unclear>, und ge=
<lb n="5"/><unclear cert="medium" resp="#joint">treüwen</unclear> lieben nachbaren.
<lb n="6"/><unclear cert="medium" resp="#joint">Vor</unclear> <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">verschinen</unclear> <unclear cert="medium" resp="#joint">jaren</unclear>, ist <unclear cert="medium" resp="#joint">eüwer</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">mitburger</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">N</unclear>. Schellenberg</persName>, <unclear cert="low" resp="#joint">jetziger</unclear> zeit
<lb n="8"/><unclear cert="medium" resp="#joint">gastgeb</unclear> <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">zur</unclear> <placeName ref="stadtasg-places-293" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Cronen</unclear></placeName>, von <unclear cert="medium" resp="#joint">seinem</unclear>
<lb n="9"/>vatter <unclear cert="medium" resp="#joint">seligen</unclear> unserem <unclear cert="medium" resp="#joint">zuegehörigen</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Gabriel</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">Murer</unclear></persName> dem goldschmid, <unclear cert="medium" resp="#joint">beÿ</unclear> ihme <unclear cert="low" resp="#joint">dasselb</unclear> <unclear cert="low" resp="#joint">handt=</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">werch</unclear> <unclear cert="low" resp="#joint">zuleren</unclear>, übergeben worden. <unclear cert="medium" resp="#joint">Daruf</unclear>
<lb n="12"/>hat ermelter <persName resp="#ner"><unclear cert="medium" resp="#joint">Murer</unclear></persName> uns <unclear cert="medium" resp="#joint">heüt</unclear> dato <unclear cert="low" resp="#joint">clagß=</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">weiß</unclear> <unclear cert="low" resp="#joint">fürgebracht</unclear>, wie <unclear cert="low" resp="#joint">daß</unclear> gemelter
<lb n="14"/><unclear cert="medium" resp="#joint">eüwer</unclear> burger, <unclear cert="low" resp="#joint">domalen</unclear> sein <unclear cert="medium" resp="#joint">geweßner</unclear> lehr=
<lb n="15"/>jung, <unclear cert="medium" resp="#joint">ihne</unclear> <unclear cert="medium" resp="#joint">ungefahr</unclear> anderthalb <unclear cert="medium" resp="#joint">jar</unclear>, <unclear cert="medium" resp="#joint">vor</unclear> uß=
<lb n="16"/>gang der <unclear cert="low" resp="#joint">anbedingten</unclear> <unclear cert="low" resp="#joint">jaren</unclear>, und <unclear cert="medium" resp="#joint">nam=</unclear>
<lb n="17"/>lich eben <unclear cert="medium" resp="#joint">zu</unclear> der zeit, da er seiner am aller
<lb n="18"/>meisten <unclear cert="medium" resp="#joint">genieß</unclear> gehabt <unclear cert="medium" resp="#joint">hette</unclear>, <unclear cert="medium" resp="#joint">uß</unclear> der <unclear cert="medium" resp="#joint">leer</unclear> auß=
<lb n="19"/><unclear cert="medium" resp="#joint">getretten</unclear> und der <unclear cert="medium" resp="#joint">wanderschafft</unclear> nachgezogen
<lb n="20"/><unclear cert="medium" resp="#joint">seÿe</unclear>. <unclear cert="medium" resp="#joint">Als</unclear> er aber von derselben
<lb n="21"/><unclear cert="medium" resp="#joint">seiner</unclear> <unclear cert="medium" resp="#joint">wanderschafft</unclear> unlangst wider
<lb n="22"/><unclear cert="low" resp="#joint">alher</unclear> in unser statt gelangt, habe er <unclear cert="low" resp="#joint">ihne</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">deßhalber</unclear> umb <unclear cert="medium" resp="#joint">gebürenden</unclear> abtrag <unclear cert="medium" resp="#joint">ersuochen</unclear>
<lb n="24"/>lassen, er <persName resp="#ner">Schellenberg</persName> auch uf solches sein
<lb n="25"/><unclear cert="medium" resp="#joint">treüw</unclear> an <unclear cert="medium" resp="#joint">eidsstatt</unclear> angelobt, sich in der
<lb n="26"/><unclear cert="medium" resp="#joint">nechsten</unclear> <unclear cert="medium" resp="#joint">monatsfrist</unclear> <unclear cert="medium" resp="#joint">alhie</unclear> widerumb <unclear cert="medium" resp="#joint">zu=</unclear>
<lb n="27"/>stellen und mit ihme, <unclear cert="medium" resp="#joint">der</unclear> gebür nach <unclear cert="medium" resp="#joint">abzu=</unclear>
<lb n="28"/>kommen. <unclear cert="medium" resp="#joint">Weil</unclear> <unclear cert="medium" resp="#joint">nun</unclear> solches auch nit
<lb n="29"/><unclear cert="medium" resp="#joint">ervolgt</unclear>, und über den <unclear cert="medium" resp="#joint">bestimten</unclear> monat
<lb n="30"/>vil zeit <unclear cert="medium" resp="#joint">verloffen</unclear>, da <unclear cert="medium" resp="#joint">gleichwol</unclear> er Schel=
<lb n="31"/>lenberg, wegen seiner <unclear cert="medium" resp="#joint">neüwangestellten</unclear>
<lb n="32"/>wirtschafft und <unclear cert="medium" resp="#joint">gehaltner</unclear> <unclear cert="medium" resp="#joint">hochzeit</unclear> sich biß=
<lb n="33"/><unclear cert="medium" resp="#joint">her</unclear> entschuldiget, und aber <unclear cert="medium" resp="#joint">ihme</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Murer</unclear></persName>,
<lb n="34"/><unclear cert="medium" resp="#joint">als</unclear> <unclear cert="medium" resp="#joint">einem</unclear>, so deß seinigen bedürfftig,
<lb n="35"/><unclear cert="medium" resp="#joint">beschwerlich</unclear> fallen wil, <unclear cert="medium" resp="#joint">diß</unclear> <unclear cert="medium" resp="#joint">sach</unclear> lenger
<pb facs="StadtASG_Missive_1836_6814.jpg" n="2"/>
<lb n="36"/><unclear cert="medium" resp="#joint">ersuecht</unclear> <unclear cert="medium" resp="#joint">zulassen</unclear>, hat er <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">umb</unclear> hilff und
<lb n="37"/><unclear cert="low" resp="#joint">raht</unclear> <unclear cert="low" resp="#joint">underthaenig</unclear> gebetten.
<lb n="38"/><unclear cert="medium" resp="#joint">Sidmalen</unclear> dann <unclear cert="medium" resp="#joint">unß</unclear> wol <unclear cert="medium" resp="#joint">bewußt</unclear>, <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">eß</unclear>
<lb n="39"/><unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">gelübdts</unclear> halber <unclear cert="medium" resp="#joint">erzelter</unclear> <unclear cert="medium" resp="#joint">maßen</unclear> beschechen,
<lb n="40"/>und deßwegen wir <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">unserigen</unclear> <unclear cert="medium" resp="#joint">begeren</unclear>
<lb n="41"/><unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">verwaigeren</unclear> <unclear cert="medium" resp="#joint">koennen</unclear>, So haben wir
<lb n="42"/><unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">endung</unclear> diser sach <unclear cert="medium" resp="#joint">ainen</unclear> tag <unclear cert="low" resp="#joint">ernempt</unclear>
<lb n="43"/>namlich <origDate resp="#ner"><unclear cert="low" resp="#joint">Moendag</unclear> den <unclear cert="low" resp="#joint">26</unclear>. <unclear cert="low" resp="#joint">ten</unclear> <unclear cert="low" resp="#joint">Juii</unclear></origDate>. Und
<lb n="44"/>gelangt darauf an <unclear cert="medium" resp="#joint">eüch</unclear> unser <unclear cert="low" resp="#joint">freünd</unclear>, <unclear cert="low" resp="#joint">nach</unclear>-
<lb n="45"/><unclear cert="low" resp="#joint">barliches</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear>, ihr <unclear cert="low" resp="#joint">wollend</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="46"/><unclear cert="low" resp="#joint">meltem</unclear> <unclear cert="low" resp="#joint">eüwerem</unclear> <unclear cert="low" resp="#joint">mitburger</unclear> <unclear cert="low" resp="#joint">disen</unclear> tag
<lb n="47"/>der gestalt ankünden lassen, daß <unclear cert="medium" resp="#joint">er</unclear>
<lb n="48"/><unclear cert="medium" resp="#joint">denselben</unclear> <unclear cert="medium" resp="#joint">beii</unclear> <unclear cert="medium" resp="#joint">obgehoertem</unclear> seinem <unclear cert="medium" resp="#joint">gelübd</unclear>
<lb n="49"/><unclear cert="medium" resp="#joint">besueche</unclear>, oder durch seinen anwald <unclear cert="medium" resp="#joint">besuechen</unclear>
<lb n="50"/>lasse, und ein <unclear cert="medium" resp="#joint">versuechen</unclear> <unclear cert="medium" resp="#joint">thue</unclear>, ob er sich
<lb n="51"/>mit dem <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">koenne</unclear> <unclear cert="medium" resp="#joint">guetiglich</unclear>
<lb n="52"/>abfinden, In mangel aber <unclear cert="medium" resp="#joint">deßen</unclear>
<lb n="53"/><unclear cert="medium" resp="#joint">gebürenden</unclear> rechtens <unclear cert="medium" resp="#joint">erwarte</unclear>, da <unclear cert="medium" resp="#joint">ihme</unclear>
<lb n="54"/><unclear cert="medium" resp="#joint">daßelbige</unclear> nach aller <unclear cert="medium" resp="#joint">billigkait</unclear> <unclear cert="medium" resp="#joint">widerfahren</unclear>
<lb n="55"/>solle. <unclear cert="low" resp="#joint">Staht</unclear> umb <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">auch</unclear> in <unclear cert="medium" resp="#joint">ander</unclear>
<lb n="56"/><unclear cert="medium" resp="#joint">weg</unclear> widerumb <unclear cert="medium" resp="#joint">zubeschulden</unclear>. <unclear cert="medium" resp="#joint">dat</unclear>.
<lb n="57"/><origDate when="1613" resp="#ner">den .<unclear cert="low" resp="#joint">25</unclear>. <unclear cert="low" resp="#joint">ten</unclear>. Aprilis <unclear cert="medium" resp="#joint">Ao</unclear> etc <unclear cert="medium" resp="#joint">1613</unclear></origDate>.
<lb n="58"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermr</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear>
<lb n="59"/>der Statt <unclear cert="medium" resp="#joint">Sant</unclear> Gallen</orgName>
<lb n="60"/><unclear cert="medium" resp="#joint">An</unclear> <orgName ref="stadtasg-actors-718" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Shltheiß</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear> zu
<lb n="61"/>Winterthur</orgName>
