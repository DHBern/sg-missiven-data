<lb n="63"/><unclear cert="medium" resp="#joint">trifft</unclear> an <persName resp="#ner"><unclear cert="medium" resp="#joint">Gabriel</unclear> <unclear cert="medium" resp="#joint">Murern</unclear></persName> <unclear cert="medium" resp="#joint">gold</unclear>-
