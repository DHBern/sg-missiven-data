<p>
<pb facs="StadtASG_Missive_1897_7063.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Ehrnvest</unclear>, <unclear cert="low" resp="#joint">fuersichtig</unclear>, <unclear cert="low" resp="#joint">ehsam</unclear> <unclear cert="low" resp="#joint">weis</unclear>, <unclear cert="low" resp="#joint">gunstige</unclear> liebe herren, <unclear cert="low" resp="#joint">denselben</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">seyen</unclear> unser willige dienst zuvor.
<lb n="3"/>Demnach siche unser mitburger <persName resp="#ner">Ulrich <unclear cert="low" resp="#joint">Gschwendreuter</unclear></persName> der <unclear cert="low" resp="#joint">juenger</unclear>
<lb n="4"/>hievor <unclear cert="low" resp="#joint">bei</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wst</unclear>. ab <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">burgern</unclear>. <unclear cert="low" resp="#joint">N</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Gebelen</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">kornfuerer</unclear> und <unclear cert="low" resp="#joint">ehegnossen</unclear>, umb etwas bei dem-
<lb n="6"/>selben ihme ausstehenden kaufschlasß erclagt, und im naher uff
<lb n="7"/>sein <unclear cert="low" resp="#joint">dortewegens</unclear> <unclear cert="low" resp="#joint">beschehen</unclear> <unclear cert="low" resp="#joint">vilfeltiges</unclear> <unclear cert="low" resp="#joint">nachvolgen</unclear> <unclear cert="low" resp="#joint">disen</unclear> <unclear cert="low" resp="#joint">bescheidt</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">erlanget</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">solle</unclear>, <unclear cert="low" resp="#joint">wan</unclear> <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Gschwendreuter</unclear></persName> sein <unclear cert="low" resp="#joint">fuergeben</unclear> des
<lb n="9"/>strittigen khufschlasß erweisen, darauf ihme gebuerender bescheidt
<lb n="10"/>ertheilt, und benueglicher will gemachet werden solle.
<lb n="11"/>Dieweil er dan zuo seinem beweisthumb .4. unserer mitburgeren
<lb n="12"/>daruber zuvernemmen fuorgeschlagen, und <unclear cert="low" resp="#joint">dienstlich</unclear> gebetten was
<lb n="13"/>dieselben guot wussend aussagen, und in der <unclear cert="low" resp="#joint">strittigen</unclear> <unclear cert="low" resp="#joint">handlung</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">bekhandtschafften</unclear> <unclear cert="low" resp="#joint">wurden</unclear>, <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wst</unclear>. <unclear cert="low" resp="#joint">alß</unclear> des <unclear cert="low" resp="#joint">beclagten</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">obrigkheit</unclear> <unclear cert="low" resp="#joint">schrifftlichen</unclear> <unclear cert="low" resp="#joint">gelangen</unclear> <unclear cert="low" resp="#joint">zuelassen</unclear>. <unclear cert="low" resp="#joint">Daß</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="16"/>nit underlassen wellen, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">mehrgenants</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Gschwendreuters</unclear></persName> <unclear cert="low" resp="#joint">ferner</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">nachfolgen</unclear> und pitliches anhalten, daß <unclear cert="low" resp="#joint">jhenige</unclear> so <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">bei</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">gemelten</unclear> und <unclear cert="low" resp="#joint">hienachfolgenden</unclear> <unclear cert="low" resp="#joint">personen</unclear> <unclear cert="low" resp="#joint">befunden</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
<lb n="19"/><unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wst</unclear>. <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">beschicht</unclear>, <unclear cert="low" resp="#joint">verschloßen</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">uberschriben</unclear>,
<lb n="20"/>sich darnach der billikheit und <unclear cert="low" resp="#joint">villgenants</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Gschwendreuters</unclear></persName>
<lb n="21"/><unclear cert="low" resp="#joint">weiters</unclear> <unclear cert="low" resp="#joint">ansuochen</unclear> in der sach <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">gnedig</unclear> <unclear cert="low" resp="#joint">bedenkhen</unclear>, und er-
<lb n="22"/><unclear cert="low" resp="#joint">achtens</unclear> <unclear cert="low" resp="#joint">desto</unclear> besser <unclear cert="low" resp="#joint">zugerichten</unclear>. <unclear cert="low" resp="#joint">Wolten</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wst</unclear>.,
<lb n="23"/><unclear cert="low" resp="#joint">deren</unclear> wir alle angeneme dienst. <unclear cert="low" resp="#joint">ud</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">willigkhit</unclear>
<pb facs="StadtASG_Missive_1897_7064.jpg" n="2"/>
<lb n="24"/>zeerwaisen brait und guetwillig; nit weniger uns damit
<lb n="25"/>neben Inen dem Schirmreichen Segen Gottes besten fleiß
<lb n="26"/>empfehlende. <origPlace ref="stadtasg-places-36" cert="medium" resp="#ner">Ratolffzell</origPlace> <origDate resp="#ner">den .2. Junij Ao. 614</origDate>.
<lb n="27"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermaister und Rath</orgName>
<lb n="28"/>daselbsten.
<pb facs="StadtASG_Missive_1897_7065.jpg" n="3"/>
<lb n="29"/>In sachen <persName resp="#ner">Ulrichen Issenrueters</persName> zue
<lb n="30"/><placeName ref="stadtasg-places-36" cert="medium" resp="#ner">Ratolffzell</placeName> burgerlich verwanndt ains contra
<lb n="31"/><persName resp="#ner">N. Scherer</persName> von <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName> suen in beiseyn
<lb n="32"/>hern <persName resp="#ner">Adam Egels</persName> kirchenpflaegers unnd h.
<lb n="33"/><persName resp="#ner">Georg Wahler</persName> beden des raths zue <placeName ref="stadtasg-places-36" cert="medium" resp="#ner">Rzell</placeName>
<lb n="34"/>alls von ainem e. rath daselbst verordnten
<lb n="35"/>seindt inzogen, volgende khundtschafft
<lb n="36"/>in gezogen worden.
<lb n="37"/>1 Erstlichen <persName resp="#ner">Gallus Seitz</persName> baumeister sagt bei seinem aydt
<lb n="38"/>ainem e. rath geschworen, daß sich zuegetragen alls jungst
<lb n="39"/>verwichnen winters der <placeName ref="stadtasg-places-36" cert="medium" resp="#ner">Zeller</placeName> oder Under see zuegefroren,
<lb n="40"/>ihme unnd seinen mitconsorten die korn seckh uf <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Costantz</placeName>
<lb n="41"/>oder <placeName resp="#ner">Lohn</placeName> alls gewoehnliche schifflegeten zuefuehren von <placeName ref="stadtasg-places-36" cert="medium" resp="#ner">Zell</placeName>
<lb n="42"/>zueding von jedem schweren oder leeren sackh 6 batzen
<lb n="43"/>fuerlohn und . 6 . d zoll des ersten marckhts alls man im
<lb n="44"/>landt fahren muessen, durch ainen von <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName> genant
<lb n="45"/><persName resp="#ner">Schopffer</persName>. N. versprochen und bezahlt worden.
<lb n="46"/>2 <persName role="issuer" resp="#ner">Thomaß Götz</persName> sagt bei seinem burger aydt, daß sich
<lb n="47"/>auch jungst abgeloffner winterzeit begeben alls der see
<lb n="48"/>uberfroren gewesen, daß ihme <persName resp="#ner">Caspar Schirer</persName> von <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St.
<lb n="49"/>Gallen</placeName> die korn seckh von <placeName ref="stadtasg-places-36" cert="medium" resp="#ner">Zell</placeName> gahn <placeName resp="#ner">Lohn</placeName> zuefuehren
<lb n="50"/>des ersten marckhts jeden p . 6 . batzen fuhrlohens ver-
<lb n="51"/>dinget, und darzue . 6 . d bezalt habe fuer den
<lb n="52"/>gebuerlichen zoll zuereichen.
<lb n="53"/>. 3 . <persName role="issuer" resp="#ner">Matheus Eigel</persName> auch burger zue Ratolffzell
<lb n="54"/>bezeuget bei seinem burgerlichen aydt daß nechst-
<pb facs="StadtASG_Missive_1897_7066.jpg" n="4"/>
<lb n="55"/>verwirckung winters zeit alls der <unclear cert="low" resp="#joint">see</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">Zall</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">gfrorn</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">gwesen</unclear>, <unclear cert="low" resp="#joint">Ime</unclear> und <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">mitconsorten</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">fuohrlüthen</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">wegen</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">starck</unclear> <unclear cert="low" resp="#joint">leüten</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">sack</unclear> <unclear cert="low" resp="#joint">grcß</unclear> <unclear cert="low" resp="#joint">lohe</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">füern</unclear> <unclear cert="low" resp="#joint">verdingt</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">das</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">lesten</unclear> <unclear cert="low" resp="#joint">marckhts</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gfrörne</unclear> und <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">jeden</unclear> <unclear cert="low" resp="#joint">schwaren</unclear> <unclear cert="low" resp="#joint">sackh</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">bezalt</unclear> <unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">sechst</unclear> <unclear cert="low" resp="#joint">batzen</unclear>, <unclear cert="low" resp="#joint">und</unclear>. <unclear cert="low" resp="#joint">6</unclear>. d. für dz zollgelt zehlen.
<lb n="60"/>.4. <persName resp="#ner">Blasius Kösli</persName> burger und <unclear cert="low" resp="#joint">furman</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-36" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Radolffzell</unclear></placeName>
<lb n="61"/><unclear cert="low" resp="#joint">khundtschafftet</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">glichen</unclear>, das Ime bij der <unclear cert="low" resp="#joint">kälten</unclear> der <unclear cert="low" resp="#joint">gfrörne</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">säckh</unclear> des <unclear cert="low" resp="#joint">kornß</unclear> <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">lohe</unclear> <unclear cert="low" resp="#joint">zuefüern</unclear> <unclear cert="low" resp="#joint">verdingt</unclear>, und von jeden
<lb n="63"/>schwären sackh des lesten marckhts allt weg zue landt <unclear cert="low" resp="#joint">fahren</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">mueßten</unclear>, <unclear cert="low" resp="#joint">fuohrlohn</unclear> <unclear cert="low" resp="#joint">versprochen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">bezalt</unclear> worden sechst batzen,
<lb n="65"/>unnd dan für den gwonlichen zoll .6. d. Inmassen er zeuug
<lb n="66"/>dem <persName resp="#ner">Jacoben Gmünden</persName> u. so <unclear cert="low" resp="#joint">woln</unclear> <unclear cert="low" resp="#joint">N</unclear>. <unclear cert="low" resp="#joint">von</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>: <unclear cert="low" resp="#joint">Gallen</unclear></placeName> in
<lb n="67"/><unclear cert="low" resp="#joint">sollichen</unclear> <unclear cert="low" resp="#joint">fuohr</unclear> <unclear cert="low" resp="#joint">lohn</unclear> <unclear cert="low" resp="#joint">geholffen</unclear> <unclear cert="low" resp="#joint">sije</unclear>.
<pb facs="StadtASG_Missive_1897_7067.jpg" n="5"/>
<pb facs="StadtASG_Missive_1897_7068.jpg" n="6"/>
<lb n="68"/><unclear cert="medium" resp="#joint">Denen</unclear> Frommen, <unclear cert="low" resp="#joint">Fuersichtigen</unclear>, <unclear cert="low" resp="#joint">Eersamen</unclear>, und <unclear cert="low" resp="#joint">Weisen</unclear>
<lb n="69"/><unclear cert="low" resp="#joint">Herrn</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeisteren</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Rathe</unclear> der Statt
<lb n="70"/><unclear cert="medium" resp="#joint">St</unclear>. Gallen</orgName>, <unclear cert="medium" resp="#joint">Unsern</unclear> <unclear cert="medium" resp="#joint">sonders</unclear> lieben herren und <unclear cert="low" resp="#joint">guotten</unclear>
<lb n="71"/><unclear cert="low" resp="#joint">freuenden</unclear>.
<lb n="72"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
