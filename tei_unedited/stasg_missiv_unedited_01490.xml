<p>
<pb facs="StadtASG_Missive_1490_5359.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> fründtlich willig dienst, sambt was wir
<lb n="2"/><unclear cert="medium" resp="#joint">eren</unclear> liebs und guots <unclear cert="low" resp="#joint">vermögend</unclear> <unclear cert="low" resp="#joint">zuovor</unclear> <unclear cert="low" resp="#joint">from</unclear> für-
<lb n="3"/>sichtig <unclear cert="low" resp="#joint">er</unclear> und <unclear cert="medium" resp="#joint">wis</unclear> <unclear cert="medium" resp="#joint">insonnders</unclear> <unclear cert="medium" resp="#joint">guote</unclear> fründt, <unclear cert="medium" resp="#joint">ge</unclear>-
<lb n="4"/><unclear cert="medium" resp="#joint">trüw</unclear> lieb <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>, Nachdem des hochwür-
<lb n="5"/>digen <unclear cert="low" resp="#joint">fürsten</unclear> unnsers <unclear cert="medium" resp="#joint">gnedigen</unclear> herren <unclear cert="medium" resp="#joint">unndt</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">pundtsgenossen</unclear> des <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">prelaten</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">würdigen</unclear>
<lb n="7"/><orgName ref="stadtasg-actors-541" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Gotshuß</unclear> St. Gallen</orgName> <unclear cert="low" resp="#joint">unnderthanen</unclear> der alten Landt-
<lb n="8"/><unclear cert="low" resp="#joint">schafft</unclear>, von <unclear cert="medium" resp="#joint">uralten</unclear> <unclear cert="medium" resp="#joint">christenlicher</unclear> gewonheit her,
<lb n="9"/><unclear cert="medium" resp="#joint">jerlich</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">bestimbter</unclear> <unclear cert="medium" resp="#joint">zit</unclear>, <unclear cert="medium" resp="#joint">da</unclear> <unclear cert="medium" resp="#joint">selbige</unclear> <unclear cert="medium" resp="#joint">gotzhuß</unclear>
<lb n="10"/>S. Gallen alls <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">houbtkilch</unclear> mit <unclear cert="medium" resp="#joint">krützfertten</unclear>,
<lb n="11"/>wie dann <unclear cert="low" resp="#joint">allenthalbenn</unclear> by der catholischen kilchen
<lb n="12"/><unclear cert="low" resp="#joint">ouch</unclear> beschicht <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">besuochen</unclear> pflegendt, und aber
<lb n="13"/><unclear cert="medium" resp="#joint">inen</unclear> <unclear cert="medium" resp="#joint">sidt</unclear> enderung der religion, wenn <unclear cert="medium" resp="#joint">sie</unclear> durch
<lb n="14"/><unclear cert="low" resp="#joint">üwer</unclear> statt (wie dann <unclear cert="medium" resp="#joint">unvermidenlich</unclear> beschehen
<lb n="15"/><unclear cert="medium" resp="#joint">muoß</unclear>) <unclear cert="medium" resp="#joint">reisend</unclear>, nit mer <unclear cert="medium" resp="#joint">gestattet</unclear> werdten,
<lb n="16"/>die christenlichen zeichen wie das <unclear cert="low" resp="#joint">brüchlich</unclear>, undt
<lb n="17"/><unclear cert="low" resp="#joint">zuovor</unclear> <unclear cert="low" resp="#joint">iederzit</unclear> in <unclear cert="low" resp="#joint">üebung</unclear> gsin, <unclear cert="low" resp="#joint">offentlich</unclear> undt
<lb n="18"/><unclear cert="low" resp="#joint">ufrecht</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> tragen, <unclear cert="low" resp="#joint">sind</unclear> wir von Ir fr. <unclear cert="medium" resp="#joint">G</unclear>. und
<lb n="19"/>derselben guoten <unclear cert="low" resp="#joint">erlichen</unclear> <unclear cert="low" resp="#joint">lüten</unclear> wegen <unclear cert="medium" resp="#joint">angesuocht</unclear>
<lb n="20"/>wordten, an <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. E. langen <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">lassenn</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">sittenmal</unclear> <unclear cert="low" resp="#joint">inen</unclear> solches beschwerlich, und <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">khleinerung</unclear> <unclear cert="low" resp="#joint">reicht</unclear>, ir <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">fründtlich</unclear> dahin begeben,
<lb n="23"/>und uns <unclear cert="medium" resp="#joint">zeeren</unclear> und <unclear cert="medium" resp="#joint">gefallen</unclear> hierinn <unclear cert="low" resp="#joint">insehen</unclear>,
<lb n="24"/><unclear cert="low" resp="#joint">gestatten</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">soliche</unclear> <unclear cert="low" resp="#joint">nüwerung</unclear> <unclear cert="low" resp="#joint">abstellen</unclear> <unclear cert="low" resp="#joint">wellendt</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">soll</unclear> <unclear cert="low" resp="#joint">hingegen</unclear> <unclear cert="low" resp="#joint">zwüschen</unclear> alle bescheidenheit gehalten
<lb n="26"/>und <unclear cert="medium" resp="#joint">zuo</unclear> billichem klagen kein ursach <unclear cert="low" resp="#joint">geben</unclear> werden.
<pb facs="StadtASG_Missive_1490_5360.jpg" n="2"/>
<lb n="27"/>unnd <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">bedenckhen</unclear>, das wir <unclear cert="medium" resp="#joint">üch</unclear> unnd den
<lb n="28"/><unclear cert="low" resp="#joint">üwren</unclear> in vil <unclear cert="low" resp="#joint">hoecheren</unclear> unnd <unclear cert="low" resp="#joint">groeßren</unclear> anligen
<lb n="29"/>(wie <unclear cert="medium" resp="#joint">üch</unclear> noch unvergessen) unnd <unclear cert="low" resp="#joint">besonders</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">nechthin</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">zeiten</unclear> gegen <persName resp="#ner">B. H.</persName> uff herren <persName resp="#ner">Car</persName>=
<lb n="31"/>dinaelen unnd anderen, in dem geschefft gegen
<lb n="32"/>der Inquisition mit gantz <unclear cert="low" resp="#joint">guettem</unclear> <unclear cert="low" resp="#joint">hertzen</unclear> unnd
<lb n="33"/><unclear cert="low" resp="#joint">Eidtgnoeßischem</unclear> <unclear cert="low" resp="#joint">gemueth</unclear>. <unclear cert="low" resp="#joint">befürderen</unclear> <unclear cert="low" resp="#joint">syn</unclear> <unclear cert="low" resp="#joint">gewest</unclear>,
<lb n="34"/>die <unclear cert="low" resp="#joint">üwren</unclear> <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">deßen</unclear> wol <unclear cert="low" resp="#joint">genoßen</unclear>, unnd wir
<lb n="35"/><unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">auch</unclear> noch witers urbiittig, Inmaßen das
<lb n="36"/>wir uns <unclear cert="low" resp="#joint">einichen</unclear> zweiffel machendt, einicher
<lb n="37"/><unclear cert="low" resp="#joint">verwegerung</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> neben dem wir es zuo an=
<lb n="38"/>derer <unclear cert="low" resp="#joint">fründtschafft</unclear> <unclear cert="low" resp="#joint">uffnemmen</unclear>, werden ir uns
<lb n="39"/>auch alzeit <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">bewißung</unclear> aller <unclear cert="low" resp="#joint">Eidtgnoeßischer</unclear>
<lb n="40"/>fründtschafft lieb unnd diensten geneigt haben.
<lb n="41"/>unß allen damit <unclear cert="low" resp="#joint">goetlicher</unclear> <unclear cert="low" resp="#joint">gnaden</unclear> <unclear cert="low" resp="#joint">bevelchende</unclear>.
<lb n="42"/>datum unnd in unser aller <unclear cert="medium" resp="#joint">nammen</unclear> mit <unclear cert="low" resp="#joint">üwer</unclear>
<lb n="43"/>unnd unser G. L. E. <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">statt</unclear> <placeName ref="stadtasg-places-69" cert="medium" resp="#ner">Lucern</placeName> secret
<lb n="44"/>Insigel verschloßen, <origDate when="1605-11-06" resp="#ner">den 6. tag Novembris
<lb n="45"/>Anno 1605</origDate>.
<lb n="46"/><orgName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Schultheißen</unclear>, Landtaman unnd
<lb n="47"/><unclear cert="low" resp="#joint">Räth</unclear> der acht Catholischen orten
<lb n="48"/>der</orgName> <orgName ref="stadtasg-actors-750" cert="medium" role="issuer" resp="#ner">Eidtgnoßschafft</orgName>, <placeName ref="stadtasg-places-69" cert="medium" resp="#ner">Lucern</placeName>,
<lb n="49"/><placeName ref="stadtasg-places-70" cert="medium" resp="#ner">Ury</placeName>, <placeName ref="stadtasg-places-71" cert="medium" resp="#ner">Schwitz</placeName>, <placeName ref="stadtasg-places-72" cert="medium" resp="#ner">Underwalden</placeName>,
