<p>
<pb facs="StadtASG_Missive_1966_7307.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freündt</unclear>: <unclear cert="low" resp="#joint">nachparlich</unclear> unnd <unclear cert="medium" resp="#joint">guotwill</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">lige</unclear> dienst zuvor, fürsichtige, <unclear cert="medium" resp="#joint">ehrsame</unclear>, <unclear cert="medium" resp="#joint">wei</unclear>-
<lb n="3"/><unclear cert="medium" resp="#joint">se</unclear> besonders liebe freünd unnd <unclear cert="medium" resp="#joint">guote</unclear> nach-
<lb n="4"/><unclear cert="medium" resp="#joint">parn</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Ewer</unclear> <unclear cert="medium" resp="#joint">überschickhte</unclear>, <unclear cert="medium" resp="#joint">newe</unclear> <unclear cert="medium" resp="#joint">Müntzordnung</unclear>,
<lb n="6"/><unclear cert="medium" resp="#joint">habend</unclear> wir <unclear cert="medium" resp="#joint">ordenlich</unclear> empfangen, unnd
<lb n="7"/>weilen wir <unclear cert="medium" resp="#joint">hiebey</unclear> <unclear cert="medium" resp="#joint">eweren</unclear> <unclear cert="medium" resp="#joint">nachparlichen</unclear>
<lb n="8"/>guoten willen <unclear cert="low" resp="#joint">zueverspüren</unclear>, <unclear cert="low" resp="#joint">thuen</unclear> wir
<lb n="9"/>unns deßen <unclear cert="medium" resp="#joint">freündt</unclear>: nachparlichen be-
<lb n="10"/><unclear cert="medium" resp="#joint">danckhen</unclear>, <unclear cert="medium" resp="#joint">mit</unclear> <unclear cert="medium" resp="#joint">nachparlichem</unclear> <unclear cert="medium" resp="#joint">erbietten</unclear>,
<lb n="11"/><unclear cert="medium" resp="#joint">wa</unclear> wir Euch in <unclear cert="medium" resp="#joint">gleichem</unclear> unnd <unclear cert="medium" resp="#joint">anderem</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">nachparliches</unclear> belieben erweisen <unclear cert="medium" resp="#joint">khünden</unclear>,
<lb n="13"/>sollet Ir unns <unclear cert="medium" resp="#joint">zuenachparlicher</unclear> <unclear cert="medium" resp="#joint">guoter</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">Correspondentz</unclear> yeder <unclear cert="medium" resp="#joint">zeit</unclear> <unclear cert="medium" resp="#joint">vorders</unclear> <unclear cert="medium" resp="#joint">willig</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">zebefinden</unclear> haben. <unclear cert="medium" resp="#joint">Act</unclear>. <origDate when="1615-09-02" resp="#ner">2. <unclear cert="medium" resp="#joint">Septb</unclear>. <unclear cert="medium" resp="#joint">A°</unclear> 1615</origDate>.
<lb n="16"/><orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner">Verwalter <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">haubtman</unclear>-
<lb n="17"/><unclear cert="medium" resp="#joint">schaft</unclear> burgermaister und
<lb n="18"/>Rath der Statt <unclear cert="medium" resp="#joint">Costantz</unclear></orgName>.
<pb facs="StadtASG_Missive_1966_7308.jpg" n="2"/>
<pb facs="StadtASG_Missive_1966_7309.jpg" n="3"/>
<pb facs="StadtASG_Missive_1966_7310.jpg" n="4"/>
<lb n="19"/>Denen fuersichtigen ersamen unnd weyßen
<lb n="20"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister unnd Rhat zuo <unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></orgName>
<lb n="21"/><unclear cert="low" resp="#joint">unßern</unclear> <unclear cert="low" resp="#joint">besonders</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">freundt</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">gue</unclear>-
<lb n="22"/>ten nachparn.
</p>
