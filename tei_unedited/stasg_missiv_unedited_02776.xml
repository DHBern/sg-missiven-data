<lb n="6"/>Alle <unclear cert="medium" resp="#joint">kleider</unclear> und <unclear cert="medium" resp="#joint">anders</unclear> so ich mit mir <unclear cert="medium" resp="#joint">härgebracht</unclear> han, <unclear cert="medium" resp="#joint">nütit</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">ußgenomen</unclear>, dann der <unclear cert="low" resp="#joint">kißenbethen</unclear>, <unclear cert="low" resp="#joint">myn</unclear> <unclear cert="low" resp="#joint">wyße</unclear> <unclear cert="low" resp="#joint">Schluethen</unclear>,
