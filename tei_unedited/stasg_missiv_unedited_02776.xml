<lb n="3"/><unclear cert="medium" resp="#joint">heimbgesucht</unclear>, so ist <unclear cert="medium" resp="#joint">also</unclear> <unclear cert="medium" resp="#joint">myn</unclear> <unclear cert="medium" resp="#joint">letster</unclear> will und meinung, das
<lb n="4"/>man nach mynem <unclear cert="medium" resp="#joint">dötlichen</unclear> <unclear cert="medium" resp="#joint">hinscheiden</unclear> <unclear cert="medium" resp="#joint">söll</unclear> volgen <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">volg</unclear>,
