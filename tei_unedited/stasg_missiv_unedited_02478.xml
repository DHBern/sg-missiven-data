<pb facs="StadtASG_Missive_2478_9550.jpg" n="2"/>
<pb facs="StadtASG_Missive_2478_9551.jpg" n="3"/>
<lb n="26"/>Copia.
<lb n="27"/><persName role="issuer" resp="#ner">Thoman <unclear cert="low" resp="#joint">Studers</unclear></persName> unnd <persName resp="#ner">Barbara <unclear cert="low" resp="#joint">Kollerin</unclear></persName> als
