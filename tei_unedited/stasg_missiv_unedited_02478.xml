<p>
<pb facs="StadtASG_Missive_2478_9549.jpg" n="1"/>
<lb n="1"/>Edle Veste, <unclear cert="low" resp="#joint">Ehrnveste</unclear>, Fuersichtige Weysse, sonders
<lb n="2"/>liebe Herren, <unclear cert="low" resp="#joint">freündt</unclear> unnd nachparen, denselben seyen
<lb n="3"/>meine <unclear cert="low" resp="#joint">freündt</unclear> <unclear cert="medium" resp="#joint">nachparliche</unclear> dienst unnd grueß
<lb n="4"/>zuvor p.
<lb n="5"/><unclear cert="low" resp="#joint">Den</unclear> Herren <unclear cert="medium" resp="#joint">Nachparen</unclear> hab ich uff ihr an herren
<lb n="6"/><persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Zandren</unclear></persName> <unclear cert="medium" resp="#joint">vogten</unclear> uff der <placeName ref="stadtasg-places-296" cert="medium" resp="#ner">Eggen</placeName>, abgangnes
<lb n="7"/>unnd hernach von ime <unclear cert="low" resp="#joint">Zandren</unclear> (<unclear cert="low" resp="#joint">weil</unclear> die begerte
<lb n="8"/>verrichtung der <unclear cert="medium" resp="#joint">hochen</unclear> oberkeit zuegehoerig) mir
<lb n="9"/><unclear cert="low" resp="#joint">überschickhtes</unclear> schreiben, zue begerter antwurt nit
<lb n="10"/>verhalten <unclear cert="low" resp="#joint">woellen</unclear>; daß ich <persName resp="#ner"><unclear cert="low" resp="#joint">Thoman</unclear> <unclear cert="low" resp="#joint">Schloehner</unclear></persName>
<lb n="11"/>unnd sein <unclear cert="low" resp="#joint">haußfrawen</unclear> für mich nach <placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Costanz</unclear></placeName> in
<lb n="12"/><unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">Wiertzhauß</unclear> <placeName ref="stadtasg-places-255" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Crentzlingen</unclear></placeName> <unclear cert="low" resp="#joint">Citieren</unclear>, <unclear cert="low" resp="#joint">weil</unclear> <unclear cert="medium" resp="#joint">sy</unclear> aber
<lb n="13"/>vor <unclear cert="low" resp="#joint">meinem</unclear> unnd meiner <unclear cert="low" resp="#joint">ambtleüthen</unclear> <unclear cert="low" resp="#joint">hinwegreysen</unclear>
<lb n="14"/>nit <unclear cert="medium" resp="#joint">erschinen</unclear>, durch andere verordnete examinieren
<lb n="15"/>lassen, welche ußgesagt, wie die Herren Nachparen
<lb n="16"/><unclear cert="medium" resp="#joint">hiebeygschlossen</unclear>, <unclear cert="medium" resp="#joint">zueempfachen</unclear> habendt. <unclear cert="low" resp="#joint">Ersueche</unclear> die=
<lb n="17"/>selben <unclear cert="medium" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">sye</unclear> <unclear cert="medium" resp="#joint">woellendt</unclear> <unclear cert="medium" resp="#joint">dz</unclear> ienige so
<lb n="18"/><unclear cert="low" resp="#joint">weiters</unclear> <unclear cert="low" resp="#joint">ernenter</unclear> <unclear cert="medium" resp="#joint">malificant</unclear> an der <unclear cert="medium" resp="#joint">Tortur</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">willig</unclear> uff dise <unclear cert="low" resp="#joint">Persohnen</unclear> <unclear cert="low" resp="#joint">bekhenen</unclear> <unclear cert="medium" resp="#joint">moechten</unclear>,
<lb n="20"/>mir <unclear cert="medium" resp="#joint">nachparlich</unclear> ze comunicieren. <unclear cert="medium" resp="#joint">Daß</unclear> <unclear cert="low" resp="#joint">soth</unclear> umb
<lb n="21"/>die Herren <unclear cert="medium" resp="#joint">Nachparen</unclear> <unclear cert="low" resp="#joint">Jn</unclear> <unclear cert="medium" resp="#joint">begebenden</unclear> fellen, <unclear cert="medium" resp="#joint">zueerwidern</unclear>.
<lb n="22"/>Datum <origPlace ref="stadtasg-places-29" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Frawenfeldt</unclear></origPlace>. <origDate when="1624-03-28" resp="#ner">den 28 <unclear cert="low" resp="#joint">ten</unclear> Martij <unclear cert="low" resp="#joint">Ao</unclear> <unclear cert="low" resp="#joint">p</unclear> 1624</origDate>.
