<lb n="39"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Thoeni</unclear> Jaglis Sohn</persName> genant, <unclear cert="low" resp="#joint">gewahret</unclear>, das <unclear cert="low" resp="#joint">tuoch</unclear>
