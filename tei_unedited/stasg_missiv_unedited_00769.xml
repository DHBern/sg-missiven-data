<lb n="26"/>unnd <unclear cert="medium" resp="#joint">wÿsen</unclear>. <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeÿster</unclear> unnd Rath der Statt <unclear cert="medium" resp="#joint">Sannct</unclear> Gallen</orgName>.
