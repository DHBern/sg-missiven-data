    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2393_9187.jpg" n="1"/>
<lb n="1"/>Unser früntt- nachbarlich und guottwillig
<lb n="2"/>dienst zuvor, <unclear cert="low" resp="#joint">Eerenvesste</unclear>, <unclear cert="low" resp="#joint">Fürsichtige</unclear>, <unclear cert="low" resp="#joint">Eersame</unclear>
<lb n="3"/>und Weyse, insonders liebe guotte Fründe und <unclear cert="low" resp="#joint">Nachbarn</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Derselben</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">ihres</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">langdr</unclear> <unclear cert="low" resp="#joint">hernschfft</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">verhafften</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Melchiors</unclear> <unclear cert="low" resp="#joint">Pfisters</unclear></persName> <unclear cert="low" resp="#joint">abermalß</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">abgangen</unclear> <unclear cert="low" resp="#joint">fründt</unclear>- <unclear cert="low" resp="#joint">nachbarlich</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">schreiben</unclear> und begeren, haben wir sambt
<lb n="8"/>den Inlagen nachts Eebendts umb 4 <unclear cert="low" resp="#joint">uhren</unclear>
<lb n="9"/>von weisern ihren Abgefertigten Botten
<lb n="10"/>wolh empfangen, und <unclear cert="low" resp="#joint">ablesendtlich</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">verstanden</unclear>. <unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">nicht</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">minder</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">nochmahln</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">frischem</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">gewiß</unclear>, <unclear cert="low" resp="#joint">wasmaßen</unclear> wir nülchlich
<lb n="14"/>E. E. F. E. Wht. uff derselben <unclear cert="low" resp="#joint">erstes</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">gethanes</unclear> <unclear cert="low" resp="#joint">schreiben</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">anthwurt</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">zuokhomen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">berte</unclear> <unclear cert="low" resp="#joint">angezogne</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">bürgen</unclear> <unclear cert="low" resp="#joint">Iroes</unclear> <unclear cert="low" resp="#joint">Abbt</unclear> <unclear cert="low" resp="#joint">Iherß</unclear> <unclear cert="low" resp="#joint">bestendten</unclear> <unclear cert="low" resp="#joint">knechts</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">halben</unclear> <unclear cert="low" resp="#joint">selbst</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">ußschuß</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">selbsten</unclear> <unclear cert="low" resp="#joint">stellen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">Iherß</unclear> <unclear cert="low" resp="#joint">theil</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">zuoeröffnen</unclear> <unclear cert="low" resp="#joint">willens</unclear> <unclear cert="low" resp="#joint">seige</unclear>, <unclear cert="low" resp="#joint">da</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">anderst</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">vermeint</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">werde</unclear> <unclear cert="low" resp="#joint">derselbige</unclear> <unclear cert="low" resp="#joint">glechergsiniem</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">anerbietten</unclear> nach <unclear cert="low" resp="#joint">erschienen</unclear> <unclear cert="low" resp="#joint">sin</unclear> und allen
<lb n="24"/>mündtlichen bericht <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">haben</unclear>.
<pb facs="StadtASG_Missive_2393_9188.jpg" n="2"/>
<lb n="25"/>Diewil aber solchs leider biß daher noch
<lb n="26"/>nicht entricht, haben wir es mit
<lb n="27"/>mitthailung warnung,
<lb n="28"/>damit wir
<lb n="29"/>Ihrer f. gn. zuo uebel
<lb n="30"/>Ihren Ertzh. treuwlicher gebuer nach
<lb n="31"/>nicht zehl.
<lb n="32"/>Uff welches wir dann nicht ermanglet
<lb n="33"/>Jhr Lbt. uff dato fuerohin lauth ver-
<lb n="34"/>ordneten überfuergl. und Ihm auch alle
<lb n="35"/>erstrengl. in dz herst, dz Ihm ahn dero-
<lb n="36"/>selben schriben sambt dem Jnschlusß zu-
<lb n="37"/>fuergen zulassen, der sich dann
<lb n="38"/>anfenglichs zum hoechsten entschuldiget
<lb n="39"/>hinder mich erschinet mit fuergeben, dasß Er hievon nicht
<lb n="40"/>anderst vermeint, dann das
<lb n="41"/>er in dz herbst sich naher <placeName resp="#ner">Radolffszell</placeName>
<lb n="42"/>seiner anererbten lufft nach begeben welle, nach dem Er aber
<lb n="43"/>sich besinnt, wasß für beschwerden
<lb n="44"/>villeicht über In gehen, und Er umb
<lb n="45"/>deßwegen nicht aigentlich wüssen khuenne
<pb facs="StadtASG_Missive_2393_9189.jpg" n="3"/>
<lb n="46"/><unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">iro</unclear> <unclear cert="low" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rorschach</unclear></placeName> <unclear cert="low" resp="#joint">vorstehn</unclear>, <unclear cert="low" resp="#joint">hette</unclear> er
<lb n="47"/>zu <unclear cert="medium" resp="#joint">vernemen</unclear> sich <unclear cert="low" resp="#joint">bester</unclear> <unclear cert="low" resp="#joint">erfaren</unclear>, und
<lb n="48"/>zu dem Ende <unclear cert="low" resp="#joint">besagtem</unclear> <unclear cert="low" resp="#joint">Weitkher</unclear> <unclear cert="low" resp="#joint">ad</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">Informationem</unclear> <unclear cert="low" resp="#joint">kommen</unclear> <unclear cert="low" resp="#joint">konnen</unclear>.
<lb n="50"/><unclear cert="low" resp="#joint">Welches</unclear> der <unclear cert="low" resp="#joint">hofmarschakh</unclear> <unclear cert="low" resp="#joint">erholl</unclear>, und
<lb n="51"/><unclear cert="low" resp="#joint">dieweil</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">keines</unclear> <unclear cert="low" resp="#joint">gwußern</unclear> <unclear cert="low" resp="#joint">aufsehens</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">beimig</unclear>, <unclear cert="low" resp="#joint">hatete</unclear> er die <unclear cert="low" resp="#joint">Sachen</unclear> <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">bis</unclear> <unclear cert="low" resp="#joint">dato</unclear> <unclear cert="low" resp="#joint">also</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">beruwen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">Iher</unclear> <unclear cert="low" resp="#joint">hochft</unclear>. <unclear cert="low" resp="#joint">willen</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">unterthenig</unclear> <unclear cert="low" resp="#joint">pitt</unclear>, <unclear cert="low" resp="#joint">weil</unclear> er sich <unclear cert="low" resp="#joint">hierinn</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">soweit</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">bedacht</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">wolten</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">iro</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">khiste</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">stifft</unclear> <unclear cert="low" resp="#joint">Amthuß</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">ihro</unclear> <unclear cert="low" resp="#joint">gethanen</unclear> <unclear cert="low" resp="#joint">Verspruch</unclear> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">Verantwortung</unclear> <unclear cert="low" resp="#joint">angehört</unclear>, <unclear cert="low" resp="#joint">wofern</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">nochmahls</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">zugesprochen</unclear> sich zu stellen, und <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">die</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">Sach</unclear> <unclear cert="low" resp="#joint">beschaffen</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="low" resp="#joint">alda</unclear> <unclear cert="low" resp="#joint">komende</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">nochmahlen</unclear> <unclear cert="low" resp="#joint">grundliche</unclear> <unclear cert="low" resp="#joint">relation</unclear> <unclear cert="low" resp="#joint">ze</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">beicht</unclear> <unclear cert="low" resp="#joint">zethun</unclear>, Er <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">höchlich</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">beschwert</unclear>, <unclear cert="low" resp="#joint">solchs</unclear> <unclear cert="low" resp="#joint">ihm</unclear> <unclear cert="low" resp="#joint">sethals</unclear> <unclear cert="low" resp="#joint">selbs</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">dieweil</unclear> <unclear cert="low" resp="#joint">sonderlich</unclear> <unclear cert="low" resp="#joint">Ihnen</unclear> <unclear cert="low" resp="#joint">unglükh</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">nich</unclear> zu wider zu <unclear cert="low" resp="#joint">lauffen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">sy</unclear>
<lb n="66"/><unclear cert="low" resp="#joint">mediante</unclear> <unclear cert="low" resp="#joint">Juramento</unclear> de hoc <unclear cert="low" resp="#joint">puncto</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">vorhin</unclear>, und <unclear cert="low" resp="#joint">alsdan</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Ihm</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">nochlost</unclear> <unclear cert="low" resp="#joint">zugeschikht</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">möchte</unclear>
<lb n="69"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">veriters</unclear> <unclear cert="low" resp="#joint">disen</unclear> <unclear cert="low" resp="#joint">berich</unclear> <unclear cert="low" resp="#joint">wollen</unclear> <unclear cert="low" resp="#joint">thuen</unclear>, <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">ihro</unclear>
<pb facs="StadtASG_Missive_2393_9190.jpg" n="4"/>
<lb n="70"/>legitimè et ex tractu
<lb n="71"/>hiraub et Ehist, wie es
<lb n="72"/>wie soalichs selbst gezeugt
<lb n="73"/>secretinsigill zuleget werden khan.
<lb n="74"/>So wir ihnen vff ihr fr. nachbarlich
<lb n="75"/>begeren zu widerantwurt nit verhalten
<lb n="76"/>vnd denen selben zugevallen bey obange-
<lb n="77"/>gemelt deuten ihren pothen ubersenden sollen.
<lb n="78"/>Den E. E. et Ft. C. Wht. in
<lb n="79"/>dergleichen et allen anderen zuetragenden
<lb n="80"/>vnd begebenden occasionen allen angenehmen willen,
<lb n="81"/>willfahrige dienst frl. nachbarlichen willen
<lb n="82"/>zu erweisen, sinde wir
<lb n="83"/>so bereitig et wolgeneigt, deß wir
<lb n="84"/>gott bitten, daß er vns samptlich
<lb n="85"/>in seinem gnaden schirm frewen vnd
<lb n="86"/>vatterlich wolle erhalten. Datum
<lb n="87"/><origDate when="1623" resp="#ner">den 2.ten Februarij anno 1623</origDate>
<lb n="88"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. vnd Rhat
<lb n="89"/>der Statt StGallen</orgName>.
<lb n="90"/>An h. <orgName ref="stadtasg-actors-508" cert="medium" role="recipient" resp="#ner">Burgermeister et
<lb n="91"/>Rhat der Statt Radolffszell</orgName>.
</p>
