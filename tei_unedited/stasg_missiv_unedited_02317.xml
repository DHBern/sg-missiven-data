    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2317_8839.jpg" n="1"/>
<lb n="1"/>Unnßer fründtlich willig diennst, unnd waß wir
<lb n="2"/>ehren liebs unnd guots <unclear cert="low" resp="#joint">vermoegend</unclear>, <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">wünschung</unclear> <unclear cert="low" resp="#joint">eines</unclear>
<lb n="3"/>guoten <unclear cert="low" resp="#joint">glückhseligen</unclear> <unclear cert="low" resp="#joint">fridsamen</unclear> <unclear cert="low" resp="#joint">neüwen</unclear> <unclear cert="low" resp="#joint">jahrs</unclear>, <unclear cert="low" resp="#joint">zuvor</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">from</unclear> <unclear cert="low" resp="#joint">fürsichtig</unclear> <unclear cert="low" resp="#joint">ehrsam</unclear> <unclear cert="low" resp="#joint">weyß</unclear>, innsonders <unclear cert="low" resp="#joint">guot</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">fründt</unclear> unnd <unclear cert="low" resp="#joint">getrüw</unclear> <unclear cert="low" resp="#joint">lieb</unclear> <orgName resp="#ner"><unclear cert="low" resp="#joint">Eydtgnoßen</unclear></orgName>. <unclear cert="low" resp="#joint">Demnach</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">schreiben</unclear> <unclear cert="low" resp="#joint">zuokomen</unclear>, so herr Guobernator und
<lb n="7"/>parlament zuo <placeName resp="#ner">Dol</placeName> inn der graffschafft <placeName ref="stadtasg-places-281" cert="medium" resp="#ner">Burgund</placeName>
<lb n="8"/>von <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Manßfeldischen</unclear> <unclear cert="low" resp="#joint">kriegs</unclear> <unclear cert="low" resp="#joint">volckhs</unclear> <unclear cert="low" resp="#joint">wegen</unclear>, <unclear cert="low" resp="#joint">an</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">gemeine</unclear> <unclear cert="low" resp="#joint">13</unclear>. <unclear cert="low" resp="#joint">ohrt</unclear> der <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eydtgnoßschafft</orgName> abgehn laßen,
<lb n="10"/>habend wir nit ermanglen wöllen, <unclear cert="low" resp="#joint">deßselben</unclear>
<lb n="11"/>durch beyligende abschrifft der gepür nach <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">theil</unclear>-
<lb n="12"/><unclear cert="low" resp="#joint">hafft</unclear> <unclear cert="low" resp="#joint">zemachen</unclear>. Unnd habend wir den gemelten
<lb n="13"/>herren inn <placeName ref="stadtasg-places-281" cert="medium" resp="#ner">Burgund</placeName> <unclear cert="low" resp="#joint">gleich</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">ihrne</unclear> <unclear cert="low" resp="#joint">potten</unclear> <unclear cert="low" resp="#joint">den</unclear>
<lb n="14"/>bescheid hinwider erfolgen laßen, ds wir geneigt sygen,
<lb n="15"/>diß ihrs schreibens üch unnd übrige unßere liebe
<lb n="16"/><orgName resp="#ner">Eydtgnoßen</orgName> auch <unclear cert="low" resp="#joint">zuoverstendigen</unclear>, unnd unß mit den-
<lb n="17"/>selben fürobas iederzeit der Erbeinigung und <unclear cert="low" resp="#joint">gepür</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">gemeeß</unclear> <unclear cert="low" resp="#joint">zuoerzeigen</unclear>, und gemeine ruow und <unclear cert="low" resp="#joint">wohlfahrt</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">erhalten</unclear> <unclear cert="low" resp="#joint">zehelffen</unclear>, darbey uns <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">herr</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">witter</unclear> sambtlich <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">schirm</unclear> <unclear cert="low" resp="#joint">bewahren</unclear> <unclear cert="low" resp="#joint">wölle</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">Datt</unclear> den <origDate when="1621-12-29" resp="#ner">29ten decembris anno 1621</origDate>.
<lb n="22"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister unnd
<lb n="23"/>rhat der statt Zürich</orgName>.
<lb n="24"/><unclear cert="low" resp="#joint">Den</unclear> <orgName ref="stadtasg-actors-773" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Landaman</unclear> unnd Rhat
<lb n="25"/>der <unclear cert="low" resp="#joint">ußeren</unclear> <unclear cert="low" resp="#joint">Roden</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">landts</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">Appenzell</unclear></orgName>.
<pb facs="StadtASG_Missive_2317_8840.jpg" n="2"/>
<lb n="27"/><unclear cert="low" resp="#joint">An</unclear> <unclear cert="low" resp="#joint">ußroedischen</unclear> <origPlace ref="stadtasg-places-8" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Appenzell</unclear></origPlace>.
<lb n="28"/><origDate when="1621" resp="#ner">27. <unclear cert="medium" resp="#joint">xbris</unclear> 1621</origDate>.
<lb n="29"/><unclear cert="medium" resp="#joint">belangend</unclear> <unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">burgundische</unclear> schriben an die <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydt</unclear>-
<lb n="30"/><unclear cert="low" resp="#joint">gnoßschaft</unclear></orgName> <unclear cert="low" resp="#joint">gmeiner</unclear> <unclear cert="low" resp="#joint">13</unclear>. <unclear cert="low" resp="#joint">orthen</unclear> <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Doll</unclear></placeName> <unclear cert="low" resp="#joint">abgangen</unclear> <unclear cert="low" resp="#joint">von</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">gubernator</unclear> <unclear cert="low" resp="#joint">daselbs</unclear> unnd <unclear cert="low" resp="#joint">parlament</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">wegen</unclear> des <unclear cert="low" resp="#joint">Manßfeldischen</unclear> <unclear cert="low" resp="#joint">kriegs</unclear>-
<lb n="33"/><unclear cert="low" resp="#joint">volkhs</unclear>.
</p>
