<lb n="25"/><unclear cert="medium" resp="#joint">Buehler</unclear></persName> disem <unclear cert="medium" resp="#joint">gschäfft</unclear> <unclear cert="medium" resp="#joint">nachzesetzen</unclear> abge=
<lb n="26"/><unclear cert="medium" resp="#joint">fertiget</unclear> <unclear cert="medium" resp="#joint">worden</unclear>, So haben wir
<lb n="27"/><unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">woellen</unclear> <unclear cert="medium" resp="#joint">ermanglen</unclear>, <unclear cert="medium" resp="#joint">ihne</unclear> mit disem
<lb n="28"/>unserm <unclear cert="medium" resp="#joint">beßere</unclear> <unclear cert="medium" resp="#joint">meinung</unclear> <unclear cert="medium" resp="#joint">mitgteiltem</unclear> <unclear cert="medium" resp="#joint">fuer=</unclear>
<lb n="29"/>schreiben <unclear cert="medium" resp="#joint">zubegleiten</unclear> <unclear cert="medium" resp="#joint">zubegleiten</unclear>.
<lb n="30"/><unclear cert="medium" resp="#joint">Gelangt</unclear> <unclear cert="medium" resp="#joint">derohalben</unclear> an <unclear cert="medium" resp="#joint">eüch</unclear> unser <unclear cert="medium" resp="#joint">getreüw=</unclear>
<pb facs="StadtASG_Missive_1826_6776.jpg" n="2"/>
<lb n="31"/>lieb <unclear cert="medium" resp="#joint">nachbarn</unclear>, ihr <unclear cert="medium" resp="#joint">wellet</unclear> nit allein <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">eürem</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">getreüwen</unclear> lieben <unclear cert="medium" resp="#joint">mitburgeren</unclear> dem ehren-
<lb n="33"/>vesten fürnemen herren <persName resp="#ner"><unclear cert="medium" resp="#joint">N</unclear>. <unclear cert="medium" resp="#joint">Hetlinger</unclear></persName>
<lb n="34"/><unclear cert="medium" resp="#joint">landtschreiberen</unclear>, und <unclear cert="medium" resp="#joint">anderen</unclear> <unclear cert="medium" resp="#joint">persohnen</unclear>,
<lb n="35"/>so <unclear cert="low" resp="#joint">hiervon</unclear> wüssenschafft haben möchten,
<lb n="36"/><unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">ander</unclear> von <unclear cert="medium" resp="#joint">oberkeits</unclear> wegen die anstellung <unclear cert="low" resp="#joint">thuen</unclear>,
