<lb n="23"/><unclear cert="low" resp="#joint">zeiger</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">getreüwer</unclear> <unclear cert="low" resp="#joint">lieber</unclear> statt=
