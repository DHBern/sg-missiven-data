<lb n="38"/><unclear cert="medium" resp="#joint">gerten</unclear> <unclear cert="medium" resp="#joint">bericht</unclear> <unclear cert="medium" resp="#joint">uns</unclear> schrifftlich besiglet
<lb n="39"/><unclear cert="medium" resp="#joint">fürlegen</unclear> <unclear cert="medium" resp="#joint">könne</unclear>, wie wir nit
<lb n="40"/><unclear cert="medium" resp="#joint">zweiflen</unclear> ihr <unclear cert="medium" resp="#joint">hierzue</unclear> nit <unclear cert="medium" resp="#joint">ungeneigt</unclear> <unclear cert="medium" resp="#joint">seÿn</unclear>
<lb n="41"/>werden. Daß <unclear cert="medium" resp="#joint">begeren</unclear> wir <unclear cert="medium" resp="#joint">in</unclear>
<lb n="42"/><unclear cert="medium" resp="#joint">gleichem</unclear> und <unclear cert="low" resp="#joint">mehrerm</unclear> <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">zutragende</unclear>
<lb n="43"/>begebenheiten mit so begierigem willen
<lb n="44"/><unclear cert="medium" resp="#joint">zeerwideren</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> wir <unclear cert="medium" resp="#joint">eüch</unclear> und <unclear cert="medium" resp="#joint">unß</unclear>
<lb n="45"/>dem schirm <unclear cert="medium" resp="#joint">deß</unclear> Allmechtigen <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">be</unclear>-
<lb n="46"/><unclear cert="medium" resp="#joint">harrender</unclear> <unclear cert="medium" resp="#joint">wolfart</unclear> <unclear cert="medium" resp="#joint">in</unclear> <unclear cert="medium" resp="#joint">treüwen</unclear>
