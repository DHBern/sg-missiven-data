<p>
<pb facs="StadtASG_Missive_1826_6775.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freundt</unclear> nachbarlich willig <unclear cert="medium" resp="#joint">dinst</unclear>, und
<lb n="2"/>was wir ehren liebs und guots <unclear cert="medium" resp="#joint">vermoegen</unclear>, zuvor,
<lb n="3"/><unclear cert="medium" resp="#joint">fromen</unclear> <unclear cert="medium" resp="#joint">fuersichtigen</unclear>, ersamen und weisen,
<lb n="4"/>insonders guoten <unclear cert="medium" resp="#joint">freunden</unclear> und <unclear cert="medium" resp="#joint">getreüwen</unclear>
<lb n="5"/>lieben <unclear cert="medium" resp="#joint">nachbarn</unclear>.
<lb n="6"/>Was <unclear cert="low" resp="#joint">leidigen</unclear> <unclear cert="low" resp="#joint">fallaments</unclear>, sich <unclear cert="low" resp="#joint">kurtzver=</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">ruckter</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">außgewichenn</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">burgern</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear> <unclear cert="low" resp="#joint">Heinrich</unclear> <unclear cert="low" resp="#joint">Scherer</unclear></persName> <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">Kromen</unclear></persName> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">mitverwandten</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">zuogetragen</unclear>,
<lb n="10"/>ist <unclear cert="medium" resp="#joint">euch</unclear> <unclear cert="medium" resp="#joint">albereit</unclear> vor disem wol <unclear cert="medium" resp="#joint">fuerkomen</unclear>,
<lb n="11"/><unclear cert="medium" resp="#joint">Sintmalen</unclear> dann <unclear cert="medium" resp="#joint">nit</unclear> allein den allgemeinen
<lb n="12"/>creditoren, sonder auch <unclear cert="medium" resp="#joint">zugleich</unclear> <unclear cert="medium" resp="#joint">uns</unclear> selbs,
<lb n="13"/>der <unclear cert="medium" resp="#joint">ordenlichen</unclear> oberkeit <unclear cert="medium" resp="#joint">halbs</unclear>, <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">eroerterung</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">dises</unclear> handels, an <unclear cert="medium" resp="#joint">gruendtlichem</unclear> bericht, was
<lb n="15"/><unclear cert="medium" resp="#joint">gemelts</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Christoph</unclear> <unclear cert="medium" resp="#joint">Scherers</unclear></persName> <unclear cert="medium" resp="#joint">eheliche</unclear> <unclear cert="medium" resp="#joint">haußfrauw</unclear>,
<lb n="16"/><unclear cert="medium" resp="#joint">euwer</unclear> <unclear cert="medium" resp="#joint">gewesne</unclear> burgerin, die <unclear cert="medium" resp="#joint">ehrentugend=</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">reich</unclear> frauw <persName resp="#ner">Anna Hettlingerin</persName>, besagtem
<lb n="18"/>ihrem eheman, in die <unclear cert="medium" resp="#joint">ehe</unclear> an <unclear cert="medium" resp="#joint">haab</unclear> und guot zuo=
