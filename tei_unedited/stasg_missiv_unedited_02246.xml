    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2246_8505.jpg" n="1"/>
<lb n="1"/>Unser freundtlich willig dienst
<lb n="2"/>zuvor, Ehrnveste, Fuersichtige
<lb n="3"/>Ehrsame und Weyse, besonders
<lb n="4"/>liebe und guette <unclear cert="low" resp="#joint">Freundt</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">unlängst</unclear> <unclear cert="low" resp="#joint">verschiner</unclear> <unclear cert="low" resp="#joint">zeit</unclear>
<lb n="6"/>unser <unclear cert="low" resp="#joint">lieber</unclear> <unclear cert="low" resp="#joint">Mitbuerger</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Casper</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">Steiner</unclear></persName>, <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">dem</unclear> willen deß
<lb n="8"/>Allmechtigen Gottes, auß <unclear cert="low" resp="#joint">disem</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">jahmerhafften</unclear> <unclear cert="low" resp="#joint">truebseligen</unclear> <unclear cert="low" resp="#joint">leben</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">wehrenden</unclear> <unclear cert="low" resp="#joint">himlischen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">freuedt</unclear> <unclear cert="low" resp="#joint">abgescheiden</unclear>, <unclear cert="low" resp="#joint">deme</unclear>
<lb n="12"/>Gott <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">froeliche</unclear> <unclear cert="low" resp="#joint">ufferstehung</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">uns</unclear> allen zu seiner zeit
<lb n="14"/>ein christlichs seligs endt
<lb n="15"/>gnedigclich verleihen woelle.
<lb n="16"/>Wann er dann keine <unclear cert="low" resp="#joint">eheliche</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">leibs</unclear> <unclear cert="low" resp="#joint">erben</unclear>, <unclear cert="low" resp="#joint">und</unclear> aber ein
<lb n="18"/>Huepsche haab und Guett hinder-
<lb n="19"/><unclear cert="low" resp="#joint">laßen</unclear>. Haben <unclear cert="low" resp="#joint">wir</unclear> uff
<lb n="20"/>anhalten der freundtschafft
<lb n="21"/>allhie wonnung habende, ein
<lb n="22"/>tag <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">theilung</unclear> <unclear cert="low" resp="#joint">bestimbt</unclear>
<lb n="23"/>und <unclear cert="low" resp="#joint">angesezt</unclear>, <unclear cert="low" resp="#joint">namblich</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">den</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">22</unclear>. <unclear cert="low" resp="#joint">monatstag</unclear> <unclear cert="low" resp="#joint">Januarij</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">nechstkhünfftigs</unclear> 1621</date>.ten <unclear cert="low" resp="#joint">Jahrs</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">dieweil</unclear> nun, wie die
<lb n="27"/>freundtschafft berichtet, neben
<lb n="28"/><unclear cert="low" resp="#joint">andern</unclear> mehr <unclear cert="low" resp="#joint">außlendischen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">erben</unclear>, <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">Abgeleibten</unclear>, <unclear cert="low" resp="#joint">ein</unclear>
<pb facs="StadtASG_Missive_2246_8506.jpg" n="2"/>
<lb n="30"/><unclear cert="low" resp="#joint">schwöster</unclear> <unclear cert="low" resp="#joint">nahmmens</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Elisabetha</unclear></persName>
<lb n="31"/><persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear> <unclear cert="low" resp="#joint">Scheiffers</unclear></persName> <unclear cert="low" resp="#joint">eheliche</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">haußfrauw</unclear>
<lb n="33"/>in <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Fl</unclear>. <unclear cert="low" resp="#joint">Wl</unclear>. <unclear cert="low" resp="#joint">Statt</unclear>. <unclear cert="low" resp="#joint">verburgert</unclear>
<lb n="34"/>haben <unclear cert="low" resp="#joint">solle</unclear>. <unclear cert="low" resp="#joint">Deßhalben</unclear> wir
<lb n="35"/><unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">ermanglen</unclear> <unclear cert="low" resp="#joint">wollen</unclear> <unclear cert="low" resp="#joint">derselben</unclear>
<lb n="36"/>ein solches durch eignen Lauffers
<lb n="37"/>botten <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">theiglnachrichtung</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">wüßenhafft</unclear> zu machen.
<lb n="39"/><unclear cert="low" resp="#joint">Gelangt</unclear> <unclear cert="low" resp="#joint">demnach</unclear> an <unclear cert="low" resp="#joint">dieselben</unclear>
<lb n="40"/>unser freündtlichs gesinnen, die
<lb n="41"/>wöllen uns unbeschwärt berichten,
<lb n="42"/>ob gedachte <persName resp="#ner"><unclear cert="low" resp="#joint">Elisabetha</unclear> <unclear cert="low" resp="#joint">Scheifferin</unclear></persName>
<lb n="43"/>in E. Fl. Wl. Statt wohne, unnd
<lb n="44"/>ob sie noch <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">leben</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">kind</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">leib</unclear> <unclear cert="low" resp="#joint">erbohren</unclear> in
<lb n="46"/>des lebens vorhanden? Und so fern
<lb n="47"/><unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">also</unclear>, <unclear cert="low" resp="#joint">Inen</unclear> nicht allein solches
<lb n="48"/>ihres bruoders od vettern selig
<lb n="49"/>tödtliches ableiben zu kundt zethuon.
<lb n="50"/>Sondern sie auch dahin halten, so fern
<lb n="51"/>sie <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">vermelts</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Schreyers</unclear></persName>
<lb n="52"/><unclear cert="low" resp="#joint">hinderlaßenschafft</unclear> <unclear cert="low" resp="#joint">aeiniche</unclear> <unclear cert="low" resp="#joint">Erbliche</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">ansprach</unclear> <unclear cert="low" resp="#joint">zehaben</unclear> <unclear cert="low" resp="#joint">vermeinen</unclear>, <unclear cert="low" resp="#joint">sölches</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">entweders</unclear> in eigner <unclear cert="low" resp="#joint">persohn</unclear>, <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">durch</unclear>
<lb n="55"/>einen vollmächtigen Anwaldt mit
<lb n="56"/><unclear cert="low" resp="#joint">gnuogsamem</unclear> <unclear cert="low" resp="#joint">gewalt</unclear>, auch schein
<lb n="57"/>und Urkhundt, wie nahe sielver-
<lb n="58"/>wandt, Und <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Fl</unclear>. <unclear cert="low" resp="#joint">Wl</unclear>. <unclear cert="low" resp="#joint">Statt</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">Erbreüch</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">sölchen</unclear> <unclear cert="low" resp="#joint">fählen</unclear> <unclear cert="low" resp="#joint">außweißt</unclear>,
<lb n="60"/>und man zu Erben zuogelaßen
<lb n="61"/>werde, sich uffs lengst, <date resp="#ner">den 20ten.</date>
<pb facs="StadtASG_Missive_2246_8507.jpg" n="3"/>
<lb n="62"/>oder <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">K</unclear>. <unclear cert="low" resp="#joint">ermelts</unclear> <unclear cert="low" resp="#joint">monats</unclear>
<lb n="63"/><date resp="#ner"><unclear cert="low" resp="#joint">Ianuarii</unclear></date> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">iinstellen</unclear>,
<lb n="64"/><unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">man</unclear> <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">theilung</unclear> <unclear cert="low" resp="#joint">shreiten</unclear>
<lb n="65"/>und <unclear cert="low" resp="#joint">iedem</unclear> <unclear cert="low" resp="#joint">eruolgen</unclear> <unclear cert="low" resp="#joint">moege</unclear> <unclear cert="low" resp="#joint">was</unclear>
<lb n="66"/>ihme von billich und <unclear cert="low" resp="#joint">erblicher</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="67"/><unclear cert="low" resp="#joint">rechtigkeit</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">wirt</unclear> <unclear cert="low" resp="#joint">gebueren</unclear>.
<lb n="68"/><unclear cert="low" resp="#joint">Wolten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">wie</unclear>
<lb n="69"/>obgemelt noch zuer thaeg,
<lb n="70"/>so wohl für uns <unclear cert="low" resp="#joint">selbs</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">offt</unclear>
<lb n="71"/><unclear cert="low" resp="#joint">vohr</unclear> <unclear cert="low" resp="#joint">besagtes</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">stadt</unclear> <unclear cert="low" resp="#joint">dieners</unclear>
<lb n="72"/><unclear cert="low" resp="#joint">unangetaeigt</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="73"/>und <unclear cert="low" resp="#joint">verbleiben</unclear> <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="74"/>allen angenemhmen diensts
<lb n="75"/>erzeigungen wohl beigethan,
<lb n="76"/>uns damit samptlich der <unclear cert="low" resp="#joint">ob</unclear>-
<lb n="77"/><unclear cert="low" resp="#joint">enhalt</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">treüwen</unclear> <unclear cert="low" resp="#joint">wohlbeuoh</unclear>-
<lb n="78"/><unclear cert="low" resp="#joint">lende</unclear>. Datum den <origDate when="1620" resp="#ner"><unclear cert="low" resp="#joint">17</unclear> <unclear cert="low" resp="#joint">X</unclear>. <unclear cert="low" resp="#joint">De</unclear>-
<lb n="79"/><unclear cert="low" resp="#joint">cembris</unclear>, anno 1620</origDate>.
<lb n="80"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und rhat
<lb n="81"/>der stadt Sant Gallen</orgName>.
<lb n="82"/>Den ehrenuesten fürsichtigen ersamen
<lb n="83"/>und weißen schultheiß burgermeister
<lb n="84"/>und rhat zu <placeName ref="stadtasg-places-424" cert="medium" resp="#ner">Ogersheim</placeName>, unseren
<lb n="85"/>besunders lieben und gueten freünden.
<lb n="86"/>Nota ligt in <placeName ref="stadtasg-places-143" cert="medium" resp="#ner">churf. Pfalz</placeName> ungefehr 4. <unclear cert="low" resp="#joint">meil</unclear>
<lb n="87"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Speÿr</unclear>, <unclear cert="low" resp="#joint">nah</unclear> <placeName ref="stadtasg-places-375" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Frankenthal</unclear></placeName>.
<pb facs="StadtASG_Missive_2246_8508.jpg" n="4"/>
<lb n="88"/><origDate when="1620" resp="#ner">17. <unclear cert="low" resp="#joint">Xbris</unclear> 1620</origDate>. An die statt <placeName ref="stadtasg-places-424" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Ogersheimb</unclear></placeName>
<lb n="89"/><unclear cert="medium" resp="#joint">inn</unclear> der <placeName ref="stadtasg-places-143" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Pffaltz</unclear></placeName> ligend. <persName role="issuer" resp="#ner">Caspar <unclear cert="low" resp="#joint">Steiners</unclear></persName> <unclear cert="low" resp="#joint">sel</unclear>.
<lb n="90"/><unclear cert="low" resp="#joint">vlßne</unclear>. <unclear cert="low" resp="#joint">schaffs</unclear> <unclear cert="low" resp="#joint">betref</unclear>.
</p>
