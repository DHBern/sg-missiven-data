<lb n="16"/>schriben, unnd ouch <unclear cert="medium" resp="#joint">ehr</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Schelch</unclear></persName>, innamen sin selbs,
<lb n="17"/>unnd gedachter siner <unclear cert="low" resp="#joint">geschwüsterigten</unclear>, <unclear cert="low" resp="#joint">erschinen</unclear>, ver-
