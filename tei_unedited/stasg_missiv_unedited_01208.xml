<lb n="29"/><unclear cert="low" resp="#joint">zuoerheben</unclear>, unnd <unclear cert="medium" resp="#joint">ynzenemmen</unclear>, <unclear cert="medium" resp="#joint">hatt</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">unns</unclear>, sambt
