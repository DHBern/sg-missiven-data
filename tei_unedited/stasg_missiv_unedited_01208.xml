<lb n="13"/><unclear cert="medium" resp="#joint">Struoben</unclear></persName> seligen absterben, <unclear cert="medium" resp="#joint">uff</unclear> desselben <unclear cert="medium" resp="#joint">hinderlaßen</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">zittlich</unclear> hab unnd guetter, <unclear cert="low" resp="#joint">gemainen</unclear> daran <unclear cert="medium" resp="#joint">sprüchenden</unclear>
