<lb n="9"/>seligen <unclear cert="low" resp="#joint">verlaßenschafft</unclear>, <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">namhaffte</unclear> <unclear cert="low" resp="#joint">summ</unclear> <unclear cert="low" resp="#joint">geltz</unclear>, noch
<lb n="10"/><unclear cert="medium" resp="#joint">unbezalt</unclear> <unclear cert="medium" resp="#joint">usstendig</unclear>, <unclear cert="medium" resp="#joint">wellche</unclear> sich <unclear cert="low" resp="#joint">hievôr</unclear> uß <unclear cert="low" resp="#joint">erbkouff</unclear>
