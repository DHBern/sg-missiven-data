    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1435_5133.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">frünt</unclear>: und <unclear cert="low" resp="#joint">nachpuerlich</unclear> <unclear cert="low" resp="#joint">guetwillig</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">dienst</unclear> zuvor <unclear cert="low" resp="#joint">edlen</unclear>, <unclear cert="low" resp="#joint">vesten</unclear>, <unclear cert="low" resp="#joint">fürsihtigen</unclear>, <unclear cert="low" resp="#joint">ehrsamen</unclear>
<lb n="3"/>und <unclear cert="low" resp="#joint">weysen</unclear> <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">günstige</unclear> herren lieben
<lb n="4"/>fründt und guete nachpurn.
<lb n="5"/>Was ihr den <date resp="#ner">7. iunii</date>, an uns, wegen <unclear cert="low" resp="#joint">wolfe</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">eilten</unclear> <unclear cert="low" resp="#joint">vertragß</unclear> <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">derselbig</unclear> <unclear cert="low" resp="#joint">ueh</unclear> <unclear cert="low" resp="#joint">ehreer</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">lich</unclear> <unclear cert="low" resp="#joint">syge</unclear> <unclear cert="low" resp="#joint">zugeschriben</unclear>, haben wir
<lb n="8"/>ablessend verstanden,
<lb n="9"/>Und wül unser meinung niemahlß gewessen
<lb n="10"/>und noch nit ist, üch <unclear cert="low" resp="#joint">iegenwessen</unclear> <unclear cert="low" resp="#joint">verlecz</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">lich</unclear> <unclear cert="low" resp="#joint">zeschriben</unclear>, <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">selbem</unclear> <unclear cert="low" resp="#joint">zuwider</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">zehandlen</unclear>, <unclear cert="low" resp="#joint">vil</unclear> <unclear cert="low" resp="#joint">mehe</unclear> aber <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">wolgmeind</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">te</unclear> <unclear cert="low" resp="#joint">nachpurschafft</unclear> <unclear cert="low" resp="#joint">zuerwysen</unclear>,
<lb n="14"/><unclear cert="low" resp="#joint">Jnmaßen</unclear> unser abgsandte andern
<lb n="15"/>bevelch nit gehabt, Aber <unclear cert="low" resp="#joint">ettwaß</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">misverstand</unclear> <unclear cert="low" resp="#joint">darunder</unclear> geloffen, so wol
<lb n="17"/>auch <unclear cert="low" resp="#joint">zwüschen</unclear> <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">mitrath</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Rudolff</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">Teüblin</unclear></persName>, und <persName resp="#ner"><unclear cert="low" resp="#joint">Zacharias</unclear> <unclear cert="low" resp="#joint">Kienzen</unclear></persName>, <unclear cert="low" resp="#joint">ihres</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">spans</unclear> halb, was unglüchs sich erzuhen
<lb n="20"/>möchte, haben wir <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">dißmahl</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">wyegen</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">Teüblin</unclear> seiner ansprach
<lb n="22"/>halb <unclear cert="low" resp="#joint">ettwaß</unclear> <unclear cert="low" resp="#joint">inzehalten</unclear> <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">rathsam</unclear> <unclear cert="low" resp="#joint">eracht</unclear>,
<lb n="23"/>Und wollen im mitel, unses theils, jn angre-
<lb n="24"/>agter sach wegen unser nothurfft, wie
<lb n="25"/>der selben <unclear cert="low" resp="#joint">zuebegegnen</unclear>, <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">underlaßen</unclear>,
<lb n="26"/><unclear cert="low" resp="#joint">den</unclear> gebürlichen bscheid zegeben, und
<lb n="27"/><unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">deßelben</unclear> <unclear cert="low" resp="#joint">fürderlichst</unclear> <unclear cert="low" resp="#joint">brihten</unclear>.
<pb facs="StadtASG_Missive_1435_5134.jpg" n="2"/>
<lb n="28"/><unclear cert="low" resp="#joint">Sousten</unclear> <unclear cert="low" resp="#joint">sind</unclear> wir ein mahl, der <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">hergebrachten</unclear> <unclear cert="low" resp="#joint">ver</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">tregen</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">bißhar</unclear> in <unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">krefften</unclear>
<lb n="30"/>würden, und ansehen verpleiben,
<lb n="31"/>Wolten wir üch zur begerter <unclear cert="low" resp="#joint">andtwurth</unclear> <unclear cert="low" resp="#joint">ohn</unclear>-
<lb n="32"/><unclear cert="low" resp="#joint">angefuegt</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="33"/>Uns sambtlich <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gnadenreich</unclear> <unclear cert="low" resp="#joint">sägen</unclear> Gotts
<lb n="34"/>bevelchende den <origDate resp="#ner">25 juli A° 603</origDate>.
<lb n="35"/><orgName ref="stadtasg-actors-102" cert="medium" role="issuer" resp="#ner">Stat Aman und Raath
<lb n="36"/>zuo Arbon</orgName>.
<pb facs="StadtASG_Missive_1435_5135.jpg" n="3"/>
<pb facs="StadtASG_Missive_1435_5136.jpg" n="4"/>
<lb n="37"/>Denn Edlen, vesten, fuersichtigen, Ersaamen unnd
<lb n="38"/><unclear cert="medium" resp="#joint">wyßen</unclear> <unclear cert="medium" resp="#joint">Heren</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister <unclear cert="medium" resp="#joint">und</unclear> Raath der
<lb n="39"/>Statt <unclear cert="medium" resp="#joint">S</unclear>. Gallen</orgName>, unßeren sonders guenstig
<lb n="40"/>Lieben Heren, guetten fründ und Nachbaurn.
</p>
