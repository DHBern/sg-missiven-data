    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1767_6521.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">frundtlich</unclear> willig diennst, sampt waß wir ehren liebs
<lb n="2"/>unnd guots <unclear cert="low" resp="#joint">vermögen</unclear> zuvor from fürsichtig ersam wyß
<lb n="3"/>innsonders guot fründ unnd <unclear cert="low" resp="#joint">getrüw</unclear> lieb eidtgnossenn.
<lb n="4"/>Vor <unclear cert="low" resp="#joint">unnß</unclear> sind <unclear cert="low" resp="#joint">erschinen</unclear> unnsere liebe unnd <unclear cert="low" resp="#joint">getrüwe</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">lanndtlüth</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Niclauß</unclear> <unclear cert="low" resp="#joint">Vogell</unclear></persName>, unnd <persName resp="#ner"><unclear cert="low" resp="#joint">Fridlÿ</unclear> <unclear cert="low" resp="#joint">Aeble</unclear></persName>, unnd <unclear cert="low" resp="#joint">unnß</unclear>
<lb n="6"/>der <unclear cert="low" resp="#joint">lenge</unclear> nach irer g. <unclear cert="low" resp="#joint">byhabenden</unclear>. <unclear cert="low" resp="#joint">schuldenthalb</unclear> <unclear cert="low" resp="#joint">selbig</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">verlaßnen</unclear> <unclear cert="low" resp="#joint">lüt</unclear> <unclear cert="low" resp="#joint">berichtett</unclear>. welliches <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">bewüßt</unclear>, unnd
<lb n="8"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">innfendtarium</unclear> <unclear cert="low" resp="#joint">desselbigen</unclear>. <unclear cert="low" resp="#joint">zugestelt</unclear> worden <unclear cert="low" resp="#joint">under</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">hannden</unclear> habenn, unnd durch ieren. Seckellmeister <persName resp="#ner">Schmidt</persName>.
<lb n="10"/>unnd Buwmeister <persName resp="#ner">Schüch</persName>, zugestelt worden <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">uber</unclear> <unclear cert="low" resp="#joint">geben</unclear>
<lb n="11"/>da sy verhofft innen. glich förmige. abschrifft ohne <unclear cert="low" resp="#joint">ieren</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">chostenn</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">khomen</unclear> <unclear cert="low" resp="#joint">syn</unclear> <unclear cert="low" resp="#joint">sölle</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">wegen</unclear> sy <unclear cert="low" resp="#joint">frundtlich</unclear>.
<lb n="13"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">höchstes</unclear> <unclear cert="low" resp="#joint">pittenn</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">bem</unclear> <unclear cert="low" resp="#joint">ieren</unclear> <unclear cert="low" resp="#joint">wegen</unclear> mitt
<lb n="14"/><unclear cert="low" resp="#joint">fürgschrifft</unclear>. <unclear cert="low" resp="#joint">ann</unclear> <unclear cert="low" resp="#joint">üch</unclear>. <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">g</unclear>. l. e. befurderen wellen inn
<lb n="15"/>hoffnung der selben woll zu geniessenn. darzu sy <unclear cert="low" resp="#joint">rächt</unclear> haben
<lb n="16"/><unclear cert="low" resp="#joint">möchtenn</unclear>. unnd so wir nun gesagtt. unnsere liebe. lanndtlüth
<lb n="17"/>inn irem begerenn ann gehörtt. unnd verstannden <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">gelangtt</unclear>
<lb n="18"/>ann <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">g</unclear>. l. e. unnser fründtlich pitten ir wellent
<lb n="19"/><unclear cert="low" resp="#joint">gesagtt</unclear>. unnsere liebe <unclear cert="low" resp="#joint">lanndtlüth</unclear>, inn <unclear cert="low" resp="#joint">irem</unclear> <unclear cert="low" resp="#joint">begneden</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">behulffenn</unclear> unnd <unclear cert="low" resp="#joint">berathen</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">synn</unclear>. daß <unclear cert="low" resp="#joint">innen</unclear> obgemelt
<lb n="21"/><unclear cert="low" resp="#joint">innfenntarium</unclear> ouch ire. rächungen. unnd <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">gantze</unclear> <unclear cert="low" resp="#joint">bericht</unclear>
<lb n="22"/>zu hannden gestelt werde. damiet sy wie ouch ire erben
<lb n="23"/><unclear cert="low" resp="#joint">wüssenn</unclear> <unclear cert="low" resp="#joint">waß</unclear> sy habenn mögen. Welliches umb eüch unnd
<lb n="24"/>unnsere <unclear cert="low" resp="#joint">g</unclear>. l. e. unnd <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">ieren</unclear>. <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">allerwüll</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">soll</unclear> <unclear cert="low" resp="#joint">verdiennet</unclear> <unclear cert="low" resp="#joint">werden</unclear>. <unclear cert="low" resp="#joint">Hiemiet</unclear> <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">samptlich</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">schutz</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">schierm</unclear> <unclear cert="low" resp="#joint">gottes</unclear> <unclear cert="low" resp="#joint">thrüwlichen</unclear> <unclear cert="low" resp="#joint">bevelchende</unclear>. Datum <origDate when="1612" resp="#ner">den 23 tag
<lb n="27"/>May anno 1612</origDate>.
<lb n="28"/><orgName ref="stadtasg-actors-502" cert="medium" role="issuer" resp="#ner">Lanndtaman unnd rath
<lb n="29"/>zu Glaruß</orgName>
<pb facs="StadtASG_Missive_1767_6522.jpg" n="2"/>
<pb facs="StadtASG_Missive_1767_6523.jpg" n="3"/>
<pb facs="StadtASG_Missive_1767_6524.jpg" n="4"/>
<lb n="30"/>Den fromen fürsichtigen. ersamen <unclear cert="low" resp="#joint">wisen</unclear>.
<lb n="31"/><unclear cert="low" resp="#joint">herren</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd <unclear cert="low" resp="#joint">Rhatt</unclear>. der.
<lb n="32"/>Statt Sanntt Gallen</orgName>, <unclear cert="low" resp="#joint">unnseren</unclear>. lieben
<lb n="33"/>guotten fründen. und getrüwen Eydt-
<lb n="34"/>gnossen.
</p>
