    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2616_10149.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edle</unclear> <unclear cert="low" resp="#joint">fromme</unclear>, <unclear cert="low" resp="#joint">ehrnveste</unclear>, <unclear cert="low" resp="#joint">fürsichtige</unclear>, <unclear cert="low" resp="#joint">ehrsambe</unclear>,
<lb n="2"/>und <unclear cert="low" resp="#joint">weiße</unclear>, <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">guette</unclear> <unclear cert="low" resp="#joint">freündt</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">nachparnn</unclear>, <unclear cert="low" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">seyen</unclear> unßer freüntlich
<lb n="4"/>nachparlich willig dienst samdt grueß beuor,
<lb n="5"/>Es ist vor unß in versameltem <orgName resp="#ner">raadt</orgName> erschinen,
<lb n="6"/>maister <persName resp="#ner">Burckhart Laußer</persName>, goldschmid alhie, der
<lb n="7"/>und fürtragen laßen, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">kurcz</unclear> <unclear cert="low" resp="#joint">etwas</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">abgeloffner</unclear> <unclear cert="low" resp="#joint">zeit</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">ehren</unclear> unnd tugenthsamb.
<lb n="9"/>frow <persName resp="#ner">Anna Scherbin</persName>, sein liebe dochteren, weÿl-
<lb n="10"/>und deß frommen ehrnvesten unndt weißenn.
<lb n="11"/>herren <persName resp="#ner"><unclear cert="low" resp="#joint">Jacoben</unclear> <unclear cert="low" resp="#joint">Reütlingers</unclear></persName> <unclear cert="low" resp="#joint">burgermaisters</unclear>
<lb n="12"/>seligen, <unclear cert="low" resp="#joint">eheliche</unclear> <unclear cert="low" resp="#joint">haußfrow</unclear> der <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">dem</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">allmechtigen</unclear>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">dißer</unclear> zeit, zue seinen <unclear cert="low" resp="#joint">genaden</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">berüefft</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">hinderlaßne</unclear> erben
<lb n="15"/>ir verlaßenschafft, miteinanderen gebürlich
<lb n="16"/>unnd <unclear cert="low" resp="#joint">freüntlich</unclear> <unclear cert="low" resp="#joint">geteilt</unclear>, <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">anstat</unclear>.
<lb n="17"/><persName resp="#ner"><unclear cert="low" resp="#joint">Urßula</unclear> <unclear cert="low" resp="#joint">Scherbin</unclear></persName>, <unclear cert="low" resp="#joint">seiner</unclear> lieben <unclear cert="low" resp="#joint">hußfrowen</unclear>, zue
<lb n="18"/>seinem <unclear cert="low" resp="#joint">gebürenden</unclear> <unclear cert="low" resp="#joint">theil</unclear> <unclear cert="low" resp="#joint">gefallen</unclear>, <unclear cert="low" resp="#joint">daßelbig</unclear> man
<lb n="19"/><unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">handt</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">wellen</unclear>, <unclear cert="low" resp="#joint">sonder</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">herren</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Melchior</unclear> <unclear cert="low" resp="#joint">Scherber</unclear></persName> <unclear cert="low" resp="#joint">eüwerem</unclear> <unclear cert="low" resp="#joint">burger</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">vögtlicherweiße</unclear> <unclear cert="low" resp="#joint">zuegehandeicht</unclear>, <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">sye</unclear> ime
<lb n="22"/><unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">allerley</unclear> <unclear cert="low" resp="#joint">fridliebenden</unclear> <unclear cert="low" resp="#joint">rüews</unclear> <unclear cert="low" resp="#joint">willen</unclear>, <unclear cert="low" resp="#joint">bÿ</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">solicher</unclear> <unclear cert="low" resp="#joint">theilung</unclear> <unclear cert="low" resp="#joint">versprochen</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">das</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">man</unclear> <unclear cert="low" resp="#joint">ihme</unclear> ein <unclear cert="low" resp="#joint">gldj</unclear> <unclear cert="low" resp="#joint">oder</unclear> 300: <unclear cert="low" resp="#joint">von</unclear> seiner frowen
<lb n="25"/><unclear cert="low" resp="#joint">erbtheil</unclear>, <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">handt</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">welle</unclear>, welche
<lb n="26"/>er theilß an sein handtwerckh, sich, sein weib
<lb n="27"/>unnd kindt, <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">beßer</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">dißer</unclear> <unclear cert="low" resp="#joint">theüren</unclear> zeit
<lb n="28"/>ußzebringen, theilß zuebeßerung seiner
<lb n="29"/>buwloßen behaußung uffwenden solle, aber
<lb n="30"/><unclear cert="low" resp="#joint">bißdahero</unclear> <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">nichts</unclear> <unclear cert="low" resp="#joint">erfolgt</unclear>. <unclear cert="low" resp="#joint">Weil</unclear> dann
<lb n="31"/>nun solcher seiner frowen erbtheil, in der
<pb facs="StadtASG_Missive_2616_10150.jpg" n="2"/>
<lb n="32"/>Herren <unclear cert="low" resp="#joint">oberkaittlichen</unclear> <unclear cert="low" resp="#joint">gewaltt</unclear> <unclear cert="low" resp="#joint">seye</unclear>, So sye
<lb n="33"/>er <unclear cert="low" resp="#joint">willens</unclear>, <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">denselbigen</unclear>, umb <unclear cert="low" resp="#joint">bewilligung</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">anzehalten</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">gedachter</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">vatter</unclear>, <unclear cert="low" resp="#joint">ime</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">300</unclear> <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">wäre</unclear> <unclear cert="low" resp="#joint">antwort</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">zuestelle</unclear>, <unclear cert="low" resp="#joint">Dero</unclear>-
<lb n="36"/><unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">diewil</unclear> <unclear cert="low" resp="#joint">er</unclear> die <unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">pitliches</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">fürschreiben</unclear> <unclear cert="low" resp="#joint">angelangt</unclear>, <unclear cert="low" resp="#joint">gethrüwt</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">ur</unclear>-
<lb n="38"/><unclear cert="low" resp="#joint">fruchtbarlich</unclear> <unclear cert="low" resp="#joint">zugeniessen</unclear>, <unclear cert="low" resp="#joint">Dieweil</unclear> sein
<lb n="39"/>begeren, wir ime nit wol <unclear cert="low" resp="#joint">verwaigeren</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">abschlachen</unclear> <unclear cert="low" resp="#joint">künden</unclear>, <unclear cert="low" resp="#joint">Sonder</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">gelangt</unclear> an die <unclear cert="low" resp="#joint">Herren</unclear>, <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">seintwegen</unclear> <unclear cert="low" resp="#joint">unser</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">früntt</unclear>- <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Nachperliches</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear>,
<lb n="43"/>Sie wellen durch ir oberkaittliches Mitel
<lb n="44"/>gegen dem Herren <persName resp="#ner">Scherer</persName> verschaffen, das
<lb n="45"/>er ime wo nit gar <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">drei</unclear>, <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">uffs</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">wenigist</unclear> 200 <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">volgen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>
<lb n="47"/>welle, <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">hoffnung</unclear> <unclear cert="low" resp="#joint">selbigs</unclear> seiner <unclear cert="low" resp="#joint">Hauß</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">haltung</unclear>, <unclear cert="low" resp="#joint">zenutz</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guetem</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">dan</unclear> auch
<lb n="49"/>zuverbesserung seiner behausung (wohin er
<lb n="50"/><unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">zeordnen</unclear> <unclear cert="low" resp="#joint">schier</unclear> nit liebers) verwenden
<lb n="51"/>werde, Und würde hiemit auch, zwüschen
<lb n="52"/>ime, und seiner Hausfrowen, mer fridt und
<lb n="53"/>einigkeit gepflantzet, Und sich dises fals
<lb n="54"/>halben, gegen ime dermassen erweisen, das
<lb n="55"/>er <unclear cert="low" resp="#joint">dises</unclear> <unclear cert="low" resp="#joint">unsers</unclear>, <unclear cert="low" resp="#joint">pitlichen</unclear> <unclear cert="low" resp="#joint">fürschreibens</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">würcklich</unclear> <unclear cert="low" resp="#joint">genossen</unclear> <unclear cert="low" resp="#joint">spüren</unclear> <unclear cert="low" resp="#joint">möge</unclear>, <unclear cert="low" resp="#joint">Daß</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">seyen</unclear> wir von <unclear cert="low" resp="#joint">seintwegen</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Herren</unclear>
<lb n="58"/>in begebenden <unclear cert="low" resp="#joint">gelegenhaiten</unclear>, <unclear cert="low" resp="#joint">zeverdienen</unclear>
<lb n="59"/>berait und willig, Im <unclear cert="low" resp="#joint">fahl</unclear> <unclear cert="low" resp="#joint">es</unclear> aber <unclear cert="low" resp="#joint">wider</unclear>
<lb n="60"/>verhoffen nit geschechen welte, des verhinder-
<lb n="61"/>lichen ursach, mit <unclear cert="low" resp="#joint">schriftlicher</unclear> <unclear cert="low" resp="#joint">Antwort</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">zeberichten</unclear> <unclear cert="low" resp="#joint">unbeschwärt</unclear> <unclear cert="low" resp="#joint">zesein</unclear>, <unclear cert="low" resp="#joint">Göttlicher</unclear>
<lb n="63"/>bewahrung <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">sametlich</unclear> <unclear cert="low" resp="#joint">etc</unclear>.
<pb facs="StadtASG_Missive_2616_10151.jpg" n="3"/>
<lb n="64"/>getruelich befohlende, dat den <origDate when="1626-10-30" resp="#ner">20/30
<lb n="65"/>octobr. a° 1626</origDate>,
<lb n="66"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Vogt unnd rath der stadt</orgName>.
<lb n="67"/><origPlace ref="stadtasg-places-19" cert="medium" resp="#ner">Bischofzell</origPlace>. .
<pb facs="StadtASG_Missive_2616_10152.jpg" n="4"/>
<lb n="68"/>Denen
<lb n="69"/>edlen, fromen, vernamten, fuersichtigen
<lb n="70"/>ersamben und weisen, herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="71"/>unnd Rhat der stat St. Gallen</orgName>, unsern
<lb n="72"/>besonders lieben herren freund und nachbarn.
</p>
