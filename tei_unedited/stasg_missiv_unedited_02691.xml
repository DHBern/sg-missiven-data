<lb n="44"/><unclear cert="low" resp="#joint">keit</unclear> nach ab: unnd <unclear cert="low" resp="#joint">hinder</unclear> sich <unclear cert="low" resp="#joint">zůwÿßen</unclear>, <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">wir</unclear>
