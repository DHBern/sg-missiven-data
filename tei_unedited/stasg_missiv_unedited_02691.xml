<lb n="13"/>by unns den <unclear cert="low" resp="#joint">Innern</unclear> <unclear cert="low" resp="#joint">Orten</unclear> <unclear cert="low" resp="#joint">durchzuereisen</unclear> <unclear cert="low" resp="#joint">understond</unclear>,
<lb n="14"/>auch bereit theils durchgereiset theils aber wider
<lb n="15"/>umb <unclear cert="low" resp="#joint">hindersich</unclear> unnd zuruckh gewisen worden; Haben
<lb n="16"/>wir in <unclear cert="low" resp="#joint">betrachtung</unclear>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">bschwerd</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">armen</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">gemeinen</unclear> <unclear cert="low" resp="#joint">mann</unclear> by diser <unclear cert="low" resp="#joint">thüwrer</unclear> <unclear cert="low" resp="#joint">zit</unclear> in unnd <unclear cert="low" resp="#joint">uß</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Orten</unclear> <unclear cert="low" resp="#joint">ingemein</unclear>, <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">abbruch</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">lob</unclear>:
