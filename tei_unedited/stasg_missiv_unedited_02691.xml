<lb n="8"/><unclear cert="low" resp="#joint">eils</unclear> unnd andern frömbde stend angrentzenden
<lb n="9"/>Ortten der <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidtgnoschafft</unclear></orgName>, ein <unclear cert="low" resp="#joint">zit</unclear> <unclear cert="low" resp="#joint">hero</unclear> <unclear cert="low" resp="#joint">vil</unclear> <unclear cert="low" resp="#joint">hoch</unclear> <unclear cert="low" resp="#joint">tüts</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">ches</unclear> volchs <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">roß</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">fuoß</unclear> <unclear cert="low" resp="#joint">iez</unclear> zuo. 10. dan zuo .20.
<lb n="11"/>dann <unclear cert="low" resp="#joint">minder</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">meer</unclear> in vollender gschafft die
