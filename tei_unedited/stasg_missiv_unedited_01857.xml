<lb n="26"/>halten, sich <unclear cert="medium" resp="#joint">entlichen</unclear> mit Ime bey Euch <unclear cert="low" resp="#joint">vereinbaret</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">eins</unclear> <unclear cert="low" resp="#joint">wege</unclear> <unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="low" resp="#joint">kündmaistigeten</unclear> <unclear cert="low" resp="#joint">Anwaltß</unclear> In <unclear cert="low" resp="#joint">seinen</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">Namen</unclear>
<lb n="29"/><origPlace ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schaffhußen</unclear></origPlace> <origDate when="1613" resp="#ner"><unclear cert="low" resp="#joint">1613</unclear> <unclear cert="low" resp="#joint">xbr</unclear>.</origDate>
<pb facs="StadtASG_Missive_1857_6898.jpg" n="2"/>
<lb n="30"/>kleinern accordo einzulaßen gemaindt, daß <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">begerende</unclear> <unclear cert="low" resp="#joint">seye</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> Er <unclear cert="low" resp="#joint">rechtlichen</unclear> <unclear cert="low" resp="#joint">aüßtrags</unclear> <unclear cert="low" resp="#joint">undt</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">züsprüchs</unclear> <unclear cert="low" resp="#joint">gewertig</unclear> <unclear cert="low" resp="#joint">zü</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">begähret</unclear>, <unclear cert="low" resp="#joint">wölch</unclear> haben wier
<lb n="33"/>ihme hierin zü wilfahren nit umbgehen wöllen.
<lb n="34"/>Undt ersüchen Eüch hierauff freündtlich, Eydtgnößisch undt
<lb n="35"/>dienstlich, Ihr wöllen besagten unsern burgeren <persName resp="#ner"><unclear cert="low" resp="#joint">Heinrich</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">Schopfen</unclear></persName> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">orts</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">unßers</unclear> undt <unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">erachtens</unclear>
<lb n="37"/>billichen begährens wegen günstigs für befündert
<lb n="38"/>halten, undt ihme zü allem dem jenigen wohn Rechtens
<lb n="39"/>undt oberkeit wegen <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">wolverwahrten</unclear>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">mehr</unclear>-
<lb n="40"/><unclear cert="low" resp="#joint">bemeldten</unclear> <unclear cert="low" resp="#joint">Seüigs</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">schüldtforderung</unclear> <unclear cert="low" resp="#joint">allüen</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">wohn</unclear> <unclear cert="low" resp="#joint">angeregten</unclear> <unclear cert="low" resp="#joint">Schärerischen</unclear> undt <unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">anderen</unclear>
<lb n="42"/>fallimento wohn Eüch <unclear cert="low" resp="#joint">zü</unclear> <unclear cert="low" resp="#joint">gesprochen</unclear> <unclear cert="low" resp="#joint">worden</unclear> undt <unclear cert="low" resp="#joint">biß</unclear>
