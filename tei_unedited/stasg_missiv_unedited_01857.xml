<p>
<pb facs="StadtASG_Missive_1857_6897.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig dienst, <unclear cert="low" resp="#joint">samet</unclear> waß wir Ehren liebs
<lb n="2"/>undt guets vermogen <unclear cert="low" resp="#joint">zuvor</unclear>, From, fuersichtig, Ehrsam, <unclear cert="low" resp="#joint">weyß</unclear>,
<lb n="3"/>Inßonders guete freündt undt <unclear cert="medium" resp="#joint">getrewe</unclear> liebe <orgName role="recipient" resp="#ner">Eydtgnossen</orgName>.
<lb n="4"/>Daß Ihr <unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">mitburgeren</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">H</unclear>. <unclear cert="low" resp="#joint">Heinrych</unclear> <unclear cert="low" resp="#joint">Pryern</unclear></persName> <unclear cert="low" resp="#joint">deß</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">kleinen</unclear> <orgName resp="#ner"><unclear cert="low" resp="#joint">Rhats</unclear></orgName> <unclear cert="low" resp="#joint">richteren</unclear> undt lieben <unclear cert="low" resp="#joint">Mightsfeündt</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">rechtferthiges</unclear> <unclear cert="low" resp="#joint">begeren</unclear> <unclear cert="low" resp="#joint">erclern</unclear> <unclear cert="low" resp="#joint">widern</unclear> <unclear cert="low" resp="#joint">gesprochnen</unclear> <unclear cert="low" resp="#joint">widere</unclear>
<lb n="7"/>den fallierten <persName resp="#ner"><unclear cert="low" resp="#joint">Hanß</unclear> <unclear cert="low" resp="#joint">Meinrych</unclear> <unclear cert="low" resp="#joint">Heining</unclear></persName> wohnhafft zu <placeName ref="stadtasg-places-196" cert="medium" resp="#ner">Lyon</placeName>
<lb n="8"/>deßen <unclear cert="medium" resp="#joint">dertn</unclear> <unclear cert="medium" resp="#joint">dusßern</unclear> <unclear cert="medium" resp="#joint">30</unclear> <unclear cert="medium" resp="#joint">od</unclear> <unclear cert="medium" resp="#joint">kuertze</unclear> <unclear cert="medium" resp="#joint">herre</unclear> Er <unclear cert="medium" resp="#joint">weegen</unclear> wegen
<lb n="9"/><unclear cert="medium" resp="#joint">uf</unclear> <unclear cert="medium" resp="#joint">Record</unclear> daß <unclear cert="medium" resp="#joint">derge</unclear> <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">vomelbenn</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Heining</unclear></persName> <unclear cert="medium" resp="#joint">Ihn</unclear> seiner
<lb n="10"/><unclear cert="medium" resp="#joint">schuldtforderung</unclear> <unclear cert="medium" resp="#joint">bis</unclear> der <unclear cert="low" resp="#joint">bschänigtn</unclear> undt <unclear cert="low" resp="#joint">Ihrer</unclear> <unclear cert="low" resp="#joint">mitver</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">wandter</unclear> <unclear cert="low" resp="#joint">fallimentsach</unclear> bey Euch zu <unclear cert="medium" resp="#joint">geschlagne</unclear> <unclear cert="medium" resp="#joint">waaren</unclear>
<lb n="12"/>undt Inen <unclear cert="low" resp="#joint">einzogen</unclear> <unclear cert="low" resp="#joint">mächten</unclear>: <unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">Arrest</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">Hafftortt</unclear>
<lb n="13"/>verwilliget undt begünstiget: Deßen <unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="low" resp="#joint">wir</unclear> unß
<lb n="14"/><unclear cert="low" resp="#joint">neben</unclear> <unclear cert="low" resp="#joint">Ime</unclear> freündtlich bedanckhen. Undt <unclear cert="low" resp="#joint">hat</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="15"/>ein <unclear cert="medium" resp="#joint">solches</unclear> <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">ohnmeßig</unclear> <unclear cert="medium" resp="#joint">hohug</unclear> <unclear cert="medium" resp="#joint">geruemet</unclear>, <unclear cert="medium" resp="#joint">fohrtens</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">dienstfleißig</unclear> <unclear cert="medium" resp="#joint">pittende</unclear>, <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">dieweyl</unclear> <unclear cert="medium" resp="#joint">Er</unclear> <unclear cert="medium" resp="#joint">deßwillgen</unclear>
<lb n="17"/>bey Euch <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">selbiger</unclear> sach <unclear cert="medium" resp="#joint">künftlich</unclear> <unclear cert="medium" resp="#joint">zu</unclear> procedieren <unclear cert="low" resp="#joint">vorhabens</unclear>,
