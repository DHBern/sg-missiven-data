<lb n="49"/>undt unß <unclear cert="low" resp="#joint">danckhbarlich</unclear> <unclear cert="low" resp="#joint">zü</unclear> <unclear cert="low" resp="#joint">berümen</unclear>, <unclear cert="low" resp="#joint">aüch</unclear> <unclear cert="low" resp="#joint">imt</unclear> <unclear cert="low" resp="#joint">werckh</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">höchlichen</unclear> <unclear cert="low" resp="#joint">zü</unclear> <unclear cert="low" resp="#joint">erfröwen</unclear> habe. Daran <unclear cert="low" resp="#joint">beschicht</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">gefallens</unclear>, undt <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">dienstlich</unclear>, <unclear cert="low" resp="#joint">aüch</unclear>
