<p>
<pb facs="StadtASG_Missive_3101_12207.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear> willig dienst, sambt was wir ehren, liebs
<lb n="2"/>und guots <unclear cert="medium" resp="#joint">vermoegend</unclear> <unclear cert="medium" resp="#joint">zuvor</unclear>, fromm fürsichtig <unclear cert="medium" resp="#joint">ehrsamm</unclear> wyß, be-
<lb n="3"/>sonders guot fründ, und getrüw lieb <unclear cert="medium" resp="#joint">Eydtgnossen</unclear>.
<lb n="4"/>Was <unclear cert="low" resp="#joint">maßen</unclear> die <unclear cert="medium" resp="#joint">Roem</unclear>. <unclear cert="medium" resp="#joint">Keys</unclear>. <unclear cert="medium" resp="#joint">Myt</unclear>. durch <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">an</unclear> die <unclear cert="low" resp="#joint">gesambten</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">Lobl</unclear>. <unclear cert="low" resp="#joint">13</unclear>. <unclear cert="low" resp="#joint">Orth</unclear> <unclear cert="low" resp="#joint">abgelaßenes</unclear> <unclear cert="low" resp="#joint">schryben</unclear>, <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">ab</unclear> unß sonderbar beschweren,
<lb n="6"/><unclear cert="medium" resp="#joint">bevelhs</unclear> <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">dem</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">herzogen</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">Rhan</unclear></persName>, so in <unclear cert="medium" resp="#joint">uwerem</unclear> <unclear cert="medium" resp="#joint">nammen</unclear>, in der <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eydt</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">gnoschafft</unclear></orgName> <unclear cert="medium" resp="#joint">albereit</unclear> bestelt <unclear cert="low" resp="#joint">gewesen</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">himmel</unclear> <unclear cert="low" resp="#joint">uwerem</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">ußgezogen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> haben Ihr <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">bygefüegt</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">er</unclear> abschrifft mit <unclear cert="medium" resp="#joint">mehrerem</unclear> <unclear cert="medium" resp="#joint">zuovernemmen</unclear>. <unclear cert="medium" resp="#joint">Wan</unclear> <unclear cert="medium" resp="#joint">nun</unclear> aber das
<lb n="10"/><unclear cert="low" resp="#joint">wenigste</unclear> <unclear cert="low" resp="#joint">derglychen</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">beschehen</unclear>, <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">einich</unclear> <unclear cert="low" resp="#joint">wüßens</unclear> <unclear cert="low" resp="#joint">haben</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear> die <unclear cert="medium" resp="#joint">uwerigen</unclear> <unclear cert="medium" resp="#joint">gsehen</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">thuot</unclear> es, <unclear cert="medium" resp="#joint">daß</unclear> by <unclear cert="low" resp="#joint">hoechstgedachter</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">Ihrer</unclear> <unclear cert="low" resp="#joint">Keys</unclear>. <unclear cert="low" resp="#joint">Myt</unclear>. <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">solcher</unclear> <unclear cert="low" resp="#joint">gestalten</unclear> <unclear cert="low" resp="#joint">angegeben</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">deß</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">froembd</unclear> und nachgedencklich fürkommen, und umb <unclear cert="medium" resp="#joint">sovil</unclear> <unclear cert="medium" resp="#joint">mehr</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">daß</unclear> es sich <unclear cert="low" resp="#joint">ansehen</unclear> <unclear cert="low" resp="#joint">laßet</unclear>, ein <unclear cert="medium" resp="#joint">solch</unclear> <unclear cert="medium" resp="#joint">uerheblich</unclear> von <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">mißgünst</unclear>-
<lb n="15"/>igen <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">Lobl</unclear>. <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydtgnoschafft</unclear></orgName> <unclear cert="low" resp="#joint">selbsten</unclear>, <unclear cert="low" resp="#joint">dardurch</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">unwillen</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">un</unclear>-
<lb n="16"/><unclear cert="low" resp="#joint">gunst</unclear> beschweren <unclear cert="medium" resp="#joint">wellen</unclear> <unclear cert="medium" resp="#joint">beschehen</unclear> <unclear cert="medium" resp="#joint">syn</unclear> <unclear cert="medium" resp="#joint">mueße</unclear>. Und habend <unclear cert="medium" resp="#joint">deß</unclear>-
<lb n="17"/>halb nit <unclear cert="medium" resp="#joint">underlaßen</unclear> <unclear cert="medium" resp="#joint">koennen</unclear>, <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">G</unclear>. <unclear cert="medium" resp="#joint">L</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">nebent</unclear> der
<lb n="18"/>participation <unclear cert="medium" resp="#joint">gedachts</unclear> schrybens, hiemit <unclear cert="low" resp="#joint">fründt-Eydtgnossischen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">zebethen</unclear> und <unclear cert="low" resp="#joint">zeersuochen</unclear>, <unclear cert="low" resp="#joint">maaßen</unclear> gegen <unclear cert="medium" resp="#joint">vilen</unclear> und <unclear cert="medium" resp="#joint">unsere</unclear> auch
<lb n="20"/><unclear cert="medium" resp="#joint">G</unclear>. <unclear cert="medium" resp="#joint">L</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. der übrigen <unclear cert="low" resp="#joint">Orthen</unclear> <unclear cert="low" resp="#joint">ebenmeßig</unclear> <unclear cert="low" resp="#joint">beschicht</unclear>, <unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="low" resp="#joint">ohnbe</unclear>-
<lb n="21"/><unclear cert="low" resp="#joint">schwerdt</unclear> <unclear cert="low" resp="#joint">syn</unclear> <unclear cert="low" resp="#joint">woellind</unclear>, zuo der <unclear cert="low" resp="#joint">erkundigung</unclear>, <unclear cert="low" resp="#joint">warmenhero</unclear> unß <unclear cert="low" resp="#joint">solche</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">zuolag</unclear> <unclear cert="low" resp="#joint">ufgetragen</unclear> <unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">syn</unclear> <unclear cert="low" resp="#joint">moechte</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">uwerige</unclear> <unclear cert="low" resp="#joint">Eydtgnossisch</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">contribuieren</unclear>, und unß <unclear cert="medium" resp="#joint">deßen</unclear>, <unclear cert="medium" resp="#joint">was</unclear> <unclear cert="medium" resp="#joint">Ihr</unclear> in <unclear cert="low" resp="#joint">erfahrung</unclear> <unclear cert="low" resp="#joint">bringend</unclear>,
<lb n="24"/><unclear cert="low" resp="#joint">zeberichten</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">fernerer</unclear> <unclear cert="low" resp="#joint">nothurfft</unclear> darüber <unclear cert="medium" resp="#joint">fürzunemmen</unclear> <unclear cert="medium" resp="#joint">haben</unclear>.
<lb n="25"/><unclear cert="medium" resp="#joint">Wir</unclear> <unclear cert="medium" resp="#joint">wüßend</unclear> unß <unclear cert="low" resp="#joint">zwarhen</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">zueerinneren</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">wyland</unclear> <unclear cert="low" resp="#joint">unser</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">hiebevor</unclear> in <unclear cert="medium" resp="#joint">Eydtgnoßischer</unclear> <unclear cert="medium" resp="#joint">verthrüwligkeit</unclear> <unclear cert="medium" resp="#joint">angesynnen</unclear>,
<lb n="27"/>by den <unclear cert="medium" resp="#joint">uwerigen</unclear> die <unclear cert="low" resp="#joint">versechung</unclear> <unclear cert="low" resp="#joint">gethuon</unclear>, <unclear cert="low" resp="#joint">daß</unclear> sy nit <unclear cert="low" resp="#joint">sovil</unclear> <unclear cert="low" resp="#joint">ussert</unclear> <unclear cert="low" resp="#joint">uweres</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">Landts</unclear> <unclear cert="low" resp="#joint">verschickind</unclear>, von <unclear cert="medium" resp="#joint">einicher</unclear> sonderbaren <unclear cert="medium" resp="#joint">Keyserlicher</unclear> be-
<lb n="29"/>stellung aber ist unß <unclear cert="medium" resp="#joint">nüzit</unclear> in <unclear cert="medium" resp="#joint">wüßen</unclear> gewesen, wie <unclear cert="low" resp="#joint">ermagnus</unclear>,
<lb n="30"/>und eben so <unclear cert="medium" resp="#joint">wenig</unclear> habend <unclear cert="medium" resp="#joint">wir</unclear>, <unclear cert="medium" resp="#joint">wie</unclear> man unß <unclear cert="low" resp="#joint">zuogemeßen</unclear> <unclear cert="low" resp="#joint">daruß</unclear>
<pb facs="StadtASG_Missive_3101_12208.jpg" n="2"/>
<lb n="31"/>ützet an <unclear cert="low" resp="#joint">ußgezogen</unclear>, und söllend also auch <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">glauben</unclear>, <unclear cert="low" resp="#joint">wylen</unclear> ihr
<lb n="32"/><unclear cert="low" resp="#joint">unsre</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">luth</unclear> <unclear cert="low" resp="#joint">unßers</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">üch</unclear> uff den <date resp="#ner">22.ten Jungst ver=
<lb n="33"/>wichnen monats</date> abgebenen, gedachten den üwerigen wider die
<lb n="34"/>verfürung zuogesprochen, daß villichten uß= und von Ihnnen naher
<lb n="35"/>ein sölicher lümbden uff unß kommen syn möchte, Wir wollend
<lb n="36"/>aber deß brichts über die ansechende erkundigung üwer syts
<lb n="37"/>glych wie von anderen orthen her gern erwarten, und hiemit unß
<lb n="38"/>sambtlichen dem schirm Gottes wol empfelchen. Geben den <origDate when="1635" resp="#ner">11.ten
<lb n="39"/>Julii. Anno 1635.</origDate>
<lb n="40"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und Raht
<lb n="41"/>der stadt Zürich</orgName>.
<pb facs="StadtASG_Missive_3101_12209.jpg" n="3"/>
<pb facs="StadtASG_Missive_3101_12210.jpg" n="4"/>
<lb n="42"/>Den fromen, fürsichtigen, Ehr=
<lb n="43"/>samen, wyßen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister
<lb n="44"/>und Rath der Stadt Sant
<lb n="45"/>Gallen</orgName>. Unseren besonders
<lb n="46"/>guten fründen und getrüwen
<lb n="47"/>lieben <orgName role="recipient" resp="#ner">Eidtgnoßen</orgName>.
</p>
