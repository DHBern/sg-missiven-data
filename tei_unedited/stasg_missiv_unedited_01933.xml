<p>
<pb facs="StadtASG_Missive_1933_7199.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründt</unclear>: nachbarlich willig dienst, und was
<lb n="2"/>wir <unclear cert="medium" resp="#joint">liebs</unclear> und <unclear cert="medium" resp="#joint">guts</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear> <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="medium" resp="#joint">frommer</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">Edler</unclear>, <unclear cert="medium" resp="#joint">Ehrnvester</unclear> und <unclear cert="medium" resp="#joint">Weiser</unclear>, sonders <unclear cert="medium" resp="#joint">lieber</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">Herr</unclear> <unclear cert="medium" resp="#joint">Landtvogt</unclear>, und <unclear cert="low" resp="#joint">guter</unclear> <unclear cert="low" resp="#joint">fründ</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">Uff</unclear> <unclear cert="low" resp="#joint">euwer</unclear> an <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">Stattschreiber</unclear> abgangen
<lb n="6"/>schreiben, und <unclear cert="medium" resp="#joint">zeigers</unclear> <unclear cert="medium" resp="#joint">diß</unclear>, <unclear cert="medium" resp="#joint">euwers</unclear> <unclear cert="medium" resp="#joint">abgefertigten</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">Gwaltsbotten</unclear> <unclear cert="medium" resp="#joint">ferners</unclear> schrifft: und <unclear cert="medium" resp="#joint">mundt=</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">liches</unclear> <unclear cert="medium" resp="#joint">begeren</unclear>, haben <unclear cert="medium" resp="#joint">wir</unclear> nit <unclear cert="medium" resp="#joint">ermanglet</unclear>
<lb n="9"/>nachbemelte <unclear cert="low" resp="#joint">zeügen</unclear> <unclear cert="low" resp="#joint">zuverhoeren</unclear>,
<lb n="10"/>welche wir mit <unclear cert="low" resp="#joint">einem</unclear> <unclear cert="low" resp="#joint">leiblich</unclear> <unclear cert="low" resp="#joint">geschwornem</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">eid</unclear> beladen, und <unclear cert="medium" resp="#joint">bey</unclear> <unclear cert="medium" resp="#joint">demselbigen</unclear> uff <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">ex</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">miniert</unclear> <unclear cert="low" resp="#joint">deren</unclear> <unclear cert="low" resp="#joint">puncten</unclear> <unclear cert="low" resp="#joint">halber</unclear>, so <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">er=</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">oeffnet</unclear> <unclear cert="low" resp="#joint">worden</unclear>: die haben <unclear cert="medium" resp="#joint">bezügt</unclear>
<lb n="14"/>und <unclear cert="medium" resp="#joint">ußgesagt</unclear>, wie <unclear cert="medium" resp="#joint">volgt</unclear>.
<lb n="15"/><persName resp="#ner">Jacob Hartman <unclear cert="low" resp="#joint">Jung</unclear></persName> <unclear cert="low" resp="#joint">gebohrner</unclear> burg
<lb n="16"/><unclear cert="low" resp="#joint">allhie</unclear>, sagt,
<lb n="17"/><unclear cert="medium" resp="#joint">dicta</unclear> <unclear cert="medium" resp="#joint">testium</unclear>, <unclear cert="medium" resp="#joint">etc</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">postea</unclear>
<lb n="19"/>Welche <unclear cert="medium" resp="#joint">Ußsagen</unclear> wir <unclear cert="medium" resp="#joint">eüch</unclear> hiemit zur
<lb n="20"/>nachrichtung <unclear cert="low" resp="#joint">begerter</unclear> <unclear cert="low" resp="#joint">maßen</unclear>, <unclear cert="low" resp="#joint">schrifftlich</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">verschloßen</unclear> <unclear cert="low" resp="#joint">zusenden</unclear> <unclear cert="low" resp="#joint">woellen</unclear>, <unclear cert="low" resp="#joint">denen</unclear>
<lb n="22"/>wir in <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">zudienen</unclear> <unclear cert="low" resp="#joint">geneigt</unclear>
<lb n="23"/>und <unclear cert="medium" resp="#joint">anerbietig</unclear>. <unclear cert="medium" resp="#joint">Uns</unclear> <unclear cert="medium" resp="#joint">darmit</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">samtlich</unclear> <unclear cert="medium" resp="#joint">goettlicher</unclear> obhalt in <unclear cert="medium" resp="#joint">trüwe</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">bevelhende</unclear>. Datum den. <origDate when="1615" resp="#ner"><unclear cert="low" resp="#joint">28</unclear>. <unclear cert="low" resp="#joint">tl</unclear>.
<lb n="26"/><unclear cert="low" resp="#joint">Febr</unclear>: <unclear cert="low" resp="#joint">1615</unclear></origDate>.
<lb n="27"/>B. v <unclear cert="medium" resp="#joint">Rth</unclear>.
<lb n="28"/><unclear cert="medium" resp="#joint">Dem</unclear> frommen Edlen Ehrnvesten <unclear cert="low" resp="#joint">frund</unclear> <unclear cert="low" resp="#joint">wsn</unclear>
<lb n="29"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Heinrich</unclear> <unclear cert="low" resp="#joint">Elmer</unclear></persName> des Raths und <unclear cert="low" resp="#joint">Pannerherrn</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-73" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Glaruß</unclear></placeName>, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">Landtvogt</unclear>, <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">obern</unclear>
<lb n="31"/>und <unclear cert="medium" resp="#joint">nidern</unclear> <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Turgoew</unclear></placeName>, <unclear cert="medium" resp="#joint">unserem</unclear> <unclear cert="medium" resp="#joint">son</unclear>
<lb n="32"/>lieben Herrn und <unclear cert="medium" resp="#joint">guten</unclear> <unclear cert="medium" resp="#joint">fründ</unclear>.
<pb facs="StadtASG_Missive_1933_7200.jpg" n="2"/>
<lb n="33"/>[]
</p>
