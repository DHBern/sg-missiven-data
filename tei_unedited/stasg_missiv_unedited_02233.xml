<lb n="100"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">schreiben</unclear>. So haben wir <unclear cert="medium" resp="#joint">ihme</unclear>
<lb n="101"/>in <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">herauß</unclear> <unclear cert="low" resp="#joint">bestimbt</unclear> <unclear cert="low" resp="#joint">vnd¤</unclear>
