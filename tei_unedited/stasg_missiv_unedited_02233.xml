<lb n="11"/>und <unclear cert="low" resp="#joint">jurisdiction</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">straeutz</unclear> injuri und
<lb n="13"/>schmachredn erregt, umb
<lb n="14"/>welhes willen sie beidersits
<lb n="15"/>rechtlich vor uns gestanden. Wyln
<lb n="16"/>aber <unclear cert="low" resp="#joint">ermelter</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Schlatter</unclear></persName>
<lb n="17"/><unclear cert="low" resp="#joint">damahln</unclear> dilation und
<lb n="18"/><unclear cert="low" resp="#joint">ufschub</unclear> <unclear cert="low" resp="#joint">begert</unclear> <unclear cert="low" resp="#joint">dergestalt</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">weill</unclear> er mit <unclear cert="low" resp="#joint">kundschaften</unclear>
<lb n="20"/>so wohl <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">disem</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">eim</unclear> <unclear cert="low" resp="#joint">andern</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">vorhero</unclear> mit ihme <persName resp="#ner">Jaelgen</persName>, allhie ver-
<lb n="22"/>lofnen handels halber, nit gefast
<lb n="23"/>habe wir ihme damit er sich
<lb n="24"/><unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">uns</unclear> nicht z'clagen dilation
<lb n="25"/><unclear cert="low" resp="#joint">erkennt</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">dan</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jaelg</unclear></persName>
