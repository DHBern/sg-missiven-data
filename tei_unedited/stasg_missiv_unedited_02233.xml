<lb n="76"/><unclear cert="low" resp="#joint">fuegt</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">recht</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">versprechen</unclear> <unclear cert="low" resp="#joint">vnd</unclear>
<lb n="77"/><unclear cert="low" resp="#joint">schafft</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">vnsers</unclear> <unclear cert="low" resp="#joint">burgers</unclear> <unclear cert="low" resp="#joint">darumb</unclear>
