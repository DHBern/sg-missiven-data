<p>
<pb facs="StadtASG_Missive_2233_8439.jpg" n="1"/>
<lb n="1"/>Unser freundt, nachpuelich willig
<lb n="2"/>dienst zuvor, edle gestreng,
<lb n="3"/>vest und weise, insonders liebe
<lb n="4"/>herrn Landtvogt guote freundt
<lb n="5"/>und <unclear cert="low" resp="#joint">nachpur</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">im</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">Monat</unclear> <unclear cert="low" resp="#joint">Maio</unclear></date>,
<lb n="7"/><unclear cert="low" resp="#joint">zwüschet</unclear> <persName resp="#ner">Hannß Jaelgen</persName> von
<lb n="8"/><placeName resp="#ner">Allmißperg</placeName>, und <persName resp="#ner">Jacob Schlattern</persName>
<lb n="9"/>von <placeName ref="stadtasg-places-1" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Ruoßrüti</unclear></placeName>, <unclear cert="low" resp="#joint">beiden</unclear> <unclear cert="low" resp="#joint">ußem</unclear>
