<lb n="68"/><unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">vnserer</unclear> <unclear cert="low" resp="#joint">befuegniß</unclear>, <unclear cert="low" resp="#joint">vnd</unclear> Er sich <unclear cert="low" resp="#joint">scheint</unclear> <unclear cert="low" resp="#joint">beschwärlich</unclear> <unclear cert="low" resp="#joint">wollen</unclear>,
<lb n="69"/>als <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">frembden</unclear> <unclear cert="low" resp="#joint">obrigkeit</unclear>
<lb n="70"/>in <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">olders</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">was</unclear>
