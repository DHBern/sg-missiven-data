<lb n="13"/><unclear cert="low" resp="#joint">jn</unclear> <unclear cert="low" resp="#joint">dergleichen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">anderem</unclear> <unclear cert="low" resp="#joint">zuerwideren</unclear>,
<lb n="14"/>und alle <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">nachbarliche</unclear> correspondenz
<lb n="15"/><unclear cert="low" resp="#joint">beharlich</unclear> <unclear cert="low" resp="#joint">zuunderhalten</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">jederzeit</unclear>
<lb n="16"/>willig verbleiben, Und weil <unclear cert="medium" resp="#joint">unß</unclear>
<lb n="17"/>von anderen orten, auch was <unclear cert="medium" resp="#joint">vertrewlich</unclear>
<lb n="18"/>communicirt worden, haben wir <unclear cert="medium" resp="#joint">selbiges</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">hiemit</unclear> <unclear cert="medium" resp="#joint">beizuschließen</unclear> <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">underlaßen</unclear>
