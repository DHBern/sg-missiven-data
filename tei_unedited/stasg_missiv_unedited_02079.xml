<p>
<pb facs="StadtASG_Missive_2079_7785.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündt</unclear>: <unclear cert="low" resp="#joint">und</unclear> nachbarlich willig dienst
<lb n="2"/>zuvor fürsichtige <unclear cert="medium" resp="#joint">ehrsame</unclear> und weise <unclear cert="medium" resp="#joint">besonders</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">liebe</unclear> und <unclear cert="medium" resp="#joint">gute</unclear> freündt.
<lb n="4"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. schreiben vom <date resp="#ner"><unclear cert="medium" resp="#joint">12</unclear>. <unclear cert="medium" resp="#joint">diß</unclear></date> <unclear cert="medium" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">unß</unclear> abgangen,
<lb n="5"/><unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">deme</unclear> <unclear cert="low" resp="#joint">jnschluß</unclear>, <unclear cert="low" resp="#joint">betreffend</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">durchs</unclear>
<lb n="6"/><placeName ref="stadtasg-places-99" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Tyrol</unclear></placeName> und <placeName resp="#ner"><unclear cert="low" resp="#joint">Friaul</unclear></placeName> <unclear cert="low" resp="#joint">passierende</unclear> <unclear cert="low" resp="#joint">kriegsvolckh</unclear>,
<lb n="7"/>haben wir mit sonderm <unclear cert="medium" resp="#joint">angenemmen</unclear> belieben
<lb n="8"/><unclear cert="low" resp="#joint">empfangen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">jnhalts</unclear> <unclear cert="low" resp="#joint">vernomen</unclear>, der-
<lb n="9"/>gleichen <unclear cert="low" resp="#joint">aviso</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">eben</unclear> <unclear cert="low" resp="#joint">derzeit</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">mehr</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">orten</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">zukomen</unclear>, <unclear cert="low" resp="#joint">Solcher</unclear> <unclear cert="low" resp="#joint">nachbar</unclear>-
