<lb n="21"/><unclear cert="medium" resp="#joint">licher</unclear> protection <unclear cert="medium" resp="#joint">befelhende</unclear>. <unclear cert="medium" resp="#joint">Datum</unclear> <origDate when="1617-12-17" resp="#ner"><unclear cert="medium" resp="#joint">17</unclear>.
