<lb n="31"/><unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-40" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Kempten</unclear></placeName> <unclear cert="low" resp="#joint">ankommen</unclear>.
