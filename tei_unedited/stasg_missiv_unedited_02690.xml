<p>
<pb facs="StadtASG_Missive_2690_10445.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freündtlich</unclear> willig dienst sampt <unclear cert="medium" resp="#joint">waß</unclear> wir ehren
<lb n="2"/>liebs <unclear cert="medium" resp="#joint">und</unclear> guots vermögen <unclear cert="medium" resp="#joint">zuovor</unclear>, fromm, fürsichtig,
<lb n="3"/>ehrsam, weiß, insonders guot <unclear cert="medium" resp="#joint">freündt</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">getreüw</unclear>
<lb n="4"/>lieb <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eÿdtgnoßen</unclear></orgName>.
<lb n="5"/>Wir <unclear cert="medium" resp="#joint">hettend</unclear> unß <unclear cert="medium" resp="#joint">versehen</unclear>, es wurden <unclear cert="medium" resp="#joint">eüwere</unclear> burger
<lb n="6"/>die edlen <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">vesten</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Joachim</unclear></persName>, <persName resp="#ner"><unclear cert="low" resp="#joint">Laurentz</unclear></persName>, unnd
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">Davidt</unclear> <unclear cert="low" resp="#joint">Zollighoffere</unclear></persName> <unclear cert="low" resp="#joint">vertröster</unclear> maaßen ihr original
<lb n="8"/>obligation umb ihre an die fallierte <persName resp="#ner"><unclear cert="medium" resp="#joint">Peÿer</unclear></persName> und <persName resp="#ner"><unclear cert="medium" resp="#joint">Huober</unclear></persName>
<lb n="9"/>habende <unclear cert="medium" resp="#joint">ansprach</unclear> unnd forderung, durch ihre verordnete
<lb n="10"/><unclear cert="medium" resp="#joint">anwäldt</unclear> unß <unclear cert="medium" resp="#joint">fürweißen</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">auflegen</unclear> laßen.
<lb n="11"/><unclear cert="medium" resp="#joint">Dieweill</unclear> wir aber <unclear cert="medium" resp="#joint">jüngst</unclear> von <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">unßeren</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">getreüwen</unclear> lieben <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eÿdtgnoßen</unclear></orgName> verstanden, daß
<lb n="13"/><unclear cert="medium" resp="#joint">sÿ</unclear> bemelte verschreibung ohn <unclear cert="medium" resp="#joint">einig</unclear> <unclear cert="medium" resp="#joint">erhebliche</unclear> <unclear cert="medium" resp="#joint">ursach</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">eüch</unclear> in <unclear cert="medium" resp="#joint">eüweren</unclear> <unclear cert="medium" resp="#joint">behalt</unclear> <unclear cert="medium" resp="#joint">übergeben</unclear>: <unclear cert="medium" resp="#joint">alß</unclear> langt hiemit
<lb n="15"/>an <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">unßer</unclear> <unclear cert="medium" resp="#joint">freündt</unclear> <unclear cert="medium" resp="#joint">Eÿdtgnößisches</unclear> <unclear cert="medium" resp="#joint">ersuochen</unclear>, ihr <unclear cert="medium" resp="#joint">sÿ</unclear>
<lb n="16"/>dahin vermögen <unclear cert="medium" resp="#joint">wöllen</unclear>, daß <unclear cert="medium" resp="#joint">sÿ</unclear> fürderlich solche ihr
<lb n="17"/>habende <unclear cert="medium" resp="#joint">gerechtsame</unclear> in originali <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">fürzeigen</unclear> unnd
<lb n="18"/><unclear cert="medium" resp="#joint">überantworten</unclear> sollend: <unclear cert="medium" resp="#joint">Inn</unclear> <unclear cert="medium" resp="#joint">betrachttung</unclear> daß solches
<lb n="19"/><unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">orten</unclear> inn: <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">usserhalb</unclear> loblicher <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eÿdtgnoschaft</unclear></orgName>
<lb n="20"/>in rechtlichem gebrauch unnd <unclear cert="medium" resp="#joint">üebung</unclear> ist: <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">ouch</unclear> den
<lb n="21"/><unclear cert="medium" resp="#joint">darvon</unclear> genommenen <unclear cert="medium" resp="#joint">Copeÿen</unclear> <unclear cert="medium" resp="#joint">glouben</unclear> zegeben, noch
<lb n="22"/>darüber <unclear cert="medium" resp="#joint">recht</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">gerechttigkeit</unclear> <unclear cert="medium" resp="#joint">zeverwalten</unclear>,
<lb n="23"/><unclear cert="medium" resp="#joint">ald</unclear> <unclear cert="medium" resp="#joint">ihnen</unclear> <unclear cert="medium" resp="#joint">zuobeziehung</unclear> ihres <unclear cert="medium" resp="#joint">außstandts</unclear> einige
<lb n="24"/>beförderung <unclear cert="medium" resp="#joint">zethuon</unclear> nit schuldig <unclear cert="medium" resp="#joint">seind</unclear>. <unclear cert="medium" resp="#joint">Wöllend</unclear>
<lb n="25"/>derhalben unß <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">getrösten</unclear>, ihr <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">denselben</unclear>
<lb n="26"/>die <unclear cert="medium" resp="#joint">verfüegung</unclear> <unclear cert="medium" resp="#joint">thuon</unclear> <unclear cert="medium" resp="#joint">werdend</unclear>, daß <unclear cert="medium" resp="#joint">sÿ</unclear> ihre habende
<lb n="27"/>authentische verschreibung unß durch sich selbst, oder
<lb n="28"/>ihre <unclear cert="medium" resp="#joint">anwäldt</unclear> zeigen unnd <unclear cert="medium" resp="#joint">weißen</unclear> sollend.
<lb n="29"/>Welches <unclear cert="medium" resp="#joint">nebend</unclear> <unclear cert="medium" resp="#joint">dem</unclear> es <unclear cert="medium" resp="#joint">recht</unclear>, <unclear cert="medium" resp="#joint">üeblich</unclear>, billich
<lb n="30"/><unclear cert="medium" resp="#joint">und</unclear> nothwendig ist, <unclear cert="medium" resp="#joint">seind</unclear> wir es <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">eüwere</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">angewandte</unclear> <unclear cert="medium" resp="#joint">Eÿdtgnößisch</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear> <unclear cert="medium" resp="#joint">zuobe</unclear>-
