<lb n="16"/><unclear cert="low" resp="#joint">Kastants</unclear> <unclear cert="low" resp="#joint">verlasstenschafft</unclear> khain <unclear cert="medium" resp="#joint">anspruch</unclear>, aber <unclear cert="medium" resp="#joint">sines</unclear>
<lb n="17"/>Bruoders <unclear cert="low" resp="#joint">unßers</unclear> <unclear cert="low" resp="#joint">hindersessen</unclear> <unclear cert="low" resp="#joint">Othmar</unclear> <unclear cert="low" resp="#joint">Kastants</unclear> <unclear cert="low" resp="#joint">seligen</unclear>
