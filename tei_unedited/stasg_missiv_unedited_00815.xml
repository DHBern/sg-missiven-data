<lb n="5"/>uff <unclear cert="low" resp="#joint">sinnen</unclear> <unclear cert="low" resp="#joint">ueberschlag</unclear>, mit <unclear cert="low" resp="#joint">einem</unclear> <unclear cert="low" resp="#joint">permentinen</unclear> <unclear cert="low" resp="#joint">offnnen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Edict</unclear>, <unclear cert="low" resp="#joint">wylandt</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Joerg</unclear> <unclear cert="low" resp="#joint">Kastants</unclear></persName>, <unclear cert="low" resp="#joint">Eüwers</unclear> <unclear cert="low" resp="#joint">Buergers</unclear>,
