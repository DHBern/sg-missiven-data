<p>
<pb facs="StadtASG_Missive_815_2209.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">frundtlich</unclear> willig dienst <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">from</unclear>, <unclear cert="medium" resp="#joint">fuersichtig</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">weise</unclear>, <unclear cert="medium" resp="#joint">sunders</unclear> lieben <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guoeten</unclear> <unclear cert="medium" resp="#joint">frundt</unclear>, was uns
<lb n="3"/><persName resp="#ner">Ullrich <unclear cert="medium" resp="#joint">Zuoellighoffer</unclear></persName> zuo <placeName ref="stadtasg-places-136" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Nenggen</unclear></placeName> <unclear cert="low" resp="#joint">sorg</unclear> <unclear cert="low" resp="#joint">Stattamman</unclear>
