<lb n="37"/>Ir <unclear cert="low" resp="#joint">wellet</unclear> <unclear cert="low" resp="#joint">unß</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unßern</unclear> Burgern zum besten, <unclear cert="medium" resp="#joint">sry</unclear> <unclear cert="medium" resp="#joint">Restants</unclear>
