<lb n="26"/>Comissario <unclear cert="medium" resp="#joint">unßerm</unclear> mit <unclear cert="low" resp="#joint">Rathay</unclear>, <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">beruembten</unclear> <unclear cert="low" resp="#joint">diebß</unclear> <unclear cert="low" resp="#joint">offentlich</unclear>
