<lb n="28"/><unclear cert="low" resp="#joint">stehn</unclear>, unnd <unclear cert="medium" resp="#joint">gantzer</unclear> handlung <unclear cert="low" resp="#joint">ußtrag</unclear> <unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">Erbietten</unclear> nach
<lb n="29"/><unclear cert="low" resp="#joint">Erwartten</unclear> soll.
<lb n="30"/>Weil <unclear cert="low" resp="#joint">dan</unclear> nicht <unclear cert="low" resp="#joint">allein</unclear> deß wegen <unclear cert="low" resp="#joint">hie</unclear> <unclear cert="low" resp="#joint">be</unclear> <unclear cert="low" resp="#joint">vorgenden</unclear> <unclear cert="low" resp="#joint">ansehenlichen</unclear>
<lb n="31"/>Costen <unclear cert="low" resp="#joint">auffgehn</unclear>, (<unclear cert="low" resp="#joint">daß</unclear> Recht <unclear cert="medium" resp="#joint">Thue</unclear> will) <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">vrthell</unclear>
<lb n="32"/>auch <unclear cert="medium" resp="#joint">o</unclear> <unclear cert="medium" resp="#joint">baldt</unclear>, wider alß fur <unclear cert="low" resp="#joint">Ihne</unclear> <unclear cert="low" resp="#joint">gesprochen</unclear>, unnd Er Ein
<lb n="33"/>Theil deßwegen mit Costen unnd <unclear cert="medium" resp="#joint">straff</unclear> <unclear cert="medium" resp="#joint">unden</unclear> <unclear cert="medium" resp="#joint">ligen</unclear> <unclear cert="medium" resp="#joint">moechte</unclear>,
<lb n="34"/>Er <unclear cert="low" resp="#joint">Restant</unclear> aber sit hero sich <unclear cert="low" resp="#joint">absensiert</unclear> gehalten, unnd allso
<lb n="35"/><unclear cert="low" resp="#joint">sache</unclear> wider alher gelangt.
