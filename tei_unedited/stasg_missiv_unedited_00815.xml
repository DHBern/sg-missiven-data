<lb n="19"/>schwester <unclear cert="low" resp="#joint">angemelts</unclear> <unclear cert="low" resp="#joint">Joerg</unclear> <unclear cert="low" resp="#joint">Kastants</unclear> <unclear cert="low" resp="#joint">verlassenschaft</unclear>
<lb n="20"/>Ein Erb zue <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">vermaint</unclear>. <unclear cert="low" resp="#joint">sint</unclear> <unclear cert="low" resp="#joint">etwz</unclear> zeit <unclear cert="low" resp="#joint">dermassen</unclear>
