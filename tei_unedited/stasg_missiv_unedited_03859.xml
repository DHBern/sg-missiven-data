<lb n="45"/>aber <unclear cert="low" resp="#joint">könen</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">andren</unclear> <unclear cert="low" resp="#joint">nichts</unclear> <unclear cert="low" resp="#joint">nachlaßen</unclear>: <unclear cert="low" resp="#joint">deß</unclear>
