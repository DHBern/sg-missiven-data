<lb n="42"/>so wol er, als die partten gegen <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">andren</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">hoch</unclear> <unclear cert="low" resp="#joint">ge</unclear>
