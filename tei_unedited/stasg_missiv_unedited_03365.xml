<p>
<pb facs="StadtASG_Missive_3365_13379.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründtlich</unclear> willig dienst, <unclear cert="medium" resp="#joint">sambt</unclear>
<lb n="2"/>was wir ehren liebs und <unclear cert="medium" resp="#joint">guets</unclear> ver-
<lb n="3"/><unclear cert="medium" resp="#joint">moegendt</unclear>, <unclear cert="medium" resp="#joint">zuvor</unclear>, <unclear cert="medium" resp="#joint">From</unclear>, Fürsichtig
<lb n="4"/><unclear cert="medium" resp="#joint">Ehrsam</unclear> <unclear cert="medium" resp="#joint">Weiß</unclear>, Insonders <unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">Fründe</unclear>
<lb n="5"/>und <unclear cert="medium" resp="#joint">getreüw</unclear> lieb <unclear cert="medium" resp="#joint">Eydgnossen</unclear>.
<lb n="6"/><unclear cert="medium" resp="#joint">Wir</unclear> habendt <unclear cert="low" resp="#joint">Eüwer</unclear>, <unclear cert="low" resp="#joint">unsre</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
<lb n="7"/><unclear cert="low" resp="#joint">underm</unclear> <unclear cert="low" resp="#joint">dato</unclear> <date resp="#ner">den <unclear cert="medium" resp="#joint">16.t</unclear> Augusti</date> <unclear cert="medium" resp="#joint">Jüngst</unclear>-
<lb n="8"/><unclear cert="medium" resp="#joint">hin</unclear> <unclear cert="medium" resp="#joint">abgangen</unclear> schriben <unclear cert="medium" resp="#joint">wohl</unclear> empfangen
<lb n="9"/>und <unclear cert="low" resp="#joint">daruß</unclear> <unclear cert="low" resp="#joint">Eüwer</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydgnoßschaft</unclear></orgName>
<lb n="10"/>begern, <unclear cert="low" resp="#joint">Iro</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">Abschrift</unclear> <unclear cert="low" resp="#joint">unser</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">jüngst</unclear> <unclear cert="low" resp="#joint">renovirten</unclear> und <unclear cert="medium" resp="#joint">bestimpten</unclear> Appo-
<lb n="12"/><unclear cert="medium" resp="#joint">tekher</unclear> <unclear cert="medium" resp="#joint">Tax</unclear>, wievil man für <unclear cert="medium" resp="#joint">dero</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">machen</unclear> und <unclear cert="low" resp="#joint">ußgwen</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Arzneyen</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">bezahlen</unclear> und entrichten solle <unclear cert="medium" resp="#joint">ubersenden</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">verstanden</unclear>.
<lb n="16"/>Wann wir dann <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">U</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>.
<lb n="17"/><unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">allein</unclear> in disem <unclear cert="low" resp="#joint">sonder</unclear> auch <unclear cert="low" resp="#joint">ein</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">mehrern</unclear> <unclear cert="low" resp="#joint">zegratificieren</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Eydgnossische</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">willfährigkeit</unclear> <unclear cert="low" resp="#joint">zeerzeigen</unclear> <unclear cert="low" resp="#joint">ganz</unclear> <unclear cert="low" resp="#joint">geneigt</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">Alß</unclear> <unclear cert="low" resp="#joint">ubersenden</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">Copiam</unclear> <unclear cert="low" resp="#joint">obangeregten</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">Appotegkher</unclear> <unclear cert="low" resp="#joint">Taxes</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">medicamentorum</unclear> <unclear cert="low" resp="#joint">tam</unclear> <unclear cert="low" resp="#joint">simplicium</unclear> <unclear cert="low" resp="#joint">quam</unclear> <unclear cert="low" resp="#joint">compositorum</unclear> <unclear cert="low" resp="#joint">begerter</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">maßen</unclear>, <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">gelegenheit</unclear>, <unclear cert="low" resp="#joint">die</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">fremdt</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydgnoßschafft</unclear></orgName> <unclear cert="low" resp="#joint">ersuchend</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">nachstem</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">bekommen</unclear> <unclear cert="low" resp="#joint">also</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">Eüch</unclear> nit <unclear cert="medium" resp="#joint">ehnd</unclear>, wie wir <unclear cert="medium" resp="#joint">zwar</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">gern</unclear> <unclear cert="medium" resp="#joint">gewolt</unclear> <unclear cert="medium" resp="#joint">hetten</unclear>, mit <unclear cert="medium" resp="#joint">selbiger</unclear> <unclear cert="medium" resp="#joint">willfahren</unclear>
<lb n="28"/><unclear cert="medium" resp="#joint">khonnen</unclear>
<pb facs="StadtASG_Missive_3365_13380.jpg" n="2"/>
<lb n="29"/>Sonsten wie obangedeuttet E. w. wir ußert H. L. C.
<lb n="30"/>in allen andern begebenden occurentien beliebendes
<lb n="31"/>Eidgnößisches gefallen zůerweißen, sige
<lb n="32"/>wier nochmals so willig alß anerbietig.
<lb n="33"/>Der reine Gottes Bott, diße uns samthlich
<lb n="34"/>in seiner heilign protection wolle erhaltn.
<lb n="35"/>Datum <origDate when="1629-09-09" resp="#ner">dn 9 tn Septembris Anno 1629</origDate>.
<lb n="36"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und Rhatt
<lb n="37"/>der Statt St. Gallen</orgName>.
<lb n="38"/>Ann <orgName ref="stadtasg-actors-28" cert="medium" role="recipient" resp="#ner">Burgermeister unnd Rhatt
<lb n="39"/>der Statt Schaffhußen</orgName>.
