    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2221_8393.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig dienste
<lb n="2"/>zuvor, Edler vester, fuersichtig
<lb n="3"/>und weiser, besonders lieber Herr
<lb n="4"/>und <unclear cert="low" resp="#joint">gueter</unclear> freündt.
<lb n="5"/>Nachdem <unclear cert="low" resp="#joint">iüngster</unclear> tagen <unclear cert="low" resp="#joint">unser</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">erkhomen</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Ernvest</unclear> lieber burger <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">Rainer</unclear></persName> deß Herren freündtlicher
<lb n="8"/>lieber brueder seliger, durch den
<lb n="9"/>willen deß Allmaechtigen Gottes
<lb n="10"/>auß <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">iamerhaften</unclear> <unclear cert="low" resp="#joint">trueb</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">seligen</unclear> <unclear cert="low" resp="#joint">leben</unclear> zu <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">ewigen</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">himlischen</unclear> <unclear cert="low" resp="#joint">freüde</unclear> <unclear cert="low" resp="#joint">abgevorderet</unclear>,
<lb n="13"/><unclear cert="low" resp="#joint">thunde</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">zevorderst</unclear> <unclear cert="low" resp="#joint">dem</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">dises</unclear> <unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">zugestanden</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">leidts</unclear> <unclear cert="low" resp="#joint">mitleidenlich</unclear> <unclear cert="low" resp="#joint">beklagen</unclear>,
<lb n="16"/>Gott bittende, daß er ihne
<lb n="17"/>in ander weg gnedig ergezen
<lb n="18"/>vor weiterem leid bewaren,
<lb n="19"/>ihme unserem burger s. ein
<lb n="20"/><unclear cert="low" resp="#joint">froliche</unclear> <unclear cert="low" resp="#joint">uferstendtnuß</unclear>, <unclear cert="low" resp="#joint">unß</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">ambt</unclear> <unclear cert="low" resp="#joint">sambtlich</unclear> zu seiner zeit
<lb n="22"/>ein <unclear cert="low" resp="#joint">seliges</unclear> <unclear cert="low" resp="#joint">christliches</unclear> <unclear cert="low" resp="#joint">endte</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">wolle</unclear> <unclear cert="low" resp="#joint">verleihen</unclear>.
<lb n="24"/><unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">ermelter</unclear> <unclear cert="low" resp="#joint">unser</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">burger</unclear> <unclear cert="low" resp="#joint">seliger</unclear> <unclear cert="low" resp="#joint">beneben</unclear> <unclear cert="low" resp="#joint">dem</unclear>
<lb n="26"/>Herren usserhalb unserer
<lb n="27"/>iurisdiction merer lehenhunds-
<lb n="28"/>lechen,
<pb facs="StadtASG_Missive_2221_8394.jpg" n="2"/>
<lb n="29"/>halten in nicht ermanglen
<lb n="30"/>woelle, damit sich zuebeclagen
<lb n="31"/>niemadts ursach habe, uff soelche
<lb n="32"/>nachsinung todtlich hinkait
<lb n="33"/>gsegne welt, alle seine ver-
<lb n="34"/>laßne sachen, durch <unclear cert="low" resp="#joint">unsern</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">hiezue</unclear> <unclear cert="low" resp="#joint">verordnete</unclear> <unclear cert="low" resp="#joint">zuebeschliessen</unclear>
<lb n="36"/>und <unclear cert="low" resp="#joint">verpitschirn</unclear> <unclear cert="low" resp="#joint">zuelassen</unclear>.
<lb n="37"/><unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">dieweil</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">allhiesigen</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">erben</unclear> <unclear cert="low" resp="#joint">zuefridenheit</unclear> <unclear cert="low" resp="#joint">aber</unclear>, <unclear cert="low" resp="#joint">unser</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">mitburger</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Ludwig</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">Kunz</unclear></persName>, in <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">behausung</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">mehrertheil</unclear> <unclear cert="low" resp="#joint">verwahrlichen</unclear> <unclear cert="low" resp="#joint">ist</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">ligen</unclear> <unclear cert="low" resp="#joint">thut</unclear>, <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">besorgen</unclear>, <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">moechte</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">underthon</unclear> <unclear cert="low" resp="#joint">fuersichtigkeit</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">solcher</unclear> <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">schaden</unclear>,
<lb n="45"/><unclear cert="low" resp="#joint">lag</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">abgschafft</unclear> <unclear cert="low" resp="#joint">werden</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">odn</unclear> <unclear cert="low" resp="#joint">hiedurch</unclear> <unclear cert="low" resp="#joint">in</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">ungleich</unclear> <unclear cert="low" resp="#joint">verdacht</unclear> <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">andern</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">miterben</unclear> <unclear cert="low" resp="#joint">wachsen</unclear>.
<lb n="49"/><unclear cert="low" resp="#joint">Endtlich</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">Ambts</unclear> <unclear cert="low" resp="#joint">halben</unclear> <unclear cert="low" resp="#joint">anlangen</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">lassen</unclear>, <unclear cert="low" resp="#joint">gehorsamlich</unclear> <unclear cert="low" resp="#joint">gebetten</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">habe</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ihme</unclear> solches nicht <unclear cert="low" resp="#joint">zue</unclear>-
<lb n="52"/><unclear cert="low" resp="#joint">verweigern</unclear> <unclear cert="low" resp="#joint">gewüßt</unclear>.
<lb n="53"/><unclear cert="low" resp="#joint">Als</unclear> <unclear cert="low" resp="#joint">gelangt</unclear> <unclear cert="low" resp="#joint">derowegen</unclear> an den
<lb n="54"/>herrn unser freündtlich ersuechen
<lb n="55"/>er <unclear cert="low" resp="#joint">woelle</unclear> <unclear cert="low" resp="#joint">aignen</unclear> <unclear cert="low" resp="#joint">sicheren</unclear> <unclear cert="low" resp="#joint">ainglich</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">einhweders</unclear> <unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">Anwaldt</unclear>
<pb facs="StadtASG_Missive_2221_8395.jpg" n="3"/>
<lb n="57"/><unclear cert="low" resp="#joint">zukrafft</unclear> <unclear cert="low" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">gebürenden</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">anthails</unclear> <unclear cert="low" resp="#joint">allhero</unclear> <unclear cert="low" resp="#joint">aborndne</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">im</unclear> allhie <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">schreiben</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">hiezuo</unclear> <unclear cert="low" resp="#joint">vollmechtig</unclear>, damit
<lb n="61"/>man unuerlengt zuer thaillung
<lb n="62"/>schreiten kuenne und <unclear cert="low" resp="#joint">iedem</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">eruolgen</unclear>, <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">billich</unclear> und erbliche gerech=
<lb n="65"/>tigkeit wegen gebüert und ge=
<lb n="66"/><unclear cert="low" resp="#joint">hört</unclear> <unclear cert="low" resp="#joint">möcht</unclear>.
<lb n="67"/><unclear cert="low" resp="#joint">Welches</unclear> <unclear cert="low" resp="#joint">wir</unclear> dem herren so
<lb n="68"/>wohl für vns selbst als
<lb n="69"/>uff der erben ersuoch zuo siner
<lb n="70"/>nachrichtung unangefüegt
<lb n="71"/>nicht lassen wellen, deme
<lb n="72"/>wir zuo allem freüntlichem
<lb n="73"/>und angenemem gefallen
<lb n="74"/>sonders <unclear cert="low" resp="#joint">wohlgeneigt</unclear> <unclear cert="low" resp="#joint">verbleiben</unclear>
<lb n="75"/><unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">vns</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">samptlich</unclear> <unclear cert="low" resp="#joint">goetlicher</unclear>
<lb n="76"/><unclear cert="low" resp="#joint">bewahr</unclear> <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">beuohlen</unclear> <unclear cert="low" resp="#joint">thuend</unclear>.
<lb n="77"/>Datum den <origDate when="1620-07-26" resp="#ner">26. Julii anno
<lb n="78"/>1620</origDate>.
<lb n="79"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermaister</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">rhate</unclear>
<lb n="80"/>der statt St. Gallen</orgName>.
<lb n="81"/>Dem edlen vesten <unclear cert="low" resp="#joint">fürsichtig</unclear>
<lb n="82"/><unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">weisen</unclear> <unclear cert="low" resp="#joint">herren</unclear> <persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Melchiorn</unclear>
<lb n="83"/><unclear cert="low" resp="#joint">Rainern</unclear></persName> <unclear cert="low" resp="#joint">stattreichtern</unclear> zuo
<lb n="84"/><placeName resp="#ner">Caschauw</placeName> in <placeName ref="stadtasg-places-41" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Ober</unclear> <unclear cert="low" resp="#joint">Ungern</unclear></placeName>.
<lb n="85"/><unclear cert="low" resp="#joint">vnserm</unclear> <unclear cert="low" resp="#joint">besonders</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">herren</unclear>
<lb n="86"/><unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">freündt</unclear>.
<pb facs="StadtASG_Missive_2221_8396.jpg" n="4"/>
<lb n="87"/>Dem Stattrichter zu <placeName resp="#ner">Caschauw</placeName> in <placeName ref="stadtasg-places-41" cert="medium" resp="#ner">ober
<lb n="88"/>Ungarn</placeName> <persName role="recipient" resp="#ner">Melchior Reniern</persName>,
<lb n="89"/><origDate when="1620-07-20" resp="#ner">20. Julij 1620</origDate>.
</p>
