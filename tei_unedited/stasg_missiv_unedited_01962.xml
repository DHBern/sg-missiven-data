        <body>
<p>
<pb facs="StadtASG_Missive_1962_7297.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freuend</unclear>, <unclear cert="medium" resp="#joint">nachbarlich</unclear> willig dienst und <unclear cert="medium" resp="#joint">grueß</unclear>,
<lb n="2"/>zuvor, <unclear cert="medium" resp="#joint">edler</unclear>, <unclear cert="medium" resp="#joint">vester</unclear>, <unclear cert="medium" resp="#joint">sonders</unclear> <unclear cert="medium" resp="#joint">lieber</unclear> <unclear cert="medium" resp="#joint">herr</unclear> vogt, <unclear cert="low" resp="#joint">gueter</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">freuend</unclear> und nachbar.
<lb n="4"/>Welcher <unclear cert="medium" resp="#joint">maßen</unclear> durch desselben <unclear cert="medium" resp="#joint">zuthun</unclear>, <unclear cert="medium" resp="#joint">mehr</unclear> <unclear cert="medium" resp="#joint">dann</unclear> <unclear cert="medium" resp="#joint">vor</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">dreyen</unclear> <unclear cert="medium" resp="#joint">monaten</unclear>, von wegen unsers <unclear cert="medium" resp="#joint">spitls</unclear>, auf <unclear cert="low" resp="#joint">der</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">statt</unclear> <placeName ref="stadtasg-places-5" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Arbon</unclear></placeName> und der <placeName resp="#ner"><unclear cert="medium" resp="#joint">Mahrnmüli</unclear></placeName>, noch <unclear cert="medium" resp="#joint">außstender</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">alten</unclear> <unclear cert="medium" resp="#joint">ziußen</unclear>, ein <unclear cert="medium" resp="#joint">vergleichung</unclear> <unclear cert="medium" resp="#joint">beschehen</unclear>, da <persName resp="#ner"><unclear cert="low" resp="#joint">Martin</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">Strauß</unclear></persName>, <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">Ambtsverwalthern</unclear> unsern <unclear cert="low" resp="#joint">Spitelherrn</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">eine</unclear> antwurt, ob <orgName ref="stadtasg-actors-102" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Statt</unclear>-
<lb n="10"/><unclear cert="medium" resp="#joint">aman</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear> zu <unclear cert="medium" resp="#joint">Arbon</unclear></orgName> die <unclear cert="medium" resp="#joint">abgeredte</unclear> <unclear cert="medium" resp="#joint">vergleichungs</unclear>-
<lb n="11"/><unclear cert="medium" resp="#joint">puncten</unclear> <unclear cert="medium" resp="#joint">aufzunemen</unclear> und sich <unclear cert="medium" resp="#joint">zuverschreiben</unclear> bedacht
<lb n="12"/><unclear cert="medium" resp="#joint">seye</unclear>, oder nit, <unclear cert="medium" resp="#joint">innen</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">nechsten</unclear> <unclear cert="medium" resp="#joint">acht</unclear> <unclear cert="medium" resp="#joint">tagen</unclear> hat
<lb n="13"/><unclear cert="medium" resp="#joint">sollen</unclear> <unclear cert="medium" resp="#joint">wüßen</unclear> lassen, <unclear cert="medium" resp="#joint">inmaßen</unclear> <unclear cert="medium" resp="#joint">ihme</unclear> zu <unclear cert="medium" resp="#joint">solchem</unclear> <unclear cert="medium" resp="#joint">end</unclear>,
<lb n="14"/>ein <unclear cert="medium" resp="#joint">copey</unclear> der <unclear cert="medium" resp="#joint">formb</unclear>, in <unclear cert="low" resp="#joint">nach</unclear> deren <unclear cert="low" resp="#joint">gemelte</unclear> <unclear cert="low" resp="#joint">Stattaman</unclear>
<lb n="15"/>und <unclear cert="medium" resp="#joint">Raht</unclear> sich verschreiben sollen, <unclear cert="low" resp="#joint">anhends</unclear> <unclear cert="low" resp="#joint">überschickht</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">worden</unclear>. <unclear cert="low" resp="#joint">Dessen</unclear> alles werden <unclear cert="medium" resp="#joint">sich</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. <unclear cert="medium" resp="#joint">zweifels</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">ohne</unclear> frey <unclear cert="medium" resp="#joint">unvearbeith</unclear> noch wol <unclear cert="medium" resp="#joint">wüssen</unclear> <unclear cert="medium" resp="#joint">zubesinnen</unclear>.
<lb n="18"/>Wiewol nun <unclear cert="medium" resp="#joint">ermelte</unclear> <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">Spitelherren</unclear> verhofft, es
<lb n="19"/><unclear cert="medium" resp="#joint">solte</unclear> <unclear cert="medium" resp="#joint">abgeredter</unclear> <unclear cert="medium" resp="#joint">maßen</unclear>, <unclear cert="medium" resp="#joint">besagter</unclear> <unclear cert="medium" resp="#joint">Strauß</unclear> sie <unclear cert="medium" resp="#joint">einer</unclear>
<lb n="20"/>antwurt, <unclear cert="medium" resp="#joint">weßen</unclear> er oder <orgName resp="#ner"><unclear cert="low" resp="#joint">Stattaman</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear></orgName> <unclear cert="medium" resp="#joint">hierüber</unclear>
<lb n="21"/>gesinnet seyen, <unclear cert="medium" resp="#joint">gewürdiget</unclear> haben,
<lb n="22"/>so werden <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">jedoch</unclear>
<lb n="23"/>von ihnen <unclear cert="medium" resp="#joint">berichtet</unclear>, daß <unclear cert="low" resp="#joint">weder</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Strauß</unclear> <unclear cert="low" resp="#joint">noch</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">Stattaman</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear> sie <unclear cert="medium" resp="#joint">seithero</unclear> <unclear cert="medium" resp="#joint">weder</unclear> <unclear cert="medium" resp="#joint">des</unclear> einen
<lb n="25"/>noch <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">andern</unclear>, <unclear cert="low" resp="#joint">ja</unclear> <unclear cert="low" resp="#joint">überal</unclear> gar <unclear cert="low" resp="#joint">nichts</unclear> <unclear cert="low" resp="#joint">wüßen</unclear>
<lb n="26"/>lassen, so sie nit <unclear cert="medium" resp="#joint">unbillich</unclear> <unclear cert="medium" resp="#joint">verwundere</unclear>, und <unclear cert="medium" resp="#joint">anderst</unclear>
<lb n="27"/>nit <unclear cert="medium" resp="#joint">erachten</unclear> <unclear cert="medium" resp="#joint">koennen</unclear>, dann <unclear cert="medium" resp="#joint">Strauß</unclear> sie also <unclear cert="low" resp="#joint">fürsetzlich</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">zuverkhleineren</unclear> <unclear cert="low" resp="#joint">vorhabens</unclear> seyn <unclear cert="medium" resp="#joint">müße</unclear>.
<lb n="29"/><unclear cert="medium" resp="#joint">Wann</unclear> nun aber sie <unclear cert="low" resp="#joint">hauptsaechlich</unclear> (<unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">weise</unclear> <unclear cert="low" resp="#joint">sie</unclear> dann
<lb n="30"/>fürs künfftig ein recht <unclear cert="medium" resp="#joint">darzu</unclear>.) mit dem <persName resp="#ner"><unclear cert="medium" resp="#joint">Straußen</unclear></persName>
<lb n="31"/><unclear cert="medium" resp="#joint">nichts</unclear> zuthun, <unclear cert="medium" resp="#joint">deßwegen</unclear> sie nit bedacht, sich <unclear cert="medium" resp="#joint">von</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">ihme</unclear> also verachtlich <unclear cert="medium" resp="#joint">herumb</unclear> <unclear cert="medium" resp="#joint">ziehen</unclear> <unclear cert="medium" resp="#joint">zulassen</unclear>, so
<lb n="33"/>haben sie sich <unclear cert="low" resp="#joint">erclert</unclear>, <unclear cert="low" resp="#joint">dieweilen</unclear> <unclear cert="low" resp="#joint">Strauß</unclear>
<lb n="34"/>sie die <unclear cert="medium" resp="#joint">Spitelherren</unclear>, auf angeregte vergleichung, in
<lb n="35"/><unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">langer</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">keiner</unclear> antwurt <unclear cert="low" resp="#joint">gewürdiget</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">derowegen</unclear>
<lb n="36"/>sie der vor <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wt</unclear>. <unclear cert="low" resp="#joint">abgeredten</unclear> <unclear cert="low" resp="#joint">verkomnuß</unclear> <unclear cert="low" resp="#joint">gentzlich</unclear>
<lb n="37"/>nit <unclear cert="medium" resp="#joint">mehr</unclear> gebunden <unclear cert="medium" resp="#joint">seye</unclear>, <unclear cert="medium" resp="#joint">sondern</unclear> <unclear cert="medium" resp="#joint">woellen</unclear> die-
<lb n="38"/>selbige <unclear cert="medium" resp="#joint">hiemit</unclear> <unclear cert="medium" resp="#joint">außtruckhenlich</unclear> <unclear cert="medium" resp="#joint">revociert</unclear> und
<pb facs="StadtASG_Missive_1962_7298.jpg" n="2"/>
<lb n="39"/>aufgehebt haben, inmaßen dann ihr consens (der
<lb n="40"/>aber <unclear cert="low" resp="#joint">ihnen</unclear> in der abhandlung außtrukhenlich vor=
<lb n="41"/>behalten worden) ohne das hierzue auf noch niemals
<lb n="42"/>ervolgt seye, ihnen ihr recht wegen deßhalb aufger
<lb n="43"/>loffnen unkostens in allweg <unclear cert="low" resp="#joint">vorbehaltende</unclear>, und
<lb n="44"/><unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">uns</unclear> darbey freündtlich ersuecht, wir
<lb n="45"/>wölten nit allein E. Vt. söches notificieren, und
<lb n="46"/>auch dieselbe von ihretwegen ansuechen, daß die
<lb n="47"/>obangeregt dem <unclear cert="low" resp="#joint">Straußen</unclear> <unclear cert="low" resp="#joint">überschikhte</unclear> <unclear cert="low" resp="#joint">copey</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">ihme</unclear> wider abgenomen, den schuelherren wider
<lb n="49"/>zuegestelt, und dann ihnen den schuelherren gegen
<lb n="50"/>und wider <orgName resp="#ner">statthamen und <unclear cert="low" resp="#joint">raht</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">Arbon</unclear></orgName>,
<lb n="51"/><unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">mehr</unclear>, und nach so langem vilfaltigem anhalten,
<lb n="52"/>zue gebüerendem rechten verholffen werden möge.
<lb n="53"/>Wölches ihr begeren, in ansehen diße sach jez so lange
<lb n="54"/>jar und tag angestanden, wir ihnen nit söllen noch
<lb n="55"/>können verweigeren.
<lb n="56"/>Gelangt und ist derowegen an E. Vt. unser freündt=
<lb n="57"/>nachbarlich <unclear cert="low" resp="#joint">gesinnen</unclear>, bitten und begeren, die
<lb n="58"/><unclear cert="low" resp="#joint">sihmalen</unclear> die <unclear cert="low" resp="#joint">darinn</unclear> <unclear cert="low" resp="#joint">be=</unclear> <unclear cert="low" resp="#joint">wöllen</unclear> <unclear cert="low" resp="#joint">mehrgenantem</unclear> <unclear cert="low" resp="#joint">Straußen</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">obangedeüte</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">griffne</unclear> <unclear cert="low" resp="#joint">abhandlung</unclear>, <unclear cert="low" resp="#joint">form=</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">überschikhte</unclear> <unclear cert="low" resp="#joint">copey</unclear>, <unclear cert="low" resp="#joint">wider</unclear> abnemen <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="60"/><unclear cert="low" resp="#joint">blicher</unclear> <unclear cert="low" resp="#joint">ordenlicher</unclear> <unclear cert="low" resp="#joint">weiß</unclear> und uns die <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">zeigeren</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">handen</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">keintwederm</unclear> <unclear cert="low" resp="#joint">theil</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">überschikhen</unclear>, und dann unseren schuelherren einen
<lb n="62"/><unclear cert="low" resp="#joint">gesazt</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">bekräfftiget</unclear> <unclear cert="low" resp="#joint">worden</unclear>, und <unclear cert="low" resp="#joint">richter</unclear> <unclear cert="low" resp="#joint">zeigen</unclear>, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">wölchem</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">gegentheil</unclear>, <unclear cert="low" resp="#joint">nam=</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">deßwegen</unclear> <unclear cert="low" resp="#joint">unbindig</unclear> <unclear cert="low" resp="#joint">ist</unclear>, <unclear cert="low" resp="#joint">lich</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">gemelte</unclear> <unclear cert="low" resp="#joint">statthamen</unclear> und <unclear cert="low" resp="#joint">raht</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">ihr</unclear>
<lb n="64"/>sach <unclear cert="low" resp="#joint">zueberehtigen</unclear> <unclear cert="low" resp="#joint">wüssen</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">wir</unclear> dann hiemit
<lb n="65"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">namen</unclear> und von wegen unsrer schuelherren E. Vt.
<lb n="66"/>als vogt und ambtman, von ihres tragenden ambts
<lb n="67"/>wegen, hiemit umb recht, und verschaffung rechts,
<lb n="68"/>in der besten form <unclear cert="low" resp="#joint">abermals</unclear> <unclear cert="low" resp="#joint">wöllen</unclear> <unclear cert="low" resp="#joint">angerüefft</unclear> <unclear cert="low" resp="#joint">haben</unclear>,
<lb n="69"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">genzlich</unclear> <unclear cert="low" resp="#joint">versehende</unclear>, die werde zeit und ort
<lb n="70"/>hiezue unverzüglich ernambsen, die <unclear cert="low" resp="#joint">citation</unclear> <unclear cert="low" resp="#joint">ordenlicher</unclear> <unclear cert="low" resp="#joint">weiß</unclear> <unclear cert="low" resp="#joint">verschaffen</unclear>, und
<lb n="71"/>also die schuelherren (damit sie <unclear cert="low" resp="#joint">weiter</unclear> <unclear cert="low" resp="#joint">rahts</unclear> <unclear cert="low" resp="#joint">zuepflegen</unclear> nit verurschet werden)
<lb n="72"/>am lauff des rechtens lenger nit aufhalten laßen, sonderen ihnen vil
<lb n="73"/>mehr, nach der sachen so <unclear cert="low" resp="#joint">langem</unclear> <unclear cert="low" resp="#joint">anstand</unclear>, <unclear cert="low" resp="#joint">endtlich</unclear> <unclear cert="low" resp="#joint">einmal</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">ihren</unclear>
<lb n="74"/><unclear cert="low" resp="#joint">verhelffen</unclear>. <unclear cert="low" resp="#joint">Wie</unclear> wir <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Vt</unclear>. wol vertrauwen und wüßen, daß sie
<lb n="75"/>das ihrige bißher gneigthen gethun haben.
<lb n="76"/>Und in erwartung, bey zeigern diß der darauf warten sol, einer schrift=
<lb n="77"/>lichen <unclear cert="low" resp="#joint">antwort</unclear>, <unclear cert="low" resp="#joint">bevölchen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">sambtlich</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">schirm</unclear> des Allmechtigen.
<lb n="78"/>Datum den. <origDate when="1615" resp="#ner">17. d. Augusti anno <unclear cert="low" resp="#joint">1615</unclear></origDate>.
<lb n="79"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">B</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">rht</unclear>.</orgName>
<lb n="80"/><unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">Edlen</unclear> <unclear cert="low" resp="#joint">Vesten</unclear> <unclear cert="low" resp="#joint">haubtman</unclear> <persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Bernhardt</unclear> <unclear cert="low" resp="#joint">Belman</unclear></persName>,
<lb n="81"/><unclear cert="low" resp="#joint">Bischoffl</unclear>. <unclear cert="low" resp="#joint">Cost</unclear>. <unclear cert="low" resp="#joint">raht</unclear> und obervogt zue
<lb n="82"/><placeName ref="stadtasg-places-5" cert="medium" resp="#ner">Arbon</placeName>, unserem sonders lieben herren, gueten
<lb n="83"/>freünd und nachbarn.
</p>
