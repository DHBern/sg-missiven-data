    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1553_5613.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">freüntlich</unclear> willig dienst und was wir
<lb n="2"/>liebs und guots <unclear cert="low" resp="#joint">vermoegen</unclear> <unclear cert="low" resp="#joint">zuovor</unclear> from fürsichtig
<lb n="3"/>ersam und wis insunders guot <unclear cert="low" resp="#joint">freünde</unclear> undt
<lb n="4"/><unclear cert="low" resp="#joint">getrüw</unclear> lieb <unclear cert="low" resp="#joint">nachburen</unclear>.
<lb n="5"/>Nachdem verschiner zeit eüers ambts angehoeriger
<lb n="6"/>underthan <persName resp="#ner">Jacob Lieb</persName> von <unclear cert="low" resp="#joint">Lechen</unclear> genant <unclear cert="low" resp="#joint">aines</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">handtwerchs</unclear> <unclear cert="low" resp="#joint">ain</unclear> schuochmacher <unclear cert="low" resp="#joint">alhie</unclear> in <unclear cert="low" resp="#joint">unser</unclear>
<lb n="8"/>statt gearbeitet, hat er sich in bemelter zeit mit
<lb n="9"/><unclear cert="low" resp="#joint">ainer</unclear> <unclear cert="low" resp="#joint">unser</unclear> burgerin <persName resp="#ner"><unclear cert="low" resp="#joint">Beatrix</unclear></persName>, <persName resp="#ner">Benedict
<lb n="10"/>Cuozelins</persName> (so glichwol ietz ußlendig) eelicher huß-
<lb n="11"/>frawen, dergestalt vergangen, das er ir in <unclear cert="low" resp="#joint">ueehren</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">khindt</unclear> <unclear cert="low" resp="#joint">erzelt</unclear>, welches in der <unclear cert="low" resp="#joint">hailig</unclear> <unclear cert="low" resp="#joint">tauff</unclear>
<lb n="13"/><persName resp="#ner"><unclear cert="low" resp="#joint">Johannes</unclear></persName>
<lb n="14"/>ainen namen empfangen. <unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">nun</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">sölhe</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">bei</unclear> <unclear cert="low" resp="#joint">uns</unclear> in und <unclear cert="low" resp="#joint">glich</unclear> <unclear cert="low" resp="#joint">fällen</unclear> derglich khindter
<lb n="17"/>(wie an im selbs billich) den vättern gemeinlich
<lb n="18"/>zue erziehen und zue erhalten, zue getreuen und ueber-
<lb n="19"/>geben werden, Allso haben wir uff <unclear cert="low" resp="#joint">pitlich</unclear> <unclear cert="low" resp="#joint">an</unclear>-
<lb n="20"/><unclear cert="low" resp="#joint">welches</unclear> <unclear cert="low" resp="#joint">eher</unclear> nit <unclear cert="low" resp="#joint">bescheh</unclear>-
<lb n="21"/><unclear cert="low" resp="#joint">en</unclear>, <unclear cert="low" resp="#joint">weil</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">lang</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">guoter</unclear> <unclear cert="low" resp="#joint">lüten</unclear> <unclear cert="low" resp="#joint">vferwechsen</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">lasen</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">ruofen</unclear> bemelter <persName resp="#ner"><unclear cert="low" resp="#joint">Beatrixen</unclear></persName> <unclear cert="low" resp="#joint">eelicher</unclear> <unclear cert="low" resp="#joint">freündtschafft</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">nit</unclear> underlassen wöllen, eüch sollich khindt zue ueber-
<lb n="26"/>schikhen. Mit freündtlichem <unclear cert="low" resp="#joint">sölhes</unclear> dem gedachten
<lb n="27"/><persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Lieben</unclear></persName>, oder aber <unclear cert="low" resp="#joint">sinen</unclear> <unclear cert="low" resp="#joint">befreündten</unclear> und ver-
<lb n="28"/><unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">ehrlichen</unclear> <unclear cert="low" resp="#joint">christlichen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">haben</unclear> zue <unclear cert="low" resp="#joint">erziehen</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">wandten</unclear> <unclear cert="low" resp="#joint">zuezeordnen</unclear>, in betrachtung das <unclear cert="low" resp="#joint">vilbe</unclear>-
<lb n="31"/>melte <persName resp="#ner"><unclear cert="low" resp="#joint">Beatrix</unclear></persName> <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">iren</unclear> zue der hailig drifaltig-
<lb n="32"/>khait leiblich geschwornen aidts erhalt, das <unclear cert="low" resp="#joint">eben</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">dißes</unclear> <unclear cert="low" resp="#joint">khindts</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">obsteende</unclear> <persName resp="#ner">Jacob Lieb</persName> reheter ainig
<lb n="34"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wahrer</unclear> <unclear cert="low" resp="#joint">vater</unclear> sei. Wolten wir <unclear cert="medium" resp="#joint">eüch</unclear>
<lb n="35"/>denen wir <unclear cert="medium" resp="#joint">außen</unclear> zue allen angenemen
<lb n="36"/><unclear cert="low" resp="#joint">Den</unclear> <unclear cert="low" resp="#joint">fromen</unclear> <unclear cert="low" resp="#joint">fürsichtigen</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">ersamen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wisen</unclear> <unclear cert="low" resp="#joint">landt</unclear><orgName ref="stadtasg-actors-506" cert="medium" role="recipient" resp="#ner">-
<lb n="38"/><unclear cert="low" resp="#joint">aman</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">rhaethen</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">Appen</unclear>-
<lb n="39"/><unclear cert="low" resp="#joint">zel</unclear></orgName> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">besunders</unclear> <unclear cert="low" resp="#joint">guoten</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">freünden</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachburen</unclear>.
<lb n="41"/>diensten wol <unclear cert="low" resp="#joint">geneigt</unclear>, nachbarlich nit verhalten
<lb n="42"/>und <unclear cert="low" resp="#joint">uns</unclear> beneben <unclear cert="low" resp="#joint">sametlich</unclear> <unclear cert="low" resp="#joint">göttlicher</unclear> <unclear cert="low" resp="#joint">bewarung</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">wolbevelchende</unclear>. Datum den <origDate when="1607-06-16" resp="#ner">16. junij anno 1607</origDate>.
<lb n="44"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und rhat d statt
<lb n="45"/><unclear cert="low" resp="#joint">St</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></orgName>.
<pb facs="StadtASG_Missive_1553_5614.jpg" n="2"/>
<lb n="46"/><unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">Landtammanns</unclear> brieff zuo <placeName resp="#ner">Lachen</placeName>
<lb n="47"/><origDate when="1607-06-16" resp="#ner">16 junij 1607</origDate>, trifft an <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">angehoerigen</unclear>
<lb n="48"/><persName resp="#ner">Jacob Lieb</persName>.
</p>
