<lb n="13"/><unclear cert="medium" resp="#joint">fürlesen</unclear> <unclear cert="medium" resp="#joint">lasen</unclear>, der <unclear cert="medium" resp="#joint">zeigt</unclear> aber an, er <unclear cert="medium" resp="#joint">wüße</unclear> sich <unclear cert="medium" resp="#joint">we</unclear>-
<lb n="14"/><unclear cert="medium" resp="#joint">nigst</unclear> nit <unclear cert="medium" resp="#joint">z'erindern</unclear>, <unclear cert="medium" resp="#joint">dz</unclear> ihm zu <placeName ref="stadtasg-places-46" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Winterthur</unclear></placeName> ein <unclear cert="medium" resp="#joint">der</unclear>-
