<lb n="4"/><unclear cert="low" resp="#joint">moegend</unclear>, <unclear cert="low" resp="#joint">zevor</unclear>, <unclear cert="low" resp="#joint">Fromme</unclear>, Fürsichtige, Ersame, und weise,
<lb n="5"/><unclear cert="medium" resp="#joint">besonders</unclear> <unclear cert="medium" resp="#joint">liebe</unclear>, <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="medium" resp="#joint">Fründ</unclear> und <unclear cert="medium" resp="#joint">nachbarn</unclear>.
<lb n="6"/>Was ihr diser tagen zu gunst üwers Burgers <unclear cert="medium" resp="#joint">Jere</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">miae</unclear> <unclear cert="medium" resp="#joint">Büechlej</unclear>, wegen einer forderung, so er an <unclear cert="medium" resp="#joint">unsern</unclear>
<lb n="8"/>Burger <persName resp="#ner">Tobias <unclear cert="low" resp="#joint">Lohern</unclear></persName>, <unclear cert="low" resp="#joint">Brieffebotten</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">pretendirn</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">vermeint</unclear>, <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">schrifftlich</unclear> an uns gelangen <unclear cert="medium" resp="#joint">lasen</unclear>, <unclear cert="medium" resp="#joint">dz</unclear>
<lb n="10"/>haben wir <unclear cert="medium" resp="#joint">durch</unclear> den <placeName ref="stadtasg-places-32" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Zürcher</unclear></placeName> <unclear cert="low" resp="#joint">botten</unclear> wol <unclear cert="medium" resp="#joint">empfangen</unclear>,
