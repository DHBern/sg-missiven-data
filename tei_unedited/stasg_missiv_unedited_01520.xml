<lb n="100"/><unclear cert="low" resp="#joint">wegen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Leonhart</unclear> <unclear cert="low" resp="#joint">Buchsings</unclear></persName> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">siner</unclear>
