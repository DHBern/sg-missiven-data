<lb n="39"/>nit mehr <unclear cert="low" resp="#joint">getriben</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">allein</unclear> gegen <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">theil</unclear>,
