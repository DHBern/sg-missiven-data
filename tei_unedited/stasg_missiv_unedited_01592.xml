    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1592_5761.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freundtlich</unclear> willig dienst, und was wir <unclear cert="low" resp="#joint">Ehrer</unclear>
<lb n="2"/>liebs und <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear> zuovor, <unclear cert="medium" resp="#joint">FromFuersichtig</unclear>, Ehr-
<lb n="3"/>sam <unclear cert="medium" resp="#joint">Weyß</unclear>, <unclear cert="low" resp="#joint">Insonnders</unclear> <unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">freundt</unclear>, und <unclear cert="low" resp="#joint">getreue</unclear> lieb <unclear cert="low" resp="#joint">Nachbarn</unclear>.
<lb n="4"/><unclear cert="medium" resp="#joint">Unß</unclear> hat unnsere <unclear cert="low" resp="#joint">landtmaennin</unclear>, <persName resp="#ner">Anna <unclear cert="low" resp="#joint">Vetterj</unclear></persName>, <unclear cert="low" resp="#joint">weyßern</unclear> diß
<lb n="5"/><unclear cert="medium" resp="#joint">brieffs</unclear> <unclear cert="medium" resp="#joint">zuerkennen</unclear> geben, wie das vor etlichen wuchen, der <unclear cert="low" resp="#joint">weyn</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">schenckh</unclear> <unclear cert="low" resp="#joint">eüwers</unclear> <unclear cert="low" resp="#joint">Spittals</unclear> <unclear cert="medium" resp="#joint">N</unclear>: <persName resp="#ner"><unclear cert="medium" resp="#joint">Spengler</unclear></persName>, <unclear cert="medium" resp="#joint">todes</unclear> <unclear cert="medium" resp="#joint">abgestorben</unclear> sige,
<lb n="7"/>Zuo dessen verlassenschafft, sy nebend <unclear cert="medium" resp="#joint">andern</unclear>, auch ein erb sie,
<lb n="8"/>nit weniger alß <unclear cert="medium" resp="#joint">ihr</unclear> der <persName resp="#ner">Anna <unclear cert="medium" resp="#joint">Vetterin</unclear></persName>, <unclear cert="low" resp="#joint">schwoester</unclear>, <persName resp="#ner"><unclear cert="medium" resp="#joint">Dorothea</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">Schluenpffin</unclear></persName>, <unclear cert="low" resp="#joint">eüwre</unclear> buergerin; <unclear cert="low" resp="#joint">diewyl</unclear> er, in <unclear cert="medium" resp="#joint">naeherem</unclear> grad, <unclear cert="medium" resp="#joint">lybß</unclear>-
<lb n="10"/>erben, hinder <unclear cert="low" resp="#joint">ihme</unclear> nit verlassen habe; <unclear cert="low" resp="#joint">Diewyl</unclear> aber etwas
<lb n="11"/><unclear cert="medium" resp="#joint">bedenckhens</unclear> entstanden, das sy <unclear cert="medium" resp="#joint">ihm</unclear> <unclear cert="medium" resp="#joint">ehestandt</unclear> nit solte <unclear cert="medium" resp="#joint">geboren</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">syn</unclear>; habe sy <unclear cert="low" resp="#joint">ihre</unclear> liebe <unclear cert="low" resp="#joint">basen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Margrethen</unclear> <unclear cert="medium" resp="#joint">Vetterin</unclear></persName>, (die auch
<lb n="13"/><unclear cert="low" resp="#joint">gegenwertig</unclear> <unclear cert="low" resp="#joint">ware</unclear>) darumb fuer unß <unclear cert="medium" resp="#joint">gestelt</unclear>; <unclear cert="low" resp="#joint">dero</unclear> wol in
<lb n="14"/><unclear cert="medium" resp="#joint">wissen</unclear>, daß ihr lieber vatter <unclear cert="low" resp="#joint">s</unclear>: <persName resp="#ner">Herman Vetter</persName>, <unclear cert="medium" resp="#joint">ihrre</unclear> auch
<lb n="15"/>lieber <unclear cert="medium" resp="#joint">muoter</unclear> <unclear cert="low" resp="#joint">s</unclear>: <persName resp="#ner"><unclear cert="low" resp="#joint">Vibraten</unclear> <unclear cert="low" resp="#joint">Spenglerin</unclear></persName>, die ehe versprochen
<lb n="16"/>habe, und aber <unclear cert="low" resp="#joint">etwan</unclear> <unclear cert="low" resp="#joint">wyter</unclear> gestorben, ehe das er selbige ver-
<lb n="17"/>sprochne ehe, mit <unclear cert="low" resp="#joint">offentlichem</unclear> <unclear cert="low" resp="#joint">kilchgang</unclear> habe <unclear cert="low" resp="#joint">bestaettigen</unclear> lassen
<lb n="18"/><unclear cert="medium" resp="#joint">koennen</unclear>; Nichtsdestoweniger habe er in synem <unclear cert="medium" resp="#joint">todbeth</unclear> begert,
<lb n="19"/>daß sy <unclear cert="medium" resp="#joint">ordenlicher</unclear> weyß <unclear cert="low" resp="#joint">moechten</unclear> zuo <unclear cert="low" resp="#joint">ehleüthen</unclear> <unclear cert="medium" resp="#joint">zesamen</unclear> geben
<lb n="20"/><unclear cert="medium" resp="#joint">werden</unclear>, das dan auch beschehen, sovil rechte ordnung habe er-
<lb n="21"/><unclear cert="low" resp="#joint">lyden</unclear> <unclear cert="low" resp="#joint">moegen</unclear>, <unclear cert="low" resp="#joint">diewil</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">die</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Anna</unclear></persName> <unclear cert="low" resp="#joint">iez</unclear> <unclear cert="low" resp="#joint">3</unclear> <unclear cert="low" resp="#joint">jar</unclear> <unclear cert="low" resp="#joint">getragen</unclear> <unclear cert="low" resp="#joint">hab</unclear>. <unclear cert="low" resp="#joint">Darumben</unclear> <unclear cert="low" resp="#joint">vermeint</unclear> sy, das sy auch <unclear cert="low" resp="#joint">fuer</unclear> ein
<lb n="22"/><unclear cert="low" resp="#joint">ehekhindt</unclear> solte gehalten und geachtet, und hiemit <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">ein</unclear> erben,
<lb n="23"/>neben <unclear cert="low" resp="#joint">andern</unclear>, erkendt werden; Wan dan ihr dise sach, disen tagen
<lb n="24"/><unclear cert="low" resp="#joint">zuoerfahren</unclear> <unclear cert="low" resp="#joint">gsinnet</unclear>, Sie ihr <unclear cert="low" resp="#joint">demuetig</unclear> pitt an unß, das wir
<lb n="25"/><unclear cert="low" resp="#joint">ihro</unclear> mit unser intercession an eüch <unclear cert="low" resp="#joint">fuerdersam</unclear> syn <unclear cert="low" resp="#joint">woelten</unclear>;
<lb n="26"/>Wan wir unß dan solches <unclear cert="low" resp="#joint">zethuon</unclear> schuldig <unclear cert="medium" resp="#joint">erkendt</unclear>, So ist
<lb n="27"/><unclear cert="low" resp="#joint">hiemit</unclear> unnser <unclear cert="low" resp="#joint">freundtlichen</unclear> bitten an <unclear cert="medium" resp="#joint">eüch</unclear>, ir <unclear cert="low" resp="#joint">woellen</unclear> offt-
<lb n="28"/>gedachte <persName resp="#ner"><unclear cert="medium" resp="#joint">Annam</unclear> <unclear cert="low" resp="#joint">Vettern</unclear></persName> <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">befolhen</unclear> syn lassen, und <unclear cert="medium" resp="#joint">uff</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="low" resp="#joint">khundschafft</unclear> und sag, so ermelte <unclear cert="medium" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">baß</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Margreth</unclear> <unclear cert="low" resp="#joint">Vettern</unclear></persName>
<lb n="30"/>selbsten in <unclear cert="low" resp="#joint">wyblicher</unclear> form, vor unß gethon, wie oben ge-
<lb n="31"/>meldet, <unclear cert="low" resp="#joint">eüch</unclear> <unclear cert="low" resp="#joint">gebuerender</unclear> <unclear cert="low" resp="#joint">maassen</unclear>, <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">freundtlich</unclear> gegen ihro
<pb facs="StadtASG_Missive_1592_5762.jpg" n="2"/>
<lb n="32"/><unclear cert="medium" resp="#joint">erzeigen</unclear>, das sy diser <unclear cert="low" resp="#joint">unserer</unclear> <unclear cert="low" resp="#joint">fuegschrifft</unclear> <unclear cert="low" resp="#joint">fruchtbarlichs</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">gnossen</unclear> <unclear cert="low" resp="#joint">zuehaben</unclear> <unclear cert="low" resp="#joint">spueren</unclear>, und dasselbige <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">rhuemen</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">moege</unclear>. Das begeren wir umb <unclear cert="medium" resp="#joint">euch</unclear> und die <unclear cert="low" resp="#joint">euweren</unclear>
<lb n="35"/>in dergleichen und <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">freundtlich</unclear> zuverdienen. Und
<lb n="36"/><unclear cert="low" resp="#joint">thund</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">sambtlich</unclear> <unclear cert="low" resp="#joint">Goetlicher</unclear> protection anbefelchen
<lb n="37"/><unclear cert="medium" resp="#joint">daby</unclear> den. <origDate when="1608" resp="#ner"><unclear cert="low" resp="#joint">21</unclear>. <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">Januarii</unclear> <unclear cert="low" resp="#joint">Ao</unclear>. 1608</origDate>.
<lb n="38"/><orgName ref="stadtasg-actors-506" cert="medium" role="issuer" resp="#ner">Lanndtaman unnd <unclear cert="medium" resp="#joint">Raath</unclear>
<lb n="39"/><unclear cert="medium" resp="#joint">zue</unclear> Appenzell</orgName>. etc.
<pb facs="StadtASG_Missive_1592_5763.jpg" n="3"/>
<pb facs="StadtASG_Missive_1592_5764.jpg" n="4"/>
<lb n="40"/><unclear cert="low" resp="#joint">Denen</unclear> frommen fuersichtigen, ehr-
<lb n="41"/><unclear cert="medium" resp="#joint">samen</unclear> <unclear cert="medium" resp="#joint">weisen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="42"/>und Rath der Statt Sant Gallen</orgName>,
<lb n="43"/><unclear cert="low" resp="#joint">unseren</unclear> innsonders gueten fründen,
<lb n="44"/>unnd <unclear cert="medium" resp="#joint">getreüwen</unclear> lieben <unclear cert="medium" resp="#joint">nachbaren</unclear>.
</p>
