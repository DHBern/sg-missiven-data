    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_3113_12265.jpg" n="1"/>
<lb n="1"/>Unser freundtlich willige dienst, zuvor, <unclear cert="low" resp="#joint">Fromm</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">Ehrsam</unclear> und <unclear cert="low" resp="#joint">Weyse</unclear>, <unclear cert="low" resp="#joint">insonders</unclear> <unclear cert="low" resp="#joint">gute</unclear> <unclear cert="low" resp="#joint">Freundt</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">getreuwe</unclear> liebe Eidt- und Pundts-
<lb n="4"/>gnossen.
<lb n="5"/>Es hat unß unser lieber getreuwer burger
<lb n="6"/>und Rector unsers Gymnasij allhie
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">H</unclear>: <unclear cert="low" resp="#joint">Bernhardt</unclear> <unclear cert="low" resp="#joint">Schopffer</unclear></persName> gehorsamlich
<lb n="8"/>zuoerkennen gegeben. Waß-
<lb n="9"/>massen ein knab auß euwerem Thal,
<lb n="10"/>nahmens <persName resp="#ner">Hannß Zuen</persName> vor disem ihme
<lb n="11"/>in die kost und Disciplin, umb ein
<lb n="12"/>gebürlich tisch- und lehrgelt übergeben
<lb n="13"/>und <unclear cert="low" resp="#joint">anvertrauwet</unclear> <unclear cert="low" resp="#joint">worden</unclear>, mit
<lb n="14"/><unclear cert="low" resp="#joint">+</unclear> <unclear cert="low" resp="#joint">H</unclear>: <unclear cert="low" resp="#joint">Rectorj</unclear> <unclear cert="low" resp="#joint">versprechen</unclear>, daß ihme nicht allein
<lb n="15"/>daß <unclear cert="low" resp="#joint">erstangeregte</unclear> <unclear cert="low" resp="#joint">kostgelt</unclear>, <unclear cert="low" resp="#joint">sonder</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">knaben</unclear>, <unclear cert="low" resp="#joint">zu</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">deßselben</unclear> <unclear cert="low" resp="#joint">nothurfften</unclear> <unclear cert="low" resp="#joint">werde</unclear> <unclear cert="low" resp="#joint">außlegen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">Rectori</unclear>, <unclear cert="low" resp="#joint">daßselbige</unclear> <unclear cert="low" resp="#joint">jaerlich</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">fehlbar</unclear> mit <unclear cert="low" resp="#joint">danck</unclear> <unclear cert="low" resp="#joint">erstattet</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">solle</unclear> <unclear cert="low" resp="#joint">außbezahlet</unclear> werden.
<lb n="21"/><unclear cert="low" resp="#joint">Wann</unclear> aber <unclear cert="low" resp="#joint">bißdahin</unclear> <unclear cert="low" resp="#joint">eüwerer</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">liebs</unclear>. <unclear cert="low" resp="#joint">gedachten</unclear> <unclear cert="low" resp="#joint">H</unclear>. <unclear cert="low" resp="#joint">Zogt</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">etlich</unclear> <unclear cert="low" resp="#joint">mahlen</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">vermelts</unclear> <unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">tisch</unclear>- <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">lehrjungs</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">verordneten</unclear> Vogt und <unclear cert="low" resp="#joint">vormündern</unclear>
<lb n="25"/><persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear> <unclear cert="low" resp="#joint">Jußli</unclear></persName>, so <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">freundt</unclear>- <unclear cert="low" resp="#joint">alß</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">ernstlich</unclear> <unclear cert="low" resp="#joint">zugeschriben</unclear>, und <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">disen</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">eigewißnen</unclear> <unclear cert="low" resp="#joint">Curaten</unclear>
<lb n="28"/>nicht allein, umb die noch <unclear cert="low" resp="#joint">restierende</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">bezahlung</unclear>, so sich <unclear cert="low" resp="#joint">vermög</unclear> <unclear cert="low" resp="#joint">ußzugs</unclear>
<pb facs="StadtASG_Missive_3113_12266.jpg" n="2"/>
<lb n="30"/>uff die fues. belauffen, sonder
<lb n="31"/>auch umb <unclear cert="low" resp="#joint">bezahlung</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">mahl</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">angehalten</unclear>, so seÿe aber biß dato
<lb n="33"/>wider sein verhoffen kaine ervolget
<lb n="34"/>dahero er dann <unclear cert="low" resp="#joint">notttranglich</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="35"/><unclear cert="low" resp="#joint">ursacht</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">aig(en)sinigen</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">gwaltsbotten</unclear> <unclear cert="low" resp="#joint">abzuordnen</unclear>,
<lb n="37"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">bevelch</unclear> <unclear cert="low" resp="#joint">angeregte</unclear> <unclear cert="low" resp="#joint">schuldt</unclear>, guetlich oder recht-
<lb n="38"/>lich <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">bÿ</unclear> <unclear cert="low" resp="#joint">ihnen</unclear> <unclear cert="low" resp="#joint">vogt</unclear> <unclear cert="low" resp="#joint">dieneren</unclear> <unclear cert="low" resp="#joint">berg</unclear>
<lb n="39"/>und nicht <unclear cert="low" resp="#joint">zuweichen</unclear> <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">derselben</unclear>
<lb n="40"/>zu seinem <unclear cert="low" resp="#joint">begnuegen</unclear> <unclear cert="low" resp="#joint">ußgewüscht</unclear>
<lb n="41"/>und bezalt worden <unclear cert="low" resp="#joint">seÿe</unclear>.
<lb n="42"/><unclear cert="low" resp="#joint">darzue</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">Damit</unclear> <unclear cert="low" resp="#joint">er</unclear> aber desto eher disers seins
<lb n="44"/>erlangenn möge, alß
<lb n="45"/>seÿe an uß sein gehorsamlich ersuchen ud
<lb n="46"/>pitt, wir wolten ihme hierinnen
<lb n="47"/>mit unserer intercession und fürschrift
<lb n="48"/>an euch, deren er zu <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">schleüniger</unclear>
<lb n="49"/>erlangung seines <unclear cert="low" resp="#joint">ußstandts</unclear> <unclear cert="low" resp="#joint">frucht</unclear>-
<lb n="50"/><unclear cert="low" resp="#joint">barlich</unclear> <unclear cert="low" resp="#joint">zugeniessen</unclear> <unclear cert="low" resp="#joint">verhoffe</unclear>, <unclear cert="low" resp="#joint">behülff</unclear>-
<lb n="51"/><unclear cert="low" resp="#joint">sen</unclear> <unclear cert="low" resp="#joint">erscheinen</unclear>.
<lb n="52"/><unclear cert="low" resp="#joint">Wan</unclear> wir dann diß sei bgeren
<lb n="53"/>nicht für unbillich erachten, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">sonder</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">die</unclear> unsern zu dem ihrig(en) zubrhelffen
<lb n="55"/>uns so genaigt als schuldig erachten.
<lb n="56"/>alß haben wir <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">aines</unclear> <unclear cert="low" resp="#joint">sovil</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">lieber</unclear> <unclear cert="low" resp="#joint">willfahren</unclear> <unclear cert="low" resp="#joint">wollen</unclear>,
<lb n="58"/><unclear cert="low" resp="#joint">Gelangt</unclear> <unclear cert="low" resp="#joint">derohalben</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">uch</unclear>
<pb facs="StadtASG_Missive_3113_12267.jpg" n="3"/>
<lb n="59"/><unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">getrüwen</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">Eidt</unclear>- und <unclear cert="low" resp="#joint">Pundtsgnossen</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear> <unclear cert="low" resp="#joint">bitt</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">pundtsgnössisch</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">ersuochen</unclear>, <unclear cert="low" resp="#joint">Ihr</unclear> wellen dero burgeren
<lb n="62"/><persName resp="#ner">Jacob Züblin</persName>, alß deß knaben verordenten
<lb n="63"/>oberkeitt halber mit allem ernst
<lb n="64"/>dahin halten und <unclear cert="low" resp="#joint">vermoegen</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">allein</unclear>
<lb n="66"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">berüehrte</unclear>, <unclear cert="low" resp="#joint">alß</unclear> deß <unclear cert="low" resp="#joint">nechsten</unclear> <unclear cert="low" resp="#joint">ellten</unclear> <unclear cert="low" resp="#joint">beßeren</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">überfelliges</unclear> <unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">allso</unclear> <unclear cert="low" resp="#joint">weite</unclear> <unclear cert="low" resp="#joint">inhanden</unclear>
<lb n="68"/>deß sellig, die ob specificierte summa
<lb n="69"/>samt allem <unclear cert="low" resp="#joint">daruober</unclear> <unclear cert="low" resp="#joint">uffgeloffen</unclear> <unclear cert="low" resp="#joint">costen</unclear>,
<lb n="70"/><unclear cert="low" resp="#joint">lohn</unclear> und ußgaaben ohne weiteren uffhalt
<lb n="71"/>entrichte und bezahle, sondern auch
<lb n="72"/>die anordnung und verfuegung thuon
<lb n="73"/>solle, dz <unclear cert="low" resp="#joint">mehrberüehrter</unclear> <unclear cert="low" resp="#joint">sellig</unclear> <unclear cert="low" resp="#joint">vogtsknab</unclear>
<lb n="74"/><unclear cert="low" resp="#joint">angetzündt</unclear> <unclear cert="low" resp="#joint">hiedannen</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">seinem</unclear>
<lb n="75"/><unclear cert="low" resp="#joint">Praeceptori</unclear> <unclear cert="low" resp="#joint">abgehollt</unclear> und <unclear cert="low" resp="#joint">beschwerdt</unclear>
<lb n="76"/><unclear cert="low" resp="#joint">abgeholet</unclear> werde. Und <unclear cert="low" resp="#joint">solches</unclear>
<lb n="77"/><unclear cert="low" resp="#joint">koennen</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">Ewer</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">erwiß</unclear>
<lb n="78"/>wir <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">Euch</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">daß</unclear> wohl ver-
<lb n="79"/><unclear cert="low" resp="#joint">trawen</unclear>, <unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="low" resp="#joint">gütth</unclear> <unclear cert="low" resp="#joint">geneigt</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">werden</unclear>.
<lb n="80"/><unclear cert="low" resp="#joint">Hieran</unclear> <unclear cert="low" resp="#joint">beschecht</unclear> die <unclear cert="low" resp="#joint">billichkeit</unclear>
<lb n="81"/>und sindt wir es umb <unclear cert="low" resp="#joint">ewer</unclear> <unclear cert="low" resp="#joint">Eych</unclear> in
<lb n="82"/>gleichen und andern <unclear cert="low" resp="#joint">begebenheiten</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear>
<lb n="83"/><unclear cert="low" resp="#joint">eid</unclear>- und <unclear cert="low" resp="#joint">pundtsgnössisch</unclear> <unclear cert="low" resp="#joint">zueerwidern</unclear>
<lb n="84"/><unclear cert="low" resp="#joint">geneigtwillig</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">anerbötig</unclear>. <unclear cert="low" resp="#joint">Uns</unclear>
<lb n="85"/><unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">samtlich</unclear> <unclear cert="low" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">trüwem</unclear> <unclear cert="low" resp="#joint">schirm</unclear>
<lb n="86"/><unclear cert="low" resp="#joint">wohlbevehlende</unclear>. Datum
<lb n="87"/><origDate when="1635" resp="#ner">den 18ten. Septembris <unclear cert="low" resp="#joint">Ao</unclear> <unclear cert="low" resp="#joint">1635</unclear>.</origDate>
<lb n="88"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und Raht
<lb n="89"/>der Statt St. Gallen.</orgName>
<lb n="90"/><unclear cert="low" resp="#joint">Den</unclear> <unclear cert="low" resp="#joint">Frommen</unclear> <unclear cert="low" resp="#joint">Ersammen</unclear> <unclear cert="low" resp="#joint">Wysen</unclear>, <unclear cert="low" resp="#joint">Amman</unclear>
<lb n="91"/>und Rhat zuo Underwalden C.
<lb n="92"/>unsern besonders gueten Fründen
<lb n="93"/>und getrüwen lieben <unclear cert="low" resp="#joint">Eid</unclear>- <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Pundts</unclear>-
<lb n="94"/><unclear cert="low" resp="#joint">gnoßen</unclear>.
<pb facs="StadtASG_Missive_3113_12268.jpg" n="4"/>
<lb n="95"/><unclear cert="medium" resp="#joint">An</unclear> <unclear cert="medium" resp="#joint">Aman</unclear> und <unclear cert="medium" resp="#joint">Gricht</unclear> zuo <placeName resp="#ner"><unclear cert="low" resp="#joint">Undwatz</unclear></placeName>,
<lb n="96"/><origDate when="1635" resp="#ner">15. <unclear cert="medium" resp="#joint">7bris</unclear> <unclear cert="medium" resp="#joint">1635</unclear></origDate>. <unclear cert="medium" resp="#joint">wegen</unclear> H. <unclear cert="low" resp="#joint">Rector</unclear>
<lb n="97"/><persName resp="#ner"><unclear cert="low" resp="#joint">Schoepfers</unclear></persName> <unclear cert="low" resp="#joint">loßgangne</unclear> <unclear cert="low" resp="#joint">weidqualen</unclear>
</p>
