<pb facs="StadtASG_Missive_3281_13017.jpg" n="3"/>
<pb facs="StadtASG_Missive_3281_13018.jpg" n="4"/>
<lb n="25"/>Denen <unclear cert="low" resp="#joint">HochWoledlen</unclear>, Edlen, <unclear cert="low" resp="#joint">Stren</unclear>-
<lb n="26"/><unclear cert="low" resp="#joint">gen</unclear>, Vesten, und Ehrnvesten Herrn
<lb n="27"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister undt Rahdt der Freystat
<lb n="28"/>St. Gallen</orgName>, in der <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydttgenohßschafft</unclear></orgName>
<lb n="29"/>meinen besonders lieben herren unndt
<lb n="30"/><unclear cert="low" resp="#joint">freundt</unclear>.
<lb n="31"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
