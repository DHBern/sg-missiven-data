<p>
<pb facs="StadtASG_Missive_3281_13015.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Mein</unclear> <unclear cert="medium" resp="#joint">freuntlich</unclear> <unclear cert="medium" resp="#joint">grueß</unclear> <unclear cert="medium" resp="#joint">undt</unclear> <unclear cert="medium" resp="#joint">dinste</unclear> zuvor, <unclear cert="medium" resp="#joint">HochwolEedle</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">Eedle</unclear>, <unclear cert="medium" resp="#joint">Gestränge</unclear>, Veste, <unclear cert="medium" resp="#joint">Eerenveste</unclear> <unclear cert="medium" resp="#joint">besonders</unclear> liebe herrn
<lb n="3"/>und <unclear cert="low" resp="#joint">freundte</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">Nach</unclear> <unclear cert="low" resp="#joint">deme</unclear> durch <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">kriegßweeßen</unclear> mein Arme <unclear cert="medium" resp="#joint">herrschafft</unclear> <unclear cert="medium" resp="#joint">landte</unclear>
<lb n="5"/>und <unclear cert="medium" resp="#joint">leuhte</unclear> <unclear cert="medium" resp="#joint">seid</unclear> <unclear cert="medium" resp="#joint">gantz</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">grundt</unclear> gerichtet, <unclear cert="medium" resp="#joint">Allßo</unclear> <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">weeder</unclear>
<lb n="6"/>mir noch meinen armen <unclear cert="low" resp="#joint">underthanen</unclear> möglich ist <unclear cert="medium" resp="#joint">ohnverhören</unclear>, die
<lb n="7"/><unclear cert="medium" resp="#joint">kirchen</unclear> <unclear cert="medium" resp="#joint">diener</unclear> <unclear cert="medium" resp="#joint">lenger</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">underhalten</unclear> und <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">versorgen</unclear>,
<lb n="8"/>Und aber die <unclear cert="medium" resp="#joint">herrn</unclear> sich <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">mitleidentlich</unclear> haben angenomen,
<lb n="9"/>und <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">ansehnlichen</unclear> <unclear cert="low" resp="#joint">steueren</unclear> begabet, Habe ich er-
<lb n="10"/><unclear cert="medium" resp="#joint">kandtelichen</unclear> <unclear cert="medium" resp="#joint">vernommen</unclear>, <unclear cert="medium" resp="#joint">Thue</unclear> <unclear cert="medium" resp="#joint">derowegen</unclear> <unclear cert="medium" resp="#joint">mich</unclear> zum <unclear cert="low" resp="#joint">hochfleiß</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">igsten</unclear> <unclear cert="low" resp="#joint">bedancken</unclear>, Und <unclear cert="low" resp="#joint">wolte</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">hertzen</unclear> <unclear cert="low" resp="#joint">wüntschen</unclear>
<lb n="12"/>in meinen <unclear cert="medium" resp="#joint">kräfften</unclear> sein <unclear cert="medium" resp="#joint">möchte</unclear> den selb. <unclear cert="medium" resp="#joint">hinwider</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">dienen</unclear>
<lb n="13"/>oder <unclear cert="medium" resp="#joint">angeneme</unclear> <unclear cert="medium" resp="#joint">freundtschafft</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">bezeigen</unclear>, <unclear cert="medium" resp="#joint">Wolte</unclear> ich <unclear cert="medium" resp="#joint">an</unclear>
<lb n="14"/>mir <unclear cert="medium" resp="#joint">keinen</unclear> <unclear cert="medium" resp="#joint">mangell</unclear> <unclear cert="medium" resp="#joint">erscheinen</unclear> <unclear cert="medium" resp="#joint">laßen</unclear>, Wie ich dann <unclear cert="low" resp="#joint">darzue</unclear>
<lb n="15"/>mich die tage <unclear cert="medium" resp="#joint">meineß</unclear> <unclear cert="medium" resp="#joint">leebenß</unclear> <unclear cert="medium" resp="#joint">befleißigen</unclear> will, <unclear cert="medium" resp="#joint">Undt</unclear>
<lb n="16"/>waß ich und meine kirchen <unclear cert="low" resp="#joint">diener</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">verdienen</unclear> <unclear cert="low" resp="#joint">konnen</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Wolle</unclear> der <unclear cert="low" resp="#joint">Allmechtige</unclear> <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">reichlich</unclear> <unclear cert="low" resp="#joint">belohnen</unclear>, <unclear cert="low" resp="#joint">Deß</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">gnade</unclear> <unclear cert="low" resp="#joint">die</unclear> herrn <unclear cert="low" resp="#joint">Ich</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">schutz</unclear> und <unclear cert="low" resp="#joint">wollfahrt</unclear> <unclear cert="low" resp="#joint">befehle</unclear>.
<lb n="19"/><unclear cert="low" resp="#joint">Datum</unclear> <origPlace resp="#ner"><unclear cert="low" resp="#joint">Seefewßen</unclear></origPlace> <origDate when="1638-03-23" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">13/23</unclear> <unclear cert="low" resp="#joint">Martij</unclear> <unclear cert="low" resp="#joint">a°</unclear> <unclear cert="low" resp="#joint">1638</unclear></origDate>:
<lb n="20"/><unclear cert="low" resp="#joint">Der</unclear> <unclear cert="low" resp="#joint">herrn</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">Dinstwilliger</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">wohl</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">Affectionirter</unclear> freundt
<lb n="23"/><unclear cert="medium" resp="#joint">Wilhelm</unclear> <unclear cert="medium" resp="#joint">freihr</unclear> <unclear cert="medium" resp="#joint">zu</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">Seens</unclear>.
