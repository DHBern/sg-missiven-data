    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_932_2739.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="medium" resp="#joint">freundtlich</unclear> willig diennst
<lb n="2"/><unclear cert="medium" resp="#joint">zuvor</unclear>. Ersamen unnd weisen, <unclear cert="medium" resp="#joint">besunder</unclear>
<lb n="3"/>lieben unnd <unclear cert="low" resp="#joint">guten</unclear> <unclear cert="low" resp="#joint">freund</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="4"/>schreiben, betreffend <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">arrest</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">unn</unclear>-
<lb n="5"/>ser burger, doctor <persName resp="#ner">Abraham <unclear cert="medium" resp="#joint">Muergel</unclear></persName>,
<lb n="6"/>unnd sein schwager <persName resp="#ner"><unclear cert="medium" resp="#joint">Bernhart</unclear> <unclear cert="medium" resp="#joint">Haentzler</unclear></persName>,
<lb n="7"/>burger <unclear cert="medium" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-77" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Ravenspurg</unclear></placeName>, inn <unclear cert="medium" resp="#joint">weilundt</unclear>
<lb n="8"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Leinhart</unclear> <unclear cert="medium" resp="#joint">Haentzlers</unclear></persName> <unclear cert="medium" resp="#joint">seeligen</unclear> <unclear cert="medium" resp="#joint">verlaßner</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">dochter</unclear> <unclear cert="medium" resp="#joint">haab</unclear> unnd <unclear cert="medium" resp="#joint">guetere</unclear>, <unclear cert="medium" resp="#joint">gelegt</unclear> haben soll <unclear cert="low" resp="#joint">etc</unclear>.
<lb n="10"/>haben wir alles <unclear cert="low" resp="#joint">innhallts</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">lennge</unclear>, <unclear cert="low" resp="#joint">zu</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">jrem</unclear> <unclear cert="low" resp="#joint">anbegeren</unclear>, empfanngen. Und
<lb n="12"/><unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">darauff</unclear> <unclear cert="low" resp="#joint">freundtlich</unclear> und
<lb n="13"/>nachbarlich <unclear cert="medium" resp="#joint">zuerkennen</unclear>, <unclear cert="medium" resp="#joint">das</unclear> wir solches
<lb n="14"/><unclear cert="medium" resp="#joint">bemeltem</unclear> unnserm burger doctor
<lb n="15"/>Abraham <unclear cert="medium" resp="#joint">Muergel</unclear> <unclear cert="medium" resp="#joint">fuergehallten</unclear>. <unclear cert="medium" resp="#joint">Der</unclear>
<lb n="16"/>hat unns <unclear cert="medium" resp="#joint">darauff</unclear> disen bericht <unclear cert="medium" resp="#joint">gethon</unclear>,
<lb n="17"/>das er <unclear cert="medium" resp="#joint">dhein</unclear> <unclear cert="medium" resp="#joint">srunden</unclear> <unclear cert="medium" resp="#joint">arrest</unclear> angelegt,
<lb n="18"/><unclear cert="medium" resp="#joint">gleichwol</unclear>, nach dem er, unnd sein <unclear cert="low" resp="#joint">schwager</unclear>,
<lb n="19"/><unclear cert="low" resp="#joint">sich</unclear>, weilund <unclear cert="medium" resp="#joint">jres</unclear> schwagers unnd <unclear cert="medium" resp="#joint">vet</unclear>-
<lb n="20"/>ters <unclear cert="low" resp="#joint">Leinhart</unclear> <unclear cert="low" resp="#joint">Haentzlers</unclear> <unclear cert="low" resp="#joint">seeligen</unclear> <unclear cert="low" resp="#joint">dochter</unclear>,
<lb n="21"/>alls <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">naechsten</unclear> <unclear cert="low" resp="#joint">vatter</unclear> <unclear cert="low" resp="#joint">maegen</unclear>, <unclear cert="low" resp="#joint">ange</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">nomen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">dieselbig</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">rath</unclear>, <unclear cert="low" resp="#joint">vor</unclear>-
<lb n="23"/><unclear cert="low" resp="#joint">wissen</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">zuethun</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">dochter</unclear> <unclear cert="low" resp="#joint">muter</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">maegen</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">verwanndten</unclear>, <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">zwayen</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">vormuendern</unclear> <unclear cert="low" resp="#joint">versehen</unclear>, <unclear cert="low" resp="#joint">hette</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">verhofft</unclear>,
<lb n="26"/><unclear cert="low" resp="#joint">man</unclear> <unclear cert="low" resp="#joint">sollte</unclear> <unclear cert="low" resp="#joint">dieselb</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">allßo</unclear> <unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">fremd</unclear>-
<pb facs="StadtASG_Missive_932_2740.jpg" n="2"/>
<lb n="27"/>sonnder sy, bey irer verwalltung, bis
<lb n="28"/>sy doch der dochter haab unnd guet so mehrer-
<lb n="29"/>thails, unnder dem <unclear cert="low" resp="#joint">rathaus</unclear> angelegt,
<lb n="30"/>wider zu hannden pringen <unclear cert="low" resp="#joint">moegen</unclear>, gelassen
<lb n="31"/>haben. <unclear cert="low" resp="#joint">Dannenheer</unclear> er unnd sein
<lb n="32"/>schwager, <unclear cert="medium" resp="#joint">denn</unclear> ersten <unclear cert="low" resp="#joint">wegken</unclear> <unclear cert="low" resp="#joint">aufferlegt</unclear>,
<lb n="33"/><unclear cert="low" resp="#joint">nochzurzeit</unclear>, <unclear cert="low" resp="#joint">one</unclear> ir vorwissen, nichtzit von
<lb n="34"/>hannden zelassen, Dieweil es
<lb n="35"/><unclear cert="low" resp="#joint">sich</unclear> die sachen dermassen veranndert,
<lb n="36"/>so <unclear cert="low" resp="#joint">khünde</unclear> er nit vil darwider <unclear cert="medium" resp="#joint">thuen</unclear>, aber
<lb n="37"/>doch, auff E. E. W. schreiben, sich <unclear cert="low" resp="#joint">iezo</unclear> <unclear cert="low" resp="#joint">alß</unclear>
<lb n="38"/>balld, ehe unnd er sich zuvor, mit seinem
<lb n="39"/>schwager <persName resp="#ner">Bernhart <unclear cert="low" resp="#joint">Hainzler</unclear></persName> <unclear cert="low" resp="#joint">unnderredt</unclear>,
<lb n="40"/>nit enndtlich seines gemuets <unclear cert="low" resp="#joint">erclairen</unclear>,
<lb n="41"/>aber <unclear cert="low" resp="#joint">ungevärlich</unclear> inn 14 tagen oder
<lb n="42"/>dreyen wuchen auffs <unclear cert="low" resp="#joint">lenngst</unclear>, <unclear cert="medium" resp="#joint">woelle</unclear> er
<lb n="43"/>sich selber in E. E. W. statt verfuegen,
<lb n="44"/>unnd derselben E. E. W. uff ir <unclear cert="medium" resp="#joint">begern</unclear>,
<lb n="45"/><unclear cert="low" resp="#joint">gepuerennden</unclear> beschaid geben, unnd sich inn
<lb n="46"/>dem, aller gepuer erzaigen und beweisen.
<lb n="47"/>Das wir E. E. W. auff ir schreiben diß-
<lb n="48"/>mals, für bericht <unclear cert="low" resp="#joint">anzaigen</unclear> <unclear cert="medium" resp="#joint">woellen</unclear>, und
<lb n="49"/>derselben freündtlich nachparlich lieb
<lb n="50"/>unnd dienst zuerzaigen, sein wir ge-
<lb n="51"/><unclear cert="low" resp="#joint">naigt</unclear> unnd willig. Datum den <origDate when="1570-11-24" cert="medium" resp="#ner">24ten
<lb n="52"/>novembris. Anno 70</origDate>.
<lb n="53"/><orgName role="issuer" resp="#ner">Burgermaister und
<lb n="54"/>rath der statt Lindow</orgName>,
<pb facs="StadtASG_Missive_932_2741.jpg" n="3"/>
<pb facs="StadtASG_Missive_932_2742.jpg" n="4"/>
<lb n="55"/>Den ersamen unnd weisen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="56"/>maister unnd Rathe der Statt Sanct
<lb n="57"/>Gallen</orgName>, unnsern <unclear cert="medium" resp="#joint">besonders</unclear> lieben und
<lb n="58"/>guoten <unclear cert="low" resp="#joint">freuenden</unclear>.
</p>
