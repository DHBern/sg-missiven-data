<lb n="3"/><unclear cert="low" resp="#joint">liebs</unclear> und <unclear cert="low" resp="#joint">guots</unclear> <unclear cert="low" resp="#joint">vermoegen</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">vor</unclear>, <unclear cert="low" resp="#joint">Frommen</unclear>, <unclear cert="low" resp="#joint">Für</unclear>-
<lb n="4"/><unclear cert="low" resp="#joint">sichtigen</unclear>, <unclear cert="low" resp="#joint">Eersamen</unclear> und <unclear cert="low" resp="#joint">Weÿsen</unclear>, <unclear cert="low" resp="#joint">Insunders</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">Freünde</unclear>, und getrewe liebe Eÿdgnossen.
<lb n="6"/>Es berichtet unß unser lieber burger <persName resp="#ner">Lorenz Isell</persName>,
<lb n="7"/>welcher gestalten ihme von eweren burgern Herren
<lb n="8"/><persName resp="#ner"><unclear cert="low" resp="#joint">Lux</unclear> <unclear cert="low" resp="#joint">Yselin</unclear></persName>, und <persName resp="#ner">Claudio Geyar</persName> ein ansehenliche
<lb n="9"/>summa weÿzen angetragen, und anhero
<lb n="10"/><unclear cert="low" resp="#joint">laut</unclear> <unclear cert="low" resp="#joint">ihres</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">schreibens</unclear>
