<p>
<pb facs="StadtASG_Missive_2678_10401.jpg" n="1"/>
<lb n="1"/>Intercession.,
<lb n="2"/>Unser freündlich willig dienst, sampt was wir <unclear cert="low" resp="#joint">eeren</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">liebs</unclear> und <unclear cert="low" resp="#joint">guots</unclear> <unclear cert="low" resp="#joint">vermoegen</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">vor</unclear>, <unclear cert="low" resp="#joint">Frommen</unclear>, <unclear cert="low" resp="#joint">Für</unclear>-
<lb n="4"/>sichtigen, Eersamen und Weÿsen, Insunders
<lb n="5"/>guote Freünde, und <unclear cert="low" resp="#joint">getrewe</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">Eÿdgnossen</unclear>.
<lb n="6"/>Es berichtet unß unser lieber burger <persName resp="#ner">Lorenz <unclear cert="low" resp="#joint">Isell</unclear></persName>,
<lb n="7"/>welcher <unclear cert="low" resp="#joint">gestalten</unclear> ihme von eweren burgern Herren
<lb n="8"/><persName resp="#ner">Lux Yselin</persName>, und <persName resp="#ner"><unclear cert="low" resp="#joint">Claudio</unclear> <unclear cert="low" resp="#joint">Geyar</unclear></persName> ein <unclear cert="low" resp="#joint">ansehenliche</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">summa</unclear> <unclear cert="low" resp="#joint">weÿzen</unclear> angetragen, und anhero
<lb n="10"/><unclear cert="low" resp="#joint">laut</unclear> <unclear cert="low" resp="#joint">ihres</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">schreibens</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">füeren</unclear> <unclear cert="low" resp="#joint">zuelassen</unclear> <unclear cert="low" resp="#joint">versprochen</unclear> worden; Es <unclear cert="medium" resp="#joint">were</unclear>
<lb n="13"/>aber dieselbe einen gewaltt usser euch unsern.
<lb n="14"/>Ggl. weÿsen lieben <unclear cert="low" resp="#joint">Eÿdgnossen</unclear>, nach als <unclear cert="low" resp="#joint">die</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">sellte</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">frucht</unclear> <unclear cert="low" resp="#joint">schon</unclear> <unclear cert="low" resp="#joint">auff</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">waegen</unclear> geladen gewesen,
<lb n="17"/><unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">jezmalß</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">ins</unclear> <unclear cert="low" resp="#joint">künfftig</unclear>
<lb n="18"/>und bereits <unclear cert="low" resp="#joint">vortgesollt</unclear>, <unclear cert="low" resp="#joint">neüwlich</unclear> inhibirt, und
<lb n="19"/><unclear cert="low" resp="#joint">süe</unclear> <unclear cert="low" resp="#joint">beÿ</unclear> der <unclear cert="low" resp="#joint">thorhütung</unclear> abgehalten worden, die <unclear cert="low" resp="#joint">ab</unclear>-
<lb n="20"/><unclear cert="low" resp="#joint">zuführen</unclear>, <unclear cert="low" resp="#joint">one</unclear> <unclear cert="low" resp="#joint">fernern</unclear> <unclear cert="low" resp="#joint">befindtnen</unclear> <unclear cert="low" resp="#joint">befelch</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">Nun</unclear> <unclear cert="low" resp="#joint">sezen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">Zwar</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">keinen</unclear> <unclear cert="low" resp="#joint">zweifel</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">Ewer</unclear> <unclear cert="low" resp="#joint">Liebden</unclear>
<lb n="23"/>hierinen wichtige und erhebliche ursach <unclear cert="low" resp="#joint">und</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">bedenckhen</unclear> <unclear cert="medium" resp="#joint">gehabt</unclear> <unclear cert="low" resp="#joint">haben</unclear>; Jedoch <unclear cert="low" resp="#joint">gelebt</unclear>
<lb n="25"/>er der <unclear cert="low" resp="#joint">zueverlässigen</unclear> <unclear cert="low" resp="#joint">hoffnung</unclear>, da Ihr
<lb n="26"/>dessen, dz die frucht allhie in diser unserer statt
<lb n="27"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachbarschafft</unclear>
<lb n="28"/>verkaufft und <unclear cert="low" resp="#joint">verschlißen</unclear> <unclear cert="low" resp="#joint">oder</unclear> verbraucht
<lb n="29"/>werden werde, gnuogsamlich versichert <unclear cert="low" resp="#joint">werdte</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">alß</unclear> dann solches on ferner bedenckhen gestatten.
<lb n="31"/>und <unclear cert="low" resp="#joint">anhero</unclear> <unclear cert="low" resp="#joint">gehen</unclear> <unclear cert="low" resp="#joint">zulassen</unclear> <unclear cert="low" resp="#joint">nit</unclear> ungeneigt weren,
<lb n="32"/>Mit angehefftem <unclear cert="low" resp="#joint">Pitten</unclear>, <unclear cert="low" resp="#joint">weilen</unclear> ihme wir
<lb n="33"/>ihme hierzu mit unserer Intercession
<pb facs="StadtASG_Missive_2678_10402.jpg" n="2"/>
<lb n="34"/>Wan er <unclear cert="low" resp="#joint">kaußbarliche</unclear> <unclear cert="low" resp="#joint">zagnißen</unclear> <unclear cert="low" resp="#joint">verhefto</unclear> J <unclear cert="low" resp="#joint">be</unclear>-
<lb n="35"/><unclear cert="low" resp="#joint">hilßthueg</unclear> <unclear cert="low" resp="#joint">ergehen</unclear> <unclear cert="low" resp="#joint">wollte</unclear>, <unclear cert="low" resp="#joint">Wegen</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">gehorsamen</unclear> <unclear cert="low" resp="#joint">verbleiben</unclear> <unclear cert="low" resp="#joint">angeregts</unclear> <unclear cert="low" resp="#joint">fruecht</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">niemandts</unclear> <unclear cert="low" resp="#joint">andersthin</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">iß</unclear> diser <unclear cert="low" resp="#joint">unserer</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Jz</unclear>. die an <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Jnis</unclear> <unclear cert="low" resp="#joint">besteheß</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachburgsaßt</unclear> <placeName ref="stadtasg-places-91" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Oestereichischen</unclear></placeName> <unclear cert="low" resp="#joint">Vorthausfests</unclear> wegen unsicher-
<lb n="40"/>hait der <unclear cert="low" resp="#joint">straßen</unclear> <unclear cert="low" resp="#joint">keine</unclear> <unclear cert="low" resp="#joint">fruecht</unclear> <unclear cert="low" resp="#joint">herauß</unclear> <unclear cert="low" resp="#joint">stehndte</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">J</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">gemeinen</unclear> <unclear cert="low" resp="#joint">man</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">guetem</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="42"/><unclear cert="low" resp="#joint">kaufken</unclear> <unclear cert="low" resp="#joint">laßen</unclear> wolle. Wan dan
<lb n="43"/>wir biß disen laeufen solh fruecht wol migen dir
<lb n="44"/>ansere solhe fruecht wol migen
<lb n="45"/>Wan dan nun wir ihme die gebettene
<lb n="46"/>interceßion burgerliher verwandtnus halber
<lb n="47"/>nit zuverweigern gewueßt.
<lb n="48"/>Alß langt an eüch unser getrewe lieb <unclear cert="low" resp="#joint">Eid</unclear>-
<lb n="49"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">fehrnen</unclear> <unclear cert="low" resp="#joint">gnoßen</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">freundt</unclear> <unclear cert="low" resp="#joint">Eydtgnößisch</unclear> <unclear cert="low" resp="#joint">pitt</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">wegen</unclear> und ersuchen, <unclear cert="medium" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">geruhen</unclear> <unclear cert="low" resp="#joint">hierinen</unclear> <unclear cert="low" resp="#joint">un</unclear>-
<lb n="51"/><unclear cert="low" resp="#joint">seren</unclear> burger, <unclear cert="medium" resp="#joint">sovil</unclear> sich ohne nük ihrer <unclear cert="medium" resp="#joint">aige</unclear>-
<lb n="52"/>nen Statt und burgerschaft halber be-
<lb n="53"/>so woleuch auhl. Läglichen thun <unclear cert="low" resp="#joint">laßt</unclear>, zu Jz seiner pitt
<lb n="54"/>gstezewillfahren, da wir <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">versehung</unclear> <unclear cert="low" resp="#joint">zethun</unclear>, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">außert</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">greüzen</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">verkaufft</unclear> werden <unclear cert="low" resp="#joint">sol</unclear>,
<lb n="57"/><unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">solhes</unclear> umb eüch und die <unclear cert="low" resp="#joint">Ewrige</unclear> zu <unclear cert="low" resp="#joint">be</unclear>-
<lb n="58"/><unclear cert="low" resp="#joint">gebenheit</unclear>, <unclear cert="low" resp="#joint">Eydtgnößisch</unclear> und freundtlich <unclear cert="medium" resp="#joint">zuer</unclear>-
<lb n="59"/><unclear cert="low" resp="#joint">widern</unclear> <unclear cert="low" resp="#joint">erbietig</unclear> sindt, <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">Goett</unclear>-
<lb n="60"/>licher <unclear cert="low" resp="#joint">solfalt</unclear> <unclear cert="low" resp="#joint">bevehlend</unclear>. <unclear cert="low" resp="#joint">Geben</unclear> den <origDate when="1620-04-25" resp="#ner"><unclear cert="low" resp="#joint">25</unclear>.
<lb n="61"/>Aprilis, Ao 1620</origDate>.
<lb n="62"/>An die Statt <orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Wyl</unclear></orgName>. <unclear cert="low" resp="#joint">B</unclear>. <unclear cert="low" resp="#joint">J</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">R</unclear>. d <unclear cert="low" resp="#joint">Statt</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Stgallen</orgName>.
