<lb n="13"/>aber dieselbe einen <unclear cert="low" resp="#joint">gewaltt</unclear> <unclear cert="low" resp="#joint">usser</unclear> <unclear cert="low" resp="#joint">euch</unclear> unsern.
<lb n="14"/><unclear cert="low" resp="#joint">Ggl</unclear>. <unclear cert="low" resp="#joint">weÿsen</unclear> lieben Eÿdgnossen, nach als <unclear cert="low" resp="#joint">die</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">sellte</unclear>
