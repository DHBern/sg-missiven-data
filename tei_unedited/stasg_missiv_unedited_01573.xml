<lb n="123"/>Dann <unclear cert="medium" resp="#joint">disere</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">alle</unclear> <unclear cert="medium" resp="#joint">andere</unclear> handlungen,
