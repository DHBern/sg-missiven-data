<lb n="116"/>lung, dem gemeinen vatterlandt <unclear cert="low" resp="#joint">zeruowen</unclear>
<lb n="117"/><unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guotem</unclear>, <unclear cert="medium" resp="#joint">zuo</unclear> einem <unclear cert="low" resp="#joint">erwünschten</unclear> glück-
