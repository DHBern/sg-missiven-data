<lb n="120"/><unclear cert="low" resp="#joint">Daß</unclear> <unclear cert="low" resp="#joint">alles</unclear> bittend wir, wellind <unclear cert="medium" resp="#joint">ir</unclear> <unclear cert="medium" resp="#joint">unsere</unclear>
