<lb n="29"/><origPlace ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Lindauw</unclear></origPlace>, <origDate resp="#ner">den <unclear cert="low" resp="#joint">16</unclear>. 19. aprilis</origDate>.
