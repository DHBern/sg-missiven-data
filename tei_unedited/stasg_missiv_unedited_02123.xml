<lb n="23"/><unclear cert="low" resp="#joint">So</unclear> <unclear cert="low" resp="#joint">ist</unclear> unß auch diser tagen <unclear cert="medium" resp="#joint">eüsserlich</unclear> <unclear cert="medium" resp="#joint">fürkommen</unclear>,
