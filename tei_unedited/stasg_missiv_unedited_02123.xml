<p>
<pb facs="StadtASG_Missive_2123_7951.jpg" n="1"/>
<lb n="1"/>Unnser freündtlich willig <unclear cert="medium" resp="#joint">dinst</unclear> zuvor, fürsichtige,
<lb n="2"/><unclear cert="medium" resp="#joint">ersame</unclear> und weise, besonders liebe und <unclear cert="medium" resp="#joint">guete</unclear> freünd.
<lb n="3"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">f</unclear>. <unclear cert="low" resp="#joint">w</unclear>. <unclear cert="low" resp="#joint">sollen</unclear> wir <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">hoechstem</unclear> vertrauen nicht
<lb n="4"/><unclear cert="medium" resp="#joint">bergen</unclear>, das <unclear cert="medium" resp="#joint">sithero</unclear> unsers vorigen schreibens,
<lb n="5"/>die <unclear cert="medium" resp="#joint">koeu</unclear>. <unclear cert="medium" resp="#joint">würde</unclear> <unclear cert="medium" resp="#joint">inn</unclear> <placeName ref="stadtasg-places-41" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Ungarn</unclear></placeName> und <placeName resp="#ner"><unclear cert="medium" resp="#joint">Boeheimb</unclear></placeName>, nicht
<lb n="6"/>allein <unclear cert="medium" resp="#joint">ann</unclear> unß, <unclear cert="medium" resp="#joint">ann</unclear> <unclear cert="medium" resp="#joint">herrn</unclear> <unclear cert="medium" resp="#joint">abbt</unclear> zu <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">St</unclear>. <unclear cert="medium" resp="#joint">Gallen</unclear></placeName>, <unclear cert="medium" resp="#joint">und</unclear>
<lb n="7"/>andere <unclear cert="medium" resp="#joint">ann</unclear> <unclear cert="medium" resp="#joint">disen</unclear> seiten am <unclear cert="low" resp="#joint">See</unclear> <unclear cert="low" resp="#joint">gelegne</unclear> <unclear cert="low" resp="#joint">orth</unclear>, <unclear cert="low" resp="#joint">sonder</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">ann</unclear> die Statt <placeName ref="stadtasg-places-194" cert="medium" resp="#ner">Wangen</placeName>, <placeName ref="stadtasg-places-118" cert="medium" resp="#ner">Yßni</placeName>, <placeName ref="stadtasg-places-244" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Leütkirch</unclear></placeName> und
<lb n="9"/>die benachbarte <unclear cert="medium" resp="#joint">vom</unclear> <unclear cert="medium" resp="#joint">adel</unclear>, <unclear cert="medium" resp="#joint">undterschidliche</unclear> schreiben
<lb n="10"/><unclear cert="low" resp="#joint">abgehen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>, welche gleichwol ein <unclear cert="medium" resp="#joint">hoffnung</unclear> zum
<lb n="11"/><unclear cert="medium" resp="#joint">boehmischen</unclear> <unclear cert="medium" resp="#joint">friden</unclear> <unclear cert="medium" resp="#joint">machen</unclear>, aber <unclear cert="low" resp="#joint">beinebens</unclear> <unclear cert="low" resp="#joint">gnaedigist</unclear>
<lb n="12"/>begehren, dem <unclear cert="medium" resp="#joint">jhenigen</unclear> <unclear cert="medium" resp="#joint">kriegsvolckh</unclear>, so die <unclear cert="medium" resp="#joint">kay</unclear>.
<lb n="13"/><unclear cert="medium" resp="#joint">mt</unclear>. <unclear cert="medium" resp="#joint">hochloebseeligister</unclear> <unclear cert="medium" resp="#joint">gedaechtnuß</unclear>, noch vor dero
<lb n="14"/>ableiben, zu <unclear cert="medium" resp="#joint">staerckhung</unclear>, <unclear cert="medium" resp="#joint">auff</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">fueß</unclear> gebracht,
<lb n="15"/>den <unclear cert="medium" resp="#joint">paß</unclear> und durchzug, <unclear cert="medium" resp="#joint">inn</unclear> unserer und ihrer <unclear cert="low" resp="#joint">bott</unclear>-
<lb n="16"/>und <unclear cert="low" resp="#joint">piietkaiten</unclear>, <unclear cert="low" resp="#joint">guetwillig</unclear> <unclear cert="low" resp="#joint">zuverstatten</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">zuzu</unclear>-
<lb n="17"/>lassen; mit <unclear cert="medium" resp="#joint">allergnaedigstem</unclear> <unclear cert="medium" resp="#joint">versprechen</unclear>, <unclear cert="medium" resp="#joint">solch</unclear>
