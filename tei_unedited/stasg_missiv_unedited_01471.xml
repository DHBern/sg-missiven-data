<lb n="10"/><unclear cert="low" resp="#joint">hab</unclear> unnd <unclear cert="medium" resp="#joint">guot</unclear> ouch <unclear cert="medium" resp="#joint">ansprach</unclear> <unclear cert="medium" resp="#joint">füren</unclear>, <unclear cert="medium" resp="#joint">haben</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">eüch</unclear>
