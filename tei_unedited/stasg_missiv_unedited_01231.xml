    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1231_4089.jpg" n="1"/>
<pb facs="StadtASG_Missive_1231_4090.jpg" n="2"/>
<pb facs="StadtASG_Missive_1231_4091.jpg" n="3"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edle</unclear>, <unclear cert="low" resp="#joint">ernueste</unclear>, <unclear cert="low" resp="#joint">fürsichtige</unclear>, <unclear cert="low" resp="#joint">erbare</unclear> und wol
<lb n="2"/>weise herrn, den herrn seie meine zu <unclear cert="low" resp="#joint">gebür</unclear>
<lb n="3"/>ganz guettwillige und beflißne diest <unclear cert="low" resp="#joint">zuuor</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">gL</unclear> <unclear cert="low" resp="#joint">herrn</unclear> liebe unnd <unclear cert="low" resp="#joint">guette</unclear> <unclear cert="low" resp="#joint">freundt</unclear>, was
<lb n="5"/><unclear cert="low" resp="#joint">hieuor</unclear> durch weilundt <unclear cert="low" resp="#joint">bede</unclear> meiner ehrn ge-
<lb n="6"/>liebten junckern und <unclear cert="low" resp="#joint">oheimen</unclear>, <persName resp="#ner">Marquarden
<lb n="7"/>vom Stain</persName>, zu <placeName ref="stadtasg-places-345" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Jetingen</unclear></placeName>, und <placeName ref="stadtasg-places-6" cert="medium" resp="#ner">Matzensieß</placeName> etc.
<lb n="8"/>und <unclear cert="low" resp="#joint">sines</unclear> geliebten bruedern <persName resp="#ner">Hannssen
<lb n="9"/>vom Stain</persName>, seligen, an <unclear cert="medium" resp="#joint">den</unclear> auch edlen und
<lb n="10"/><unclear cert="low" resp="#joint">vesten</unclear> herrn <persName resp="#ner"><unclear cert="low" resp="#joint">Leonhartten</unclear> <unclear cert="low" resp="#joint">Zollenkofer</unclear></persName>, zum
<lb n="11"/><placeName resp="#ner">Sonnenberg</placeName> unnd <placeName resp="#ner">Altenklingen</placeName> etc. wegen
<lb n="12"/>weilundt <persName resp="#ner">Jeronimus Oßwaldts</persName>, des erbarn
<lb n="13"/><persName resp="#ner">Matheus Oßwaldts</persName> burgers und <unclear cert="low" resp="#joint">appoteckers</unclear>
<lb n="14"/>zu <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName> sons seligen, <unclear cert="low" resp="#joint">nachgelaßner</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">zweier</unclear> <unclear cert="medium" resp="#joint">kinder</unclear> <unclear cert="low" resp="#joint">eruoederer</unclear> vätterlichen erbs,
<lb n="16"/>oder doch <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">weingst</unclear> kleiner <unclear cert="medium" resp="#joint">hilf</unclear> und bei-
<lb n="17"/>stands halben, zugeschriben worden, <unclear cert="low" resp="#joint">das</unclear> wirt
<lb n="18"/>woll ermeltem herrn <persName resp="#ner">Zollenkofer</persName> zweiuels
<lb n="19"/>loß, noch in guettem angedencken <unclear cert="low" resp="#joint">sin</unclear>,
<lb n="20"/>Nun hat mich ermelts Jeronimus Oßwaldts nach-
<lb n="21"/>gelaßne witib in <unclear cert="low" resp="#joint">demuett</unclear> berichtet, welcher
<lb n="22"/>gestalt der allmechtig <unclear cert="low" resp="#joint">gedachten</unclear> <unclear cert="low" resp="#joint">irn</unclear> <unclear cert="low" resp="#joint">schwerher</unclear>
<pb facs="StadtASG_Missive_1231_4092.jpg" n="4"/>
<lb n="23"/><persName resp="#ner"><unclear cert="low" resp="#joint">Matheus</unclear> Oßwald</persName>, auß disem <unclear cert="low" resp="#joint">zergengklichen</unclear>
<lb n="24"/>leben, <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">goettlichen</unclear> gnaden <unclear cert="medium" resp="#joint">abgev=</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">ordert</unclear> haben solte,
<lb n="26"/>Und wiewoll nun sich der <unclear cert="low" resp="#joint">billicheit</unclear> nach ver=
<lb n="27"/>sehen, nach disem zeitlichen abgang (<unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">dan</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">also</unclear>) <unclear cert="low" resp="#joint">sin</unclear> Oßwaldts <unclear cert="low" resp="#joint">hinderlaßne</unclear> erben
<lb n="29"/><unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName>, <unclear cert="low" resp="#joint">solten</unclear> ein <unclear cert="low" resp="#joint">soliches</unclear> an ge=
<lb n="30"/>dachts <persName resp="#ner">Jeronimus Oßwaldts</persName> verlaßne witib
<lb n="31"/>und kindern, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">rechtmeßige</unclear> <unclear cert="low" resp="#joint">miterben</unclear>,
<lb n="32"/>auch gelangen laßen. <unclear cert="low" resp="#joint">Sitemalen</unclear> er <persName resp="#ner">Jero=
<lb n="33"/>nimus <unclear cert="low" resp="#joint">Oßwald</unclear></persName>, noch seine zehen hinderlaßne
<lb n="34"/>arme waisen von dem alten <placeName ref="stadtasg-places-186" cert="medium" resp="#ner">Oßwalden</placeName> in
<lb n="35"/><unclear cert="low" resp="#joint">erbschaft</unclear> <unclear cert="low" resp="#joint">weiße</unclear> nie außgeschloßen worden,
<lb n="36"/><unclear cert="low" resp="#joint">geschwigen</unclear>, das <unclear cert="medium" resp="#joint">sin</unclear> vatter, <unclear cert="low" resp="#joint">jne</unclear> <persName resp="#ner">Jeronimus
<lb n="37"/><unclear cert="low" resp="#joint">Oßwald</unclear></persName>, umb willen <unclear cert="low" resp="#joint">aines</unclear> <unclear cert="low" resp="#joint">namhaften</unclear> an=
<lb n="38"/><unclear cert="low" resp="#joint">nemens</unclear> <unclear cert="medium" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">studium</unclear> (wie die <unclear cert="medium" resp="#joint">jhezo</unclear> hind=
<lb n="39"/><unclear cert="low" resp="#joint">laßne</unclear> <unclear cert="low" resp="#joint">schwestern</unclear> mit etwas ungrund für
<lb n="40"/>geben) <unclear cert="low" resp="#joint">jme</unclear> <unclear cert="low" resp="#joint">einichsten</unclear> erbloß <unclear cert="low" resp="#joint">erkennen</unclear>
<lb n="41"/>wellen, deßen alles aber unangeschen,
<lb n="42"/>wil jedoch disen <unclear cert="low" resp="#joint">armen</unclear> <unclear cert="low" resp="#joint">waisen</unclear>, von <unclear cert="low" resp="#joint">jres</unclear>
<lb n="43"/>vatters seligen wegen, wie es mit <unclear cert="low" resp="#joint">mergedachts</unclear>
<lb n="44"/><persName resp="#ner">Matheus <unclear cert="low" resp="#joint">Oßwalds</unclear></persName> seligen <unclear cert="low" resp="#joint">verlaßenschaft</unclear>
<pb facs="StadtASG_Missive_1231_4093.jpg" n="5"/>
<lb n="45"/>behaften, ainicher bericht <unclear cert="low" resp="#joint">bewußt</unclear> <unclear cert="low" resp="#joint">schicht</unclear>,
<lb n="46"/>lich <unclear cert="low" resp="#joint">bevindtlich</unclear> <unclear cert="low" resp="#joint">zekomen</unclear>, <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">dem</unclear> sich <unclear cert="low" resp="#joint">dan</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">aus</unclear> <unclear cert="low" resp="#joint">vil</unclear> mer zuverwundern, unnd augen-
<lb n="48"/>scheinlich ab <unclear cert="low" resp="#joint">zunemen</unclear>, <unclear cert="low" resp="#joint">das</unclear> bede <unclear cert="low" resp="#joint">verlaßne</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">chwrtter</unclear> <unclear cert="low" resp="#joint">dises</unclear> <unclear cert="low" resp="#joint">irs</unclear> <unclear cert="low" resp="#joint">bruoders</unclear> seligen, und
<lb n="50"/>seine arme waisen unbillicher und unrecht-
<lb n="51"/><unclear cert="low" resp="#joint">messiger</unclear> <unclear cert="low" resp="#joint">wiße</unclear> der erbschaft <unclear cert="low" resp="#joint">us</unclear> <unclear cert="low" resp="#joint">zue</unclear>-
<lb n="52"/><unclear cert="low" resp="#joint">schießen</unclear>, <unclear cert="low" resp="#joint">gleichsam</unclear> <unclear cert="low" resp="#joint">eheir</unclear> <unclear cert="low" resp="#joint">vereint</unclear> sein wolten.
<lb n="53"/>Wenn dann mer <unclear cert="low" resp="#joint">offtgedachte</unclear> <unclear cert="low" resp="#joint">witib</unclear> <unclear cert="low" resp="#joint">wie</unclear> ob
<lb n="54"/><unclear cert="low" resp="#joint">gemelt</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">grund</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">zusein</unclear> <unclear cert="low" resp="#joint">nie</unclear> <unclear cert="low" resp="#joint">angemeldet</unclear>,
<lb n="55"/>unnd auch bej weitem nit alß das ime ohmie
<lb n="56"/>seligen inn seinem studiern vil an gehenkht
<lb n="57"/>worden. Darunder er ainicher erbschaft
<lb n="58"/><unclear cert="low" resp="#joint">merfehig</unclear> sein solte. Welches disen armen
<lb n="59"/>waißen mer <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">zuvil</unclear> beschwerlich unnd
<lb n="60"/>schmertzlich fallen thate. Unnd hierauf
<lb n="61"/>irem demuetigen flehenlichen bitten nach,
<lb n="62"/>an die herren <unclear cert="low" resp="#joint">fuerbitlich</unclear> schriben umb er-
<lb n="63"/>tailung aller <unclear cert="low" resp="#joint">gerechtikait</unclear> <unclear cert="low" resp="#joint">abgohn</unclear> <unclear cert="low" resp="#joint">zelaßen</unclear>,
<lb n="64"/>der billichait gemaeß nicht verwegern sollen
<lb n="65"/>noch künden, dem allem nach gelangt an
<pb facs="StadtASG_Missive_1231_4094.jpg" n="6"/>
<lb n="66"/>die <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">mein</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">gebür</unclear> <unclear cert="low" resp="#joint">ganntz</unclear> <unclear cert="low" resp="#joint">dinstlich</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">hochfleissigs</unclear> <unclear cert="low" resp="#joint">bitten</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">wellen</unclear> wo sye anderst
<lb n="68"/>Inn <unclear cert="low" resp="#joint">solchem</unclear> <unclear cert="low" resp="#joint">vorhaben</unclear>, <unclear cert="low" resp="#joint">wie</unclear> nicht <unclear cert="low" resp="#joint">zuoverhoffen</unclear>,
<lb n="69"/><unclear cert="low" resp="#joint">vortschreiten</unclear> <unclear cert="low" resp="#joint">wolten</unclear> nicht allein der loblichen
<lb n="70"/>statt <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName> gebrauch, auch aller ver-
<lb n="71"/>nunfft unnd billicheit nach, dise beede armen
<lb n="72"/>waisen als rechte natürliche miterben, wo nit
<lb n="73"/>zuo völliger erbschafft. Jedoch zuo solchem
<lb n="74"/>von obrigkeit wegen beholffen sein, damit
<lb n="75"/>sye sich Ires lieben vatters und anherren
<lb n="76"/>seligen verlaßner redlicheit zuogetrösten, unnd
<lb n="77"/>auch <unclear cert="low" resp="#joint">wei</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">ei</unclear> <unclear cert="low" resp="#joint">nes</unclear> <unclear cert="low" resp="#joint">töchterlin</unclear>, <unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">eine</unclear>
<lb n="78"/><unclear cert="low" resp="#joint">waiß</unclear>, mit solchem wider antwortlichem
<lb n="79"/>schreiben an mich <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">neysten</unclear> <unclear cert="low" resp="#joint">abfertigen</unclear>, da-
<lb n="80"/>mit sye bede waisen diser meiner Inen zum
<lb n="81"/>besten gemainter fürschrifft <unclear cert="low" resp="#joint">wirkhlich</unclear> ge-
<lb n="82"/><unclear cert="low" resp="#joint">nossen</unclear> <unclear cert="low" resp="#joint">zuohaben</unclear>, <unclear cert="low" resp="#joint">entlich</unclear> <unclear cert="low" resp="#joint">sehen</unclear> und befinden
<lb n="83"/>megen. Und ich es umb die herren in <unclear cert="low" resp="#joint">derglich</unclear>
<lb n="84"/><unclear cert="low" resp="#joint">od</unclear> andern <unclear cert="low" resp="#joint">zuotragenden</unclear> <unclear cert="low" resp="#joint">fellen</unclear>, Inn gebür
<lb n="85"/>hinwiderumb zuoverdienen auch <unclear cert="low" resp="#joint">ursach</unclear> <unclear cert="low" resp="#joint">habe</unclear>,
<lb n="86"/><unclear cert="low" resp="#joint">den</unclear> herren beineben Inn gebür angeneme willige
<lb n="87"/>dinst zuerweisen, haben die selbige mich
<pb facs="StadtASG_Missive_1231_4095.jpg" n="7"/>
<lb n="88"/><unclear cert="low" resp="#joint">eher</unclear> <unclear cert="medium" resp="#joint">aeb</unclear> <unclear cert="low" resp="#joint">geneigt</unclear> unnd <unclear cert="medium" resp="#joint">guettwillig</unclear>,
<lb n="89"/>damit <unclear cert="low" resp="#joint">unns</unclear> der goettlichen allmacht,
<lb n="90"/>inn schuz unnd schirm <unclear cert="low" resp="#joint">beuelchendt</unclear>, datum
<lb n="91"/><origPlace ref="stadtasg-places-345" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Jetingen</unclear></origPlace> <origDate when="1588-07-04" cert="medium" resp="#ner">den <unclear cert="low" resp="#joint">4</unclear> <unclear cert="low" resp="#joint">julii</unclear> anno 88</origDate>.
<lb n="92"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Margreta</unclear> vom Stein</persName> zu
<lb n="93"/><placeName ref="stadtasg-places-345" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Jettinngen</unclear></placeName> und <placeName ref="stadtasg-places-6" cert="medium" resp="#ner">Matzensies</placeName> etc.
<lb n="94"/>geborne von <placeName resp="#ner"><unclear cert="low" resp="#joint">Flersheim</unclear></placeName>,
<pb facs="StadtASG_Missive_1231_4096.jpg" n="8"/>
<lb n="95"/>Denen edlen, <unclear cert="low" resp="#joint">eerenuessten</unclear>, fürsichtigen, ersamen
<lb n="96"/>unnd wollweisen herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermaisterur</unclear>
<lb n="97"/>unnd Rath der statt Sant Gallen</orgName>, <unclear cert="low" resp="#joint">mein</unclear>-
<lb n="98"/><unclear cert="low" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">insonnders</unclear> <unclear cert="low" resp="#joint">gnaedigen</unclear> herren, lieben und guet-
<lb n="99"/>en freündten.
<lb n="100"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName>
</p>
