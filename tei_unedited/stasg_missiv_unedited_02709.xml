<lb n="3"/><unclear cert="medium" resp="#joint">denselben</unclear> <unclear cert="medium" resp="#joint">syen</unclear> <unclear cert="medium" resp="#joint">mein</unclear> <unclear cert="medium" resp="#joint">freundt</unclear>: nachbarlich willig
