        <body>
<p>
<pb facs="StadtASG_Missive_2107_7897.jpg" n="1"/>
<lb n="1"/>Unsere freuendt, nachparlich, guetwillige dienst
<lb n="2"/>unnd <unclear cert="low" resp="#joint">gruetz</unclear> <unclear cert="low" resp="#joint">bevor</unclear>, <unclear cert="low" resp="#joint">Edle</unclear>, <unclear cert="low" resp="#joint">Ehrnveste</unclear>, Fromme,
<lb n="3"/>Fuersichtig unnd Weise, innsonders liebe guette
<lb n="4"/>Freuendt unnd Nachparen. <unclear cert="low" resp="#joint">etc</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Euwer</unclear> <unclear cert="low" resp="#joint">fuergeschriben</unclear> von wegen euwers bur-
<lb n="6"/>gers <persName resp="#ner">Zachariaßen Studins</persName> unnd deßo an euch
<lb n="7"/>schrifftlich ubergebne suplication haben wir hoerende
<lb n="8"/>ablesen wol verstanden. In beruerrter suplication
<lb n="9"/>ist <unclear cert="low" resp="#joint">zuevernemmen</unclear>, dz Ihr von gedachtem suplicanten
<lb n="10"/>im <unclear cert="low" resp="#joint">grund</unclear> (. <unclear cert="low" resp="#joint">deme</unclear> sonst ist <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">volget</unclear> .) nit bericht worden.
<lb n="11"/>Es haben vor Jaren die von <placeName ref="stadtasg-places-5" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Arbon</unclear></placeName> unnd <placeName ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Bischoffzel</unclear></placeName>
<lb n="12"/>in heuwrath unnd erbfahlen etlich gelt unnd geltzwerth
<lb n="13"/>uß einem orth an das ander gezogen unnd <unclear cert="low" resp="#joint">khein</unclear>
<lb n="14"/>theil den anderen umb den <unclear cert="low" resp="#joint">abzug</unclear> <unclear cert="low" resp="#joint">angeforderet</unclear>,
<lb n="15"/><unclear cert="low" resp="#joint">anderst</unclear> bey ettwas wenigen Jaren haben die
<lb n="16"/>benachparte von <placeName ref="stadtasg-places-19" cert="medium" resp="#ner">Bischoffzel</placeName> unnserer mitburgerin
<lb n="17"/><persName resp="#ner">Maria Laimbacherin</persName> umb den abzug von einer heinn-
<lb n="18"/>ererbbten summa nit allein angeforderet, sonder
<lb n="19"/>den auch von Ihro genommen, dahero wir verursachet,
<lb n="20"/>sie die von <placeName ref="stadtasg-places-19" cert="medium" resp="#ner">Bischoffzel</placeName> zuehalten wie sie unns
<lb n="21"/>unnd die unnserige halten <unclear cert="low" resp="#joint">thuend</unclear>: <unclear cert="low" resp="#joint">Unnd</unclear> <unclear cert="low" resp="#joint">heuerchen</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">hiemit</unclear> von dem was <persName resp="#ner">Studin</persName>, alß ein burger
<lb n="23"/>der Statt <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName> heuwrathlich hiedannen
<lb n="24"/>gezogen oder <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">zueziehen</unclear>, <unclear cert="low" resp="#joint">kheinen</unclear> <unclear cert="low" resp="#joint">abzug</unclear> an,
<lb n="25"/>dan wir hiemit (. welches fehr von unns .) wider
<lb n="26"/>unnsere mit euch nachparlich uffgerichte ver-
<lb n="27"/>einbarung brieff unnd sigill thuen wurden,
<lb n="28"/>sonder <unclear cert="low" resp="#joint">alleinig</unclear> von <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">ihenigen</unclear>, <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">deß</unclear>
<lb n="29"/><persName resp="#ner"><unclear cert="low" resp="#joint">Studins</unclear></persName> <unclear cert="low" resp="#joint">vorfahr</unclear> <persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Jeoerg</unclear> <unclear cert="low" resp="#joint">Ruedtman</unclear></persName> <unclear cert="low" resp="#joint">gewaeßner</unclear>
<pb facs="StadtASG_Missive_2107_7898.jpg" n="2"/>
<lb n="30"/>burger zue <placeName ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Bischofzell</unclear></placeName> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">hinweg</unclear> <unclear cert="low" resp="#joint">gezogen</unclear>,
<lb n="31"/><unclear cert="low" resp="#joint">woellen</unclear> wir <unclear cert="medium" resp="#joint">auß</unclear> <unclear cert="medium" resp="#joint">oberzelten</unclear> ursach deß <unclear cert="medium" resp="#joint">abzugs</unclear>
<lb n="32"/>nit <unclear cert="medium" resp="#joint">ermanglen</unclear>. Dz aber <unclear cert="medium" resp="#joint">sollicher</unclear> abzug nit
<lb n="33"/><unclear cert="medium" resp="#joint">hievor</unclear> <unclear cert="medium" resp="#joint">und</unclear> zue <unclear cert="medium" resp="#joint">lebzeiten</unclear> <unclear cert="medium" resp="#joint">gemeltes</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Ruedtmans</unclear></persName>
<lb n="34"/>begert <unclear cert="medium" resp="#joint">worden</unclear>, ist darumb <unclear cert="medium" resp="#joint">geschehen</unclear>, dz <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="35"/>wegen <unclear cert="medium" resp="#joint">seines</unclear> <unclear cert="medium" resp="#joint">eheweibs</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Juhel</unclear> <unclear cert="medium" resp="#joint">Muelligin</unclear></persName>, welche
<lb n="36"/><unclear cert="low" resp="#joint">sebziger</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Guldin</unclear></persName> <unclear cert="low" resp="#joint">ehelichen</unclear> <unclear cert="low" resp="#joint">beigewohnt</unclear>,
<lb n="37"/><unclear cert="low" resp="#joint">noch</unclear> vil <unclear cert="low" resp="#joint">haab</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">hinwegzueziechen</unclear> allhie
<lb n="38"/>gelegen <unclear cert="medium" resp="#joint">und</unclear> das ein mit dem anderen <unclear cert="medium" resp="#joint">nochener</unclear>
<lb n="39"/>erforderet <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">eingebracht</unclear> worden. <unclear cert="medium" resp="#joint">Und</unclear>
<lb n="40"/>wurdt <persName resp="#ner"><unclear cert="medium" resp="#joint">Guldin</unclear></persName> <unclear cert="medium" resp="#joint">oder</unclear> <unclear cert="medium" resp="#joint">andere</unclear> nit <unclear cert="medium" resp="#joint">ruehmen</unclear> <unclear cert="medium" resp="#joint">dar</unclear>-
<lb n="41"/><unclear cert="medium" resp="#joint">zebringen</unclear>, dz <persName resp="#ner"><unclear cert="medium" resp="#joint">Ruedtman</unclear></persName> <unclear cert="medium" resp="#joint">seige</unclear> <unclear cert="medium" resp="#joint">deßwegen</unclear> frey
<lb n="42"/><unclear cert="medium" resp="#joint">und</unclear> ledig <unclear cert="medium" resp="#joint">gesagt</unclear> <unclear cert="medium" resp="#joint">worden</unclear>, das haben wir
<lb n="43"/><unclear cert="medium" resp="#joint">Euch</unclear> zum <unclear cert="low" resp="#joint">gegenbricht</unclear> <unclear cert="low" resp="#joint">zuebeschreiben</unclear> nit underlaßen
<lb n="44"/>sollen, <unclear cert="medium" resp="#joint">denen</unclear> wir <unclear cert="medium" resp="#joint">sonsten</unclear> zue <unclear cert="medium" resp="#joint">guetem</unclear> <unclear cert="medium" resp="#joint">beliebenden</unclear>
<lb n="45"/><unclear cert="medium" resp="#joint">nachperlichen</unclear> willen <unclear cert="medium" resp="#joint">geneigt</unclear> unnd <unclear cert="medium" resp="#joint">Gotes</unclear>
<lb n="46"/><unclear cert="medium" resp="#joint">wahl</unclear> <unclear cert="medium" resp="#joint">befolehen</unclear>. <origPlace ref="stadtasg-places-5" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Arbon</unclear></origPlace> <origDate resp="#ner"><unclear cert="medium" resp="#joint">d</unclear> <unclear cert="medium" resp="#joint">19/9</unclear> <unclear cert="medium" resp="#joint">9bris</unclear> <unclear cert="medium" resp="#joint">Ao</unclear> 618</origDate>.
<lb n="47"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Stattaman</unclear> unnd
<lb n="48"/>Rath <unclear cert="medium" resp="#joint">daßelbst</unclear></orgName>.,
<pb facs="StadtASG_Missive_2107_7899.jpg" n="3"/>
<pb facs="StadtASG_Missive_2107_7900.jpg" n="4"/>
<lb n="49"/>Den Edlen, <unclear cert="low" resp="#joint">Ehrenvesten</unclear>, Frommen,
<lb n="50"/><unclear cert="low" resp="#joint">Fuersichtigen</unclear> unnd Weißen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister
<lb n="51"/>unnd Rath der Statt Sant Gallen</orgName>
<lb n="52"/>unnseren sonders lieben freunden unnd
<lb n="53"/><unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">Nachparn</unclear>. <unclear cert="low" resp="#joint">etc</unclear>.
</p>
