    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_3008_11835.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Hochwohlgeborner</unclear> <unclear cert="low" resp="#joint">Gnediger</unclear> Herr
<lb n="2"/>E. Excellenz sygen unser guotwillig
<lb n="3"/><unclear cert="low" resp="#joint">beflißen</unclear> <unclear cert="low" resp="#joint">dienst</unclear>, und was wir <unclear cert="low" resp="#joint">mer</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">liebs</unclear> und <unclear cert="low" resp="#joint">guets</unclear> <unclear cert="low" resp="#joint">vermoegendt</unclear> <unclear cert="low" resp="#joint">zvor</unclear>,
<lb n="5"/>Wir <unclear cert="low" resp="#joint">habendt</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Excell</unclear>:
<lb n="6"/><unclear cert="low" resp="#joint">widerantwurtlichem</unclear> <unclear cert="low" resp="#joint">schryben</unclear> <unclear cert="low" resp="#joint">ab</unclear>
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">herrn</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Caimung</unclear></persName> und <unclear cert="low" resp="#joint">deßen</unclear>, <unclear cert="low" resp="#joint">wie</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">seinigen</unclear> <unclear cert="low" resp="#joint">liberation</unclear> <unclear cert="low" resp="#joint">betreffendt</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">sonderem</unclear> <unclear cert="low" resp="#joint">belieben</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>, <unclear cert="low" resp="#joint">die</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">Eex</unclear> <unclear cert="low" resp="#joint">tragende</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">guetige</unclear> <unclear cert="low" resp="#joint">affection</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">deme</unclear>
<lb n="12"/>by <unclear cert="low" resp="#joint">deroselben</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">fuerbitt</unclear> <unclear cert="low" resp="#joint">gleichwohl</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">sovyl</unclear> <unclear cert="low" resp="#joint">gewuerckt</unclear>, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">E</unclear>:
<lb n="14"/><unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Caimung</unclear> und die seinige, über
<lb n="15"/>wohl genoßene sicherhiet, fuer alle,
<lb n="16"/>maßen wir dan auch <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Ime</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">selbs</unclear> <unclear cert="low" resp="#joint">bekhantlich</unclear> <unclear cert="low" resp="#joint">sithero</unclear> <unclear cert="low" resp="#joint">sovil</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">vernomen</unclear>, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">Sy</unclear> E. <unclear cert="low" resp="#joint">Excellenz</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">bißhero</unclear> <unclear cert="low" resp="#joint">gnoßne</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">schuz</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">recht</unclear>, und erzaigt gnad und <unclear cert="low" resp="#joint">favor</unclear>
<lb n="22"/>die <unclear cert="low" resp="#joint">desswegen</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">gnuogsam</unclear> <unclear cert="low" resp="#joint">ruehmen</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">khönen</unclear>. <unclear cert="low" resp="#joint">dahero</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">billich</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">verursachet</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Excell</unclear>: <unclear cert="low" resp="#joint">hiefür</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">ebnermaßen</unclear> <unclear cert="low" resp="#joint">schuldigen</unclear> <unclear cert="low" resp="#joint">danckh</unclear> <unclear cert="low" resp="#joint">zesagen</unclear>.
<lb n="26"/><unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Excell</unclear>: <unclear cert="low" resp="#joint">nun</unclear>,
<lb n="27"/><unclear cert="low" resp="#joint">Wan</unclear> <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">hieruf</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">hoffnung</unclear> <unclear cert="low" resp="#joint">geschoepfft</unclear>, es
<lb n="29"/>werde E: <unclear cert="low" resp="#joint">Excell</unclear>: <unclear cert="low" resp="#joint">dieselbige</unclear> <unclear cert="low" resp="#joint">ze</unclear>-
<lb n="30"/><unclear cert="low" resp="#joint">sichern</unclear>, <unclear cert="low" resp="#joint">herrn</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Caimungs</unclear> und <unclear cert="low" resp="#joint">seiner</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">weib</unclear> und <unclear cert="low" resp="#joint">khind</unclear> <unclear cert="low" resp="#joint">voellige</unclear> <unclear cert="low" resp="#joint">liberation</unclear>
<lb n="32"/>nicht ungeneigt sein, <unclear cert="low" resp="#joint">Als</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Excell</unclear>: <unclear cert="low" resp="#joint">zu</unclear>
<lb n="34"/>erlangung derselben wir uff
<lb n="35"/>Ihro und dero befreündten beharlich
<lb n="36"/>ansuchen, wir Ime mit diserer unserer
<lb n="37"/>anderwertigen intercession fürderlich
<lb n="38"/>zesein wenig bedenckhens getragen.
<pb facs="StadtASG_Missive_3008_11836.jpg" n="2"/>
<lb n="39"/>Gelangt derhalben E. Excellen
<lb n="40"/>unser nochmaligs under thenigstes
<lb n="41"/>bitten, die geruhe diser un
<lb n="42"/>dainen u die vorigs theilweis
<lb n="43"/>dije Herr <persName resp="#ner">Anbott</persName> und
<lb n="44"/>gnedig zu deliberiren, und Ih
<lb n="45"/>gnedig geneigt u die
<lb n="46"/>ro angelegenheit, dise sicher und auß
<lb n="47"/>einandernab
<lb n="48"/>allhero in Iher verhanden zubeveh
<lb n="49"/>lassn.
<lb n="50"/>Uns hiemit Thuen in Degenad
<lb n="51"/>aller Ehe u beliebendes gefalln
<lb n="52"/>dienern u sy so
<lb n="53"/>ihrer in gns befhllen
<lb n="54"/>usn.
<lb n="55"/>Daß Dero
<lb n="56"/>E. Excellen wir für solche ertzeig
<lb n="57"/>te gnd gering yedoch gutwillig
<lb n="58"/>wihl zubehegnen wir so
<lb n="59"/>geneigt, willig u erbutig, als
<lb n="60"/>wir Gott den herren für E. Excell:
<lb n="61"/>wolfahr beharlich bittn <origPlace ref="stadtasg-places-38" cert="medium" resp="#ner">St galln</origPlace>
<lb n="62"/><origDate when="1634-05-18" resp="#ner">den 18tn Maij A° 1634</origDate>.
<lb n="63"/>E. Excellen
<lb n="64"/>dienstwillige
<lb n="65"/><orgName role="issuer" resp="#ner">B. u Rhath</orgName>.
<lb n="66"/>Dem hochwohlgebornen herren, herren
<lb n="67"/><persName role="recipient" resp="#ner">Gustav horn</persName>, herren zu <placeName resp="#ner">Hering</placeName> und
<lb n="68"/><placeName resp="#ner">Mallas</placeName> Rittern p Konigl: Mt:
<lb n="69"/>u <placeName ref="stadtasg-places-248" cert="medium" resp="#ner">Reiche Schweden</placeName> Rhat und Veldtmarschalchen p
<lb n="70"/>unserm gnedign herren.
<pb facs="StadtASG_Missive_3008_11837.jpg" n="3"/>
<pb facs="StadtASG_Missive_3008_11838.jpg" n="4"/>
<lb n="71"/><origDate when="1634-05-18" resp="#ner">18. Maii 1634</origDate>. An <persName role="recipient" resp="#ner">Gustav Horn</persName>.
</p>
        </body>
