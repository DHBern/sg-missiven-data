<lb n="77"/>günstigen herrn, <unclear cert="low" resp="#joint">getrewen</unclear> <unclear cert="low" resp="#joint">Fürdrern</unclear> <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="78"/><unclear cert="low" resp="#joint">patronen</unclear>.
<lb n="79"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sanct</unclear> Gallen</placeName>.
</p>
