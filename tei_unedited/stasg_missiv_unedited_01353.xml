<lb n="7"/>begangnen <unclear cert="medium" resp="#joint">mißhandlung</unclear> halber <unclear cert="medium" resp="#joint">nit</unclear> allein deß
<lb n="8"/>spitals beneficia, sonder auch <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">burgerrecht</unclear> <unclear cert="low" resp="#joint">beÿ</unclear>
