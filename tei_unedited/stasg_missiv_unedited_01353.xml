<lb n="12"/>selbig <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">hauß</unclear> <unclear cert="low" resp="#joint">fraw</unclear>, hat den <unclear cert="medium" resp="#joint">verschinen</unclear> <unclear cert="medium" resp="#joint">herbst</unclear>, <unclear cert="medium" resp="#joint">beÿ</unclear>
