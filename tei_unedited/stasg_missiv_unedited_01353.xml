<lb n="14"/>kinder <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">nacht</unclear> vor <unclear cert="low" resp="#joint">unser</unclear> statt an <unclear cert="low" resp="#joint">dreÿ</unclear> <unclear cert="low" resp="#joint">undeschid</unclear>-
