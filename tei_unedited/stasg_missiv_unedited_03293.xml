<lb n="38"/>nun <unclear cert="medium" resp="#joint">ußertem</unclear> <unclear cert="medium" resp="#joint">lagere</unclear>, <unclear cert="medium" resp="#joint">Ihe</unclear> sach, <unclear cert="low" resp="#joint">z'wol</unclear> wegen <unclear cert="medium" resp="#joint">angeregten</unclear>
<lb n="39"/>eigen nützigen <unclear cert="low" resp="#joint">uffwechslens</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">sonsten</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">uil</unclear>
