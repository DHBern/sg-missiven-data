<lb n="46"/><unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">der</unclear> sachen <unclear cert="medium" resp="#joint">grundtlichen</unclear>, <unclear cert="medium" resp="#joint">nothwendigen</unclear> <unclear cert="medium" resp="#joint">erkhündigung</unclear>
