    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1995_7433.jpg" n="1"/>
<lb n="1"/>Unser fründtlich willig dienst sampt was wir
<lb n="2"/>eeren liebs unnd guetes vermögend <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">vor</unclear>. <unclear cert="low" resp="#joint">From</unclear>, fürsichtig,
<lb n="3"/>ersam, wÿß, insonders guet fründ unnd getrüw lieb
<lb n="4"/>eidtgnossen. Wir haben <unclear cert="low" resp="#joint">üwer</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">antwortschrÿben</unclear>, unnd <unclear cert="low" resp="#joint">wolmeinenden</unclear> <unclear cert="low" resp="#joint">fürschlag</unclear> <unclear cert="low" resp="#joint">unsers</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">bÿsässen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">M</unclear>. <unclear cert="low" resp="#joint">Hansen</unclear> <unclear cert="low" resp="#joint">Täubelius</unclear></persName> <unclear cert="low" resp="#joint">sel</unclear>. <unclear cert="low" resp="#joint">verkaufften</unclear> <unclear cert="low" resp="#joint">üwern</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">burgern</unclear> <unclear cert="low" resp="#joint">ußstendts</unclear> <unclear cert="low" resp="#joint">erbfaal</unclear> <unclear cert="low" resp="#joint">belangende</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">sondern</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">eidtgnössischem</unclear> gefallen <unclear cert="low" resp="#joint">verstanden</unclear>, <unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">wir</unclear> üch hiemit
<lb n="9"/>fründtlich bedannckendt. Unnd hättendt ouch nit ermanglet,
<lb n="10"/>inn annemmung desselben, <unclear cert="low" resp="#joint">wovern</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">erfinden</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">chönnen</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">söllich</unclear> <unclear cert="low" resp="#joint">mittel</unclear> <unclear cert="low" resp="#joint">one</unclear> <unclear cert="low" resp="#joint">mercklichen</unclear> <unclear cert="low" resp="#joint">schad</unclear>-
<lb n="12"/>unnd verluest zue dem sÿnen chommen möchte, <unclear cert="low" resp="#joint">zuevernügen</unclear>.
<lb n="13"/><unclear cert="low" resp="#joint">Wann</unclear> aber hingägen unns rhatsam sÿn bedunckt hr.
<lb n="14"/>üch <unclear cert="low" resp="#joint">belieben</unclear> <unclear cert="low" resp="#joint">liesendt</unclear> <unclear cert="low" resp="#joint">zueverschaffen</unclear> das er umb einen
<lb n="15"/>theil sÿnes erbfaals also baar, umb den übrigen aber,
<lb n="16"/>mit gueter gwüsser handtschrifft in üwer Statt
<lb n="17"/>oder <unclear cert="low" resp="#joint">landtschafft</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">sich</unclear> in kurtzem ablößte, versichert
<lb n="18"/>wurde so wärn hiemit an <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unnser</unclear> fründt: unnd
<lb n="19"/><unclear cert="low" resp="#joint">eidtgnössisch</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear> ir unns <unclear cert="low" resp="#joint">zuegfallen</unclear>, üch hierinn
<lb n="20"/>dem unseren dahin das dem also volg beschähen
<lb n="21"/>möchte wÿl es <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">brueders</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">unlangbaren</unclear> <unclear cert="low" resp="#joint">er</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">faal</unclear>, günstig <unclear cert="low" resp="#joint">ergäben</unclear> <unclear cert="low" resp="#joint">thätend</unclear>. <unclear cert="low" resp="#joint">Wöllend</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">fählen</unclear> mit aller <unclear cert="low" resp="#joint">hievor</unclear> <unclear cert="low" resp="#joint">anerbottenn</unclear> eidt-
<lb n="24"/><unclear cert="low" resp="#joint">gnossischer</unclear> <unclear cert="low" resp="#joint">correspondenz</unclear> <unclear cert="low" resp="#joint">nachmal</unclear> <unclear cert="low" resp="#joint">zueverglychen</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">wissend</unclear> damit üch in <unclear cert="low" resp="#joint">söllich</unclear> <unclear cert="low" resp="#joint">vaellen</unclear> <unclear cert="low" resp="#joint">fründtlichen</unclear> will-
<lb n="26"/><unclear cert="low" resp="#joint">faren</unclear>.
<pb facs="StadtASG_Missive_1995_7434.jpg" n="2"/>
<lb n="27"/><unclear cert="low" resp="#joint">Willfarung</unclear> <unclear cert="low" resp="#joint">Goetlicher</unclear> <unclear cert="low" resp="#joint">protection</unclear> <unclear cert="low" resp="#joint">wolbevolchen</unclear> <unclear cert="low" resp="#joint">haben</unclear>.
<lb n="28"/><unclear cert="low" resp="#joint">Datum</unclear> den. <origDate when="1616-05-26" resp="#ner"><unclear cert="low" resp="#joint">26</unclear>. <unclear cert="low" resp="#joint">Maij</unclear>. <unclear cert="low" resp="#joint">1616</unclear></origDate>.
<lb n="29"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Schultheiß</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Rhat</unclear>
<lb n="30"/>der Statt <unclear cert="low" resp="#joint">Lucern</unclear></orgName>.
<pb facs="StadtASG_Missive_1995_7435.jpg" n="3"/>
<pb facs="StadtASG_Missive_1995_7436.jpg" n="4"/>
<lb n="31"/>Den fromen fuersichtigen ersamen weysen
<lb n="32"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd rhat der stadt Sanct
<lb n="33"/>Gallen</orgName> unsern insonders guten fründen und
<lb n="34"/>gethrewen lieben eidtgnosen.
</p>
