<lb n="3"/>weiser, insonders lieber herr landtvogt und <unclear cert="medium" resp="#joint">gueter</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">freünd</unclear>.
<lb n="5"/>Wir <unclear cert="low" resp="#joint">überschickhend</unclear> <unclear cert="low" resp="#joint">hiebey</unclear> <unclear cert="low" resp="#joint">eüch</unclear> den <unclear cert="medium" resp="#joint">gan</unclear>-
