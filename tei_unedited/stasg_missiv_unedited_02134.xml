<lb n="95"/><unclear cert="low" resp="#joint">khuend</unclear>, <unclear cert="low" resp="#joint">seigen</unclear> wir an statt der
<lb n="96"/>unsern <unclear cert="medium" resp="#joint">erbuetig</unclear>, <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">iedezeit</unclear>
<lb n="97"/><unclear cert="medium" resp="#joint">ungefpart</unclear> willig und geneigt <unclear cert="low" resp="#joint">finden</unclear>
<lb n="98"/><unclear cert="low" resp="#joint">zelassen</unclear>, mit hilff deß allerhoechsten
<lb n="99"/>den wir <unclear cert="medium" resp="#joint">bitten</unclear>, daß er uns <unclear cert="low" resp="#joint">sampt</unclear>-
<lb n="100"/>lich in bestendiger wohlfart, lange
<lb n="101"/>zeit <unclear cert="low" resp="#joint">woelle</unclear> erhalten. Datum den
<lb n="102"/><origDate when="1619" resp="#ner"><unclear cert="low" resp="#joint">17</unclear> <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">Junii</unclear> Ao 1619</origDate>.
<lb n="103"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und <unclear cert="low" resp="#joint">rhat</unclear>
<lb n="104"/>der statt <unclear cert="medium" resp="#joint">Sannct</unclear> Gallen</orgName>.
<lb n="105"/>Den hochgeachten, edlen, gestrengen, fromen, vesten,
<lb n="106"/>ehren, und <unclear cert="low" resp="#joint">nothvesten</unclear>, <unclear cert="low" resp="#joint">fuernehmen</unclear>, fuersichtigen,
<lb n="107"/>ehrsamen und weisen, <orgName ref="stadtasg-actors-750" cert="medium" role="recipient" resp="#ner">der dreyzehen Orthen <unclear cert="low" resp="#joint">gemeiner</unclear>
<lb n="108"/>loblicher Eydtgnoschafft</orgName>, <unclear cert="low" resp="#joint">fuertreffenliche</unclear> <unclear cert="low" resp="#joint">rhatsbotten</unclear>
<lb n="109"/>diser zeit uf dem tag der jahrrechnung <unclear cert="low" resp="#joint">ze</unclear> <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> im
<lb n="110"/><placeName ref="stadtasg-places-266" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Argoeuw</unclear></placeName> <unclear cert="low" resp="#joint">beyeinandern</unclear> <unclear cert="low" resp="#joint">versambt</unclear>, <unclear cert="low" resp="#joint">unsern</unclear> insonders guen-
