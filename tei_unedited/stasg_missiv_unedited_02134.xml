<p>
<pb facs="StadtASG_Missive_2134_7995.jpg" n="1"/>
<lb n="1"/>Gestrenge edle, ehrenveste, fromme,
<lb n="2"/>veste, <unclear cert="low" resp="#joint">ehrn</unclear>, und <unclear cert="low" resp="#joint">nottveste</unclear>, <unclear cert="low" resp="#joint">fuerneme</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">fuersichtige</unclear>, <unclear cert="low" resp="#joint">ehrsame</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">weiße</unclear>, In-
<lb n="4"/>sonders guenstige hochgeehrte herren,
<lb n="5"/>wohlvertrauwte guote freundt,
<lb n="6"/>und getreuwe liebe <orgName role="recipient" resp="#ner">Eidtgnoßen</orgName>,
<lb n="7"/><unclear cert="low" resp="#joint">derselb</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> und <unclear cert="medium" resp="#joint">iederß</unclear> <unclear cert="medium" resp="#joint">seigen</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">freundtliche</unclear> <unclear cert="medium" resp="#joint">willige</unclear> dienst,
<lb n="9"/>aidgnoßische treuw und freundt-
<lb n="10"/>schafft, und was wir mehr ehren
<lb n="11"/>liebs und guots vermoegen,
<lb n="12"/>mit <unclear cert="low" resp="#joint">ungespartem</unclear> <unclear cert="low" resp="#joint">vleiß</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">zuvor</unclear>.
<lb n="14"/><unclear cert="low" resp="#joint">Wessen</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">verburgerte</unclear>,
<lb n="15"/><unclear cert="low" resp="#joint">kauff</unclear> und <unclear cert="medium" resp="#joint">handelßleuth</unclear>, so in
<lb n="16"/><placeName ref="stadtasg-places-91" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">oestereichische</unclear> <unclear cert="medium" resp="#joint">landt</unclear></placeName> <unclear cert="medium" resp="#joint">handtieren</unclear>,
<lb n="17"/>schwaerlichen <unclear cert="medium" resp="#joint">anligens</unclear> der <unclear cert="low" resp="#joint">neuwen</unclear>
<lb n="18"/>ufflagen und <unclear cert="low" resp="#joint">zolls</unclear> <unclear cert="low" resp="#joint">staigerungen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">underschidlichen</unclear> <unclear cert="low" resp="#joint">zollstetten</unclear>,
<lb n="20"/><unclear cert="low" resp="#joint">vor</unclear> und wider die <unclear cert="low" resp="#joint">habeningkh</unclear>
<lb n="21"/>und <unclear cert="low" resp="#joint">vieler</unclear> <unclear cert="low" resp="#joint">stattlich</unclear> <unclear cert="low" resp="#joint">ansehenlicher</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">ertheilter</unclear> Intercessionen, an uns
<lb n="23"/><unclear cert="medium" resp="#joint">abermahls</unclear> <unclear cert="medium" resp="#joint">undehnig</unclear> und <unclear cert="medium" resp="#joint">weh</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">muethig</unclear> <unclear cert="medium" resp="#joint">supplicando</unclear> <unclear cert="medium" resp="#joint">gelangen</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">laßen</unclear>, daß haben <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Gstreng</unclear>.
<lb n="26"/><unclear cert="medium" resp="#joint">edl</unclear>. <unclear cert="medium" resp="#joint">Vst</unclear>. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. auß <unclear cert="medium" resp="#joint">beyver</unclear>-
<lb n="27"/><unclear cert="medium" resp="#joint">warter</unclear> von <unclear cert="low" resp="#joint">Ihnen</unclear> uns <unclear cert="medium" resp="#joint">derenthalb</unclear>
<lb n="28"/><unclear cert="medium" resp="#joint">uebergebener</unclear> supplicationschrifft
<lb n="29"/><unclear cert="medium" resp="#joint">guenstig</unclear> zuvernehmen.
<pb facs="StadtASG_Missive_2134_7996.jpg" n="2"/>
<lb n="30"/>Obnunwohl E. Gstreng. Vst. W.
<lb n="31"/>Gl. E. Wht. wir füer dißmahl
<lb n="32"/><unclear cert="low" resp="#joint">gern</unclear> <unclear cert="low" resp="#joint">verschont</unclear> hetten, so ha-
<lb n="33"/><unclear cert="low" resp="#joint">ben</unclear> wir aber den <unclear cert="low" resp="#joint">unsren</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">trungenlich</unclear> <unclear cert="low" resp="#joint">gebettne</unclear>
<lb n="35"/>intercession umb <unclear cert="low" resp="#joint">so</unclear> vil desto
<lb n="36"/>wenig <unclear cert="low" resp="#joint">verweigern</unclear> <unclear cert="low" resp="#joint">kuennen</unclear>,
<lb n="37"/>als <unclear cert="low" resp="#joint">vil</unclear> wir ihr eingefüerte
<lb n="38"/>umbstendtliche motiven, <unclear cert="low" resp="#joint">uber</unclear>
<lb n="39"/>die <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Erbainung</unclear> <unclear cert="low" resp="#joint">teglich</unclear> <unclear cert="low" resp="#joint">uffgesezte</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">bschwerden</unclear> und <unclear cert="low" resp="#joint">attentierte</unclear> <unclear cert="low" resp="#joint">zolls</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">steigerung</unclear>, <unclear cert="low" resp="#joint">sehr</unclear> <unclear cert="low" resp="#joint">hochbeschwerlich</unclear>
<lb n="42"/>und <unclear cert="low" resp="#joint">wichtig</unclear> <unclear cert="low" resp="#joint">befinden</unclear>.
<lb n="43"/><unclear cert="low" resp="#joint">Glangt</unclear> <unclear cert="low" resp="#joint">derwegen</unclear> an E. <unclear cert="low" resp="#joint">Gstreng</unclear>.
<lb n="44"/><unclear cert="low" resp="#joint">Vst</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">Gl</unclear>. E. <unclear cert="low" resp="#joint">Wht</unclear>. unser fründt-
<lb n="45"/>lich Eüdtgnössisches bitten und er-
<lb n="46"/>suochen, die wöllen dise, als <unclear cert="low" resp="#joint">obenmassen</unclear>
<lb n="47"/>ein gemeine deß <unclear cert="low" resp="#joint">vatterlandts</unclear>
<lb n="48"/>betreffende sach <unclear cert="low" resp="#joint">ihro</unclear> <unclear cert="low" resp="#joint">bey</unclear>-
<lb n="49"/><unclear cert="low" resp="#joint">wohnenden</unclear> hohen verstande nach
<lb n="50"/>vernünfftig erwegen, und <unclear cert="medium" resp="#joint">ihro</unclear> die-
<lb n="51"/>selbige <unclear cert="medium" resp="#joint">zuo</unclear> abschaffung und wider
<lb n="52"/>uffhebung dessen, so der <unclear cert="low" resp="#joint">Erbainung</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">zuwider</unclear> <unclear cert="low" resp="#joint">uffgesezt</unclear> worden
<lb n="54"/>ist, <unclear cert="low" resp="#joint">füer</unclear> dißmahl, mit <unclear cert="low" resp="#joint">nit</unclear>
<lb n="55"/>geringerem ernst angelegen <unclear cert="medium" resp="#joint">sin</unclear>
<lb n="56"/>lassen. Und <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">geehrten</unclear> <unclear cert="low" resp="#joint">Eüdtg</unclear>.
<lb n="57"/><unclear cert="low" resp="#joint">seige</unclear> <unclear cert="low" resp="#joint">vorfahren</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Gstreng</unclear>. <unclear cert="low" resp="#joint">Vst</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">Gl</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="58"/><unclear cert="low" resp="#joint">nun</unclear> etlichmahl, dise kummeren deß
<pb facs="StadtASG_Missive_2134_7997.jpg" n="3"/>
<lb n="59"/><unclear cert="low" resp="#joint">schens</unclear>, und beschwerden fürzekhomen,
<lb n="60"/>sich loblich und <unclear cert="low" resp="#joint">hochstarks</unclear> <unclear cert="low" resp="#joint">bemuoeht</unclear>, und
<lb n="61"/><unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">deßwegen</unclear>
<lb n="62"/><unclear cert="medium" resp="#joint">gemainer</unclear> <unclear cert="medium" resp="#joint">khauffleüthen</unclear> <unclear cert="medium" resp="#joint">abgeordneten</unclear>
<lb n="63"/>in seinem <unclear cert="low" resp="#joint">werben</unclear> mit <unclear cert="low" resp="#joint">hilff</unclear> <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">rhat</unclear> so <unclear cert="low" resp="#joint">guettig</unclear> und <unclear cert="medium" resp="#joint">guothertzig</unclear>
<lb n="65"/><unclear cert="medium" resp="#joint">begegeng</unclear> als <unclear cert="medium" resp="#joint">es</unclear> die notturfft und
<lb n="66"/><unclear cert="low" resp="#joint">wichtigkheit</unclear> der sach <unclear cert="low" resp="#joint">woll</unclear> er-
<lb n="67"/><unclear cert="low" resp="#joint">fordert</unclear>, E. <unclear cert="low" resp="#joint">Sthl</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">St</unclear>. E. W.
<lb n="68"/><unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">zethuon</unclear>, und <unclear cert="low" resp="#joint">hiezue</unclear> <unclear cert="low" resp="#joint">genuegsame</unclear>
<lb n="69"/><unclear cert="low" resp="#joint">wegwiß</unclear> <unclear cert="low" resp="#joint">haben</unclear>. damit <unclear cert="low" resp="#joint">durch</unclear>
<lb n="70"/><unclear cert="low" resp="#joint">vermog</unclear> der <unclear cert="low" resp="#joint">wollhergebrachten</unclear>
<lb n="71"/>und <unclear cert="low" resp="#joint">jungst</unclear> <unclear cert="low" resp="#joint">ernewerten</unclear> <unclear cert="low" resp="#joint">jaren</unclear> <unclear cert="low" resp="#joint">erbeinung</unclear> <unclear cert="low" resp="#joint">zwüschet</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">hochlöblichen</unclear>
<lb n="72"/><unclear cert="low" resp="#joint">hauß</unclear> <placeName ref="stadtasg-places-91" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Osterreich</unclear></placeName> und <unclear cert="medium" resp="#joint">gemainer</unclear> loblich
<lb n="73"/><orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidtgnoschafft</unclear></orgName>, widerumb uff
<lb n="74"/>ein <unclear cert="low" resp="#joint">gwiße</unclear> <unclear cert="low" resp="#joint">anzhall</unclear> jahr <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">streckhte</unclear>
<lb n="75"/><unclear cert="low" resp="#joint">zhollvergleichung</unclear>, daß hirinne
<lb n="76"/>kein <unclear cert="low" resp="#joint">fernere</unclear> <unclear cert="low" resp="#joint">neüwerung</unclear> oder
<lb n="77"/><unclear cert="low" resp="#joint">beschwernuß</unclear> <unclear cert="low" resp="#joint">fürgenomen</unclear> werden
<lb n="78"/>solle, so die in der <unclear cert="medium" resp="#joint">supplication</unclear>
<lb n="79"/><unclear cert="low" resp="#joint">angedeütete</unclear> gravamina, <unclear cert="medium" resp="#joint">uffge</unclear>-
<lb n="80"/>setzte zollbeschwerden, und <unclear cert="low" resp="#joint">neüwerung</unclear>
<lb n="81"/><unclear cert="low" resp="#joint">gentzlich</unclear> <unclear cert="medium" resp="#joint">abgestelt</unclear>, und hiemit E.
<lb n="82"/><unclear cert="low" resp="#joint">Sthl</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">St</unclear>. E. W. <unclear cert="low" resp="#joint">bevolch</unclear>-
<lb n="83"/><unclear cert="low" resp="#joint">ne</unclear> <unclear cert="low" resp="#joint">Burger</unclear> und <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">verwandten</unclear> <unclear cert="low" resp="#joint">ne</unclear> hinfüro <unclear cert="low" resp="#joint">ohnmolestiert</unclear> und
<lb n="84"/><unclear cert="low" resp="#joint">beruewiget</unclear> <unclear cert="low" resp="#joint">verbleiben</unclear> <unclear cert="low" resp="#joint">möchten</unclear>.
<lb n="85"/><unclear cert="low" resp="#joint">wan</unclear> <unclear cert="low" resp="#joint">wiruß</unclear> <unclear cert="low" resp="#joint">dis</unclear> ein <unclear cert="low" resp="#joint">werkh</unclear>,
<lb n="86"/><unclear cert="low" resp="#joint">so</unclear> zu <unclear cert="medium" resp="#joint">erhalttung</unclear> der <unclear cert="low" resp="#joint">erbeinung</unclear>,
<lb n="87"/>und <unclear cert="low" resp="#joint">befüedrung</unclear> der <unclear cert="medium" resp="#joint">commercien</unclear>
<lb n="88"/>in <unclear cert="medium" resp="#joint">gemainem</unclear> <unclear cert="medium" resp="#joint">vatterlandt</unclear>
<pb facs="StadtASG_Missive_2134_7998.jpg" n="4"/>
<lb n="89"/>(deren dann <unclear cert="low" resp="#joint">wenig</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">frische</unclear>
<lb n="90"/>und <unclear cert="low" resp="#joint">keines</unclear> <unclear cert="low" resp="#joint">brandts</unclear> <unclear cert="low" resp="#joint">versehen</unclear>, <unclear cert="low" resp="#joint">iehzo</unclear>-
<lb n="91"/><unclear cert="low" resp="#joint">mahlß</unclear>.) <unclear cert="low" resp="#joint">merckhlich</unclear> dienen <unclear cert="medium" resp="#joint">wurde</unclear>.
<lb n="92"/>Und <unclear cert="low" resp="#joint">worinnen</unclear> <unclear cert="low" resp="#joint">ggl</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">Eydtg</unclear>. <unclear cert="low" resp="#joint">St</unclear>.
<lb n="93"/><unclear cert="low" resp="#joint">Ad</unclear>. <unclear cert="low" resp="#joint">Fb</unclear>. E. <unclear cert="low" resp="#joint">Wt</unclear>. <unclear cert="low" resp="#joint">wir</unclear> solches <unclear cert="medium" resp="#joint">hinwi</unclear>-
