    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2219_8385.jpg" n="1"/>
<lb n="1"/>Den herren
<lb n="2"/><unclear cert="low" resp="#joint">Schwebbergeldt</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">zauber</unclear> <unclear cert="low" resp="#joint">ab</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">befelch</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">hr</unclear>: <unclear cert="low" resp="#joint">Reichs</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">schreibers</unclear> <unclear cert="low" resp="#joint">geschehen</unclear>.
<lb n="6"/>Unser freundtlich willig dienst
<lb n="7"/>undt was wir mehr ehren liebs
<lb n="8"/>und guets vermoegendt, zuvor,
<lb n="9"/>Edlen, Vesten, Frommen, Fuersichtig
<lb n="10"/>und Weisen, Insonders guette
<lb n="11"/>Freundt, und getreuwe liebe
<lb n="12"/><orgName resp="#ner">Eidtgnossen</orgName>.
<lb n="13"/>Es hat unß unser lieber getreuwer
<lb n="14"/>Burger <persName resp="#ner">Cunradt Reiner</persName> der
<lb n="15"/>Metzger gehorsamblich brichtet,
<lb n="16"/>wie <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">jetzt</unclear> <unclear cert="low" resp="#joint">etlich</unclear> <unclear cert="low" resp="#joint">jahr</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">und</unclear> noch, <unclear cert="low" resp="#joint">Inmassen</unclear> <unclear cert="low" resp="#joint">seine</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">geehrte</unclear> in Gott ruwende voralttern
<lb n="19"/>besonders aber sein <unclear cert="low" resp="#joint">vilgeliebter</unclear>
<lb n="20"/>her vatt unser getreuwer lieber
<lb n="21"/>Burgermaister <persName resp="#ner">Otmar Reiner</persName>
<lb n="22"/>seliger, in <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Wht</unclear>: <unclear cert="low" resp="#joint">Gnd</unclear>. <unclear cert="low" resp="#joint">fhr</unclear>: <unclear cert="low" resp="#joint">Fr</unclear>: <unclear cert="low" resp="#joint">Wht</unclear>:
<lb n="23"/><unclear cert="low" resp="#joint">Landtschafft</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Gebietten</unclear> mit
<lb n="24"/><unclear cert="low" resp="#joint">erkhauffung</unclear> <unclear cert="low" resp="#joint">veichs</unclear>, <unclear cert="low" resp="#joint">gehandlet</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">soe</unclear> <unclear cert="low" resp="#joint">einstheils</unclear> allhero in unser
<lb n="26"/>Statt <unclear cert="low" resp="#joint">getriben</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">vermetzget</unclear>,
<lb n="27"/><unclear cert="low" resp="#joint">andertheils</unclear> aber <unclear cert="low" resp="#joint">eegemeldten</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">unßern</unclear> <unclear cert="low" resp="#joint">getrüwen</unclear> <unclear cert="low" resp="#joint">Metzgern</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">und</unclear> in der <unclear cert="low" resp="#joint">Nachbarschafft</unclear> <unclear cert="low" resp="#joint">verkhaufft</unclear>.
<lb n="30"/><unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">seinermaßen</unclear> <unclear cert="low" resp="#joint">weitters</unclear> <unclear cert="low" resp="#joint">dan</unclear>
<lb n="31"/>den gebürenden zoll, und daß
<lb n="32"/>gewohnliche gleidt geldt nacher
<lb n="33"/>uff sein aigen khosten uß <unclear cert="low" resp="#joint">gebe</unclear>,
<lb n="34"/><unclear cert="low" resp="#joint">nichts</unclear> <unclear cert="low" resp="#joint">uffghaltten</unclear>, mit guettem
<lb n="35"/>willen <unclear cert="low" resp="#joint">erlegt</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">bezahlt</unclear> <unclear cert="low" resp="#joint">habe</unclear>.
<lb n="36"/><persName resp="#ner">Conradt Reinen</persName> Metzgern
<lb n="37"/>betre. <date resp="#ner">1620. 4 Julii</date>.
<pb facs="StadtASG_Missive_2219_8386.jpg" n="2"/>
<lb n="38"/><unclear cert="low" resp="#joint">Wan</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">jezt</unclear> <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">zeitt</unclear> <unclear cert="low" resp="#joint">hero</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">neuwerung</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">fuer</unclear>-
<lb n="40"/><unclear cert="low" resp="#joint">genomen</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">welle</unclear>, in <unclear cert="low" resp="#joint">deme</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">tractergeltt</unclear> (wie man
<lb n="42"/>es nenne) so <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">ihme</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">den</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">frembden</unclear> <unclear cert="low" resp="#joint">ußlendischen</unclear> <unclear cert="low" resp="#joint">rossen</unclear> <unclear cert="low" resp="#joint">welle</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">abgeforderet</unclear> werden. Welches
<lb n="45"/>aber ein solche neuwerung die
<lb n="46"/>nicht allein ihme, sonderen auch
<lb n="47"/>gemeiner unser burgerschafft
<lb n="48"/>zu nicht geringem nachtheil
<lb n="49"/>wurde gelangen. Uß hat
<lb n="50"/>uns an e. whl. und gl. l. whl.
<lb n="51"/>umb fuer-schrifft, deß inhatts,
<lb n="52"/>daß er mit neuwen ufflagen nicht
<lb n="53"/>beschwaert, sonder bij dem zol
<lb n="54"/>zoll und glaitgeltt wie von
<lb n="55"/>altemhero gelassen werden
<lb n="56"/>möchte, gantz underthanig gebetten.
<lb n="57"/>Wiewohl wir nun <unclear cert="low" resp="#joint">wussen</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">whl</unclear>. und gl. l. whl. jemanden
<lb n="59"/>gern mit <unclear cert="low" resp="#joint">neuwerungen</unclear> <unclear cert="low" resp="#joint">zube</unclear>-
<lb n="60"/><unclear cert="low" resp="#joint">schwaeren</unclear> <unclear cert="low" resp="#joint">insonderheit</unclear> aber <unclear cert="low" resp="#joint">dero</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">mit</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">vertrauwte</unclear> <unclear cert="low" resp="#joint">verbundtete</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidgnossen</unclear></orgName>
<lb n="63"/><unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">ouch</unclear> die unsern,
<lb n="64"/>nicht
<lb n="65"/>gemeint noch gesinnet sindt.
<lb n="66"/>So haben wir jedoch, dem unsern
<pb facs="StadtASG_Missive_2219_8387.jpg" n="3"/>
<lb n="67"/>solche <unclear cert="low" resp="#joint">begerte</unclear> <unclear cert="low" resp="#joint">Interceßion</unclear>, <unclear cert="low" resp="#joint">weil</unclear>
<lb n="68"/>er <unclear cert="low" resp="#joint">denn</unclear> <unclear cert="low" resp="#joint">wolbedienung</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">vertroestet</unclear>,
<lb n="69"/>nicht <unclear cert="low" resp="#joint">verwaigeren</unclear> <unclear cert="low" resp="#joint">koennen</unclear>.
<lb n="70"/><unclear cert="low" resp="#joint">Gelaungt</unclear> <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">halben</unclear> an E. We.
<lb n="71"/>und <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. unser freundt=
<lb n="72"/>lich und <unclear cert="low" resp="#joint">Eydtgnoeßischs</unclear> <unclear cert="low" resp="#joint">ersuochen</unclear> und <unclear cert="low" resp="#joint">bitten</unclear>,
<lb n="73"/><unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">woelle</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Wolffurt</unclear></placeName> <unclear cert="low" resp="#joint">und</unclear>
<lb n="74"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">ab</unclear>
<lb n="75"/><unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Wolfurt</unclear></placeName> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">entgelten</unclear>
<lb n="76"/><unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">wohl</unclear>
<lb n="77"/><unclear cert="low" resp="#joint">verbruendten</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">ihme</unclear>
<lb n="78"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">Neuwerung</unclear> <unclear cert="low" resp="#joint">ufflag</unclear>
<lb n="79"/><unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Truckhengelts</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">beschwaeren</unclear>,
<lb n="80"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Ihren</unclear> <unclear cert="low" resp="#joint">Beampten</unclear> <unclear cert="low" resp="#joint">ob=</unclear>
<lb n="81"/><unclear cert="low" resp="#joint">ufferlegen</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">bej</unclear> dem
<lb n="82"/>alten zoll und glaittgeltt
<lb n="83"/>ohne ersteigern, mit <unclear cert="low" resp="#joint">seiner</unclear>
<lb n="84"/><unclear cert="low" resp="#joint">alhißigen</unclear> <unclear cert="low" resp="#joint">wahren</unclear> <unclear cert="low" resp="#joint">furo</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">ob</unclear>
<lb n="85"/><unclear cert="low" resp="#joint">bißhero</unclear> <unclear cert="low" resp="#joint">ruehwigklich</unclear> <unclear cert="low" resp="#joint">paßieren</unclear> <unclear cert="low" resp="#joint">undt</unclear>
<lb n="86"/><unclear cert="low" resp="#joint">repaßieren</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, und
<lb n="87"/>sich <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">so=</unclear>
<lb n="88"/><unclear cert="low" resp="#joint">wolgemueth</unclear> <unclear cert="low" resp="#joint">erweisen</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="89"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">zum</unclear> <unclear cert="low" resp="#joint">besten</unclear>
<lb n="90"/><unclear cert="low" resp="#joint">mittgetheilten</unclear> <unclear cert="low" resp="#joint">fuorschrifft</unclear> <unclear cert="low" resp="#joint">vrucht=</unclear>
<lb n="91"/><unclear cert="low" resp="#joint">barlich</unclear> <unclear cert="low" resp="#joint">enoßen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">deren</unclear>
<lb n="92"/><unclear cert="low" resp="#joint">erfroeuwen</unclear> <unclear cert="low" resp="#joint">moege</unclear>. Wie
<lb n="93"/>nun <unclear cert="low" resp="#joint">hiran</unclear> nicht allein dem
<lb n="94"/>unsren: sonder auch uns und
<lb n="95"/>gemeiner unser burgerschafft
<lb n="96"/>ein sonder angenembs gefallens
<lb n="97"/>erwißen wirt. Also
<pb facs="StadtASG_Missive_2219_8388.jpg" n="4"/>
<lb n="98"/>unde umb E. Vest, F. W. E. L.
<lb n="99"/>wir uns solches hinwiderumb,
<lb n="100"/>uf alle zuetragende begebenheiten
<lb n="101"/>mit allem Eidtgnoszischem
<lb n="102"/>willen zubeschulden und zuverdien-
<lb n="103"/>nen willig und anerbietig, alß
<lb n="104"/>wir Gott bitten, daß er
<lb n="105"/>dieselbe in glueck-
<lb n="106"/>lichen erwuenschten wohlstandt
<lb n="107"/>furohin gnedigklichen wolle erhalten.
<lb n="108"/>Datum den <origDate when="1620-07-04" resp="#ner">4ten Julii anno 1620</origDate>.
<lb n="109"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und rath
<lb n="110"/>der statt Sant Gallen</orgName>.
<lb n="111"/><placeName ref="stadtasg-places-13" cert="medium" resp="#ner">Bernn</placeName>
<lb n="112"/>Denen edlen, vesten, fuersichtigen und
<lb n="113"/>weisen <orgName ref="stadtasg-actors-514" cert="medium" role="recipient" resp="#ner">schultheißen und rath der
<lb n="114"/>statt Bern</orgName>, unsern insonders
<lb n="115"/>guten freunden und getreuen
<lb n="116"/>lieben <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eidtgenoßen</orgName>.
</p>
        </body>
