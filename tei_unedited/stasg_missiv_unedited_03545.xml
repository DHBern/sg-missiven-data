<lb n="56"/>viell desto mehr verobligirt, so auch gantz bereitwillig ge-
<lb n="57"/><unclear cert="low" resp="#joint">neigt</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">uerbietig</unclear>, <unclear cert="low" resp="#joint">Dieselbe</unclear> <unclear cert="low" resp="#joint">darmit</unclear> <unclear cert="low" resp="#joint">gottes</unclear> <unclear cert="low" resp="#joint">schutz</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">schirmb</unclear> <unclear cert="low" resp="#joint">treulich</unclear> <unclear cert="low" resp="#joint">entpfehlende</unclear>. Datum, <origPlace ref="stadtasg-places-297" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Hanaw</unclear></origPlace> den
<lb n="59"/><origDate when="1643-02-25" resp="#ner">15/25 februarij a° 1643</origDate>.
