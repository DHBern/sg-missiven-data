<lb n="21"/><unclear cert="low" resp="#joint">verer</unclear> darin <unclear cert="low" resp="#joint">fürgeschriten</unclear>, <unclear cert="low" resp="#joint">fürdresam</unclear>, <unclear cert="low" resp="#joint">beholffen</unclear> und
