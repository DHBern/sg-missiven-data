<lb n="18"/><unclear cert="low" resp="#joint">innamen</unclear> wie <unclear cert="low" resp="#joint">obstat</unclear>, ernstlichen <unclear cert="low" resp="#joint">gepetten</unclear>, <unclear cert="medium" resp="#joint">wir</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">inen</unclear> und <unclear cert="low" resp="#joint">obgemelten</unclear> irem schwager, gegen üch, <unclear cert="low" resp="#joint">unnsern</unclear>
