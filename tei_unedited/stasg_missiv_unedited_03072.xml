<p>
<pb facs="StadtASG_Missive_3072_12089.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich willig dienst, sambt was wir ehren, liebs
<lb n="2"/>und guots <unclear cert="medium" resp="#joint">vermoegend</unclear> zuovor, <unclear cert="medium" resp="#joint">from</unclear>, fürsichtig, <unclear cert="medium" resp="#joint">ehrsam</unclear>, <unclear cert="medium" resp="#joint">wyß</unclear>,
<lb n="3"/>insonders <unclear cert="medium" resp="#joint">guot</unclear> fründt, und <unclear cert="medium" resp="#joint">getrüw</unclear> lieb <unclear cert="medium" resp="#joint">Eydtgnoßen</unclear>.
<lb n="4"/>Demnach von <unclear cert="medium" resp="#joint">dem</unclear> zuo <placeName ref="stadtasg-places-49" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Solothurn</unclear></placeName> <unclear cert="medium" resp="#joint">disere</unclear> tag <unclear cert="medium" resp="#joint">nüw-ankomnnen</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">frantzoesischen</unclear> <unclear cert="medium" resp="#joint">h</unclear>. <unclear cert="medium" resp="#joint">Ambassadoren</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Meliand</unclear></persName> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">allererst</unclear> ein schryben
<lb n="6"/><unclear cert="medium" resp="#joint">yngelangt</unclear>, <unclear cert="medium" resp="#joint">dardurch</unclear> er <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">syner</unclear> <unclear cert="medium" resp="#joint">ankunft</unclear> berichtet, <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">begerenn</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">dieselbig</unclear> <unclear cert="low" resp="#joint">übrigen</unclear> <unclear cert="low" resp="#joint">lobl</unclear>. <unclear cert="low" resp="#joint">Orthen</unclear> <unclear cert="low" resp="#joint">auch</unclear> zuo notificieren, <unclear cert="medium" resp="#joint">wolten</unclear> wir
<lb n="8"/>ein solches <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">grad</unclear> durch <unclear cert="medium" resp="#joint">einen</unclear> <unclear cert="medium" resp="#joint">copenlich</unclear>-
<lb n="9"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="medium" resp="#joint">ynschluß</unclear> <unclear cert="medium" resp="#joint">zethuon</unclear> nit <unclear cert="medium" resp="#joint">underlaßen</unclear>. <unclear cert="medium" resp="#joint">Bevelchend</unclear> <unclear cert="medium" resp="#joint">unß</unclear> damit
<lb n="10"/>sambtlichen dem <unclear cert="medium" resp="#joint">gnaedigisten</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> <unclear cert="medium" resp="#joint">Gottes</unclear> <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">Allerhoechsten</unclear>.
<lb n="11"/><unclear cert="medium" resp="#joint">Dat</unclear>. <origDate when="1635" resp="#ner">den <unclear cert="low" resp="#joint">25</unclear>. <unclear cert="low" resp="#joint">ten</unclear> Martii <unclear cert="medium" resp="#joint">a.o</unclear> 1635</origDate>.
<lb n="12"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear> und Rath
