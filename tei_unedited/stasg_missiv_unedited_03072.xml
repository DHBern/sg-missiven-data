<pb facs="StadtASG_Missive_3072_12091.jpg" n="3"/>
<lb n="14"/>Hoch und wolgeachte herren,
<lb n="15"/>Nach dem ich <unclear cert="low" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-49" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Solothurn</unclear></placeName> <unclear cert="low" resp="#joint">angelangt</unclear>, <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">volg</unclear> dem <unclear cert="medium" resp="#joint">bevelch</unclear> deß Aller=
<lb n="16"/><unclear cert="medium" resp="#joint">christenlichsten</unclear> Königs <unclear cert="medium" resp="#joint">meines</unclear> gnedigsten herren, <unclear cert="medium" resp="#joint">daselbsten</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">residieren</unclear>,
<lb n="17"/><unclear cert="medium" resp="#joint">als</unclear> ein <unclear cert="medium" resp="#joint">ordinarij</unclear> <unclear cert="medium" resp="#joint">Ambaßador</unclear> <unclear cert="medium" resp="#joint">bi</unclear> <unclear cert="medium" resp="#joint">den</unclear> herren <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoßen</unclear></orgName>, an stadt <unclear cert="medium" resp="#joint">wijl=</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">ens</unclear> herren <persName resp="#ner"><unclear cert="medium" resp="#joint">Vialars</unclear></persName>, <unclear cert="medium" resp="#joint">lobseliger</unclear> <unclear cert="medium" resp="#joint">gedechtnuß</unclear>, <unclear cert="medium" resp="#joint">welchen</unclear> Gott <unclear cert="medium" resp="#joint">gfallen</unclear> <unclear cert="medium" resp="#joint">zuo</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">Ihne</unclear> <unclear cert="medium" resp="#joint">z'brueffen</unclear>: So hab ich üch <unclear cert="medium" resp="#joint">deßen</unclear> hiemit <unclear cert="medium" resp="#joint">alsbalden</unclear> advisieren,
<lb n="20"/>und <unclear cert="low" resp="#joint">zuoglich</unclear> pitten <unclear cert="medium" resp="#joint">wöllen</unclear>, ein <unclear cert="medium" resp="#joint">söliches</unclear> den herren aller übrigen
<lb n="21"/><unclear cert="medium" resp="#joint">Orthen</unclear> auch <unclear cert="medium" resp="#joint">wüßenthaft</unclear> <unclear cert="medium" resp="#joint">ze</unclear> machen, damit <unclear cert="medium" resp="#joint">sij</unclear> gebürlich berichtet <unclear cert="medium" resp="#joint">sijgind</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">der</unclear> sorg, welche <unclear cert="medium" resp="#joint">Ihre</unclear> <unclear cert="medium" resp="#joint">Mayt</unclear>. <unclear cert="medium" resp="#joint">tragt</unclear> und <unclear cert="medium" resp="#joint">hat</unclear> für den <unclear cert="medium" resp="#joint">gantzen</unclear> <unclear cert="medium" resp="#joint">lijb</unclear> üwers
<lb n="23"/><orgName resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoßischen</unclear> <unclear cert="medium" resp="#joint">Regiments</unclear></orgName>, und daß ich <unclear cert="medium" resp="#joint">möge</unclear> sonderbar <unclear cert="medium" resp="#joint">bezügen</unclear> die
<lb n="24"/><unclear cert="medium" resp="#joint">begird</unclear> <unclear cert="medium" resp="#joint">ich</unclear> hab <unclear cert="low" resp="#joint">mijne</unclear> <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">geneigt</unclear> <unclear cert="low" resp="#joint">willige</unclear> <unclear cert="low" resp="#joint">dinst</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">contribuieren</unclear> in den
<lb n="25"/><unclear cert="medium" resp="#joint">bevelchen</unclear> <unclear cert="medium" resp="#joint">Ihrer</unclear> Aller christenlichsten <unclear cert="medium" resp="#joint">Mt</unclear>. <unclear cert="medium" resp="#joint">bij</unclear> den <unclear cert="medium" resp="#joint">anläßen</unclear> die sich
<lb n="26"/><unclear cert="medium" resp="#joint">praesentieren</unclear> werdend <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">üwerer</unclear> <unclear cert="medium" resp="#joint">allgemeinen</unclear> nutzbarkeit, <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">bittende</unclear>
<lb n="27"/>Hoch und wolgeachte herren, daß Er üch in <unclear cert="low" resp="#joint">sijnen</unclear> <unclear cert="low" resp="#joint">h</unclear>. <unclear cert="low" resp="#joint">schutz</unclear> und schirm
<lb n="28"/><unclear cert="low" resp="#joint">erhalte</unclear>.
<lb n="29"/><unclear cert="low" resp="#joint">Uß</unclear> <origPlace ref="stadtasg-places-49" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Solothurn</unclear></origPlace> <origDate when="1635" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">2.ten</unclear> <unclear cert="low" resp="#joint">Aprilis</unclear>. <unclear cert="low" resp="#joint">1635</unclear>.</origDate>
<lb n="30"/>Üwer <unclear cert="medium" resp="#joint">dinst</unclear> und <unclear cert="medium" resp="#joint">gantz</unclear> williger.
<lb n="31"/><persName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Meliand</unclear></persName>.
