    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2146_8043.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unßer</unclear> <unclear cert="medium" resp="#joint">freündt</unclear>- <unclear cert="medium" resp="#joint">nachbarliche</unclear> <unclear cert="medium" resp="#joint">willige</unclear> <unclear cert="medium" resp="#joint">dienste</unclear> zuvor,
<lb n="2"/><unclear cert="medium" resp="#joint">fuersichtige</unclear>, ersame, und <unclear cert="medium" resp="#joint">weiße</unclear>, besonders liebe,
<lb n="3"/>guete <unclear cert="medium" resp="#joint">freündt</unclear> und <unclear cert="low" resp="#joint">nachbarn</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Deroßelben</unclear> <unclear cert="low" resp="#joint">freündt</unclear>- <unclear cert="low" resp="#joint">nachbar</unclear>- und <unclear cert="low" resp="#joint">vertraülich</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">zuoschreiben</unclear>, <unclear cert="low" resp="#joint">haben</unclear> wir <unclear cert="medium" resp="#joint">wohl</unclear> <unclear cert="medium" resp="#joint">empfangen</unclear>, und
<lb n="6"/><unclear cert="medium" resp="#joint">darauß</unclear> verstanden, <unclear cert="low" resp="#joint">wasmaßen</unclear> dieselben auß
<lb n="7"/><unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">benachbarten</unclear> <unclear cert="low" resp="#joint">orthen</unclear> <unclear cert="low" resp="#joint">berichtet</unclear> worden, als <unclear cert="medium" resp="#joint">wan</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">6000</unclear>. <unclear cert="medium" resp="#joint">spannische</unclear> <unclear cert="medium" resp="#joint">soldaten</unclear> über den <unclear cert="low" resp="#joint">Gotthart</unclear> <unclear cert="low" resp="#joint">herauß</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">auf</unclear> <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Roschach</unclear></placeName>, und <unclear cert="medium" resp="#joint">da</unclear> <unclear cert="medium" resp="#joint">dannen</unclear> <unclear cert="medium" resp="#joint">hinueber</unclear> <unclear cert="medium" resp="#joint">ubwerg</unclear>
<lb n="10"/><placeName resp="#ner"><unclear cert="medium" resp="#joint">Arleberg</unclear></placeName> oder <placeName resp="#ner"><unclear cert="medium" resp="#joint">Roschen</unclear></placeName> <unclear cert="medium" resp="#joint">marchiren</unclear>, und <unclear cert="medium" resp="#joint">deßwegen</unclear>
<lb n="11"/>die <unclear cert="low" resp="#joint">oesterreichische</unclear> <unclear cert="low" resp="#joint">voegt</unclear> <unclear cert="low" resp="#joint">baeder</unclear> <unclear cert="low" resp="#joint">arlebergisch</unclear>-
<lb n="12"/><unclear cert="low" resp="#joint">herrschafften</unclear> <unclear cert="low" resp="#joint">erst</unclear> <unclear cert="low" resp="#joint">heüt</unclear> zusammen kommen <unclear cert="medium" resp="#joint">solten</unclear>.
<lb n="13"/>In <unclear cert="low" resp="#joint">freündt</unclear>- <unclear cert="low" resp="#joint">nachbarlicher</unclear> <unclear cert="low" resp="#joint">widerantwurt</unclear>, <unclear cert="low" resp="#joint">thuend</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. wir uns <unclear cert="low" resp="#joint">zuvorderst</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">abermahl</unclear>-
<lb n="15"/><unclear cert="low" resp="#joint">freündt</unclear>-
<lb n="16"/><unclear cert="low" resp="#joint">lichen</unclear> communication und <unclear cert="medium" resp="#joint">wohlmeinenden</unclear> <unclear cert="medium" resp="#joint">berichts</unclear>,
<lb n="17"/><unclear cert="medium" resp="#joint">ganz</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear> und <unclear cert="medium" resp="#joint">hochlich</unclear> <unclear cert="medium" resp="#joint">bedancken</unclear>, und <unclear cert="low" resp="#joint">fürauf</unclear>
<lb n="18"/>nicht <unclear cert="low" resp="#joint">pergen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> wir <unclear cert="low" resp="#joint">dieß</unclear> <unclear cert="low" resp="#joint">angedeüteten</unclear> <unclear cert="low" resp="#joint">durchzugs</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">halber</unclear>, <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">nichts</unclear> <unclear cert="low" resp="#joint">gründtliches</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">erfahrung</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">bringen</unclear> <unclear cert="low" resp="#joint">koennen</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">wollen</unclear> aber nicht <unclear cert="medium" resp="#joint">under</unclear>-
<lb n="21"/><unclear cert="medium" resp="#joint">laßen</unclear>, so <unclear cert="medium" resp="#joint">baldt</unclear> <unclear cert="medium" resp="#joint">uns</unclear> deßwegen und anders <unclear cert="medium" resp="#joint">halber</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">gewißes</unclear> <unclear cert="medium" resp="#joint">solte</unclear> <unclear cert="medium" resp="#joint">zuokommen</unclear>, <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. <unclear cert="medium" resp="#joint">deßen</unclear>
<lb n="23"/><unclear cert="medium" resp="#joint">alßbaldt</unclear> und ohnverzuglich <unclear cert="medium" resp="#joint">zuberichten</unclear>, <unclear cert="medium" resp="#joint">zu</unclear> dem
<lb n="24"/><unclear cert="low" resp="#joint">endt</unclear>, wir <unclear cert="medium" resp="#joint">dero</unclear> <unclear cert="medium" resp="#joint">denzelt</unclear> <unclear cert="medium" resp="#joint">disen</unclear> <unclear cert="medium" resp="#joint">beyligenden</unclear> <unclear cert="medium" resp="#joint">extract</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">eines</unclear> an <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">mitburger</unclear> <unclear cert="low" resp="#joint">einen</unclear>, <unclear cert="low" resp="#joint">abgangnen</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">schreibens</unclear>, <unclear cert="low" resp="#joint">ubersenden</unclear>, und <unclear cert="low" resp="#joint">dieselbe</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">freündt</unclear>-
<lb n="27"/>nachbarlich bitten <unclear cert="medium" resp="#joint">woellen</unclear>, in <unclear cert="medium" resp="#joint">solcher</unclear> guet <unclear cert="medium" resp="#joint">vertraüw</unclear>-
<lb n="28"/><unclear cert="medium" resp="#joint">lichen</unclear> correspondenz gegen uns <unclear cert="low" resp="#joint">weiters</unclear> <unclear cert="low" resp="#joint">zuverfahren</unclear>.
<pb facs="StadtASG_Missive_2146_8044.jpg" n="2"/>
<lb n="29"/>und was sich in und siethär deßwegen ferners
<lb n="30"/>fuerlauffen moechte, unbeschwaert z'avisiere,
<lb n="31"/>auch hingegen sich gegen uns eüch gantz
<lb n="32"/>und aller vertraulichen auffrichtigen
<lb n="33"/>nachbarschafft versehn. Gott
<lb n="34"/>den herren bittende, daß er uns
<lb n="35"/>samtlich vor aller gefahrlichkeith
<lb n="36"/>noch lange bewahren und in gutem
<lb n="37"/>fried und wohlstande erhalten wolle.
<lb n="38"/>Datum den <origDate when="1619-09-12" resp="#ner">12. septembris 1619</origDate>.
<lb n="39"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und rhate
<lb n="40"/>der statt St. Gallen</orgName>.
<lb n="41"/>An die von <orgName role="recipient" resp="#ner">Lindauw</orgName>.
</p>
