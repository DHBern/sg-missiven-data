<lb n="41"/>aÿdigt, und demnach uf der cla=
<lb n="42"/>genden mundtliches fürbringen,
<lb n="43"/>verhört worden, als volgt.
<lb n="44"/>Elisabeth Schoblerin, weilund
<lb n="45"/><persName resp="#ner">Johann Schmitzs</persName> seeligen wittib, de=
<lb n="46"/>ponirt <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">erstatten</unclear> <unclear cert="low" resp="#joint">aÿd</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">er=</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">schinen</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">Laetare</unclear></date> <unclear cert="low" resp="#joint">seÿen</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">fast</unclear>, <unclear cert="low" resp="#joint">dz</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">hoc</unclear> 25 jahr gewesen, das <unclear cert="low" resp="#joint">sÿe</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">Irem</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Schmitzen</unclear></persName> <unclear cert="low" resp="#joint">seeligen</unclear>
