<lb n="51"/>vor aine wittfraw gewesen, und
<lb n="52"/>hab <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">beÿ</unclear> <unclear cert="low" resp="#joint">lebzeiten</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">Ires</unclear> <unclear cert="low" resp="#joint">ersten</unclear> <unclear cert="low" resp="#joint">ehewürts</unclear> <unclear cert="low" resp="#joint">verlofen</unclear>,
<lb n="54"/>was sÿe iezo außagen wöll, ob
<lb n="55"/>es aber in dem ersten oder an=
<lb n="56"/>deren jahr, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">absterben</unclear> <unclear cert="low" resp="#joint">Ires</unclear> <unclear cert="low" resp="#joint">ersten</unclear>
<lb n="57"/><unclear cert="low" resp="#joint">ehewürts</unclear> beschehen, mög sÿe nit
<lb n="58"/>wüßen, allainig main sÿe zeü=
<lb n="59"/>gin werd beÿ 28. oder 29. jahren
<lb n="60"/>sein, das herr burgermaister v.
<pb facs="StadtASG_Missive_2115_7925.jpg" n="3"/>
<lb n="61"/>Kallen seeligen ehefraw, Marga-
<lb n="62"/>retha Schoblerin zu <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">S: Gallen</placeName> bey
<lb n="63"/>ihren zeugin in irem und ires erst
<lb n="64"/>ehwürts seeligen behausung in
<lb n="65"/>einer chur gelegen, selcher zeiten
<lb n="66"/>hab herren berlegt <persName resp="#ner">Michael <unclear cert="low" resp="#joint">Schoblers</unclear></persName>
<lb n="67"/><unclear cert="low" resp="#joint">seel</unclear>: <unclear cert="low" resp="#joint">mueter</unclear> die <unclear cert="low" resp="#joint">alt</unclear> <unclear cert="low" resp="#joint">fr</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Kallin</unclear></persName>
<lb n="68"/>etlich mahl heimbgesuecht, und
<lb n="69"/><unclear cert="low" resp="#joint">anderem</unclear> <unclear cert="low" resp="#joint">einsmahls</unclear>, als sye
<lb n="70"/>dieselbig besuecht, hab <unclear cert="low" resp="#joint">bemelte</unclear>
<lb n="71"/><unclear cert="low" resp="#joint">Kallin</unclear>, <unclear cert="low" resp="#joint">das</unclear> ist fr. <persName resp="#ner">Margaretha
<lb n="72"/>Schoblerin</persName>, zue ihro fr. <persName resp="#ner">Eli-
<lb n="73"/>sabeth Schoblerin</persName>, geborner
<lb n="74"/><persName resp="#ner">Schlumpfin</persName>, berlegt herr
<lb n="75"/>Michael Schoblers mueter, ge-
<lb n="76"/><unclear cert="low" resp="#joint">sagt</unclear>, <unclear cert="low" resp="#joint">Baß</unclear> <persName resp="#ner">Elisabeth</persName>, du bist mir
<lb n="77"/>auch noch schuldig, wan gibst
<lb n="78"/>es <unclear cert="low" resp="#joint">mir</unclear>, <unclear cert="low" resp="#joint">darauf</unclear> hab bemelts
<lb n="79"/>herr Michel Schoblers mueter
<lb n="80"/>geandtwort, botz schimpf,
<lb n="81"/>bin dir nichts schuldig, warumb
<lb n="82"/>hast es nit gefordert, weilen
<lb n="83"/>mein <persName resp="#ner">Schobler</persName> <unclear cert="low" resp="#joint">gelebt</unclear>.
<lb n="84"/><unclear cert="low" resp="#joint">Endet</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">damit</unclear> ir <unclear cert="low" resp="#joint">zeugin</unclear> <unclear cert="low" resp="#joint">außag</unclear>,
