<lb n="15"/><unclear cert="low" resp="#joint">dor</unclear>, wann <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">mund</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">mehreren</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear>, ein <unclear cert="medium" resp="#joint">beßere</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">meinung</unclear> <unclear cert="medium" resp="#joint">faßen</unclear> werde, Es <unclear cert="medium" resp="#joint">hat</unclear> aber auch <unclear cert="medium" resp="#joint">Ihr</unclear> <unclear cert="medium" resp="#joint">mundtliches</unclear> <unclear cert="medium" resp="#joint">fürbring</unclear>
