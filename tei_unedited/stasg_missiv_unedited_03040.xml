<p>
<pb facs="StadtASG_Missive_3040_11955.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> fründtlich willig dienst, sambt was wir ehren liebs und <unclear cert="medium" resp="#joint">guets</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">vermoegend</unclear>, <unclear cert="medium" resp="#joint">zuevor</unclear>. <unclear cert="medium" resp="#joint">From</unclear>, Fürsichtig, <unclear cert="medium" resp="#joint">Ersam</unclear> <unclear cert="medium" resp="#joint">Wyß</unclear>, besonders <unclear cert="medium" resp="#joint">guet</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">fründ</unclear>, und <unclear cert="medium" resp="#joint">getrüw</unclear> lieb <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoßen</unclear></orgName>.
<lb n="4"/><unclear cert="medium" resp="#joint">Was</unclear> <unclear cert="medium" resp="#joint">gestalten</unclear> der <unclear cert="low" resp="#joint">Frantzoes</unclear>. <unclear cert="low" resp="#joint">Ambaßador</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-49" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Solothurn</unclear></placeName> der <unclear cert="low" resp="#joint">Herr</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Vialar</unclear></persName>,
<lb n="5"/><unclear cert="low" resp="#joint">die</unclear> Inn <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">gesambten</unclear> <unclear cert="low" resp="#joint">Evangel</unclear>. <unclear cert="low" resp="#joint">Orten</unclear> und <unclear cert="low" resp="#joint">Zuegewandten</unclear> <unclear cert="low" resp="#joint">nammen</unclear>,
<lb n="6"/><unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Koen</unclear>. <unclear cert="low" resp="#joint">Mt</unclear>. <unclear cert="low" resp="#joint">diser</unclear> tagen abgefertigte <unclear cert="medium" resp="#joint">Gsantschafft</unclear>, welliche wir, <unclear cert="medium" resp="#joint">samt</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">ursachen</unclear>, demselben durch ein <unclear cert="medium" resp="#joint">fründt</unclear>- <unclear cert="medium" resp="#joint">beweglich</unclear>- <unclear cert="medium" resp="#joint">schryben</unclear> ein tag vor
<lb n="8"/>Ihrem <unclear cert="medium" resp="#joint">verreisen</unclear>, <unclear cert="medium" resp="#joint">notificiert</unclear>, und <unclear cert="low" resp="#joint">Ihne</unclear> <unclear cert="low" resp="#joint">darby</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">favor</unclear>- <unclear cert="low" resp="#joint">schryben</unclear>, <unclear cert="low" resp="#joint">ange=</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">sprochen</unclear>, <unclear cert="low" resp="#joint">ufnemmen</unclear> <unclear cert="low" resp="#joint">thuet</unclear>; <unclear cert="low" resp="#joint">Das</unclear> haben Ihr <unclear cert="low" resp="#joint">ußer</unclear> <unclear cert="low" resp="#joint">U</unclear>. <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">zue</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Bärn</unclear></placeName> und <unclear cert="low" resp="#joint">den</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">üwern</unclear> <unclear cert="low" resp="#joint">nachricht</unclear> <unclear cert="low" resp="#joint">us</unclear> <unclear cert="low" resp="#joint">copeylicher</unclear> <unclear cert="low" resp="#joint">bylag</unclear> <unclear cert="low" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">antwort</unclear> <unclear cert="low" resp="#joint">schrybens</unclear> <unclear cert="low" resp="#joint">zue=</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">vernemmen</unclear>, <unclear cert="low" resp="#joint">Unnd</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">glych</unclear> <unclear cert="low" resp="#joint">ohnbericht</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">wöllen</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">solich</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">schryben</unclear> <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">Abgesandten</unclear>, <unclear cert="low" resp="#joint">welliche</unclear> <unclear cert="low" resp="#joint">ußert</unclear> <unclear cert="low" resp="#joint">Bärn</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">fürrük</unclear> <unclear cert="low" resp="#joint">zehen</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-310" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Murten</unclear></placeName> <unclear cert="low" resp="#joint">angetroffen</unclear>, <unclear cert="low" resp="#joint">eroeffnet</unclear> worden. Sy aber <unclear cert="low" resp="#joint">Ihn</unclear> <unclear cert="low" resp="#joint">reiß</unclear> <unclear cert="low" resp="#joint">uf</unclear> <placeName ref="stadtasg-places-49" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sollo=</unclear>
