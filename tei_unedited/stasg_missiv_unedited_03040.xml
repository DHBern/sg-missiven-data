<lb n="18"/><unclear cert="medium" resp="#joint">schryben</unclear>, <unclear cert="medium" resp="#joint">hete</unclear> <unclear cert="medium" resp="#joint">begleiten</unclear> <unclear cert="medium" resp="#joint">wellen</unclear>: Doch syen sy <unclear cert="medium" resp="#joint">nüt</unclear> <unclear cert="medium" resp="#joint">desto</unclear> <unclear cert="medium" resp="#joint">weniger</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">consequenz</unclear> willen im <unclear cert="medium" resp="#joint">nammen</unclear> Gottes <unclear cert="medium" resp="#joint">fortgereiset</unclear>,
<lb n="20"/><unclear cert="medium" resp="#joint">Der</unclear> <unclear cert="medium" resp="#joint">welle</unclear> <unclear cert="medium" resp="#joint">denselben</unclear> ein <unclear cert="medium" resp="#joint">glükhaffte</unclear> <unclear cert="medium" resp="#joint">reiß</unclear> und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">verrichtung</unclear> <unclear cert="low" resp="#joint">verlyhen</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">Dato</unclear> <unclear cert="low" resp="#joint">den</unclear> <origDate when="1634-10-08" resp="#ner"><unclear cert="low" resp="#joint">20</unclear>. <unclear cert="low" resp="#joint">8</unclear>. Octobris 1634</origDate>
