<lb n="1"/><unclear cert="low" resp="#joint">Unßer</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear> willig dinst, sampt <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">wier</unclear> <unclear cert="low" resp="#joint">eeren</unclear>
