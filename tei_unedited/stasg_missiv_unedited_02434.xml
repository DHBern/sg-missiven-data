<lb n="28"/><unclear cert="low" resp="#joint">unnderthanigs</unclear> fleißes <unclear cert="low" resp="#joint">gepeten</unclear>. <unclear cert="low" resp="#joint">Welche</unclear> wir <unclear cert="low" resp="#joint">Ime</unclear>
