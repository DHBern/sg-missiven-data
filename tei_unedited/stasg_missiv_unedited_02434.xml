<lb n="3"/><unclear cert="low" resp="#joint">eersam</unclear> <unclear cert="low" resp="#joint">weyß</unclear> <unclear cert="medium" resp="#joint">innsonders</unclear> guot fründt unnd getrüw
<lb n="4"/>lieb <orgName role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnossen</unclear></orgName>.
<lb n="5"/>Wier haben <unclear cert="low" resp="#joint">gedignen</unclear> <unclear cert="low" resp="#joint">unßerem</unclear> burger, herren <persName resp="#ner">Caspar
<lb n="6"/><unclear cert="low" resp="#joint">Oßwalden</unclear></persName>, seinem begeren nach, wider seiner <unclear cert="medium" resp="#joint">hauß</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">frauwen</unclear> <unclear cert="low" resp="#joint">bruoder</unclear> unnd verschwagerte, ein <unclear cert="low" resp="#joint">gewüß</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">vermugt</unclear> <unclear cert="low" resp="#joint">testament</unclear>, vor <unclear cert="medium" resp="#joint">unß</unclear> einen rechtstag an-
<lb n="9"/><unclear cert="low" resp="#joint">gesezt</unclear> <unclear cert="low" resp="#joint">gehabt</unclear>. <unclear cert="low" resp="#joint">welchen</unclear> <unclear cert="medium" resp="#joint">aber</unclear> sy <unclear cert="low" resp="#joint">zubesuechen</unclear> <unclear cert="low" resp="#joint">genzlich</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">abgeschlagen</unclear> unnd daß er innen zu <placeName ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Bischoffzel</unclear></placeName> <unclear cert="low" resp="#joint">red</unclear> und
<lb n="11"/><unclear cert="low" resp="#joint">andtwurt</unclear> geben solle begert, unnd zu dem <unclear cert="low" resp="#joint">endt</unclear> <unclear cert="low" resp="#joint">hin</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">gedachter</unclear> seiner <unclear cert="low" resp="#joint">haußfrauwen</unclear> seligen <unclear cert="low" resp="#joint">zuermelten</unclear>
<lb n="13"/><placeName ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Bischoffzel</unclear></placeName> ligende <unclear cert="low" resp="#joint">verlaßenschafft</unclear>, in arrest <unclear cert="low" resp="#joint">zenemmen</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">verlauten</unclear> laßen, <unclear cert="low" resp="#joint">ja</unclear> <unclear cert="low" resp="#joint">unßerem</unclear> burger aber <unclear cert="medium" resp="#joint">innen</unclear> da-
<lb n="15"/>selbsten <unclear cert="low" resp="#joint">andtwurt</unclear> zegeben, <unclear cert="low" resp="#joint">umb</unclear> etwaß <unclear cert="low" resp="#joint">bedenckhlich</unclear>
<lb n="16"/>fallen wöllen. <unclear cert="low" resp="#joint">Wan</unclear> dan sein <unclear cert="low" resp="#joint">haußfrauw</unclear> selig in der
<lb n="17"/><placeName resp="#ner"><unclear cert="medium" resp="#joint">graffschafft</unclear> <unclear cert="low" resp="#joint">Thüngen</unclear></placeName> ein guot Kazenstaig genant
<lb n="18"/><unclear cert="medium" resp="#joint">gehabt</unclear>, <unclear cert="low" resp="#joint">welchs</unclear> er auch in <unclear cert="low" resp="#joint">haftumb</unclear> legen laßen <unclear cert="low" resp="#joint">wöllen</unclear>,
<lb n="19"/><unclear cert="low" resp="#joint">söllches</unclear> <unclear cert="low" resp="#joint">aber</unclear> wie er berichtet, <unclear cert="low" resp="#joint">euwerem</unclear> <unclear cert="low" resp="#joint">burgeren</unclear>
<lb n="20"/>einen, deßen nam <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">unerkhanndt</unclear>, <unclear cert="low" resp="#joint">zekauffen</unclear>
<lb n="21"/>geben worden sein solle. Damit nun er sein <unclear cert="low" resp="#joint">ufge</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">richte</unclear> testament <unclear cert="low" resp="#joint">verthriben</unclear> <unclear cert="medium" resp="#joint">möchte</unclear>, <unclear cert="low" resp="#joint">were</unclear> er <unclear cert="medium" resp="#joint">uf</unclear>
