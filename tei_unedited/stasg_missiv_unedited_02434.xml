<lb n="25"/><unclear cert="low" resp="#joint">zepiten</unclear> <unclear cert="medium" resp="#joint">bedacht</unclear>, auf daß nun er <unclear cert="low" resp="#joint">sölchen</unclear> <unclear cert="medium" resp="#joint">desto</unclear> <unclear cert="medium" resp="#joint">eher</unclear>
