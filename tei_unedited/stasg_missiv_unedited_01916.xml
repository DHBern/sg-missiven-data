<p>
<pb facs="StadtASG_Missive_1916_7135.jpg" n="1"/>
<lb n="1"/>Unser fründtlich willig dienst sampt was wir
<lb n="2"/>eeren liebs und guots vermögent <unclear cert="low" resp="#joint">zuvor</unclear>, from <unclear cert="medium" resp="#joint">fürsiech</unclear>-
<lb n="3"/><unclear cert="medium" resp="#joint">tig</unclear> ersam wyß <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">sunders</unclear> guot fründt und getrüw
<lb n="4"/>lieb <orgName ref="stadtasg-actors-750" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Eydgnoßen</unclear></orgName>. Wir habent üch <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">drüen</unclear> <unclear cert="medium" resp="#joint">tagen</unclear>
<lb n="5"/>unserer <unclear cert="low" resp="#joint">landtmanen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Fridlj</unclear> <unclear cert="low" resp="#joint">Taelis</unclear></persName> <unclear cert="low" resp="#joint">saeligen</unclear> <unclear cert="low" resp="#joint">kindts</unclear> <unclear cert="low" resp="#joint">lasen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">wirtwen</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">maelwercks</unclear> ein <unclear cert="low" resp="#joint">stilstandt</unclear>, <unclear cert="low" resp="#joint">wyl</unclear> <unclear cert="low" resp="#joint">domallen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">irer</unclear> <unclear cert="low" resp="#joint">vogt</unclear> nit <unclear cert="medium" resp="#joint">anheimsch</unclear>, fründtlich und <unclear cert="low" resp="#joint">Eydgnoßisch</unclear> <unclear cert="low" resp="#joint">zuoge</unclear>-
<lb n="8"/>schriben. Inn wölchem <unclear cert="low" resp="#joint">vermeldt</unclear> worden, so baldt der vogt
<lb n="9"/>widerumb zuo landt kome und er <unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">ire</unclear> <unclear cert="low" resp="#joint">waegen</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">zuoacuhsen</unclear> <unclear cert="low" resp="#joint">triben</unclear> <unclear cert="low" resp="#joint">wärde</unclear>, sy <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">saelbige</unclear> <unclear cert="low" resp="#joint">erschinen</unclear> <unclear cert="low" resp="#joint">sölen</unclear>.
<lb n="11"/>Und <unclear cert="medium" resp="#joint">sidiewill</unclear> gedachter <unclear cert="low" resp="#joint">frouwen</unclear> <unclear cert="low" resp="#joint">vogt</unclear> <unclear cert="low" resp="#joint">dismallen</unclear> <unclear cert="low" resp="#joint">anheimsch</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">uber</unclear> <unclear cert="low" resp="#joint">saechs</unclear> <unclear cert="low" resp="#joint">waegen</unclear> <unclear cert="low" resp="#joint">kernen</unclear> <unclear cert="low" resp="#joint">schicken</unclear>, <unclear cert="low" resp="#joint">wölecher</unclear> by <unclear cert="medium" resp="#joint">üch</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">uwer</unclear> getrüwen <unclear cert="low" resp="#joint">lieben</unclear> <orgName ref="stadtasg-actors-750" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Eydgnoßc</unclear></orgName> werden möcht <unclear cert="low" resp="#joint">tag</unclear> ine
<lb n="14"/>zuo komen und der <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">widersacuhg</unclear> der <unclear cert="low" resp="#joint">wirtwen</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">wüsenschafft</unclear> <unclear cert="low" resp="#joint">gmacht</unclear>, <unclear cert="low" resp="#joint">damitt</unclear> wir der <unclear cert="medium" resp="#joint">unseren</unclear> <unclear cert="medium" resp="#joint">begaeren</unclear>.
<lb n="16"/><unclear cert="medium" resp="#joint">Die</unclear> sach ein <unclear cert="medium" resp="#joint">endtschafft</unclear> <unclear cert="medium" resp="#joint">gewine</unclear>, so <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">halben</unclear> so <unclear cert="medium" resp="#joint">der</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">wirtwen</unclear> so <unclear cert="medium" resp="#joint">komenent</unclear> dem <unclear cert="low" resp="#joint">unseren</unclear> in die <unclear cert="medium" resp="#joint">lee</unclear> <unclear cert="medium" resp="#joint">im</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">taag</unclear> <unclear cert="medium" resp="#joint">zrechni</unclear> <unclear cert="medium" resp="#joint">etwar</unclear> <unclear cert="medium" resp="#joint">inreyte</unclear> oder <unclear cert="low" resp="#joint">komne</unclear> <unclear cert="low" resp="#joint">saelbigs</unclear>
<lb n="19"/>nit <unclear cert="medium" resp="#joint">erschieslich</unclear> <unclear cert="medium" resp="#joint">taeglich</unclear> <unclear cert="medium" resp="#joint">geinen</unclear> <unclear cert="medium" resp="#joint">fordereten</unclear> <unclear cert="medium" resp="#joint">lasen</unclear> <unclear cert="medium" resp="#joint">aenge</unclear>-
<lb n="20"/><unclear cert="medium" resp="#joint">laegene</unclear>, <unclear cert="medium" resp="#joint">mögent</unclear> sy die <unclear cert="low" resp="#joint">unseren</unclear> uff <unclear cert="low" resp="#joint">üweres</unclear> oder <unclear cert="low" resp="#joint">irer</unclear> guot-
<lb n="21"/>beduncken ein <unclear cert="low" resp="#joint">ernampten</unclear> tag <unclear cert="low" resp="#joint">ansetzen</unclear>, inen den-
<lb n="22"/><unclear cert="medium" resp="#joint">saellben</unclear> <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">kürtze</unclear> <unclear cert="medium" resp="#joint">wüsenschafft</unclear> machen, so <unclear cert="low" resp="#joint">waerdent</unclear>
<lb n="23"/>sy <unclear cert="low" resp="#joint">dan</unclear> wie unß nit <unclear cert="medium" resp="#joint">zwifelt</unclear> <unclear cert="medium" resp="#joint">ghsa</unclear> <unclear cert="medium" resp="#joint">erschinen</unclear>. Das hab-
<lb n="24"/>ent wir üch uff der <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">begaeren</unclear> der <unclear cert="low" resp="#joint">wirtwen</unclear> zuo
<lb n="25"/><unclear cert="medium" resp="#joint">nachrichtung</unclear> fründtlich und <unclear cert="low" resp="#joint">Eydgnoßisch</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">berichten</unclear> <unclear cert="low" resp="#joint">nit</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">underlasen</unclear> <unclear cert="low" resp="#joint">söllen</unclear>. <unclear cert="low" resp="#joint">Damitt</unclear> üch und <unclear cert="low" resp="#joint">unß</unclear> in <unclear cert="medium" resp="#joint">gottes</unclear> <unclear cert="medium" resp="#joint">schirmb</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">gnaden</unclear> <unclear cert="medium" resp="#joint">wolbeuälchende</unclear>. <unclear cert="medium" resp="#joint">Dattum</unclear> den <origDate when="1614" resp="#ner">4 tag octobris anno
<lb n="28"/>1614</origDate>
<lb n="29"/><orgName ref="stadtasg-actors-502" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Landtaman</unclear> und rath
<lb n="30"/>zuo <unclear cert="low" resp="#joint">Glaruß</unclear></orgName>.
<pb facs="StadtASG_Missive_1916_7136.jpg" n="2"/>
<lb n="31"/>[]
<pb facs="StadtASG_Missive_1916_7137.jpg" n="3"/>
<pb facs="StadtASG_Missive_1916_7138.jpg" n="4"/>
<lb n="32"/>Den fromen <unclear cert="medium" resp="#joint">fuersichtigen</unclear>
<lb n="33"/>ersamen und wysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="34"/>meister und Rhat der Statt Sant
<lb n="35"/>Gallen</orgName>. Unsern innsunders
<lb n="36"/><unclear cert="medium" resp="#joint">guoten</unclear> fründen und <unclear cert="low" resp="#joint">getrüwen</unclear>
<lb n="37"/>lieben <unclear cert="low" resp="#joint">Eydgnoßen</unclear>.
</p>
