<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">fraeündtlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear> <unclear cert="medium" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">Eersamen</unclear>,
<lb n="2"/>Fürsichtigen, <unclear cert="medium" resp="#joint">Eersamen</unclear> und <unclear cert="medium" resp="#joint">Weÿsen</unclear>, <unclear cert="medium" resp="#joint">Insonders</unclear>
<lb n="3"/>lieben und <unclear cert="medium" resp="#joint">guoten</unclear> <unclear cert="medium" resp="#joint">Fraeünde</unclear>.
<lb n="4"/><unclear cert="medium" resp="#joint">Es</unclear> <unclear cert="medium" resp="#joint">berichten</unclear> <unclear cert="medium" resp="#joint">u</unclear>. <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">unsere</unclear> burger und <unclear cert="low" resp="#joint">korn</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">kaeüffer</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">baertholomeconradt</unclear> <unclear cert="low" resp="#joint">Ziegler</unclear></persName>, <persName resp="#ner"><unclear cert="low" resp="#joint">Othmar</unclear> <unclear cert="low" resp="#joint">Schmaeltz</unclear></persName>, <persName resp="#ner"><unclear cert="low" resp="#joint">Con</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">radt</unclear> <unclear cert="low" resp="#joint">Ziegler</unclear></persName>, <persName resp="#ner"><unclear cert="low" resp="#joint">Lorentz</unclear> <unclear cert="low" resp="#joint">Vonwiler</unclear></persName>, und <persName resp="#ner">Heinrich <unclear cert="medium" resp="#joint">Loch</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">erinen</unclear></persName>, was <unclear cert="low" resp="#joint">massen</unclear> <unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. Statt
<lb n="8"/><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">disharohinnor</unclear> <unclear cert="low" resp="#joint">gewessten</unclear> <unclear cert="low" resp="#joint">Kaÿs</unclear>: <unclear cert="low" resp="#joint">Commissariis</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">abfuerung</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">irer</unclear> für das <unclear cert="low" resp="#joint">kaÿs</unclear>: in <unclear cert="low" resp="#joint">Puendten</unclear> <unclear cert="low" resp="#joint">ligende</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">kriegsvolckh</unclear> <unclear cert="low" resp="#joint">eingen</unclear> <unclear cert="low" resp="#joint">kaufften</unclear> <unclear cert="low" resp="#joint">fruedten</unclear>, <unclear cert="low" resp="#joint">deren</unclear> 94. an der <unclear cert="low" resp="#joint">zahl</unclear> <unclear cert="low" resp="#joint">gewesen</unclear>, <unclear cert="low" resp="#joint">etliche</unclear> <unclear cert="low" resp="#joint">Ross</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">hergeben</unclear> <unclear cert="low" resp="#joint">herleÿhen</unclear> <unclear cert="low" resp="#joint">muessen</unclear>, <unclear cert="low" resp="#joint">welche</unclear> ihnen <unclear cert="low" resp="#joint">uff</unclear> die <unclear cert="low" resp="#joint">ersten</unclear> <unclear cert="low" resp="#joint">fuos</unclear>
<lb n="12"/>widerumb <unclear cert="low" resp="#joint">ze</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Luez</unclear></placeName> <unclear cert="low" resp="#joint">Zubringen</unclear> versprochen <unclear cert="low" resp="#joint">worden</unclear>
