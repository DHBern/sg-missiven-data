<lb n="24"/><unclear cert="medium" resp="#joint">kaeüffern</unclear> (<unclear cert="medium" resp="#joint">nach</unclear> <unclear cert="medium" resp="#joint">usgendecheit</unclear> <unclear cert="medium" resp="#joint">vermittlest</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">interposition</unclear> <unclear cert="medium" resp="#joint">ihrer</unclear> <unclear cert="medium" resp="#joint">ansehenlichen</unclear> reputation, die
<lb n="26"/><unclear cert="medium" resp="#joint">beste</unclear> <unclear cert="medium" resp="#joint">mittel</unclear> <unclear cert="medium" resp="#joint">zuzeigen</unclear> <unclear cert="medium" resp="#joint">wisen</unclear>, <unclear cert="medium" resp="#joint">dardurch</unclear> sie <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">er</unclear>-
<lb n="27"/><unclear cert="medium" resp="#joint">emelten</unclear> <unclear cert="medium" resp="#joint">ihren</unclear> <unclear cert="medium" resp="#joint">anzahl</unclear> <unclear cert="medium" resp="#joint">hergegebnen</unclear> <unclear cert="medium" resp="#joint">Rossen</unclear> wider
<lb n="28"/><unclear cert="medium" resp="#joint">gelangen</unclear> <unclear cert="medium" resp="#joint">koenen</unclear> <unclear cert="medium" resp="#joint">moechten</unclear>; <unclear cert="medium" resp="#joint">Alß</unclear> <unclear cert="medium" resp="#joint">ersuochen</unclear>
<pb facs="StadtASG_Missive_2762_10776.jpg" n="2"/>
<lb n="29"/>denselben thuen wir hiemit frundtlichs,
<lb n="30"/>sie wellen iha ihnen weyteren kauffschlahen des korns,
<lb n="31"/>soviel mueglich uff wegen hierzuo verhilfflichen seyn, gsuchen lassen wird,
<lb n="32"/>daß geendt
<lb n="33"/>umb E. E. R. wrd. wir frundtlich
<lb n="34"/>hinwider mit aller wollbeliebiger diensterweisung
<lb n="35"/>(damit wir ihnen ohne dz wol beygethan
<lb n="36"/>verbleiben) ferners zuobeschulden erbieting zuemahl
<lb n="37"/>uns Gottes gnaden schirm befehlende, datt
<lb n="38"/><date resp="#ner">den 30.ten Junii 1629.</date>
<lb n="39"/>Der hoffnung, es werde
<lb n="40"/>derselben von ihrn gn.
<lb n="41"/>Erzh. Commissariis albereit zuogeschriben sein.
<lb n="42"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. und Rhat der statt
<lb n="43"/>St. Gallen</orgName>.
