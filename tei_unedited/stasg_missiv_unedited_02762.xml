<lb n="14"/><unclear cert="medium" resp="#joint">zeit</unclear> <unclear cert="medium" resp="#joint">angestanden</unclear>, <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">sÿ</unclear> <unclear cert="medium" resp="#joint">derselbigen</unclear> <unclear cert="medium" resp="#joint">hoehlich</unclear> <unclear cert="medium" resp="#joint">vonnoeten</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">hetten</unclear>, <unclear cert="medium" resp="#joint">Als</unclear> <unclear cert="medium" resp="#joint">haetten</unclear> <unclear cert="medium" resp="#joint">sÿ</unclear> nit <unclear cert="medium" resp="#joint">underlassen</unclear> <unclear cert="medium" resp="#joint">koenden</unclear>, sich
<lb n="16"/>darumben an einem und andern <unclear cert="medium" resp="#joint">orth</unclear> <unclear cert="medium" resp="#joint">widerumb</unclear> <unclear cert="medium" resp="#joint">anzuo</unclear>-
<lb n="17"/><unclear cert="medium" resp="#joint">melden</unclear>, damit nicht <unclear cert="medium" resp="#joint">etwan</unclear> durch <unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">stilschwigen</unclear> <unclear cert="low" resp="#joint">schuldt</unclear> <unclear cert="low" resp="#joint">dieselben</unclear>
<lb n="18"/>und <unclear cert="medium" resp="#joint">hinlaessigkeit</unclear> <unclear cert="medium" resp="#joint">dieselben</unclear> <unclear cert="medium" resp="#joint">dahinden</unclear> <unclear cert="medium" resp="#joint">bliben</unclear> <unclear cert="medium" resp="#joint">verwarloset</unclear>
<lb n="19"/>wurden; mit <unclear cert="medium" resp="#joint">angehefften</unclear> <unclear cert="medium" resp="#joint">bitten</unclear>, <unclear cert="medium" resp="#joint">wir</unclear> ihnen <unclear cert="medium" resp="#joint">hier</unclear>-
<lb n="20"/><unclear cert="medium" resp="#joint">zuo</unclear> die <unclear cert="medium" resp="#joint">oberkeitliche</unclear> <unclear cert="medium" resp="#joint">handt</unclear> <unclear cert="medium" resp="#joint">bieten</unclear> <unclear cert="medium" resp="#joint">wöllten</unclear>.
<lb n="21"/><unclear cert="medium" resp="#joint">Wann</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">dann</unclear> nit <unclear cert="medium" resp="#joint">zweifelt</unclear>, es werde
<lb n="22"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. die <unclear cert="low" resp="#joint">bewandtnus</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">sachen</unclear>
