<p>
<pb facs="StadtASG_Missive_1969_7317.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Edle</unclear>, <unclear cert="medium" resp="#joint">Veste</unclear>, <unclear cert="medium" resp="#joint">Frome</unclear>, <unclear cert="medium" resp="#joint">Fürsichtige</unclear>, <unclear cert="medium" resp="#joint">Ersame</unclear>, <unclear cert="medium" resp="#joint">Weyse</unclear>, sonders
<lb n="2"/><unclear cert="low" resp="#joint">günstige</unclear> <unclear cert="low" resp="#joint">ehrende</unclear> <unclear cert="low" resp="#joint">Brueder</unclear>, <unclear cert="low" resp="#joint">woluertreüwte</unclear> <unclear cert="low" resp="#joint">liebe</unclear> Eidt-
<lb n="3"/>und <unclear cert="low" resp="#joint">Pündtsgnossen</unclear>, <unclear cert="low" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">seyen</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">gantz</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">geneigte</unclear>, <unclear cert="low" resp="#joint">guetwillige</unclear> dienst und <unclear cert="medium" resp="#joint">gruetz</unclear>, mit <unclear cert="medium" resp="#joint">erbieth</unclear>-
<lb n="5"/>ung <unclear cert="medium" resp="#joint">aller</unclear> <unclear cert="medium" resp="#joint">angenemen</unclear> <unclear cert="medium" resp="#joint">Eidt</unclear>- und <unclear cert="medium" resp="#joint">Pündtsgnoßischer</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">treüw</unclear> und <unclear cert="medium" resp="#joint">liebe</unclear>, <unclear cert="medium" resp="#joint">beuor</unclear>.
<lb n="7"/>Demnach <unclear cert="medium" resp="#joint">fuegend</unclear> wir denselben <unclear cert="low" resp="#joint">fründtlicher</unclear> <unclear cert="low" resp="#joint">woll</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">meinung</unclear> <unclear cert="low" resp="#joint">zuuernemmen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">auf</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">heütdentag</unclear></date> seines
<lb n="9"/><unclear cert="medium" resp="#joint">datums</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> wir <unclear cert="low" resp="#joint">Rhatsweiß</unclear> <unclear cert="low" resp="#joint">beieinanderen</unclear> <unclear cert="low" resp="#joint">gesampt</unclear>
<lb n="10"/>gewesen, <unclear cert="medium" resp="#joint">für</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">kommen</unclear> und <unclear cert="medium" resp="#joint">erschinen</unclear> <unclear cert="medium" resp="#joint">ist</unclear>, <unclear cert="medium" resp="#joint">Meister</unclear>
<lb n="11"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Hanns</unclear> Jacob <unclear cert="medium" resp="#joint">Töber</unclear></persName> <unclear cert="medium" resp="#joint">üwer</unclear> <unclear cert="medium" resp="#joint">Burger</unclear>, für sich <unclear cert="low" resp="#joint">selbst</unclear>, und
<lb n="12"/><unclear cert="medium" resp="#joint">Jn</unclear> namen seiner lieben <unclear cert="low" resp="#joint">Schwöster</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Anna</unclear> <unclear cert="low" resp="#joint">Töberin</unclear></persName>.
<lb n="13"/>Und <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">vil</unclear> <unclear cert="low" resp="#joint">kummer</unclear> <unclear cert="low" resp="#joint">beduren</unclear> und <unclear cert="medium" resp="#joint">hertzlaid</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">fürbringen</unclear> und <unclear cert="low" resp="#joint">eröffnen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>, <unclear cert="low" resp="#joint">weiland</unclear> <unclear cert="low" resp="#joint">Jres</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">Vatters</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Balthasar</unclear> <unclear cert="low" resp="#joint">Töbers</unclear></persName> seligen <unclear cert="medium" resp="#joint">kläglichen</unclear> <unclear cert="medium" resp="#joint">abgang</unclear>,
<lb n="16"/><unclear cert="medium" resp="#joint">Gott</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">Allmächtige</unclear> <unclear cert="medium" resp="#joint">Jnnigklich</unclear> <unclear cert="medium" resp="#joint">anrueffende</unclear>, <unclear cert="medium" resp="#joint">wölle</unclear>
<lb n="17"/>sy <unclear cert="low" resp="#joint">Jn</unclear> <unclear cert="low" resp="#joint">Jrer</unclear> <unclear cert="low" resp="#joint">bekümbernuß</unclear> nit <unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">trösten</unclear>; <unclear cert="low" resp="#joint">sonderen</unclear>
<lb n="18"/>auch <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">fernerem</unclear> <unclear cert="low" resp="#joint">unfall</unclear> <unclear cert="low" resp="#joint">gnedigklich</unclear> <unclear cert="low" resp="#joint">bewharen</unclear>.
<lb n="19"/>Und <unclear cert="medium" resp="#joint">obwoll</unclear> er <persName resp="#ner">Hanns Jacob <unclear cert="medium" resp="#joint">Töber</unclear></persName> sampt <unclear cert="medium" resp="#joint">seiner</unclear> lieben
<lb n="20"/><unclear cert="low" resp="#joint">Schwöster</unclear> <unclear cert="low" resp="#joint">gentzlicher</unclear> <unclear cert="low" resp="#joint">hoffnung</unclear> <unclear cert="low" resp="#joint">gewesen</unclear>, <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">wurde</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">denselben</unclear> nicht allein <unclear cert="medium" resp="#joint">Jrer</unclear> <unclear cert="medium" resp="#joint">Muetter</unclear> seligen <unclear cert="low" resp="#joint">vor</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">etlich</unclear> <unclear cert="low" resp="#joint">Jaren</unclear> <unclear cert="low" resp="#joint">gebürende</unclear> <unclear cert="low" resp="#joint">Erbfall</unclear>, so <unclear cert="medium" resp="#joint">bei</unclear> des Vatters
<lb n="23"/>seligen <unclear cert="medium" resp="#joint">haab</unclear> und <unclear cert="low" resp="#joint">guett</unclear> <unclear cert="low" resp="#joint">unzerteilt</unclear> <unclear cert="low" resp="#joint">verbliben</unclear>, <unclear cert="low" resp="#joint">sonderen</unclear>
<lb n="24"/>auch <unclear cert="low" resp="#joint">Jres</unclear> <unclear cert="low" resp="#joint">Vatters</unclear> seligen <unclear cert="low" resp="#joint">hinderlaßne</unclear> <unclear cert="low" resp="#joint">haab</unclear> und
<lb n="25"/><unclear cert="medium" resp="#joint">guett</unclear>, gleich so <unclear cert="medium" resp="#joint">woll</unclear> <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">anderen</unclear> <unclear cert="medium" resp="#joint">Jren</unclear> <unclear cert="medium" resp="#joint">Gschwuisterten</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">zuhendig</unclear> gemacht und <unclear cert="medium" resp="#joint">vervolget</unclear> <unclear cert="medium" resp="#joint">werden</unclear>. <unclear cert="medium" resp="#joint">So</unclear> aber
<lb n="27"/><unclear cert="medium" resp="#joint">Jme</unclear> <unclear cert="medium" resp="#joint">wider</unclear> all <unclear cert="medium" resp="#joint">Jre</unclear> <unclear cert="medium" resp="#joint">verhoffen</unclear> fürkomen, daß sy <unclear cert="low" resp="#joint">diser</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">beider</unclear> <unclear cert="low" resp="#joint">verlaßenschafften</unclear> (<unclear cert="low" resp="#joint">vorbehalten</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">schwöster</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">erlegende</unclear> <unclear cert="low" resp="#joint">Kleider</unclear>) zum <unclear cert="medium" resp="#joint">theil</unclear> <unclear cert="medium" resp="#joint">alligklichen</unclear> außge-
<lb n="30"/><unclear cert="medium" resp="#joint">schlossen</unclear> <unclear cert="medium" resp="#joint">worden</unclear> <unclear cert="medium" resp="#joint">syend</unclear>. <unclear cert="medium" resp="#joint">Jm</unclear> fall und <unclear cert="medium" resp="#joint">aber</unclear>,
<lb n="31"/><unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">unß</unclear> nit <unclear cert="medium" resp="#joint">zweifflet</unclear>, <unclear cert="medium" resp="#joint">solches</unclear> ohne <unclear cert="medium" resp="#joint">sonderbare</unclear> <unclear cert="medium" resp="#joint">ursach</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">beschehe</unclear>, <unclear cert="medium" resp="#joint">sonder</unclear> <unclear cert="medium" resp="#joint">villichter</unclear> <unclear cert="medium" resp="#joint">angeregte</unclear> <unclear cert="medium" resp="#joint">Gschwuist</unclear>-
<lb n="33"/><unclear cert="medium" resp="#joint">erte</unclear> auß <unclear cert="low" resp="#joint">Menschlicher</unclear> <unclear cert="low" resp="#joint">blödigkeit</unclear> <unclear cert="low" resp="#joint">angeborener</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">Nattur</unclear>, die <unclear cert="low" resp="#joint">allweegen</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">eigneschafft</unclear> <unclear cert="low" resp="#joint">mer</unclear> zu
<pb facs="StadtASG_Missive_1969_7318.jpg" n="2"/>
<lb n="35"/>zu boesem, dann zu guettem geneigt ist, sich etlicher
<lb n="36"/>massen auß unbedachter jugend, zu ein uebel moecht-
<lb n="37"/>end verdiefft haben, das aber, so etwas beschechen,
<lb n="38"/>ihnen von grund ihrer herzen wider und leid
<lb n="39"/>were. Deßwegen habend sy uns an
<lb n="40"/>euwer Wt. Ehr. Fr. L. Wht. umb intercession
<lb n="41"/>und fürschrift underdienstlich angelangt, welches
<lb n="42"/>wür ihnen dann in ihrem bekümbernuß und
<lb n="43"/>truebsall nit koenen verweigeren noch abschlachen.
<lb n="44"/>Glangt demnach an E. Wt. Ehr. Fr. L. Wht. unser
<lb n="45"/>ganz freündtlich Eydt- und pundtgnößisches pitten,
<lb n="46"/>dieselben woellen mehrgemelten supplicanten
<lb n="47"/>ihr begangne fäller und ubertretung (die da auß
<lb n="48"/>jugend und unwüssenheit beschechen sein moechtend,
<lb n="49"/>ietz aber ein herzlichen reüwen daruber habend)
<lb n="50"/>auß christenlichem mitleiden und barmherzigkeit
<lb n="51"/>verzeichen und vergeben, wo ie nit müglich ihres
<lb n="52"/>vatters seligen haab und guet, ihnen doch ihrer ehr-
<lb n="53"/>lichen muetter seligen gebürende verlassenschaft,
<lb n="54"/>so woll alß anderen ihren geschwüsterden, gnädig-
<lb n="55"/>klich eruolgen und zukomen lassen, und allso die
<lb n="56"/>barmherzigkeit der gerechtigkeit fürsetzen,
<lb n="57"/>in massen uns nit zweifflet sy ohn das, solches woll
<lb n="58"/>thun werdend.
<lb n="59"/>Diß unser intercessionschriben wöllen Euwer Wt.
<lb n="60"/>Ehr. Fr. L. Wht. von uns im besten verstohn, denen
<lb n="61"/>wür dann, alß den hochuerstendigen nichts woellend
<lb n="62"/>fürgeschriben haben.
<lb n="63"/>Goettlicher bewahrung uns allerseits woll be-
<lb n="64"/>felchende, und einer freündtlichen willfahrigen
<pb facs="StadtASG_Missive_1969_7319.jpg" n="3"/>
<lb n="65"/><unclear cert="low" resp="#joint">anttwortt</unclear> <unclear cert="low" resp="#joint">erwarttende</unclear>. <unclear cert="low" resp="#joint">Datum</unclear> den <origDate when="1615" resp="#ner"><unclear cert="low" resp="#joint">16</unclear>: <unclear cert="low" resp="#joint">tag</unclear> <unclear cert="low" resp="#joint">septembris</unclear>
<lb n="66"/><unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">1615</unclear> <unclear cert="low" resp="#joint">jarß</unclear></origDate>.
<lb n="67"/><unclear cert="low" resp="#joint">F</unclear>: <unclear cert="low" resp="#joint">Wt</unclear>: <unclear cert="low" resp="#joint">Fr</unclear>: <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Wtt</unclear>:
<lb n="68"/><unclear cert="low" resp="#joint">getreüwer</unclear> <unclear cert="low" resp="#joint">eidt</unclear>, und <unclear cert="low" resp="#joint">pundtgnossen</unclear>.
<lb n="69"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Stattvogt</unclear> und rhatte der
<lb n="70"/>Statt <unclear cert="low" resp="#joint">Meijenfeld</unclear></orgName>.
<pb facs="StadtASG_Missive_1969_7320.jpg" n="4"/>
<lb n="71"/><unclear cert="medium" resp="#joint">Denen</unclear> Edlen, <unclear cert="low" resp="#joint">Vhesten</unclear>, Frommen, <unclear cert="medium" resp="#joint">Fuersichtigen</unclear>, <unclear cert="medium" resp="#joint">Ersammen</unclear>
<lb n="72"/>und <unclear cert="low" resp="#joint">weysen</unclear> <unclear cert="low" resp="#joint">herren</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">Rhatt</unclear> der
<lb n="73"/>Statt <unclear cert="low" resp="#joint">SantGallen</unclear></orgName>. <unclear cert="low" resp="#joint">unseren</unclear> Insonders guoten
<lb n="74"/><unclear cert="low" resp="#joint">Freuenden</unclear>, <unclear cert="low" resp="#joint">wolfertrauwten</unclear> Lieben <unclear cert="low" resp="#joint">Eidt</unclear>., <unclear cert="low" resp="#joint">und</unclear>
<lb n="75"/><unclear cert="low" resp="#joint">Puntßgnoßen</unclear>.
<lb n="76"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">SantGallen</unclear></placeName>.
</p>
