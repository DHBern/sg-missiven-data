<p>
<pb facs="StadtASG_Missive_890_2559.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Ernnest</unclear> <unclear cert="low" resp="#joint">fuernem</unclear> <unclear cert="low" resp="#joint">guenstig</unclear> und weis herren, <unclear cert="low" resp="#joint">kaufluet</unclear> der.
<lb n="2"/><unclear cert="low" resp="#joint">stedt</unclear> <placeName resp="#ner">Sann <unclear cert="low" resp="#joint">galla</unclear>.</placeName> und <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schafhaussen</unclear></placeName>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">thuent</unclear> uech zu wissen,
<lb n="3"/>das sich auf <date resp="#ner"><unclear cert="medium" resp="#joint">sonntag</unclear>, <unclear cert="medium" resp="#joint">28</unclear>. <unclear cert="medium" resp="#joint">vergangen</unclear> monatz <unclear cert="low" resp="#joint">september</unclear></date>, alhie
<lb n="4"/>zu <placeName ref="stadtasg-places-196" cert="medium" resp="#ner">Lyon</placeName> <unclear cert="medium" resp="#joint">hat</unclear> <unclear cert="low" resp="#joint">zuogtragen</unclear>, dz das <unclear cert="medium" resp="#joint">vollck</unclear> in aller <unclear cert="low" resp="#joint">unruhe</unclear>, die
<lb n="5"/><unclear cert="low" resp="#joint">catholichen</unclear> in der <unclear cert="low" resp="#joint">wehr</unclear> und der stadt mechtig, gleich woll gott
<lb n="6"/>lob, noch bis auff <unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="medium" resp="#joint">stundt</unclear> kein <unclear cert="low" resp="#joint">bludt</unclear> <unclear cert="medium" resp="#joint">vergießen</unclear>, noch ander.
<lb n="7"/><unclear cert="low" resp="#joint">uebell</unclear> nitt <unclear cert="low" resp="#joint">gethonn</unclear>. der <unclear cert="low" resp="#joint">gouvernör</unclear> sampt andern herren so.
<lb n="8"/>alhie <unclear cert="medium" resp="#joint">sindt</unclear>, alls der <unclear cert="medium" resp="#joint">sanneschall</unclear> herr. <unclear cert="medium" resp="#joint">de</unclear> <unclear cert="low" resp="#joint">monteran</unclear>, von <placeName resp="#ner"><unclear cert="low" resp="#joint">Sannct</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">chamon</unclear></placeName>, graff von <placeName resp="#ner"><unclear cert="medium" resp="#joint">Benne</unclear></placeName>, die <unclear cert="medium" resp="#joint">dannocht</unclear> so <unclear cert="low" resp="#joint">guete</unclear> ordnung alhie <unclear cert="low" resp="#joint">geben</unclear>
<lb n="10"/>und noch <unclear cert="medium" resp="#joint">bishero</unclear>. dz <unclear cert="low" resp="#joint">underme</unclear> <unclear cert="low" resp="#joint">gemeinen</unclear> vollck, <unclear cert="medium" resp="#joint">sovil</unclear> alls <unclear cert="low" resp="#joint">mueg</unclear>-
<lb n="11"/>lich verweren. <unclear cert="medium" resp="#joint">kein</unclear> unrad <unclear cert="low" resp="#joint">gschee</unclear>. es kan aber in sollichen sachen
<lb n="12"/><unclear cert="medium" resp="#joint">nitt</unclear> so eben <unclear cert="low" resp="#joint">zuogahn</unclear>, der <unclear cert="low" resp="#joint">gouvnernör</unclear> was mir noch <unclear cert="medium" resp="#joint">bishero</unclear>.
<lb n="13"/>fuer in kert. hat. unns allen <unclear cert="low" resp="#joint">gueten</unclear> willen bewisen, <unclear cert="low" resp="#joint">wir</unclear>
<lb n="14"/>aber <unclear cert="low" resp="#joint">koenden</unclear> <unclear cert="medium" resp="#joint">nitt</unclear> minder thon, dann euch disser sache berichte
<lb n="15"/>hoffen zuo <unclear cert="low" resp="#joint">deme</unclear>, dar mir <unclear cert="low" resp="#joint">hie</unclear> thon woellen, ir <unclear cert="low" resp="#joint">werdens</unclear> noch <unclear cert="low" resp="#joint">weitter</unclear>
<lb n="16"/>guet ordnung darzuo geben. sampt den herren <unclear cert="low" resp="#joint">kaufleuten</unclear> von
<lb n="17"/><orgName ref="stadtasg-actors-28" cert="medium" resp="#ner">Schafhaussenn</orgName>. die mit disem auch <unclear cert="medium" resp="#joint">anligen</unclear>. <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">itzig</unclear> unnd <unclear cert="low" resp="#joint">zu</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">khunfftige</unclear> wir schriben hiemit dem <unclear cert="low" resp="#joint">ambascador</unclear>. gen <placeName ref="stadtasg-places-49" cert="medium" resp="#ner">Sollothorn</placeName>
<lb n="19"/><unclear cert="medium" resp="#joint">das</unclear> er mit <unclear cert="low" resp="#joint">erstem</unclear> dem herren <unclear cert="low" resp="#joint">gouvernoer</unclear> hie, <unclear cert="medium" resp="#joint">fuer</unclear> uns <unclear cert="medium" resp="#joint">widumb</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">schribe</unclear>, in <unclear cert="low" resp="#joint">ermane</unclear>, unns <unclear cert="low" resp="#joint">bevollen</unclear> hab. das <unclear cert="medium" resp="#joint">nit</unclear> schaden <unclear cert="low" resp="#joint">kann</unclear>
<lb n="21"/>gleichwoll. wie obgemellt, der herr alhie uns noch <unclear cert="low" resp="#joint">bis</unclear> <unclear cert="low" resp="#joint">hero</unclear>, allen
<lb n="22"/>dienst bewiesen, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">koendten</unclear> noch nitt wissen, was <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">disen</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">handtlungen</unclear> in <unclear cert="medium" resp="#joint">gantz</unclear> <placeName ref="stadtasg-places-131" cert="medium" resp="#ner">Franckreich</placeName> <unclear cert="medium" resp="#joint">vollgent</unclear> <unclear cert="medium" resp="#joint">moecht</unclear>. <unclear cert="medium" resp="#joint">allem</unclear> <unclear cert="medium" resp="#joint">an</unclear>-
<lb n="24"/>sehen nach, <unclear cert="low" resp="#joint">moecht</unclear>. das <unclear cert="medium" resp="#joint">gantz</unclear> <unclear cert="medium" resp="#joint">landt</unclear> in <unclear cert="low" resp="#joint">unrohe</unclear> komen, <unclear cert="low" resp="#joint">wir</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">koendten</unclear> mit <unclear cert="medium" resp="#joint">grundt</unclear> nitt <unclear cert="medium" resp="#joint">weitter</unclear> von <unclear cert="medium" resp="#joint">disen</unclear> sachen schriben,
<lb n="26"/><unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">ursachen</unclear>. hapt ir selbs zuo ermessen, <unclear cert="low" resp="#joint">zeiger</unclear> <unclear cert="low" resp="#joint">ditz</unclear> <unclear cert="medium" resp="#joint">ist</unclear> <persName resp="#ner">Hanns
<lb n="27"/><unclear cert="medium" resp="#joint">Grillen</unclear> von <unclear cert="low" resp="#joint">Coyre</unclear></persName> dem haben wir <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">zerung</unclear> geben <unclear cert="low" resp="#joint">20</unclear> v
<lb n="28"/>zu 50 s <unclear cert="medium" resp="#joint">p</unclear> v werdent <unclear cert="medium" resp="#joint">inn</unclear> wissen. widerumb herinn <unclear cert="low" resp="#joint">zeferdigen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">allsdan</unclear> <unclear cert="low" resp="#joint">waetten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">dz</unclear> alles mit <unclear cert="low" resp="#joint">ime</unclear> ab. <unclear cert="low" resp="#joint">bevollen</unclear>
