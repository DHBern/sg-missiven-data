<p>
<pb facs="StadtASG_Missive_890_2559.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Ernnest</unclear> <unclear cert="low" resp="#joint">fuernem</unclear> <unclear cert="low" resp="#joint">guenstig</unclear> und weis herren, <unclear cert="medium" resp="#joint">kaufluet</unclear> der.
<lb n="2"/><unclear cert="medium" resp="#joint">stedt</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Sann</unclear> <unclear cert="low" resp="#joint">galla</unclear>.</placeName> und <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schafhaussen</unclear></placeName>, <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">thuent</unclear> uech <unclear cert="medium" resp="#joint">zu</unclear> wissen,
<lb n="3"/>das sich <unclear cert="medium" resp="#joint">auf</unclear> <date resp="#ner">sonntag, 28. vergangen monatz <unclear cert="low" resp="#joint">september</unclear></date>, alhie
<lb n="4"/>zu <placeName ref="stadtasg-places-196" cert="medium" resp="#ner">Lyon</placeName> hat <unclear cert="low" resp="#joint">zuogtragen</unclear>, dz das vollck in aller <unclear cert="low" resp="#joint">unruhe</unclear>, die
<lb n="5"/><unclear cert="low" resp="#joint">catholichen</unclear> in der <unclear cert="low" resp="#joint">wehr</unclear> und der stadt mechtig, gleich woll gott
<lb n="6"/>lob, noch bis auff dise stundt <unclear cert="medium" resp="#joint">kein</unclear> <unclear cert="low" resp="#joint">bludt</unclear> <unclear cert="low" resp="#joint">vergießen</unclear>, noch ander.
<lb n="7"/><unclear cert="low" resp="#joint">uebell</unclear> nitt <unclear cert="low" resp="#joint">gethonn</unclear>. der <unclear cert="low" resp="#joint">gouvernör</unclear> sampt andern herren so.
<lb n="8"/>alhie <unclear cert="low" resp="#joint">sindt</unclear>, alls der sanneschall herr. de <unclear cert="low" resp="#joint">monteran</unclear>, von <placeName resp="#ner"><unclear cert="low" resp="#joint">Sannct</unclear>
<lb n="9"/>chamon</placeName>, graff von <placeName resp="#ner"><unclear cert="low" resp="#joint">Benne</unclear></placeName>, die dannocht so <unclear cert="low" resp="#joint">guete</unclear> ordnung alhie <unclear cert="low" resp="#joint">geben</unclear>
<lb n="10"/>und noch bishero. dz <unclear cert="low" resp="#joint">underme</unclear> <unclear cert="low" resp="#joint">gemeinen</unclear> vollck, <unclear cert="low" resp="#joint">sovil</unclear> alls <unclear cert="low" resp="#joint">mueg</unclear>-
<lb n="11"/>lich verweren. <unclear cert="medium" resp="#joint">kein</unclear> unrad <unclear cert="low" resp="#joint">gschee</unclear>. es kan aber in sollichen sachen
<lb n="12"/><unclear cert="medium" resp="#joint">nitt</unclear> so eben <unclear cert="low" resp="#joint">zuogahn</unclear>, der <unclear cert="low" resp="#joint">gouvnernör</unclear> was mir noch bishero.
<lb n="13"/><unclear cert="medium" resp="#joint">fuer</unclear> in kert. hat. unns allen <unclear cert="low" resp="#joint">gueten</unclear> willen bewisen, <unclear cert="low" resp="#joint">wir</unclear>
<lb n="14"/>aber <unclear cert="low" resp="#joint">koenden</unclear> <unclear cert="medium" resp="#joint">nitt</unclear> minder thon, dann euch <unclear cert="medium" resp="#joint">disser</unclear> sache berichte
<lb n="15"/>hoffen zuo <unclear cert="low" resp="#joint">deme</unclear>, <unclear cert="medium" resp="#joint">dar</unclear> mir <unclear cert="medium" resp="#joint">hie</unclear> thon <unclear cert="medium" resp="#joint">woellen</unclear>, ir <unclear cert="low" resp="#joint">werdens</unclear> noch <unclear cert="low" resp="#joint">weitter</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">guet</unclear> ordnung darzuo geben. sampt den herren <unclear cert="medium" resp="#joint">kaufleuten</unclear> von
<lb n="17"/><orgName ref="stadtasg-actors-28" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schafhaussenn</unclear></orgName>. die mit disem auch anligen. <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">itzig</unclear> unnd <unclear cert="low" resp="#joint">zu</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">khunfftige</unclear> wir schriben hiemit dem <unclear cert="low" resp="#joint">ambascador</unclear>. gen <placeName ref="stadtasg-places-49" cert="medium" resp="#ner">Sollothorn</placeName>
<lb n="19"/><unclear cert="low" resp="#joint">das</unclear> er mit <unclear cert="low" resp="#joint">erstem</unclear> dem herren <unclear cert="low" resp="#joint">gouvernoer</unclear> hie, <unclear cert="medium" resp="#joint">fuer</unclear> uns widumb
<lb n="20"/>schribe, in <unclear cert="low" resp="#joint">ermane</unclear>, unns <unclear cert="low" resp="#joint">bevollen</unclear> hab. das nit schaden <unclear cert="medium" resp="#joint">kann</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">gleichwoll</unclear>. wie obgemellt, der herr alhie uns noch <unclear cert="low" resp="#joint">bis</unclear> <unclear cert="low" resp="#joint">hero</unclear>, allen
<lb n="22"/>dienst bewiesen, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">koendten</unclear> noch nitt wissen, was <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">disen</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">handtlungen</unclear> in gantz <placeName ref="stadtasg-places-131" cert="medium" resp="#ner">Franckreich</placeName> <unclear cert="medium" resp="#joint">vollgent</unclear> <unclear cert="medium" resp="#joint">moecht</unclear>. <unclear cert="medium" resp="#joint">allem</unclear> <unclear cert="medium" resp="#joint">an</unclear>-
<lb n="24"/><unclear cert="medium" resp="#joint">sehen</unclear> nach, <unclear cert="medium" resp="#joint">moecht</unclear>. das gantz landt in <unclear cert="low" resp="#joint">unrohe</unclear> komen, <unclear cert="low" resp="#joint">wir</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">koendten</unclear> mit grundt nitt weitter von disen sachen <unclear cert="medium" resp="#joint">schriben</unclear>,
<lb n="26"/><unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">ursachen</unclear>. hapt ir selbs <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">ermessen</unclear>, <unclear cert="medium" resp="#joint">zeiger</unclear> <unclear cert="medium" resp="#joint">ditz</unclear> ist <persName resp="#ner">Hanns
<lb n="27"/><unclear cert="low" resp="#joint">Grillen</unclear> von <unclear cert="low" resp="#joint">Coyre</unclear></persName> dem haben wir <unclear cert="low" resp="#joint">uf</unclear> <unclear cert="low" resp="#joint">zerung</unclear> geben <unclear cert="low" resp="#joint">20</unclear> v
<lb n="28"/>zu 50 s <unclear cert="medium" resp="#joint">p</unclear> v werdent <unclear cert="medium" resp="#joint">inn</unclear> wissen. <unclear cert="medium" resp="#joint">widerumb</unclear> herinn <unclear cert="medium" resp="#joint">zeferdigen</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">allsdan</unclear> <unclear cert="medium" resp="#joint">waetten</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">dz</unclear> alles mit <unclear cert="low" resp="#joint">ime</unclear> ab. <unclear cert="medium" resp="#joint">bevollen</unclear>
<lb n="30"/><unclear cert="medium" resp="#joint">uich</unclear> unnd uns <unclear cert="low" resp="#joint">gon</unclear> dem herren datum <origPlace ref="stadtasg-places-196" cert="medium" resp="#ner">Lyon</origPlace> <origDate when="1567" resp="#ner">3 <unclear cert="low" resp="#joint">ottobre</unclear> 1567
<lb n="31"/>nach <unclear cert="low" resp="#joint">mitag</unclear> umb 3 ur.</origDate>
