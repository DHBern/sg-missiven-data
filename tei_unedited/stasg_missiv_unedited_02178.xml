<lb n="9"/><unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">besorgender</unclear> <unclear cert="low" resp="#joint">gfahr</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">untrüw</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">annd</unclear>-
