<p>
<pb facs="StadtASG_Missive_970_2927.jpg" n="1"/>
<lb n="1"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Wilhelm</unclear> <unclear cert="low" resp="#joint">grav</unclear></persName> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">zu</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Zimbern</unclear></placeName>
<lb n="2"/><unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">zu</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Wildenstein</unclear></placeName> und <placeName resp="#ner"><unclear cert="medium" resp="#joint">Mößkirch</unclear></placeName> etc.
<lb n="3"/><unclear cert="medium" resp="#joint">Unsern</unclear> <unclear cert="medium" resp="#joint">gn</unclear>. grueß zuvor. <unclear cert="medium" resp="#joint">Ernhaffte</unclear> <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">fürneme</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">besundern</unclear>, wann wir <unclear cert="medium" resp="#joint">unns</unclear>
<lb n="5"/>alles <unclear cert="medium" resp="#joint">guetten</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">euch</unclear> versehen, haben wir
<lb n="6"/>nit <unclear cert="low" resp="#joint">underlassen</unclear> wellen, euch <unclear cert="low" resp="#joint">nachmals</unclear> <unclear cert="low" resp="#joint">mittle</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">gnedige</unclear> <unclear cert="low" resp="#joint">Gs</unclear>. <unclear cert="low" resp="#joint">anzulangen</unclear>. <unclear cert="low" resp="#joint">Nachdem</unclear> wir
<lb n="8"/>ain <unclear cert="medium" resp="#joint">zimliche</unclear> <unclear cert="medium" resp="#joint">suma</unclear> gelts <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">losen</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">kündt</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">unnd</unclear> unns wol versehen, <unclear cert="medium" resp="#joint">es</unclear> were <unclear cert="low" resp="#joint">dißer</unclear> <unclear cert="low" resp="#joint">ort</unclear>
<lb n="10"/>die <unclear cert="medium" resp="#joint">Müntzen</unclear> durch <unclear cert="medium" resp="#joint">uß</unclear> genomen, oder <unclear cert="medium" resp="#joint">verbotten</unclear>
<lb n="11"/>worden, so <unclear cert="medium" resp="#joint">befindt</unclear> sich aber
<lb n="12"/><unclear cert="medium" resp="#joint">ietz</unclear> das <unclear cert="medium" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-4" cert="medium" resp="#ner">Überlingen</placeName>, (<unclear cert="low" resp="#joint">alda</unclear> <unclear cert="low" resp="#joint">unsere</unclear> und-
<lb n="13"/><unclear cert="low" resp="#joint">thonen</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Maiste</unclear> <unclear cert="low" resp="#joint">losung</unclear> <unclear cert="low" resp="#joint">enpfhahen</unclear>.) <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">drej</unclear>,
<lb n="14"/><unclear cert="low" resp="#joint">bätzner</unclear> <unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">pronier</unclear>, <unclear cert="low" resp="#joint">zuger</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">eüwer</unclear>,
<lb n="15"/>für <unclear cert="low" resp="#joint">voll</unclear> <unclear cert="low" resp="#joint">passirt</unclear> werden, <unclear cert="medium" resp="#joint">wölche</unclear> man
<lb n="16"/>aber <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">unnß</unclear> <unclear cert="medium" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">solcher</unclear> <unclear cert="medium" resp="#joint">losung</unclear> nit nemen,
<lb n="17"/>dieweil unns dann nit <unclear cert="medium" resp="#joint">zweifelt</unclear>, ir <unclear cert="medium" resp="#joint">wußt</unclear>
<lb n="18"/>wol <unclear cert="medium" resp="#joint">goldt</unclear> oder <unclear cert="medium" resp="#joint">Reichs</unclear> <unclear cert="medium" resp="#joint">Müntz</unclear> gegen <unclear cert="medium" resp="#joint">ein</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">thausendt</unclear> oder <unclear cert="medium" resp="#joint">mehr</unclear> <unclear cert="medium" resp="#joint">guldin</unclear> gemelter <unclear cert="medium" resp="#joint">drej</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">bätzner</unclear> umb <unclear cert="medium" resp="#joint">ain</unclear> <unclear cert="medium" resp="#joint">leidenlichen</unclear> <unclear cert="medium" resp="#joint">überwechsel</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">zewegen</unclear> <unclear cert="medium" resp="#joint">zubringen</unclear>. So <unclear cert="medium" resp="#joint">gelangt</unclear>
<lb n="22"/>unser <unclear cert="low" resp="#joint">gn</unclear>. <unclear cert="low" resp="#joint">gesünnen</unclear> an <unclear cert="medium" resp="#joint">euch</unclear> ir <unclear cert="medium" resp="#joint">wollendt</unclear>
<lb n="23"/><unclear cert="medium" resp="#joint">unnß</unclear> <unclear cert="medium" resp="#joint">souil</unclear> <unclear cert="medium" resp="#joint">zu</unclear> gefallen thuen, und unns
<lb n="24"/><unclear cert="medium" resp="#joint">hierej</unclear> <unclear cert="medium" resp="#joint">verstendigen</unclear>, ob ir unns <unclear cert="medium" resp="#joint">was</unclear> <unclear cert="medium" resp="#joint">künden</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">vertrüssten</unclear>, und <unclear cert="medium" resp="#joint">wie</unclear> hoch <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">überwechsel</unclear>
<pb facs="StadtASG_Missive_970_2928.jpg" n="2"/>
<lb n="26"/>sein mieste, sonder was <unclear cert="low" resp="#joint">furkhuempt</unclear>, da <unclear cert="low" resp="#joint">unß</unclear> doch
<lb n="27"/>nit zweifelt, ir unß in demselbigen leidenlich
<lb n="28"/>halten wurden. Unnd da ir <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">bej</unclear>
<lb n="29"/>euch selbs nicht vertrawthen, welt ir unnser
<lb n="30"/>liebe und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">nachpurn</unclear>, <unclear cert="low" resp="#joint">euwer</unclear> herren <unclear cert="medium" resp="#joint">zu</unclear>
<lb n="31"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sant Gallen</placeName> von unser wegen anlangen <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">hierinnen</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">nachpuerlich</unclear> <unclear cert="low" resp="#joint">wilfarn</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">khuendten</unclear>, unnd
<lb n="34"/><unclear cert="low" resp="#joint">dieselbig</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">bej</unclear> <unclear cert="low" resp="#joint">nechstem</unclear> <unclear cert="low" resp="#joint">Beraht</unclear> <unclear cert="low" resp="#joint">gewißlich</unclear>
<lb n="35"/>verstendigen, damit wir <unclear cert="low" resp="#joint">unß</unclear> dester baß
<lb n="36"/>darnach zurichten. So solten ir wissen, das
<lb n="37"/>ir solchs gegen unß khunfftigclich geniessen
<lb n="38"/>solt. Unnd das <unclear cert="low" resp="#joint">unß</unclear> euch in gnaden haben
<lb n="39"/><unclear cert="low" resp="#joint">zuerkhennen</unclear>. Wolten wir euch unnserer
<lb n="40"/>notturfft nach gd. nit bergen. Unnd
<lb n="41"/><unclear cert="low" resp="#joint">seindt</unclear> euch iederzeit allen gd. willen
<lb n="42"/>zuerweisen <unclear cert="low" resp="#joint">urbiethig</unclear>. Datum <origPlace resp="#ner">Meßkhirch</origPlace>
<lb n="43"/><origDate when="1572" cert="medium" resp="#ner">den letst septembris a° etc. <unclear cert="low" resp="#joint">72</unclear></origDate>.
<lb n="44"/>Wilhelm <unclear cert="low" resp="#joint">graue</unclear> und
<lb n="45"/>herr <unclear cert="medium" resp="#joint">zu</unclear> <placeName resp="#ner">Zimbern</placeName>
<pb facs="StadtASG_Missive_970_2929.jpg" n="3"/>
<pb facs="StadtASG_Missive_970_2930.jpg" n="4"/>
<lb n="46"/>Den ersamen und fuernemen unsren
<lb n="47"/>lieben besondernn <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister
<lb n="48"/>und Rath <unclear cert="low" resp="#joint">unnsers</unclear> <unclear cert="low" resp="#joint">kenigklichen</unclear> <unclear cert="low" resp="#joint">heiligen</unclear> <unclear cert="low" resp="#joint">Richs</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">zue</unclear> Sanct Gallen</orgName>
<lb n="50"/><unclear cert="low" resp="#joint">sampt</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">sunderen</unclear>.
<lb n="51"/><unclear cert="low" resp="#joint">inn</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">keiserlichen</unclear> <unclear cert="low" resp="#joint">gnaden</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="53"/><unclear cert="low" resp="#joint">felch</unclear> <unclear cert="low" resp="#joint">habern</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">erbrechen</unclear>.
