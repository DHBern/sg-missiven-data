<lb n="52"/><unclear cert="low" resp="#joint">Die</unclear> <unclear cert="low" resp="#joint">khizlin</unclear> <unclear cert="low" resp="#joint">dern</unclear> <unclear cert="low" resp="#joint">aines</unclear> <unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">vierling</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">mueß</unclear>,
