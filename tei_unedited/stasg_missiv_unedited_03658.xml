<lb n="54"/>auch die mezger dhein lebern zu den khizlen nemen
<pb facs="StadtASG_Missive_3658_14644.jpg" n="4"/>
<lb n="55"/>welche nit <unclear cert="low" resp="#joint">zuvor</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">gschwornen</unclear> <unclear cert="low" resp="#joint">schauen</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">besichtiget</unclear> <unclear cert="low" resp="#joint">worden</unclear>, und solle zue gmeingkiste
<lb n="57"/>alten kalbb ein gemelten werden alles bei strafe
<lb n="58"/>3 <unclear cert="low" resp="#joint">lb</unclear> <unclear cert="low" resp="#joint">d</unclear>.
<lb n="59"/>Item die schaefe und <unclear cert="low" resp="#joint">kalbskoepfe</unclear> <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">grstell</unclear>,
