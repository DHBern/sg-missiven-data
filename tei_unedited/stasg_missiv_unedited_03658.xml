<lb n="50"/>Daß <unclear cert="low" resp="#joint">bökhen</unclear>, <unclear cert="low" resp="#joint">gaiß</unclear> <unclear cert="low" resp="#joint">flaisch</unclear> <unclear cert="low" resp="#joint">dß</unclear> lb. <unclear cert="low" resp="#joint">pr</unclear>. <unclear cert="low" resp="#joint">9</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">8</unclear> <unclear cert="low" resp="#joint">d</unclear>. nach <unclear cert="low" resp="#joint">deme</unclear>
