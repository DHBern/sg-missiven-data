<p>
<pb facs="StadtASG_Missive_1739_6393.jpg" n="1"/>
<lb n="1"/>Vnnser feindtlichen gruoß unnd allers liebs <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">guots</unclear>. Zuvor <unclear cert="low" resp="#joint">fromer</unclear> <unclear cert="low" resp="#joint">vester</unclear> <unclear cert="low" resp="#joint">wyser</unclear> <unclear cert="low" resp="#joint">insunders</unclear> <unclear cert="low" resp="#joint">getruwer</unclear>
<lb n="3"/>lieber <unclear cert="low" resp="#joint">landman</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">widerumb</unclear> durch unser lieb <orgName resp="#ner"><unclear cert="low" resp="#joint">Eidge</unclear>-
<lb n="4"/><unclear cert="low" resp="#joint">nosen</unclear> von Sannct Gallen</orgName> durch schriben bricht, wie das sich ain gspan
<lb n="5"/>zethragen dinet halben von hrn burgermeister <persName resp="#ner">Keltter</persName> selignder
<lb n="6"/>lasnen witwen erzeicht da sich <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">erben</unclear> <unclear cert="low" resp="#joint">ußert</unclear> und <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">dir</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">billichen</unclear> <unclear cert="low" resp="#joint">spruchen</unclear> <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">zuogethon</unclear>, <unclear cert="low" resp="#joint">widerumb</unclear> sy <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">frouw</unclear> <unclear cert="low" resp="#joint">sich</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">widerumb</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">schirm</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">burgrecht</unclear> <unclear cert="low" resp="#joint">begeben</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">uwer</unclear> <unclear cert="low" resp="#joint">schr</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">bricht</unclear>. Das <unclear cert="low" resp="#joint">abermallen</unclear> <unclear cert="low" resp="#joint">frouw</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Kelltren</unclear>.</persName> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">mermallen</unclear> <unclear cert="low" resp="#joint">ußert</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">landrechtens</unclear> <unclear cert="low" resp="#joint">rümen</unclear>. Und sich <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">letzstlich</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">dir</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">den</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">falckh</unclear> <unclear cert="low" resp="#joint">stigen</unclear>. begärend ferner von <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">wüßen</unclear>, ob dem also
<lb n="12"/>sye. Das <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">ds</unclear> <unclear cert="low" resp="#joint">landrechtens</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">fäig</unclear>. Und du <unclear cert="low" resp="#joint">dich</unclear> <unclear cert="low" resp="#joint">irendten</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">spruchen</unclear> <unclear cert="low" resp="#joint">usspruch</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">underwißt</unclear>, da <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">luter</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">uwer</unclear> <unclear cert="low" resp="#joint">zuo</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">erinnern</unclear> <unclear cert="low" resp="#joint">wüßen</unclear>, ob sy unser landrecht ufgeben. oder wie sy
<lb n="15"/>gscheidt. Und ob sy iezich das sy sich widerumb under unser <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">von</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">Sanct</unclear> <unclear cert="low" resp="#joint">Gallen</unclear> <unclear cert="low" resp="#joint">schirm</unclear> und <unclear cert="low" resp="#joint">burgrecht</unclear> <unclear cert="low" resp="#joint">begäben</unclear>. <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">sol</unclear> <unclear cert="low" resp="#joint">uwer</unclear>
<lb n="17"/>dann wir <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">grundtlichen</unclear> <unclear cert="low" resp="#joint">bricht</unclear> <unclear cert="low" resp="#joint">habend</unclear>. Und <unclear cert="low" resp="#joint">abermallen</unclear>
