<lb n="20"/><unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">du</unclear> <unclear cert="low" resp="#joint">selbs</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">ds</unclear> <unclear cert="low" resp="#joint">fürderlichest</unclear> <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">erschinen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">uns</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">s</unclear>. <unclear cert="low" resp="#joint">erbs</unclear> <unclear cert="low" resp="#joint">beschaffenheit</unclear> <unclear cert="low" resp="#joint">grundts</unclear> <unclear cert="low" resp="#joint">brichtest</unclear>. <unclear cert="low" resp="#joint">Darmit</unclear>
<lb n="22"/>wir <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">versprechen</unclear>, <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">l</unclear> <unclear cert="low" resp="#joint">e</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Sanct</unclear> <unclear cert="low" resp="#joint">Gallen</unclear> <unclear cert="low" resp="#joint">wid</unclear>-
<lb n="23"/><unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">irem</unclear> <unclear cert="low" resp="#joint">begären</unclear> <unclear cert="low" resp="#joint">andtwort</unclear> finden. Und <unclear cert="low" resp="#joint">las</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">luter</unclear> <unclear cert="low" resp="#joint">wüßen</unclear>. Zu
<lb n="24"/>wöllens komen ist, deßen allerdingen ze spruchen könen,
<lb n="25"/>wir wellen luter hiemit zuo dir <unclear cert="low" resp="#joint">versehen</unclear>. <unclear cert="low" resp="#joint">Du</unclear> <unclear cert="low" resp="#joint">werdest</unclear> <unclear cert="low" resp="#joint">dßelbige</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">stundtlich</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">erschinen</unclear> <unclear cert="low" resp="#joint">statt</unclear> <unclear cert="low" resp="#joint">thun</unclear>, Das <unclear cert="low" resp="#joint">wiß</unclear> <unclear cert="low" resp="#joint">dich</unclear> <unclear cert="low" resp="#joint">zuo</unclear>
