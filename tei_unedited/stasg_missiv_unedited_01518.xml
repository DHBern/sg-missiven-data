<p>
<pb facs="StadtASG_Missive_1518_5471.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich <unclear cert="medium" resp="#joint">nachpürlich</unclear> willig dienst unnd
<lb n="2"/><unclear cert="medium" resp="#joint">gruetz</unclear>, und was wir <unclear cert="low" resp="#joint">ehren</unclear> liebs und <unclear cert="medium" resp="#joint">guetz</unclear> vermögend
<lb n="3"/><unclear cert="medium" resp="#joint">zuo</unclear> vor fromm fürsichtig <unclear cert="low" resp="#joint">ehrsam</unclear> <unclear cert="low" resp="#joint">wiß</unclear>, in sonders
<lb n="4"/>guot fründ und <unclear cert="low" resp="#joint">gethrüw</unclear> lieb <unclear cert="medium" resp="#joint">Nachpuren</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">dan</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">kurtz</unclear> <unclear cert="medium" resp="#joint">ver</unclear> <unclear cert="medium" resp="#joint">schiner</unclear> <unclear cert="medium" resp="#joint">zit</unclear> gott der <unclear cert="low" resp="#joint">allmechtig</unclear> <unclear cert="low" resp="#joint">den</unclear> ehr-
<lb n="6"/>würdigen herren <persName resp="#ner"><unclear cert="low" resp="#joint">Hanß</unclear> Jacob <unclear cert="low" resp="#joint">Girtanner</unclear></persName> <unclear cert="low" resp="#joint">gewessnen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">pfarher</unclear> zuo <placeName ref="stadtasg-places-102" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Hundwylen</unclear></placeName>, zuo <unclear cert="medium" resp="#joint">sinen</unclear> göttlichen gnaden
<lb n="8"/><unclear cert="low" resp="#joint">beruefft</unclear>, <unclear cert="medium" resp="#joint">deß</unclear> wegen <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">landtlüth</unclear>,
<lb n="9"/>houptman und <unclear cert="low" resp="#joint">räth</unclear>, in namen einer gantzen <unclear cert="medium" resp="#joint">gmeind</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">kilchöri</unclear> <placeName ref="stadtasg-places-102" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Hundwyllen</unclear></placeName>, vor <unclear cert="low" resp="#joint">unß</unclear> er <unclear cert="low" resp="#joint">schinen</unclear> umb
<lb n="11"/>hilff unnd <unclear cert="low" resp="#joint">rath</unclear>, umb <unclear cert="medium" resp="#joint">einen</unclear> anderen <unclear cert="low" resp="#joint">Vorstender</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">göttliches</unclear> <unclear cert="low" resp="#joint">worts</unclear>, mit an meldung wie dz jetz ein
<lb n="13"/>zit <unclear cert="medium" resp="#joint">har</unclear>, der <unclear cert="medium" resp="#joint">ehrwürdig</unclear> herr <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Alther</unclear></persName>,
<lb n="14"/>üwer Burger, die <unclear cert="low" resp="#joint">kantzlen</unclear> alda by <unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">ver</unclear> <unclear cert="low" resp="#joint">sehen</unclear>
<lb n="15"/>in <unclear cert="low" resp="#joint">wellichen</unclear> zit er inen so wol gefallen, mit
<lb n="16"/><unclear cert="medium" resp="#joint">siner</unclear> lehr thun und wandel, dz er inen der
<lb n="17"/>maßen so wol geliebet, mit <unclear cert="low" resp="#joint">fründtlichen</unclear> <unclear cert="low" resp="#joint">be</unclear> <unclear cert="medium" resp="#joint">sunchen</unclear>
<lb n="18"/>an <unclear cert="low" resp="#joint">ine</unclear>, ob er gar <unclear cert="low" resp="#joint">möchti</unclear> by inen sin und bliben.
<lb n="19"/><unclear cert="low" resp="#joint">Welliches</unclear> <unclear cert="low" resp="#joint">be</unclear> <unclear cert="low" resp="#joint">sunchen</unclear> er nit <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">ver</unclear> <unclear cert="low" resp="#joint">worffen</unclear>
<lb n="20"/>so ver und <unclear cert="low" resp="#joint">wÿt</unclear>, <unclear cert="medium" resp="#joint">wenn</unclear> es sinen gnedigen herren
<lb n="21"/>und <unclear cert="low" resp="#joint">oberen</unclear> <unclear cert="low" resp="#joint">Burger</unclear> <unclear cert="low" resp="#joint">meister</unclear> und Rath <unclear cert="low" resp="#joint">gefalle</unclear>, den
<lb n="22"/>er wider <unclear cert="low" resp="#joint">iren</unclear> willen nit <unclear cert="low" resp="#joint">gesinet</unclear>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">wegen</unclear>
<lb n="23"/>sy <unclear cert="medium" resp="#joint">unß</unclear> gantz <unclear cert="low" resp="#joint">fründlich</unclear> <unclear cert="low" resp="#joint">piten</unclear> <unclear cert="low" resp="#joint">de</unclear>, <unclear cert="low" resp="#joint">unß</unclear> ein <unclear cert="low" resp="#joint">fürgschrifft</unclear>
<lb n="24"/>an üch gelangen <unclear cert="low" resp="#joint">laßen</unclear>, dan er inen der maßen
<lb n="25"/>wie oben gemelt, so wol geliebet, dz wo es jemer
<lb n="26"/><unclear cert="low" resp="#joint">müglich</unclear>, mit <unclear cert="medium" resp="#joint">großem</unclear> wol gefallen by inen
<lb n="27"/>haben möchtend. <unclear cert="low" resp="#joint">Langt</unclear> <unclear cert="low" resp="#joint">derhalben</unclear> von <unclear cert="medium" resp="#joint">iretwegen</unclear>
<lb n="28"/>unser gantz fründtlich unnd nachpürlich <unclear cert="low" resp="#joint">pöt</unclear> an üch
<lb n="29"/>wellend inen von <unclear cert="medium" resp="#joint">gueter</unclear> <unclear cert="medium" resp="#joint">Nachpurschafft</unclear> wegen
<pb facs="StadtASG_Missive_1518_5472.jpg" n="2"/>
<lb n="30"/>gedachten <unclear cert="low" resp="#joint">hern</unclear> <persName resp="#ner">Jacoben</persName> guenstigklichen verwilligen,
<lb n="31"/>in betrachtung dz <unclear cert="medium" resp="#joint">uerb</unclear> in <unclear cert="low" resp="#joint">guotem</unclear> <unclear cert="low" resp="#joint">schuz</unclear> und schirm
<lb n="32"/>und <unclear cert="medium" resp="#joint">dz</unclear> sy <unclear cert="medium" resp="#joint">einen</unclear> <unclear cert="medium" resp="#joint">guoten</unclear> willen <unclear cert="medium" resp="#joint">zuo</unclear> üch als unseren
<lb n="33"/>guoten fründen und lieben <unclear cert="low" resp="#joint">nachpuren</unclear> <unclear cert="low" resp="#joint">tragend</unclear>,
<lb n="34"/>und <unclear cert="low" resp="#joint">hienebend</unclear> unser <unclear cert="low" resp="#joint">fürgschrifft</unclear> <unclear cert="low" resp="#joint">gschpueren</unclear> und
<lb n="35"/>erkennen moegend, daran uns ouch <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">ouch</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">begernend</unclear> ein <unclear cert="low" resp="#joint">wolgefallen</unclear> <unclear cert="low" resp="#joint">bschicht</unclear>, sind ouch des
<lb n="37"/><unclear cert="medium" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">erpietens</unclear>, wo wir solliche nachpürliche
<lb n="38"/><unclear cert="low" resp="#joint">fründtschafft</unclear> <unclear cert="low" resp="#joint">koenend</unclear> in ander weg <unclear cert="low" resp="#joint">bschulden</unclear>,
<lb n="39"/><unclear cert="low" resp="#joint">wellend</unclear> wir uns <unclear cert="medium" resp="#joint">gneigt</unclear> erzeigen, wie wir <unclear cert="low" resp="#joint">dan</unclear>
<lb n="40"/>gegen üch <unclear cert="medium" resp="#joint">gsinet</unclear> <unclear cert="medium" resp="#joint">alle</unclear> <unclear cert="medium" resp="#joint">guote</unclear> nachpürliche trüw <unclear cert="medium" resp="#joint">zuo</unclear>
<lb n="41"/>bewysen. Hiemit üch und uns samptlich in
<lb n="42"/>Gottes <unclear cert="medium" resp="#joint">schuz</unclear> <unclear cert="medium" resp="#joint">und</unclear> schirm <unclear cert="low" resp="#joint">wolbeuelchende</unclear>. <unclear cert="low" resp="#joint">Acto</unclear>
<lb n="43"/>den <origDate when="1601-09-22" resp="#ner">22 <unclear cert="medium" resp="#joint">t</unclear> Septembris anno <unclear cert="low" resp="#joint">1601</unclear></origDate>.
<lb n="44"/><orgName ref="stadtasg-actors-565" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Landtamman</unclear> und rath der usseren
<lb n="45"/>Roden des <unclear cert="low" resp="#joint">lantz</unclear> Appenzell</orgName>.
<pb facs="StadtASG_Missive_1518_5473.jpg" n="3"/>
<pb facs="StadtASG_Missive_1518_5474.jpg" n="4"/>
<lb n="46"/><unclear cert="medium" resp="#joint">Denn</unclear> frommen fuersichtigen <unclear cert="medium" resp="#joint">ersammen</unclear> unnd
<lb n="47"/>weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">burgermaister</unclear> und rath der statt
<lb n="48"/>Sant <unclear cert="medium" resp="#joint">Gallenn</unclear></orgName>, <unclear cert="medium" resp="#joint">unsern</unclear> insonders guoten
<lb n="49"/><unclear cert="medium" resp="#joint">fruenden</unclear> und <unclear cert="medium" resp="#joint">getruewen</unclear> lieben <unclear cert="low" resp="#joint">nachpuren</unclear>.
</p>
