<lb n="3"/>ersamen unnd <unclear cert="low" resp="#joint">wyßen</unclear> <unclear cert="medium" resp="#joint">insonders</unclear> <unclear cert="low" resp="#joint">günstig</unclear> <unclear cert="low" resp="#joint">guot</unclear> <unclear cert="low" resp="#joint">fründ</unclear> und <unclear cert="low" resp="#joint">getrüw</unclear>
