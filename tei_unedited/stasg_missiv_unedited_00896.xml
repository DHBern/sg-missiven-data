<lb n="41"/><unclear cert="medium" resp="#joint">dar</unclear> <unclear cert="medium" resp="#joint">nebend</unclear> <unclear cert="medium" resp="#joint">wollend</unclear> ir so <unclear cert="low" resp="#joint">früntlichs</unclear> <unclear cert="low" resp="#joint">nachpürlichs</unclear>
