<lb n="29"/><unclear cert="medium" resp="#joint">un</unclear> <unclear cert="medium" resp="#joint">lidenlichs</unclear> gegen <unclear cert="medium" resp="#joint">unß</unclear> ald den <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">fal</unclear> glicher
