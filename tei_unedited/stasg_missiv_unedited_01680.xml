<pb facs="StadtASG_Missive_1680_6139.jpg" n="5"/>
<pb facs="StadtASG_Missive_1680_6140.jpg" n="6"/>
<lb n="28"/>A <unclear cert="low" resp="#joint">Nobles</unclear> <unclear cert="low" resp="#joint">et</unclear> puissans
<lb n="29"/>Seigneurs
<lb n="30"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Les Seigneurs Bourguemaistre
<lb n="31"/>et conseil de la ville de S. Gal.</orgName>
<lb n="32"/>A <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">S. Gal.</placeName>
