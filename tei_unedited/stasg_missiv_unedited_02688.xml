<p>
<pb facs="StadtASG_Missive_2688_10441.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> freündtlich willig dienst, <unclear cert="medium" resp="#joint">samt</unclear> was
<lb n="2"/>wir ehren liebs und guots vermögen <unclear cert="medium" resp="#joint">zuovor</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">from</unclear> fürsichtig <unclear cert="medium" resp="#joint">eersam</unclear> weiß, insonders guot
<lb n="4"/>freündt und <unclear cert="medium" resp="#joint">getreüw</unclear> lieb <orgName role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eütgnoßen</unclear></orgName>.
<lb n="5"/>Was <unclear cert="medium" resp="#joint">ihr</unclear>, wegen <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">verburgreten</unclear> <unclear cert="medium" resp="#joint">herren</unclear>
<lb n="6"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Joachim</unclear> <unclear cert="medium" resp="#joint">Lowrenzen</unclear></persName> und <persName resp="#ner"><unclear cert="medium" resp="#joint">David</unclear> <unclear cert="medium" resp="#joint">Zollikoffern</unclear></persName>, <unclear cert="medium" resp="#joint">beÿ</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">eignem</unclear> botten <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">uns</unclear> schrifftlich <unclear cert="medium" resp="#joint">langen</unclear> <unclear cert="medium" resp="#joint">laßen</unclear>, das
<lb n="8"/>haben wir wol verstanden, und <unclear cert="medium" resp="#joint">darauff</unclear>
<lb n="9"/>nit <unclear cert="medium" resp="#joint">ermanglet</unclear>, <unclear cert="medium" resp="#joint">ihnen</unclear> solch <unclear cert="medium" resp="#joint">eüwer</unclear> schreiben <unclear cert="medium" resp="#joint">eii</unclear>-
<lb n="10"/><unclear cert="medium" resp="#joint">zuhändigen</unclear>, und <unclear cert="medium" resp="#joint">ferners</unclear> die gebür an sie ge-
<lb n="11"/><unclear cert="medium" resp="#joint">sinnen</unclear> <unclear cert="medium" resp="#joint">zulaßen</unclear>.
<lb n="12"/>Welcher gestalt <unclear cert="medium" resp="#joint">nun</unclear> dieselbigen <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">beant</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">wortet</unclear>, <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">getreüw</unclear> lieb
<lb n="14"/><unclear cert="low" resp="#joint">Eütgnoßen</unclear> <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">ihrem</unclear> schrifftlich über-
<lb n="15"/><unclear cert="low" resp="#joint">reüchten</unclear> <unclear cert="low" resp="#joint">innschluß</unclear> <unclear cert="low" resp="#joint">mehrers</unclear> <unclear cert="low" resp="#joint">innhalts</unclear> ver-
<lb n="16"/><unclear cert="medium" resp="#joint">nemen</unclear>.
<lb n="17"/>Und <unclear cert="medium" resp="#joint">weilen</unclear> uns <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">zweiflet</unclear> ihre
<lb n="18"/><unclear cert="medium" resp="#joint">eingewendte</unclear> motiven
<lb n="19"/>und anerbieten werden zu <unclear cert="medium" resp="#joint">ihrer</unclear> <unclear cert="medium" resp="#joint">ent</unclear>-
<lb n="20"/><unclear cert="medium" resp="#joint">schuldigung</unclear> <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> wol statt finden; <unclear cert="medium" resp="#joint">also</unclear>
<lb n="21"/>haben wir sie <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">dißmalen</unclear> <unclear cert="low" resp="#joint">füerneres</unclear> nit
<lb n="22"/>wol <unclear cert="medium" resp="#joint">nötigen</unclear> <unclear cert="medium" resp="#joint">können</unclear>.
<lb n="23"/>Wolten wir <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">getreüw</unclear> lieb <unclear cert="medium" resp="#joint">Eüdt</unclear>-
<lb n="24"/><unclear cert="medium" resp="#joint">gnoßen</unclear>, als <unclear cert="medium" resp="#joint">denen</unclear> wir sonst zu <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">Eüdt</unclear>-
<lb n="25"/><unclear cert="low" resp="#joint">gnösische</unclear> <unclear cert="low" resp="#joint">freündtschafft</unclear> <unclear cert="low" resp="#joint">erweisung</unclear>, <unclear cert="low" resp="#joint">willig</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">verbliben</unclear>, <unclear cert="low" resp="#joint">antwortlich</unclear> nit verhalten, <unclear cert="medium" resp="#joint">zumahl</unclear>
<lb n="27"/>uns <unclear cert="medium" resp="#joint">göttlicher</unclear> obhalt uns wol <unclear cert="medium" resp="#joint">befelhende</unclear>.
<lb n="28"/><unclear cert="medium" resp="#joint">Dath</unclear> den. <origDate when="1628" resp="#ner"><unclear cert="low" resp="#joint">30</unclear> <unclear cert="low" resp="#joint">kl</unclear>. <unclear cert="low" resp="#joint">Maÿ</unclear>. 1628</origDate>.
<lb n="29"/><unclear cert="medium" resp="#joint">B</unclear>.
<lb n="30"/>an <origPlace ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schaffhausen</unclear></origPlace>.
<pb facs="StadtASG_Missive_2688_10442.jpg" n="2"/>
</p>
