<lb n="31"/><unclear cert="low" resp="#joint">bruch</unclear> unnd <unclear cert="low" resp="#joint">gwonheiten</unclear> (<unclear cert="low" resp="#joint">unseres</unclear> <unclear cert="low" resp="#joint">erachtens</unclear>,) <unclear cert="medium" resp="#joint">zuo</unclear>
<lb n="32"/>sölchen <unclear cert="low" resp="#joint">krefften</unclear> <unclear cert="low" resp="#joint">khomen</unclear>, das <unclear cert="low" resp="#joint">sölcher</unclear> nit <unclear cert="low" resp="#joint">lüchtlich</unclear>
