<lb n="58"/>Eidtgnossen. Dem allem nach, und
<lb n="59"/><unclear cert="medium" resp="#joint">dwyl</unclear> wir <unclear cert="low" resp="#joint">hieruß</unclear> nit <unclear cert="medium" resp="#joint">anders</unclear> <unclear cert="low" resp="#joint">khönnend</unclear> <unclear cert="low" resp="#joint">schlüßen</unclear>,
