<lb n="44"/>ein <unclear cert="low" resp="#joint">sölcher</unclear> <unclear cert="low" resp="#joint">inganng</unclear> in <unclear cert="medium" resp="#joint">unser</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoschafft</unclear></orgName>
<lb n="45"/>gemacht unnd <unclear cert="low" resp="#joint">ingefüert</unclear> wurde, das <unclear cert="medium" resp="#joint">hieruß</unclear>
