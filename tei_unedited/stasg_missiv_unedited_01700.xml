        <body>
<p>
<pb facs="StadtASG_Missive_1700_6225.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">fründtlich</unclear> willig dienst zuvor
<lb n="2"/><unclear cert="medium" resp="#joint">Fürsichtigen</unclear>, Ersamen und <unclear cert="low" resp="#joint">Wisen</unclear>,
<lb n="3"/>besonders liebe <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">Fründt</unclear>,
<lb n="4"/>und <unclear cert="low" resp="#joint">Nachburn</unclear>.
<lb n="5"/>Uf derselben den <date resp="#ner">26te. diß</date> an
<lb n="6"/><unclear cert="medium" resp="#joint">uns</unclear> abgangen <unclear cert="low" resp="#joint">fründtlich</unclear> schriben
<lb n="7"/>und <unclear cert="medium" resp="#joint">begeren</unclear>, so wir <unclear cert="medium" resp="#joint">samt</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">beschuß</unclear> <unclear cert="medium" resp="#joint">beygelegnen</unclear> <unclear cert="medium" resp="#joint">wexel</unclear> <unclear cert="medium" resp="#joint">und</unclear>
<lb n="9"/>20 <unclear cert="medium" resp="#joint">fl</unclear>. <unclear cert="medium" resp="#joint">Leütten</unclear> vom ordinarij botten
<lb n="10"/>enpfangen, haben wir nicht
<lb n="11"/>ermanglet, <unclear cert="low" resp="#joint">angedeütte</unclear> <unclear cert="low" resp="#joint">wexel</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">angehendts</unclear> durch <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">leinwath</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">greder</unclear> wie sich gebürt probieren
<lb n="14"/>zelassen. Di haben nun
<lb n="15"/><unclear cert="low" resp="#joint">hiemit</unclear> solche uf die prob
<lb n="16"/>an halt und <unclear cert="low" resp="#joint">gehalt</unclear> <unclear cert="medium" resp="#joint">befunden</unclear>,
<lb n="17"/>wie E. <unclear cert="medium" resp="#joint">Fl</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear> <unclear cert="medium" resp="#joint">hiemit</unclear>
<lb n="18"/>In biylag zu <unclear cert="low" resp="#joint">vernemen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">Uud</unclear> demnach uns <unclear cert="low" resp="#joint">unsere</unclear> getreüwe
<lb n="20"/>liebe <unclear cert="low" resp="#joint">bürger</unclear> <persName resp="#ner">Caspar <unclear cert="medium" resp="#joint">Schobinger</unclear></persName>
<lb n="21"/>und <persName resp="#ner"><unclear cert="low" resp="#joint">Barthlime</unclear> <unclear cert="low" resp="#joint">Zollikoffer</unclear></persName>, so
<lb n="22"/>bewüsster wexel halber iüngst
<lb n="23"/>hin in E. <unclear cert="medium" resp="#joint">Fl</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear> <unclear cert="medium" resp="#joint">Statt</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">gereyßt</unclear>, <unclear cert="medium" resp="#joint">des</unclear> <unclear cert="medium" resp="#joint">ansehnlichen</unclear>,
<lb n="25"/>ihnen <unclear cert="medium" resp="#joint">erwißnen</unclear> <unclear cert="medium" resp="#joint">Ehrung</unclear>, <unclear cert="medium" resp="#joint">wegen</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">guetter</unclear> <unclear cert="medium" resp="#joint">nachburlicher</unclear> <unclear cert="medium" resp="#joint">wolgewogenheit</unclear>
<lb n="27"/>willen sie in ihren <unclear cert="low" resp="#joint">anligendten</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">bewendnußen</unclear>; <unclear cert="low" resp="#joint">solch</unclear> <unclear cert="low" resp="#joint">wegen</unclear>
<pb facs="StadtASG_Missive_1700_6226.jpg" n="2"/>
<lb n="29"/><unclear cert="low" resp="#joint">vielfaeltig</unclear> <unclear cert="low" resp="#joint">ehr</unclear>, <unclear cert="low" resp="#joint">zuogemuetheite</unclear> <unclear cert="low" resp="#joint">freüntschafft</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">vererhung</unclear> <unclear cert="low" resp="#joint">weins</unclear> und <unclear cert="low" resp="#joint">bezalung</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">kuchens</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">sin</unclear> in <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">herberg</unclear> <unclear cert="low" resp="#joint">bewisen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">erzeigt</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">worden</unclear>, da <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">wol</unclear> <unclear cert="medium" resp="#joint">erachten</unclear> <unclear cert="medium" resp="#joint">koennen</unclear>
<lb n="33"/>daß solches nit <unclear cert="medium" resp="#joint">nur</unclear> wegen <unclear cert="medium" resp="#joint">ihren</unclear>
<lb n="34"/><unclear cert="medium" resp="#joint">persohnen</unclear>, sonder auch uns <unclear cert="medium" resp="#joint">zuo</unclear> ehren
<lb n="35"/>und <unclear cert="low" resp="#joint">freündt</unclear> <unclear cert="low" resp="#joint">nachbawrlichen</unclear> gefallen
<lb n="36"/><unclear cert="medium" resp="#joint">bschehen</unclear> <unclear cert="medium" resp="#joint">sige</unclear>, wie wir dann
<lb n="37"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">selbig</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">sondere</unclear> gestalt nicht
<lb n="38"/><unclear cert="low" resp="#joint">uofnemmen</unclear>.
<lb n="39"/><unclear cert="low" resp="#joint">Deß</unclear> haben <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">N</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. wir
<lb n="40"/><unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">zugleich</unclear> <unclear cert="low" resp="#joint">freündtnachbawrlich</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">danckhen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">beneben</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">hingegen</unclear>
<lb n="42"/>anerbieten <unclear cert="medium" resp="#joint">woellen</unclear>, <unclear cert="medium" resp="#joint">wo</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">umb</unclear>
<lb n="43"/>die <unclear cert="medium" resp="#joint">dieselbe</unclear> oder <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">ihrige</unclear>, <unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="medium" resp="#joint">er</unclear>
<lb n="44"/><unclear cert="medium" resp="#joint">wißne</unclear> <unclear cert="medium" resp="#joint">erzeigte</unclear> <unclear cert="medium" resp="#joint">ehr</unclear> in <unclear cert="medium" resp="#joint">glichen</unclear> oder
<lb n="45"/>sonst mit <unclear cert="medium" resp="#joint">erweisung</unclear> aller <unclear cert="low" resp="#joint">gueten</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">nachbarschafft</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">sonst</unclear> <unclear cert="low" resp="#joint">angenemmer</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">erweisung</unclear> <unclear cert="low" resp="#joint">koennen</unclear> beschulden
<lb n="48"/>daß solches mit <unclear cert="medium" resp="#joint">guetem</unclear> willen und
<lb n="49"/><unclear cert="medium" resp="#joint">gmuet</unclear> <unclear cert="medium" resp="#joint">bschehen</unclear> solle, <unclear cert="medium" resp="#joint">alß</unclear> wir
<lb n="50"/>Gott bitten, daß Er, die <unclear cert="medium" resp="#joint">und</unclear>
<lb n="51"/>uns in <unclear cert="low" resp="#joint">sinem</unclear> <unclear cert="low" resp="#joint">gnadenschirm</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">langwirig</unclear> erhalten welle. Datum
<lb n="53"/><origDate when="1620-08-24" resp="#ner">den <unclear cert="medium" resp="#joint">24ten</unclear> <unclear cert="medium" resp="#joint">Augustj</unclear> Anno <unclear cert="low" resp="#joint">1620</unclear></origDate>.
<lb n="54"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und Rhat
<lb n="55"/>der Statt <unclear cert="low" resp="#joint">Sant</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></orgName>.
<lb n="56"/>An <unclear cert="low" resp="#joint">herren</unclear> <orgName ref="stadtasg-actors-511" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und
<lb n="57"/>Rhat der Statt <unclear cert="medium" resp="#joint">Lindaw</unclear></orgName>.
<pb facs="StadtASG_Missive_1700_6227.jpg" n="3"/>
<pb facs="StadtASG_Missive_1700_6228.jpg" n="4"/>
</p>
