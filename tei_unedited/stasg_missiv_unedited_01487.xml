<lb n="15"/><unclear cert="low" resp="#joint">eüwer</unclear> <unclear cert="low" resp="#joint">fürnemeste</unclear> <unclear cert="low" resp="#joint">heüpter</unclear> und <unclear cert="low" resp="#joint">Rhatsverwandte</unclear>,
