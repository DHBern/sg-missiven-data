<p>
<pb facs="StadtASG_Missive_2886_11345.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unsern</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear> willig dienst und was wir ehren, liebs und guots
<lb n="2"/>vermögend, zuovor, fromm, fürsichtig, <unclear cert="medium" resp="#joint">ehrsam</unclear>, <unclear cert="medium" resp="#joint">wyß</unclear>, <unclear cert="medium" resp="#joint">insonders</unclear>
<lb n="3"/>guot <unclear cert="medium" resp="#joint">freünd</unclear> und <unclear cert="medium" resp="#joint">getreüw</unclear> lieb <orgName role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoßen</unclear></orgName>,
<lb n="4"/><unclear cert="medium" resp="#joint">Alsdann</unclear> uns <unclear cert="medium" resp="#joint">albereit</unclear> ein schryben von <unclear cert="low" resp="#joint">üweren</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unseren</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">R</unclear>. <unclear cert="low" resp="#joint">gemeinen</unclear> <unclear cert="low" resp="#joint">3en</unclear> <unclear cert="low" resp="#joint">Pündten</unclear> an <unclear cert="medium" resp="#joint">alle</unclear> ort und <unclear cert="low" resp="#joint">zuogewandte</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">lobl.er</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydtgnoßschaft</unclear></orgName> abgangen, <unclear cert="medium" resp="#joint">zuokomen</unclear>, mit <unclear cert="low" resp="#joint">begehr</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">ieder</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">ort</unclear> an <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">gestelt</unclear>, <unclear cert="medium" resp="#joint">ehist</unclear> <unclear cert="medium" resp="#joint">zuoaviseren</unclear>, habend wir <unclear cert="low" resp="#joint">keinen</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">umbgang</unclear> <unclear cert="low" resp="#joint">nemmen</unclear> <unclear cert="low" resp="#joint">söllen</unclear>, <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">Eydtgnoßen</unclear> <unclear cert="low" resp="#joint">einer</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">sölchen</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">copeylichen</unclear> <unclear cert="low" resp="#joint">biyschluß</unclear>, <unclear cert="low" resp="#joint">sowol</unclear> als <unclear cert="medium" resp="#joint">gegen</unclear> <unclear cert="medium" resp="#joint">übrigen</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">orten</unclear> allen <unclear cert="low" resp="#joint">beschieht</unclear>, <unclear cert="low" resp="#joint">alsbald</unclear> auch <unclear cert="low" resp="#joint">theilhaft</unclear> <unclear cert="low" resp="#joint">zemachen</unclear>. <unclear cert="low" resp="#joint">Üch</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">sihe</unclear> <unclear cert="low" resp="#joint">hieby</unclear> nebent <unclear cert="medium" resp="#joint">erbiatung</unclear> aller <unclear cert="medium" resp="#joint">behäglichen</unclear> <unclear cert="medium" resp="#joint">eydtgnößisch=</unclear>
<lb n="12"/>en diensten und <unclear cert="medium" resp="#joint">freündtschaft</unclear> den <unclear cert="medium" resp="#joint">allgütigen</unclear> <unclear cert="medium" resp="#joint">Gott</unclear> <unclear cert="medium" resp="#joint">hertz=</unclear>
<lb n="13"/>lich bittend, <unclear cert="medium" resp="#joint">er</unclear> uns <unclear cert="medium" resp="#joint">allersyts</unclear> under sinem <unclear cert="medium" resp="#joint">gwaltigen</unclear> schirm
<lb n="14"/><unclear cert="medium" resp="#joint">ferner</unclear> <unclear cert="medium" resp="#joint">gnädigklich</unclear> <unclear cert="medium" resp="#joint">zuoerhalten</unclear> <unclear cert="medium" resp="#joint">geruohe</unclear>. <unclear cert="medium" resp="#joint">Dat</unclear>. <origDate when="1632" resp="#ner">den 11.ten <unclear cert="medium" resp="#joint">Januarii</unclear>
<lb n="15"/>anno <unclear cert="medium" resp="#joint">1632</unclear></origDate>.
<lb n="16"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">rhat</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">statt</unclear> Zürich</orgName>.
<pb facs="StadtASG_Missive_2886_11346.jpg" n="2"/>
<pb facs="StadtASG_Missive_2886_11347.jpg" n="3"/>
<pb facs="StadtASG_Missive_2886_11348.jpg" n="4"/>
<lb n="18"/>Den frommen fürsichtigen ehr-
<lb n="19"/>samen wÿsen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermeister
<lb n="20"/>und rath der statt St. Gallen</orgName>,
<lb n="21"/>unsseren insonders gueten
<lb n="22"/>fründen und getrüwen lieben
<lb n="23"/>eidtgnossen.
</p>
