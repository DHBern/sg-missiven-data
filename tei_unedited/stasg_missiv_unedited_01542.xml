<lb n="40"/>ein <unclear cert="medium" resp="#joint">schedliche</unclear> <unclear cert="medium" resp="#joint">grosse</unclear> <unclear cert="low" resp="#joint">brunst</unclear>, <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">mercklichem</unclear>
<lb n="41"/>nachteil, <unclear cert="low" resp="#joint">gfahr</unclear> unnd schaden, nit nur <unclear cert="medium" resp="#joint">gmeiner</unclear>
<lb n="42"/><unclear cert="medium" resp="#joint">Drygen</unclear> <unclear cert="medium" resp="#joint">Puendten</unclear>, <unclear cert="medium" resp="#joint">sonders</unclear> einer gantzen <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eidt=
<lb n="43"/>gnoschafft</orgName> <unclear cert="low" resp="#joint">unsers</unclear> geliebten <unclear cert="medium" resp="#joint">vatterlandts</unclear>, wo
<lb n="44"/>man dem nit <unclear cert="medium" resp="#joint">weret</unclear>, <unclear cert="medium" resp="#joint">ußbraechen</unclear> moechte, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="45"/>wir <unclear cert="low" resp="#joint">allersydts</unclear> wol darmit <unclear cert="medium" resp="#joint">zeschaffen</unclear> <unclear cert="low" resp="#joint">uberkhoemen</unclear>,
<lb n="46"/>wir auch nit <unclear cert="low" resp="#joint">wueßen</unclear> <unclear cert="medium" resp="#joint">moegend</unclear>, waß durch
<lb n="47"/>unsere <unclear cert="low" resp="#joint">wolgmeinte</unclear> botschafft <unclear cert="low" resp="#joint">sendung</unclear> uß=
<lb n="48"/>gerichtet werden mag, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">zuobesorgen</unclear>, diser
<lb n="49"/><unclear cert="low" resp="#joint">handel</unclear> nit <unclear cert="medium" resp="#joint">alß</unclear> bald <unclear cert="low" resp="#joint">zuegstillen</unclear>, So
<lb n="50"/><unclear cert="medium" resp="#joint">hatt</unclear> unß <unclear cert="low" resp="#joint">inansehen</unclear> diser sachen wichtigkeit,
<lb n="51"/>unnd daruff <unclear cert="medium" resp="#joint">sechenden</unclear> gfahr unnd <unclear cert="low" resp="#joint">nachteilg=</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">keit</unclear> <unclear cert="low" resp="#joint">gmeine</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidtgnoschafft</unclear></orgName> <unclear cert="low" resp="#joint">berueren</unclear> <unclear cert="low" resp="#joint">thuott</unclear>:
<lb n="53"/>fuer gantz nothwendig <unclear cert="low" resp="#joint">angesehen</unclear>, ein <unclear cert="medium" resp="#joint">gmeine</unclear>
<lb n="54"/>Eidtgnößische tagleistung <unclear cert="medium" resp="#joint">zuobeschryben</unclear>, da=
<lb n="55"/>mit man inn diser sach <unclear cert="medium" resp="#joint">was</unclear> die <unclear cert="medium" resp="#joint">gebuer</unclear>
<lb n="56"/>und <unclear cert="low" resp="#joint">notturfft</unclear> <unclear cert="low" resp="#joint">erforderet</unclear>, mit <unclear cert="low" resp="#joint">gmeinem</unclear>
<lb n="57"/>rath und <unclear cert="low" resp="#joint">zuthuon</unclear> handlen, und sonderlichen auch
<lb n="58"/>von deß froembden kriegßvolcks wegen, so <unclear cert="low" resp="#joint">sider</unclear>
<lb n="59"/>wenig tagen durch ein <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnoschafft</unclear></orgName> gezogen
<lb n="60"/>und <unclear cert="low" resp="#joint">nachzuecht</unclear>, und sich inn der <unclear cert="low" resp="#joint">nähe</unclear> an
<lb n="61"/>den <unclear cert="medium" resp="#joint">grentzen</unclear> <unclear cert="low" resp="#joint">uffhaltet</unclear>, da man nit <unclear cert="low" resp="#joint">weißt</unclear>
<lb n="62"/>wohin es alles <unclear cert="low" resp="#joint">gemeint</unclear> ist, <unclear cert="low" resp="#joint">und</unclear> man <unclear cert="low" resp="#joint">soellicher</unclear>
<lb n="63"/>durchzuegen und <unclear cert="low" resp="#joint">nächenens</unclear> froembden volcks
<lb n="64"/>billich <unclear cert="medium" resp="#joint">warnemmen</unclear> soll, wie <unclear cert="medium" resp="#joint">vormalen</unclear> <unclear cert="medium" resp="#joint">zuo</unclear>
<lb n="65"/>tagen <unclear cert="low" resp="#joint">verabscheidet</unclear> worden, mit <unclear cert="low" resp="#joint">einanderen</unclear>
<lb n="66"/><unclear cert="low" resp="#joint">redhalten</unclear>, und dahin trachten <unclear cert="low" resp="#joint">khoenne</unclear>, daß
<lb n="67"/><unclear cert="medium" resp="#joint">alle</unclear> <unclear cert="medium" resp="#joint">besorgende</unclear> <unclear cert="medium" resp="#joint">gfahr</unclear> unnd <unclear cert="medium" resp="#joint">unheil</unclear> durch
