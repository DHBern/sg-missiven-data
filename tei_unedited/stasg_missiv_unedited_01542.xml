<lb n="68"/><unclear cert="medium" resp="#joint">zytlichem</unclear> <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">rath</unclear> <unclear cert="medium" resp="#joint">abgewendt</unclear>, unnd nit <unclear cert="low" resp="#joint">nuen</unclear>
<lb n="69"/>Inn pündten frid ruow und <unclear cert="low" resp="#joint">einighkeit</unclear> unnd
<lb n="70"/>ein <unclear cert="low" resp="#joint">ordenlichs</unclear> <unclear cert="low" resp="#joint">wäsen</unclear> erhalten, <unclear cert="low" resp="#joint">sonders</unclear> auch
<lb n="71"/><unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">gemeine</unclear> <unclear cert="medium" resp="#joint">vatterlandt</unclear> <unclear cert="medium" resp="#joint">Inn</unclear> <unclear cert="low" resp="#joint">friden</unclear>, <unclear cert="medium" resp="#joint">sicherheit</unclear>
<lb n="72"/>unnd <unclear cert="medium" resp="#joint">wolstanndt</unclear> behalten, unnd <unclear cert="low" resp="#joint">under</unclear>
<lb n="73"/><unclear cert="medium" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">allersydts</unclear> <unclear cert="medium" resp="#joint">Inn</unclear> <unclear cert="medium" resp="#joint">guetem</unclear> <unclear cert="medium" resp="#joint">eidtgnößischen</unclear>
