<lb n="49"/>It <persName resp="#ner"><unclear cert="low" resp="#joint">Haineeli</unclear> <unclear cert="low" resp="#joint">Beuttel</unclear></persName> hat <unclear cert="low" resp="#joint">im</unclear> an <unclear cert="low" resp="#joint">duoch</unclear> zuo <unclear cert="low" resp="#joint">kofte</unclear>
