<lb n="16"/><unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">zwainzig</unclear> <unclear cert="low" resp="#joint">elenn</unclear> <unclear cert="low" resp="#joint">geschnitten</unclear> <unclear cert="low" resp="#joint">wordenn</unclear>.
<lb n="17"/><unclear cert="low" resp="#joint">Söulichs</unclear> <unclear cert="low" resp="#joint">habennd</unclear> wir üch <unclear cert="low" resp="#joint">nachpürlicher</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">mÿn</unclear> <unclear cert="low" resp="#joint">unberricht</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">lassenn</unclear> <unclear cert="low" resp="#joint">söllenn</unclear>, <unclear cert="low" resp="#joint">diewil</unclear>
