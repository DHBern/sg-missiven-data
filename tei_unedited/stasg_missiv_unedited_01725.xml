<lb n="45"/><persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Muellir</unclear></persName>
<lb n="46"/>It uff den <date resp="#ner">28 tg ougst 1609</date>, hat <persName resp="#ner">Hans <unclear cert="low" resp="#joint">Marti</unclear></persName>
<lb n="47"/><persName resp="#ner"><unclear cert="low" resp="#joint">Jung</unclear> <unclear cert="low" resp="#joint">Selich</unclear></persName> im an <unclear cert="low" resp="#joint">duoch</unclear> <unclear cert="low" resp="#joint">gen</unclear> hat 94 <unclear cert="medium" resp="#joint">El</unclear> kost
