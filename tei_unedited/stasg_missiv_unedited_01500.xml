<p>
<pb facs="StadtASG_Missive_1500_5401.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edel</unclear>, <unclear cert="low" resp="#joint">erenvest</unclear>, <unclear cert="low" resp="#joint">fürsichtig</unclear>, <unclear cert="low" resp="#joint">ersamb</unclear>, <unclear cert="low" resp="#joint">weÿß</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">gün</unclear>-
<lb n="2"/>stig lieb herren, <unclear cert="medium" resp="#joint">denen</unclear> <unclear cert="medium" resp="#joint">seie</unclear> <unclear cert="medium" resp="#joint">unser</unclear> <unclear cert="medium" resp="#joint">freundtlich</unclear>, willig
<lb n="3"/>dienst zuvor, <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">maßen</unclear> wir <unclear cert="low" resp="#joint">von</unclear> <persName resp="#ner">Casparo <unclear cert="medium" resp="#joint">Degeen</unclear></persName>-
<lb n="4"/><unclear cert="medium" resp="#joint">ner</unclear>, <unclear cert="medium" resp="#joint">eines</unclear> zwischen <unclear cert="medium" resp="#joint">weÿllendt</unclear> <unclear cert="medium" resp="#joint">hern</unclear> <persName resp="#ner">Jacoben <unclear cert="medium" resp="#joint">Schlumpffen</unclear></persName>
<lb n="5"/><unclear cert="medium" resp="#joint">handlsmann</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName> seligen, und ime <persName resp="#ner"><unclear cert="low" resp="#joint">Degeener</unclear></persName>,
<lb n="6"/>getroffnen <unclear cert="medium" resp="#joint">Contracts</unclear> halber, umb <unclear cert="medium" resp="#joint">Intercession</unclear> <unclear cert="medium" resp="#joint">schtlich</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">ersuocht</unclear> worden, <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">gibt</unclear> die <unclear cert="medium" resp="#joint">beÿlag</unclear> <unclear cert="medium" resp="#joint">außfürlich</unclear>, <unclear cert="medium" resp="#joint">zuver</unclear>-
<lb n="8"/><unclear cert="medium" resp="#joint">nehmen</unclear>,
<lb n="9"/>Wie woll wir <unclear cert="medium" resp="#joint">zwar</unclear>, <unclear cert="medium" resp="#joint">einen</unclear> <unclear cert="medium" resp="#joint">ersamben</unclear> <unclear cert="medium" resp="#joint">wollweÿsen</unclear> Ma-
<lb n="10"/>gistrat, <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St: Gallen</placeName>, lieber unbehelligt <unclear cert="medium" resp="#joint">gelaßen</unclear>, und
<lb n="11"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">ohnne</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">Intercession</unclear> <unclear cert="low" resp="#joint">ime</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Degeener</unclear></persName> sowol
<lb n="12"/>an der <unclear cert="low" resp="#joint">selben</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">die</unclear> Schlumpffischen erben, <unclear cert="medium" resp="#joint">Vnser</unclear> ab-
<lb n="13"/><unclear cert="low" resp="#joint">gangens</unclear> <unclear cert="low" resp="#joint">günstige</unclear> <unclear cert="low" resp="#joint">schreiben</unclear>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">gefruchtet</unclear> <unclear cert="low" resp="#joint">gesehen</unclear> het-
<lb n="14"/>ten, Jedoch aber <unclear cert="medium" resp="#joint">weÿllen</unclear> wir umb der verlengerung
<lb n="15"/>willen, <unclear cert="medium" resp="#joint">diß</unclear> <unclear cert="medium" resp="#joint">handls</unclear>, <unclear cert="medium" resp="#joint">von</unclear> gedachten <persName resp="#ner"><unclear cert="low" resp="#joint">Degeener</unclear></persName>, <unclear cert="low" resp="#joint">so</unclear> sich
<lb n="16"/><unclear cert="medium" resp="#joint">vil</unclear> <unclear cert="medium" resp="#joint">Jar</unclear>. <unclear cert="medium" resp="#joint">hero</unclear> <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">uffgehalten</unclear>, unnd in ehren wol be-
<lb n="17"/><unclear cert="medium" resp="#joint">khandt</unclear>, auch angenemb, und lieb ist, umb <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">schrifft</unclear> an-
<lb n="18"/><unclear cert="medium" resp="#joint">gelannget</unclear> worden, daneben auch <unclear cert="medium" resp="#joint">befinden</unclear>, <unclear cert="medium" resp="#joint">daß</unclear> ange-
<lb n="19"/>zogner <unclear cert="medium" resp="#joint">Pact</unclear> an Ime <unclear cert="medium" resp="#joint">selbß</unclear> Just, in rechten <unclear cert="medium" resp="#joint">genuogsamb</unclear>
<lb n="20"/>fundiert, unnd aprobiert, wie nit weniger <unclear cert="medium" resp="#joint">uffrichtig</unclear>
<lb n="21"/>mit gueter <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">bedrachtung</unclear> und <unclear cert="low" resp="#joint">bschaidenhait</unclear>, <unclear cert="low" resp="#joint">auß</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">treuem</unclear> <unclear cert="low" resp="#joint">wolmeinendem</unclear> gemueth, <unclear cert="medium" resp="#joint">ausser</unclear> aller <unclear cert="medium" resp="#joint">gefahr</unclear>, <unclear cert="medium" resp="#joint">wie</unclear>
<lb n="23"/><unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">iro</unclear> <unclear cert="medium" resp="#joint">ehrlichen</unclear> <unclear cert="medium" resp="#joint">burgers</unclear> und <unclear cert="low" resp="#joint">handlsleuth</unclear>, <unclear cert="low" resp="#joint">vndern</unclear> <unclear cert="low" resp="#joint">gmeinen</unclear>-
<pb facs="StadtASG_Missive_1500_5402.jpg" n="2"/>
<lb n="24"/>unsers Raths verwanthe, und der dritte, der Osterreich-
<lb n="25"/>ischen handlsleüth von <placeName ref="stadtasg-places-135" cert="medium" resp="#ner">Augspurg</placeName> factor, die solches mit
<lb n="26"/>handschrifft, und pitschafften bezeügen, darzue auch noch
<lb n="27"/>mit Ierem Coerperlichen Iuramenndt, da von noethen, zue
<lb n="28"/>bestaetten thetin sich anerpotten, so mueßen, dan wir
<lb n="29"/>solche bezeygnus, fuer genueg, unnd chraefftig erkhennen, Do-
<lb n="30"/>genster auch umb so vill mehr ursachen, deren sachen
<lb n="31"/>mit ernst nach zue sezen, In bedennkhung herr <persName resp="#ner">Schluempff</persName>
<lb n="32"/>seliger, eben das Ienig Ime Degenster, zue gewartten ge-
<lb n="33"/>habt, was er am Ierg erzaigt, deß haben wir Ime
<lb n="34"/>die gebettne fuerschrifft, umb sovill weniger abschlagen
<lb n="35"/>khuennen, sonderlich aber zue dem ennde, das wir beeden thailen
<lb n="36"/>vielmehr verguennen, und wüntschen wolten, das sy In-
<lb n="37"/>guete von ein ander khumben, als etwo khünfftig, in meh-
<lb n="38"/>rer weitterung, oder aber die Schluempfischen befreündten,
<lb n="39"/>bevorab Irer handtlung, und gwerb, sich in dise Lanndt er-
<lb n="40"/>strekhen, Inn widerwertige nachredt, od andere costen
<lb n="41"/>ungelegenheit, gerathen solten, Zuer verhuettung aber deß-
<lb n="42"/>selben, So lanngt an die herrn unser freunndt: und wolmai-
<lb n="43"/>nenndts, deinstliches gesinnen, gerichen sy die Schluempfischen herrn
<lb n="44"/>erben, dahin zuegemahnen, das sy unverhindert Irer
<lb n="45"/>waigerung, billicher vergleichung, deren sich auch Degen-
<lb n="46"/>ster, nach billichen dingen, unserm verhoffen nach nit sezen
<lb n="47"/>wirt, statt thuen, Wie dann auß <persName resp="#ner">Lorenzen Zollikoffers</persName>-
<pb facs="StadtASG_Missive_1500_5403.jpg" n="3"/>
<lb n="48"/><unclear cert="low" resp="#joint">beyligenden</unclear> <unclear cert="low" resp="#joint">schriben</unclear>, <unclear cert="low" resp="#joint">gunstigen</unclear> die <unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">daselb</unclear> <unclear cert="low" resp="#joint">zůsechen</unclear>,
<lb n="49"/><unclear cert="low" resp="#joint">daß</unclear> sich die <unclear cert="medium" resp="#joint">Schlumperischen</unclear>, gegen <unclear cert="medium" resp="#joint">herren</unclear> <unclear cert="medium" resp="#joint">burgermaister</unclear> <unclear cert="medium" resp="#joint">zů</unclear>
<lb n="50"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>. <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">die</unclear> vergleichung <unclear cert="low" resp="#joint">ieres</unclear> <unclear cert="low" resp="#joint">thails</unclear> auch an er=
<lb n="51"/>botten, <unclear cert="low" resp="#joint">Solches</unclear> wie es an ime selbst billich, und <unclear cert="low" resp="#joint">innen</unclear> <unclear cert="medium" resp="#joint">zůr</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">khünfftiger</unclear> <unclear cert="low" resp="#joint">mehrern</unclear> <unclear cert="low" resp="#joint">růhe</unclear> <unclear cert="low" resp="#joint">geraicht</unclear>, auch <unclear cert="medium" resp="#joint">dem</unclear> von beeden
<lb n="53"/>thailen <unclear cert="low" resp="#joint">gschloßnen</unclear>, <unclear cert="low" resp="#joint">compromiß</unclear>, <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">genießen</unclear> <unclear cert="low" resp="#joint">hiedurch</unclear> <unclear cert="low" resp="#joint">beschiecht</unclear>,
<lb n="54"/><unclear cert="low" resp="#joint">Also</unclear> <unclear cert="low" resp="#joint">seindt</unclear> <unclear cert="low" resp="#joint">wierß</unclear>, in der <unclear cert="medium" resp="#joint">gleichen</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> andern <unclear cert="low" resp="#joint">zůetragennden</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">faellen</unclear> <unclear cert="low" resp="#joint">zůbeschulden</unclear> <unclear cert="low" resp="#joint">urbiethig</unclear>, <unclear cert="low" resp="#joint">goettlicher</unclear> allmacht, <unclear cert="medium" resp="#joint">unnß</unclear>
<lb n="56"/><unclear cert="medium" resp="#joint">alle</unclear> <unclear cert="medium" resp="#joint">bevelch</unclear>. Datum <origPlace resp="#ner"><unclear cert="medium" resp="#joint">Khembs</unclear></origPlace>, <origDate when="1606" resp="#ner"><unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">letsten</unclear> <unclear cert="medium" resp="#joint">Junii</unclear> <unclear cert="medium" resp="#joint">a°</unclear> <unclear cert="medium" resp="#joint">1606</unclear></origDate>
<lb n="57"/><unclear cert="medium" resp="#joint">Der</unclear> <unclear cert="medium" resp="#joint">herren</unclear>
