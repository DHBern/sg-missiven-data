<lb n="8"/>darinnen die sorten von wegen fürgebrochnen gemein=
<lb n="9"/><unclear cert="low" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">übels</unclear> <unclear cert="low" resp="#joint">one</unclear> <unclear cert="low" resp="#joint">zehoch</unclear> <unclear cert="low" resp="#joint">taxiert</unclear> werden <unclear cert="medium" resp="#joint">muossen</unclear>, für ein=
<lb n="10"/>malen biß uff ein <unclear cert="medium" resp="#joint">allgemeine</unclear> <unclear cert="medium" resp="#joint">vernere</unclear> <unclear cert="medium" resp="#joint">verbesserung</unclear>, <unclear cert="medium" resp="#joint">ohn</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">wytere</unclear> <unclear cert="medium" resp="#joint">steigerung</unclear> <unclear cert="medium" resp="#joint">verblyben</unclear> mögen <unclear cert="low" resp="#joint">wurde</unclear>, <unclear cert="low" resp="#joint">So</unclear>
