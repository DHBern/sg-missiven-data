<lb n="28"/><unclear cert="medium" resp="#joint">gwüssen</unclear> <unclear cert="medium" resp="#joint">tax</unclear> unnd ordnung <unclear cert="medium" resp="#joint">verblyben</unclear>, unnd <unclear cert="medium" resp="#joint">söllicher</unclear>
