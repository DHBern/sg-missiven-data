<lb n="33"/>wir sampt <unclear cert="medium" resp="#joint">üch</unclear> unnd anderen nochmaln <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">verhelff=</unclear>
