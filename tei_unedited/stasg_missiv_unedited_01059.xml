<lb n="5"/>ampts <unclear cert="medium" resp="#joint">angehoeriger</unclear>, <unclear cert="medium" resp="#joint">zoeuger</unclear> diß, <unclear cert="medium" resp="#joint">ist</unclear> uff <unclear cert="medium" resp="#joint">dato</unclear> <unclear cert="low" resp="#joint">vor</unclear> mir
