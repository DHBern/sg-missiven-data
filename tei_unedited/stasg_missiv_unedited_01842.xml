        <body>
<p>
<pb facs="StadtASG_Missive_1842_6835.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig dienst und grueß, <unclear cert="medium" resp="#joint">zuevor</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">Ehrwürdiger</unclear>, <unclear cert="medium" resp="#joint">Geistlicher</unclear> und <unclear cert="medium" resp="#joint">Wolgelerter</unclear> <unclear cert="medium" resp="#joint">Herr</unclear>,
<lb n="3"/>und freünd.
<lb n="4"/>Von <unclear cert="medium" resp="#joint">einer</unclear> uns <unclear cert="medium" resp="#joint">unversehenlich</unclear> <unclear cert="medium" resp="#joint">füergefallnen</unclear> <unclear cert="medium" resp="#joint">be</unclear>-
<lb n="5"/><unclear cert="medium" resp="#joint">schwerlichen</unclear> sach wegen, <unclear cert="medium" resp="#joint">schickhen</unclear> wir <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ehrw</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">zeigern</unclear> <unclear cert="low" resp="#joint">diß</unclear> unsern <unclear cert="medium" resp="#joint">getrüwen</unclear> lieben
<lb n="7"/><unclear cert="medium" resp="#joint">stattschreiber</unclear> <persName resp="#ner">Melchior <unclear cert="medium" resp="#joint">Guldlin</unclear></persName>, mit dero-
<lb n="8"/>selben (<unclear cert="low" resp="#joint">neben</unclear> <unclear cert="low" resp="#joint">überreichung</unclear> bey <unclear cert="medium" resp="#joint">verwahrter</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">protestationschrifft</unclear>.) <unclear cert="medium" resp="#joint">hievon</unclear> <unclear cert="medium" resp="#joint">unsertwegen</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">füerzubringen</unclear>, Da <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Ehrw</unclear>. gebetten
<lb n="11"/><unclear cert="low" resp="#joint">seyn</unclear> <unclear cert="low" resp="#joint">wöllen</unclear>, <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">allein</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">guetwillig</unclear> gehör und glauben <unclear cert="medium" resp="#joint">zuezustellen</unclear>,
<lb n="13"/><unclear cert="medium" resp="#joint">sond</unclear> <unclear cert="medium" resp="#joint">auch</unclear> solches so wol <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">ihme</unclear> als <unclear cert="medium" resp="#joint">uns</unclear> <unclear cert="medium" resp="#joint">gueter</unclear>
<lb n="14"/>wolmeinung <unclear cert="low" resp="#joint">zuevermerckhen</unclear>. <unclear cert="low" resp="#joint">Dero</unclear>
<lb n="15"/>alle <unclear cert="medium" resp="#joint">angeneme</unclear> <unclear cert="medium" resp="#joint">wolgefellige</unclear> dienst <unclear cert="medium" resp="#joint">züer</unclear>-
<lb n="16"/>weisen wir geneigt <unclear cert="medium" resp="#joint">verbleiben</unclear>. <unclear cert="medium" resp="#joint">Dat</unclear>.
<lb n="17"/><origDate when="1613" resp="#ner">den. <unclear cert="low" resp="#joint">5</unclear>. <unclear cert="low" resp="#joint">th</unclear>. <unclear cert="low" resp="#joint">Maji</unclear> <unclear cert="low" resp="#joint">Ao</unclear>. 1613.</origDate>
<lb n="18"/><orgName ref="stadtasg-actors-629" cert="medium" role="issuer" resp="#ner">Statthalter und <unclear cert="medium" resp="#joint">rhathe</unclear> der
<lb n="19"/>statt Sant Gallen</orgName>.
<lb n="20"/>Dem <unclear cert="medium" resp="#joint">Ehrwürdigen</unclear> <unclear cert="medium" resp="#joint">Geistlichen</unclear> Wolgelerten
<lb n="21"/>Herren, dem Herrn Official <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">Costantz</unclear>,
<lb n="22"/>unserm sonders <unclear cert="medium" resp="#joint">ehrenden</unclear> lieben <unclear cert="low" resp="#joint">Herrn</unclear>, .
<pb facs="StadtASG_Missive_1842_6836.jpg" n="2"/>
</p>
