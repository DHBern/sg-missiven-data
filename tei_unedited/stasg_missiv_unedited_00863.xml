<lb n="1"/><unclear cert="low" resp="#joint">Ehrenvest</unclear>, <unclear cert="medium" resp="#joint">From</unclear>, <unclear cert="medium" resp="#joint">Fuernem</unclear>, <unclear cert="low" resp="#joint">Weyß</unclear>, <unclear cert="low" resp="#joint">Insonder</unclear> <unclear cert="low" resp="#joint">guenstige</unclear>
<lb n="2"/>unnd lieben herrn, Euch seyen mein <unclear cert="low" resp="#joint">underthonnig</unclear>
