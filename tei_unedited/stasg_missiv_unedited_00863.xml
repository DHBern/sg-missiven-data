<lb n="4"/><unclear cert="low" resp="#joint">hieneebend</unclear> <unclear cert="low" resp="#joint">zuvernemen</unclear>, Euch, <unclear cert="low" resp="#joint">zweyffelt</unclear> on,
<lb n="5"/><unclear cert="medium" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">wüßig</unclear>, wie <unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="medium" resp="#joint">ainem</unclear> Ersamen <unclear cert="low" resp="#joint">Rhat</unclear> allhie
<lb n="6"/>zu <placeName ref="stadtasg-places-89" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Veldtkirch</unclear></placeName>, von meinen wegen, ain <unclear cert="low" resp="#joint">schreyben</unclear>
