<p>
<pb facs="StadtASG_Missive_2496_9625.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">fründtlich</unclear> willig dienst, <unclear cert="medium" resp="#joint">sambt</unclear> was wir <unclear cert="medium" resp="#joint">ehren</unclear>
<lb n="2"/>liebs und <unclear cert="medium" resp="#joint">guts</unclear> <unclear cert="low" resp="#joint">vermoegen</unclear> zuvor. <unclear cert="low" resp="#joint">From</unclear>, <unclear cert="medium" resp="#joint">fuersichtig</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">ehrsam</unclear>, <unclear cert="medium" resp="#joint">wyß</unclear>, insonders <unclear cert="low" resp="#joint">guttfründt</unclear> und <unclear cert="low" resp="#joint">getrüwe</unclear> lieb
<lb n="4"/>Eydt. und <unclear cert="medium" resp="#joint">pundtsgnoß</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Uß</unclear> <unclear cert="medium" resp="#joint">dem</unclear>, <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">getrüwe</unclear> liebe <unclear cert="low" resp="#joint">miträht</unclear>, so den
<lb n="6"/>Landtvogt <unclear cert="low" resp="#joint">im</unclear> <placeName ref="stadtasg-places-64" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Rinthall</unclear></placeName>, <unclear cert="low" resp="#joint">unsern</unclear> auch lieben und <unclear cert="low" resp="#joint">getrüwen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">mitraht</unclear> begleitet, die <unclear cert="low" resp="#joint">sonderbahre</unclear> ehr gutte <unclear cert="low" resp="#joint">eydtgnössische</unclear>
<lb n="8"/>affection und <unclear cert="low" resp="#joint">fründtschaft</unclear>, so demselbigen und <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">unsrigen</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">gmeincklichen</unclear> in <unclear cert="low" resp="#joint">üwer</unclear> <unclear cert="low" resp="#joint">reifier</unclear> widerfahren, so hoch <unclear cert="low" resp="#joint">angerüembt</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">habent</unclear> wir nit <unclear cert="low" resp="#joint">umbgohn</unclear> <unclear cert="low" resp="#joint">sollen</unclear> <unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">woellen</unclear>, darumb <unclear cert="low" resp="#joint">üch</unclear>
<lb n="11"/>unsern <unclear cert="medium" resp="#joint">G</unclear>. L. <unclear cert="medium" resp="#joint">E</unclear>. und Pundtsgnoß fründt und <unclear cert="low" resp="#joint">eydtgnößisch</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">zebedancken</unclear>, und <unclear cert="low" resp="#joint">zuvergwüßen</unclear>, dz wir <unclear cert="low" resp="#joint">söllches</unclear> zu <unclear cert="medium" resp="#joint">guetem</unclear>
<lb n="13"/>nit <unclear cert="low" resp="#joint">vergäßen</unclear>, und in andern <unclear cert="low" resp="#joint">begäbenheiten</unclear>, umb <unclear cert="low" resp="#joint">üch</unclear>
<lb n="14"/>unsern <unclear cert="medium" resp="#joint">G</unclear>. L. <unclear cert="medium" resp="#joint">E</unclear>. und <unclear cert="low" resp="#joint">pundtsgnoßen</unclear> <unclear cert="low" resp="#joint">zuerwidern</unclear>, <unclear cert="low" resp="#joint">uns</unclear> be-
<lb n="15"/><unclear cert="low" resp="#joint">fleißen</unclear> werden, <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">eydtgnößisch</unclear> <unclear cert="low" resp="#joint">zutruwen</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">soellend</unclear>, <unclear cert="low" resp="#joint">uch</unclear> damit (<unclear cert="low" resp="#joint">nebent</unclear> <unclear cert="low" resp="#joint">wünschung</unclear> all <unclear cert="low" resp="#joint">guter</unclear> <unclear cert="medium" resp="#joint">prosperitet</unclear>)
<lb n="17"/><unclear cert="medium" resp="#joint">dem</unclear> lieben <unclear cert="low" resp="#joint">gtruewen</unclear> <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">woll</unclear> <unclear cert="low" resp="#joint">bevelende</unclear>. Datum.
<lb n="18"/><origDate when="1624" resp="#ner">den <unclear cert="low" resp="#joint">18.t</unclear> Augusti. <unclear cert="medium" resp="#joint">Ao</unclear>. <unclear cert="low" resp="#joint">1624</unclear>.</origDate>
<lb n="19"/><orgName ref="stadtasg-actors-522" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Stadthalter</unclear> und <unclear cert="medium" resp="#joint">Raht</unclear>
