<lb n="6"/>Es haben <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">angehörige</unclear> <unclear cert="low" resp="#joint">burgere</unclear>, <unclear cert="low" resp="#joint">herrn</unclear>
