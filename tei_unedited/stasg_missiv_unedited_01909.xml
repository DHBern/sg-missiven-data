<lb n="32"/><unclear cert="low" resp="#joint">schriftlich</unclear> berichtet, welcher <unclear cert="low" resp="#joint">maßen</unclear> ihnen von dem <unclear cert="medium" resp="#joint">hi</unclear>-
<lb n="33"/><unclear cert="medium" resp="#joint">spanischen</unclear> zuo <placeName ref="stadtasg-places-69" cert="medium" resp="#ner">Lucern</placeName> <unclear cert="low" resp="#joint">Residierenden</unclear> <unclear cert="low" resp="#joint">Ambassadorn</unclear>
