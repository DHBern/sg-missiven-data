<lb n="55"/>vor disem <unclear cert="low" resp="#joint">überstanden</unclear>, überhebt bleiben <unclear cert="low" resp="#joint">kündten</unclear>,
<lb n="56"/>und <unclear cert="low" resp="#joint">derowegen</unclear> zue beiden theilen, namlich die
<lb n="57"/>Ußeren <unclear cert="low" resp="#joint">Roden</unclear>, und wir <unclear cert="low" resp="#joint">eben</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">gestrigs</unclear> <unclear cert="low" resp="#joint">tags</unclear></date>, ein ansehenliche Bottschafft
<lb n="58"/><unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">mehrgedachtem</unclear> herren Abbt <unclear cert="low" resp="#joint">abgefertiget</unclear>,
