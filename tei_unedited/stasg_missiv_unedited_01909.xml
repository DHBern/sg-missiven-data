<lb n="34"/><unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">schreiben</unclear> <unclear cert="low" resp="#joint">zuekomen</unclear>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">substanzlichen</unclear> innhalts,
<lb n="35"/>wie <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">namen</unclear> deß <unclear cert="low" resp="#joint">Künigs</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-280" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Hispanien</unclear></placeName>, der
