<p>
<pb facs="StadtASG_Missive_2275_8629.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründtlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear>, und was
<lb n="2"/>wir ehren liebs und guotts <unclear cert="medium" resp="#joint">vermoegendt</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">Edler</unclear> <unclear cert="medium" resp="#joint">Vester</unclear> und <unclear cert="medium" resp="#joint">Weiser</unclear>, Insonders
<lb n="4"/><unclear cert="medium" resp="#joint">lieber</unclear> Herr <unclear cert="medium" resp="#joint">Landtvogt</unclear>, <unclear cert="medium" resp="#joint">guotter</unclear> Fründt
<lb n="5"/>und Nachbar.
<lb n="6"/><unclear cert="low" resp="#joint">Demnach</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">fürkhombt</unclear>, als wann so wohl
<lb n="7"/><unclear cert="medium" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">Zürrichischen</unclear> Leger zuo <placeName ref="stadtasg-places-12" cert="medium" resp="#ner">Mayenfeldt</placeName>, <unclear cert="medium" resp="#joint">als</unclear> auch
<lb n="8"/><unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-356" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Pfeffers</unclear></placeName> <unclear cert="medium" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">Badt</unclear> <unclear cert="medium" resp="#joint">offentlich</unclear> solle geredt
<lb n="9"/><unclear cert="medium" resp="#joint">worden</unclear> sein, daß <unclear cert="medium" resp="#joint">in</unclear> <unclear cert="medium" resp="#joint">khürze</unclear> von den <orgName resp="#ner"><unclear cert="medium" resp="#joint">Leo</unclear>-
<lb n="10"/><unclear cert="medium" resp="#joint">poldischen</unclear></orgName> ein angriff gegen den <orgName resp="#ner"><unclear cert="medium" resp="#joint">Pündtneren</unclear></orgName>
<lb n="11"/>solle <unclear cert="low" resp="#joint">gschehen</unclear>, wie dann <unclear cert="medium" resp="#joint">allberaithen</unclear>
<lb n="12"/>Im selben Leger in die <unclear cert="low" resp="#joint">300</unclear>. <unclear cert="low" resp="#joint">Reüter</unclear> <unclear cert="low" resp="#joint">ankhomen</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="13"/>und teglich vil <unclear cert="medium" resp="#joint">Landtvolckh</unclear> so wider uff-
<lb n="14"/><unclear cert="medium" resp="#joint">gemahent</unclear> worden, volgen sollen.
<lb n="15"/>Wann <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">hierüber</unclear> <unclear cert="low" resp="#joint">gern</unclear> <unclear cert="low" resp="#joint">gewiße</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="16"/><unclear cert="low" resp="#joint">richt</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wolten</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">zweiffelt</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">dem</unclear> also sein <unclear cert="low" resp="#joint">solte</unclear>, <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">wol</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">unverborgen</unclear> sein <unclear cert="medium" resp="#joint">werde</unclear>: So <unclear cert="medium" resp="#joint">er</unclear>-
<lb n="19"/><unclear cert="medium" resp="#joint">suochen</unclear> wir <unclear cert="medium" resp="#joint">denselben</unclear> <unclear cert="medium" resp="#joint">hiemit</unclear> <unclear cert="medium" resp="#joint">fründt</unclear> <unclear cert="medium" resp="#joint">nachbar</unclear>-
<lb n="20"/>lich und <unclear cert="medium" resp="#joint">Eidtgnoßisch</unclear>, Er <unclear cert="low" resp="#joint">welle</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">bij</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zaiger</unclear> <unclear cert="low" resp="#joint">diß</unclear>, <unclear cert="low" resp="#joint">wie</unclear> es <unclear cert="medium" resp="#joint">darmit</unclear> <unclear cert="medium" resp="#joint">bewandt</unclear> in
<lb n="22"/><unclear cert="medium" resp="#joint">wahrheit</unclear>, und <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="low" resp="#joint">deßhalben</unclear> <unclear cert="low" resp="#joint">ehwans</unclear> <unclear cert="low" resp="#joint">bewußt</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">ainichen</unclear> <unclear cert="low" resp="#joint">unbeschwerdt</unclear> <unclear cert="low" resp="#joint">schrifftlich</unclear> bericht:
<pb facs="StadtASG_Missive_2275_8630.jpg" n="2"/>
<lb n="24"/><unclear cert="medium" resp="#joint">schuldigkheit</unclear> <unclear cert="medium" resp="#joint">dem</unclear> herren wir <unclear cert="low" resp="#joint">hinwiderumb</unclear>
<lb n="25"/>in <unclear cert="medium" resp="#joint">dergleichen</unclear> und andern <unclear cert="low" resp="#joint">feülen</unclear> <unclear cert="low" resp="#joint">nachbraliche</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="26"/><unclear cert="low" resp="#joint">felligkheit</unclear> <unclear cert="low" resp="#joint">zuerwiedern</unclear> <unclear cert="low" resp="#joint">anerpietig</unclear>. Der
<lb n="27"/><unclear cert="low" resp="#joint">höchste</unclear> <unclear cert="low" resp="#joint">woelle</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">bluetdurstige</unclear> <unclear cert="low" resp="#joint">anschleg</unclear> <unclear cert="low" resp="#joint">gnaedig</unclear>-
<lb n="28"/><unclear cert="low" resp="#joint">elich</unclear> <unclear cert="low" resp="#joint">steüren</unclear> und <unclear cert="low" resp="#joint">uns</unclear> in <unclear cert="medium" resp="#joint">unserm</unclear> <unclear cert="medium" resp="#joint">geliepten</unclear> <unclear cert="medium" resp="#joint">Vatter</unclear>-
<lb n="29"/><unclear cert="medium" resp="#joint">landt</unclear> in <unclear cert="low" resp="#joint">frieden</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wolstande</unclear> <unclear cert="low" resp="#joint">erhalten</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">deßen</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">gnaedig</unclear> <unclear cert="low" resp="#joint">schirm</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">samptlichen</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="31"/><unclear cert="low" resp="#joint">vehlen</unclear> <unclear cert="low" resp="#joint">thuen</unclear>. Datum den <origDate when="1622-06-23" resp="#ner">23ten <unclear cert="medium" resp="#joint">Junij</unclear>
<lb n="32"/>1622</origDate>.
<lb n="33"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear> und <unclear cert="medium" resp="#joint">Rhate</unclear>
<lb n="34"/>der statt <unclear cert="medium" resp="#joint">Sanct</unclear> Gallen</orgName>.
<lb n="35"/>Dem edlen vesten und <unclear cert="low" resp="#joint">weisen</unclear> <persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Leonhard</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">Holzhalben</unclear></persName> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Rhats</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">statt</unclear> <placeName ref="stadtasg-places-32" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Zürich</unclear></placeName>
<lb n="37"/>und <unclear cert="medium" resp="#joint">Landtvogt</unclear> der herrschafft <placeName resp="#ner"><unclear cert="low" resp="#joint">Hochensaex</unclear></placeName>, <unclear cert="low" resp="#joint">etc</unclear>.
<lb n="38"/><unclear cert="low" resp="#joint">unserm</unclear> insonders lieben herren <unclear cert="medium" resp="#joint">guetten</unclear>
<lb n="39"/><unclear cert="medium" resp="#joint">freünden</unclear> und <unclear cert="medium" resp="#joint">nachbarn</unclear>.
