<lb n="3"/>geneigte <unclear cert="low" resp="#joint">guotwillige</unclear> dienst, unnd <unclear cert="low" resp="#joint">waß</unclear> ich <unclear cert="medium" resp="#joint">sonsten</unclear> ehren
<lb n="4"/>liebs unnd guots <unclear cert="medium" resp="#joint">vermag</unclear> zuvor.
<lb n="5"/>Eß ist <unclear cert="low" resp="#joint">verruckter</unclear> zit min <unclear cert="low" resp="#joint">ampts</unclear> angehoeriger <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Naegele</unclear></persName>
<lb n="6"/>sins <unclear cert="low" resp="#joint">handtwerchs</unclear> ein wäber, von <placeName resp="#ner"><unclear cert="low" resp="#joint">Anglickhen</unclear></placeName>, sonst <unclear cert="low" resp="#joint">bürtig</unclear>
