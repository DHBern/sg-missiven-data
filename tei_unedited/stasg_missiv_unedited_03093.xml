<lb n="5"/>Wir <unclear cert="medium" resp="#joint">könnend</unclear> üch unnser <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">unberichtet</unclear> nit
