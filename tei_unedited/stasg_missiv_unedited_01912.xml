<lb n="24"/><unclear cert="low" resp="#joint">waegen</unclear> <unclear cert="low" resp="#joint">uech</unclear> <unclear cert="low" resp="#joint">fruendtlich</unclear> <unclear cert="low" resp="#joint">gebaetten</unclear>. <unclear cert="low" resp="#joint">wöllen</unclear> <unclear cert="low" resp="#joint">erwaegen</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">fruendtlich</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">eidtgnößisch</unclear> <unclear cert="low" resp="#joint">widerumb</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">schribenn</unclear>,
