<lb n="4"/><unclear cert="low" resp="#joint">Eidtgnossenn</unclear>. Wir sindt <unclear cert="medium" resp="#joint">wordre</unclear> <unclear cert="medium" resp="#joint">hie</unclear> durch <unclear cert="low" resp="#joint">witere</unclear> <unclear cert="low" resp="#joint">schrib</unclear>
