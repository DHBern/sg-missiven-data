    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1485_5339.jpg" n="1"/>
<lb n="1"/>Unser freüntlich willig dienst, <unclear cert="low" resp="#joint">sampt</unclear> <unclear cert="medium" resp="#joint">waß</unclear>
<lb n="2"/>wir ehren liebs und guts <unclear cert="low" resp="#joint">vermogen</unclear> zuvor,
<lb n="3"/><unclear cert="low" resp="#joint">from</unclear>, fürsichtig, ehrsam, <unclear cert="medium" resp="#joint">weiß</unclear>, <unclear cert="low" resp="#joint">inßonders</unclear>
<lb n="4"/>gut freündt und <unclear cert="low" resp="#joint">getheüw</unclear> lieb <orgName resp="#ner"><unclear cert="low" resp="#joint">Eydtgnossen</unclear></orgName>.
<lb n="5"/><unclear cert="low" resp="#joint">Waß</unclear> Ir <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">hiebevor</unclear> über und <unclear cert="low" resp="#joint">uff</unclear> Euwers
<lb n="6"/>burgers <persName resp="#ner">Haneßen Thainers</persName> supplication,
<lb n="7"/><unclear cert="low" resp="#joint">seinethalben</unclear> <unclear cert="low" resp="#joint">widerantwurtlich</unclear> gelangen
<lb n="8"/>laßen, daß habend wir ablaeßend angehört
<lb n="9"/>und mit mehrerem vernomen. So <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">unser</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jerg</unclear></persName> <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">ungebürlichs</unclear> mit Ime <persName resp="#ner">Thai</persName>=
<lb n="11"/>ner uff freyer Richsstraß, fürgenomen,
<lb n="12"/>ist <unclear cert="low" resp="#joint">unnß</unclear> daran <unclear cert="low" resp="#joint">khein</unclear> gefallen beschehen,
<lb n="13"/>sonder werdendt sin deß biß zu seiner
<lb n="14"/>zeith ingedennckh sin, und <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">begang=</unclear>
<lb n="15"/>nen thatte der gebür nach абstrafen.
<lb n="16"/>Weil aber <persName resp="#ner"><unclear cert="low" resp="#joint">Thainer</unclear></persName> <unclear cert="low" resp="#joint">gutwillens</unclear> sich, vff
<lb n="17"/>erfordern, <unclear cert="low" resp="#joint">zustellen</unclear>, <unclear cert="low" resp="#joint">anglobt</unclear>, welles
<lb n="18"/>wir <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">verßehen</unclear>, so werden <unclear cert="medium" resp="#joint">Ime</unclear> zu
<lb n="19"/><unclear cert="low" resp="#joint">erstattung</unclear> <unclear cert="low" resp="#joint">söllichs</unclear> <unclear cert="low" resp="#joint">gelüpts</unclear> der gebür
<lb n="20"/>nach <unclear cert="low" resp="#joint">unnd</unclear> in <unclear cert="low" resp="#joint">handung</unclear> <unclear cert="low" resp="#joint">sin</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jerg</unclear></persName> <unclear cert="low" resp="#joint">beclag=</unclear>
<lb n="21"/>gen hiemit einen tag, <unclear cert="low" resp="#joint">benantlichen</unclear> <unclear cert="low" resp="#joint">vff</unclear>
<lb n="22"/><date resp="#ner"><unclear cert="low" resp="#joint">Mitwochen</unclear> vor Bartholomei nechstkünfftig</date>,
<lb n="23"/>so sin würdet den <date resp="#ner"><unclear cert="low" resp="#joint">22isten</unclear> diß monats
<lb n="24"/>Augusti,</date> vor <unclear cert="low" resp="#joint">unnß</unclear> bey <unclear cert="low" resp="#joint">schiinender</unclear> <unclear cert="low" resp="#joint">tag=</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">zeith</unclear> <unclear cert="low" resp="#joint">zuerschinen</unclear>, durch sich, sinnen
<lb n="26"/>anwalten nach zu Inen <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">schuldigen</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">freveln</unclear> gutem benügen, <unclear cert="low" resp="#joint">zuverantworten</unclear>,
<lb n="28"/>alda Ime gut recht <unclear cert="medium" resp="#joint">vnnd</unclear> alle <unclear cert="low" resp="#joint">pilligkeit</unclear>
<lb n="29"/>widerfahren <unclear cert="medium" resp="#joint">sol</unclear>. <unclear cert="medium" resp="#joint">Daß</unclear> <unclear cert="low" resp="#joint">syen</unclear> wir mit
<lb n="30"/><unclear cert="low" resp="#joint">glichmäßiger</unclear> <unclear cert="low" resp="#joint">verhaltung</unclear> <unclear cert="low" resp="#joint">zuerwidern</unclear>,
<lb n="31"/><unclear cert="low" resp="#joint">Eüch</unclear> durch Eydtgnößische thrüw, ehr, <unclear cert="low" resp="#joint">liebe</unclear>
<lb n="32"/>und
<pb facs="StadtASG_Missive_1485_5340.jpg" n="2"/>
<lb n="33"/>und <unclear cert="low" resp="#joint">früendtlichait</unclear> <unclear cert="low" resp="#joint">zuebeweisen</unclear> und erzeigen,
<lb n="34"/><unclear cert="medium" resp="#joint">fürbaß</unclear> <unclear cert="medium" resp="#joint">wolgeneigt</unclear>. <unclear cert="medium" resp="#joint">Goetlicher</unclear> protection
<lb n="35"/><unclear cert="medium" resp="#joint">unnß</unclear> damit <unclear cert="low" resp="#joint">zuemahl</unclear> <unclear cert="low" resp="#joint">entpfelhend</unclear>. Datum
<lb n="36"/><origDate when="1605" resp="#ner">Mitwochs den <unclear cert="low" resp="#joint">7</unclear>. <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">Augusti</unclear> Anno 1605</origDate>.
<lb n="37"/><orgName ref="stadtasg-actors-28" cert="medium" role="issuer" resp="#ner">Burgermeister und Rhat
<lb n="38"/>der statt <unclear cert="low" resp="#joint">Schafhusen</unclear></orgName>.
<pb facs="StadtASG_Missive_1485_5341.jpg" n="3"/>
<pb facs="StadtASG_Missive_1485_5342.jpg" n="4"/>
<lb n="39"/>Den fromen, fürsichtigen,
<lb n="40"/>ehrsamen und <unclear cert="medium" resp="#joint">wisen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Bur</unclear>-
<lb n="41"/><unclear cert="medium" resp="#joint">germeister</unclear> und <unclear cert="low" resp="#joint">Rhat</unclear> der
<lb n="42"/>Statt <unclear cert="medium" resp="#joint">Sant</unclear> Gallen</orgName>, <unclear cert="low" resp="#joint">unsren</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">insunders</unclear> guoten <unclear cert="low" resp="#joint">frunden</unclear>
<lb n="44"/>und <unclear cert="low" resp="#joint">getrüwen</unclear>, lieben Eidt-
<lb n="45"/>gnossen.
</p>
