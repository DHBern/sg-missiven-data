<lb n="19"/><unclear cert="low" resp="#joint">So</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ft</unclear>. <unclear cert="low" resp="#joint">nebst</unclear> <unclear cert="low" resp="#joint">Goettlicher</unclear> <unclear cert="low" resp="#joint">empfehlung</unclear>
