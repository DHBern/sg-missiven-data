<lb n="62"/><unclear cert="medium" resp="#joint">beschaid</unclear> <unclear cert="medium" resp="#joint">zuewider</unclear> nit <unclear cert="medium" resp="#joint">bewilligen</unclear> <unclear cert="medium" resp="#joint">wöllen</unclear>, darauß er sampt <unclear cert="low" resp="#joint">inen</unclear>,
