<lb n="12"/><unclear cert="low" resp="#joint">andeüten</unclear> <unclear cert="low" resp="#joint">zue</unclear> laßen, <unclear cert="low" resp="#joint">wo</unclear> <unclear cert="low" resp="#joint">fehr</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">hierüber</unclear> <unclear cert="low" resp="#joint">nicht</unclear>
