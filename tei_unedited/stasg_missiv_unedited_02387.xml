<p>
<pb facs="StadtASG_Missive_2387_9159.jpg" n="1"/>
<lb n="1"/>Edle, <unclear cert="medium" resp="#joint">veste</unclear>, <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">ehrnveste</unclear> wollweise <unclear cert="medium" resp="#joint">gepietende</unclear> und
<lb n="2"/>günstige Herren. Es sein <unclear cert="medium" resp="#joint">mier</unclear> <unclear cert="medium" resp="#joint">unlangst</unclear> <unclear cert="medium" resp="#joint">25</unclear>. <unclear cert="medium" resp="#joint">stukh</unclear> <unclear cert="medium" resp="#joint">gold</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">ducaten</unclear> von meiner freündt einem, auß meinem
<lb n="4"/>vatterlandt <placeName ref="stadtasg-places-97" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Krendten</unclear></placeName> mit disem <unclear cert="medium" resp="#joint">bevelch</unclear> <unclear cert="medium" resp="#joint">zuegeschikht</unclear>
<lb n="5"/>worden, daß ich <unclear cert="medium" resp="#joint">sie</unclear> <unclear cert="medium" resp="#joint">ehist</unclear> unter die armen ver-
<lb n="6"/><unclear cert="medium" resp="#joint">iagten</unclear>: aber von <unclear cert="medium" resp="#joint">Eüer</unclear> <unclear cert="medium" resp="#joint">Herrlikeit</unclear> in <unclear cert="medium" resp="#joint">ier</unclear> <unclear cert="medium" resp="#joint">stat</unclear> <unclear cert="medium" resp="#joint">christ</unclear>:
<lb n="7"/><unclear cert="medium" resp="#joint">mitleidig</unclear> <unclear cert="medium" resp="#joint">aufgenummen</unclear> <unclear cert="medium" resp="#joint">Veltoliner</unclear> <unclear cert="medium" resp="#joint">außspenden</unclear> <unclear cert="medium" resp="#joint">solte</unclear>.
<lb n="8"/>Hab <unclear cert="medium" resp="#joint">demnach</unclear> disem gebürlich <unclear cert="medium" resp="#joint">nachzüleben</unclear> kein <unclear cert="medium" resp="#joint">beque</unclear>-
<lb n="9"/><unclear cert="medium" resp="#joint">mer</unclear> <unclear cert="medium" resp="#joint">mitl</unclear> <unclear cert="medium" resp="#joint">ersehen</unclear> <unclear cert="medium" resp="#joint">khünen</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> diß <unclear cert="medium" resp="#joint">geltl</unclear> hiemit <unclear cert="low" resp="#joint">Eüer</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">Hrlk</unclear>. <unclear cert="low" resp="#joint">eingeschloßen</unclear> <unclear cert="low" resp="#joint">züezüsenden</unclear>, und dieselben
<lb n="11"/><unclear cert="low" resp="#joint">dienstlich</unclear> <unclear cert="low" resp="#joint">züpitten</unclear>, es durch <unclear cert="medium" resp="#joint">iere</unclear> <unclear cert="medium" resp="#joint">geordnete</unclear> all-
<lb n="12"/><unclear cert="medium" resp="#joint">muosenpfleher</unclear> unter <unclear cert="medium" resp="#joint">genante</unclear> armen auß <placeName resp="#ner"><unclear cert="medium" resp="#joint">Veltolin</unclear></placeName>
<lb n="13"/>unbeschwert <unclear cert="low" resp="#joint">außtheillen</unclear> <unclear cert="low" resp="#joint">zülaßen</unclear>, doch <unclear cert="medium" resp="#joint">nebens</unclear>,
<lb n="14"/>den <unclear cert="medium" resp="#joint">geber</unclear> deßen <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">züvemelden</unclear>. Und <unclear cert="low" resp="#joint">thue</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">Eüer</unclear> <unclear cert="low" resp="#joint">Hrlk</unclear>. <unclear cert="low" resp="#joint">mich</unclear> <unclear cert="low" resp="#joint">zü</unclear> <unclear cert="low" resp="#joint">günstiger</unclear> <unclear cert="low" resp="#joint">wollmeinender</unclear> affe-
<lb n="16"/>ction mit <unclear cert="medium" resp="#joint">dienstlicher</unclear> <unclear cert="medium" resp="#joint">anerbietung</unclear> meiner ge-
<lb n="17"/><unclear cert="medium" resp="#joint">ringen</unclear> doch <unclear cert="medium" resp="#joint">eüßerst</unclear> <unclear cert="medium" resp="#joint">geflißnen</unclear> gehorsamen dienst
<lb n="18"/><unclear cert="medium" resp="#joint">bevelchen</unclear>. Datum <origPlace ref="stadtasg-places-24" cert="medium" resp="#ner">Lindau</origPlace> <origDate when="1622-12-24" resp="#ner">den 24. <unclear cert="medium" resp="#joint">decembris</unclear>
<lb n="19"/>im <unclear cert="low" resp="#joint">1622isten</unclear> <unclear cert="low" resp="#joint">jar</unclear></origDate>.
<lb n="20"/><unclear cert="low" resp="#joint">Eüer</unclear> <unclear cert="low" resp="#joint">Herrlikeit</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">dienstschuldiger</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">geflißner</unclear>
<lb n="23"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Adam</unclear> <unclear cert="low" resp="#joint">Cronuß</unclear></persName> zum
<lb n="24"/><unclear cert="medium" resp="#joint">Zieglhauß</unclear> bey Lindau
<lb n="25"/><unclear cert="medium" resp="#joint">wonhafft</unclear>.
<pb facs="StadtASG_Missive_2387_9160.jpg" n="2"/>
<pb facs="StadtASG_Missive_2387_9161.jpg" n="3"/>
<pb facs="StadtASG_Missive_2387_9162.jpg" n="4"/>
<lb n="26"/>Denen Edlen, Vesten, auch Ehrenvesten
<lb n="27"/>Wollweisen Herren, <unclear cert="low" resp="#joint">Herren</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Ambts</unclear>-
<lb n="28"/><unclear cert="low" resp="#joint">burgermeister</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">Bäwherren</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">loblichen</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear> <unclear cert="low" resp="#joint">etc</unclear></orgName>.
<lb n="30"/><unclear cert="low" resp="#joint">Meinen</unclear> <unclear cert="low" resp="#joint">gethräwlieben</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">guen</unclear>-
<lb n="31"/><unclear cert="low" resp="#joint">stigen</unclear> <unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">samet</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">sonders</unclear>.
</p>
