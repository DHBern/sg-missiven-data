<lb n="13"/><unclear cert="medium" resp="#joint">werdend</unclear> wir <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">hr</unclear>. <unclear cert="medium" resp="#joint">Bischoffen</unclear> zuo <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Costantz</placeName> die <unclear cert="medium" resp="#joint">nothurfft</unclear>
