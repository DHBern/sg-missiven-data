<lb n="6"/><unclear cert="medium" resp="#joint">vffs</unclear> innstendigist und <unclear cert="medium" resp="#joint">hoechst</unclear> <unclear cert="medium" resp="#joint">gebäten</unclear>, <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">wellen</unclear> <unclear cert="medium" resp="#joint">ihme</unclear> <unclear cert="medium" resp="#joint">die</unclear>
<lb n="7"/>hand <unclear cert="medium" resp="#joint">bieten</unclear>, daß er <unclear cert="low" resp="#joint">dermalen</unclear> <unclear cert="low" resp="#joint">eins</unclear> <unclear cert="low" resp="#joint">syner</unclear> <unclear cert="low" resp="#joint">langwürigen</unclear>
