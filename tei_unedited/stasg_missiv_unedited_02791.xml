<lb n="50"/><unclear cert="low" resp="#joint">offentlich</unclear> <unclear cert="low" resp="#joint">gelehret</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">kranken</unclear> <unclear cert="low" resp="#joint">daheym</unclear> <unclear cert="low" resp="#joint">besuecht</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">getroestet</unclear>, <unclear cert="low" resp="#joint">mit</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">christlicher</unclear> <unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">treüe</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">burgerschafft</unclear> einander gemeint,
<lb n="52"/>undt die gesunden den <unclear cert="low" resp="#joint">kranken</unclear> <unclear cert="low" resp="#joint">beygesprungen</unclear>, wie auch die sterbenden
<lb n="53"/>sich so fein zubereitet undt mitten im todt so hertzhaft zuerzeigen gewust,
