<lb n="26"/><unclear cert="low" resp="#joint">wuenschen</unclear>. <unclear cert="low" resp="#joint">Der</unclear> <unclear cert="low" resp="#joint">getroesten</unclear> <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">zuversicht</unclear>, <unclear cert="low" resp="#joint">weil</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">hertzlich</unclear> <unclear cert="low" resp="#joint">wol</unclear>-
<lb n="27"/><unclear cert="low" resp="#joint">gemeint</unclear>, <unclear cert="low" resp="#joint">alßo</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wtz</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">deroselb</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">besten</unclear> <unclear cert="low" resp="#joint">zuvermerckhen</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">auffzunemmen</unclear> <unclear cert="low" resp="#joint">großg</unclear>. <unclear cert="low" resp="#joint">geneigt</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">werden</unclear>.
<lb n="29"/>In den <unclear cert="low" resp="#joint">alten</unclear> <unclear cert="low" resp="#joint">kirchenhistorien</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">christen</unclear> der <unclear cert="low" resp="#joint">ersten</unclear> <unclear cert="low" resp="#joint">kirchen</unclear> von
<lb n="30"/>dem Eusebio unter andern auch dahero gelobt, daß sie sich aller <unclear cert="low" resp="#joint">christlichen</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">tugenden</unclear>, <unclear cert="low" resp="#joint">fuernemlich</unclear> <unclear cert="low" resp="#joint">aber</unclear> der <unclear cert="low" resp="#joint">bruederlichen</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">beflissen</unclear>, <unclear cert="low" resp="#joint">Ewelche</unclear> <unclear cert="low" resp="#joint">sie</unclear>
