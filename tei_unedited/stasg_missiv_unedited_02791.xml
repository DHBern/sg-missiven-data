<lb n="55"/><unclear cert="low" resp="#joint">Wie</unclear> <unclear cert="low" resp="#joint">mitleidenlich</unclear> <unclear cert="low" resp="#joint">aber</unclear>, <unclear cert="low" resp="#joint">treühertzig</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">freygebig</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">H</unclear>.
