<p>
<pb facs="StadtASG_Missive_2791_10905.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Gnadt</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">fridt</unclear> von <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">unsrem</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">vater</unclear>, <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">Jesu</unclear> <unclear cert="low" resp="#joint">Christo</unclear>, <unclear cert="low" resp="#joint">nebe</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">unserem</unclear> <unclear cert="low" resp="#joint">andaechtigen</unclear> <unclear cert="low" resp="#joint">gebaet</unclear> <unclear cert="low" resp="#joint">zuovorn</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Edle</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">veste</unclear>, <unclear cert="low" resp="#joint">frome</unclear>, <unclear cert="low" resp="#joint">ehrenveste</unclear>, <unclear cert="low" resp="#joint">fuerneme</unclear>, <unclear cert="low" resp="#joint">ersame</unclear> und wolweise
<lb n="5"/>herren und <unclear cert="low" resp="#joint">großguenstige</unclear> <unclear cert="low" resp="#joint">goenner</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">Gleich</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">dennen</unclear> <unclear cert="low" resp="#joint">obertschelchischen</unclear> <unclear cert="low" resp="#joint">erlebten</unclear> <unclear cert="low" resp="#joint">herbst</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">christlichen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">schuldigem</unclear> <unclear cert="low" resp="#joint">mitleiden</unclear> <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">schmertzlich</unclear> <unclear cert="low" resp="#joint">vernommen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Ehrs</unclear>.
<lb n="8"/><unclear cert="low" resp="#joint">Wußtz</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">deroselb</unclear> <orgName resp="#ner">Statt</orgName> und Landtschafft <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>, durch verhengnuß
<lb n="9"/>deß allgewalttigen undt strengen gottes, mit <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">scharpffen</unclear> <unclear cert="low" resp="#joint">ruthen</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">pestilentz</unclear>, <unclear cert="low" resp="#joint">negstverscheinen</unclear> <unclear cert="low" resp="#joint">sommen</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">schrecklich</unclear> <unclear cert="low" resp="#joint">heimgesucht</unclear>, und <unclear cert="low" resp="#joint">etliche</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">monat</unclear> <unclear cert="low" resp="#joint">aneinander</unclear> <unclear cert="low" resp="#joint">hart</unclear> <unclear cert="low" resp="#joint">geplagt</unclear> <unclear cert="low" resp="#joint">wordten</unclear>, In dem hierdurch ein grosse
<lb n="12"/>anzall nicht allein gemeiner leüt, sonders auch <unclear cert="low" resp="#joint">fuerneme</unclear> <unclear cert="low" resp="#joint">regentz</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">geistliche</unclear> und <unclear cert="low" resp="#joint">weltliche</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">gerissen</unclear>, haben auch die goettliche allmacht
<lb n="14"/><unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">gnedige</unclear> <unclear cert="low" resp="#joint">linderung</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">abwendunge</unclear> <unclear cert="low" resp="#joint">solches</unclear> <unclear cert="low" resp="#joint">schwaeren</unclear> <unclear cert="low" resp="#joint">straff</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">inniglig</unclear> <unclear cert="low" resp="#joint">ansrueffen</unclear> nicht unterlassen.
<lb n="16"/>Also ist uns anietzt desto mehr ene hertzliche freude zu vernehmen,
<lb n="17"/>daß der getreue gott undt vater, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">handt</unclear> <unclear cert="low" resp="#joint">beedeß</unclear> <unclear cert="low" resp="#joint">schlegt</unclear> und heilet,
<lb n="18"/>sein zuchtrutten nunmehr so <unclear cert="low" resp="#joint">gnediglich</unclear> <unclear cert="low" resp="#joint">hinweg</unclear> <unclear cert="low" resp="#joint">genommen</unclear>, <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">E</unclear>. Ehrnvest
<lb n="19"/>Wuystz und deroselb Statt undt Landtschafft widerumb mit <unclear cert="low" resp="#joint">gesunden</unclear> <unclear cert="low" resp="#joint">frischen</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">lufft</unclear> <unclear cert="low" resp="#joint">begabet</unclear> hatt.
<lb n="21"/>Fuer welche <unclear cert="low" resp="#joint">gnadt</unclear> wir nicht allein <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">hertzen</unclear> lob und danck sagen,
<lb n="22"/>alß <unclear cert="low" resp="#joint">weme</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">ueb</unclear> <unclear cert="low" resp="#joint">selbsten</unclear> <unclear cert="low" resp="#joint">widerfahren</unclear> <unclear cert="low" resp="#joint">wehre</unclear>, <unclear cert="low" resp="#joint">Sonders</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">auch</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">daneben</unclear> <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">umbgehen</unclear> <unclear cert="low" resp="#joint">moegen</unclear>, <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wtz</unclear> und <unclear cert="low" resp="#joint">deroselb</unclear> <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">dero</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">angehoerigen</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">burgerschafft</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">gantzen</unclear> <unclear cert="low" resp="#joint">commun</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear>, <unclear cert="low" resp="#joint">mit</unclear>
