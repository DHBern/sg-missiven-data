<lb n="34"/><unclear cert="low" resp="#joint">Von</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">pestzwar</unclear> <unclear cert="low" resp="#joint">schreibt</unclear> <unclear cert="low" resp="#joint">er</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">sterbensleüfften</unclear> <unclear cert="low" resp="#joint">einander</unclear> <unclear cert="low" resp="#joint">bey</unclear>-
<lb n="35"/><unclear cert="low" resp="#joint">stand</unclear> <unclear cert="low" resp="#joint">gelaistettrugen</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">krancken</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">inficirten</unclear>, <unclear cert="low" resp="#joint">ja</unclear> auch deren, die
<lb n="36"/>noch heüdtigen gewesen, so <unclear cert="low" resp="#joint">fleissig</unclear> <unclear cert="low" resp="#joint">gepflegt</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">gewarttet</unclear>, <unclear cert="low" resp="#joint">ungeachtet</unclear>,
<pb facs="StadtASG_Missive_2791_10906.jpg" n="2"/>
<lb n="37"/>sie darüber auch <unclear cert="low" resp="#joint">angestekt</unclear>, <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">offt</unclear> <unclear cert="low" resp="#joint">selbsten</unclear> das leben drüber einbuessen
<lb n="38"/>muessen.
<lb n="39"/>In den verfolgungen aber meldet er, wie sie nicht allein den <unclear cert="low" resp="#joint">armen</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">einheymischen</unclear> <unclear cert="low" resp="#joint">nothtleidenden</unclear> <unclear cert="low" resp="#joint">mitchristen</unclear> <unclear cert="low" resp="#joint">daheym</unclear> allerley <unclear cert="low" resp="#joint">guetthat</unclear> <unclear cert="low" resp="#joint">erwiesen</unclear>,
