<lb n="42"/><unclear cert="low" resp="#joint">verwiesen</unclear> gewesen, <unclear cert="low" resp="#joint">milde</unclear> <unclear cert="low" resp="#joint">handtreychung</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">steür</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">frembde</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">zugeschikt</unclear> haben. Wie <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">vierdten</unclear>, <unclear cert="low" resp="#joint">siebenden</unclear> <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">aillfften</unclear> <unclear cert="low" resp="#joint">buch</unclear> <unclear cert="low" resp="#joint">seiner</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">kirchenhistorien</unclear> <unclear cert="low" resp="#joint">hievon</unclear> <unclear cert="low" resp="#joint">weitlaeüfftiger</unclear> <unclear cert="low" resp="#joint">zulesen</unclear>.
<lb n="45"/><unclear cert="low" resp="#joint">Dergleichen</unclear> <unclear cert="low" resp="#joint">lob</unclear> nun <unclear cert="low" resp="#joint">kan</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">heütiges</unclear> <unclear cert="low" resp="#joint">tages</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">undt</unclear> <unclear cert="low" resp="#joint">H</unclear>. sambt
<lb n="46"/>dero christlichen gemein undt kirchen mit warheit gegeben werden.
<lb n="47"/>Dann mit was gueter ordnung und vaeterlicher vorsorge die obrigkeit
<lb n="48"/>in iunger sterbenslufft ihre angehoerige liebe <unclear cert="low" resp="#joint">burgerschafft</unclear> <unclear cert="low" resp="#joint">versehen</unclear>,
