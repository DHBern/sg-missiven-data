<p>
<pb facs="StadtASG_Missive_980_2975.jpg" n="1"/>
<lb n="1"/>Unnser frünndtlich guottwillig unnd <unclear cert="low" resp="#joint">nachpuir</unclear>-
<lb n="2"/><unclear cert="low" resp="#joint">lichs</unclear> <unclear cert="low" resp="#joint">diennst</unclear>, <unclear cert="low" resp="#joint">allzeitt</unclear> <unclear cert="low" resp="#joint">zuovor</unclear>, <unclear cert="low" resp="#joint">Ersam</unclear> <unclear cert="low" resp="#joint">fromm</unclear> <unclear cert="low" resp="#joint">fürs</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">sichtigenn</unclear> <unclear cert="low" resp="#joint">Ersamenn</unclear> unnd weysen, sonnders <unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">herren</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">frünnd</unclear>, unnd guotten nachpuirn. Unns bringt
<lb n="5"/>der Fr: Dt: Ertzhertzog <persName resp="#ner">Ferdinanden zuo Osterreich</persName> etc.
<lb n="6"/>unnsers gnedigisten <unclear cert="low" resp="#joint">herrns</unclear>, <unclear cert="low" resp="#joint">gehorsamer</unclear> <unclear cert="low" resp="#joint">unnderthon</unclear>
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">Hanns</unclear> <unclear cert="low" resp="#joint">Dietz</unclear></persName> <unclear cert="low" resp="#joint">zue</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Wolffurt</unclear></placeName>, <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">ambtsuerwandter</unclear>
<lb n="8"/>der herrschafft <placeName ref="stadtasg-places-60" cert="medium" resp="#ner">Bregentz</placeName>, zaiger dis briefs, Welcher-
<lb n="9"/>massen er gegen unnd wider <persName resp="#ner"><unclear cert="low" resp="#joint">Lauxen</unclear> <unclear cert="low" resp="#joint">Kitziunger</unclear></persName> <unclear cert="low" resp="#joint">ewerem</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">herren</unclear>, <unclear cert="low" resp="#joint">umb</unclear> unnd <unclear cert="low" resp="#joint">vonwegen</unclear> <unclear cert="low" resp="#joint">ains</unclear> <unclear cert="low" resp="#joint">weingartten</unclear> <unclear cert="low" resp="#joint">zue</unclear>
<lb n="11"/><placeName ref="stadtasg-places-119" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Balgach</unclear> <unclear cert="low" resp="#joint">im</unclear></placeName> <placeName ref="stadtasg-places-64" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Reintal</unclear></placeName> <unclear cert="low" resp="#joint">gelegen</unclear>, <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">irrung</unclear> <unclear cert="low" resp="#joint">spenn</unclear> <unclear cert="low" resp="#joint">unruow</unclear>
<lb n="12"/>unnd missuerstand komen unnd gewachsen, also das
<lb n="13"/>iederthail, zue demselben <unclear cert="low" resp="#joint">weingartten</unclear>. <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">pessern</unclear>
<lb n="14"/>recht unnd gerechtigkait zuhaben vermainet, und
<lb n="15"/>veder <unclear cert="low" resp="#joint">derowegen</unclear> <unclear cert="low" resp="#joint">erdult</unclear> <unclear cert="low" resp="#joint">solleern</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">mit</unclear> gedacht-
<lb n="16"/>em herrn <unclear cert="low" resp="#joint">Lauxen</unclear> <unclear cert="low" resp="#joint">Kitziunger</unclear>, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">euch</unclear> als des <unclear cert="low" resp="#joint">ortts</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">ordenlichen</unclear> <unclear cert="low" resp="#joint">richtern</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">gepuirt</unclear>, rechtlichen
<lb n="18"/>zuerörttern, unnd <unclear cert="low" resp="#joint">auszuefieren</unclear>. <unclear cert="low" resp="#joint">Unnd</unclear> <unclear cert="low" resp="#joint">unns</unclear> der-
<lb n="19"/>wegen <unclear cert="low" resp="#joint">zuebefürderung</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">austrag</unclear> <unclear cert="low" resp="#joint">solicher</unclear> <unclear cert="low" resp="#joint">irer</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">fürschrifft</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">euch</unclear>, <unclear cert="low" resp="#joint">daro</unclear> er wol zuge-
<lb n="21"/>niessen verhofft, unns elaius angeruefft und gepetten,
<lb n="22"/>die wir ime umb der pillichait willen, nit waigern
<lb n="23"/>kunden noch sollen. Gelanngt demnach <unclear cert="low" resp="#joint">inn</unclear>-
<lb n="24"/><unclear cert="low" resp="#joint">namen</unclear> <unclear cert="low" resp="#joint">hochgedachter</unclear> <unclear cert="low" resp="#joint">Fr</unclear>: <unclear cert="low" resp="#joint">Dt</unclear>: <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">ersuoch</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">unnserr</unclear> <unclear cert="low" resp="#joint">Personen</unclear> <unclear cert="low" resp="#joint">frünndtlichs</unclear> <unclear cert="low" resp="#joint">vleissigs</unclear> und
<lb n="26"/><unclear cert="low" resp="#joint">nachpuirlichs</unclear> <unclear cert="low" resp="#joint">pitten</unclear>, <unclear cert="low" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">wellt</unclear> <unclear cert="low" resp="#joint">gedachten</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Hannsen</unclear> <unclear cert="low" resp="#joint">Dietzen</unclear></persName>
<lb n="27"/><unclear cert="low" resp="#joint">unnsern</unclear> <unclear cert="low" resp="#joint">Ambtsuerwandten</unclear>, <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">seinem</unclear> rechtlichen
<lb n="28"/><unclear cert="low" resp="#joint">fürbringen</unclear>, <unclear cert="low" resp="#joint">giunstiegclichen</unclear> <unclear cert="low" resp="#joint">anuhören</unclear>, <unclear cert="low" resp="#joint">unbeswert</unclear>
<lb n="29"/>sein, ime <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">ambts</unclear> <unclear cert="low" resp="#joint">und</unclear> oberkait wegen seinem mit-
<lb n="30"/>burger, vürgeachten ewers herren, zue recht stellen, und
<lb n="31"/>sunsten souil sein sach, das recht. unnd ewer stattge-
<lb n="32"/>richts <unclear cert="low" resp="#joint">geprauch</unclear> <unclear cert="low" resp="#joint">erleiden</unclear> unnd <unclear cert="low" resp="#joint">vermögen</unclear>, <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">guote</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">befürderung</unclear>. <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">hilffliche</unclear> mittel vndters erzaigen
<lb n="34"/>damit er <unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">armer</unclear> <unclear cert="low" resp="#joint">gsell</unclear> mit <unclear cert="low" resp="#joint">khisten</unclear> <unclear cert="low" resp="#joint">unnd</unclear> ver-
<lb n="35"/><unclear cert="low" resp="#joint">gebenlichen</unclear> <unclear cert="low" resp="#joint">umbziehen</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">disen</unclear> <unclear cert="low" resp="#joint">sach</unclear>, <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">ruiwen</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">khomen</unclear>. <unclear cert="low" resp="#joint">Unnd</unclear> <unclear cert="low" resp="#joint">euch</unclear> gegen ime, unnsers unzweiflen-
<pb facs="StadtASG_Missive_980_2976.jpg" n="2"/>
<lb n="37"/>thuen, so guenstigclichen beweisen, damit er diser
<lb n="38"/>unser fuerbitht genossen haben, fuerer sich roemen
<lb n="39"/>unnd <unclear cert="low" resp="#joint">freuwen</unclear> <unclear cert="low" resp="#joint">moeg</unclear>. Das begeren wir umb
<lb n="40"/>Euch, Inn sölchen unnd dergleichen faellen wo sich
<lb n="41"/>die begeben, freündtlich unnd nachpürlich <unclear cert="low" resp="#joint">zůer=</unclear>
<lb n="42"/>widern, Unnd <unclear cert="medium" resp="#joint">uns</unclear> Euch hieneben von unns freündt=
<lb n="43"/>lich unnd nachpürlich lieb <unclear cert="low" resp="#joint">sy</unclear>. Datum <unclear cert="low" resp="#joint">Bre=</unclear>
<lb n="44"/><origPlace ref="stadtasg-places-60" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">genntz</unclear></origPlace> <origDate when="1572" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">xxiiii</unclear> <unclear cert="low" resp="#joint">t</unclear> tag februarij anno etc. <unclear cert="low" resp="#joint">Lxxij</unclear> <unclear cert="low" resp="#joint">t</unclear></origDate>.
<lb n="45"/><unclear cert="low" resp="#joint">Fr</unclear>: <unclear cert="low" resp="#joint">Dt</unclear>: <unclear cert="low" resp="#joint">Ertzhertzog</unclear> <persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Ferdinanden</unclear> <unclear cert="low" resp="#joint">zuo</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">Oesterreich</unclear></persName> etc. <unclear cert="low" resp="#joint">vogt</unclear>, unnd ambtleüth
<lb n="47"/>baider herrschafften <placeName ref="stadtasg-places-60" cert="medium" resp="#ner">Bregenntz</placeName> unnd
<lb n="48"/><placeName ref="stadtasg-places-150" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Hohenegg</unclear></placeName>.
