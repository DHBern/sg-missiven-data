    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1789_6607.jpg" n="1"/>
<lb n="1"/>Unser früntlich willig <unclear cert="medium" resp="#joint">dinst</unclear>, unnd was wir ehren, liebs
<lb n="2"/>unnd guots vermoegend zuovor, <unclear cert="medium" resp="#joint">From</unclear> <unclear cert="medium" resp="#joint">fürsihtig</unclear> Eersam Wyß,
<lb n="3"/>Innsonnders guot fründt, unnd gethrüw lieb <unclear cert="low" resp="#joint">Eidtgnoßen</unclear>.
<lb n="4"/>Uß <unclear cert="medium" resp="#joint">üwerm</unclear> schryben habent wir verstanden, <unclear cert="low" resp="#joint">was</unclear> Ir von
<lb n="5"/>wegen <unclear cert="medium" resp="#joint">deß</unclear> durch die <unclear cert="low" resp="#joint">Kö</unclear>. <unclear cert="low" resp="#joint">Mt</unclear>. zuo <placeName resp="#ner"><unclear cert="medium" resp="#joint">Savoj</unclear></placeName> by <unclear cert="medium" resp="#joint">üwern</unclear> unnd
<lb n="6"/><unclear cert="medium" resp="#joint">unnsern</unclear> lieben <unclear cert="medium" resp="#joint">Eidtgnoßen</unclear> zuo <placeName ref="stadtasg-places-133" cert="medium" resp="#ner">Basel</placeName> <unclear cert="medium" resp="#joint">begärenden</unclear> <unclear cert="medium" resp="#joint">paßes</unclear>
<lb n="7"/>für <unclear cert="low" resp="#joint">Irer</unclear> <unclear cert="low" resp="#joint">Kö</unclear>. <unclear cert="low" resp="#joint">Mt</unclear>. <unclear cert="low" resp="#joint">unnderthanen</unclear> <unclear cert="low" resp="#joint">conduiten</unclear> <unclear cert="low" resp="#joint">guetern</unclear>, <unclear cert="low" resp="#joint">an</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">gelangen</unclear> <unclear cert="low" resp="#joint">laßend</unclear>. Unnd diewyl wir
<lb n="9"/>etlichen unnseren <unclear cert="medium" resp="#joint">Mitrhaten</unclear>, so <unclear cert="medium" resp="#joint">anderer</unclear> <unclear cert="medium" resp="#joint">gschefften</unclear> halb-
<lb n="10"/><unclear cert="low" resp="#joint">er</unclear> by <unclear cert="low" resp="#joint">gemelten</unclear> <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">Eidtgnoßen</unclear> zuo <placeName ref="stadtasg-places-133" cert="medium" resp="#ner">Basel</placeName> <unclear cert="medium" resp="#joint">albereit</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">unnderwägen</unclear> <unclear cert="medium" resp="#joint">warent</unclear>, <unclear cert="medium" resp="#joint">zuovor</unclear> schon inn <unclear cert="low" resp="#joint">beuelch</unclear> gegeben,
<lb n="12"/>sich mit <unclear cert="low" resp="#joint">Inen</unclear> <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">Eidtgnoßen</unclear> <unclear cert="low" resp="#joint">uß</unclear> diser sach mündt-
<lb n="13"/>lich <unclear cert="low" resp="#joint">zuoersprachen</unclear>, der <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">wigtigkeit</unclear> unnd <unclear cert="medium" resp="#joint">nachvolg</unclear>
<lb n="14"/>nach notturfft <unclear cert="medium" resp="#joint">fürzebilden</unclear>, unnd sy zuo guotem willen
<lb n="15"/><unclear cert="low" resp="#joint">fzueigene</unclear> <unclear cert="low" resp="#joint">entschluße</unclear> <unclear cert="low" resp="#joint">zuovermannen</unclear>. So habent wir
<lb n="16"/>gedachte unnsere <unclear cert="low" resp="#joint">Mitrhat</unclear> <unclear cert="low" resp="#joint">üwers</unclear> schrybens <unclear cert="low" resp="#joint">Innhalts</unclear> durch
<lb n="17"/><unclear cert="low" resp="#joint">einen</unclear> Inn yl nachgeschickten <unclear cert="low" resp="#joint">eignen</unclear> <unclear cert="low" resp="#joint">boten</unclear> berichten <unclear cert="medium" resp="#joint">laßen</unclear>,
<lb n="18"/>damit sy das <unclear cert="low" resp="#joint">Ihenig</unclear>, <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">gmeiner</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidtgnoßschafft</unclear></orgName> <unclear cert="low" resp="#joint">hierunnder</unclear>
<lb n="19"/>beschwerlich unnd bedencklich <unclear cert="medium" resp="#joint">fürfallen</unclear> will, gemelten
<lb n="20"/>von <placeName ref="stadtasg-places-133" cert="medium" resp="#ner">Basel</placeName> desto <unclear cert="low" resp="#joint">baß</unclear> nach gebür fürzehalten <unclear cert="low" resp="#joint">wüßtint</unclear>.
<lb n="21"/>Sind also guoter hoffnung, es werde uff <unclear cert="medium" resp="#joint">söllichs</unclear> alles
<lb n="22"/>von Inen ein <unclear cert="low" resp="#joint">guoter</unclear> <unclear cert="low" resp="#joint">willfariger</unclear> fründtlicher entschluß
<lb n="23"/>unnd <unclear cert="medium" resp="#joint">bescheidt</unclear> fürderlich <unclear cert="low" resp="#joint">ervolgen</unclear>. <unclear cert="low" resp="#joint">Deßen</unclear> wir
<lb n="24"/>üch uff üwer <unclear cert="low" resp="#joint">schryben</unclear> <unclear cert="low" resp="#joint">Inn</unclear> <unclear cert="low" resp="#joint">antwort</unclear> berichten, unnd <unclear cert="low" resp="#joint">deby</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">Götlichem</unclear> <unclear cert="low" resp="#joint">schirm</unclear> beuelchen thund. Date <origDate when="1612" resp="#ner"><unclear cert="low" resp="#joint">Mitwuches</unclear>
<lb n="26"/>den 12.ten Augustj. Anno 1612</origDate>.
<lb n="27"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister unnd <unclear cert="low" resp="#joint">Raht</unclear>
<lb n="28"/>der <unclear cert="medium" resp="#joint">Stat</unclear> Zürich</orgName>.
<pb facs="StadtASG_Missive_1789_6608.jpg" n="2"/>
<pb facs="StadtASG_Missive_1789_6609.jpg" n="3"/>
<pb facs="StadtASG_Missive_1789_6610.jpg" n="4"/>
<lb n="29"/>Den frommen fürsichtigen, ehrsamen,
<lb n="30"/>wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> unnd Rath der
<lb n="31"/>Statt Sanct Gallen</orgName>, unnseren in-
<lb n="32"/>sonders gueten fründen, unnd ge-
<lb n="33"/>thrüwen lieben Eydtgnossen.
</p>
