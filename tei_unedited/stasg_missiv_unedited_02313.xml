    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2313_8823.jpg" n="1"/>
<lb n="1"/>Unser fründt, nachparlich und guott-
<lb n="2"/>willige dienst zuovor, fürsichtige, er-
<lb n="3"/>same, weiße besonders liebe fründ und
<lb n="4"/>guote nachparn.
<lb n="5"/>Auß ewerem dem, disen des Buchbinders
<lb n="6"/>daanebent, an unß abgangnen nach-
<lb n="7"/>parlichen schreiben, habend wir <unclear cert="low" resp="#joint">zwaar</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">mehrerem</unclear> <unclear cert="low" resp="#joint">vernomen</unclear>, <unclear cert="low" resp="#joint">waßen</unclear> ir,
<lb n="9"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">umbstendtlichen</unclear> <unclear cert="low" resp="#joint">verlauff</unclear>, <unclear cert="low" resp="#joint">damitt</unclear>
<lb n="10"/>von etlichen <unclear cert="low" resp="#joint">eweren</unclear> <unclear cert="low" resp="#joint">mitburger</unclear> <unclear cert="low" resp="#joint">jüngst</unclear> <unclear cert="low" resp="#joint">al</unclear>-
<lb n="11"/>hie <unclear cert="low" resp="#joint">verübten</unclear> <unclear cert="low" resp="#joint">excesses</unclear>, <unclear cert="low" resp="#joint">üch</unclear> nachparlichen
<lb n="12"/><unclear cert="low" resp="#joint">zeberichten</unclear> begehren.
<lb n="13"/>Sollend aber üch hinwider nachparlichen
<lb n="14"/><unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">pergen</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">gleichs</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">nechst</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="15"/><unclear cert="low" resp="#joint">gangnen</unclear> <origDate resp="#ner"><unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">Martins</unclear> <unclear cert="low" resp="#joint">aabend</unclear></origDate>, etwelch
<lb n="16"/>ewere angehörigen, <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">im</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">würtßher</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">berg</unclear></placeName>, <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">fauststreichs</unclear> <unclear cert="low" resp="#joint">uongebür</unclear> be-
<lb n="18"/>gangen.
<lb n="19"/>Wilen aber selbige alberaith darumben
<lb n="20"/>abgestrafft, von inen auch die <unclear cert="low" resp="#joint">straffen</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">gebürlichen</unclear> <unclear cert="low" resp="#joint">abgelegt</unclear> <unclear cert="low" resp="#joint">worden</unclear>.
<lb n="22"/><unclear cert="low" resp="#joint">Alß</unclear> <unclear cert="low" resp="#joint">wolen</unclear> wir <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">gern</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">mehrer</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">weiterung</unclear> <unclear cert="low" resp="#joint">ursach</unclear> <unclear cert="low" resp="#joint">geben</unclear>, und <unclear cert="low" resp="#joint">alhir</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="24"/><unclear cert="low" resp="#joint">loffner</unclear> <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">weiters</unclear> <unclear cert="low" resp="#joint">gedenken</unclear> <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">verhoffentlich</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">von</unclear> unß guotth
<lb n="26"/>gemainth, alß ir <unclear cert="low" resp="#joint">beschech</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">ungleichem</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">zuovermercken</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">gweilt</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">werden</unclear>.
<pb facs="StadtASG_Missive_2313_8824.jpg" n="2"/>
<lb n="29"/>Denen wir besten angeneme nachparschafft
<lb n="30"/>zuoerweißen, iederzeit beharlichen er-
<lb n="31"/>bietens verbleiben. Dat. <origDate when="1621-12-16" resp="#ner">16. Decembrl.
<lb n="32"/>a° 1621</origDate>.
<lb n="33"/><orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner">Haubtman burgermeister
<lb n="34"/>und rath der statt Costanz</orgName>,
<pb facs="StadtASG_Missive_2313_8825.jpg" n="3"/>
<pb facs="StadtASG_Missive_2313_8826.jpg" n="4"/>
<lb n="35"/><unclear cert="low" resp="#joint">Denen</unclear> fürsichtigen, <unclear cert="low" resp="#joint">ersamen</unclear>, <unclear cert="low" resp="#joint">weiß=</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">en</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister unnd rath <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">S</unclear>.
<lb n="37"/>Gallen</orgName>, <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">besonders</unclear> lieben
<lb n="38"/><unclear cert="low" resp="#joint">freünd</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">guoten</unclear> <unclear cert="low" resp="#joint">nachpauren</unclear>.
</p>
