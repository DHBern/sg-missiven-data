<p>
<pb facs="StadtASG_Missive_2005_7481.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freündtlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear>, und was wir
<lb n="2"/>mehr ehren, liebs und <unclear cert="medium" resp="#joint">guets</unclear> vermögend, zuvor,
<lb n="3"/>fürsichtig, Ersam und Weiß, <unclear cert="medium" resp="#joint">besonders</unclear> liebe
<lb n="4"/><unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">freünd</unclear> und nachbarn.
<lb n="5"/>Was <unclear cert="medium" resp="#joint">maßen</unclear> ein <unclear cert="medium" resp="#joint">Sültzischer</unclear> <unclear cert="medium" resp="#joint">Bevelchhaber</unclear> zu
<lb n="6"/><placeName ref="stadtasg-places-77" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Ravenspurg</unclear></placeName> knecht geworben,
<lb n="7"/>haben wir auß <unclear cert="medium" resp="#joint">ihrem</unclear> <unclear cert="medium" resp="#joint">schreiben</unclear> (darfür
<lb n="8"/>wir <unclear cert="medium" resp="#joint">unß</unclear> nachbarlich <unclear cert="medium" resp="#joint">bedanckhen</unclear>.) mit
<lb n="9"/>mehrerm <unclear cert="medium" resp="#joint">vernomen</unclear>, Und <unclear cert="medium" resp="#joint">komt</unclear> <unclear cert="medium" resp="#joint">unß</unclear>
<lb n="10"/>für, daß zu <placeName resp="#ner">Biberach</placeName> gleichmeßigs <unclear cert="medium" resp="#joint">geschehe</unclear>.
<lb n="11"/>Wie dann die Statt <placeName ref="stadtasg-places-28" cert="medium" resp="#ner">Ulm</placeName> <unclear cert="medium" resp="#joint">unß</unclear> gleicher gestalt
<lb n="12"/>von diser <unclear cert="medium" resp="#joint">Sültzischen</unclear> werbung auch berichtet,
<lb n="13"/>und mit namen, daß <unclear cert="medium" resp="#joint">inn</unclear> den deßhalb
<lb n="14"/><unclear cert="medium" resp="#joint">erthailten</unclear> <unclear cert="medium" resp="#joint">kaiserlichen</unclear> patenten <unclear cert="medium" resp="#joint">expresse</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">eingeverleibt</unclear>, daß die <unclear cert="medium" resp="#joint">geworbne</unclear> knecht
<lb n="16"/>auf <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Roschach</unclear></placeName>, <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">SantGallen</unclear></placeName>, und <unclear cert="medium" resp="#joint">fort</unclear> <unclear cert="medium" resp="#joint">gen</unclear> <placeName ref="stadtasg-places-70" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Uri</unclear></placeName>
<lb n="17"/><unclear cert="medium" resp="#joint">gefüehrt</unclear> werden sollen. darvon <unclear cert="medium" resp="#joint">doch</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">unsers</unclear> <unclear cert="medium" resp="#joint">nachbarn</unclear> <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">Abbts</unclear> (der <unclear cert="medium" resp="#joint">diser</unclear>
<lb n="19"/>zeit <unclear cert="medium" resp="#joint">im</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Griesbach</unclear></placeName> sich <unclear cert="medium" resp="#joint">befindt</unclear>.) <unclear cert="medium" resp="#joint">hinderlaßne</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">Räht</unclear> (die wir darumb <unclear cert="medium" resp="#joint">ersuechen</unclear> <unclear cert="medium" resp="#joint">laßen</unclear>,) <unclear cert="medium" resp="#joint">gentzlich</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">nichts</unclear> <unclear cert="medium" resp="#joint">wüßen</unclear> wollen.
<lb n="22"/>Welches <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">F</unclear>: <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Wht</unclear>: wir in <unclear cert="low" resp="#joint">freündt</unclear>- <unclear cert="low" resp="#joint">nach</unclear>-
<lb n="23"/><unclear cert="low" resp="#joint">barlicher</unclear> antwurt, nit verhalten wollen,
<lb n="24"/>und bleiben ihnen zu nachbarlichen <unclear cert="medium" resp="#joint">diensten</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">ebenmeßig</unclear> wol <unclear cert="medium" resp="#joint">beigethon</unclear>. <unclear cert="medium" resp="#joint">Göttlicher</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">Vorsehung</unclear> <unclear cert="medium" resp="#joint">unß</unclear> zumal wol <unclear cert="medium" resp="#joint">bevelhend</unclear>.
<lb n="27"/><unclear cert="medium" resp="#joint">Datl</unclear>. den .<origDate when="1616" resp="#ner"><unclear cert="low" resp="#joint">9</unclear>. <unclear cert="low" resp="#joint">El</unclear>. <unclear cert="low" resp="#joint">Junii</unclear> <unclear cert="low" resp="#joint">Ao</unclear> <unclear cert="low" resp="#joint">1616</unclear></origDate>.
<lb n="28"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">B</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">Raht</unclear> <unclear cert="low" resp="#joint">etc</unclear></orgName>.
<lb n="29"/>An die von <orgName ref="stadtasg-actors-511" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Lindau</unclear></orgName>.
