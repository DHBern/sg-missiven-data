    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_921_2695.jpg" n="1"/>
<lb n="1"/>Unser früntlich willig dienst sampt
<lb n="2"/>was wir eren liebs unnd <unclear cert="medium" resp="#joint">guets</unclear> ver=
<lb n="3"/><unclear cert="medium" resp="#joint">moegenn</unclear> zuvor, <unclear cert="low" resp="#joint">fromen</unclear> <unclear cert="low" resp="#joint">fürsichtigen</unclear> <unclear cert="low" resp="#joint">ersamen</unclear>
<lb n="4"/>unnd <unclear cert="low" resp="#joint">wyßen</unclear>, insonnders <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">fründt</unclear>,
<lb n="5"/>und <unclear cert="low" resp="#joint">getrüwen</unclear> lieben <unclear cert="medium" resp="#joint">eydtgnossen</unclear>,
<lb n="6"/>unser <unclear cert="low" resp="#joint">schulths</unclear> herr <persName resp="#ner"><unclear cert="low" resp="#joint">Josig</unclear> <unclear cert="low" resp="#joint">Helmlin</unclear></persName>,
<lb n="7"/>so uff <unclear cert="low" resp="#joint">jüngst</unclear> <unclear cert="low" resp="#joint">gehalltnem</unclear> tag zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="medium" resp="#joint">im</unclear>
<lb n="8"/><placeName ref="stadtasg-places-266" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Ergoew</unclear></placeName> unser rats anwallt <unclear cert="low" resp="#joint">gsyn</unclear>, <unclear cert="low" resp="#joint">hat</unclear>
<lb n="9"/>unns fürbracht, das herr burger=
<lb n="10"/>meister von <placeName resp="#ner">Cham</placeName> von <placeName ref="stadtasg-places-32" cert="medium" resp="#ner">Zürich</placeName>, ime <unclear cert="low" resp="#joint">angezoeigt</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">alls</unclear> dann etliche ungehorsame personen,
<lb n="12"/>in <unclear cert="medium" resp="#joint">unnser</unclear> graffschafft <placeName ref="stadtasg-places-153" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rotenburg</unclear></placeName>, unbillicher
<lb n="13"/><unclear cert="medium" resp="#joint">wyß</unclear> sich wider unns <unclear cert="low" resp="#joint">enboert</unclear>, unnd
<lb n="14"/>ungehorsam erzeigt, etc. derhalben etliche
<lb n="15"/>ort loblicher <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eydtgnoschafft</orgName>, <unclear cert="low" resp="#joint">uß</unclear> schuldiger
<lb n="16"/>pflicht ir ersam <unclear cert="medium" resp="#joint">ratsbotschafft</unclear> zuo unns
<lb n="17"/>geschickt mit <unclear cert="low" resp="#joint">gebürendem</unclear> <unclear cert="low" resp="#joint">befelch</unclear>, <unclear cert="low" resp="#joint">wyl</unclear> aber
<lb n="18"/>dise sach gar <unclear cert="low" resp="#joint">schnaell</unclear> <unclear cert="low" resp="#joint">hingelegt</unclear>, <unclear cert="low" resp="#joint">wyl</unclear> die
<lb n="19"/><unclear cert="low" resp="#joint">ungehorsamen</unclear> kein <unclear cert="low" resp="#joint">gegrünte</unclear> ursach ghan
<lb n="20"/>sich allso <unclear cert="low" resp="#joint">zeenboeren</unclear>, alls sy selbs bekennen
<lb n="21"/><unclear cert="low" resp="#joint">muessen</unclear> durch <unclear cert="low" resp="#joint">etlich</unclear> unruewig personen unbe=
<lb n="22"/>dacht die mit <unclear cert="medium" resp="#joint">zherlicher</unclear> hand <unclear cert="low" resp="#joint">meyntyls</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">fürgenomen</unclear> syn. Namlich das ir unser
<lb n="24"/>lieb eydtgnossen, üwer ersam <unclear cert="medium" resp="#joint">ratsbot=</unclear>
<lb n="25"/>schafft ouch <unclear cert="low" resp="#joint">abgevertiget</unclear> habendt die=
<pb facs="StadtASG_Missive_921_2696.jpg" n="2"/>
<lb n="26"/>gan <placeName ref="stadtasg-places-32" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Zuerich</unclear></placeName> <unclear cert="low" resp="#joint">ankome</unclear>, wijl aber <unclear cert="low" resp="#joint">wolbemellter</unclear>
<lb n="27"/>burgermeister von <placeName resp="#ner">Cham</placeName> und <unclear cert="low" resp="#joint">sijn</unclear> <unclear cert="low" resp="#joint">mitther</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">uß</unclear> befelch ir herren und obern, unser lieben
<lb n="29"/><unclear cert="low" resp="#joint">eijdtgnossen</unclear> von <unclear cert="low" resp="#joint">Zuerich</unclear> zuovor bij <unclear cert="low" resp="#joint">unß</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">gsijn</unclear>, alles grundts <unclear cert="medium" resp="#joint">bricht</unclear> <unclear cert="medium" resp="#joint">gethondt</unclear>,
<lb n="31"/>derhalben üwer ersam <unclear cert="low" resp="#joint">ratsbottschfft</unclear>
<lb n="32"/>verstendiget und <unclear cert="low" resp="#joint">vermogen</unclear> wider (wijl
<lb n="33"/>wie <unclear cert="low" resp="#joint">obstadt</unclear> sich <unclear cert="low" resp="#joint">wijter</unclear> <unclear cert="low" resp="#joint">zebemueijen</unclear> nit von
<lb n="34"/><unclear cert="low" resp="#joint">noetten</unclear>) <unclear cert="low" resp="#joint">heim</unclear> <unclear cert="low" resp="#joint">zerijten</unclear>, <unclear cert="medium" resp="#joint">koennen</unclear> und <unclear cert="low" resp="#joint">werdend</unclear>
<lb n="35"/>wir doch üwer guot <unclear cert="low" resp="#joint">vorhaben</unclear> <unclear cert="low" resp="#joint">unß</unclear> erzeigt
<lb n="36"/>nit in <unclear cert="low" resp="#joint">vergeß</unclear> stellen, sonders wo das <unclear cert="low" resp="#joint">ze</unclear>-
<lb n="37"/>beschulden kompt <unclear cert="medium" resp="#joint">eijdtgnossischer</unclear> pflicht
<lb n="38"/>nach, haben <unclear cert="medium" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">erwidern</unclear> und verdienen
<lb n="39"/><unclear cert="low" resp="#joint">danckend</unclear> üch gantz fründtlich
<lb n="40"/><unclear cert="medium" resp="#joint">soelicher</unclear> <unclear cert="medium" resp="#joint">eijdtgnossischer</unclear> guotwilligkeijt,
<lb n="41"/>üch und <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="medium" resp="#joint">hiemitt</unclear> in den <unclear cert="medium" resp="#joint">schirmm</unclear>
<lb n="42"/><unclear cert="medium" resp="#joint">goetlicher</unclear> gnaden befelchende, <unclear cert="low" resp="#joint">uß</unclear> unserm
<lb n="43"/><unclear cert="medium" resp="#joint">rhat</unclear> <origDate when="1570" resp="#ner"><unclear cert="medium" resp="#joint">mittwoch</unclear> nach mittvasten anno
<lb n="44"/>1570</origDate>
<lb n="45"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Schultheß</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">rhat</unclear>
<lb n="46"/>der statt <unclear cert="low" resp="#joint">Lucernn</unclear></orgName>.
<pb facs="StadtASG_Missive_921_2697.jpg" n="3"/>
<pb facs="StadtASG_Missive_921_2698.jpg" n="4"/>
<lb n="47"/>Den fromen <unclear cert="low" resp="#joint">fuersichtigenn</unclear>
<lb n="48"/>ersamen unnd <unclear cert="low" resp="#joint">wyßenn</unclear>,
<lb n="49"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd Rat der
<lb n="50"/>statt Sant Gallen</orgName>, unsern
<lb n="51"/><unclear cert="low" resp="#joint">inßonders</unclear> <unclear cert="medium" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">fruenden</unclear> unnd
<lb n="52"/>getruewen lieben <unclear cert="low" resp="#joint">Eydtgnon</unclear>.
</p>
