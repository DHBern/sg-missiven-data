<lb n="23"/>ettwas <unclear cert="low" resp="#joint">rechtmeßiger</unclear> <unclear cert="low" resp="#joint">ansprach</unclear>, an <unclear cert="low" resp="#joint">erstgedachtß</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">Ires</unclear> <unclear cert="low" resp="#joint">Brueders</unclear> <unclear cert="low" resp="#joint">säligen</unclear> verlaßenschafft, <unclear cert="medium" resp="#joint">zehaben</unclear> <unclear cert="medium" resp="#joint">vermeindt</unclear>,
<lb n="25"/><unclear cert="medium" resp="#joint">guot</unclear> <unclear cert="medium" resp="#joint">uffrichtigs</unclear> Recht <unclear cert="low" resp="#joint">erthëlt</unclear>: <unclear cert="low" resp="#joint">unnd</unclear> so <unclear cert="low" resp="#joint">disers</unclear>-
<lb n="26"/><unclear cert="low" resp="#joint">halben</unclear> ettwas <unclear cert="low" resp="#joint">Rechtsüebung</unclear> <unclear cert="low" resp="#joint">angfangen</unclear> der
<lb n="27"/>rechtliche <unclear cert="medium" resp="#joint">proceß</unclear>, <unclear cert="medium" resp="#joint">wie</unclear> ouch die <unclear cert="medium" resp="#joint">ußthëllung</unclear>,
<lb n="28"/>(biß uff <unclear cert="medium" resp="#joint">wÿtteren</unclear> <unclear cert="medium" resp="#joint">bscheid</unclear>.) <unclear cert="medium" resp="#joint">ÿngestelt</unclear> werdenn. <unclear cert="low" resp="#joint">etc</unclear>.
<pb facs="StadtASG_Missive_1990_7418.jpg" n="2"/>
<lb n="29"/><unclear cert="low" resp="#joint">Diß</unclear> <unclear cert="low" resp="#joint">hab</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">herren</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">chürtze</unclear> <unclear cert="low" resp="#joint">verstendigen</unclear>, unnd
