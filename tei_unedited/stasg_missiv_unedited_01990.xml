<p>
<pb facs="StadtASG_Missive_1990_7417.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Gestreng</unclear>. Edel. <unclear cert="medium" resp="#joint">Ehrenvest</unclear>. <unclear cert="medium" resp="#joint">From</unclear>, fürnem, fürsichtig,
<lb n="2"/><unclear cert="medium" resp="#joint">Ehrsame</unclear>, unnd <unclear cert="medium" resp="#joint">wÿße</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> Herren, guete fründ, unnd
<lb n="3"/><orgName role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eÿdtgnoßen</unclear></orgName>. Nach <unclear cert="low" resp="#joint">mÿnem</unclear> <unclear cert="low" resp="#joint">fründtlichen</unclear> <unclear cert="low" resp="#joint">grueß</unclear>,
<lb n="4"/><unclear cert="low" resp="#joint">sÿendt</unclear> <unclear cert="low" resp="#joint">denselben</unclear>, <unclear cert="low" resp="#joint">mÿne</unclear> <unclear cert="low" resp="#joint">bereidtwilligen</unclear> <unclear cert="low" resp="#joint">dinst</unclear>, <unclear cert="low" resp="#joint">jeder</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">zÿtt</unclear> <unclear cert="low" resp="#joint">zueroran</unclear> <unclear cert="low" resp="#joint">etc</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">Diewÿl</unclear> die Herren, was <persName resp="#ner"><unclear cert="medium" resp="#joint">Mathÿas</unclear> <unclear cert="medium" resp="#joint">Moßburgers</unclear></persName>,
<lb n="7"/><unclear cert="medium" resp="#joint">Ires</unclear> <unclear cert="medium" resp="#joint">gewäßnen</unclear> Burgers, (<unclear cert="medium" resp="#joint">welchen</unclear> <unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">vier</unclear> <unclear cert="medium" resp="#joint">jaren</unclear>,
<lb n="8"/>unnd <unclear cert="low" resp="#joint">gar</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">sÿn</unclear> <unclear cert="low" resp="#joint">verlaßne</unclear> wittwen zuo <unclear cert="medium" resp="#joint">Beitz</unclear>-
<lb n="9"/><unclear cert="medium" resp="#joint">now</unclear> <unclear cert="medium" resp="#joint">todes</unclear> <unclear cert="medium" resp="#joint">verschiden</unclear>.) verlaßenschafft <unclear cert="medium" resp="#joint">sÿe</unclear>. unnd sonder-
<lb n="10"/>lich, was nach <unclear cert="medium" resp="#joint">Innhaltt</unclear>, <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">hie</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Beitznow</unclear></placeName> <unclear cert="medium" resp="#joint">vberndten</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">Erbrechtenß</unclear>, an <unclear cert="medium" resp="#joint">mehrgedachts</unclear> <unclear cert="medium" resp="#joint">Moßburgers</unclear>, verlaßne
<lb n="12"/><unclear cert="medium" resp="#joint">erben</unclear>, <unclear cert="medium" resp="#joint">erblichen</unclear> gefallen, unnd <unclear cert="medium" resp="#joint">ghören</unclear> <unclear cert="medium" resp="#joint">möge</unclear>. <unclear cert="medium" resp="#joint">vonn</unclear>
<lb n="13"/>mir <unclear cert="medium" resp="#joint">bricht</unclear> <unclear cert="medium" resp="#joint">begärtt</unclear>. Ich aber von <unclear cert="medium" resp="#joint">söchen</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">sach</unclear>. <unclear cert="medium" resp="#joint">Callß</unclear> ein <unclear cert="medium" resp="#joint">nüwangeträttner</unclear>.) biß uff dise
<lb n="15"/>stund, kein <unclear cert="medium" resp="#joint">wüsen</unclear> <unclear cert="medium" resp="#joint">gheptt</unclear>. <unclear cert="medium" resp="#joint">So</unclear> <unclear cert="medium" resp="#joint">gblangt</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">ann</unclear> die Herren, <unclear cert="medium" resp="#joint">mÿn</unclear> gantz <unclear cert="medium" resp="#joint">dinstlichs</unclear> <unclear cert="medium" resp="#joint">pitt</unclear>, <unclear cert="medium" resp="#joint">dises</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">gschäffts</unclear> halben, <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">ettwaß</unclear>, unnd biß dahin,
<lb n="18"/>das Ich, <unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">einß</unclear>, oder das ander, <unclear cert="medium" resp="#joint">gedachter</unclear> <unclear cert="medium" resp="#joint">abg</unclear>-
<lb n="19"/><unclear cert="medium" resp="#joint">storbnen</unclear> verlaßenschafft, unnd andere <unclear cert="low" resp="#joint">gstalt</unclear>, <unclear cert="low" resp="#joint">beschaffen</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">sÿe</unclear>, <unclear cert="low" resp="#joint">bricht</unclear> <unclear cert="low" resp="#joint">Innemen</unclear> möge, <unclear cert="low" resp="#joint">geduldt</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">tragen</unclear>. So
<lb n="21"/><unclear cert="low" resp="#joint">soll</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Herenn</unclear> <unclear cert="low" resp="#joint">alererst</unclear>, <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">allein</unclear> <unclear cert="low" resp="#joint">gschrifftlichen</unclear>
