    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1908_7105.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edel</unclear>, <unclear cert="low" resp="#joint">gestreng</unclear>, <unclear cert="low" resp="#joint">from</unclear>, <unclear cert="low" resp="#joint">ehrenvest</unclear>, fürsichtig
<lb n="2"/><unclear cert="low" resp="#joint">wyß</unclear>, <unclear cert="low" resp="#joint">inbesonders</unclear> <unclear cert="low" resp="#joint">günstige</unclear> <unclear cert="low" resp="#joint">herren</unclear>, <unclear cert="low" resp="#joint">denn</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">selbigen</unclear> sye, min fründtlich begrüessen, mit erer-
<lb n="4"/>bietung willigen diensten zuvor an bereit,
<lb n="5"/>Demnach zuo <unclear cert="low" resp="#joint">eineß</unclear> <unclear cert="low" resp="#joint">jeden</unclear> <unclear cert="low" resp="#joint">landtvogts</unclear> <unclear cert="low" resp="#joint">antrit</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">grosser</unclear> costen uffloufft, unnd dz innemmen, sich biß
<lb n="7"/>in herbst verzücht, also dz ich <unclear cert="low" resp="#joint">eineß</unclear> <unclear cert="low" resp="#joint">fürsatzeß</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">bedörfftig</unclear>. unnd <unclear cert="low" resp="#joint">thuon</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Str</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">nachpar</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">lich</unclear> fründtlich hiemit ersuochen, und bitten mir 200 f.
<lb n="10"/>fürzelychen, uff ein <unclear cert="low" resp="#joint">jahr</unclear> <unclear cert="low" resp="#joint">zuobegünstigen</unclear>, <unclear cert="low" resp="#joint">vorhabens</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">daßelbig</unclear> sampt dem interesse zuo danckh wid-
<lb n="12"/>rumb erstatten, Mit dem fründtlichen anerbieten
<lb n="13"/>wo ich, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">min</unclear> <unclear cert="low" resp="#joint">lbt</unclear>. <unclear cert="low" resp="#joint">günstige</unclear> <unclear cert="low" resp="#joint">herren</unclear>, diß erzeigen, und
<lb n="14"/>zuvor erßnen und empfangne fründtsch. und guottäten
<lb n="15"/>die <unclear cert="low" resp="#joint">zytt</unclear> <unclear cert="low" resp="#joint">miner</unclear> <unclear cert="low" resp="#joint">anbevolchnen</unclear> regierung nit allein,
<lb n="16"/>sondern in nachvolgender zytt kan verdienen unnd
<lb n="17"/><unclear cert="low" resp="#joint">beschulden</unclear>, <unclear cert="low" resp="#joint">solcheß</unclear>, für sy, und <unclear cert="low" resp="#joint">ire</unclear> <unclear cert="low" resp="#joint">burger</unclear>, <unclear cert="low" resp="#joint">bestes</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">flyß</unclear>, <unclear cert="low" resp="#joint">angedenckh</unclear> <unclear cert="low" resp="#joint">sin</unclear>, <unclear cert="low" resp="#joint">hiemit</unclear> unß <unclear cert="low" resp="#joint">sämptlich</unclear>, <unclear cert="low" resp="#joint">obgedachten</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">göttlicher</unclear> <unclear cert="low" resp="#joint">bewarnuß</unclear> wol bevolchen, dat. <origDate when="1612-07-20" resp="#ner">20 julij
<lb n="20"/>anno 1612</origDate>.
<lb n="21"/>Dz mittel diser fürlychung, werj. by altem H.
<lb n="22"/>landtvogt <persName resp="#ner">Yten von Zug</persName>, so diser <unclear cert="low" resp="#joint">glt</unclear> <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Str</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="23"/><unclear cert="low" resp="#joint">umb</unclear> sovil <unclear cert="low" resp="#joint">zuothuon</unclear>, <unclear cert="low" resp="#joint">daselbsten</unclear> <unclear cert="low" resp="#joint">innzenemmen</unclear>, <unclear cert="low" resp="#joint">und</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">orths</unclear> <unclear cert="low" resp="#joint">mir</unclear> wol gelegen, dafür ich mich
<lb n="25"/>einer obligation verschrybung <unclear cert="low" resp="#joint">anerbiete</unclear>, <unclear cert="low" resp="#joint">etc</unclear>.
<lb n="26"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Str</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="27"/><unclear cert="low" resp="#joint">dwillig</unclear>
<lb n="28"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Ulrich</unclear> <unclear cert="low" resp="#joint">Tschudi</unclear></persName>, deß raths zuo
<lb n="29"/><placeName ref="stadtasg-places-73" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Glariß</unclear></placeName>, <unclear cert="low" resp="#joint">angehnder</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">landtvogt</unclear> <unclear cert="low" resp="#joint">nider</unclear> und obren
<lb n="31"/><placeName ref="stadtasg-places-64" cert="medium" resp="#ner">Rhynthalß</placeName>,
<pb facs="StadtASG_Missive_1908_7106.jpg" n="2"/>
<lb n="32"/>[]
<pb facs="StadtASG_Missive_1908_7107.jpg" n="3"/>
<pb facs="StadtASG_Missive_1908_7108.jpg" n="4"/>
<lb n="33"/><unclear cert="medium" resp="#joint">Denen</unclear> edlen <unclear cert="medium" resp="#joint">vesten</unclear> frommen,
<lb n="34"/><unclear cert="medium" resp="#joint">fürnemen</unclear> fürsichtigen <unclear cert="low" resp="#joint">wyßen</unclear>,
<lb n="35"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Raht</unclear> der statt
<lb n="36"/><unclear cert="low" resp="#joint">Sanntgallen</unclear></orgName>, minen <unclear cert="low" resp="#joint">innsonders</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">guenstigenn</unclear> herren <unclear cert="low" resp="#joint">nachparen</unclear>.
</p>
