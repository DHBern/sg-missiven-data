<lb n="4"/>Unser freündt nachberlich willig <unclear cert="low" resp="#joint">dinst</unclear> zuvor,
<lb n="5"/>Ersame, Fromme, Erbare und Weyse, <unclear cert="low" resp="#joint">bsunders</unclear>
<lb n="6"/>liebe und gute Nachbarn.
<lb n="7"/><unclear cert="low" resp="#joint">Was</unclear> wir <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">vor</unclear> schon <unclear cert="low" resp="#joint">allbereit</unclear> <unclear cert="low" resp="#joint">verfloßner</unclear> <unclear cert="low" resp="#joint">zyt</unclear>
