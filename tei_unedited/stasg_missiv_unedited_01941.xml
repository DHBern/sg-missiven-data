<pb facs="StadtASG_Missive_1941_7226.jpg" n="4"/>
<lb n="75"/><unclear cert="low" resp="#joint">Denen</unclear> edlen, frommen, <unclear cert="low" resp="#joint">ernvesten</unclear>, fürsichtigen,
<lb n="76"/>unnd <unclear cert="low" resp="#joint">wyßen</unclear>, herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister unnd <unclear cert="low" resp="#joint">Rhat</unclear>
