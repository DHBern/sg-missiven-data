<p>
<pb facs="StadtASG_Missive_1941_7223.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unnsere</unclear> <unclear cert="low" resp="#joint">früntlich</unclear>, nachparlich unnd <unclear cert="low" resp="#joint">guotwillig</unclear>
<lb n="2"/>diennst, mit erbiettung alles <unclear cert="low" resp="#joint">guotes</unclear> zuvor, edle,
<lb n="3"/>frome, <unclear cert="low" resp="#joint">ehrnveste</unclear>, fürsichtige weyse, günstige
<lb n="4"/>liebe herren unnd <unclear cert="low" resp="#joint">nachparen</unclear>. Es <unclear cert="medium" resp="#joint">hat</unclear> <unclear cert="medium" resp="#joint">dato</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">diß</unclear>, <persName resp="#ner"><unclear cert="medium" resp="#joint">Wernhoß</unclear> Suter</persName> <unclear cert="low" resp="#joint">der</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Keßler</unclear></persName> von <placeName ref="stadtasg-places-177" cert="medium" resp="#ner">Ligg-
<lb n="6"/>ennberg</placeName>, vor unnß <unclear cert="low" resp="#joint">erschinen</unclear>, unnd <unclear cert="medium" resp="#joint">Inne</unclear> <unclear cert="medium" resp="#joint">undere</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">tenigkait</unclear> <unclear cert="medium" resp="#joint">fürtregen</unclear> <unclear cert="medium" resp="#joint">lasen</unclear>, wie <unclear cert="medium" resp="#joint">daß</unclear> <unclear cert="medium" resp="#joint">er</unclear> bi
<lb n="8"/><unclear cert="low" resp="#joint">etlichen</unclear> <unclear cert="low" resp="#joint">vergangnen</unclear> <unclear cert="low" resp="#joint">wuchen</unclear>, von herren <persName resp="#ner">Jerg</persName>
<lb n="9"/>erhütlen <persName resp="#ner">Effinger</persName> dem <unclear cert="low" resp="#joint">Jüngern</unclear>, unnd dem <unclear cert="low" resp="#joint">Ehen</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">großweibel</unclear> alhie, etliche <unclear cert="low" resp="#joint">talern</unclear>, (weliche
<lb n="11"/><unclear cert="low" resp="#joint">zür</unclear> selbigen zyt alß neüwe ußgang unnd
<lb n="12"/>genem <unclear cert="low" resp="#joint">gewesen</unclear>) <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">hebt</unclear> unnd <unclear cert="low" resp="#joint">empfanngen</unclear> habe,
<lb n="13"/>Alß aber er <unclear cert="low" resp="#joint">Keßler</unclear> <unclear cert="low" resp="#joint">unlanngst</unclear> <unclear cert="low" resp="#joint">verschinen</unclear>,
<lb n="14"/>mit sollichen <unclear cert="low" resp="#joint">tallern</unclear>, <unclear cert="low" resp="#joint">anndern</unclear> sinen <unclear cert="medium" resp="#joint">geschefften</unclear>
<lb n="15"/>halben, Inn <unclear cert="medium" resp="#joint">ewer</unclear> statt komen, unnd die selbig
<lb n="16"/>allain <unclear cert="low" resp="#joint">besichtigen</unclear>, unnd nit ußgeben wellen,
<lb n="17"/>weren Ime die Jenigen <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">verhoffen</unclear>,
<lb n="18"/>hinderhalten, unnd <unclear cert="low" resp="#joint">deß</unclear> nit widerumb zuge-
<lb n="19"/><unclear cert="low" resp="#joint">stelt</unclear> worden, <unclear cert="medium" resp="#joint">dannen</unclear> <unclear cert="medium" resp="#joint">uß</unclear> gedachter <unclear cert="low" resp="#joint">Keßler</unclear>
<lb n="20"/>verursacht, unnd habe sich des ortts vor diß
<lb n="21"/>alß unseren Eherenden herren unnd getrüwen
<lb n="22"/>lieben <unclear cert="low" resp="#joint">nachparen</unclear> erclagt, wölliches Ime
<lb n="23"/>kein anndern beschaid, one die tallen ervolgt,
<lb n="24"/>Im fall er Keßler, die Jenige, weliche Ime
<lb n="25"/>die <unclear cert="low" resp="#joint">talern</unclear> <unclear cert="low" resp="#joint">beanntwurt</unclear>, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">derselbigen</unclear> <unclear cert="low" resp="#joint">stell</unclear>
<lb n="26"/>unnd Namhafft mache, sölle <unclear cert="low" resp="#joint">Ime</unclear> mit <unclear cert="low" resp="#joint">fründtlich</unclear>
<pb facs="StadtASG_Missive_1941_7224.jpg" n="2"/>
<lb n="27"/><unclear cert="medium" resp="#joint">schand</unclear> begegnet <unclear cert="medium" resp="#joint">were</unclear>, derhalben <unclear cert="medium" resp="#joint">bate</unclear> er unns
<lb n="28"/>ganntz <unclear cert="medium" resp="#joint">unnderthenig</unclear>, unnd <unclear cert="low" resp="#joint">vlehenlich</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">wellen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">mid</unclear> <unclear cert="low" resp="#joint">oberkaitlichem</unclear> <unclear cert="low" resp="#joint">gwalt</unclear>, <unclear cert="low" resp="#joint">obennante</unclear> <unclear cert="low" resp="#joint">unn</unclear>-
<lb n="30"/><unclear cert="low" resp="#joint">ser</unclear> <unclear cert="low" resp="#joint">baide</unclear> <unclear cert="low" resp="#joint">burger</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">vermögen</unclear> unnd <unclear cert="low" resp="#joint">durch</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">mittel</unclear> umb <unclear cert="low" resp="#joint">suil</unclear> <unclear cert="low" resp="#joint">gehorsam</unclear> <unclear cert="low" resp="#joint">machen</unclear>. Das sy, haab-
<lb n="32"/>unnd <unclear cert="low" resp="#joint">guet</unclear>, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">demselbigen</unclear> <unclear cert="low" resp="#joint">erschinen</unclear>, weliches
<lb n="33"/>aber wir, (dwyl es unnserm burgerlichen aid
<lb n="34"/>zewider) nit <unclear cert="low" resp="#joint">konnden</unclear> <unclear cert="low" resp="#joint">gstatten</unclear>, jedoch an
<lb n="35"/>dem hat an unns nit solln erwinden dann
<lb n="36"/>das wir sy für <unclear cert="medium" resp="#joint">unnß</unclear> <unclear cert="medium" resp="#joint">stanndthun</unclear>, unnd <unclear cert="low" resp="#joint">inen</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">oberzelter</unclear> <unclear cert="low" resp="#joint">maßen</unclear> fürhalten laßen, habend
<lb n="38"/>sy <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">gehorsamlich</unclear> unnd <unclear cert="low" resp="#joint">unnderthenigklich</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">bekennt</unclear>. Es <unclear cert="low" resp="#joint">sige</unclear> nit ohn. Sy habend <unclear cert="low" resp="#joint">berüerte</unclear>
<lb n="40"/><persName resp="#ner"><unclear cert="low" resp="#joint">Kosler</unclear></persName> <unclear cert="low" resp="#joint">etliche</unclear> <unclear cert="low" resp="#joint">taller</unclear> <unclear cert="low" resp="#joint">ingerumpt</unclear>, jedoch
<lb n="41"/><unclear cert="low" resp="#joint">anndergstalt</unclear> nit, wann er solliche nit <unclear cert="low" resp="#joint">konnde</unclear> umb
<lb n="42"/><unclear cert="low" resp="#joint">gold</unclear> <unclear cert="low" resp="#joint">usbringen</unclear>. Das er <unclear cert="medium" resp="#joint">Kosler</unclear> <unclear cert="medium" resp="#joint">inen</unclear> dieselbigen
<lb n="43"/><unclear cert="low" resp="#joint">widerumb</unclear> beandtwurten unnd <unclear cert="low" resp="#joint">zustellen</unclear> <unclear cert="low" resp="#joint">solle</unclear>,
<lb n="44"/><unclear cert="low" resp="#joint">wellennd</unclear> sy <unclear cert="low" resp="#joint">unnbeschwerdt</unclear> ime <unclear cert="low" resp="#joint">anndere</unclear> <unclear cert="low" resp="#joint">müntz</unclear>
<lb n="45"/>unnd <unclear cert="low" resp="#joint">sonders</unclear> an <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">tallern</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">befundigen</unclear>,
<lb n="46"/><unclear cert="low" resp="#joint">hievor</unclear> ouch mehe dan dismals da dannenbeko-
<lb n="47"/>men, dann wann sy solliche widerumb
<lb n="48"/>zur hannd bringen. Wellennd sy die <unclear cert="medium" resp="#joint">jenigen</unclear>
<lb n="49"/>als bald <unclear cert="medium" resp="#joint">unnserm</unclear> <unclear cert="medium" resp="#joint">gwardteherr</unclear>, der <unclear cert="medium" resp="#joint">sye</unclear>
<lb n="50"/><unclear cert="medium" resp="#joint">alberait</unclear>, <unclear cert="medium" resp="#joint">deßenndtwegen</unclear>, vor unns <unclear cert="medium" resp="#joint">gricht</unclear>-
<lb n="51"/>lichen <unclear cert="low" resp="#joint">fürgeliten</unclear>, <unclear cert="low" resp="#joint">beandtwurten</unclear> unnd
<lb n="52"/><unclear cert="low" resp="#joint">zustellen</unclear>, mit <unclear cert="medium" resp="#joint">mererm</unclear> <unclear cert="medium" resp="#joint">vermelden</unclear>, <unclear cert="medium" resp="#joint">wenhohr</unclear>
<pb facs="StadtASG_Missive_1941_7225.jpg" n="3"/>
<lb n="53"/>das <unclear cert="medium" resp="#joint">etliche</unclear> <unclear cert="medium" resp="#joint">uewere</unclear> burger, <unclear cert="medium" resp="#joint">neulich</unclear> <unclear cert="medium" resp="#joint">am</unclear> marckt
<lb n="54"/><unclear cert="medium" resp="#joint">alhie</unclear> <unclear cert="medium" resp="#joint">dieben</unclear>, <unclear cert="medium" resp="#joint">fuer</unclear> selbiges <unclear cert="low" resp="#joint">huett</unclear>, als sy die <unclear cert="low" resp="#joint">heim</unclear>
