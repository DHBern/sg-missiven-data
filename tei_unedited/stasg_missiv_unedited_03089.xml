<lb n="10"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">fuergefalnen</unclear> <unclear cert="low" resp="#joint">wichtigen</unclear> <unclear cert="low" resp="#joint">geschefften</unclear> und andern
