<lb n="8"/>daß den <date resp="#ner"><unclear cert="low" resp="#joint">31isten</unclear> tag Octobris</date>, <unclear cert="low" resp="#joint">nechst</unclear> <unclear cert="low" resp="#joint">fürgebrachts</unclear>
