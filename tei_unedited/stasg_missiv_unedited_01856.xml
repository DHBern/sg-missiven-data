<lb n="8"/>er, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">abstärben</unclear>, <unclear cert="low" resp="#joint">wylund</unclear> <unclear cert="low" resp="#joint">hern</unclear> <unclear cert="low" resp="#joint">fändrich</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Josuwen</unclear> <unclear cert="low" resp="#joint">Vogelß</unclear></persName>.
