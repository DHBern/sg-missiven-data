    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2195_8263.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unsern</unclear> <unclear cert="low" resp="#joint">freundt</unclear>- nachbarlich
<lb n="2"/>willig dienst, zuvor, fürsichtig
<lb n="3"/><unclear cert="medium" resp="#joint">ersamen</unclear> und weisen, besonders
<lb n="4"/><unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">guten</unclear> <unclear cert="low" resp="#joint">freundt</unclear> und nachbarn.
<lb n="5"/>Wir <unclear cert="low" resp="#joint">zweifflen</unclear> nit, es werde <unclear cert="low" resp="#joint">denenselb</unclear>
<lb n="6"/>die gantz <unclear cert="low" resp="#joint">unversehens</unclear> <unclear cert="low" resp="#joint">eingerißne</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">gelltsteiegerung</unclear>, so wohl an
<lb n="8"/><unclear cert="low" resp="#joint">goldt</unclear> als <unclear cert="low" resp="#joint">silber</unclear> <unclear cert="low" resp="#joint">sorth</unclear>, nit verborgen
<lb n="9"/><unclear cert="medium" resp="#joint">sein</unclear>.
<lb n="10"/>Wann dann <unclear cert="medium" resp="#joint">hirdurch</unclear> <unclear cert="medium" resp="#joint">ins</unclear> <unclear cert="medium" resp="#joint">kunfftig</unclear>
<lb n="11"/>anders nichts, dann gantz <unclear cert="low" resp="#joint">beschwer</unclear>-
<lb n="12"/>liche <unclear cert="medium" resp="#joint">gefahr</unclear>, und <unclear cert="low" resp="#joint">unwiderbring</unclear>-
<lb n="13"/>liche <unclear cert="low" resp="#joint">schaden</unclear> <unclear cert="low" resp="#joint">zuerwartten</unclear>, <unclear cert="low" resp="#joint">deme</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">wür</unclear> <unclear cert="low" resp="#joint">unsers</unclear> theils <unclear cert="low" resp="#joint">allhir</unclear> in <unclear cert="medium" resp="#joint">unser</unclear>
<lb n="15"/>statt, und in der nachbar-
<lb n="16"/>schafft, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">ebmoglich</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Dieweil</unclear> aber im reich, <unclear cert="low" resp="#joint">deßweg</unclear>
<lb n="18"/>so gar kein <unclear cert="medium" resp="#joint">fürsehung</unclear> geschicht, <unclear cert="medium" resp="#joint">so</unclear>
<lb n="19"/>dann theils in den <unclear cert="medium" resp="#joint">furnembsten</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">reichsstätten</unclear> <unclear cert="medium" resp="#joint">jetz</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">allerhandt</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">auffschläg</unclear> <unclear cert="medium" resp="#joint">ervolgen</unclear>, wie
<lb n="22"/><unclear cert="low" resp="#joint">auß</unclear> d <unclear cert="low" resp="#joint">beylag</unclear> litera A. <unclear cert="medium" resp="#joint">zuerseh</unclear>-
<lb n="23"/><unclear cert="medium" resp="#joint">Als</unclear> <unclear cert="medium" resp="#joint">sindt</unclear> wir <unclear cert="medium" resp="#joint">gleichsamb</unclear> wider
<lb n="24"/>unsern willen <unclear cert="low" resp="#joint">genoetiget</unclear> <unclear cert="low" resp="#joint">word</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">auch</unclear>,
<lb n="26"/>der <unclear cert="low" resp="#joint">ungelegenheit</unclear> <unclear cert="low" resp="#joint">jetzig</unclear> zeit
<lb n="27"/>zu <unclear cert="medium" resp="#joint">accomodiren</unclear>. Und
<pb facs="StadtASG_Missive_2195_8264.jpg" n="2"/>
<lb n="28"/>die <unclear cert="low" resp="#joint">Guld</unclear>- und <unclear cert="low" resp="#joint">Silber</unclear> <unclear cert="low" resp="#joint">Sortten</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">z</unclear>' <unclear cert="low" resp="#joint">taxieren</unclear>, wie es <unclear cert="medium" resp="#joint">dgeschafft</unclear>
<lb n="30"/><unclear cert="medium" resp="#joint">litera</unclear> <unclear cert="medium" resp="#joint">B</unclear>. <unclear cert="medium" resp="#joint">z'erkennen</unclear> <unclear cert="medium" resp="#joint">gibt</unclear>.
<lb n="31"/><unclear cert="medium" resp="#joint">Todoch</unclear> haben wir <unclear cert="low" resp="#joint">solchs</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">zur</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">zeit</unclear> nicht <unclear cert="low" resp="#joint">offentlich</unclear> <unclear cert="low" resp="#joint">publiciern</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">lase</unclear> <unclear cert="low" resp="#joint">lasen</unclear>, <unclear cert="low" resp="#joint">deßwegen</unclear> biß
<lb n="34"/><unclear cert="low" resp="#joint">mengklich</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Müntz</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">rigerschen</unclear> <unclear cert="low" resp="#joint">Preiß</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">weitre</unclear> <unclear cert="low" resp="#joint">Verordnungen</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">gelten</unclear> <unclear cert="low" resp="#joint">zenemmen</unclear> <unclear cert="low" resp="#joint">mag</unclear>.
<lb n="37"/><unclear cert="low" resp="#joint">Welches</unclear> E. E. <unclear cert="medium" resp="#joint">Wht</unclear>. <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">fründ</unclear>-
<lb n="38"/><unclear cert="medium" resp="#joint">nachbarlicher</unclear> <unclear cert="medium" resp="#joint">wollmainung</unclear>,
<lb n="39"/>und <unclear cert="medium" resp="#joint">darmit</unclear> <unclear cert="medium" resp="#joint">Herrn</unclear> <unclear cert="medium" resp="#joint">Bisch</unclear>. <unclear cert="medium" resp="#joint">v</unclear>. <placeName ref="stadtasg-places-7" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Costantz</unclear></placeName>
<lb n="40"/><unclear cert="medium" resp="#joint">underamtleüthen</unclear>, so <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Morsche</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">z</unclear>' <placeName resp="#ner"><unclear cert="low" resp="#joint">Morschen</unclear></placeName>- <unclear cert="low" resp="#joint">v</unclear>. <placeName ref="stadtasg-places-68" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Stainahethel</unclear></placeName> <unclear cert="low" resp="#joint">bacher</unclear> <unclear cert="low" resp="#joint">bsetzet</unclear>, <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">ange</unclear>-
<lb n="42"/><unclear cert="low" resp="#joint">bsitzer</unclear> <unclear cert="low" resp="#joint">schirt</unclear> <unclear cert="low" resp="#joint">werden</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">daß</unclear> sie die
<lb n="43"/><unclear cert="low" resp="#joint">Müntz</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">höhern</unclear> <unclear cert="low" resp="#joint">werth</unclear>, <unclear cert="low" resp="#joint">dan</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">hero</unclear> <unclear cert="low" resp="#joint">bschehen</unclear>,
<lb n="45"/>für sie selbs also <unclear cert="low" resp="#joint">ußgeben</unclear>, und alß in E. E. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="46"/><unclear cert="low" resp="#joint">Statt</unclear> nach <unclear cert="low" resp="#joint">Meüwrungweis</unclear>,
<lb n="47"/><unclear cert="low" resp="#joint">z</unclear>' <unclear cert="low" resp="#joint">fihren</unclear> <unclear cert="low" resp="#joint">bgern</unclear> <unclear cert="low" resp="#joint">wölten</unclear>, <unclear cert="low" resp="#joint">ohnwisen</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">hafft</unclear> <unclear cert="low" resp="#joint">z</unclear>' <unclear cert="low" resp="#joint">machen</unclear> nicht umbgehen,
<lb n="49"/>und <unclear cert="low" resp="#joint">zughorig</unclear> <unclear cert="low" resp="#joint">bitten</unclear> <unclear cert="low" resp="#joint">wöllen</unclear>, "<unclear cert="low" resp="#joint">hierdurch</unclear>"
<lb n="50"/>"Ihr"
<lb n="51"/><unclear cert="low" resp="#joint">bedacht</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Schirmnuß</unclear> <unclear cert="low" resp="#joint">sovil</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">d</unclear> <unclear cert="low" resp="#joint">Gold</unclear> <unclear cert="low" resp="#joint">v</unclear>. <unclear cert="low" resp="#joint">Silber</unclear> <unclear cert="low" resp="#joint">sortten</unclear>,
<lb n="53"/><unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">Jhnen</unclear> <unclear cert="low" resp="#joint">bißhero</unclear> gangbar gewest,
<lb n="54"/><unclear cert="low" resp="#joint">syn</unclear> <unclear cert="low" resp="#joint">v</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">sijen</unclear> "<unclear cert="low" resp="#joint">unbschwert</unclear> nachbarlich
<pb facs="StadtASG_Missive_2195_8265.jpg" n="3"/>
<lb n="55"/><unclear cert="medium" resp="#joint">gebrucht</unclear>. Als <unclear cert="low" resp="#joint">dringkhwirt</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">lutt</unclear> <unclear cert="low" resp="#joint">zuoerschlahen</unclear>.
<lb n="57"/><unclear cert="low" resp="#joint">Hiezwüschen</unclear> <unclear cert="low" resp="#joint">uech</unclear> e. <unclear cert="medium" resp="#joint">f</unclear>. e. <unclear cert="low" resp="#joint">wht</unclear>
