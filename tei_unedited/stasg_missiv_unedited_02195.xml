<lb n="59"/><unclear cert="low" resp="#joint">nachberliche</unclear> <unclear cert="low" resp="#joint">Dienste</unclear>, und
<lb n="60"/>alles <unclear cert="medium" resp="#joint">deßjehnige</unclear>, waß <unclear cert="medium" resp="#joint">zuo</unclear>
<lb n="61"/>continuirung <unclear cert="low" resp="#joint">gütter</unclear> <unclear cert="low" resp="#joint">nachber</unclear>,
<lb n="62"/>schafft <unclear cert="low" resp="#joint">erersprieße</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">erzeigen</unclear>
<lb n="63"/>willig und <unclear cert="low" resp="#joint">anerbötig</unclear>, mit
<lb n="64"/>hilff deß <unclear cert="medium" resp="#joint">Allerhöchsten</unclear>, <unclear cert="medium" resp="#joint">er</unclear>
<lb n="65"/><unclear cert="medium" resp="#joint">welle</unclear> uns <unclear cert="medium" resp="#joint">samptlich</unclear> in seinem
<lb n="66"/>gnadenschirm <unclear cert="medium" resp="#joint">trüwelich</unclear> <unclear cert="medium" resp="#joint">erhalte</unclear>
<lb n="67"/><unclear cert="medium" resp="#joint">Aktum</unclear> den <origDate when="1620-02-21" resp="#ner"><unclear cert="medium" resp="#joint">21</unclear>. Februarij 1620</origDate>.
<lb n="68"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgr</unclear>. und <unclear cert="medium" resp="#joint">Rhatt</unclear>
<lb n="69"/>der Statt St. Gallen</orgName>.
<lb n="70"/>An die <unclear cert="low" resp="#joint">Rhaett</unclear>.
