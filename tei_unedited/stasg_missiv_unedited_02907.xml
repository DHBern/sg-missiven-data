<lb n="4"/>von <unclear cert="medium" resp="#joint">stetten</unclear>, und landen gemainer <unclear cert="low" resp="#joint">dreÿzehen</unclear> <unclear cert="low" resp="#joint">ortten</unclear> <unclear cert="low" resp="#joint">der</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eüdt</unclear>-
