<lb n="14"/>nicht <unclear cert="medium" resp="#joint">allain</unclear> die <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Bischoffs</unclear> <unclear cert="low" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-7" cert="medium" resp="#ner">Costantz</placeName> <unclear cert="low" resp="#joint">A</unclear>. <unclear cert="low" resp="#joint">zwischen</unclear> <unclear cert="low" resp="#joint">gedachten</unclear>
