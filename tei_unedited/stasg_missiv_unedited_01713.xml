<p>
<pb facs="StadtASG_Missive_1713_6281.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">früntlich</unclear> willig dienst sampt was wir <unclear cert="medium" resp="#joint">ehren</unclear>,
<lb n="2"/>liebs unnd guots vermögend, zuvor <unclear cert="low" resp="#joint">from</unclear>, fürsichtig,
<lb n="3"/>ersam, wyß, insonders <unclear cert="low" resp="#joint">guot</unclear> <unclear cert="low" resp="#joint">fründ</unclear>, und getrüw lieb
<lb n="4"/><orgName resp="#ner">Eydtgnossen</orgName>. Ir werdend uß <unclear cert="medium" resp="#joint">unnserem</unclear> <unclear cert="low" resp="#joint">vorgenden</unclear>
<lb n="5"/>schryben verstanden haben, das unns <unclear cert="low" resp="#joint">söllichs</unclear> <unclear cert="low" resp="#joint">gewüße</unclear>
<lb n="6"/>advis unnd berichts <unclear cert="medium" resp="#joint">zuokommen</unclear>, das wir nun mehr
<lb n="7"/>anderst nit gedencken sonders glouben <unclear cert="medium" resp="#joint">müessendt</unclear>, eß
<lb n="8"/>habe <unclear cert="medium" resp="#joint">f</unclear>. <unclear cert="medium" resp="#joint">drlht</unclear> der <persName resp="#ner">Hertzog zuo Savoy</persName> grosse <unclear cert="medium" resp="#joint">anschleg</unclear>
<lb n="9"/>unnd <unclear cert="low" resp="#joint">pratiken</unclear> <unclear cert="low" resp="#joint">uf</unclear> ein statt <placeName ref="stadtasg-places-169" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Genf</unclear></placeName>, unnd <unclear cert="medium" resp="#joint">unnser</unclear>
<lb n="10"/>landschaft, darumb wir dan üch <unclear cert="low" resp="#joint">fründt</unclear>: und eydt=
<lb n="11"/>=gnossisch <unclear cert="medium" resp="#joint">gepetten</unclear>, ir wöllind nit allein ein <unclear cert="medium" resp="#joint">getrüws</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">ufsächen</unclear> <unclear cert="medium" resp="#joint">uf</unclear> <unclear cert="medium" resp="#joint">unns</unclear> haben, <unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">grüst</unclear> halten,
<lb n="13"/><unclear cert="low" resp="#joint">uf</unclear> das im <unclear cert="low" resp="#joint">faal</unclear> der <unclear cert="low" resp="#joint">not</unclear> ir unns einen <unclear cert="low" resp="#joint">dapferen</unclear>
<lb n="14"/>bystand <unclear cert="low" resp="#joint">thuon</unclear>, unnd was die <unclear cert="low" resp="#joint">Pündt</unclear> <unclear cert="low" resp="#joint">wysend</unclear> leisten <unclear cert="medium" resp="#joint">könnind</unclear>,
<lb n="15"/>unnd <unclear cert="medium" resp="#joint">wiewoll</unclear> wir unns eines <unclear cert="low" resp="#joint">söllchen</unclear> <unclear cert="low" resp="#joint">zuo</unclear> üch gentzlich
<lb n="16"/>versächend unnd <unclear cert="medium" resp="#joint">getröstend</unclear>. <unclear cert="medium" resp="#joint">Nütdestoweniger</unclear>
<lb n="17"/>wyl <unclear cert="low" resp="#joint">sölliche</unclear> <unclear cert="low" resp="#joint">wichtige</unclear> advis unnd berichts nit allein
<lb n="18"/>continuierend, <unclear cert="low" resp="#joint">deß</unclear> Hertzogen macht sich von tag zuo tag
<lb n="19"/>mehret, sonders <unclear cert="medium" resp="#joint">ouch</unclear> unnseren <unclear cert="medium" resp="#joint">grentzen</unclear> <unclear cert="medium" resp="#joint">nächeret</unclear>, <unclear cert="medium" resp="#joint">allso</unclear>
<lb n="20"/>das wir <unclear cert="low" resp="#joint">allbereit</unclear> <unclear cert="low" resp="#joint">etliche</unclear> <unclear cert="low" resp="#joint">dusent</unclear> man <unclear cert="low" resp="#joint">zur</unclear> <unclear cert="low" resp="#joint">verwarung</unclear>
<lb n="21"/>der pässen unnd <unclear cert="low" resp="#joint">grentzen</unclear> <unclear cert="low" resp="#joint">ufgemant</unclear>, unnd <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">väld</unclear>
<lb n="22"/>liggen habend, unnd nun mehr anders nützit dan
<lb n="23"/>eines <unclear cert="low" resp="#joint">überfaals</unclear> unnd <unclear cert="low" resp="#joint">angrifs</unclear> <unclear cert="low" resp="#joint">erwertend</unclear> sind. So
<lb n="24"/>habend wir nit <unclear cert="low" resp="#joint">umbghen</unclear> können üch <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">zebrichten</unclear>,
<lb n="25"/>unnd darby <unclear cert="medium" resp="#joint">nochmalen</unclear> <unclear cert="medium" resp="#joint">zepitten</unclear>, ir wöllind üch
<lb n="26"/><unclear cert="medium" resp="#joint">allso</unclear>
<pb facs="StadtASG_Missive_1713_6282.jpg" n="2"/>
<lb n="27"/><unclear cert="medium" resp="#joint">taeß</unclear> <unclear cert="medium" resp="#joint">gerüst</unclear> unnd gefaßt <unclear cert="medium" resp="#joint">halte</unclear>, damit <unclear cert="low" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">fer=</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">ner</unclear> <unclear cert="low" resp="#joint">vermanen</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">sijn</unclear>, unnd uns, <unclear cert="medium" resp="#joint">unserem</unclear> <unclear cert="medium" resp="#joint">hochen</unclear> <unclear cert="medium" resp="#joint">zu</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">habenden</unclear> <unclear cert="medium" resp="#joint">vertrüwen</unclear> nach, <unclear cert="low" resp="#joint">üwre</unclear> hilff, <unclear cert="low" resp="#joint">vermög</unclear> der
<lb n="30"/><unclear cert="low" resp="#joint">pündten</unclear>, leisten <unclear cert="low" resp="#joint">künind</unclear> unnd <unclear cert="low" resp="#joint">mögind</unclear>. Uns hie=
<lb n="31"/><unclear cert="low" resp="#joint">niderümb</unclear> <unclear cert="low" resp="#joint">erpietende</unclear>, <unclear cert="low" resp="#joint">dahr</unclear> <unclear cert="low" resp="#joint">Ir</unclear> in <unclear cert="medium" resp="#joint">glijchen</unclear> <unclear cert="medium" resp="#joint">nott=</unclear>
<lb n="32"/>fahl <unclear cert="low" resp="#joint">kommen</unclear> <unclear cert="low" resp="#joint">söllten</unclear>, <unclear cert="low" resp="#joint">darvor</unclear> üch doch der allmechtige
<lb n="33"/>Gott <unclear cert="medium" resp="#joint">behüetten</unclear> <unclear cert="medium" resp="#joint">wölle</unclear>, das wir üch <unclear cert="low" resp="#joint">auch</unclear> nit <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="34"/>sonders, alls getrüwen <unclear cert="medium" resp="#joint">Eijdtgnoßen</unclear> gepürt unnd <unclear cert="medium" resp="#joint">zu=</unclear>
<lb n="35"/>stath, <unclear cert="medium" resp="#joint">vermög</unclear> der <unclear cert="medium" resp="#joint">pündten</unclear> <unclear cert="medium" resp="#joint">trüwen</unclear> <unclear cert="medium" resp="#joint">bijstand</unclear> leisten
<lb n="36"/><unclear cert="medium" resp="#joint">wöllind</unclear>. Gott <unclear cert="medium" resp="#joint">pittende</unclear>, <unclear cert="medium" resp="#joint">dz</unclear> <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">unnserer</unclear> <unclear cert="medium" resp="#joint">gemeinen</unclear>
<lb n="37"/><unclear cert="medium" resp="#joint">fijnden</unclear> <unclear cert="medium" resp="#joint">böse</unclear> anschleg unnd <unclear cert="medium" resp="#joint">pratiken</unclear> <unclear cert="medium" resp="#joint">vonn</unclear> unns ab=
<lb n="38"/><unclear cert="low" resp="#joint">wenden</unclear>, unnd mit gnaden <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">wallten</unclear> <unclear cert="low" resp="#joint">wölle</unclear>.
<lb n="39"/>Datum <origDate when="1611-02-23" resp="#ner">23. feb: 1611</origDate>
<lb n="40"/><orgName ref="stadtasg-actors-514" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Schuldheiß</unclear> und <unclear cert="medium" resp="#joint">rhatt</unclear>
<lb n="41"/>der statt Bern</orgName>.
<pb facs="StadtASG_Missive_1713_6283.jpg" n="3"/>
<pb facs="StadtASG_Missive_1713_6284.jpg" n="4"/>
<lb n="42"/>Denn frommen, fürsichtigen,
<lb n="43"/>ersammen, wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger=
<lb n="44"/>=meister unnd <unclear cert="medium" resp="#joint">Rhatt</unclear> der statt
