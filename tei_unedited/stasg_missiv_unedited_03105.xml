<lb n="8"/><unclear cert="low" resp="#joint">haußfrawen</unclear> <persName resp="#ner">Catharina <unclear cert="low" resp="#joint">Staingadmerin</unclear></persName> <unclear cert="low" resp="#joint">seeligen</unclear>, <unclear cert="low" resp="#joint">euwerer</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">geweßnen</unclear> <unclear cert="low" resp="#joint">angehoerigen</unclear>, im standt der <unclear cert="low" resp="#joint">ehe</unclear> <unclear cert="low" resp="#joint">ein</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">tochter</unclear>, <unclear cert="low" resp="#joint">namens</unclear> <persName resp="#ner">Anna Maria</persName> ehelich <unclear cert="low" resp="#joint">erzeuget</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">welche</unclear> tochter <unclear cert="low" resp="#joint">Ir</unclear> <unclear cert="low" resp="#joint">großmueter</unclear>,
<lb n="12"/><persName resp="#ner">Maria <unclear cert="low" resp="#joint">Staingadmerin</unclear></persName> <unclear cert="low" resp="#joint">s</unclear>., <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">Jrem</unclear> leben, so baldt
<lb n="13"/>deß <unclear cert="low" resp="#joint">kindts</unclear> <unclear cert="low" resp="#joint">muter</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">obgemelte</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">ehefraw</unclear> <unclear cert="low" resp="#joint">seel</unclear>., mit todt
<lb n="14"/>abgangen, uß erheblichen ursachen, <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">Iro</unclear> <unclear cert="low" resp="#joint">naher</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">wangen</unclear> <unclear cert="low" resp="#joint">genomen</unclear>, und wie wolen er ge-
<lb n="16"/>meltes kindt Iro der <unclear cert="low" resp="#joint">großmueter</unclear> <unclear cert="low" resp="#joint">dozumal</unclear>
<lb n="17"/>nit gern volgen laßen wollen, so habe sie
<lb n="18"/>Ime doch anzezaigt, so er es nit <unclear cert="low" resp="#joint">thue</unclear>, <unclear cert="low" resp="#joint">wolle</unclear>
