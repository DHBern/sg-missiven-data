    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2137_8007.jpg" n="1"/>
<lb n="1"/>Unser freündlich willig <unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">fürsichtig</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">ehrsambe</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">weiß</unclear>, <unclear cert="low" resp="#joint">bsonders</unclear> <unclear cert="low" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">guete</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">freünd</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachbarn</unclear>.
<lb n="4"/>Es langt uns eüsserlich ahn, wie das <unclear cert="low" resp="#joint">die</unclear> zue <placeName ref="stadtasg-places-41" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Hungarn</unclear></placeName>
<lb n="5"/><unclear cert="low" resp="#joint">und</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Böheimb</unclear></placeName> <unclear cert="low" resp="#joint">kön</unclear>: <unclear cert="low" resp="#joint">wierde</unclear>, <unclear cert="low" resp="#joint">erzhörzog</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Ferdinand</unclear></persName>
<lb n="6"/><unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-91" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Österreich</unclear></placeName> <unclear cert="low" resp="#joint">v</unclear>. <unclear cert="low" resp="#joint">vonn</unclear> dem inn und umb <placeName resp="#ner">Metz</placeName>
<lb n="7"/>gelegnen Französischen kriegsvolckh, ettlich
<lb n="8"/>1000 mann inn bstallung genommen, und die-
<lb n="9"/>selbige, durch die <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eidgnoschafft</orgName> und Landtvogtej
<lb n="10"/><placeName ref="stadtasg-places-108" cert="medium" resp="#ner">Schwaaben</placeName>, inn das <placeName resp="#ner"><unclear cert="low" resp="#joint">Böhemerland</unclear></placeName> <unclear cert="low" resp="#joint">zuefuehren</unclear> <unclear cert="low" resp="#joint">vor</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">habens</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">soll</unclear>.
<lb n="12"/>Wann wir dann den grund <unclear cert="low" resp="#joint">dises</unclear> <unclear cert="low" resp="#joint">fürgebens</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">zueerkündigen</unclear> <unclear cert="low" resp="#joint">begierig</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">kheinen</unclear> <unclear cert="low" resp="#joint">zweifel</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">tragen</unclear>, dann das E: St: hierinnber (ob es etwas
<lb n="15"/>oder nichts) albereit guete wüssenschafft tragen,
<lb n="16"/>oder doch <unclear cert="low" resp="#joint">selbiges</unclear> <unclear cert="low" resp="#joint">nochmals</unclear> <unclear cert="low" resp="#joint">zueerfahren</unclear>, <unclear cert="low" resp="#joint">bequeme</unclear>
<lb n="17"/>gelegenheit haben werden: <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="18"/><unclear cert="low" resp="#joint">langt</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">diselbe</unclear> hiemit unser ganz freündt:
<lb n="19"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">hochfleißiges</unclear> <unclear cert="low" resp="#joint">ersuechen</unclear>, sie wöllen unserem
<lb n="20"/>habenden vertrowen und bißher gehaltnen nach-
<lb n="21"/>barlichen correspondenz nach, <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">ehist</unclear> <unclear cert="low" resp="#joint">müglich</unclear>
<lb n="22"/>berichten, was E: St: dißfals wüssend sein, oder
<lb n="23"/>hernach kundtbar werden möchte.
<lb n="24"/>Das begehrn wir inn dergleichen und andrem
<lb n="25"/>mehrerm freündt: nachbarlich zuebeschulden, uns
<lb n="26"/>damit <unclear cert="low" resp="#joint">Göttlichem</unclear> <unclear cert="low" resp="#joint">schutz</unclear> <unclear cert="low" resp="#joint">wolbefehlend</unclear>. Datum
<lb n="27"/>den <origDate when="1619-07-16" resp="#ner">16. Julii a° 1619</origDate>
<lb n="28"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermeister und rhat
<lb n="29"/>der statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_2137_8008.jpg" n="2"/>
<pb facs="StadtASG_Missive_2137_8009.jpg" n="3"/>
<pb facs="StadtASG_Missive_2137_8010.jpg" n="4"/>
<lb n="30"/>Den <unclear cert="medium" resp="#joint">fuersichtigen</unclear> <unclear cert="medium" resp="#joint">ehrsamen</unclear> und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="31"/><unclear cert="medium" resp="#joint">meister</unclear> und <unclear cert="medium" resp="#joint">Rhat</unclear> der statt Sanct Gallen</orgName>,
<lb n="32"/>unsern besondern lieben gueten <unclear cert="medium" resp="#joint">freuenden</unclear> und
<lb n="33"/><unclear cert="medium" resp="#joint">nachbarn</unclear>.
</p>
