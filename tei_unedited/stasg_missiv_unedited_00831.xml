    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_831_2273.jpg" n="1"/>
<lb n="1"/>Unnser früntlich willig diennst. Unnd <unclear cert="medium" resp="#joint">waß</unclear> wir
<lb n="2"/><unclear cert="medium" resp="#joint">ehren</unclear> liebs. unnd <unclear cert="medium" resp="#joint">guotz</unclear> vermoegen, <unclear cert="low" resp="#joint">Zuvoran</unclear> Ersamen
<lb n="3"/>wysen. <unclear cert="medium" resp="#joint">Innßennders</unclear> guot fründt. unnd gethrüwen lieben
<lb n="4"/><unclear cert="low" resp="#joint">eüdtgnoßen</unclear>. Ewer schriben, die <unclear cert="medium" resp="#joint">zöll</unclear> <unclear cert="medium" resp="#joint">statt</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Altorff</unclear></placeName>.
<lb n="5"/>unnd <placeName ref="stadtasg-places-81" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Gebhartzhoffen</unclear></placeName>. <unclear cert="low" resp="#joint">belaungende</unclear> haben wir
<lb n="6"/><unclear cert="low" resp="#joint">ennthpfanngen</unclear>. unnd <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Innhaltz</unclear> verstannden,
<lb n="7"/><unclear cert="low" resp="#joint">fuegennd</unclear> wir üch <unclear cert="low" resp="#joint">hürüber</unclear> <unclear cert="low" resp="#joint">zewüssen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> die zoller.
<lb n="8"/>unnd <unclear cert="low" resp="#joint">gegenschriber</unclear> zuo gebhartzhoffen, unnsern <unclear cert="medium" resp="#joint">burgern</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">glichß</unclear> <unclear cert="medium" resp="#joint">falß</unclear> umb die <unclear cert="medium" resp="#joint">bezallung</unclear> der zollen <unclear cert="medium" resp="#joint">zuogeschriben</unclear>,
<lb n="10"/><unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">aber</unclear> wir uß <unclear cert="low" resp="#joint">unnderthennigen</unclear> <unclear cert="low" resp="#joint">pitt</unclear> <unclear cert="low" resp="#joint">unnsern</unclear>
<lb n="11"/>burgern. dennselbigen <unclear cert="low" resp="#joint">widerum</unclear> <unclear cert="low" resp="#joint">zuogeschriben</unclear>.
<lb n="12"/><unclear cert="low" resp="#joint">werdenn</unclear> Ir uß <unclear cert="low" resp="#joint">hiebyligennder</unclear> <unclear cert="low" resp="#joint">copy</unclear> vernemen.
<lb n="13"/>Habennd ouch <unclear cert="low" resp="#joint">süthar</unclear> kain klag von den unnseren
<lb n="14"/><unclear cert="medium" resp="#joint">vernomen</unclear> <unclear cert="low" resp="#joint">guotter</unclear> hoffnung die zoller werden
<lb n="15"/>den hanndel. <unclear cert="medium" resp="#joint">biß</unclear> uff ainen <unclear cert="medium" resp="#joint">gmainen</unclear> <unclear cert="low" resp="#joint">aüdtgnossischen</unclear>
<lb n="16"/>tag beruewen <unclear cert="medium" resp="#joint">lasßen</unclear> etc. Zum <unclear cert="low" resp="#joint">annderen</unclear>
<lb n="17"/>gethrüwen lieben <unclear cert="low" resp="#joint">aüdtgnosßen</unclear>, <unclear cert="low" resp="#joint">waß</unclear> Ewer. unnd
<lb n="18"/>unnser <unclear cert="low" resp="#joint">gethrüwe</unclear> lieb <unclear cert="low" resp="#joint">eüdtgnosßen</unclear>. von <placeName ref="stadtasg-places-133" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Basßel</unclear></placeName>
<lb n="19"/>unnß für <unclear cert="low" resp="#joint">nüwe</unclear> <unclear cert="low" resp="#joint">züttungen</unclear> <unclear cert="low" resp="#joint">zuogeschriben</unclear>, haben
<lb n="20"/>Ir uß diser <unclear cert="low" resp="#joint">hiebyligennder</unclear> <unclear cert="low" resp="#joint">copyen</unclear> <unclear cert="low" resp="#joint">zevernemen</unclear>
<lb n="21"/>Mit <unclear cert="medium" resp="#joint">früntlicher</unclear> <unclear cert="medium" resp="#joint">pitt</unclear> Ir wellen Jeder <unclear cert="low" resp="#joint">züt</unclear>. (<unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="22"/>nit <unclear cert="medium" resp="#joint">zwüfflet</unclear>.) ain <unclear cert="medium" resp="#joint">gethrüwlichß</unclear> uffsehen haben,
<lb n="23"/>unnd <unclear cert="medium" resp="#joint">waß</unclear> Ir erkundigen <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">Jeder</unclear> <unclear cert="low" resp="#joint">züt</unclear> <unclear cert="low" resp="#joint">berichten</unclear>
<lb n="24"/>begeren wir umb üch <unclear cert="medium" resp="#joint">zeuerdiennen</unclear>. Dattum
<lb n="25"/>den <origDate when="1562" cert="medium" resp="#ner">xij <unclear cert="low" resp="#joint">Januarij</unclear> anno <unclear cert="low" resp="#joint">lxij</unclear></origDate>
<lb n="26"/><orgName ref="stadtasg-actors-28" cert="medium" role="issuer" resp="#ner">Burgermaister. unnd Rath
<lb n="27"/>der statt schaffhusenn</orgName>.,
<pb facs="StadtASG_Missive_831_2274.jpg" n="2"/>
<pb facs="StadtASG_Missive_831_2275.jpg" n="3"/>
<pb facs="StadtASG_Missive_831_2276.jpg" n="4"/>
<lb n="28"/>Den ersamen wysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister unnd Rath
<lb n="29"/>der statt Sannt Gallen</orgName>, unnseren innsonders
<lb n="30"/><unclear cert="low" resp="#joint">guetten</unclear> fründen unnd <unclear cert="low" resp="#joint">getrüwen</unclear> lieben <unclear cert="medium" resp="#joint">aidtgnossen</unclear>.
</p>
