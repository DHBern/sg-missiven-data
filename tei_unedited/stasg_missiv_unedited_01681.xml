<lb n="3"/>insonders <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">frunden</unclear>, <unclear cert="low" resp="#joint">gethreuwen</unclear> lieben Eyd und <unclear cert="low" resp="#joint">pundtgnossen</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Wyr</unclear> <unclear cert="medium" resp="#joint">habendt</unclear> <unclear cert="low" resp="#joint">euwer</unclear> an unß <unclear cert="low" resp="#joint">gethonen</unclear> schryben <unclear cert="low" resp="#joint">empfangen</unclear>, <unclear cert="low" resp="#joint">uß</unclear> dem-
