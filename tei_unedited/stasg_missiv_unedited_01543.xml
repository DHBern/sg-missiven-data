<p>
<pb facs="StadtASG_Missive_1543_5583.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Edl</unclear>, <unclear cert="medium" resp="#joint">Ehrnvest</unclear>, <unclear cert="medium" resp="#joint">ersamb</unclear>, <unclear cert="medium" resp="#joint">fürsihtig</unclear> unnd weise. Sonnders
<lb n="2"/>günstige <unclear cert="medium" resp="#joint">herrn</unclear> unnd <unclear cert="medium" resp="#joint">frünndt</unclear>. <unclear cert="medium" resp="#joint">Denenn</unclear> sint <unclear cert="medium" resp="#joint">unnsere</unclear> <unclear cert="medium" resp="#joint">guet</unclear>-
<lb n="3"/>willige diennst. <unclear cert="low" resp="#joint">Neben</unclear> <unclear cert="low" resp="#joint">wündshung</unclear> aller <unclear cert="medium" resp="#joint">glükhseelligen</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">wolfart</unclear> <unclear cert="medium" resp="#joint">jederzeit</unclear> berait, unnd <unclear cert="medium" resp="#joint">khünnen</unclear> denselben
<lb n="5"/><unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">nit</unclear> verhalten, das, als wir an <unclear cert="medium" resp="#joint">heut</unclear> in ver-
<lb n="6"/><unclear cert="medium" resp="#joint">sambleten</unclear> rath <unclear cert="medium" resp="#joint">gesessen</unclear>, für <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">ershinen</unclear> <unclear cert="low" resp="#joint">ist</unclear>,
<lb n="7"/><unclear cert="low" resp="#joint">zaiger</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">brieffs</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Daniel</unclear> <unclear cert="low" resp="#joint">Rausher</unclear></persName> <unclear cert="low" resp="#joint">euer</unclear> <unclear cert="low" resp="#joint">mit</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">burger</unclear>, unnd gab <unclear cert="medium" resp="#joint">unns</unclear> <unclear cert="medium" resp="#joint">diennstlih</unclear> <unclear cert="medium" resp="#joint">zuvernemben</unclear>,
<lb n="9"/>wie das er <unclear cert="medium" resp="#joint">sih</unclear>, aus <unclear cert="medium" resp="#joint">erheblihen</unclear> <unclear cert="medium" resp="#joint">ursahen</unclear>, <unclear cert="medium" resp="#joint">dieweiln</unclear>
<lb n="10"/>er <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">weib</unclear> unnd <unclear cert="medium" resp="#joint">khindern</unclear>, <unclear cert="medium" resp="#joint">vermitls</unclear> <unclear cert="medium" resp="#joint">göttliher</unclear>
<lb n="11"/>gnaden, neben andern <unclear cert="medium" resp="#joint">ehrlihen</unclear> <unclear cert="medium" resp="#joint">burgern</unclear> alhie, sein
<lb n="12"/><unclear cert="medium" resp="#joint">nahrung</unclear> <unclear cert="medium" resp="#joint">zugewinen</unclear> getraut, hieher <unclear cert="low" resp="#joint">zubegeben</unclear>,
<lb n="13"/>unnd <unclear cert="medium" resp="#joint">nider</unclear> <unclear cert="medium" resp="#joint">zurihten</unclear> <unclear cert="medium" resp="#joint">vorhabens</unclear> <unclear cert="medium" resp="#joint">were</unclear>, <unclear cert="medium" resp="#joint">batte</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">unns</unclear> hierauf <unclear cert="medium" resp="#joint">sonders</unclear> <unclear cert="medium" resp="#joint">fleiß</unclear>, <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">dise</unclear> <unclear cert="medium" resp="#joint">bitt</unclear>
<lb n="15"/>günstig <unclear cert="medium" resp="#joint">züverwilligen</unclear>, <unclear cert="medium" resp="#joint">benebens</unclear> ime an die <unclear cert="medium" resp="#joint">herrn</unclear>,
<lb n="16"/><unclear cert="medium" resp="#joint">damit</unclear> ime glauben <unclear cert="medium" resp="#joint">gesezt</unclear>, unnd ain <unclear cert="medium" resp="#joint">gebreühiger</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">abschidt</unclear> <unclear cert="medium" resp="#joint">erthailt</unclear>, <unclear cert="medium" resp="#joint">auh</unclear> alle <unclear cert="medium" resp="#joint">müglihe</unclear> promotion er-
<lb n="18"/>zaigt werden <unclear cert="low" resp="#joint">möhte</unclear> <unclear cert="low" resp="#joint">fürshrifft</unclear> <unclear cert="low" resp="#joint">züerthaillen</unclear>.
<lb n="19"/>Wann wir dann <unclear cert="medium" resp="#joint">solch</unclear> sein bitt, für <unclear cert="medium" resp="#joint">zimblih</unclear> <unclear cert="medium" resp="#joint">ange</unclear>-
<lb n="20"/>sehen, unnd den <unclear cert="medium" resp="#joint">jehnigen</unclear>, so <unclear cert="low" resp="#joint">sih</unclear> <unclear cert="low" resp="#joint">ehrlihen</unclear> <unclear cert="low" resp="#joint">hindurh</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zubringen</unclear> unnd <unclear cert="medium" resp="#joint">züerhalten</unclear> <unclear cert="medium" resp="#joint">willens</unclear>, allen <unclear cert="low" resp="#joint">müglihen</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">fürshub</unclear> <unclear cert="low" resp="#joint">zuthuen</unclear>, wie <unclear cert="medium" resp="#joint">shuldig</unclear> <unclear cert="medium" resp="#joint">als</unclear> <unclear cert="medium" resp="#joint">genaigt</unclear> sein,
<lb n="23"/><unclear cert="low" resp="#joint">demnach</unclear> haben wir ime dieselb <unclear cert="medium" resp="#joint">khaines</unclear> wegs
<pb facs="StadtASG_Missive_1543_5584.jpg" n="2"/>
<lb n="24"/>denegirn <unclear cert="medium" resp="#joint">khönnen</unclear>, Unnd langt hierauf an die Herrn
<lb n="25"/><unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">freüntlich</unclear> <unclear cert="low" resp="#joint">ansynnen</unclear> unnd bitten, Sie wellen <unclear cert="low" resp="#joint">besagten</unclear>
<lb n="26"/><persName resp="#ner"><unclear cert="low" resp="#joint">Daniel</unclear> <unclear cert="low" resp="#joint">Reüscher</unclear></persName> Iren mitburger, diser unser <unclear cert="low" resp="#joint">intercession</unclear>
<lb n="27"/>günstig <unclear cert="low" resp="#joint">genießen</unclear> laßen, denselben seiner burgerlichen
<lb n="28"/>pflicht, damit er den Herrn <unclear cert="low" resp="#joint">zuegethann</unclear>, <unclear cert="low" resp="#joint">entbündten</unclear>, <unclear cert="low" resp="#joint">Ime</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">gebreüchigen</unclear> abschiedt seines <unclear cert="low" resp="#joint">verhaltens</unclear> <unclear cert="medium" resp="#joint">erthaillen</unclear>, unnd
<lb n="30"/><unclear cert="low" resp="#joint">sonnst</unclear> auch <unclear cert="medium" resp="#joint">zue</unclear> disem seinem ehelichen <unclear cert="low" resp="#joint">fürhaben</unclear> unnd intent
<lb n="31"/>alle <unclear cert="low" resp="#joint">guete</unclear> befürderung erzaigen, Dagegen wann Er
<lb n="32"/><unclear cert="low" resp="#joint">Reüscher</unclear> sich alhie nidergesezt haben wirt, wellen
<lb n="33"/>wir darob sein, inmaßen wir es <unclear cert="low" resp="#joint">ohne</unclear> das schuldig,
<lb n="34"/>damit seine <unclear cert="low" resp="#joint">khündter</unclear>, des <unclear cert="low" resp="#joint">jehnigen</unclear>, so <unclear cert="low" resp="#joint">Ihnen</unclear> von
<lb n="35"/>rechtswegen <unclear cert="medium" resp="#joint">irgendts</unclear> <unclear cert="medium" resp="#joint">gebürt</unclear> unnd zuestendig ist,
<lb n="36"/>wann wir <unclear cert="medium" resp="#joint">alläin</unclear> deßen nachrichtung haben, <unclear cert="low" resp="#joint">khünfftig</unclear>
<lb n="37"/>habhafft werden sollen, Das <unclear cert="low" resp="#joint">begern</unclear> umb die
<lb n="38"/>Herrn, wir in dergleichen unnd andern hinwider
<lb n="39"/><unclear cert="low" resp="#joint">freündlich</unclear> <unclear cert="low" resp="#joint">zuebeschulden</unclear>, <origPlace resp="#ner"><unclear cert="low" resp="#joint">Closterneüburg</unclear></origPlace> novo stylo
<lb n="40"/><origDate resp="#ner">den 27. Martij anno etc. <unclear cert="medium" resp="#joint">607.t</unclear></origDate>
<lb n="41"/>N. <orgName role="issuer" resp="#ner">richter unnd rath der
<lb n="42"/>statt <unclear cert="low" resp="#joint">Closterneüburg</unclear></orgName>.
<pb facs="StadtASG_Missive_1543_5585.jpg" n="3"/>
<pb facs="StadtASG_Missive_1543_5586.jpg" n="4"/>
