<lb n="107"/>gern <unclear cert="medium" resp="#joint">alher</unclear> <unclear cert="medium" resp="#joint">geschickt</unclear>, <unclear cert="medium" resp="#joint">welcher</unclear> <unclear cert="medium" resp="#joint">zwen</unclear> uß <unclear cert="low" resp="#joint">eüwer</unclear>
