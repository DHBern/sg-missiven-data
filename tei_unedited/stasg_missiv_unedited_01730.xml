    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1730_6357.jpg" n="1"/>
<lb n="1"/>Unser freundt, nachparliche <unclear cert="medium" resp="#joint">willige</unclear> dienst, unnd
<lb n="2"/><unclear cert="low" resp="#joint">waß</unclear> wir ehren liebs unnd <unclear cert="medium" resp="#joint">guets</unclear> vermoegend
<lb n="3"/>zuvor, <unclear cert="medium" resp="#joint">Ehrnvest</unclear>, <unclear cert="medium" resp="#joint">Fuersichtig</unclear>, <unclear cert="medium" resp="#joint">Ersam</unclear> unnd <unclear cert="low" resp="#joint">Weiß</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">insonders</unclear> lieben Herren, <unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">Freundt</unclear> unnd
<lb n="5"/><unclear cert="medium" resp="#joint">Nachparn</unclear>.
<lb n="6"/>Demnach unser <unclear cert="medium" resp="#joint">gnaedig</unclear> <unclear cert="medium" resp="#joint">Herren</unclear> unnd obern,
<lb n="7"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermaister</unclear> unnd Raht der Statt <unclear cert="medium" resp="#joint">Sanct</unclear>
<lb n="8"/>Gallen</orgName>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">bschehen</unclear> <unclear cert="low" resp="#joint">gehorsambliches</unclear> <unclear cert="low" resp="#joint">anrueffen</unclear>
<lb n="9"/>unnd <unclear cert="low" resp="#joint">pitten</unclear> etlicher irer <unclear cert="medium" resp="#joint">Burgern</unclear> <unclear cert="medium" resp="#joint">zuewußig</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">Tisani</unclear> <unclear cert="medium" resp="#joint">schuldglaeubigern</unclear>, <unclear cert="medium" resp="#joint">ainen</unclear> <unclear cert="medium" resp="#joint">aindtlichen</unclear>
<lb n="11"/>peremptorischen Rechtstag uff <date resp="#ner"><unclear cert="low" resp="#joint">Mitwoch</unclear> den
<lb n="12"/><unclear cert="low" resp="#joint">ailfften</unclear> Monatstag Septembris <unclear cert="medium" resp="#joint">nechstkunff</unclear>-
<lb n="13"/>tig stylo veteri</date> <unclear cert="medium" resp="#joint">angesetzt</unclear>, under <unclear cert="medium" resp="#joint">dem</unclear>
<lb n="14"/>uns <unclear cert="low" resp="#joint">fuerkomen</unclear>, daß er <unclear cert="medium" resp="#joint">Tisan</unclear> auch E. E.
<lb n="15"/><unclear cert="medium" resp="#joint">Fr</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>. <unclear cert="medium" resp="#joint">angehoerigen</unclear> burgern, <unclear cert="medium" resp="#joint">alß</unclear> Herren
<lb n="16"/><persName resp="#ner">Abraham <unclear cert="low" resp="#joint">Schlumpfen</unclear></persName>, <unclear cert="low" resp="#joint">Rorman</unclear> <unclear cert="low" resp="#joint">gebr</unclear>. <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-5" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Arbon</unclear></placeName>,
<lb n="17"/>unnd andern mehr <unclear cert="medium" resp="#joint">waß</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">thuen</unclear> schuldig sein
<lb n="18"/>solle. Damit dann nun me=
<lb n="19"/><unclear cert="medium" resp="#joint">nigklich</unclear> an <unclear cert="medium" resp="#joint">seinen</unclear> <unclear cert="medium" resp="#joint">habend</unclear> <unclear cert="medium" resp="#joint">Rechten</unclear> nicht
<lb n="20"/><unclear cert="low" resp="#joint">verkuerzt</unclear>; sondern <unclear cert="medium" resp="#joint">iedem</unclear> alle <unclear cert="low" resp="#joint">rechtmaeßige</unclear>
<lb n="21"/>billichkait <unclear cert="low" resp="#joint">gedygen</unclear> unnd <unclear cert="medium" resp="#joint">ervolgen</unclear> moege,
<lb n="22"/><unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">habend</unclear> wir nit wollen <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">ermanglen</unclear>,
<lb n="23"/>E. E. <unclear cert="low" resp="#joint">Fr</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. inligend offen Edict <unclear cert="medium" resp="#joint">zueueber</unclear>-
<lb n="24"/><unclear cert="medium" resp="#joint">schicken</unclear> mit freundt, <unclear cert="medium" resp="#joint">nachparlichem</unclear> <unclear cert="medium" resp="#joint">pitt</unclear>.
<lb n="25"/>unnd <unclear cert="medium" resp="#joint">ersuechen</unclear>, die wellen solches unbeschwert
<lb n="26"/><unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">meniglichs</unclear> nachrichtung an <unclear cert="medium" resp="#joint">gewohnlichen</unclear>
<lb n="27"/>enden unnd <unclear cert="medium" resp="#joint">orthen</unclear> <unclear cert="medium" resp="#joint">offentlich</unclear> <unclear cert="medium" resp="#joint">verkunden</unclear>, und an=
<pb facs="StadtASG_Missive_1730_6358.jpg" n="2"/>
<lb n="28"/><unclear cert="low" resp="#joint">schlagen</unclear> lassen, daß begeren wier uf
<lb n="29"/>begebende fähl hinwiderumb freündt, nach-
<lb n="30"/>barlich zuobeschulden und zuoverdienen. Datt
<lb n="31"/>den <origDate when="1611-08-14" resp="#ner"><unclear cert="medium" resp="#joint">14</unclear>. <unclear cert="low" resp="#joint">Augustj</unclear> Anno 1611</origDate>.
<lb n="32"/><persName role="issuer" resp="#ner">Cristoff Buffler</persName> Stataman,
<lb n="33"/>und die Vrthel sprecher deß
<lb n="34"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Stattgrichts</unclear> <unclear cert="medium" resp="#joint">zur</unclear> Statt Sant
<lb n="35"/>Gallen</orgName>.
<pb facs="StadtASG_Missive_1730_6359.jpg" n="3"/>
<pb facs="StadtASG_Missive_1730_6360.jpg" n="4"/>
<lb n="36"/>Den <unclear cert="low" resp="#joint">Eerenvesten</unclear>, fürsichtigen, <unclear cert="low" resp="#joint">Eersamen</unclear> und Weisen,
<lb n="37"/><orgName ref="stadtasg-actors-511" cert="medium" role="recipient" resp="#ner">Burgermaister <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Rhaht</unclear> der <unclear cert="medium" resp="#joint">Stat</unclear> <unclear cert="low" resp="#joint">Lindaw</unclear></orgName> <unclear cert="low" resp="#joint">im</unclear>
<lb n="38"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Bodensee</unclear></placeName>, <unclear cert="low" resp="#joint">unnsern</unclear> lieben herren, guoten <unclear cert="medium" resp="#joint">fründ</unclear> <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="39"/><unclear cert="medium" resp="#joint">Nachparren</unclear>.
</p>
