<lb n="9"/><unclear cert="medium" resp="#joint">laßen</unclear>. Und habend Ir hieby <unclear cert="medium" resp="#joint">ligend</unclear> <unclear cert="medium" resp="#joint">was</unclear> uns <unclear cert="medium" resp="#joint">allererst</unclear> von
<lb n="10"/><unclear cert="medium" resp="#joint">guetem</unclear> <unclear cert="medium" resp="#joint">ort</unclear> <unclear cert="medium" resp="#joint">zuekomen</unclear> und <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">üweren</unclear> <unclear cert="low" resp="#joint">anderen</unclear> und <unclear cert="medium" resp="#joint">unseren</unclear>
