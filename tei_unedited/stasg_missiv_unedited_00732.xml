<p>
<pb facs="StadtASG_Missive_732_1851.JPG" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Edl</unclear>, <unclear cert="medium" resp="#joint">vest</unclear>, fuersichtig, <unclear cert="low" resp="#joint">ersam</unclear> und weiß <unclear cert="low" resp="#joint">hern</unclear> <orgName ref="stadtasg-actors-56" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">stathpleger</unclear>,
<lb n="2"/>burgermaister, unnd ain ersamer rath diser <unclear cert="medium" resp="#joint">loblichn</unclear>
<lb n="3"/>statt Augspurg</orgName>, <unclear cert="medium" resp="#joint">geneytig</unclear> unnd gebietend <unclear cert="medium" resp="#joint">hern</unclear>.
<lb n="4"/>Wiewoll verschiner tagen uff anhalten <persName resp="#ner">Wilhelmen
<lb n="5"/><unclear cert="low" resp="#joint">Gjoetzen</unclear></persName> unnd <persName resp="#ner">Casparn <unclear cert="medium" resp="#joint">Rathmundt</unclear></persName>, amman <unclear cert="medium" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Roschach</unclear></placeName>,
<lb n="6"/><unclear cert="medium" resp="#joint">ain</unclear> <unclear cert="medium" resp="#joint">vermainte</unclear> <unclear cert="medium" resp="#joint">gannt</unclear> <unclear cert="medium" resp="#joint">verkhundung</unclear> <unclear cert="medium" resp="#joint">außganngen</unclear>,
<lb n="7"/>in der vermelt worden, das derselbig <persName resp="#ner"><unclear cert="low" resp="#joint">Rathmundt</unclear></persName>, als
<lb n="8"/>volmechtiger <unclear cert="low" resp="#joint">anwald</unclear> gedachts <persName resp="#ner"><unclear cert="medium" resp="#joint">Gjoetzens</unclear></persName>, auch <unclear cert="medium" resp="#joint">mein</unclear>
<lb n="9"/>und anderer <unclear cert="low" resp="#joint">meins</unclear> <unclear cert="low" resp="#joint">dochter</unclear> <unclear cert="low" resp="#joint">mans</unclear> <persName resp="#ner">Lienharten von
<lb n="10"/><unclear cert="low" resp="#joint">Roehenstains</unclear></persName> <unclear cert="low" resp="#joint">glaubiger</unclear>, sein <unclear cert="medium" resp="#joint">Roehenstains</unclear> gueter
<lb n="11"/><unclear cert="medium" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Sannd</unclear> Gallen</placeName> ligent, mit <unclear cert="low" resp="#joint">gannt</unclear> angreiffen
<lb n="12"/><unclear cert="medium" resp="#joint">welle</unclear>, unnd ich aber all mein tag demselben
<lb n="13"/><persName resp="#ner"><unclear cert="low" resp="#joint">Rathmundt</unclear></persName> derhalb <unclear cert="low" resp="#joint">ainchen</unclear> <unclear cert="low" resp="#joint">bevelch</unclear> nit geben, hab
<lb n="14"/>ich <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">fuersorg</unclear> der sachen ainem genannt <persName resp="#ner">Joachim
<lb n="15"/>Reitlinger</persName>, burger <unclear cert="medium" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sand Gallen</placeName>, <unclear cert="medium" resp="#joint">gemein</unclear> <unclear cert="medium" resp="#joint">gwalt</unclear>
<lb n="16"/>mit notturfftiger instruction <unclear cert="medium" resp="#joint">uberschickt</unclear>, die sachen
<lb n="17"/>an meiner stat der gebuer nach <unclear cert="medium" resp="#joint">zueverfechten</unclear>, als <unclear cert="low" resp="#joint">Ewr</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">vest</unclear>. und f. <unclear cert="medium" resp="#joint">w</unclear>. <unclear cert="medium" resp="#joint">ert</unclear>. <unclear cert="medium" resp="#joint">auß</unclear> beiligender copi <unclear cert="medium" resp="#joint">gnejigclich</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">zuevernemen</unclear> haben, darauff ich woll <unclear cert="low" resp="#joint">vermaint</unclear>,
<lb n="20"/>das <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner">Reitlinger</persName> denselben <unclear cert="low" resp="#joint">angenomen</unclear>, oder doch
<lb n="21"/>mich auffs <unclear cert="low" resp="#joint">furderlichist</unclear> wider bericht haben sollte,
<lb n="22"/>das <unclear cert="low" resp="#joint">er</unclear> denselben nit annemen, und <unclear cert="low" resp="#joint">waß</unclear> gehandlet
<lb n="23"/>worden were. Dieweil <unclear cert="low" resp="#joint">dasselb</unclear> aber nit beschehen,
<lb n="24"/>unnd die sach <unclear cert="low" resp="#joint">bißheer</unclear> also <unclear cert="low" resp="#joint">ansteen</unclear> beliben, und ich
<lb n="25"/>auch <unclear cert="low" resp="#joint">hainerlay</unclear> <unclear cert="low" resp="#joint">wißen</unclear> empfangen, biß uff <unclear cert="low" resp="#joint">gesterigen</unclear>
<lb n="26"/>den <date resp="#ner"><unclear cert="medium" resp="#joint">xxiiten</unclear> tag <unclear cert="low" resp="#joint">junii</unclear></date> vernomen, das <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner">Reitlinger</persName>
<lb n="27"/>meinen gewalt nit angenomen, und <unclear cert="medium" resp="#joint">deßhalb</unclear> von
<lb n="28"/><unclear cert="medium" resp="#joint">meintwegen</unclear> nichts gehandlet, noch mich <unclear cert="low" resp="#joint">sunst</unclear> mit
<lb n="29"/>nichten berichtet, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">bißheer</unclear> in solcher <unclear cert="medium" resp="#joint">hanndlung</unclear> ver-
<pb facs="StadtASG_Missive_732_1852.JPG" n="2"/>
<lb n="30"/><unclear cert="low" resp="#joint">lotten</unclear>. So dann dise <unclear cert="medium" resp="#joint">gant</unclear> <unclear cert="medium" resp="#joint">verkuendung</unclear>
<lb n="31"/>nit allain unformlich. sonnder auch des <unclear cert="low" resp="#joint">Ratmundts</unclear>
<lb n="32"/>fuergeben ungebuerlich beschehen. Auch die <unclear cert="medium" resp="#joint">hanndlung</unclear>
<lb n="33"/>nit allain mich. sonnder auch <unclear cert="low" resp="#joint">meine</unclear> <unclear cert="low" resp="#joint">doechtern</unclear> und
<lb n="34"/><unclear cert="low" resp="#joint">enickel</unclear> betrifft. derhalb ich in sorgen stee, in solchem
<lb n="35"/><unclear cert="low" resp="#joint">verkuertzt</unclear>. unnd vernachtailt werden moechte. So
<lb n="36"/>ist hierauff an eur <unclear cert="medium" resp="#joint">V</unclear>. und F. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. mein under-
<lb n="37"/>thenig <unclear cert="low" resp="#joint">hochfleissig</unclear> bitt, <unclear cert="medium" resp="#joint">die</unclear> wellen mit irem <unclear cert="low" resp="#joint">guenstige</unclear>
<lb n="38"/>fuerschreiben, an ainen ersamen <orgName ref="stadtasg-actors-148" cert="medium" resp="#ner">Rath der stat Sant
<lb n="39"/>Gallen</orgName> von meinetwegen schreiben. das ir <unclear cert="low" resp="#joint">weishait</unclear>
<lb n="40"/>gestalt der sachen, <unclear cert="medium" resp="#joint">guennstigclich</unclear> <unclear cert="medium" resp="#joint">erwegen</unclear>. unnd waß
<lb n="41"/>bißheer <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">gemelter</unclear> sach <unclear cert="medium" resp="#joint">gehanndlet</unclear> worden, eur
<lb n="42"/><unclear cert="medium" resp="#joint">V</unclear>. und F. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. oder mich berichten, und <unclear cert="medium" resp="#joint">darob</unclear> seien,
<lb n="43"/><unclear cert="low" resp="#joint">damitt</unclear> <unclear cert="medium" resp="#joint">weder</unclear> ich, noch die meinen nit <unclear cert="low" resp="#joint">verkuertzt</unclear> werden
<lb n="44"/>das will nit allain ich, sonnder baide meine dochter-
<lb n="45"/><unclear cert="low" resp="#joint">menner</unclear>, <persName resp="#ner">Pangratz von Rappenstain</persName>, <persName resp="#ner">Jorg Langen-
<lb n="46"/>mantel</persName> auch <persName resp="#ner">Hannß <unclear cert="low" resp="#joint">Vehlin</unclear> der juenger</persName>, unnd
<lb n="47"/><persName resp="#ner">Anthoni Weiß</persName>. als weilund <persName resp="#ner">Lienharten <unclear cert="low" resp="#joint">Laugingers</unclear></persName>
<lb n="48"/>meines lieben dochtermans seligen verlaßner
<lb n="49"/><unclear cert="low" resp="#joint">kynnder</unclear>. meiner lieben <unclear cert="low" resp="#joint">enicklen</unclear> pfleger umb
<lb n="50"/>eur <unclear cert="medium" resp="#joint">V</unclear>. und F. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>. deßgleichen auch gegen <unclear cert="medium" resp="#joint">ainem</unclear>
<lb n="51"/>ersamen <orgName ref="stadtasg-actors-148" cert="medium" resp="#ner">Rath <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">Sand</unclear> Gallen</orgName>, ganntz diemuetig-
<lb n="52"/><unclear cert="low" resp="#joint">clich</unclear> und gehorsamlich <unclear cert="medium" resp="#joint">zuoverdienen</unclear> <unclear cert="low" resp="#joint">geflissen</unclear> sein,
<lb n="53"/><unclear cert="low" resp="#joint">hierauff</unclear> <unclear cert="low" resp="#joint">guenstiger</unclear> befuerderung gewarttent.
<lb n="54"/><unclear cert="medium" resp="#joint">Eur</unclear> <unclear cert="low" resp="#joint">Hlt</unclear>. <unclear cert="low" resp="#joint">vest</unclear>
<lb n="55"/>und F. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wt</unclear>.
<lb n="56"/>diemuetige
<lb n="57"/><unclear cert="medium" resp="#joint">mitburgerin</unclear>
<lb n="58"/><persName role="issuer" resp="#ner">Catharina <unclear cert="low" resp="#joint">Kraeusin</unclear></persName>
<lb n="59"/><unclear cert="low" resp="#joint">weilund</unclear> <persName resp="#ner">Hannsen
<lb n="60"/>Wolffens von <unclear cert="low" resp="#joint">Bibel</unclear>-
<lb n="61"/>spurg</persName> <unclear cert="medium" resp="#joint">selige</unclear> nachge-
<lb n="62"/>laßne wittib.
