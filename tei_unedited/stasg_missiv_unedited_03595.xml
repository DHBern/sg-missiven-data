<p>
<pb facs="StadtASG_Missive_3595_14343.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">fründt</unclear>: <unclear cert="low" resp="#joint">nachperlich</unclear> willig dienst, und <unclear cert="medium" resp="#joint">waß</unclear>
<lb n="2"/>wir ehren liebs und guots vermögend zuovor. Fromm <unclear cert="low" resp="#joint">für</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">sichtig</unclear>, <unclear cert="low" resp="#joint">ehrsam</unclear>, <unclear cert="low" resp="#joint">weyß</unclear>, <unclear cert="low" resp="#joint">Jnsonders</unclear> guot fründt und wol-
<lb n="4"/><unclear cert="medium" resp="#joint">vertrüwte</unclear> liebe nachparen,
<lb n="5"/><unclear cert="medium" resp="#joint">Unß</unclear> <unclear cert="medium" resp="#joint">habendt</unclear> <unclear cert="medium" resp="#joint">unser</unclear> liebe <unclear cert="medium" resp="#joint">landtlüth</unclear>, <persName resp="#ner"><unclear cert="medium" resp="#joint">Thoman</unclear> <unclear cert="medium" resp="#joint">Dobler</unclear></persName>,
<lb n="6"/>und <persName resp="#ner"><unclear cert="medium" resp="#joint">Barnhardt</unclear> <unclear cert="medium" resp="#joint">Stüoberman</unclear></persName>, <unclear cert="medium" resp="#joint">gehorsamlich</unclear> <unclear cert="medium" resp="#joint">zuoverstohen</unclear>
<lb n="7"/>geben, <unclear cert="low" resp="#joint">waßgestalten</unclear> <unclear cert="low" resp="#joint">sij</unclear> <unclear cert="low" resp="#joint">verschinenß</unclear> <unclear cert="low" resp="#joint">margens</unclear> <unclear cert="low" resp="#joint">daß</unclear> ist
