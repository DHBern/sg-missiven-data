<lb n="4"/><unclear cert="low" resp="#joint">frawen</unclear>, <unclear cert="low" resp="#joint">Saybergern</unclear>, <unclear cert="low" resp="#joint">conuent</unclear> <unclear cert="low" resp="#joint">frawen</unclear>, <unclear cert="low" resp="#joint">zuo</unclear>
<lb n="5"/>Sannt Clarenn, <unclear cert="low" resp="#joint">Inn</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">stat</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">Ire</unclear> <unclear cert="low" resp="#joint">vordern</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Ierlich</unclear> zehenn schilling pfening geltz, <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">ainem</unclear>
