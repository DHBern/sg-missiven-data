    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1379_4843.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">freünttlich</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachbarlich</unclear> <unclear cert="low" resp="#joint">willig</unclear> <unclear cert="low" resp="#joint">dienst</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">zuvor</unclear> fürsichtigen <unclear cert="low" resp="#joint">ersamen</unclear> und weisen, <unclear cert="low" resp="#joint">be</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">sonders</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">freünden</unclear> und <unclear cert="low" resp="#joint">nachbarn</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Derselben</unclear> <unclear cert="low" resp="#joint">under</unclear> dato <date resp="#ner">den 25. 9b. hujus</date>, uf
<lb n="5"/>ernstlich <unclear cert="low" resp="#joint">anhalten</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Schnizers</unclear></persName> an
<lb n="6"/>unß abgefertigt schreiben, betreffend <persName resp="#ner">Hannß-
<lb n="7"/>Jacob Soenlin</persName> unsern burger, habend wir
<lb n="8"/><unclear cert="low" resp="#joint">seines</unclear> <unclear cert="low" resp="#joint">innhaltts</unclear> ablesend
<lb n="9"/>verstanden, und solches angeregtem unserm
<lb n="10"/>burger sich darinn zuersehen und sein Antwortt hierüber <unclear cert="low" resp="#joint">zegeben</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Raths</unclear> <unclear cert="low" resp="#joint">halb</unclear> über <unclear cert="low" resp="#joint">zustellen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">Welcher</unclear> unß in solcher seiner Antwort bericht,
<lb n="13"/><unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">gleichwol</unclear> <unclear cert="low" resp="#joint">er</unclear>, <unclear cert="low" resp="#joint">eins</unclear> <unclear cert="low" resp="#joint">zwüschend</unclear> <unclear cert="low" resp="#joint">ime</unclear>
<lb n="14"/>und <persName resp="#ner"><unclear cert="low" resp="#joint">Schnizern</unclear></persName> <unclear cert="low" resp="#joint">getroffnen</unclear> <unclear cert="low" resp="#joint">kauffs</unclear> <unclear cert="low" resp="#joint">halben</unclear> zu
<lb n="15"/><placeName ref="stadtasg-places-78" cert="medium" resp="#ner">Buochhorn</placeName> daß Recht zegeben angelobt. Seye
<lb n="16"/>doch solches gänzlich andrer gstalt nit gschehen,
<lb n="17"/>dann <unclear cert="low" resp="#joint">sover</unclear> <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Soenlin</unclear></persName> <unclear cert="low" resp="#joint">berürten</unclear> <unclear cert="low" resp="#joint">kauff</unclear>
<lb n="18"/>(welchen er etlicher von dem <persName resp="#ner">Schnizer</persName>
<lb n="19"/>verschweigner füncten halber zu retractieren
<lb n="20"/>vermeint.) nit halten welte, Daß deß-
<lb n="21"/>dann er <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">Schnizer</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Rchten</unclear> <unclear cert="low" resp="#joint">dises</unclear> <unclear cert="low" resp="#joint">kauffs</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">entlaßen</unclear> <unclear cert="low" resp="#joint">welle</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">Rchtens</unclear> zu <unclear cert="low" resp="#joint">Buochhorn</unclear> <unclear cert="low" resp="#joint">zgestatten</unclear>
<lb n="22"/>schuldig sein solle.
<lb n="23"/>Wann nun aber er uß allerhand be-
<lb n="24"/>weglichen ursachen,
<lb n="25"/>sich in weitleüfigkeit Rchtens
<lb n="26"/>zu begeben in vilfaltig bedenckhen gstelt,
<lb n="27"/>habe er zu vermeidung aller deßhalb
<pb facs="StadtASG_Missive_1379_4844.jpg" n="2"/>
<lb n="28"/>beßerserkanus, ermeltem <persName resp="#ner">Schnizer</persName>, den
<lb n="29"/>ergangnen kauff <unclear cert="low" resp="#joint">verſprochner</unclear> maßen gehalten,
<lb n="30"/>und hiemit <unclear cert="low" resp="#joint">berüerter</unclear> <unclear cert="low" resp="#joint">gelübdgnuogsam</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">sih</unclear> <unclear cert="low" resp="#joint">entlediget</unclear>.
<lb n="32"/><unclear cert="low" resp="#joint">Ungeacht</unclear> aber <unclear cert="low" resp="#joint">deßen</unclear> alles habe <persName resp="#ner"><unclear cert="low" resp="#joint">Schnizer</unclear></persName> <unclear cert="medium" resp="#joint">noh</unclear>-
<lb n="33"/>mals hieran <unclear cert="medium" resp="#joint">sih</unclear> nit <unclear cert="low" resp="#joint">ersettiget</unclear>: <unclear cert="low" resp="#joint">sondern</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">etlihe</unclear> <unclear cert="low" resp="#joint">klagbeschwerden</unclear>, ( deren er <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">doh</unclear> nit
<lb n="35"/>gestendig.) <unclear cert="low" resp="#joint">dises</unclear> kauffs halber wider in für-
<lb n="36"/>gebracht, und derhalben <unclear cert="low" resp="#joint">ine</unclear> vor <unclear cert="low" resp="#joint">unserem</unclear>
<lb n="37"/><orgName resp="#ner"><unclear cert="medium" resp="#joint">Stattgriht</unclear></orgName> <unclear cert="low" resp="#joint">rehtens</unclear> <unclear cert="low" resp="#joint">angelangt</unclear> und ersuoht,
<lb n="38"/>dannen er <unclear cert="low" resp="#joint">doh</unclear> <unclear cert="low" resp="#joint">hernah</unclear> wider <unclear cert="low" resp="#joint">abg</unclear>-
<lb n="39"/>standen, und <unclear cert="low" resp="#joint">söllih</unclear> angefangen <unclear cert="medium" resp="#joint">reht</unclear> gegen
<lb n="40"/>im nit <unclear cert="low" resp="#joint">ußgeüebt</unclear>.
<lb n="41"/>Weil dann <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Scüelin</unclear></persName> besagtem <persName resp="#ner"><unclear cert="low" resp="#joint">Schnizer</unclear></persName>,
<lb n="42"/>angeregten kauff, und waß er ime deßhalb
<lb n="43"/><unclear cert="low" resp="#joint">verbunden</unclear> geweßen, seins <unclear cert="low" resp="#joint">erahtens</unclear>, der ge-
<lb n="44"/>bür naherstattet, und dann darnebend
<lb n="45"/>deß <persName resp="#ner">Schnizers</persName> nüwgeführte klagten, an-
<lb n="46"/>geregt gelübd im wenigsten <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">berüerend</unclear>,
<lb n="47"/><unclear cert="low" resp="#joint">darzuo</unclear> er <persName resp="#ner">Schnizer</persName> dertwegen, alhie vor
<lb n="48"/><unclear cert="low" resp="#joint">unserem</unclear> <orgName resp="#ner"><unclear cert="medium" resp="#joint">Stattgriht</unclear></orgName> gegen im in <unclear cert="medium" resp="#joint">reht</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">eingstanden</unclear>. So <unclear cert="low" resp="#joint">verhoffe</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">Imen</unclear>
<lb n="50"/>an keinen andern orten, alß vor seinem
<lb n="51"/><unclear cert="low" resp="#joint">ordenlihen</unclear> <unclear cert="low" resp="#joint">rihter</unclear> ( den der <persName resp="#ner">Schnizer</persName>, alß vor
<lb n="52"/>gehört, <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">ine</unclear> <unclear cert="low" resp="#joint">albereit</unclear> <unclear cert="low" resp="#joint">angerüefft</unclear>.)
<lb n="53"/><unclear cert="low" resp="#joint">rehtens</unclear> <unclear cert="low" resp="#joint">zegestatten</unclear> schuldig sein, vor welhem
<lb n="54"/>er ime seiner anspracchen halber guoten red und
<lb n="55"/>antwort geben, und daruf <unclear cert="low" resp="#joint">gebürenden</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">rehtens</unclear> erwarten welle. Unß hieruf
<pb facs="StadtASG_Missive_1379_4845.jpg" n="3"/>
<lb n="57"/>underthenig pittende, wir ine bey
<lb n="58"/>disem sinem anerbieten verbleiben laßen,
<lb n="59"/>und <unclear cert="low" resp="#joint">ime</unclear> deßhalb weiter nichts zuomuoten
<lb n="60"/>wöllen.
<lb n="61"/>Wann dann <unclear cert="low" resp="#joint">unß</unclear> wol bewußt, daß meher-
<lb n="62"/>besagter <persName resp="#ner">Schnizer</persName>, den unsern, vor etwas
<lb n="63"/><unclear cert="low" resp="#joint">verschiner</unclear> zeit, vor unserem Stattgricht
<lb n="64"/>rechtens <unclear cert="low" resp="#joint">ersuocht</unclear>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">demselben</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">sehen</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">kuenden</unclear>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">grund</unclear> <unclear cert="low" resp="#joint">wir</unclear> ine vor
<lb n="66"/>unserm <unclear cert="medium" resp="#joint">Stattgricht</unclear> ab: und für ander
<lb n="67"/>richter weisen <unclear cert="low" resp="#joint">sölten</unclear>, besonders dieweil
<lb n="68"/>der unser deß <unclear cert="low" resp="#joint">glübts</unclear> <unclear cert="low" resp="#joint">andrergstalt</unclear> nit, als
<lb n="69"/><unclear cert="low" resp="#joint">obgehörter</unclear> maßen gestendig. So
<lb n="70"/>habend wir deßhalb dem unsern
<lb n="71"/><unclear cert="low" resp="#joint">über</unclear> vorgemelt <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">anerbieten</unclear>, dißmal
<lb n="72"/>mehr nit uflegen <unclear cert="low" resp="#joint">kuenden</unclear>. Da
<lb n="73"/>aber <persName resp="#ner"><unclear cert="low" resp="#joint">Schnizzer</unclear></persName> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="medium" resp="#joint">ine</unclear> nochmals etwas <unclear cert="low" resp="#joint">zuo</unclear>-
<lb n="74"/>sprechen <unclear cert="medium" resp="#joint">vermeint</unclear>, <unclear cert="low" resp="#joint">seyend</unclear> wir wol <unclear cert="medium" resp="#joint">geneigt</unclear>,
<lb n="75"/><unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">guot</unclear> <unclear cert="low" resp="#joint">schleünig</unclear> und fürderlich recht
<lb n="76"/>widerfaren zelaßen.
<lb n="77"/>Deß wolten wir E. E. B. Wht.
<lb n="78"/>zuo begerter antwort nit verhalten,
<lb n="79"/><unclear cert="low" resp="#joint">seyend</unclear> und bleibend hiemit denselben
<lb n="80"/>zuo aller guoten angenemen nachbarschaft
<lb n="81"/>jederzeit wol geneigt. Datum
<lb n="82"/>den <origDate when="1600" resp="#ner">25.t Septembris stylo veterj <unclear cert="low" resp="#joint">a°</unclear> 1600</origDate>
<lb n="83"/><unclear cert="low" resp="#joint">An</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Bischofzel</unclear>.
<lb n="84"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">B. u. rhat
<lb n="85"/>der statt St. Gallen</orgName>.
<pb facs="StadtASG_Missive_1379_4846.jpg" n="4"/>
