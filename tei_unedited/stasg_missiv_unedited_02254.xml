    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2254_8545.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freüntlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">sampt</unclear> was wir ehren liebs
<lb n="3"/>und guotts <unclear cert="medium" resp="#joint">vermoegen</unclear>, <unclear cert="medium" resp="#joint">zuvor</unclear>.
<lb n="4"/><unclear cert="medium" resp="#joint">Edlen</unclear>, vesten, <unclear cert="medium" resp="#joint">fromen</unclear>, <unclear cert="medium" resp="#joint">fuersichtig</unclear>,
<lb n="5"/>ersamen, und weisen, <unclear cert="medium" resp="#joint">insonders</unclear>
<lb n="6"/>guotten <unclear cert="medium" resp="#joint">freünde</unclear> und <unclear cert="medium" resp="#joint">getreüwen</unclear>,
<lb n="7"/>lieben <orgName role="recipient" resp="#ner">eidtgnossen</orgName>.
<lb n="8"/><unclear cert="medium" resp="#joint">Was</unclear> <unclear cert="medium" resp="#joint">dieselbe</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">verderblich</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">unpoesen</unclear> <unclear cert="medium" resp="#joint">halber</unclear>, <unclear cert="medium" resp="#joint">so</unclear> doch
<lb n="10"/>die <unclear cert="low" resp="#joint">allerlei</unclear> <unclear cert="low" resp="#joint">froembde</unclear> <unclear cert="low" resp="#joint">ußerhalb</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">miner</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">eidtgnoschafft</unclear></orgName> <unclear cert="low" resp="#joint">erzeugte</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">purn</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">halbe</unclear> <unclear cert="low" resp="#joint">diebiß</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">Ihren</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">landen</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">luein</unclear></placeName> <unclear cert="low" resp="#joint">duerfen</unclear>,
<lb n="14"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">grueßent</unclear> <unclear cert="low" resp="#joint">eßlich</unclear> <unclear cert="low" resp="#joint">gesellsch</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">bietth</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">lagen</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">hert</unclear>,
<lb n="16"/><unclear cert="low" resp="#joint">schlezen</unclear>, <unclear cert="low" resp="#joint">do</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">erfüege</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ermelte</unclear> <unclear cert="low" resp="#joint">urthl</unclear> in dem
<lb n="18"/><unclear cert="low" resp="#joint">fall</unclear> <unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">beicht</unclear> <unclear cert="low" resp="#joint">befreit</unclear>, wie
<lb n="19"/><unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">anhero</unclear> <unclear cert="low" resp="#joint">sinde</unclear> <unclear cert="low" resp="#joint">ungesprochen</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">verbleiben</unclear> <unclear cert="low" resp="#joint">laßen</unclear> wellen <unclear cert="low" resp="#joint">unb</unclear>
<lb n="21"/><date resp="#ner"><unclear cert="low" resp="#joint">7</unclear> <unclear cert="low" resp="#joint">st</unclear>. <unclear cert="low" resp="#joint">Januarii</unclear></date> <unclear cert="low" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">di</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">muetthlich</unclear> <unclear cert="low" resp="#joint">zuogestelt</unclear>, <unclear cert="low" resp="#joint">daß</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">haben</unclear> wir <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">ermeltem</unclear> <unclear cert="medium" resp="#joint">Ihrem</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">schriben</unclear> so wir erst <date resp="#ner"><unclear cert="medium" resp="#joint">gesteriges</unclear>
<lb n="25"/>tags den <unclear cert="medium" resp="#joint">28</unclear> <unclear cert="medium" resp="#joint">lt</unclear>.</date> <unclear cert="medium" resp="#joint">mines</unclear> <unclear cert="medium" resp="#joint">empfangen</unclear>.
<lb n="26"/>mit <unclear cert="medium" resp="#joint">mehreren</unclear> <unclear cert="medium" resp="#joint">ablesend</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">verstanden</unclear>.
<pb facs="StadtASG_Missive_2254_8546.jpg" n="2"/>
<lb n="28"/>Und <unclear cert="low" resp="#joint">gereicht</unclear> <unclear cert="low" resp="#joint">hergegen</unclear> <unclear cert="low" resp="#joint">U</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="29"/>und <unclear cert="low" resp="#joint">L</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">umb</unclear> die <unclear cert="medium" resp="#joint">freundt</unclear>-
<lb n="30"/>lich <unclear cert="medium" resp="#joint">Eydtgnößisch</unclear> communication
<lb n="31"/><unclear cert="low" resp="#joint">freundtlich</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Eydtgnößisch</unclear> <unclear cert="low" resp="#joint">danck</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">daro</unclear> <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">dargegen</unclear>
<lb n="33"/>nicht verhalten. Daß.
<lb n="34"/><unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">theils</unclear> <unclear cert="low" resp="#joint">nichts</unclear> <unclear cert="low" resp="#joint">liebers</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">wünschen</unclear> <unclear cert="low" resp="#joint">noch</unclear>, <unclear cert="low" resp="#joint">denn</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">dißem</unclear> so <unclear cert="low" resp="#joint">geschwinde</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">einreißenden</unclear> <unclear cert="low" resp="#joint">ubel</unclear>, und <unclear cert="low" resp="#joint">steige</unclear>-
<lb n="38"/><unclear cert="low" resp="#joint">rung</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">sorten</unclear>, <unclear cert="low" resp="#joint">ufwechßlung</unclear>
<lb n="39"/>und <unclear cert="low" resp="#joint">verfüehrung</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">guoten</unclear> <unclear cert="low" resp="#joint">gerechten</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">redlichen</unclear> <unclear cert="low" resp="#joint">müntzen</unclear>, und <unclear cert="medium" resp="#joint">einschleichung</unclear>
<lb n="41"/><unclear cert="medium" resp="#joint">allerley</unclear> <unclear cert="medium" resp="#joint">frembder</unclear> <unclear cert="medium" resp="#joint">zuogering</unclear>
<lb n="42"/><unclear cert="medium" resp="#joint">haltiger</unclear> <unclear cert="medium" resp="#joint">sorten</unclear> <unclear cert="medium" resp="#joint">abgewehrt</unclear>,
<lb n="43"/>und ein <unclear cert="low" resp="#joint">bestendige</unclear> <unclear cert="low" resp="#joint">müntz</unclear> <unclear cert="low" resp="#joint">gleichheit</unclear>
<lb n="44"/>in <unclear cert="low" resp="#joint">einer</unclear> <unclear cert="low" resp="#joint">Eydtgnoßschaft</unclear> hette
<lb n="45"/><unclear cert="low" resp="#joint">hette</unclear> und <unclear cert="medium" resp="#joint">mechte</unclear> <unclear cert="medium" resp="#joint">erhalten</unclear> <unclear cert="medium" resp="#joint">werden</unclear>.
<lb n="46"/><unclear cert="medium" resp="#joint">wie</unclear> <unclear cert="medium" resp="#joint">wir</unclear> dann <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">ende</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">aus</unclear> <unclear cert="low" resp="#joint">dergleichnuß</unclear> <unclear cert="low" resp="#joint">er</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">manglen</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">laider</unclear> <unclear cert="low" resp="#joint">bißhero</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">ußerhalb</unclear> <unclear cert="low" resp="#joint">darob</unclear> <unclear cert="low" resp="#joint">gehalten</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">durch</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">offene</unclear> <unclear cert="low" resp="#joint">schaupfe</unclear> <unclear cert="low" resp="#joint">Edicten</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Mandaten</unclear> <unclear cert="low" resp="#joint">keine</unclear> <unclear cert="low" resp="#joint">frembde</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">feilzuonemen</unclear> <unclear cert="low" resp="#joint">eingehen</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">wöllen</unclear>, <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">unvermeidter</unclear> <unclear cert="low" resp="#joint">strafen</unclear>.
<pb facs="StadtASG_Missive_2254_8547.jpg" n="3"/>
<lb n="54"/>nach dem die saechsen Müntzen
<lb n="55"/>böß continuiren, damit durch
<lb n="56"/>abschlag im landt erfolgt und dem gwerb
<lb n="57"/>und leinwathandel hienit bößes
<lb n="58"/>angstellet werde,
<lb n="59"/>und also ir und gemeiner Oberkeit
<lb n="60"/>ledig gmachen, iedoch Euweren
<lb n="61"/>anfoderung an iedoch abgeredtergstaltnuß
<lb n="62"/>daselbst zu <placeName ref="stadtasg-places-32" cert="medium" resp="#ner">Züerich</placeName> gehalten
<lb n="63"/>sollt und dahero verusacht mich
<lb n="64"/>lauth deß wechsls von wohl
<lb n="65"/>wahrhafftig ditzes bedenkch-
<lb n="66"/>lichen standts halber, die müntz
<lb n="67"/>vor einzuostellen. und
<lb n="68"/>obwohl die mghr geordnet hinfuero
<lb n="69"/>thaler nit hocher den
<lb n="70"/>p 2. 15. gsetzt worden.
<lb n="71"/>so thung wir doch hiemit
<lb n="72"/>uuch brichten, daß derzelbig
<lb n="73"/>by disem vor, albereits die
<lb n="74"/>p 2. 20. gilt daruber wir noch
<lb n="75"/>uuchs frd gebeten wellen, weliche
<lb n="76"/>wie bescheht beser
<lb n="77"/>weilen es der statzten wesen,
<lb n="78"/>und die weg vil schadlich-
<lb n="79"/>ens zuo handlen haben.
<lb n="80"/>und hiemit götlicher
<lb n="81"/>In des heiligisten blick
<lb n="82"/>bewaren.
<pb facs="StadtASG_Missive_2254_8548.jpg" n="4"/>
<lb n="83"/>diewil verluth, das in der
<lb n="84"/>nachbuerschafft desselbigen schon allbereit
<lb n="85"/>die 6 bergli und zuo <placeName ref="stadtasg-places-167" cert="medium" resp="#ner">Thueremberg</placeName>
<lb n="86"/>garnach das halb guotli verbrun-
<lb n="87"/>nen,
<lb n="88"/>Welches E. V. Wht. und U. L. Elt.
<lb n="89"/>(mit denen wir alß unsern
<lb n="90"/>vertruwten lieben <orgName resp="#ner">Eydtgnossen</orgName> wir uß Eydgnossischer wolmeinung
<lb n="91"/>warin aller Eydtgnossischer nicht verhalten wellen. Was
<lb n="92"/>wolstand zuoerhalten begeren,) dan wir ueuwerseits
<lb n="93"/>bebiebendes erhallen, und wz
<lb n="94"/>dem geliebten vatterland zuo
<lb n="95"/>wolfart reichen und dienen
<lb n="96"/>mag, zueerwißen, darzue
<lb n="97"/>geneigt und befundt, all
<lb n="98"/>wir Gott bitten, daß
<lb n="99"/>er E. Wht. und U. L. Elt.
<lb n="100"/>hiemit glueckhafft, neiw
<lb n="101"/>friden und fredenrichen jahr
<lb n="102"/>in disn gfarlichen leueffen gnediglich
<lb n="103"/>verlichen und uns samptlich in
<lb n="104"/>sinen gnaden schirm erhalten
<lb n="105"/>welle. Datum
<lb n="106"/><origDate when="1621-02-19" resp="#ner">den 19ten Februarij 1621</origDate>.
<lb n="107"/>An <orgName ref="stadtasg-actors-514" cert="medium" role="recipient" resp="#ner">Schultheiß und Rhat
<lb n="108"/>der Statt Bern</orgName>.
<lb n="109"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und Rhat
<lb n="110"/>der Statt S. Gallen</orgName>.
</p>
