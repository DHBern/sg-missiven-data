    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1151_3745.jpg" n="1"/>
<lb n="1"/>Unnser freündtlich willig dienst, zuvor <unclear cert="low" resp="#joint">ersamen</unclear> unnd <unclear cert="low" resp="#joint">wysenn</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">sonnders</unclear> lieben unnd guotten freündt. Unns zwyffelt nit, unnser
<lb n="3"/>schryben, so wir e. f. wt. vom <date resp="#ner">26 Octobris, des <unclear cert="low" resp="#joint">abgloffnen</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">82</unclear> <unclear cert="low" resp="#joint">jars</unclear></date>, <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">ires</unclear> <unclear cert="low" resp="#joint">burgers</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Schuochmachers</unclear></persName>, unnd
<lb n="5"/><unclear cert="low" resp="#joint">vnnd</unclear> siner <unclear cert="low" resp="#joint">hussfrawen</unclear>, <persName resp="#ner">Barbara <unclear cert="low" resp="#joint">Kuentzin</unclear></persName> <unclear cert="low" resp="#joint">gethon</unclear>, <unclear cert="low" resp="#joint">syg</unclear> <unclear cert="low" resp="#joint">der</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">selben</unclear> durch sy <persName resp="#ner">Kuentzin</persName> vberantwurt worden. Im fall aber
<lb n="7"/><unclear cert="low" resp="#joint">dasselbig</unclear> nit bschehen, haben e. f. wt. dr selben innhalt uß der
<lb n="8"/><unclear cert="low" resp="#joint">byverwarther</unclear> <unclear cert="low" resp="#joint">Coppy</unclear> <unclear cert="low" resp="#joint">zuvernemen</unclear>. <unclear cert="low" resp="#joint">Vber</unclear> <unclear cert="low" resp="#joint">solches</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> das unns
<lb n="9"/>von e. f. wt. <unclear cert="low" resp="#joint">daruff</unclear> <unclear cert="low" resp="#joint">bißher</unclear> <unclear cert="low" resp="#joint">wythers</unclear> <unclear cert="low" resp="#joint">zukomen</unclear>, <unclear cert="low" resp="#joint">könden</unclear> wir der-
<lb n="10"/>selben nit bergen, das <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Schuochmacher</unclear></persName> unnd gedachte
<lb n="11"/>sin <unclear cert="low" resp="#joint">hussfraw</unclear> <persName resp="#ner">Barbara Kuenzin</persName>, an <date resp="#ner">Sannt Stephanns tag</date> her-
<lb n="12"/>hinn wider <unclear cert="low" resp="#joint">abenndts</unclear> <unclear cert="low" resp="#joint">alher</unclear> <unclear cert="low" resp="#joint">komen</unclear> unnd inn die <unclear cert="low" resp="#joint">bheussung</unclear>,
<lb n="13"/>so irem schwager unnd bruoder <persName resp="#ner">Clauß Kuentzen</persName> zughörig, unnd
<lb n="14"/>dr selben geordnetn vogt, uff ein <unclear cert="low" resp="#joint">Jar</unclear> <unclear cert="low" resp="#joint">verlyhen</unclear>, (<unclear cert="low" resp="#joint">darin</unclear> <unclear cert="low" resp="#joint">hanns</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">vorlichen</unclear>) <unclear cert="low" resp="#joint">begert</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> alls der husswürt, ime nit gleich auff-
<lb n="16"/>thon, unnd sich seins thuon wöllen, ist er alsbald, mit grosen Bottß-
<lb n="17"/>lestren, schwuere, unnd fluochen, in die <unclear cert="low" resp="#joint">Thueren</unclear> <unclear cert="low" resp="#joint">gsprungen</unclear>, unnd
<lb n="18"/><unclear cert="low" resp="#joint">dieselbigm</unclear> mit gwalt Eroffnet, sich auch <unclear cert="low" resp="#joint">allerlay</unclear> <unclear cert="low" resp="#joint">Trowworte</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">vernemen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>, unnd nebn anndrem, gsagt, das <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ime</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">vorhalten</unclear>, Nach dem Er <unclear cert="low" resp="#joint">sich</unclear> nun <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">vnnüz</unclear> <unclear cert="low" resp="#joint">gemacht</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">vnnd</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">solchem</unclear> <unclear cert="low" resp="#joint">truzwürcklich</unclear> <unclear cert="low" resp="#joint">ghalten</unclear>, <unclear cert="low" resp="#joint">habn</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ine</unclear> <unclear cert="low" resp="#joint">vengkeng</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">einziehen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">halten</unclear> <unclear cert="low" resp="#joint">ine</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">eben</unclear> <unclear cert="low" resp="#joint">Iren</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">Ringen</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">Custodj</unclear>, <unclear cert="low" resp="#joint">In</unclear> <unclear cert="low" resp="#joint">verwarung</unclear>, <unclear cert="low" resp="#joint">Diewyl</unclear> <unclear cert="low" resp="#joint">wir</unclear> dann e. f. wt. baider
<lb n="24"/>Eegemechit, unnd <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">guets</unclear>, <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">halben</unclear>, wie <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">gelegenhait</unclear>,
<lb n="25"/><unclear cert="low" resp="#joint">darneben</unclear>, an zimlichen gworen bericht gethon, unnd aber dar-
<lb n="26"/>über gar kain bscheid Ervolgt, So haben wir nit <unclear cert="low" resp="#joint">underlassen</unclear>,
<lb n="27"/><unclear cert="low" resp="#joint">könden</unclear>, noch söllen, e. f. wt. <unclear cert="low" resp="#joint">dessen</unclear> <unclear cert="low" resp="#joint">alls</unclear>, unnd wie <unclear cert="low" resp="#joint">Er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">Schuochmacher</unclear></persName>, sich <unclear cert="low" resp="#joint">siderher</unclear>, <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear>-
<lb n="29"/>halten, <unclear cert="low" resp="#joint">zuerinnern</unclear> unnd zubrichten, <unclear cert="low" resp="#joint">Uß</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">vernen</unclear> <unclear cert="low" resp="#joint">an</unclear>-
<lb n="30"/>hang, unnd <unclear cert="low" resp="#joint">Erpietten</unclear>, wann e. f. wt. von <unclear cert="low" resp="#joint">im</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Schuoch</unclear>-
<lb n="31"/>machers</persName> <unclear cert="low" resp="#joint">vnnd</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">hussfrawen</unclear> <unclear cert="low" resp="#joint">wegen</unclear>, <unclear cert="low" resp="#joint">unns</unclear> Caution unnd
<lb n="32"/><unclear cert="low" resp="#joint">Trostung</unclear> <unclear cert="low" resp="#joint">thuon</unclear>, <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">verschrybung</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">versicherung</unclear> geben,
<lb n="33"/>wann Ir der Frawen Bruoder <persName resp="#ner">Clauß Kuentz</persName> oder <unclear cert="low" resp="#joint">kinder</unclear> von
<lb n="34"/><unclear cert="low" resp="#joint">Ime</unclear>, <unclear cert="low" resp="#joint">ald</unclear> <unclear cert="low" resp="#joint">Jemandts</unclear> <unclear cert="low" resp="#joint">anndrer</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Irent</unclear> <unclear cert="low" resp="#joint">wegen</unclear> über khurz, oder
<pb facs="StadtASG_Missive_1151_3746.jpg" n="2"/>
<lb n="35"/>lannge zeyt, zuo lanndt komen, unnd <unclear cert="low" resp="#joint">ierer</unclear> <unclear cert="low" resp="#joint">haab</unclear>, unnd gueeter
<lb n="36"/>begeren wurden, das <unclear cert="low" resp="#joint">alsdann</unclear> E. F. Wt. unß deßwegen, ent-
<lb n="37"/>haeben, unnd schadlos halten, oder <unclear cert="low" resp="#joint">all</unclear> <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">haab</unclear>, unnd gueter wider
<lb n="38"/>keren thuot, unnd <unclear cert="low" resp="#joint">erstatten</unclear>, <unclear cert="low" resp="#joint">so</unclear> woellen wir dem Schuochmacher,
<lb n="39"/>unnd <unclear cert="low" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">haußfrawen</unclear>, <unclear cert="low" resp="#joint">warer</unclear> <unclear cert="low" resp="#joint">ehen</unclear>, das <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">unnser</unclear>
<lb n="40"/>statt brauch, unnd alt hernkomen, alle deß schwehers, unnd
<lb n="41"/><unclear cert="low" resp="#joint">bruoders</unclear> <unclear cert="low" resp="#joint">verlaßenschafft</unclear>, <unclear cert="low" resp="#joint">haab</unclear>, unnd <unclear cert="low" resp="#joint">gueeter</unclear> <unclear cert="low" resp="#joint">zuefallen</unclear> unnd
<lb n="42"/>volgen laßen, doch das sy der zway khinder, <unclear cert="low" resp="#joint">so</unclear> sy <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">vorigen</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">irem</unclear> <unclear cert="low" resp="#joint">haußwirt</unclear> <unclear cert="low" resp="#joint">seligen</unclear> <unclear cert="low" resp="#joint">erzeugt</unclear>, darmit zuo <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">nemen</unclear>, unnd
<lb n="44"/><unclear cert="low" resp="#joint">dannen</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">gepuert</unclear> <unclear cert="low" resp="#joint">auferziehen</unclear>, <unclear cert="low" resp="#joint">auch</unclear> inen den khindern,
<lb n="45"/><unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">sye</unclear> <unclear cert="low" resp="#joint">fueg</unclear>, <unclear cert="low" resp="#joint">nachmals</unclear> <unclear cert="low" resp="#joint">theilhuß</unclear> <unclear cert="low" resp="#joint">zuoerwarten</unclear>, <unclear cert="low" resp="#joint">dauon</unclear> was
<lb n="46"/>verordnen unnd aussetzen. Sollichs haben wir E. F. Wt. zuo
<lb n="47"/><unclear cert="low" resp="#joint">fernerem</unclear> bericht, nit verhalten <unclear cert="low" resp="#joint">sollen</unclear>, sein <unclear cert="low" resp="#joint">daruuf</unclear> <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">zaigern</unclear>,
<lb n="48"/>disem <unclear cert="low" resp="#joint">aignen</unclear>, unnd <unclear cert="low" resp="#joint">allain</unclear> <unclear cert="low" resp="#joint">darumben</unclear> <unclear cert="low" resp="#joint">abgsandten</unclear> botten, was
<lb n="49"/>Sy <unclear cert="low" resp="#joint">hierueber</unclear> <unclear cert="low" resp="#joint">zuthuon</unclear> bedacht, <unclear cert="low" resp="#joint">schrifftlichen</unclear> <unclear cert="low" resp="#joint">beschaids</unclear> <unclear cert="low" resp="#joint">gewarttig</unclear>,
<lb n="50"/><unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">verrer</unclear> darnach zuhalten <unclear cert="low" resp="#joint">haben</unclear>, dann er <unclear cert="medium" resp="#joint">ia</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Schuoch</unclear>-
<lb n="51"/><unclear cert="low" resp="#joint">macher</unclear>, <unclear cert="low" resp="#joint">biß</unclear> wir von E. F. <unclear cert="low" resp="#joint">Wt</unclear>. aller <unclear cert="low" resp="#joint">sachen</unclear> <unclear cert="low" resp="#joint">grundtlichen</unclear> bericht,
<lb n="52"/>unnd beschaid erlanngen, deßen verkhueung nit <unclear cert="low" resp="#joint">entlediget</unclear>. Datum
<lb n="53"/>den <origDate when="1583-01-02" cert="medium" resp="#ner">2 <unclear cert="low" resp="#joint">Januarii</unclear> anno 83</origDate>.
<lb n="54"/><orgName ref="stadtasg-actors-58" cert="medium" role="issuer" resp="#ner">Burgermaister, unnd rath,
<lb n="55"/>der Statt <unclear cert="low" resp="#joint">Rauenpurg</unclear></orgName>.
<pb facs="StadtASG_Missive_1151_3747.jpg" n="3"/>
<pb facs="StadtASG_Missive_1151_3748.jpg" n="4"/>
<lb n="56"/>Den ersamen, unnd <unclear cert="medium" resp="#joint">weisen</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister,
<lb n="57"/>unnd <unclear cert="low" resp="#joint">Rathe</unclear>, der Statt Sannt Gallen</orgName>, <unclear cert="medium" resp="#joint">unnsern</unclear>
<lb n="58"/>sonders lieben unnd <unclear cert="medium" resp="#joint">guotten</unclear> <unclear cert="medium" resp="#joint">freündten</unclear>.
<lb n="59"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Sant</unclear> Gallen</placeName>.
</p>
