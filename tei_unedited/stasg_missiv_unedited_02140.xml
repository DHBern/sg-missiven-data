    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2140_8019.jpg" n="1"/>
<lb n="1"/>Unnser fründt: nachparlich und guot-
<lb n="2"/>willige dienst zuvor, Fürsichtige
<lb n="3"/>Ersame weiße, besonders liebe fründ
<lb n="4"/>und guotte Nachparn.
<lb n="5"/>Demnach <unclear cert="low" resp="#joint">unnser</unclear> lieber MitRaths-
<lb n="6"/>fründt <persName resp="#ner">Bernhardt Schmalz</persName>, auß
<lb n="7"/>unnserm beuelch, durch <unclear cert="low" resp="#joint">mittel</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">ewers</unclear> <unclear cert="low" resp="#joint">burgers</unclear> <persName resp="#ner">Lorenz Kestelln</persName>,
<lb n="9"/>einer anzahl pulfers halber
<lb n="10"/>disselben für gemeine Stat alhie
<lb n="11"/>zegebrauchn, mit auch ewerem
<lb n="12"/>burger <persName resp="#ner">Cirill Zimberling</persName> handln
<lb n="13"/>lassen, werden wir an <unclear cert="low" resp="#joint">jezo</unclear> <unclear cert="low" resp="#joint">bericht</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">bemeltn</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Cirillo</unclear></persName> von oberkhait
<lb n="15"/>wegn nidergelegt, derzeit khein
<lb n="16"/>pulfer mehr auß ewerer Stat
<lb n="17"/>zuverschikhn,
<lb n="18"/>Ob dan nun wir nit <unclear cert="low" resp="#joint">gemeint</unclear>, <unclear cert="low" resp="#joint">ewe</unclear>-
<lb n="19"/><unclear cert="low" resp="#joint">ren</unclear> <unclear cert="low" resp="#joint">angehörign</unclear>, <unclear cert="low" resp="#joint">Irem</unclear> <unclear cert="low" resp="#joint">empfangnen</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">oberkhaitlichn</unclear> <unclear cert="low" resp="#joint">befelch</unclear>, <unclear cert="low" resp="#joint">wideriges</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zuezemuetn</unclear>.
<lb n="22"/><origPlace ref="stadtasg-places-7" cert="medium" resp="#ner">Costantz</origPlace> <unclear cert="low" resp="#joint">vberg</unclear> <unclear cert="low" resp="#joint">Bulyfr</unclear>.
<pb facs="StadtASG_Missive_2140_8020.jpg" n="2"/>
<lb n="23"/><unclear cert="low" resp="#joint">Seitemahlen</unclear> aber <unclear cert="medium" resp="#joint">bemelter</unclear> <unclear cert="medium" resp="#joint">Cirill</unclear>
<lb n="24"/>25. centner <unclear cert="medium" resp="#joint">pulfers</unclear> <unclear cert="medium" resp="#joint">vergwißt</unclear>, wo
<lb n="25"/><unclear cert="medium" resp="#joint">mueglich</unclear> <unclear cert="medium" resp="#joint">biß</unclear> in 30. centner <unclear cert="low" resp="#joint">Loren</unclear>-
<lb n="26"/><unclear cert="low" resp="#joint">zen</unclear> <unclear cert="low" resp="#joint">Zschellen</unclear> <unclear cert="low" resp="#joint">einzehendig</unclear> <unclear cert="low" resp="#joint">alberaith</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">versprochen</unclear>, <unclear cert="low" resp="#joint">wir</unclear> auch <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">deßhalb</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">unfelbarlich</unclear> <unclear cert="low" resp="#joint">darauff</unclear> <unclear cert="low" resp="#joint">verlassen</unclear>.
<lb n="29"/><unclear cert="low" resp="#joint">Alß</unclear> habend wir <unclear cert="medium" resp="#joint">khainen</unclear> umbgang
<lb n="30"/><unclear cert="medium" resp="#joint">nemen</unclear> <unclear cert="medium" resp="#joint">khuenen</unclear>, <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">diß</unclear>, <unclear cert="medium" resp="#joint">besagts</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">Cirillen</unclear>, <unclear cert="medium" resp="#joint">vor</unclear> euwerm <unclear cert="medium" resp="#joint">verbot</unclear>,
<lb n="32"/><unclear cert="medium" resp="#joint">gethonen</unclear> <unclear cert="medium" resp="#joint">versprechens</unclear>, <unclear cert="medium" resp="#joint">freündt</unclear>-
<lb n="33"/>nachparlich <unclear cert="low" resp="#joint">zeerinneren</unclear>.
<lb n="34"/>Mit <unclear cert="medium" resp="#joint">freündt</unclear>: nachparlicher pit,
<lb n="35"/>Ir wollen <unclear cert="low" resp="#joint">offt</unclear> <unclear cert="low" resp="#joint">ernanten</unclear> <unclear cert="low" resp="#joint">Inne</unclear> <unclear cert="low" resp="#joint">Cirillen</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">gestatten</unclear>, das Er <unclear cert="medium" resp="#joint">selb</unclear> <unclear cert="medium" resp="#joint">seinem</unclear> zue-
<lb n="37"/>sag satisfaction <unclear cert="medium" resp="#joint">thuen</unclear>, <unclear cert="medium" resp="#joint">obangedeüte</unclear>
<lb n="38"/>anzahl <unclear cert="medium" resp="#joint">pulfers</unclear> <unclear cert="medium" resp="#joint">vöellig</unclear> von gedach-
<lb n="39"/>tem <unclear cert="medium" resp="#joint">Zschellen</unclear> erheben und <unclear cert="low" resp="#joint">her</unclear> <unclear cert="low" resp="#joint">verord</unclear>-
<lb n="40"/><unclear cert="low" resp="#joint">neten</unclear> <unclear cert="low" resp="#joint">möeg</unclear>.
<lb n="41"/><unclear cert="low" resp="#joint">Darmit</unclear> <unclear cert="low" resp="#joint">erweisen</unclear> Ir <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">son</unclear>-
<lb n="42"/><unclear cert="medium" resp="#joint">dere</unclear> <unclear cert="medium" resp="#joint">nachparschafft</unclear>, <unclear cert="medium" resp="#joint">weliche</unclear>
<pb facs="StadtASG_Missive_2140_8021.jpg" n="3"/>
<lb n="43"/><unclear cert="medium" resp="#joint">wir</unclear> umb Eüch <unclear cert="low" resp="#joint">freündt</unclear> <unclear cert="low" resp="#joint">nachpar</unclear>-
<lb n="44"/>lichen <unclear cert="medium" resp="#joint">zeerwidern</unclear>, <unclear cert="medium" resp="#joint">vorders</unclear>
<lb n="45"/><unclear cert="medium" resp="#joint">berait</unclear> unnd willig sind.
<lb n="46"/>Actum den <origDate when="1619-08-29" resp="#ner">29. <unclear cert="medium" resp="#joint">Augst</unclear>. <unclear cert="medium" resp="#joint">Ao</unclear>. 1619</origDate>.
<lb n="47"/>Verwalter der <unclear cert="medium" resp="#joint">Haubtman</unclear>-
<lb n="48"/>schafft, <orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> und
<lb n="49"/>Rath der Statt <unclear cert="medium" resp="#joint">Costantz</unclear></orgName>.
<pb facs="StadtASG_Missive_2140_8022.jpg" n="4"/>
<lb n="50"/><unclear cert="medium" resp="#joint">Den</unclear> fürsichtigen ersamen unnd weysen
<lb n="51"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister unnd <unclear cert="medium" resp="#joint">Rhat</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">S</unclear>. Gallen</orgName>,
<lb n="52"/><unclear cert="medium" resp="#joint">unnseren</unclear> <unclear cert="medium" resp="#joint">besonders</unclear> lieben <unclear cert="medium" resp="#joint">und</unclear> guotten
<lb n="53"/><unclear cert="low" resp="#joint">freünden</unclear> <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">Nachparn</unclear>.
<lb n="55"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
