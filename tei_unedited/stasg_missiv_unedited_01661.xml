    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1661_6055.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unnser</unclear> <unclear cert="medium" resp="#joint">fründtlich</unclear> willig <unclear cert="medium" resp="#joint">diennst</unclear> <unclear cert="medium" resp="#joint">zuovor</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">Eernveste</unclear>, <unclear cert="medium" resp="#joint">fürsichtige</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">weise</unclear>, <unclear cert="medium" resp="#joint">besonnders</unclear>
<lb n="3"/>liebe herrn, unnd <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="medium" resp="#joint">fründt</unclear>,
<lb n="4"/>Nachdem wir <unclear cert="medium" resp="#joint">unnserm</unclear> <unclear cert="medium" resp="#joint">beywohner</unclear> herrn
<lb n="5"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Gabriel</unclear> Zollikhofern</persName> uff sein <unclear cert="medium" resp="#joint">ernstlich</unclear>
<lb n="6"/>bitt <unclear cert="medium" resp="#joint">unnd</unclear> anlangen <unclear cert="medium" resp="#joint">verwilliget</unclear> <unclear cert="medium" resp="#joint">unnsern</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">stattschreibern</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Mattheum</unclear> <unclear cert="medium" resp="#joint">Schwanzer</unclear></persName>,
<lb n="8"/><unclear cert="medium" resp="#joint">zuo</unclear> liquidation <unclear cert="medium" resp="#joint">unnd</unclear> erledigung etlicher, sein-
<lb n="9"/><unclear cert="low" resp="#joint">er</unclear> mit herrn <persName resp="#ner">Joachim</persName> <unclear cert="medium" resp="#joint">unnd</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Jacoben</unclear></persName> den
<lb n="10"/>Zollikhofern <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">mitverwanndten</unclear>, <unclear cert="low" resp="#joint">schweb</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">freünd</unclear>: <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="12"/><unclear cert="low" resp="#joint">enhafter</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">ender</unclear> <unclear cert="low" resp="#joint">Irrungen</unclear>, <unclear cert="low" resp="#joint">zuo</unclear> einem <unclear cert="medium" resp="#joint">beystannd</unclear> <unclear cert="medium" resp="#joint">zuo</unclear>-
<lb n="14"/>gebrauchen,
<lb n="15"/>So gelangt an E. E. F. Wt. <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">vleißig</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">fründtlich</unclear> bitt, <unclear cert="medium" resp="#joint">die</unclear> <unclear cert="medium" resp="#joint">geruochen</unclear>, <unclear cert="medium" resp="#joint">nicht</unclear> allein
<lb n="17"/><unclear cert="medium" resp="#joint">gedachtem</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Gabriel</unclear> Zollikhofern</persName> <unclear cert="medium" resp="#joint">zuo</unclear> der
<lb n="18"/><unclear cert="medium" resp="#joint">gleichmeßigen</unclear> <unclear cert="medium" resp="#joint">billichheit</unclear> (<unclear cert="medium" resp="#joint">Inmaßen</unclear> dieselbe,
<lb n="19"/>ohne <unclear cert="medium" resp="#joint">zweiffel</unclear> <unclear cert="medium" resp="#joint">für</unclear> sich <unclear cert="medium" resp="#joint">selbsten</unclear>, dahin ge-
<lb n="20"/>naigt sein <unclear cert="medium" resp="#joint">werdet</unclear>) <unclear cert="medium" resp="#joint">günstig</unclear> <unclear cert="medium" resp="#joint">beholffen</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">zuosein</unclear>, <unclear cert="medium" resp="#joint">Sonndern</unclear> auch die sachen, <unclear cert="medium" resp="#joint">dermaßen</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">zuobefürdern</unclear>, damit <unclear cert="medium" resp="#joint">berüerter</unclear> <unclear cert="medium" resp="#joint">unnser</unclear>
<lb n="23"/>stattschreiber, <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">unvermeidenlicher</unclear>
<lb n="24"/><unclear cert="medium" resp="#joint">schleüniger</unclear> expedition, vorstehender ge-
<lb n="25"/><unclear cert="medium" resp="#joint">mainer</unclear> <unclear cert="medium" resp="#joint">unnser</unclear> statt geschefften, nicht <unclear cert="medium" resp="#joint">uff</unclear>-
<lb n="26"/>gehalten, <unclear cert="medium" resp="#joint">sonder</unclear> sich mit <unclear cert="medium" resp="#joint">erstem</unclear> widerumb
<lb n="27"/><unclear cert="medium" resp="#joint">anhaimbs</unclear> <unclear cert="medium" resp="#joint">verfüegen</unclear> <unclear cert="medium" resp="#joint">möge</unclear>,
<lb n="28"/>Das seind umb E. E. F. Wt. wir, <unclear cert="medium" resp="#joint">uff</unclear> <unclear cert="medium" resp="#joint">für</unclear>-
<lb n="29"/>fallende <unclear cert="medium" resp="#joint">gelegenhait</unclear>, <unclear cert="medium" resp="#joint">guotwillig</unclear> <unclear cert="medium" resp="#joint">zuover</unclear>-
<lb n="30"/>dienen, denselben auch ohne das ange-
<lb n="31"/><unclear cert="medium" resp="#joint">neme</unclear> <unclear cert="medium" resp="#joint">fründtliche</unclear> <unclear cert="medium" resp="#joint">diennst</unclear>, <unclear cert="medium" resp="#joint">zuoerzaigen</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">vorderst</unclear> berait, <unclear cert="medium" resp="#joint">erbietig</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> willig,
<lb n="33"/>Datum den <origDate when="1609-11-20" resp="#ner">10./20. Novembris <unclear cert="medium" resp="#joint">a°</unclear> 1609</origDate>.
<lb n="34"/><orgName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> und
<lb n="35"/>Rhat <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">Leütkirch</unclear></orgName>.
<pb facs="StadtASG_Missive_1661_6056.jpg" n="2"/>
<pb facs="StadtASG_Missive_1661_6057.jpg" n="3"/>
<lb n="36"/>[]
<pb facs="StadtASG_Missive_1661_6058.jpg" n="4"/>
<lb n="37"/>Den <unclear cert="low" resp="#joint">frommen</unclear>, fürsichtigen und weisen,
<lb n="38"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Bürgermaister</unclear> und <unclear cert="low" resp="#joint">Rhat</unclear> der Statt Sanct
<lb n="39"/>Gallen</orgName>, unsern besondern lieben herrn und
<lb n="40"/>gueten <unclear cert="low" resp="#joint">freünden</unclear>,
</p>
