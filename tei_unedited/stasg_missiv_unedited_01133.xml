<lb n="11"/><unclear cert="medium" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">zueerkhennen</unclear>, das <unclear cert="low" resp="#joint">wir</unclear>, oder die <unclear cert="low" resp="#joint">unnseren</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">gedachtem</unclear> <unclear cert="low" resp="#joint">Ewerem</unclear> Burger, unnd <unclear cert="low" resp="#joint">seinen</unclear> <unclear cert="low" resp="#joint">verordnet</unclear>-
<lb n="13"/>en <unclear cert="low" resp="#joint">Anwäldten</unclear>, <unclear cert="low" resp="#joint">seiner</unclear> habenden <unclear cert="low" resp="#joint">Ansprach</unclear>, unnd
<lb n="14"/><unclear cert="medium" resp="#joint">vorderung</unclear>, das <unclear cert="medium" resp="#joint">gepüerendt</unclear> Recht nie verzig-
<lb n="15"/><unclear cert="medium" resp="#joint">en</unclear>, <unclear cert="medium" resp="#joint">Diewÿl</unclear> unnd aber <unclear cert="medium" resp="#joint">Er</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Nazarius</unclear> <unclear cert="medium" resp="#joint">Jäckhen</unclear></persName>
<lb n="16"/><unclear cert="medium" resp="#joint">Ansprachen</unclear>, So Er gegen ettlichen der <unclear cert="low" resp="#joint">unnsern</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">zuehaben</unclear> vermaint, <unclear cert="low" resp="#joint">dergestalt</unclear> <unclear cert="low" resp="#joint">geschaffen</unclear>,
<lb n="18"/>das <unclear cert="medium" resp="#joint">dieselben</unclear> sich <unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">beschwerden</unclear>, <unclear cert="low" resp="#joint">hetten</unclear> wir
<lb n="19"/>unns versehen, Er were <unclear cert="low" resp="#joint">selbsten</unclear> hieher <unclear cert="low" resp="#joint">komen</unclear>,
<lb n="20"/>und sich mit denselben <unclear cert="low" resp="#joint">freundtlich</unclear> verglichen,
<lb n="21"/>Unnd <unclear cert="medium" resp="#joint">abgereidt</unclear>, So dann <unclear cert="medium" resp="#joint">unnsere</unclear> Burger,
<lb n="22"/><unclear cert="low" resp="#joint">Jme</unclear> <unclear cert="medium" resp="#joint">bÿ</unclear> ordennlicher <unclear cert="low" resp="#joint">Raitung</unclear>, was schuldig
