<lb n="61"/><unclear cert="low" resp="#joint">ennlich</unclear> <unclear cert="low" resp="#joint">widerfaren</unclear>, Das habenn wir E. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">Wht</unclear>.
