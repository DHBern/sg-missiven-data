<lb n="45"/><unclear cert="low" resp="#joint">abgewesen</unclear>, <unclear cert="low" resp="#joint">Allain</unclear> <unclear cert="low" resp="#joint">erwannglet</unclear>, das der guet <unclear cert="low" resp="#joint">arm</unclear>
