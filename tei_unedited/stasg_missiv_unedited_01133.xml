<lb n="34"/>mit den <unclear cert="medium" resp="#joint">unnsern</unclear>, <unclear cert="medium" resp="#joint">sölliches</unclear> seiner <unclear cert="low" resp="#joint">sach</unclear> <unclear cert="low" resp="#joint">sachen</unclear>,
