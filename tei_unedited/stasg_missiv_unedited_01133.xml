<lb n="36"/>richt <unclear cert="medium" resp="#joint">verneme</unclear>, Wa er dann by <unclear cert="medium" resp="#joint">innen</unclear> <unclear cert="medium" resp="#joint">des</unclear> <unclear cert="medium" resp="#joint">meinen</unclear>,
