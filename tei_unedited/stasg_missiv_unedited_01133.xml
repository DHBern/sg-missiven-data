<lb n="33"/><unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">gelegnen</unclear> tag, <unclear cert="medium" resp="#joint">zue</unclear> unns <unclear cert="medium" resp="#joint">hieher</unclear> verfuege,
