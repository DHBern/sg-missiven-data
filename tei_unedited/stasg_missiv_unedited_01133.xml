<lb n="48"/><unclear cert="low" resp="#joint">gwalthaber</unclear>, <unclear cert="low" resp="#joint">ainen</unclear> so <unclear cert="low" resp="#joint">gaeßsen</unclear> <unclear cert="low" resp="#joint">unmeßigen</unclear>
