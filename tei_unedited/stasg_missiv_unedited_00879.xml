<p>
<pb facs="StadtASG_Missive_879_2493.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">früntdlich</unclear> willig <unclear cert="medium" resp="#joint">diennst</unclear>. <unclear cert="low" resp="#joint">Sampt</unclear> was
<lb n="2"/>wir eerenn, <unclear cert="medium" resp="#joint">liebs</unclear>, unnd <unclear cert="medium" resp="#joint">guots</unclear> <unclear cert="medium" resp="#joint">vermoegendt</unclear> zuo-
<lb n="3"/><unclear cert="medium" resp="#joint">vor</unclear> <unclear cert="medium" resp="#joint">from</unclear> fürsichtig, ersam unnd wyß,
<lb n="4"/>innsonnders <unclear cert="medium" resp="#joint">guoten</unclear> fründ, unnd <unclear cert="low" resp="#joint">getrüwen</unclear>
<lb n="5"/>lieben <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner">Eydgnossen</orgName>. Der <unclear cert="medium" resp="#joint">unn</unclear>-
<lb n="6"/><unclear cert="medium" resp="#joint">ser</unclear> <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Wordmüller</unclear></persName>, so ein <unclear cert="low" resp="#joint">huoffschmid</unclear>
<lb n="7"/>ist <unclear cert="medium" resp="#joint">vor</unclear> unns erschinen, unnd angezeigt.
<lb n="8"/><unclear cert="low" resp="#joint">Nach</unclear> <unclear cert="medium" resp="#joint">dem</unclear> er <unclear cert="low" resp="#joint">kurtzverruckter</unclear> <unclear cert="low" resp="#joint">zyt</unclear>, inn <unclear cert="medium" resp="#joint">üwer</unclear>
<lb n="9"/>statt, <unclear cert="medium" resp="#joint">alls</unclear> er <unclear cert="medium" resp="#joint">daselbs</unclear> <unclear cert="medium" resp="#joint">gedienet</unclear>, einen fraeffel
<lb n="10"/><unclear cert="medium" resp="#joint">beganngen</unclear>, <unclear cert="medium" resp="#joint">Were</unclear> er von üch
<lb n="11"/><unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">glüpt</unclear> <unclear cert="medium" resp="#joint">genomen</unclear>, das recht <unclear cert="low" resp="#joint">deßhalben</unclear>
<lb n="12"/>vor üch <unclear cert="low" resp="#joint">zuoverthretten</unclear>. unnd <unclear cert="low" resp="#joint">Werdar</unclear>
<lb n="13"/>zwüschent, <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">synes</unclear> <unclear cert="low" resp="#joint">bessern</unclear> <unclear cert="low" resp="#joint">nutzes</unclear>, unnd
<lb n="14"/><unclear cert="medium" resp="#joint">nottürfft</unclear> willen, gen <placeName ref="stadtasg-places-68" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Stein</unclear> an Rhyn</placeName> zogen
<lb n="15"/><unclear cert="low" resp="#joint">Unndwiewol</unclear> er mit synem meyster, by dem
<lb n="16"/>er <unclear cert="medium" resp="#joint">inn</unclear> üwer statt <unclear cert="medium" resp="#joint">gedienet</unclear>, <unclear cert="low" resp="#joint">heiter</unclear> abgeredt,
<lb n="17"/><unclear cert="low" resp="#joint">Sover</unclear> <unclear cert="low" resp="#joint">synethalben</unclear>, ein rechtlichen <unclear cert="low" resp="#joint">tagn</unclear> von
<lb n="18"/>üch <unclear cert="medium" resp="#joint">angesetzt</unclear> wurde. <unclear cert="low" resp="#joint">Sollte</unclear> er <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">densel</unclear>-
<lb n="19"/>bigen, by <unclear cert="medium" resp="#joint">guoter</unclear> zyt <unclear cert="low" resp="#joint">verkundigen</unclear>, damit
<lb n="20"/>er synem <unclear cert="medium" resp="#joint">versprächen</unclear> <unclear cert="medium" resp="#joint">destgehorsamlicher</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">stat</unclear> <unclear cert="medium" resp="#joint">thuon</unclear> <unclear cert="medium" resp="#joint">moechte</unclear> So <unclear cert="low" resp="#joint">syge</unclear> <unclear cert="medium" resp="#joint">doch</unclear>
<lb n="22"/>sollichs von <unclear cert="medium" resp="#joint">im</unclear> nit <unclear cert="medium" resp="#joint">beschehen</unclear>, <unclear cert="medium" resp="#joint">Sonnders</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">wurde</unclear> <unclear cert="medium" resp="#joint">im</unclear> von üch, <unclear cert="medium" resp="#joint">alls</unclear> ob er syn <unclear cert="low" resp="#joint">gethan</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">glübd</unclear> <unclear cert="medium" resp="#joint">fraeffenlich</unclear> <unclear cert="low" resp="#joint">uberganngen</unclear>, unnd des
<lb n="25"/><unclear cert="low" resp="#joint">rechten</unclear>, <unclear cert="low" resp="#joint">vor</unclear> üch nit <unclear cert="low" resp="#joint">erwarten</unclear> <unclear cert="low" resp="#joint">wollte</unclear>, <unclear cert="low" resp="#joint">uff</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">hirnäbent</unclear>, ein angesetzter tag zuogeschriben
<lb n="27"/>unnd <unclear cert="medium" resp="#joint">benempt</unclear>. Diewyl <unclear cert="medium" resp="#joint">im</unclear>
<lb n="28"/>aber der <unclear cert="medium" resp="#joint">selbig</unclear>, etlicher <unclear cert="low" resp="#joint">eehafften</unclear> ursach
<lb n="29"/>halber, <unclear cert="low" resp="#joint">zuobesuochen</unclear> nit <unclear cert="low" resp="#joint">moglich</unclear> gewessen,
<lb n="30"/><unclear cert="medium" resp="#joint">Bette</unclear> er unns <unclear cert="medium" resp="#joint">ganntz</unclear> <unclear cert="low" resp="#joint">thrüngenlich</unclear>, <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">wellten</unclear>
<lb n="31"/>üch <unclear cert="low" resp="#joint">desselbigen</unclear> schrifftlichen berichten. <unclear cert="low" resp="#joint">Guoter</unclear>
<pb facs="StadtASG_Missive_879_2494.jpg" n="2"/>
<lb n="32"/>hoffnung dardurch <unclear cert="low" resp="#joint">souil</unclear> <unclear cert="low" resp="#joint">zuoerlanngen</unclear>, das im
<lb n="33"/>soellich <unclear cert="low" resp="#joint">ußblyben</unclear> zuo <unclear cert="low" resp="#joint">dheinem</unclear> nachtheil, ald
<lb n="34"/>schaden <unclear cert="low" resp="#joint">reychen</unclear> <unclear cert="low" resp="#joint">soellte</unclear>. Unnd wann nun
<lb n="35"/>wir im <unclear cert="medium" resp="#joint">diß</unclear> <unclear cert="medium" resp="#joint">syn</unclear> <unclear cert="low" resp="#joint">begaeren</unclear>, der <unclear cert="low" resp="#joint">billicheit</unclear> nach
<lb n="36"/>nit abschlachen <unclear cert="low" resp="#joint">kuennen</unclear>, so <unclear cert="low" resp="#joint">langt</unclear>
<lb n="37"/>an üch <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">ganntz</unclear> fründtlich pit, ir
<lb n="38"/><unclear cert="medium" resp="#joint">wellind</unclear>, ab <unclear cert="medium" resp="#joint">soellichem</unclear> <unclear cert="medium" resp="#joint">synem</unclear> <unclear cert="low" resp="#joint">ußblyben</unclear>, <unclear cert="low" resp="#joint">so</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">dheiner</unclear> <unclear cert="medium" resp="#joint">gefarlicher</unclear>, ald verachtlicher wyß
<lb n="40"/><unclear cert="low" resp="#joint">beschechen</unclear>, dhein mißfallen, noch <unclear cert="low" resp="#joint">inne</unclear> mit der
<lb n="41"/><unclear cert="low" resp="#joint">verwürckten</unclear> straff deß <unclear cert="low" resp="#joint">ruoher</unclear> haben, sonnders
<lb n="42"/>sich so <unclear cert="low" resp="#joint">guetig</unclear> gegen im erzeigen, das er unns
<lb n="43"/><unclear cert="low" resp="#joint">ruemen</unclear> moege, <unclear cert="medium" resp="#joint">diser</unclear> <unclear cert="medium" resp="#joint">unnser</unclear> fürschrifft, ime
<lb n="44"/>zuoguotem erschossen <unclear cert="low" resp="#joint">syge</unclear>. Das <unclear cert="medium" resp="#joint">wellen</unclear>
<lb n="45"/>wir umb <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">ganntz</unclear> fründtlich beschulden.
