<p>
<pb facs="StadtASG_Missive_2292_8735.jpg" n="1"/>
<lb n="1"/>Edle frome, <unclear cert="low" resp="#joint">eerenuseste</unclear>, fuersichtige, <unclear cert="low" resp="#joint">ersame</unclear> und <unclear cert="medium" resp="#joint">weise</unclear>,
<lb n="2"/>insonders <unclear cert="low" resp="#joint">ehrende</unclear> <unclear cert="low" resp="#joint">guenstige</unclear> herren und <unclear cert="low" resp="#joint">nachparrn</unclear>,
<lb n="3"/>den herren <unclear cert="low" resp="#joint">sijen</unclear> unser <unclear cert="low" resp="#joint">freindnachparliche</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="4"/>gantz <unclear cert="low" resp="#joint">bereitwillige</unclear> dienst <unclear cert="low" resp="#joint">beuor</unclear>.
<lb n="5"/>Unnd demnach <unclear cert="medium" resp="#joint">alß</unclear> dann uun <persName resp="#ner">Elspeeta Thumen</persName>,
<lb n="6"/>unsere burgeren, nach ableiben frauen <persName resp="#ner">Anna Schri=
<lb n="7"/><unclear cert="low" resp="#joint">eiberen</unclear></persName>, <unclear cert="low" resp="#joint">wilundt</unclear> herren seckelmeister <persName resp="#ner">Hanssel=
<lb n="8"/>tzen</persName> saligen haußfrauen, alß irer großmuetter,
<lb n="9"/>herren <persName resp="#ner"><unclear cert="low" resp="#joint">Hainrichen</unclear> <unclear cert="low" resp="#joint">Riedman</unclear></persName> unserem burger,
<lb n="10"/><unclear cert="low" resp="#joint">irenn</unclear> <unclear cert="low" resp="#joint">uerordneten</unclear> vogt, uon irem <unclear cert="low" resp="#joint">großuatter</unclear>
<lb n="11"/>unnd <unclear cert="low" resp="#joint">freiundtschafft</unclear>, in sein <unclear cert="low" resp="#joint">haußhaldung</unclear> <unclear cert="low" resp="#joint">ueber=</unclear>
<lb n="12"/>geben unnd <unclear cert="low" resp="#joint">befolhen</unclear> worden, <unclear cert="low" resp="#joint">bej</unclear> <unclear cert="medium" resp="#joint">welichem</unclear> <unclear cert="low" resp="#joint">sij</unclear>
<lb n="13"/>ein <unclear cert="medium" resp="#joint">zeitlang</unclear> <unclear cert="low" resp="#joint">uerbliben</unclear> und <unclear cert="medium" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">bej</unclear> wenig <unclear cert="low" resp="#joint">uer=</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">ruigner</unclear> tagen, <unclear cert="medium" resp="#joint">ermelte</unclear> sein <unclear cert="medium" resp="#joint">vogtdochter</unclear>, sich <unclear cert="low" resp="#joint">ime</unclear>
<lb n="15"/><unclear cert="medium" resp="#joint">und</unclear> seiner <unclear cert="medium" resp="#joint">haußfrouen</unclear> <unclear cert="medium" resp="#joint">on</unclear> <unclear cert="low" resp="#joint">wueßend</unclear> <unclear cert="medium" resp="#joint">uon</unclear> alhie
<lb n="16"/>(uß muetmaßung durch <unclear cert="low" resp="#joint">anstifftung</unclear>) <unclear cert="medium" resp="#joint">hin=</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">weg</unclear> <unclear cert="medium" resp="#joint">begeben</unclear>, <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">bej</unclear> herren <persName resp="#ner"><unclear cert="low" resp="#joint">Darius</unclear> <unclear cert="low" resp="#joint">Jägkann</unclear></persName>
<lb n="18"/><unclear cert="low" resp="#joint">saligen</unclear> hinderlaßnen <unclear cert="low" resp="#joint">haußfrouen</unclear>, irer frow
<lb n="19"/><unclear cert="low" resp="#joint">baßen</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Santgallen</placeName> <unclear cert="medium" resp="#joint">ingestelt</unclear>, und alda ufge=
<lb n="20"/>halten <unclear cert="medium" resp="#joint">worden</unclear>, <unclear cert="medium" resp="#joint">deßwegen</unclear> <unclear cert="low" resp="#joint">sij</unclear> der <unclear cert="medium" resp="#joint">vogt</unclear> uon ober=
<lb n="21"/><unclear cert="low" resp="#joint">kait</unclear> wegen, und <unclear cert="medium" resp="#joint">uf</unclear> begeren <unclear cert="low" resp="#joint">ir</unclear> der <unclear cert="low" resp="#joint">tochter</unclear> groß=
<lb n="22"/><unclear cert="low" resp="#joint">uatter</unclear> und <unclear cert="low" resp="#joint">freiundtschaft</unclear>, durch ein schreiben <unclear cert="medium" resp="#joint">an</unclear>
<lb n="23"/><unclear cert="medium" resp="#joint">herren</unclear> burgermaister <persName resp="#ner"><unclear cert="low" resp="#joint">Hueber</unclear></persName> abgangen, und
<lb n="24"/>hernach auch durch unseren <unclear cert="low" resp="#joint">stattschreiber</unclear>, be=
<lb n="25"/><unclear cert="low" resp="#joint">felch</unclear> <unclear cert="low" resp="#joint">gegebner</unclear> maßen, daß si sich widerumb
<lb n="26"/>allhie instelle, erforderen laßen, und <unclear cert="low" resp="#joint">daß</unclear> uer=
<lb n="27"/><unclear cert="low" resp="#joint">sehens</unclear>, si uon irer frow baßen lenger nit uf=
<lb n="28"/>gehalten wurde, weliches biß anhero <unclear cert="low" resp="#joint">aber</unclear> (<unclear cert="low" resp="#joint">uber</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">uerstroegung</unclear> daß <unclear cert="low" resp="#joint">irer</unclear> obliegenden <unclear cert="low" resp="#joint">furgewendte</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">beschwerden</unclear> halben, <unclear cert="low" resp="#joint">gebuerliche</unclear> beschirmung wider=
<lb n="31"/>faren <unclear cert="low" resp="#joint">soelle</unclear>) nit <unclear cert="medium" resp="#joint">stat</unclear> <unclear cert="medium" resp="#joint">geben</unclear> moegen, und <unclear cert="medium" resp="#joint">alß</unclear> hier=
<lb n="32"/>durch irer ungehorsame <unclear cert="low" resp="#joint">uerspuerend</unclear>, haben
<lb n="33"/>deßwegen nit <unclear cert="low" resp="#joint">umbgehen</unclear> wellen, die herren
<pb facs="StadtASG_Missive_2292_8736.jpg" n="2"/>
<lb n="34"/>mit disem <unclear cert="low" resp="#joint">schreyben</unclear>, euch <unclear cert="low" resp="#joint">zeersuochen</unclear>, hiemit dienst-
<lb n="35"/>freünd- <unclear cert="medium" resp="#joint">und</unclear> nachparlich pittend, von <unclear cert="low" resp="#joint">oberkaidt</unclear>
<lb n="36"/>wegen <unclear cert="low" resp="#joint">zueverschaffen</unclear>, <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">zebefelhen</unclear>, daß ge-
<lb n="37"/>dachte <persName resp="#ner"><unclear cert="low" resp="#joint">Lisbeta</unclear> <unclear cert="low" resp="#joint">Wecrin</unclear></persName>, <unclear cert="low" resp="#joint">unsere</unclear> burgerin, von <unclear cert="low" resp="#joint">irer</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">großbaßen</unclear>, nit alß wider <unclear cert="low" resp="#joint">unseren</unclear>, auch <unclear cert="low" resp="#joint">ires</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">großvatters</unclear>, und <unclear cert="low" resp="#joint">befreünden</unclear> willen, verrers
<lb n="40"/>ufgehalten, sonder ufs lengst innerthalb. 8. oder
<lb n="41"/>10. tagen <unclear cert="low" resp="#joint">derhalben</unclear> wider <unclear cert="low" resp="#joint">alhero</unclear> <unclear cert="low" resp="#joint">gschaft</unclear> <unclear cert="medium" resp="#joint">werde</unclear>,
<lb n="42"/>und so <unclear cert="low" resp="#joint">irer</unclear>, <unclear cert="low" resp="#joint">ihro</unclear> sich <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">irem</unclear> vogt <unclear cert="low" resp="#joint">einzestellen</unclear>
<lb n="43"/>nit belieben <unclear cert="low" resp="#joint">wurde</unclear>, <unclear cert="low" resp="#joint">solle</unclear> <unclear cert="low" resp="#joint">ihro</unclear> <unclear cert="medium" resp="#joint">sonsten</unclear> ein
<lb n="44"/><unclear cert="low" resp="#joint">angeneeme</unclear> <unclear cert="medium" resp="#joint">bequeme</unclear> <unclear cert="medium" resp="#joint">gelegenheit</unclear> gewißen, und
<lb n="45"/><unclear cert="low" resp="#joint">verordnett</unclear>, und <unclear cert="medium" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">unsere</unclear> burgerin und
<lb n="46"/><unclear cert="low" resp="#joint">waißlin</unclear>, in <unclear cert="low" resp="#joint">vatterlichem</unclear> schuz und schirm ge-
<lb n="47"/>halten, und <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">abhelffung</unclear> <unclear cert="low" resp="#joint">irer</unclear> obligenden be-
<lb n="48"/>schwerden, nach besten <unclear cert="low" resp="#joint">müglichisten</unclear> <unclear cert="medium" resp="#joint">mittlen</unclear> gedacht
<lb n="49"/>werden, im fahl <unclear cert="medium" resp="#joint">aber</unclear> sy wider <unclear cert="medium" resp="#joint">versehen</unclear> ufgehal-
<lb n="50"/>ten, und <unclear cert="low" resp="#joint">verrers</unclear> <unclear cert="low" resp="#joint">ungehorsam</unclear> und <unclear cert="low" resp="#joint">halßtarig</unclear> ver-
<lb n="51"/>halten, <unclear cert="low" resp="#joint">wurde</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> <unclear cert="medium" resp="#joint">seiner</unclear> zeit <unclear cert="low" resp="#joint">irer</unclear> <unclear cert="low" resp="#joint">ungehorsame</unclear>
<lb n="52"/>wegen, <unclear cert="low" resp="#joint">gebürende</unclear> mittel <unclear cert="low" resp="#joint">fürgenomen</unclear> werden.
<lb n="53"/><unclear cert="medium" resp="#joint">Wollen</unclear> unß aber nachparlich <unclear cert="medium" resp="#joint">versehen</unclear>, die herren
<lb n="54"/><unclear cert="medium" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="medium" resp="#joint">oberkeitliches</unclear> mittel, diser sach werden
<lb n="55"/>zebegägnen wüßen. Wo dan wir hingegen
<lb n="56"/><unclear cert="low" resp="#joint">solches</unclear> umb die herren in <unclear cert="low" resp="#joint">gleichen</unclear>, und anderen
<lb n="57"/>begebenden <unclear cert="medium" resp="#joint">fählen</unclear> <unclear cert="low" resp="#joint">erwüderigen</unclear> und <unclear cert="medium" resp="#joint">verdienen</unclear>
<lb n="58"/>künden, <unclear cert="low" resp="#joint">wierden</unclear> wir <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">bereit</unclear> willig nachpar-
<lb n="59"/>lich erfünden ze werden, damit unß samptlich
<lb n="60"/><unclear cert="low" resp="#joint">goettlicher</unclear> bewarung wol <unclear cert="low" resp="#joint">befelende</unclear>, datum
<lb n="61"/><origPlace ref="stadtasg-places-19" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Bischofzell</unclear></origPlace> <origDate when="1621-09-16" resp="#ner">den <unclear cert="medium" resp="#joint">6/16</unclear> septembris anno 1621</origDate>.
