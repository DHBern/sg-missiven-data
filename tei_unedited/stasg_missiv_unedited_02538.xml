<lb n="32"/><unclear cert="medium" resp="#joint">liebten</unclear> <unclear cert="medium" resp="#joint">vatterland</unclear> bald ettwas <unclear cert="low" resp="#joint">vngelägenheit</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">angerichtet</unclear> werden möchte, So haben wir gestrigs
<lb n="34"/>tags <unclear cert="medium" resp="#joint">ettliche</unclear> <unclear cert="medium" resp="#joint">verthrüwte</unclear> <unclear cert="medium" resp="#joint">personen</unclear> an <unclear cert="medium" resp="#joint">vnderschiedliche</unclear>
