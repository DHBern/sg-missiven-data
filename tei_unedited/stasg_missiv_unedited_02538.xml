<lb n="23"/><unclear cert="low" resp="#joint">söllich</unclear> <unclear cert="low" resp="#joint">volck</unclear> <unclear cert="low" resp="#joint">mit</unclear> gar <unclear cert="low" resp="#joint">starckhen</unclear> <unclear cert="low" resp="#joint">truggen</unclear> <unclear cert="low" resp="#joint">herbyzogen</unclear>,
