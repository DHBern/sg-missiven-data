<p>
<pb facs="StadtASG_Missive_2848_11191.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> früntlich willig dienst, sambt was wir <unclear cert="medium" resp="#joint">ehren</unclear>, liebs und
<lb n="2"/><unclear cert="low" resp="#joint">guets</unclear> <unclear cert="low" resp="#joint">vermögend</unclear>, <unclear cert="low" resp="#joint">zuevor</unclear>, <unclear cert="low" resp="#joint">From</unclear>, <unclear cert="low" resp="#joint">Fürsichtig</unclear>, <unclear cert="low" resp="#joint">Eersam</unclear>, <unclear cert="low" resp="#joint">Wyß</unclear>, <unclear cert="low" resp="#joint">Innsonders</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">fründ</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">getrüw</unclear> lieb <unclear cert="low" resp="#joint">Eydtgnossen</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Das</unclear> <unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">letsten</unclear> <unclear cert="low" resp="#joint">jüngst</unclear> üch <unclear cert="low" resp="#joint">zuekommnen</unclear> <unclear cert="low" resp="#joint">zytungen</unclear> <unclear cert="low" resp="#joint">abermalen</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">ußfüerlich</unclear> berichten wöllen, <unclear cert="medium" resp="#joint">habend</unclear> <unclear cert="medium" resp="#joint">Ihr</unclear> uns ein sonderbar
<lb n="6"/><unclear cert="low" resp="#joint">eydtgnößisches</unclear> <unclear cert="low" resp="#joint">gefallen</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">wisen</unclear>, darfür wir üch hiemit frünt-
<lb n="7"/>lichen <unclear cert="medium" resp="#joint">danck</unclear> <unclear cert="medium" resp="#joint">sagend</unclear>, Mit pitt, <unclear cert="medium" resp="#joint">Ihr</unclear> die continuation <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">ze</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">zyten</unclear> <unclear cert="low" resp="#joint">zuezyten</unclear> <unclear cert="low" resp="#joint">empfachende</unclear> <unclear cert="low" resp="#joint">solche</unclear> <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">avisen</unclear> <unclear cert="low" resp="#joint">keins</unclear> <unclear cert="low" resp="#joint">beschwerd</unclear> <unclear cert="low" resp="#joint">syn</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">laßen</unclear>, und <unclear cert="low" resp="#joint">be</unclear> <unclear cert="low" resp="#joint">nebents</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">theilhafft</unclear> machen <unclear cert="medium" resp="#joint">wöllind</unclear>, so
<lb n="10"/>deßen <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Pünten</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nechstbenachbarten</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Tütschlanden</unclear></placeName> hal-
<lb n="11"/><unclear cert="medium" resp="#joint">ber</unclear> üch <unclear cert="low" resp="#joint">schriftwirdiges</unclear> <unclear cert="low" resp="#joint">zuelangen</unclear> wirdt. <unclear cert="medium" resp="#joint">Der</unclear> <unclear cert="medium" resp="#joint">gnedige</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">Gott</unclear> <unclear cert="medium" resp="#joint">gerueche</unclear> alles <unclear cert="medium" resp="#joint">zu</unclear> erhaltung und <unclear cert="medium" resp="#joint">rettung</unclear> <unclear cert="medium" resp="#joint">syner</unclear> <unclear cert="medium" resp="#joint">beträng</unclear>-
<lb n="13"/>ten <unclear cert="low" resp="#joint">kirchen</unclear> <unclear cert="low" resp="#joint">zueleiten</unclear>, und uns <unclear cert="medium" resp="#joint">beidersyts</unclear> <unclear cert="medium" resp="#joint">fürerhin</unclear> <unclear cert="medium" resp="#joint">jn</unclear> <unclear cert="medium" resp="#joint">synem</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">heiligen</unclear> <unclear cert="medium" resp="#joint">schirm</unclear> <unclear cert="medium" resp="#joint">zueerhalten</unclear>, Datum <origDate when="1631-03-27" resp="#ner">den 27ten Martii
<lb n="15"/><unclear cert="medium" resp="#joint">Ao</unclear>. 1631</origDate>.
<lb n="16"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und Rath
<lb n="17"/>der <unclear cert="medium" resp="#joint">Stadt</unclear> Zürich</orgName>.
<pb facs="StadtASG_Missive_2848_11192.jpg" n="2"/>
<pb facs="StadtASG_Missive_2848_11193.jpg" n="3"/>
<pb facs="StadtASG_Missive_2848_11194.jpg" n="4"/>
<lb n="18"/>Den Frommen, <unclear cert="medium" resp="#joint">Fuersichtigen</unclear>,
<lb n="19"/>Ehrsamen, Wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="20"/><unclear cert="medium" resp="#joint">meister</unclear> und Rath der Statt
<lb n="21"/>S. Gallen</orgName>, <unclear cert="medium" resp="#joint">unseren</unclear> insonders
<lb n="22"/><unclear cert="medium" resp="#joint">guten</unclear> <unclear cert="medium" resp="#joint">freünden</unclear>, und <unclear cert="medium" resp="#joint">getreüwen</unclear>
<lb n="23"/>Lieben <unclear cert="medium" resp="#joint">Eidgnoßen</unclear>.
</p>
