<lb n="42"/><unclear cert="low" resp="#joint">all</unclear> <unclear cert="low" resp="#joint">ehr</unclear>, <unclear cert="low" resp="#joint">liebs</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guets</unclear>. <unclear cert="low" resp="#joint">Uff</unclear> <unclear cert="low" resp="#joint">solch</unclear> ihr der <unclear cert="low" resp="#joint">maister</unclear>
<lb n="43"/><unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">irem</unclear> <unclear cert="low" resp="#joint">aigen</unclear> <unclear cert="low" resp="#joint">gethonen</unclear> <unclear cert="low" resp="#joint">ußsag</unclear> haben wir <unclear cert="low" resp="#joint">ihnen</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">geandtwurdt</unclear> <unclear cert="low" resp="#joint">Stillschwigen</unclear> <unclear cert="low" resp="#joint">ufferlegt</unclear>. So <unclear cert="low" resp="#joint">wissen</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">persohnen</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">M</unclear>: <persName resp="#ner"><unclear cert="low" resp="#joint">Conrad</unclear> <unclear cert="low" resp="#joint">Waehen=</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">mann</unclear></persName> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">anders</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">all</unclear> <unclear cert="low" resp="#joint">ehr</unclear> <unclear cert="low" resp="#joint">liebs</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guets</unclear>, <unclear cert="low" resp="#joint">hat</unclear> sich
<lb n="47"/>auch <unclear cert="low" resp="#joint">s</unclear>. <unclear cert="low" resp="#joint">lang</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">Inn</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">statt</unclear> gewesen verhalten,
<lb n="48"/>daß <unclear cert="low" resp="#joint">unß</unclear> von <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">ainiche</unclear> <unclear cert="low" resp="#joint">clag</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">beschwerd</unclear>
