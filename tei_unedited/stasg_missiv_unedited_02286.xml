<p>
<pb facs="StadtASG_Missive_2286_8703.jpg" n="1"/>
<lb n="1"/>Sonders gonstiger lieber herr,
<lb n="2"/>Mein dienst unnd freündtlich gruß, sambt was ich liebs unnd guets
<lb n="3"/>vermag seye ihme bevor.
<lb n="4"/>Deß hern ann mein <unclear cert="low" resp="#joint">gl</unclear>. <unclear cert="low" resp="#joint">heren</unclear> <unclear cert="low" resp="#joint">gethones</unclear> <unclear cert="low" resp="#joint">schrifftliches</unclear> <unclear cert="low" resp="#joint">begeren</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">wegen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Meyers</unclear></persName> <unclear cert="low" resp="#joint">alten</unclear> <unclear cert="low" resp="#joint">Buchfurers</unclear>, <unclear cert="low" resp="#joint">hab</unclear> <unclear cert="low" resp="#joint">ich</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">empfangenen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">befelch</unclear> nit <unclear cert="low" resp="#joint">underlaßen</unclear> <unclear cert="low" resp="#joint">soln</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">woeln</unclear>, <unclear cert="low" resp="#joint">ihme</unclear> hiemit <unclear cert="low" resp="#joint">zubeandtworten</unclear>.
<lb n="7"/>Unnd ist kuertze dz gemelter <persName resp="#ner">Caspar Meyer</persName> inn letstgehaltner
<lb n="8"/>jahrrechnung, aller seiner gewalt ein zierlicher stilschwaig vor
<lb n="9"/>denn <unclear cert="low" resp="#joint">heren</unclear> <orgName resp="#ner"><unclear cert="low" resp="#joint">Eidtgnoßenabgesandten</unclear></orgName> abgelegt, unnd gentzlichen auff seine
<lb n="10"/>sohn <persName resp="#ner">Caspar Felix Meyern</persName> an <unclear cert="low" resp="#joint">deßen</unclear> <unclear cert="low" resp="#joint">stadt</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Andreas</unclear> <unclear cert="low" resp="#joint">Thoen</unclear></persName>
<lb n="11"/><unclear cert="low" resp="#joint">vonn</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Schaniß</unclear></placeName> <unclear cert="low" resp="#joint">vogt</unclear> <unclear cert="low" resp="#joint">ist</unclear>, wie auch seinen <unclear cert="low" resp="#joint">tochterman</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Christoff</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">Beuchhellern</unclear></persName> <unclear cert="low" resp="#joint">vonn</unclear> <placeName ref="stadtasg-places-46" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Winterthur</unclear></placeName> <unclear cert="low" resp="#joint">gelegt</unclear>, <unclear cert="low" resp="#joint">und</unclear> ihnen <unclear cert="low" resp="#joint">cedirt</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">fuhrohin</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">handlungen</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">unbündig</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">solln</unclear>, <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">hiereüffen</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">sie</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Beüchheller</unclear></persName> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">Thoen</unclear> <unclear cert="low" resp="#joint">ann</unclear> <unclear cert="low" resp="#joint">stadt</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Felixen</unclear></persName> <unclear cert="low" resp="#joint">diser</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">Chur</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">vormundtschafft</unclear> <unclear cert="low" resp="#joint">angenommen</unclear>. <unclear cert="low" resp="#joint">dareüber</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">ihne</unclear> auch von denn heren Abgesandten confirmationbrieff
<lb n="17"/>zugestelt worden.
<lb n="18"/>Beschließlichen laßt mein herr, sein freündtlich dienst unnd gruß
<lb n="19"/>dem heren vermelden, unnd thuo sich mit sondern gefallen sein anerbottn
<lb n="20"/>beruemen, unns der Allmechtig Gottes woll empfehlende.
<lb n="21"/>Raptim <origPlace ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</origPlace> <origDate when="1621" resp="#ner">3a. Augusti <unclear cert="low" resp="#joint">Ao</unclear>. <unclear cert="low" resp="#joint">1621</unclear></origDate>.
<lb n="22"/><unclear cert="low" resp="#joint">Des</unclear> <unclear cert="low" resp="#joint">H</unclear>.
<lb n="23"/><unclear cert="low" resp="#joint">DW</unclear>
<lb n="24"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Heinrich</unclear> <unclear cert="low" resp="#joint">Hußmann</unclear></persName> <unclear cert="low" resp="#joint">substituter</unclear> <unclear cert="low" resp="#joint">cancelli</unclear>:
<lb n="25"/>Baden.
<lb n="26"/>Dem ehrnvesten frommen fuernemen
<lb n="27"/>unnd weisen heren <persName resp="#ner">Melchior Gueldin</persName>
<lb n="28"/>alten stadtschribern der stadt <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sannct Gallen</placeName>.
<lb n="29"/>meinem sonders gunstigen lieben herrenn.
<pb facs="StadtASG_Missive_2286_8704.jpg" n="2"/>
<lb n="30"/><unclear cert="low" resp="#joint">Edel</unclear> <unclear cert="low" resp="#joint">vest</unclear> fromm <unclear cert="low" resp="#joint">fürnäm</unclear> fürsichtig <unclear cert="low" resp="#joint">ehrsamm</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">weyse</unclear>, <unclear cert="low" resp="#joint">günstig</unclear> <unclear cert="low" resp="#joint">gnedig</unclear>
<lb n="31"/>unnd <unclear cert="low" resp="#joint">gebietend</unclear> Herren unnd Vätter. Ich hab inn glaubwürdige erfahrug ge=
<lb n="32"/>bracht, dz herr <persName resp="#ner">Caspar Meyer</persName> alter Seckelmeister, die verwaltung
<lb n="33"/>seines zeitlichen guetterns würklich abgelegt, unnd andern als vögten, oder vormünde=
<lb n="34"/>rn der gstalt übergeben, daß von derselben zeit sein herrn <persName resp="#ner">Meyers</persName> handlung
<lb n="35"/>oder verrichtung, inn alle weg unbündig sein sollen, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Vt</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>.
<lb n="36"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wt</unclear>. auß <unclear cert="low" resp="#joint">beyligender</unclear> <unclear cert="low" resp="#joint">copey</unclear> <unclear cert="low" resp="#joint">lit</unclear>. A. mit <unclear cert="low" resp="#joint">mehrem</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear>.
<lb n="37"/><unclear cert="low" resp="#joint">Worauß</unclear> <unclear cert="low" resp="#joint">ich</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">unbillich</unclear> <unclear cert="low" resp="#joint">schließe</unclear>, wann sein tochtermann
<lb n="38"/><persName resp="#ner">H. Christoffel Künßler</persName> zu <placeName ref="stadtasg-places-46" cert="medium" resp="#ner">Winterthur</placeName>, unnd <persName resp="#ner">H. Jacob <unclear cert="low" resp="#joint">Cobele</unclear></persName> <unclear cert="low" resp="#joint">zu</unclear>
<lb n="39"/><placeName ref="stadtasg-places-5" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Arbon</unclear></placeName>, wider <unclear cert="low" resp="#joint">mich</unclear> mein haußfraw, durch <unclear cert="low" resp="#joint">ihne</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Meyer</unclear></persName> <unclear cert="low" resp="#joint">angestelte</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">rechtfertigung</unclear> <unclear cert="low" resp="#joint">allhir</unclear>, <unclear cert="low" resp="#joint">gleichwohl</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">solichn</unclear> <unclear cert="low" resp="#joint">gewaltsbrieff</unclear> <unclear cert="low" resp="#joint">wurden</unclear> <unclear cert="low" resp="#joint">auflegen</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">wie</unclear> auff ihr begeren, unnd ergangne erkantnuß ich ihme ein <unclear cert="low" resp="#joint">copey</unclear> <unclear cert="low" resp="#joint">zustellen</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">jedoch</unclear> <unclear cert="low" resp="#joint">solcher</unclear> <unclear cert="low" resp="#joint">gewaltsbrieff</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">künfftig</unclear> für nichtig
<lb n="43"/>unnd ungültig angefochten, unnd ich od mein haußfrauw dahero inn mehrere
<lb n="44"/>unglegenheit leichtlich gebracht werden köndte.
<lb n="45"/>Demme unnd <unclear cert="low" resp="#joint">anderer</unclear> <unclear cert="low" resp="#joint">darauß</unclear> <unclear cert="low" resp="#joint">besorgklich</unclear> <unclear cert="low" resp="#joint">entspringender</unclear> <unclear cert="low" resp="#joint">weitläuffigkeit</unclear> <unclear cert="low" resp="#joint">vor=</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">zukomen</unclear>, so gelangt ann E. Vt. unnd <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wt</unclear>. <unclear cert="low" resp="#joint">mein</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">nammen</unclear>
<lb n="47"/>gemelter <unclear cert="low" resp="#joint">meiner</unclear> <unclear cert="low" resp="#joint">haußfrauwn</unclear> <unclear cert="low" resp="#joint">underthänig</unclear> <unclear cert="low" resp="#joint">bitten</unclear>, <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">gelieben</unclear> wölle, durch
<lb n="48"/>mitel der fromen, ehrnvesten fürnemmen ehrsamen unnd weisen, herren
<lb n="49"/><orgName ref="stadtasg-actors-718" cert="medium" role="recipient" resp="#ner">Herren Schultheiß unnd Rhat der Statt <unclear cert="low" resp="#joint">Winterthur</unclear></orgName> <unclear cert="low" resp="#joint">besagten</unclear> <unclear cert="low" resp="#joint">H</unclear>. <unclear cert="low" resp="#joint">Christoff</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">Künßlern</unclear> (<unclear cert="low" resp="#joint">als</unclear> der sich allhie tzu rechten persöhnlich eingestelt) günstig
<lb n="51"/>anzeigen zulaßen, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">er</unclear> unnd sein mithaafft er Vogt, oder desselben staat=
<lb n="52"/>halter, oder wer von ihro wegen zum rechten abgefertiget werden
<lb n="53"/>möchte, <unclear cert="low" resp="#joint">auff</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">nächstkünfftigen</unclear> <unclear cert="low" resp="#joint">rechtstag</unclear>, mit <unclear cert="low" resp="#joint">gewaltsbrieffen</unclear>
<lb n="54"/>unnd weyttertröstung (sidmahlen <persName resp="#ner">Caspar Meyers</persName> <unclear cert="low" resp="#joint">geleistes</unclear> <unclear cert="low" resp="#joint">glübdt</unclear>,
<lb n="55"/>mit <persName resp="#ner">Johannes Schirmanns</persName> entlaßung allhier, unnd obvermeldter
<lb n="56"/>erfolgter vormündschafft für erloschen oder <unclear cert="low" resp="#joint">unkräfftig</unclear> <unclear cert="low" resp="#joint">geachtet</unclear> werden
<lb n="57"/><unclear cert="low" resp="#joint">köndte</unclear>) <unclear cert="low" resp="#joint">dergestalt</unclear> <unclear cert="low" resp="#joint">verfaßt</unclear> <unclear cert="low" resp="#joint">erschinen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">ferneren</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">auffzug</unclear> <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">verlengerung</unclear> <unclear cert="low" resp="#joint">kein</unclear> <unclear cert="low" resp="#joint">erhebliche</unclear> <unclear cert="low" resp="#joint">ursach</unclear> <unclear cert="low" resp="#joint">gegeben</unclear> <unclear cert="low" resp="#joint">werde</unclear>.
<lb n="59"/><unclear cert="low" resp="#joint">Beger</unclear> umb Eüwer <unclear cert="low" resp="#joint">Vt</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wt</unclear>. <unclear cert="low" resp="#joint">ich</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">burgerlicher</unclear> <unclear cert="low" resp="#joint">gehorsamme</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">underthänigstes</unclear> <unclear cert="low" resp="#joint">müglichsts</unclear> fleiß zuverdienen.
<lb n="61"/>E. Vt. F. E. W. Wt.
<lb n="62"/>underthäniger gehorsamer burger.
<lb n="63"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Sebastian</unclear> <unclear cert="low" resp="#joint">Kuen</unclear></persName>.
