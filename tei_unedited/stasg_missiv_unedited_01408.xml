<p>
<pb facs="StadtASG_Missive_1408_4985.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freundtlich</unclear> willig dienst <unclear cert="low" resp="#joint">sein</unclear> E. <unclear cert="medium" resp="#joint">ft</unclear>. mit <unclear cert="low" resp="#joint">vleiß</unclear> voran berait, <unclear cert="low" resp="#joint">Fuersichtige</unclear>, <unclear cert="low" resp="#joint">Ersame</unclear> unnd <unclear cert="medium" resp="#joint">Weiße</unclear>, besonder
<lb n="2"/><unclear cert="medium" resp="#joint">liebe</unclear> und <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">freundt</unclear>. <unclear cert="medium" resp="#joint">Auß</unclear> <unclear cert="medium" resp="#joint">Inngelegter</unclear> schrifft vernemen E. <unclear cert="low" resp="#joint">ft</unclear>., <unclear cert="low" resp="#joint">wessen</unclear> <unclear cert="low" resp="#joint">gegenn</unclear> <unclear cert="low" resp="#joint">Ir</unclear> sich unser
<lb n="3"/>Burger <persName resp="#ner">Michael <unclear cert="low" resp="#joint">Lidel</unclear></persName>, <unclear cert="medium" resp="#joint">uber</unclear> <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Kuechen</unclear></persName> <unclear cert="low" resp="#joint">deroselben</unclear> Burger <unclear cert="low" resp="#joint">verzuglicher</unclear> bezalung halben, <unclear cert="medium" resp="#joint">beschwert</unclear>
<lb n="4"/>befinden, Weil dann die <unclear cert="low" resp="#joint">angegebene</unclear> schuldt <unclear cert="low" resp="#joint">lauter</unclear>, und <unclear cert="low" resp="#joint">darumb</unclear> bezalung derselben billig erfolg
<lb n="5"/>soll, So ersuchen wir E. <unclear cert="low" resp="#joint">ft</unclear>. hiemit <unclear cert="medium" resp="#joint">dienstfreundtlichen</unclear>, die wollen gedachten <unclear cert="low" resp="#joint">Iren</unclear> Burger mit <unclear cert="low" resp="#joint">not</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">tuerfftiger</unclear> <unclear cert="low" resp="#joint">gebuer</unclear> <unclear cert="low" resp="#joint">dohin</unclear> <unclear cert="medium" resp="#joint">anhallten</unclear>, dz er dem <unclear cert="medium" resp="#joint">unsern</unclear> sein <unclear cert="low" resp="#joint">verlegten</unclear> <unclear cert="low" resp="#joint">außstandt</unclear> <unclear cert="low" resp="#joint">benenneten</unclear> <unclear cert="low" resp="#joint">lezgehallten</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">contentiern</unclear> und <unclear cert="medium" resp="#joint">zuesenden</unclear> <unclear cert="medium" resp="#joint">solle</unclear>. <unclear cert="medium" resp="#joint">Inmassen</unclear> wir <unclear cert="medium" resp="#joint">zue</unclear> E. <unclear cert="medium" resp="#joint">ft</unclear>. <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">befuerderern</unclear> der Justitien <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">freundt</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">lichen</unclear> <unclear cert="low" resp="#joint">versehens</unclear> <unclear cert="low" resp="#joint">sein</unclear>, <unclear cert="low" resp="#joint">Hinwider</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">urbuetig</unclear>, <unclear cert="low" resp="#joint">solche</unclear> <unclear cert="low" resp="#joint">gebuerliche</unclear> <unclear cert="low" resp="#joint">verhilff</unclear>, mit allem <unclear cert="medium" resp="#joint">gueten</unclear> willen
<lb n="9"/>dienstfreundtlichen <unclear cert="low" resp="#joint">zuebeschulden</unclear>. Datum den <origDate when="1602-06-02" resp="#ner">2. Junij Anno 1602</origDate>.
<lb n="10"/><orgName ref="stadtasg-actors-571" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermaister</unclear> unnd Rath
<lb n="11"/><unclear cert="low" resp="#joint">zue</unclear> Nuernberg</orgName>.∣.
<pb facs="StadtASG_Missive_1408_4986.jpg" n="2"/>
<lb n="12"/>Den frommen fuersichtigen ersamen und wei=
<lb n="13"/>sen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermaistere</unclear> und <unclear cert="low" resp="#joint">Rate</unclear> zu St. Gallen</orgName>,
<lb n="14"/>unsern besondern lieben und gueten <unclear cert="low" resp="#joint">freunden</unclear>
</p>
