<p>
<pb facs="StadtASG_Missive_2257_8559.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig dienst, samt was
<lb n="2"/>wir ehren liebs und guets vermögen, zuvor, Für-
<lb n="3"/>sichtig, Eersame und Wyßen, besonders liebe guete
<lb n="4"/>Freündt und Nachbarn,
<lb n="5"/>Wasmaßn wir weiland unsers <unclear cert="low" resp="#joint">liebn</unclear> <unclear cert="low" resp="#joint">mit</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">Vor</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">burgers</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Casper</unclear> <unclear cert="low" resp="#joint">Kammß</unclear></persName> <unclear cert="low" resp="#joint">sel</unclear>: <unclear cert="low" resp="#joint">Erbn</unclear> <unclear cert="low" resp="#joint">einen</unclear> <unclear cert="low" resp="#joint">Teilungs</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">Termin</unclear> <unclear cert="low" resp="#joint">angesetzt</unclear> haben, wirdt euch, ohne zwifel
<lb n="8"/>wol ingedenckh sein. <unclear cert="low" resp="#joint">Wan</unclear>
<lb n="9"/>nun aber, auß ingefallnen ursachen, und sonderlich
<lb n="10"/>von wegen etlicher schweben-
<lb n="11"/>der strittigen Erben,
<lb n="12"/>die theilung keinen fortgang haben können, sind
<lb n="13"/>wir von <unclear cert="low" resp="#joint">gemelten</unclear> <unclear cert="low" resp="#joint">allhieigen</unclear> <unclear cert="low" resp="#joint">kammischn</unclear> <unclear cert="low" resp="#joint">Erbn</unclear>
<lb n="14"/>widerumb underthenig ersuecht worden, einen
<lb n="15"/>andren tag zur <unclear cert="low" resp="#joint">teilung</unclear> <unclear cert="low" resp="#joint">anzusetzen</unclear>, <unclear cert="low" resp="#joint">dero</unclear>-
<lb n="16"/><unclear cert="low" resp="#joint">nechstkunfftign</unclear> wegen <unclear cert="low" resp="#joint">wir</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">Donstag</unclear> den . 15 <unclear cert="low" resp="#joint">tn</unclear> . diß <unclear cert="low" resp="#joint">lauffendn</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Monats</unclear> <unclear cert="low" resp="#joint">Martij</unclear></date> <unclear cert="low" resp="#joint">erennnt</unclear> und <unclear cert="low" resp="#joint">angesetzt</unclear>. <unclear cert="low" resp="#joint">Ge</unclear>-
<lb n="18"/>zu <unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">langt</unclear> <unclear cert="low" resp="#joint">hieruf</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">freündt</unclear>: <unclear cert="low" resp="#joint">nachbarlichs</unclear> <unclear cert="low" resp="#joint">ersuechn</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">weltn</unclear> <unclear cert="low" resp="#joint">euwern</unclear> <unclear cert="low" resp="#joint">angehörign</unclear> <unclear cert="low" resp="#joint">burgern</unclear>, <unclear cert="low" resp="#joint">als</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">keltzen</unclear></persName> und <persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear> <unclear cert="low" resp="#joint">Schellenbergern</unclear></persName>, <unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">kammischn</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">angemaßtn</unclear> <unclear cert="low" resp="#joint">Erben</unclear>, <unclear cert="low" resp="#joint">disen</unclear> <unclear cert="low" resp="#joint">tag</unclear> <unclear cert="low" resp="#joint">ankünden</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Darbij</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">manen</unclear> <unclear cert="low" resp="#joint">lassen</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">uff</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">Mitwochen</unclear> <unclear cert="low" resp="#joint">Abends</unclear> <unclear cert="low" resp="#joint">darvor</unclear> <unclear cert="low" resp="#joint">alhie</unclear> <unclear cert="low" resp="#joint">erschinen</unclear>, <unclear cert="low" resp="#joint">und</unclear>
<lb n="24"/>(. <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">vermidung</unclear> <unclear cert="low" resp="#joint">uncostens</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">verlengerung</unclear> der
<lb n="25"/>sachen .) <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">gnuegsamer</unclear> <unclear cert="low" resp="#joint">besigleten</unclear> <unclear cert="low" resp="#joint">urkhund</unclear>, <unclear cert="low" resp="#joint">eüwerer</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">Erbrechtens</unclear> <unclear cert="low" resp="#joint">verfaßet</unclear> <unclear cert="low" resp="#joint">sijen</unclear>, und ob sie
<lb n="27"/>in Persohn nit köndtn oder weltn erschinen, doch
<lb n="28"/>vollkomne beuehligte Anwäld, mit gedachter
<lb n="29"/>Urkund an ihr statt <unclear cert="low" resp="#joint">schickind</unclear>, <unclear cert="low" resp="#joint">dann</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">si</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">ihre</unclear> <unclear cert="low" resp="#joint">Anwäld</unclear> <unclear cert="low" resp="#joint">erschinend</unclear> <unclear cert="low" resp="#joint">od</unclear> nit,
<lb n="31"/>nichtsdestoweniger von den Anwesendn Erben
<lb n="32"/>mit der teilung ein weg wie <unclear cert="low" resp="#joint">dn</unclear> <unclear cert="low" resp="#joint">andern</unclear>
<lb n="33"/>wurde <unclear cert="low" resp="#joint">vortgeschritten</unclear> <unclear cert="low" resp="#joint">werdn</unclear>. <unclear cert="low" resp="#joint">Weltn</unclear> wir
<lb n="34"/><unclear cert="low" resp="#joint">ech</unclear> <unclear cert="low" resp="#joint">pp</unclear> <unclear cert="low" resp="#joint">dat</unclear>. <origDate when="1621-03-12" resp="#ner"><unclear cert="low" resp="#joint">dn</unclear>. <unclear cert="low" resp="#joint">12</unclear> <unclear cert="low" resp="#joint">tn</unclear> <unclear cert="low" resp="#joint">Martij</unclear> 1621</origDate>.
<pb facs="StadtASG_Missive_2257_8560.jpg" n="2"/>
<lb n="35"/><unclear cert="low" resp="#joint">An</unclear> <origPlace ref="stadtasg-places-46" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Winterthur</unclear></origPlace> <origDate when="1621-03-12" resp="#ner">12 <unclear cert="medium" resp="#joint">Martij</unclear> 1621</origDate>.
</p>
