    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_801_2151.jpg" n="1"/>
<lb n="1"/>Unnser freundtlich dienst voran <unclear cert="low" resp="#joint">fuersichtigen</unclear> ersamen
<lb n="2"/>weisen besonder lieben <unclear cert="low" resp="#joint">unnd</unclear> gueten freundt. Wir haben
<lb n="3"/>ainen mit namen <persName resp="#ner">Martin Haefelin</persName> von <placeName resp="#ner">Suningen</placeName> in
<lb n="4"/>unser <unclear cert="low" resp="#joint">verwarung</unclear>, <unclear cert="low" resp="#joint">welcher</unclear> <unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">etwas</unclear> <unclear cert="low" resp="#joint">argkwönig</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">erzaigt</unclear>, <unclear cert="low" resp="#joint">glichwol</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">khain</unclear> <unclear cert="low" resp="#joint">sondern</unclear> <unclear cert="low" resp="#joint">grundt</unclear> <unclear cert="low" resp="#joint">seins</unclear> <unclear cert="low" resp="#joint">wesens</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">bekhumen</unclear> mögen. Wir vernemen aber, das
<lb n="7"/><unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">ettliche</unclear> <unclear cert="low" resp="#joint">argkwoenige</unclear> <unclear cert="low" resp="#joint">leüt</unclear> in <unclear cert="low" resp="#joint">schrift</unclear> <unclear cert="low" resp="#joint">verzaichnet</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">söllen</unclear>. <unclear cert="low" resp="#joint">Da</unclear> <unclear cert="low" resp="#joint">ist</unclear> unser pitt an <unclear cert="low" resp="#joint">euch</unclear>, <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">wölt</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">derselben</unclear> in <unclear cert="low" resp="#joint">schrift</unclear> <unclear cert="low" resp="#joint">verstendigen</unclear>, wie unser <unclear cert="low" resp="#joint">verordntn</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">gehaben</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">stattlicher</unclear> <unclear cert="low" resp="#joint">gegen</unclear> disem
<lb n="11"/><unclear cert="low" resp="#joint">Haefelin</unclear> <unclear cert="low" resp="#joint">gandlet</unclear> <unclear cert="low" resp="#joint">mögnd</unclear>. <unclear cert="low" resp="#joint">Am</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">ist</unclear> <unclear cert="low" resp="#joint">nachmaln</unclear> <unclear cert="low" resp="#joint">ainer</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">ewers</unclear> <unclear cert="low" resp="#joint">mitratsfruend</unclear> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">gwest</unclear>, <unclear cert="low" resp="#joint">habende</unclear> <unclear cert="low" resp="#joint">begert</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">wissen</unclear>, <unclear cert="low" resp="#joint">was</unclear> <unclear cert="low" resp="#joint">gestalten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">maister</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">metzger</unclear> <unclear cert="low" resp="#joint">handtwerchs</unclear> <unclear cert="low" resp="#joint">vergunt</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">flaiß</unclear> <unclear cert="low" resp="#joint">bei</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">ußzewögen</unclear>. <unclear cert="low" resp="#joint">Daruff</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">auch</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">nachpeurlichen</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">vernemen</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">maister</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">desselben</unclear> <unclear cert="low" resp="#joint">jetzbenanten</unclear> <unclear cert="low" resp="#joint">handtwerchs</unclear> <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">das</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">rindflaisch</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">schweren</unclear> <unclear cert="low" resp="#joint">ochsen</unclear>, auch von den
<lb n="19"/>gueten jungen kelbern, das pfund unsers gewichtes
<lb n="20"/>umb 6 d unser werung geben mögnd. Und <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">die</unclear>
<lb n="21"/>lung und lebern sampt den fuessen biß khuenfftig <date resp="#ner">sant
<lb n="22"/>Martins tag</date> nebet dem rindflaisch verwögenn
<lb n="23"/>und in glichem gelt schergen mögnd. Was aber
<lb n="24"/>alt küwen und derglichen ist, söllen sy nach der
<lb n="25"/><unclear cert="low" resp="#joint">schetzung</unclear> umb neün haller, oder wie <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">getzälht</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">wurd</unclear>, <unclear cert="low" resp="#joint">geben</unclear>. <unclear cert="low" resp="#joint">Und</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wir</unclear> diß jars unsern maistern
<lb n="27"/>uff die metzger khainen andern vortheil nit thun,
<lb n="28"/>dan das wir inen ain schlechte weid die vyhe
<lb n="29"/>darinn <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">triben</unclear> gegeben. Aber weyl diß jars an
<lb n="30"/>schaf flaisch mangel gwest, haben wir uff irer
<lb n="31"/>pitt vergunt, ain buochlen, das lamm flaisch auch
<lb n="32"/>umb das best umb 16 d, ain <unclear cert="low" resp="#joint">khopff</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">vi</unclear> <unclear cert="low" resp="#joint">d</unclear>, ain
<lb n="33"/><unclear cert="low" resp="#joint">kreeß</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">v</unclear> <unclear cert="low" resp="#joint">d</unclear> und ain <unclear cert="low" resp="#joint">gtreb</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">vi</unclear> <unclear cert="low" resp="#joint">d</unclear> und <unclear cert="low" resp="#joint">ain</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">pfund</unclear> <unclear cert="low" resp="#joint">späckh</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">viij</unclear> <unclear cert="low" resp="#joint">d</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">mögnd</unclear>, <unclear cert="low" resp="#joint">woltn</unclear> wir
<lb n="35"/>euch nit verhalten. Mit erpiettung, wo wir euch
<lb n="36"/>nachpeurlichen dienst erweißen khuntn, woltn
<lb n="37"/>wir willig sein. Dat <origDate when="1559-09-13" cert="medium" resp="#ner">den 13ten septembris
<lb n="38"/>anno 59</origDate>.
<lb n="39"/><unclear cert="low" resp="#joint">Verwalter</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">hauptmanschafft</unclear>, <unclear cert="low" resp="#joint">auch</unclear>
<lb n="40"/>burgermaister und rath der statt
<lb n="41"/>Costantz.
<pb facs="StadtASG_Missive_801_2152.jpg" n="2"/>
<pb facs="StadtASG_Missive_801_2153.jpg" n="3"/>
<pb facs="StadtASG_Missive_801_2154.jpg" n="4"/>
<lb n="42"/>Den <unclear cert="low" resp="#joint">fuersichtigen</unclear> ersamen <unclear cert="low" resp="#joint">weysen</unclear>
<lb n="43"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister und rath <unclear cert="low" resp="#joint">zuo</unclear> sant Gallen</orgName>
<lb n="44"/><unclear cert="low" resp="#joint">unsren</unclear> <unclear cert="low" resp="#joint">besonder</unclear> lieben und <unclear cert="medium" resp="#joint">guten</unclear> <unclear cert="low" resp="#joint">freunden</unclear>
</p>
