<p>
<pb facs="StadtASG_Missive_801_2151.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freundtlich</unclear> dienst voran <unclear cert="medium" resp="#joint">fuersichtigen</unclear> ersamen
<lb n="2"/>weisen besonder lieben <unclear cert="medium" resp="#joint">unnd</unclear> gueten <unclear cert="low" resp="#joint">freundt</unclear>. Wir haben
<lb n="3"/>ainen mit namen <persName resp="#ner">Martin <unclear cert="low" resp="#joint">Haefelin</unclear></persName> von <placeName resp="#ner"><unclear cert="low" resp="#joint">Suningen</unclear></placeName> in
<lb n="4"/>unser verwarung, <unclear cert="low" resp="#joint">welcher</unclear> sich <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">argkwönig</unclear>
<lb n="5"/><unclear cert="medium" resp="#joint">erzaigt</unclear>, <unclear cert="medium" resp="#joint">glichwol</unclear> aber <unclear cert="medium" resp="#joint">khain</unclear> <unclear cert="medium" resp="#joint">sondern</unclear> <unclear cert="medium" resp="#joint">grundt</unclear> <unclear cert="medium" resp="#joint">seins</unclear> <unclear cert="medium" resp="#joint">wesens</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">bekhumen</unclear> mögen. Wir vernemen aber, das
<lb n="7"/><unclear cert="medium" resp="#joint">euch</unclear> <unclear cert="medium" resp="#joint">ettliche</unclear> <unclear cert="medium" resp="#joint">argkwoenige</unclear> <unclear cert="medium" resp="#joint">leüt</unclear> in <unclear cert="medium" resp="#joint">schrift</unclear> <unclear cert="medium" resp="#joint">verzaichnet</unclear>
<lb n="8"/>sein <unclear cert="medium" resp="#joint">söllen</unclear>. <unclear cert="medium" resp="#joint">Da</unclear> ist unser pitt an euch, ir <unclear cert="medium" resp="#joint">wölt</unclear> <unclear cert="medium" resp="#joint">unß</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">derselben</unclear> in <unclear cert="medium" resp="#joint">schrift</unclear> <unclear cert="medium" resp="#joint">verstendigen</unclear>, wie unser <unclear cert="medium" resp="#joint">verordntn</unclear>
<lb n="10"/>uff <unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">gehaben</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">desto</unclear> stattlicher <unclear cert="medium" resp="#joint">gegen</unclear> disem
<lb n="11"/><unclear cert="medium" resp="#joint">Haefelin</unclear> <unclear cert="medium" resp="#joint">gandlet</unclear> <unclear cert="medium" resp="#joint">mögnd</unclear>. <unclear cert="medium" resp="#joint">Am</unclear> <unclear cert="medium" resp="#joint">andern</unclear> ist <unclear cert="medium" resp="#joint">nachmaln</unclear> ainer
<lb n="12"/><unclear cert="low" resp="#joint">ewers</unclear> <unclear cert="low" resp="#joint">mitratsfruend</unclear> <unclear cert="low" resp="#joint">allhie</unclear> <unclear cert="low" resp="#joint">gwest</unclear>, <unclear cert="low" resp="#joint">habende</unclear> begert
<lb n="13"/>von uns <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">wissen</unclear>, was <unclear cert="medium" resp="#joint">gestalten</unclear> <unclear cert="medium" resp="#joint">wir</unclear> unser maister
<lb n="14"/><unclear cert="medium" resp="#joint">metzger</unclear> handtwerchs <unclear cert="medium" resp="#joint">vergunt</unclear> das <unclear cert="medium" resp="#joint">flaiß</unclear> <unclear cert="medium" resp="#joint">bei</unclear> <unclear cert="medium" resp="#joint">unß</unclear>
<lb n="15"/>diser <unclear cert="medium" resp="#joint">zeit</unclear> <unclear cert="medium" resp="#joint">ußzewögen</unclear>. <unclear cert="medium" resp="#joint">Daruff</unclear> geben wir euch auch
<lb n="16"/><unclear cert="low" resp="#joint">nachpeurlichen</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">vernemen</unclear>, das <unclear cert="medium" resp="#joint">unsere</unclear> maister
<lb n="17"/><unclear cert="medium" resp="#joint">desselben</unclear> <unclear cert="medium" resp="#joint">jetzbenanten</unclear> handtwerchs diser <unclear cert="medium" resp="#joint">zeit</unclear> das
<lb n="18"/><unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">rindflaisch</unclear> von <unclear cert="medium" resp="#joint">schweren</unclear> <unclear cert="medium" resp="#joint">ochsen</unclear>, auch von den
<lb n="19"/>gueten jungen <unclear cert="low" resp="#joint">kelbern</unclear>, das pfund <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">gewichtes</unclear>
<lb n="20"/>umb 6 <unclear cert="low" resp="#joint">d</unclear> unser <unclear cert="low" resp="#joint">werung</unclear> geben <unclear cert="low" resp="#joint">mögnd</unclear>. Und <unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">die</unclear>
<lb n="21"/>lung und <unclear cert="low" resp="#joint">lebern</unclear> sampt den <unclear cert="low" resp="#joint">fuessen</unclear> <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">khuenfftig</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">sant</unclear>
<lb n="22"/>Martins tag</date> <unclear cert="low" resp="#joint">nebet</unclear> dem <unclear cert="low" resp="#joint">rindflaisch</unclear> <unclear cert="low" resp="#joint">verwögenn</unclear>
<lb n="23"/>und in <unclear cert="low" resp="#joint">glichem</unclear> <unclear cert="low" resp="#joint">gelt</unclear> <unclear cert="low" resp="#joint">schergen</unclear> <unclear cert="low" resp="#joint">mögnd</unclear>. Was aber
<lb n="24"/>alt <unclear cert="low" resp="#joint">küwen</unclear> und <unclear cert="low" resp="#joint">derglichen</unclear> ist, <unclear cert="low" resp="#joint">söllen</unclear> sy nach der
<lb n="25"/><unclear cert="medium" resp="#joint">schetzung</unclear> umb <unclear cert="low" resp="#joint">neün</unclear> haller, oder wie es <unclear cert="medium" resp="#joint">inen</unclear> <unclear cert="medium" resp="#joint">getzälht</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">wurd</unclear>, geben. Und haben wir diß <unclear cert="low" resp="#joint">jars</unclear> unsern <unclear cert="low" resp="#joint">maistern</unclear>
<lb n="27"/>uff die <unclear cert="low" resp="#joint">metzger</unclear> <unclear cert="low" resp="#joint">khainen</unclear> andern vortheil nit thun,
<lb n="28"/>dan das wir inen ain schlechte <unclear cert="low" resp="#joint">weid</unclear> die vyhe
<lb n="29"/>darinn <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">triben</unclear> gegeben. Aber <unclear cert="low" resp="#joint">weyl</unclear> diß jars an
<lb n="30"/>schaf flaisch mangel gwest, haben wir uff <unclear cert="low" resp="#joint">irer</unclear>
<lb n="31"/>pitt <unclear cert="low" resp="#joint">vergunt</unclear>, ain <unclear cert="low" resp="#joint">buochlen</unclear>, das lamm flaisch auch
<lb n="32"/><unclear cert="low" resp="#joint">umb</unclear> das best umb <unclear cert="low" resp="#joint">16</unclear> <unclear cert="low" resp="#joint">d</unclear>, ain <unclear cert="medium" resp="#joint">khopff</unclear> umb <unclear cert="low" resp="#joint">vi</unclear> <unclear cert="low" resp="#joint">d</unclear>, ain
<lb n="33"/><unclear cert="low" resp="#joint">kreeß</unclear> umb <unclear cert="medium" resp="#joint">v</unclear> <unclear cert="medium" resp="#joint">d</unclear> und ain <unclear cert="medium" resp="#joint">gtreb</unclear> umb <unclear cert="medium" resp="#joint">vi</unclear> <unclear cert="medium" resp="#joint">d</unclear> und ain
<lb n="34"/>pfund <unclear cert="medium" resp="#joint">späckh</unclear> umb <unclear cert="low" resp="#joint">viij</unclear> <unclear cert="low" resp="#joint">d</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">mögnd</unclear>, <unclear cert="low" resp="#joint">woltn</unclear> wir
<lb n="35"/>euch nit <unclear cert="low" resp="#joint">verhalten</unclear>. Mit <unclear cert="low" resp="#joint">erpiettung</unclear>, <unclear cert="low" resp="#joint">wo</unclear> wir euch
<lb n="36"/>nachpeurlichen dienst erweißen khuntn, woltn
<lb n="37"/>wir willig sein. Dat <origDate when="1559-09-13" cert="medium" resp="#ner">den 13ten septembris
<lb n="38"/>anno 59</origDate>.
<lb n="39"/>Verwalter der <unclear cert="medium" resp="#joint">hauptmanschafft</unclear>, <unclear cert="medium" resp="#joint">auch</unclear>
<lb n="40"/>burgermaister und rath der statt
<lb n="41"/><unclear cert="low" resp="#joint">Costantz</unclear>.
