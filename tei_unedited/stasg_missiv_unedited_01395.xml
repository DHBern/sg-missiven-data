<p>
<pb facs="StadtASG_Missive_1395_4923.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründtlich</unclear>, <unclear cert="low" resp="#joint">guotwillig</unclear>, und <unclear cert="medium" resp="#joint">nachpuirliche</unclear>
<lb n="2"/>dinst, <unclear cert="medium" resp="#joint">zuovor</unclear>. Fürsichtige, Ersame, <unclear cert="low" resp="#joint">Weyße</unclear> <unclear cert="medium" resp="#joint">bßon</unclear>-
<lb n="3"/>ders liebe <unclear cert="low" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">fründt</unclear> und <unclear cert="low" resp="#joint">nachpuiren</unclear>.
<lb n="4"/>Es hatt uns unser burger <persName resp="#ner">Johann <unclear cert="low" resp="#joint">Aychholtz</unclear></persName> <unclear cert="low" resp="#joint">under</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">thenig</unclear> <unclear cert="low" resp="#joint">bericht</unclear>. Wie das <unclear cert="low" resp="#joint">sines</unclear> bruoders <persName resp="#ner"><unclear cert="low" resp="#joint">Conrart</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Aychholtz</unclear></persName> seeligen <unclear cert="low" resp="#joint">dochter</unclear>, von <unclear cert="low" resp="#joint">Petrn</unclear> des <unclear cert="medium" resp="#joint">Zollikho</unclear>-
<lb n="7"/><unclear cert="medium" resp="#joint">fers</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <placeName resp="#ner">Sonnenberg</placeName> sohn, wegen <unclear cert="low" resp="#joint">bezoghner</unclear> Ehe
<lb n="8"/>angefordert. Und <unclear cert="medium" resp="#joint">deßhalb</unclear> er und <unclear cert="medium" resp="#joint">andere</unclear> ver-
<lb n="9"/><unclear cert="medium" resp="#joint">wandte</unclear> <unclear cert="medium" resp="#joint">for</unclear> <unclear cert="medium" resp="#joint">eweren</unclear> verordneten Richtern in <unclear cert="medium" resp="#joint">Ehsachen</unclear>,
<lb n="10"/>auf <date resp="#ner"><unclear cert="low" resp="#joint">negst</unclear> <unclear cert="low" resp="#joint">künftigen</unclear> dornstag</date> <unclear cert="low" resp="#joint">zuoerschinen</unclear> citirt
<lb n="11"/><unclear cert="medium" resp="#joint">seyen</unclear>. Dieweil aber ime und anderen, so <unclear cert="medium" resp="#joint">gedach</unclear>-
<lb n="12"/>ter <unclear cert="medium" resp="#joint">siner</unclear> <unclear cert="medium" resp="#joint">basen</unclear> <unclear cert="medium" resp="#joint">sippschaft</unclear> und negster <unclear cert="medium" resp="#joint">verwandt</unclear>-
<lb n="13"/><unclear cert="medium" resp="#joint">nus</unclear> <unclear cert="medium" resp="#joint">halb</unclear> <unclear cert="medium" resp="#joint">bistendig</unclear> sein sollen, von wegen <unclear cert="low" resp="#joint">sinr</unclear>
<lb n="14"/><persName resp="#ner"><unclear cert="low" resp="#joint">Aychholtz</unclear></persName> <unclear cert="low" resp="#joint">Muotter</unclear> <persName resp="#ner">Dorothea</persName> seeligen <unclear cert="low" resp="#joint">ablieben</unclear>, <unclear cert="medium" resp="#joint">ime</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">deßhalb</unclear> <unclear cert="low" resp="#joint">zuegestandnen</unclear> laidts, auch <unclear cert="low" resp="#joint">anderer</unclear> <unclear cert="low" resp="#joint">fürge</unclear>-
<lb n="16"/>fallner <unclear cert="low" resp="#joint">hindernußen</unclear>, sonderlich aber der <unclear cert="medium" resp="#joint">zuit</unclear> da
<lb n="17"/><unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">dis</unclear> bericht <unclear cert="low" resp="#joint">ersts</unclear> <unclear cert="low" resp="#joint">hüt</unclear>, auf <unclear cert="low" resp="#joint">angesetztn</unclear> tag
<lb n="18"/><unclear cert="medium" resp="#joint">zuoerschinen</unclear> <unclear cert="medium" resp="#joint">unmoglich</unclear>, <unclear cert="medium" resp="#joint">weere</unclear> bedacht umb fer-
<lb n="19"/>nere dilation <unclear cert="low" resp="#joint">anzuohalten</unclear>, <unclear cert="low" resp="#joint">derowegen</unclear> <unclear cert="medium" resp="#joint">sin</unclear> under-
<lb n="20"/>thenig bitt, wir <unclear cert="medium" resp="#joint">welten</unclear> ime ain <unclear cert="medium" resp="#joint">fürschrift</unclear> mit <unclear cert="medium" resp="#joint">zuo</unclear>-
<lb n="21"/><unclear cert="medium" resp="#joint">thailen</unclear> unbeschwert sein. Die wir nun ime <unclear cert="low" resp="#joint">nitt</unclear>
<lb n="22"/>verwaigern kuenden. Langt derohalben unser
<lb n="23"/><unclear cert="low" resp="#joint">fründtlich</unclear> <unclear cert="low" resp="#joint">ersuochen</unclear> an <unclear cert="medium" resp="#joint">Euich</unclear>, ir <unclear cert="low" resp="#joint">welten</unclear> von wegen
<lb n="24"/><unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">Aychholtz</unclear> <unclear cert="medium" resp="#joint">zuegestandnen</unclear> laidts, auch <unclear cert="medium" resp="#joint">ande</unclear>-
<lb n="25"/><unclear cert="medium" resp="#joint">re</unclear> <unclear cert="medium" resp="#joint">hindernußen</unclear> halb, den angesetzten <unclear cert="low" resp="#joint">Rechtstag</unclear> noch
<lb n="26"/><date resp="#ner"><unclear cert="low" resp="#joint">zween</unclear> Monat</date> lang prorogiren, ain andern <unclear cert="low" resp="#joint">Rechts</unclear>-
<lb n="27"/>tag <unclear cert="low" resp="#joint">ernennen</unclear> und ansetzen, und <unclear cert="low" resp="#joint">Euich</unclear> hierinn so
<lb n="28"/><unclear cert="low" resp="#joint">wilfarig</unclear> und <unclear cert="low" resp="#joint">günstich</unclear> gegen ime <unclear cert="low" resp="#joint">Aychholtz</unclear> und <unclear cert="low" resp="#joint">si</unclear>-
<lb n="29"/>nen <unclear cert="medium" resp="#joint">mitverwandten</unclear> <unclear cert="low" resp="#joint">erweißen</unclear>, das sy <unclear cert="low" resp="#joint">dises</unclear> <unclear cert="low" resp="#joint">un</unclear>-
<lb n="30"/><unclear cert="low" resp="#joint">sers</unclear> fürschreibens <unclear cert="low" resp="#joint">fruchtbarlich</unclear> <unclear cert="low" resp="#joint">genoßen</unclear> <unclear cert="low" resp="#joint">haben</unclear>, im
<pb facs="StadtASG_Missive_1395_4924.jpg" n="2"/>
<lb n="31"/>werck, <unclear cert="medium" resp="#joint">künne</unclear> <unclear cert="medium" resp="#joint">niggen</unclear>. Das <unclear cert="medium" resp="#joint">seÿen</unclear> wir in <unclear cert="medium" resp="#joint">zuo</unclear>-
<lb n="32"/><unclear cert="medium" resp="#joint">tragenden</unclear> <unclear cert="medium" resp="#joint">fählen</unclear> umb <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">zuebeschulden</unclear> <unclear cert="low" resp="#joint">erbietig</unclear>.
<lb n="33"/>Datum den <origDate when="1602" resp="#ner">24 <unclear cert="medium" resp="#joint">Iulij</unclear> anno <unclear cert="low" resp="#joint">1602</unclear></origDate>.
<lb n="34"/>Verwalter der hauptmanschafft
<lb n="35"/><orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> <unclear cert="medium" resp="#joint">und</unclear> Rath der
<lb n="36"/>Statt Costantz</orgName>.
<pb facs="StadtASG_Missive_1395_4925.jpg" n="3"/>
<pb facs="StadtASG_Missive_1395_4926.jpg" n="4"/>
<lb n="37"/>Den fürsichtigen, ersamen und <unclear cert="low" resp="#joint">weysen</unclear>
<lb n="38"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister und rath zuo St. Gallen</orgName>,
<lb n="39"/>unsern besonders lieben guoten <unclear cert="low" resp="#joint">freünden</unclear>
