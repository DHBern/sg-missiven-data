<lb n="34"/>wegen unnß zuo Ehren, unnd gfallen, sich <unclear cert="low" resp="#joint">Ingelaßen</unclear>.
<lb n="35"/>Derowegen gelangt an üch <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidgnoßen</unclear></orgName>,
<pb facs="StadtASG_Missive_1847_6858.jpg" n="2"/>
<lb n="36"/>unser <unclear cert="medium" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">Eidtgnoeßisch</unclear> <unclear cert="low" resp="#joint">pit</unclear> und <unclear cert="low" resp="#joint">ersuochen</unclear>, Ir
