<p>
<pb facs="StadtASG_Missive_1877_6981.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Edle</unclear> veste <unclear cert="medium" resp="#joint">Ehrnvst</unclear> <unclear cert="medium" resp="#joint">Fuersichtig</unclear> und <unclear cert="medium" resp="#joint">weyse</unclear>, insonders
<lb n="2"/><unclear cert="medium" resp="#joint">guenstige</unclear> liebe herren, <unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">seyen</unclear> <unclear cert="low" resp="#joint">unßer</unclear> <unclear cert="low" resp="#joint">fruendt</unclear>-
<lb n="3"/><unclear cert="low" resp="#joint">nachparlich</unclear> dienst, und <unclear cert="medium" resp="#joint">waß</unclear> wir <unclear cert="medium" resp="#joint">vermoegen</unclear> zuvor.
<lb n="4"/><unclear cert="medium" resp="#joint">Demnach</unclear> wir <unclear cert="medium" resp="#joint">berichtet</unclear>, daß bey den herren, <unclear cert="low" resp="#joint">einer</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">gefengkhlich</unclear> <unclear cert="low" resp="#joint">einkhomen</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">hiegen</unclear> <unclear cert="low" resp="#joint">verhefften</unclear>
<lb n="6"/><persName resp="#ner"><unclear cert="low" resp="#joint">Cristoff</unclear> <unclear cert="low" resp="#joint">Weblinger</unclear></persName> oder <persName resp="#ner"><unclear cert="medium" resp="#joint">Weyßhuot</unclear></persName>, <placeName resp="#ner"><unclear cert="medium" resp="#joint">Zwygerburg</unclear></placeName>, <placeName resp="#ner"><unclear cert="medium" resp="#joint">Goellhaußen</unclear></placeName>,
<lb n="7"/><unclear cert="medium" resp="#joint">er</unclear> nit <unclear cert="medium" resp="#joint">ungleich</unclear> <unclear cert="medium" resp="#joint">seye</unclear>, sonder in <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">lagger</unclear> <unclear cert="low" resp="#joint">sein</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">gspanen</unclear> <unclear cert="low" resp="#joint">gaben</unclear> solle, <unclear cert="medium" resp="#joint">Allß</unclear> <unclear cert="medium" resp="#joint">gelangt</unclear> an die herren
<lb n="9"/><unclear cert="medium" resp="#joint">unßer</unclear> <unclear cert="medium" resp="#joint">dienst</unclear>- nachparlich <unclear cert="medium" resp="#joint">bitt</unclear>, und <unclear cert="medium" resp="#joint">freundtlich</unclear> <unclear cert="medium" resp="#joint">ersuochen</unclear>,
<lb n="10"/>die <unclear cert="medium" resp="#joint">wellen</unclear> unß bey <unclear cert="medium" resp="#joint">zeigeren</unclear>, <unclear cert="medium" resp="#joint">waß</unclear> namen und ge-
<lb n="11"/><unclear cert="medium" resp="#joint">stalt</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">gefangne</unclear> <unclear cert="medium" resp="#joint">seye</unclear>, und <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">er</unclear> biß <unclear cert="low" resp="#joint">dahero</unclear>, <unclear cert="low" resp="#joint">deß</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">obgemelten</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Cristoff</unclear> <unclear cert="low" resp="#joint">Weißhuot</unclear></persName>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">bekhendt</unclear> haben
<lb n="13"/>möchte, <unclear cert="medium" resp="#joint">unbeschwert</unclear> berichten, und <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">seinn</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">bekhandtnuß</unclear> <unclear cert="medium" resp="#joint">berueerten</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Weißhuot</unclear></persName> halber <unclear cert="medium" resp="#joint">werr</unclear>
<lb n="15"/>communicieren. Daran <unclear cert="medium" resp="#joint">Erweißen</unclear> unß die
<lb n="16"/>herren <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">sonderbar</unclear> gefallen, und wir <unclear cert="medium" resp="#joint">seyen</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">es</unclear> umb die herren in <unclear cert="medium" resp="#joint">gleichem</unclear> und <unclear cert="medium" resp="#joint">anderem</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">zuverdienen</unclear> erbietig. Datum <origPlace ref="stadtasg-places-5" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Arbon</unclear></origPlace>
<lb n="19"/>den <origDate when="1624-04-08" resp="#ner"><unclear cert="medium" resp="#joint">8ten</unclear> Aprilis Anno <unclear cert="medium" resp="#joint">1624</unclear></origDate>.
<lb n="20"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Stataman</unclear> und Rath
<lb n="21"/><unclear cert="medium" resp="#joint">daselbsten</unclear></orgName>.
<pb facs="StadtASG_Missive_1877_6982.jpg" n="2"/>
<pb facs="StadtASG_Missive_1877_6983.jpg" n="3"/>
<pb facs="StadtASG_Missive_1877_6984.jpg" n="4"/>
<lb n="22"/>Den Edlen, <unclear cert="low" resp="#joint">vesten</unclear>, <unclear cert="low" resp="#joint">Ehrsamen</unclear>, <unclear cert="low" resp="#joint">fuersichtigen</unclear> und <unclear cert="low" resp="#joint">weysen</unclear>
<lb n="23"/>Herren, <unclear cert="low" resp="#joint">N</unclear>. <unclear cert="low" resp="#joint">N</unclear>. <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">Raht</unclear> der Statt
<lb n="24"/><unclear cert="medium" resp="#joint">S</unclear>. Gallen</orgName>, <unclear cert="medium" resp="#joint">unsern</unclear> insonders <unclear cert="medium" resp="#joint">fruendtlichen</unclear> lieben
<lb n="25"/>Herren und <unclear cert="low" resp="#joint">Nachparn</unclear>
<lb n="26"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sanct</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
</p>
