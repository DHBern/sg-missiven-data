<p>
<pb facs="StadtASG_Missive_1983_7391.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">früntlich</unclear> <unclear cert="medium" resp="#joint">gruotz</unclear>, auch <unclear cert="medium" resp="#joint">waß</unclear> wir ehren, liebs, <unclear cert="medium" resp="#joint">unndt</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">guotes</unclear> <unclear cert="medium" resp="#joint">vermögendt</unclear> <unclear cert="medium" resp="#joint">zuovoor</unclear>, fromm, fürsichtig, <unclear cert="medium" resp="#joint">ehrsamm</unclear>, wyß,
<lb n="3"/><unclear cert="medium" resp="#joint">inßonders</unclear> <unclear cert="medium" resp="#joint">guott</unclear> fründt, <unclear cert="medium" resp="#joint">unndt</unclear> gethrüw lieb <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoßen</unclear></orgName>.
<lb n="4"/>Wir tragen <unclear cert="medium" resp="#joint">kheinen</unclear> <unclear cert="medium" resp="#joint">zwyffell</unclear>, ir <unclear cert="medium" resp="#joint">werdendt</unclear> üch <unclear cert="low" resp="#joint">vernünfftig</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">zueerinneren</unclear> <unclear cert="low" resp="#joint">wüßen</unclear>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">gstaldt</unclear> <unclear cert="low" resp="#joint">unßer</unclear> <unclear cert="low" resp="#joint">gewäßner</unclear> burger
<lb n="6"/><unclear cert="medium" resp="#joint">haubt</unclear>: <persName resp="#ner"><unclear cert="medium" resp="#joint">Hanß</unclear> <unclear cert="medium" resp="#joint">Schwaller</unclear></persName> <unclear cert="medium" resp="#joint">sälig</unclear>, für sich selbs, <unclear cert="medium" resp="#joint">unndt</unclear> <unclear cert="medium" resp="#joint">innammen</unclear>
<lb n="7"/>auch <unclear cert="medium" resp="#joint">unßers</unclear> burgers, <unclear cert="medium" resp="#joint">haubtman</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Urßen</unclear> von <unclear cert="medium" resp="#joint">Arxen</unclear></persName>, gegen
<lb n="8"/><unclear cert="medium" resp="#joint">unndt</unclear> wider die herren <persName resp="#ner">Keller</persName>, <unclear cert="medium" resp="#joint">unndt</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Rodtmundt</unclear></persName>, <unclear cert="medium" resp="#joint">üwere</unclear> burger
<lb n="9"/><unclear cert="medium" resp="#joint">by</unclear> üch <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St: Gallen</placeName>, wegen <unclear cert="medium" resp="#joint">irer</unclear> ansprachen, vor <unclear cert="medium" resp="#joint">edtwaß</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">zyts</unclear> in dem rechten gestanden, <unclear cert="medium" resp="#joint">unndt</unclear> welcher <unclear cert="medium" resp="#joint">gstaldt</unclear> <persName resp="#ner">Jacob
<lb n="11"/>Keller</persName> damalen <unclear cert="low" resp="#joint">ußgeschworen</unclear>. <unclear cert="low" resp="#joint">Diewyll</unclear> <unclear cert="low" resp="#joint">unndt</unclear> aber
<lb n="12"/><unclear cert="medium" resp="#joint">vorgedachtes</unclear> <unclear cert="medium" resp="#joint">haubtman</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Schwallers</unclear></persName> <unclear cert="medium" resp="#joint">säligen</unclear> erben, <unclear cert="medium" resp="#joint">unndt</unclear> consorten,
<lb n="13"/><unclear cert="medium" resp="#joint">der</unclear> damalen ergangnen urtheil in daß <unclear cert="medium" resp="#joint">khünfftig</unclear>, sich
<lb n="14"/><unclear cert="medium" resp="#joint">habendt</unclear> <unclear cert="medium" resp="#joint">zugebruchen</unclear> bedürfftig, <unclear cert="medium" resp="#joint">unndt</unclear> hochnothwendig, <unclear cert="medium" resp="#joint">alls</unclear>
<lb n="15"/>haben dieselben underthänig <unclear cert="medium" resp="#joint">unß</unclear> angelanget, inen <unclear cert="medium" resp="#joint">mit</unclear>
<lb n="16"/>intercession <unclear cert="medium" resp="#joint">ahn</unclear> üch <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">ersprießlich</unclear> <unclear cert="low" resp="#joint">zesin</unclear>, damit
<lb n="17"/>sye dieselbige <unclear cert="medium" resp="#joint">desto</unclear> <unclear cert="medium" resp="#joint">fürderlicher</unclear> <unclear cert="medium" resp="#joint">mögendt</unclear> <unclear cert="medium" resp="#joint">bekommen</unclear>, wyll
<lb n="18"/>wir nun, den <unclear cert="medium" resp="#joint">unßeren</unclear>, in <unclear cert="medium" resp="#joint">rechtmäßigen</unclear> sachen <unclear cert="medium" resp="#joint">zuo</unclear> willfahren
<lb n="19"/><unclear cert="medium" resp="#joint">geneiget</unclear>, <unclear cert="medium" resp="#joint">habendt</unclear> wir inen ir <unclear cert="medium" resp="#joint">pit</unclear> nit <unclear cert="medium" resp="#joint">versagen</unclear> können,
<lb n="20"/><unclear cert="medium" resp="#joint">langet</unclear> <unclear cert="medium" resp="#joint">derowegen</unclear>, <unclear cert="medium" resp="#joint">unßer</unclear> fründt, <unclear cert="medium" resp="#joint">unndt</unclear> <unclear cert="medium" resp="#joint">eydtgnoßisch</unclear> <unclear cert="medium" resp="#joint">pit</unclear>, <unclear cert="medium" resp="#joint">unndt</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">begeren</unclear> <unclear cert="medium" resp="#joint">ahn</unclear> üch, ir wellendt <unclear cert="medium" resp="#joint">ermelten</unclear> <unclear cert="medium" resp="#joint">unßeren</unclear> burgeren,
<lb n="22"/>die <unclear cert="medium" resp="#joint">vorangedüte</unclear> urtheil, wie, <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">wellcher</unclear> <unclear cert="low" resp="#joint">gstaldt</unclear>, <unclear cert="low" resp="#joint">vorgedachter</unclear>
<lb n="23"/>Jacob Keller <unclear cert="medium" resp="#joint">ußgeschworen</unclear>, under üwer <unclear cert="medium" resp="#joint">cantzley</unclear> signatur,
<lb n="24"/><unclear cert="medium" resp="#joint">unndt</unclear> wo <unclear cert="medium" resp="#joint">müglich</unclear> <unclear cert="medium" resp="#joint">latheynischer</unclear> sprach, <unclear cert="medium" resp="#joint">günstig</unclear> <unclear cert="medium" resp="#joint">zuokommen</unclear> laßen,
<pb facs="StadtASG_Missive_1983_7392.jpg" n="2"/>
<lb n="25"/><unclear cert="medium" resp="#joint">sich</unclear> derselben in <unclear cert="medium" resp="#joint">khuenfftiger</unclear> zeytt haben zuogebrauchen,
<lb n="26"/><unclear cert="medium" resp="#joint">hieran</unclear> <unclear cert="medium" resp="#joint">erwyßendt</unclear> ir <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">angenemmes</unclear> <unclear cert="medium" resp="#joint">wollgefallen</unclear>,
