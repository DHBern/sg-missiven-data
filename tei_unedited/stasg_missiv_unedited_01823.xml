        <body>
<p>
<pb facs="StadtASG_Missive_1823_6765.jpg" n="1"/>
<lb n="1"/>Unser frundtlich willig diennst sampt waß wir ehrenn
<lb n="2"/>liebs unnd guots vermögen zuovor, from fürsichtig ehrsam
<lb n="3"/>wyß innsonders guot fründt unnd gethrüw lieb Eydtgnossen.
<lb n="4"/>Vor unnß sindt <unclear cert="low" resp="#joint">ehrschinen</unclear> unnser gethrüwer lieber <unclear cert="low" resp="#joint">mitrath</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">houptman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Niclouß</unclear> <unclear cert="low" resp="#joint">Vogell</unclear></persName>, unnd <persName resp="#ner">Fridlÿ Åblÿ</persName>, unnß <unclear cert="low" resp="#joint">abermallen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">erjnneret</unclear> unnd zuoverstenn geben, wie daß innen vonn
<lb n="7"/>irem lieben <unclear cert="low" resp="#joint">vatteren</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Iosen</unclear> <unclear cert="low" resp="#joint">Mathÿ</unclear></persName> <unclear cert="low" resp="#joint">selgen</unclear>, <unclear cert="low" resp="#joint">etwaß</unclear> <unclear cert="low" resp="#joint">ererbten</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">guotliß</unclear> <unclear cert="low" resp="#joint">zuogefallen</unclear>, <unclear cert="low" resp="#joint">wellches</unclear> hab unnd guot nun ein zÿtlang
<lb n="9"/>vonn der <unclear cert="low" resp="#joint">oberkheit</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName> <unclear cert="low" resp="#joint">unnseren</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">verordtnen</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">vögtenn</unclear> <unclear cert="low" resp="#joint">jnn</unclear> <unclear cert="low" resp="#joint">arrest</unclear> <unclear cert="low" resp="#joint">gelegt</unclear> <unclear cert="low" resp="#joint">huß</unclear> unnd <unclear cert="low" resp="#joint">hoff</unclear> <unclear cert="low" resp="#joint">bschlossenn</unclear>, <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">khenn</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">annderen</unclear> <unclear cert="low" resp="#joint">ursach</unclear>, dann daß sÿ sächenn wellen, wie <unclear cert="low" resp="#joint">ireß</unclear> <unclear cert="low" resp="#joint">vatteren</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">selgenn</unclear> <unclear cert="low" resp="#joint">hanndell</unclear> unnd <unclear cert="low" resp="#joint">wanndell</unclear> beschaffen, sÿ jnn dem zÿtt
<lb n="13"/>ouch ehrfarenn wellen, ob <unclear cert="low" resp="#joint">Wolffganng</unclear> <unclear cert="low" resp="#joint">Mathÿ</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">jn</unclear> <unclear cert="low" resp="#joint">läben</unclear>
<lb n="14"/>oder nitt. Welliches sÿ nun ein <unclear cert="low" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">zÿt</unclear> <unclear cert="low" resp="#joint">ver</unclear> <unclear cert="low" resp="#joint">wÿllet</unclear>, <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">jnen</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">vonn</unclear> gemelten <orgName ref="stadtasg-actors-148" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">S</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>.</orgName> unnd anntwürtt ehr volgen, deßo
<lb n="16"/>sÿ alleß mitt gedult uß gestannden. Nach gönntz aber <unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">jnen</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">huß</unclear> unnd hoff hußrat unnd waß da gesÿnn sampt den <unclear cert="low" resp="#joint">gelt</unclear> <unclear cert="low" resp="#joint">schulden</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">über</unclear> <unclear cert="low" resp="#joint">geben</unclear> unnd <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">gestelt</unclear> worden, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">verhoffent</unclear> <unclear cert="low" resp="#joint">menigklichen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">red</unclear> unnd anntwürtt <unclear cert="low" resp="#joint">ehrvolgt</unclear>, <unclear cert="low" resp="#joint">Jiedoch</unclear> aber habenn die
<lb n="20"/>verordneten vögt unnser <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">vonn</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Santt</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></placeName> <unclear cert="low" resp="#joint">etwaß</unclear>
<lb n="21"/>hab unnd <unclear cert="low" resp="#joint">guot</unclear> <unclear cert="low" resp="#joint">jnnen</unclear> <unclear cert="low" resp="#joint">bhalten</unclear> <unclear cert="low" resp="#joint">dergestalt</unclear> unnd <unclear cert="low" resp="#joint">fürsechung</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">gethon</unclear>, <unclear cert="low" resp="#joint">wann</unclear> <unclear cert="low" resp="#joint">Wolffganng</unclear> <unclear cert="low" resp="#joint">Mathÿ</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">jnn</unclear> <unclear cert="low" resp="#joint">läben</unclear> und widerumb
<lb n="23"/><unclear cert="low" resp="#joint">annheimbsch</unclear> <unclear cert="low" resp="#joint">wurde</unclear>, <unclear cert="low" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">ehinndurch</unclear> <unclear cert="low" resp="#joint">dester</unclear> <unclear cert="low" resp="#joint">baß</unclear> <unclear cert="low" resp="#joint">ehrhalten</unclear> <unclear cert="low" resp="#joint">möchte</unclear>,
<lb n="24"/><unclear cert="low" resp="#joint">derwÿllenn</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">wÿll</unclear> unnd aber, <unclear cert="low" resp="#joint">vonn</unclear> <unclear cert="low" resp="#joint">villgemeltem</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Wolff</unclear>-
<lb n="25"/>ganng Mathÿ</persName>, weder wÿt noch nach niemanndts kann Jn wissen
<lb n="26"/>unnd ehrfaren khonne, so sÿe eß nun billich daß man <unclear cert="low" resp="#joint">jnnen</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">übrig</unclear> <unclear cert="low" resp="#joint">hab</unclear> unnd guot, guottlichen welle volgen lassen. Eß sÿe
<lb n="28"/>dann <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">mallen</unclear> <unclear cert="low" resp="#joint">etwaß</unclear> darumb <unclear cert="low" resp="#joint">ufflegen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">Mathÿ</unclear> <unclear cert="low" resp="#joint">jnn</unclear> <unclear cert="low" resp="#joint">läbenn</unclear> <unclear cert="low" resp="#joint">sÿe</unclear>, <unclear cert="low" resp="#joint">muossen</unclear> <unclear cert="low" resp="#joint">sÿ</unclear> ouch <unclear cert="low" resp="#joint">darankhomen</unclear>,
<lb n="30"/>unnd <unclear cert="low" resp="#joint">sind</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">ann</unclear> <unclear cert="low" resp="#joint">ehrpietens</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">usstendig</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">houptguot</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">zweÿ</unclear> oder <unclear cert="low" resp="#joint">drü</unclear> <unclear cert="low" resp="#joint">jar</unclear> <unclear cert="low" resp="#joint">gnuogsame</unclear> <unclear cert="low" resp="#joint">burgschafft</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">zuostellen</unclear>. <unclear cert="low" resp="#joint">Derehalbenn</unclear> <unclear cert="low" resp="#joint">jr</unclear> fründtlich unnd höchstes pittenn
<lb n="33"/>ann unnß, wir wellent jnnen mitt fürgschrifft ann üch
<lb n="34"/>unnser G. l. E. mittzüchertten unbeschwert sÿnn jnnhoffnung
<lb n="35"/>deren woll zuogeniessen. Innd so wir der unnseren
<pb facs="StadtASG_Missive_1823_6766.jpg" n="2"/>
<lb n="36"/><unclear cert="low" resp="#joint">pitt</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">bageren</unclear> <unclear cert="low" resp="#joint">anngoehert</unclear>, unnd verstannden, die selbig
<lb n="37"/>nit unnfueklich achten, unnd <unclear cert="low" resp="#joint">befinden</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">gelanngt</unclear> <unclear cert="low" resp="#joint">ann</unclear> üch
<lb n="38"/>unnser <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>., unnser früntlich eidtgnossisch pitten, ir
<lb n="39"/>wellendt den unnseren iren noch <unclear cert="low" resp="#joint">ußstend</unclear> <unclear cert="low" resp="#joint">erbguot</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">guotwilliklichen</unclear> <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">wyteren</unclear> uffzug volgen lassen, da <unclear cert="low" resp="#joint">woll</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">vermuoden</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Wolffganng</unclear> <unclear cert="low" resp="#joint">Matz</unclear></persName> nit mehr im läben sige,
<lb n="42"/>unnd die <unclear cert="low" resp="#joint">zyllszyt</unclear> <unclear cert="low" resp="#joint">izt</unclear> nach üwerem begeren burgschafft
<lb n="43"/>zestellen diner porten uff <unclear cert="low" resp="#joint">nüw</unclear> <unclear cert="low" resp="#joint">drü</unclear> <unclear cert="low" resp="#joint">jar</unclear>, <unclear cert="low" resp="#joint">unnsers</unclear> <unclear cert="low" resp="#joint">erachtens</unclear> <unclear cert="low" resp="#joint">sy</unclear> unnser
<lb n="44"/><unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">wolldaran</unclear> <unclear cert="low" resp="#joint">khomen</unclear> <unclear cert="low" resp="#joint">moegen</unclear>, dann <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">dasselb</unclear> <unclear cert="low" resp="#joint">beidenn</unclear>
<lb n="45"/><unclear cert="low" resp="#joint">heillen</unclear> <unclear cert="low" resp="#joint">mangelbar</unclear>, <unclear cert="low" resp="#joint">wuover</unclear> ir aber hierumb <unclear cert="low" resp="#joint">etwaz</unclear> <unclear cert="low" resp="#joint">schÿns</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">uffzelegen</unclear> <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">Matz</unclear> <unclear cert="low" resp="#joint">noch</unclear> im läben, sy dass ouch glouben,
<lb n="47"/>muossen, unnd üch gegen den unnseren hierinen so
<lb n="48"/>gnedig unnd günstig bewyssen unnd erzeigen wie unnser
<lb n="49"/>sonnder guot verthruwen zuo üch stadt, unnd die <unclear cert="low" resp="#joint">unseren</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">spueren</unclear> <unclear cert="low" resp="#joint">khoenen</unclear>, <unclear cert="low" resp="#joint">diser</unclear> unnser <unclear cert="low" resp="#joint">fürgschrifft</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">pitt</unclear> ouch
<lb n="51"/>üwere oberkheitliche hilff würklichen gnossen haben.
<lb n="52"/>Daß stadt umb mehr gemelt unnser <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>. und die iren,
<lb n="53"/>unns iederzyt inn allen zuotragenden fällen, unnd bekhomen-
<lb n="54"/>den <unclear cert="low" resp="#joint">glegenheiten</unclear> <unclear cert="low" resp="#joint">gannz</unclear> <unclear cert="low" resp="#joint">diennst</unclear> unnd früntlich, ouch
<lb n="55"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">allem</unclear> <unclear cert="low" resp="#joint">eidtgnossischem</unclear> <unclear cert="low" resp="#joint">thruwen</unclear> <unclear cert="low" resp="#joint">guotwilligklich</unclear> zuo be-
<lb n="56"/>schulden unnd zuo verdienen, damit unns alle gottes
<lb n="57"/>gnediger allmacht thrüwlich unnd <unclear cert="low" resp="#joint">wollbevelchende</unclear>.
<lb n="58"/><unclear cert="low" resp="#joint">Datum</unclear> den <origDate when="1613-03-02" resp="#ner">2. tag Merzen ao 1613</origDate>.
<lb n="59"/>Unnd sindt von üch unnseren <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">l</unclear>. <unclear cert="low" resp="#joint">e</unclear>. <unclear cert="low" resp="#joint">g</unclear>. <unclear cert="low" resp="#joint">zeigeren</unclear> <unclear cert="low" resp="#joint">disem</unclear>
<lb n="60"/>hierumb verschriben poten einer früntlich antwurth
<lb n="61"/>gewertig.
<lb n="62"/><orgName role="issuer" resp="#ner">Stathalter unnd rath
<lb n="63"/>zuo Glaruß</orgName>
<pb facs="StadtASG_Missive_1823_6767.jpg" n="3"/>
<pb facs="StadtASG_Missive_1823_6768.jpg" n="4"/>
<lb n="64"/>Den <unclear cert="medium" resp="#joint">fromen</unclear>, fürsichtigen, <unclear cert="medium" resp="#joint">ehrsamen</unclear>,
<lb n="65"/>weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">Raht</unclear>
<lb n="66"/>der statt Sanct Gallen</orgName>, <unclear cert="low" resp="#joint">unserenn</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">guoten</unclear> fründen und <unclear cert="medium" resp="#joint">getrüwenn</unclear>
<lb n="68"/>lieben <unclear cert="medium" resp="#joint">eydgnoßen</unclear>.
</p>
