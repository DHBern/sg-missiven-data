<p>
<pb facs="StadtASG_Missive_1318_4533.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich willig diennst. sampt was
<lb n="2"/>wir Eeren liebs unnd guets vermoegen, zuvor
<lb n="3"/><unclear cert="low" resp="#joint">Frommen</unclear>. Fuersichtig. Ersam, Wyß. <unclear cert="low" resp="#joint">Innsonders</unclear>
<lb n="4"/>guet fründt. unnd gethrüwen lieben Eydtgnossen
<lb n="5"/><unclear cert="low" resp="#joint">Alsdann</unclear> <unclear cert="low" resp="#joint">verruckhter</unclear> tagen Unnser Burger
<lb n="6"/><persName resp="#ner">Daniel Schmidt</persName>s die <unclear cert="low" resp="#joint">schuldt</unclear> menschlicher Natur
<lb n="7"/>bezalt hat, Deme der Allmechtig gnedig
<lb n="8"/>unnd barmhertzig <unclear cert="low" resp="#joint">syn</unclear>. unnd die froeliche <unclear cert="low" resp="#joint">uffer</unclear>-
<lb n="9"/><unclear cert="low" resp="#joint">stendtnuß</unclear> <unclear cert="low" resp="#joint">verlyhen</unclear> <unclear cert="low" resp="#joint">welle</unclear>, Unnd <unclear cert="medium" resp="#joint">ußery</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">hiex</unclear> <unclear cert="medium" resp="#joint">verlassene</unclear> <unclear cert="medium" resp="#joint">gesipuerwandte</unclear>. unnd
<lb n="11"/><unclear cert="medium" resp="#joint">nechste</unclear> Erben. <unclear cert="low" resp="#joint">deßengwüßne</unclear> <unclear cert="low" resp="#joint">sin</unclear> Daniel
<lb n="12"/>Schmidts saeligen <unclear cert="medium" resp="#joint">hinderlaßne</unclear> haab unnd guet
<lb n="13"/>so <unclear cert="medium" resp="#joint">mehrer</unclear> <unclear cert="medium" resp="#joint">theil</unclear> Inn üwer Statt <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sanct Gallen</placeName>
<lb n="14"/>ligen soll, <unclear cert="medium" resp="#joint">zuevertheilen</unclear> <unclear cert="medium" resp="#joint">undernsohen</unclear> <unclear cert="medium" resp="#joint">werden</unclear>,
<lb n="15"/>Diewyl dann Daniel Schmidt saeliger unns
<lb n="16"/>mit <unclear cert="low" resp="#joint">Burckhrecht</unclear> <unclear cert="low" resp="#joint">zuegethon</unclear>. unnd <unclear cert="low" resp="#joint">underhemidt</unclear>
<lb n="17"/>gewesen, sin haab unnd guet. Inn unnser Statt
<lb n="18"/><unclear cert="low" resp="#joint">stühr</unclear> gelegen, Unnd diewyl sin <unclear cert="low" resp="#joint">verlaßne</unclear>
<lb n="19"/>haab unnd guet. an die <unclear cert="medium" resp="#joint">freembde</unclear> <unclear cert="medium" resp="#joint">Usserthalb</unclear>
<lb n="20"/>unnser Statt <placeName ref="stadtasg-places-185" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schafhußen</unclear></placeName> <unclear cert="low" resp="#joint">ußerertheit</unclear> Erblich
<lb n="21"/>vertheilt <unclear cert="low" resp="#joint">wirdet</unclear>, Derowegen damit
<lb n="22"/>wir <unclear cert="medium" resp="#joint">sines</unclear> <unclear cert="medium" resp="#joint">hinderlaßne</unclear> haab unnd guets
<lb n="23"/><unclear cert="low" resp="#joint">grundtlichen</unclear> bericht habendt, So ist <unclear cert="low" resp="#joint">hieruff</unclear>
<lb n="24"/>unnser fründtlich <unclear cert="low" resp="#joint">ansinnen</unclear>. <unclear cert="low" resp="#joint">Pitten</unclear> unnd
<lb n="25"/>begeren, an üch. Ir wöllen <unclear cert="medium" resp="#joint">Ohn</unclear> <unclear cert="medium" resp="#joint">beschwerdt</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">syn</unclear>. <unclear cert="medium" resp="#joint">an</unclear> Ordnung unnd <unclear cert="low" resp="#joint">befehlch</unclear> geben
<lb n="27"/>lassen, das üch <unclear cert="low" resp="#joint">Gedachtz</unclear> Daniel Schmidts
<lb n="28"/><unclear cert="low" resp="#joint">verordtnete</unclear> <unclear cert="low" resp="#joint">Vögt</unclear>. Oder aber die Jhenigen
<lb n="29"/>so <unclear cert="low" resp="#joint">Ehgedachtz</unclear> Daniel <unclear cert="low" resp="#joint">Schmidt</unclear> saeligen haab
<lb n="30"/>unnd guet <unclear cert="medium" resp="#joint">zueverwalten</unclear> <unclear cert="medium" resp="#joint">under</unclear> <unclear cert="medium" resp="#joint">handen</unclear>
<lb n="31"/>haben, schrifftlich <unclear cert="low" resp="#joint">zuestellen</unclear>, unnd dann unns
<lb n="32"/><unclear cert="low" resp="#joint">dasselbig</unclear> unnd <unclear cert="medium" resp="#joint">was</unclear> <unclear cert="medium" resp="#joint">Jedem</unclear> <unclear cert="medium" resp="#joint">Erben</unclear> <unclear cert="medium" resp="#joint">Innsonders</unclear>
<lb n="33"/><unclear cert="medium" resp="#joint">gepüren</unclear> mag. schrifftlich <unclear cert="low" resp="#joint">überschikhen</unclear> wöllen,
<pb facs="StadtASG_Missive_1318_4534.jpg" n="2"/>
<lb n="34"/>Unnd damit wir dann <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">geürenden</unclear>
<lb n="35"/><unclear cert="medium" resp="#joint">abzug</unclear> <unclear cert="medium" resp="#joint">zuerfordern</unclear> unnd <unclear cert="low" resp="#joint">zuenntpfachen</unclear> <unclear cert="low" resp="#joint">wüssind</unclear>,
<lb n="36"/>so <unclear cert="medium" resp="#joint">wöllen</unclear> Ir <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">zuovorane</unclear> <unclear cert="low" resp="#joint">Bhren</unclear> unnd
<lb n="37"/><unclear cert="low" resp="#joint">gfellen</unclear> <unclear cert="low" resp="#joint">nuedzit</unclear> <unclear cert="low" resp="#joint">hinvueg</unclear> <unclear cert="low" resp="#joint">ziechen</unclear>, sonnders
<lb n="38"/><unclear cert="low" resp="#joint">doß</unclear> <unclear cert="low" resp="#joint">Jedeß</unclear> so <unclear cert="low" resp="#joint">Irben</unclear> <unclear cert="low" resp="#joint">geürenden</unclear> <unclear cert="low" resp="#joint">theil</unclear>. <unclear cert="low" resp="#joint">Inn</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">Arest</unclear>. <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">verpott</unclear> <unclear cert="low" resp="#joint">annlegen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>,
<lb n="40"/><unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">lanng</unclear> <unclear cert="low" resp="#joint">biß</unclear> sie unnd <unclear cert="low" resp="#joint">Ieder</unclear> <unclear cert="low" resp="#joint">Innsunders</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">unnsern</unclear> gehörenden <unclear cert="medium" resp="#joint">abzug</unclear>,
<lb n="42"/><unclear cert="medium" resp="#joint">vernuegt</unclear> unnd <unclear cert="medium" resp="#joint">bezalt</unclear> haben, Das
<lb n="43"/><unclear cert="medium" resp="#joint">begeren</unclear> wir umb üch <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">getrüw</unclear>
<lb n="44"/>lieb <orgName role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Eydtgnoßen</unclear></orgName>. <unclear cert="medium" resp="#joint">Inn</unclear> <unclear cert="medium" resp="#joint">glychem</unclear> unnd <unclear cert="medium" resp="#joint">mhererm</unclear>
<lb n="45"/><unclear cert="medium" resp="#joint">fründtlich</unclear> widerumb <unclear cert="medium" resp="#joint">zubeschulden</unclear>, üch unnd
<lb n="46"/><unclear cert="medium" resp="#joint">unnß</unclear> <unclear cert="medium" resp="#joint">alle</unclear> hiemit Inn <unclear cert="medium" resp="#joint">denn</unclear> gnedigen <unclear cert="medium" resp="#joint">schirm</unclear>
<lb n="47"/><unclear cert="medium" resp="#joint">deß</unclear> Allmechtigen <unclear cert="medium" resp="#joint">befelchende</unclear>, Datum
<lb n="48"/><origDate when="1561" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">den</unclear>. <unclear cert="medium" resp="#joint">27</unclear>. <unclear cert="medium" resp="#joint">d</unclear>. Augusti. anno <unclear cert="medium" resp="#joint">lxi</unclear>.</origDate>
<lb n="49"/><orgName ref="stadtasg-actors-28" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear>, unnd <unclear cert="medium" resp="#joint">Rhat</unclear>.
<lb n="50"/>der Statt <unclear cert="medium" resp="#joint">Schafhusen</unclear></orgName>.
<pb facs="StadtASG_Missive_1318_4535.jpg" n="3"/>
<pb facs="StadtASG_Missive_1318_4536.jpg" n="4"/>
<lb n="51"/>Den frommen, <unclear cert="low" resp="#joint">fuersichtigen</unclear>,
<lb n="52"/><unclear cert="low" resp="#joint">ersammen</unclear> unnd wysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Bur-
