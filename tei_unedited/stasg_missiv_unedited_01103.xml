<p>
<pb facs="StadtASG_Missive_1103_3525.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="medium" resp="#joint">frundtliche</unclear> willig diennst, zuvor <unclear cert="medium" resp="#joint">fuersichtigen</unclear>
<lb n="2"/>ersamen weisen besonndern lieben <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">guetten</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">freundt</unclear> <unclear cert="low" resp="#joint">etc</unclear>. <unclear cert="low" resp="#joint">Auff</unclear> <unclear cert="low" resp="#joint">euwer</unclear> unns <unclear cert="medium" resp="#joint">jungst</unclear> <unclear cert="medium" resp="#joint">gethanes</unclear> <unclear cert="medium" resp="#joint">schreib</unclear>-
<lb n="4"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">begeren</unclear>, <unclear cert="medium" resp="#joint">euch</unclear> unnserer <unclear cert="medium" resp="#joint">goldtschmiden</unclear> <unclear cert="medium" resp="#joint">ord</unclear>-
<lb n="5"/>nung <unclear cert="low" resp="#joint">zueberichten</unclear>. So <unclear cert="medium" resp="#joint">ubersennden</unclear> wir
<lb n="6"/><unclear cert="medium" resp="#joint">euch</unclear> hiemit dieselbigen ordnung, wie wir die
<lb n="7"/>unnsern <unclear cert="medium" resp="#joint">goldtschmiden</unclear> des verganngnen, <unclear cert="low" resp="#joint">sechs</unclear> unnd
<lb n="8"/><unclear cert="low" resp="#joint">sybentzigisten</unclear> <unclear cert="low" resp="#joint">jars</unclear> <unclear cert="low" resp="#joint">erneuwert</unclear> <unclear cert="low" resp="#joint">etc</unclear>. <unclear cert="low" resp="#joint">Unnd</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">sygen</unclear> <unclear cert="low" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">jederzeit</unclear> <unclear cert="low" resp="#joint">frundtliche</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">nachbeur</unclear>-
<lb n="10"/>liche lieb unnd diennst <unclear cert="medium" resp="#joint">zuerzaigen</unclear>, genaigt <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="11"/>willig. Datum <origDate when="1579-04-28" cert="medium" resp="#ner">28 <unclear cert="medium" resp="#joint">aprilis</unclear> <unclear cert="medium" resp="#joint">a°</unclear> etc. <unclear cert="low" resp="#joint">lxxviiii</unclear></origDate>
<lb n="12"/><unclear cert="low" resp="#joint">Verwalter</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">hauptmanschafft</unclear>
<lb n="13"/><orgName ref="stadtasg-actors-587" cert="medium" role="issuer" resp="#ner">burgermaister und rath der statt
<lb n="14"/><unclear cert="low" resp="#joint">Costanntz</unclear></orgName> <unclear cert="low" resp="#joint">etc</unclear>.
<pb facs="StadtASG_Missive_1103_3526.jpg" n="2"/>
