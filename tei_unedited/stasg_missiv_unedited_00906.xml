    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_906_2639.jpg" n="1"/>
<lb n="1"/>Fromm Erenvest fürsichtig, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">wyß</unclear>, <unclear cert="low" resp="#joint">günstig</unclear> <unclear cert="low" resp="#joint">lieb</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">Herren</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">fründ</unclear>, <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">syen</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">früntlich</unclear> unnd
<lb n="3"/>guotwillig <unclear cert="low" resp="#joint">dienst</unclear>, <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">eeren</unclear> <unclear cert="low" resp="#joint">liebs</unclear> unnd
<lb n="4"/><unclear cert="low" resp="#joint">guots</unclear> <unclear cert="low" resp="#joint">berait</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, Es ist unns die <unclear cert="low" resp="#joint">predicathur</unclear>
<lb n="5"/>zuo <placeName resp="#ner">Sirnach</placeName> darüber wir rechter colathor unnd
<lb n="6"/>lehenherr sind, ledig worden, unnd diewyl
<lb n="7"/>dann wir nitt grad angendts ain annderen <unclear cert="low" resp="#joint">pred</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">iger</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">bestimpte</unclear> <unclear cert="low" resp="#joint">pfruond</unclear> <unclear cert="low" resp="#joint">überkomen</unclear> <unclear cert="low" resp="#joint">koennen</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">ald</unclear> <unclear cert="low" resp="#joint">moegen</unclear>, <unclear cert="low" resp="#joint">derhalben</unclear> so haben wir Herr <persName resp="#ner">Ruodolf
<lb n="10"/><unclear cert="low" resp="#joint">Mundtprathen</unclear></persName> <unclear cert="low" resp="#joint">geweßner</unclear> <unclear cert="low" resp="#joint">prediger</unclear> zuo <placeName resp="#ner">Lustorff</placeName>,
<lb n="11"/>uwer mittburger, früntlich ankert unnd <unclear cert="low" resp="#joint">gepett</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">welle</unclear> unns <unclear cert="low" resp="#joint">soeliche</unclear> <unclear cert="low" resp="#joint">pfruond</unclear> <unclear cert="low" resp="#joint">etwar</unclear> <unclear cert="low" resp="#joint">zyts</unclear> <unclear cert="low" resp="#joint">lang</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">bis</unclear> das <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">ainem</unclear> <unclear cert="low" resp="#joint">annderen</unclear> <unclear cert="low" resp="#joint">versehen</unclear> <unclear cert="low" resp="#joint">werd</unclear>,
<lb n="14"/><unclear cert="low" resp="#joint">versehen</unclear>, <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">er</unclear> sich nun gegen unns zethuon
<lb n="15"/>gern unnd guotwillig <unclear cert="low" resp="#joint">erpotten</unclear>, <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">vor</unclear>-
<lb n="16"/><unclear cert="low" resp="#joint">behalt</unclear>. <unclear cert="low" resp="#joint">So</unclear> <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">selbig</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">als</unclear> <unclear cert="low" resp="#joint">sinen</unclear> <unclear cert="low" resp="#joint">günst</unclear>-
<lb n="17"/>igen lieben Herren, von dennen dann er zuo
<lb n="18"/>ainem burger inn uwer statt uff unnd ange-
<lb n="19"/><unclear cert="low" resp="#joint">nomen</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">gnedig</unclear> <unclear cert="low" resp="#joint">vergünstiget</unclear>. unnd zuo-
<lb n="20"/>glassen werde, Hierumb so ge-
<lb n="21"/>lanngt an üch unnser früntlich pittlich ansuoch
<lb n="22"/>unnd begeren, das ir gesagten Herr Ruodolff
<lb n="23"/>Mundtprathen, das selbig wie <unclear cert="low" resp="#joint">vorbestimpt</unclear> <unclear cert="low" resp="#joint">unns</unclear>-
<lb n="24"/><unclear cert="low" resp="#joint">ere</unclear> <unclear cert="low" resp="#joint">pfruond</unclear> <unclear cert="low" resp="#joint">etwar</unclear> <unclear cert="low" resp="#joint">zyts</unclear> <unclear cert="low" resp="#joint">lanng</unclear> <unclear cert="low" resp="#joint">bis</unclear> <unclear cert="low" resp="#joint">das</unclear> wir
<lb n="25"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">ainem</unclear> <unclear cert="low" resp="#joint">annderen</unclear> <unclear cert="low" resp="#joint">prediger</unclear> <unclear cert="low" resp="#joint">versehen</unclear> <unclear cert="low" resp="#joint">werd</unclear>.
<lb n="26"/><unclear cert="low" resp="#joint">versehen</unclear> lassen wellen, als unns nit zwyff-
<lb n="27"/>lett ir soelichs unnserm begeren nach thuon werd,
<lb n="28"/>das wellen wir umb üch inn derglichen mer-
<lb n="29"/>er unnd minderm früntlich zuobeschulden unnd
<lb n="30"/>zuoverdiennen hab. dat den <origDate when="1588-10-09" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">9</unclear> <unclear cert="low" resp="#joint">t</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">octobris</unclear> anno 88</origDate>,
<lb n="32"/><persName role="issuer" resp="#ner">Hainricus</persName> von <unclear cert="low" resp="#joint">gottes</unclear> <unclear cert="low" resp="#joint">gnad</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">abbte</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">gotzhus</unclear> <orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Fisching</unclear></orgName>,
<pb facs="StadtASG_Missive_906_2640.jpg" n="2"/>
<lb n="34"/>[]
<pb facs="StadtASG_Missive_906_2641.jpg" n="3"/>
<pb facs="StadtASG_Missive_906_2642.jpg" n="4"/>
<lb n="35"/>Den fromen, <unclear cert="low" resp="#joint">eerenvesten</unclear>, fuersichtigen und
<lb n="36"/>wysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister unnd Rath der Statt
<lb n="37"/>Sannt Gallen</orgName>, unnsern guenstigen,
<lb n="38"/>lieben Herren unnd <unclear cert="low" resp="#joint">frunden</unclear>.
</p>
