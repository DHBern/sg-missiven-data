<p>
<pb facs="StadtASG_Missive_848_2349.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freündtlich</unclear> willig diennst <unclear cert="low" resp="#joint">zuovor</unclear>. Ersamen unnd
<lb n="2"/>weisen. lieben unnd gueten <unclear cert="low" resp="#joint">freünd</unclear>. E. E. <unclear cert="low" resp="#joint">wt</unclear>. schreiben,
<lb n="3"/>betreffend den <unclear cert="low" resp="#joint">sackh</unclear> mit kernen so in derselben <unclear cert="low" resp="#joint">statt</unclear>
<lb n="4"/>kommen. unnd hernach <unclear cert="low" resp="#joint">derselben</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Thoman</unclear> <unclear cert="low" resp="#joint">Pfund</unclear></persName>,
<lb n="5"/>zuo <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rorschach</unclear></placeName> <unclear cert="low" resp="#joint">etlichemal</unclear> <unclear cert="low" resp="#joint">nachein</unclear> <unclear cert="low" resp="#joint">anndern</unclear>. mit <unclear cert="low" resp="#joint">etwas</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">ungleichen</unclear> worten <unclear cert="medium" resp="#joint">aus</unclear> unnsers <unclear cert="low" resp="#joint">Gredmeisters</unclear> be-
<lb n="7"/><unclear cert="medium" resp="#joint">velche</unclear> <unclear cert="medium" resp="#joint">angesprochen</unclear> sölle. haben wir seins <unclear cert="low" resp="#joint">außfier</unclear>-
<lb n="8"/>lichen innhalts. nach <unclear cert="medium" resp="#joint">leünge</unclear> vernommen. Und
<lb n="9"/>geben E. E. <unclear cert="medium" resp="#joint">wt</unclear> <unclear cert="medium" resp="#joint">darauf</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear> <unclear cert="medium" resp="#joint">zuerkennen</unclear>. Das
<lb n="10"/>unnser <unclear cert="medium" resp="#joint">kornhauß</unclear> ordnung ist. unnd vermag so ein
<lb n="11"/><unclear cert="medium" resp="#joint">schiffman</unclear> <unclear cert="medium" resp="#joint">einen</unclear> frembden <unclear cert="medium" resp="#joint">sackh</unclear> <unclear cert="medium" resp="#joint">hinweg</unclear> <unclear cert="medium" resp="#joint">füert</unclear>. Das
<lb n="12"/>er denselben widerumben <unclear cert="low" resp="#joint">alheer</unclear> in unnser kornhauß
<lb n="13"/>stellen soll, unnd <unclear cert="medium" resp="#joint">mueß</unclear>, <unclear cert="medium" resp="#joint">darmit</unclear> <unclear cert="medium" resp="#joint">man</unclear> desselbigen halben,
<lb n="14"/>guete <unclear cert="medium" resp="#joint">erkhundigung</unclear> <unclear cert="medium" resp="#joint">thuon</unclear> künde. <unclear cert="medium" resp="#joint">Dannen</unclear> <unclear cert="medium" resp="#joint">heer</unclear> <unclear cert="medium" resp="#joint">bemelter</unclear>
<lb n="15"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Thoman</unclear> <unclear cert="medium" resp="#joint">Pfundt</unclear></persName>. unnsern <unclear cert="medium" resp="#joint">marckht</unclear> <unclear cert="medium" resp="#joint">versehern</unclear> <unclear cert="medium" resp="#joint">sollchen</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">sackh</unclear> mit dem <unclear cert="low" resp="#joint">bendel</unclear> <unclear cert="low" resp="#joint">zeichen</unclear>. Das <unclear cert="medium" resp="#joint">sollches</unclear> <unclear cert="medium" resp="#joint">rot</unclear> <unclear cert="medium" resp="#joint">schwartz</unclear>
<lb n="17"/>unnd <unclear cert="medium" resp="#joint">weiß</unclear>. <unclear cert="medium" resp="#joint">krie</unclear> <unclear cert="medium" resp="#joint">thuech</unclear> sein soll, angezeigt, <unclear cert="low" resp="#joint">Darauff</unclear>
<lb n="18"/><unclear cert="medium" resp="#joint">sÿ</unclear> <unclear cert="low" resp="#joint">ime</unclear> <unclear cert="low" resp="#joint">uferlegt</unclear>. denselben <unclear cert="low" resp="#joint">widerumb</unclear> der ordnung
<lb n="19"/><unclear cert="low" resp="#joint">alheer</unclear> ze stellen. Dieweil aber
<lb n="20"/><unclear cert="medium" resp="#joint">sollches</unclear> durch <unclear cert="low" resp="#joint">ine</unclear> <unclear cert="low" resp="#joint">uff</unclear> etliche <unclear cert="low" resp="#joint">bevelch</unclear> nit beschehen, unnd
<lb n="21"/>aber der kern durch E. E. <unclear cert="medium" resp="#joint">wt</unclear>. <unclear cert="medium" resp="#joint">Gredmeister</unclear> ver-
<lb n="22"/>kaufft. der leer <unclear cert="low" resp="#joint">sackh</unclear> <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">burger</unclear>. <persName resp="#ner"><unclear cert="low" resp="#joint">Martin</unclear> <unclear cert="low" resp="#joint">Maürer</unclear></persName>
<lb n="23"/><unclear cert="low" resp="#joint">zuogestellt</unclear> <unclear cert="low" resp="#joint">worden</unclear>, haben <unclear cert="medium" resp="#joint">sÿ</unclear> <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">nohmalen</unclear> mit
<lb n="24"/>ernnst <unclear cert="low" resp="#joint">uferlegt</unclear>. Das <unclear cert="low" resp="#joint">erlößt</unclear> gelt. sampt dem <unclear cert="low" resp="#joint">bendel</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">zeichin</unclear> <unclear cert="low" resp="#joint">alheer</unclear> <unclear cert="low" resp="#joint">zebringen</unclear>. Unnd dieweil dann <unclear cert="medium" resp="#joint">ein</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">sollches</unclear> unnser ordnung. So ist an E. E. <unclear cert="low" resp="#joint">wt</unclear>. <unclear cert="low" resp="#joint">unnser</unclear>
<pb facs="StadtASG_Missive_848_2350.jpg" n="2"/>
<lb n="27"/><unclear cert="medium" resp="#joint">freundtlich</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">vleissig</unclear> <unclear cert="medium" resp="#joint">bitt</unclear>. Sie <unclear cert="medium" resp="#joint">wolle</unclear> <unclear cert="medium" resp="#joint">bemelt</unclear> gelt
<lb n="28"/>sambt dem <unclear cert="low" resp="#joint">bendel</unclear> <unclear cert="low" resp="#joint">zaichin</unclear>, unns durch den <placeName resp="#ner"><unclear cert="low" resp="#joint">Pfund</unclear></placeName>,
<lb n="29"/>widerumben <unclear cert="medium" resp="#joint">zukommen</unclear> lassen. <unclear cert="low" resp="#joint">Darmit</unclear> unnser
<lb n="30"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">gredmaister</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Kornmäeßt</unclear></orgName> <unclear cert="low" resp="#joint">denjhenigen</unclear> so
<lb n="31"/><unclear cert="medium" resp="#joint">frag</unclear> darnach haben <unclear cert="low" resp="#joint">möchten</unclear>, <unclear cert="low" resp="#joint">darumben</unclear> <unclear cert="low" resp="#joint">red</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">anntwurt</unclear> <unclear cert="low" resp="#joint">zugeben</unclear> <unclear cert="low" resp="#joint">wisse</unclear>. Das begeren
<lb n="33"/>wir umb E. <unclear cert="low" resp="#joint">f</unclear>. <unclear cert="low" resp="#joint">wt</unclear>. in <unclear cert="medium" resp="#joint">sölchem</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">merrerm</unclear>
<lb n="34"/><unclear cert="medium" resp="#joint">gannz</unclear> <unclear cert="medium" resp="#joint">freundtlich</unclear> <unclear cert="medium" resp="#joint">und</unclear> nachparlich <unclear cert="low" resp="#joint">zuverdienen</unclear>,
<lb n="35"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">zubeschulden</unclear>. Datum <origDate when="1563-04-05" cert="medium" resp="#ner">den .5. tag
<lb n="36"/>aprilis anno etc. 63</origDate>
<lb n="37"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Burgermaister</unclear> <unclear cert="medium" resp="#joint">und</unclear> rathe
<lb n="38"/>der statt <unclear cert="low" resp="#joint">Lindaw</unclear></orgName>.
<pb facs="StadtASG_Missive_848_2351.jpg" n="3"/>
<pb facs="StadtASG_Missive_848_2352.jpg" n="4"/>
<lb n="39"/>Den ersamen unnd weisen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und
<lb n="40"/>Rathe der Statt Sannt Gallen</orgName>, unnsern lieben
<lb n="41"/>und gueten freunden.
