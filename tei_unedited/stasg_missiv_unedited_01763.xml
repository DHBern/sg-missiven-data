<lb n="5"/>erschinen die <unclear cert="medium" resp="#joint">fromen</unclear> vesten <unclear cert="low" resp="#joint">Houptman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Miclauß</unclear>
<lb n="6"/>Vogell</persName> unnßer lieber mit <unclear cert="low" resp="#joint">rath</unclear>, und <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Wy</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">niß</unclear></persName> <unclear cert="low" resp="#joint">beed</unclear> <unclear cert="low" resp="#joint">unnßer</unclear> <unclear cert="low" resp="#joint">zunercken</unclear> <unclear cert="low" resp="#joint">gäben</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">form</unclear>
