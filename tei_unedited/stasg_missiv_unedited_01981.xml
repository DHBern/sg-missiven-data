<p>
<pb facs="StadtASG_Missive_1981_7383.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> freündtlich willig dienst, und was
<lb n="2"/>wir <unclear cert="medium" resp="#joint">mehr</unclear> <unclear cert="medium" resp="#joint">ehrn</unclear> liebs und <unclear cert="medium" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear>
<lb n="3"/>zuvor, <unclear cert="low" resp="#joint">Fürsichtigen</unclear> Ersamen und <unclear cert="medium" resp="#joint">Weisen</unclear>,
<lb n="4"/><unclear cert="medium" resp="#joint">besonders</unclear> liebe freündt und <unclear cert="medium" resp="#joint">guete</unclear> Nach-
<lb n="5"/><unclear cert="low" resp="#joint">barn</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">Welchermassen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">burgers</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Jacoben</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">Webers</unclear></persName>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">kupfferschmids</unclear>, <unclear cert="low" resp="#joint">dothmans</unclear>
<lb n="8"/>seligen <unclear cert="medium" resp="#joint">sohns</unclear>, <unclear cert="medium" resp="#joint">gemeinen</unclear> <unclear cert="medium" resp="#joint">glaeubigern</unclear> <unclear cert="medium" resp="#joint">einen</unclear> all-
<lb n="9"/>gemeinen <unclear cert="medium" resp="#joint">Rechtstag</unclear> <unclear cert="medium" resp="#joint">ernennt</unclear> und <unclear cert="low" resp="#joint">angesetzt</unclear>:
<lb n="10"/><unclear cert="low" resp="#joint">das</unclear> haben <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">beijverwartem</unclear> <unclear cert="low" resp="#joint">Edict</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">zuvernemmen</unclear>.
<lb n="12"/><unclear cert="low" resp="#joint">Weil</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">burgere</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">angehoerige</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">villeicht</unclear> <unclear cert="low" resp="#joint">deßhalben</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">interessiert</unclear> <unclear cert="low" resp="#joint">sin</unclear>, <unclear cert="low" resp="#joint">so</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">Webers</unclear> <unclear cert="low" resp="#joint">verarrestierter</unclear> <unclear cert="low" resp="#joint">haab</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">güetern</unclear>,
<lb n="15"/><unclear cert="low" resp="#joint">forderung</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">ansprach</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">moechten</unclear>: Also
<lb n="16"/><unclear cert="medium" resp="#joint">pitten</unclear> wir <unclear cert="medium" resp="#joint">freündtlich</unclear>, <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. wollen solch
<lb n="17"/><unclear cert="medium" resp="#joint">Edict</unclear> <unclear cert="medium" resp="#joint">Irem</unclear> habenden <unclear cert="medium" resp="#joint">gebrauch</unclear> nach, <unclear cert="low" resp="#joint">beij</unclear> <unclear cert="low" resp="#joint">Ihnen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">gebürenden</unclear> <unclear cert="low" resp="#joint">orten</unclear> <unclear cert="low" resp="#joint">offentlich</unclear> <unclear cert="low" resp="#joint">anschlagen</unclear>
<lb n="19"/>und <unclear cert="medium" resp="#joint">publicieren</unclear> lassen, damit an <unclear cert="medium" resp="#joint">sinen</unclear> Recht
<lb n="20"/><unclear cert="medium" resp="#joint">niemandts</unclear> <unclear cert="medium" resp="#joint">verchürzt</unclear>, <unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">Unwissenheit</unclear>
<lb n="21"/>sich <unclear cert="medium" resp="#joint">zuebeclagen</unclear> <unclear cert="medium" resp="#joint">Ursach</unclear> <unclear cert="medium" resp="#joint">habe</unclear>.
<lb n="22"/>Das begeren umb <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">wir</unclear> hinwider,
<lb n="23"/><unclear cert="medium" resp="#joint">freündt</unclear>: und <unclear cert="medium" resp="#joint">Nachbarlich</unclear> zuverdienen, Datum
<lb n="24"/><origDate when="1616-03-14" resp="#ner">14. <unclear cert="medium" resp="#joint">Martij</unclear> <unclear cert="medium" resp="#joint">a°</unclear> 1616</origDate>.
<lb n="25"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermeister und Rhat
<lb n="26"/>der Statt Lindaw</orgName>,
<pb facs="StadtASG_Missive_1981_7384.jpg" n="2"/>
<pb facs="StadtASG_Missive_1981_7385.jpg" n="3"/>
<pb facs="StadtASG_Missive_1981_7386.jpg" n="4"/>
<lb n="27"/>Den fürsichtigen, ersamen <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">weyßen</unclear>
<lb n="28"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> unnd <unclear cert="low" resp="#joint">Rhat</unclear> der Statt St. Gallen</orgName>,
<lb n="29"/>unsern besonders lieben <unclear cert="low" resp="#joint">freünden</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">gueten</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">nachburn</unclear>.
<lb n="31"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>.
