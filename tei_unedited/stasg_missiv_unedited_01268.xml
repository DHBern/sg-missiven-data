        <body>
<p>
<pb facs="StadtASG_Missive_1268_4273.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">fraindtlich</unclear> dienst zuovor.
<lb n="2"/><unclear cert="medium" resp="#joint">Fuersichtig</unclear>, Ersam, Weiß, <unclear cert="medium" resp="#joint">Liebe</unclear> und
<lb n="3"/><unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">fraindt</unclear>. <unclear cert="low" resp="#joint">Nachdem</unclear> <unclear cert="low" resp="#joint">einer</unclear> <unclear cert="low" resp="#joint">namens</unclear>
<lb n="4"/><persName resp="#ner"><unclear cert="low" resp="#joint">Anthoni</unclear> <unclear cert="low" resp="#joint">Wideman</unclear></persName> <unclear cert="low" resp="#joint">sonsten</unclear> der <unclear cert="medium" resp="#joint">kuech</unclear>
<lb n="5"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Soeldtel</unclear></persName> genant <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Woeberts</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">hofen</unclear></placeName>, <unclear cert="low" resp="#joint">boesen</unclear> <unclear cert="low" resp="#joint">verdachts</unclear> <unclear cert="low" resp="#joint">halber</unclear>, <unclear cert="low" resp="#joint">bei</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">unns</unclear> in <unclear cert="low" resp="#joint">gefengknuß</unclear> <unclear cert="low" resp="#joint">khommen</unclear>,
<lb n="8"/>hat er <unclear cert="medium" resp="#joint">under</unclear> <unclear cert="medium" resp="#joint">anderm</unclear> <unclear cert="medium" resp="#joint">bekhant</unclear>, <unclear cert="medium" resp="#joint">wie</unclear>
<lb n="9"/>er <unclear cert="medium" resp="#joint">ungeuerlich</unclear> acht tag nach <date resp="#ner">dem
<lb n="10"/><unclear cert="medium" resp="#joint">Neuen</unclear> <unclear cert="medium" resp="#joint">Jar</unclear></date> <unclear cert="medium" resp="#joint">verschinen</unclear> <unclear cert="medium" resp="#joint">ainem</unclear> <unclear cert="medium" resp="#joint">wiert</unclear>
<lb n="11"/>in <unclear cert="medium" resp="#joint">Euer</unclear> Vorstat <unclear cert="medium" resp="#joint">fuenff</unclear> <unclear cert="medium" resp="#joint">silberne</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">Pecher</unclear> und <unclear cert="medium" resp="#joint">einen</unclear> Waidner, mit
<lb n="13"/><unclear cert="medium" resp="#joint">Moessing</unclear> <unclear cert="medium" resp="#joint">beschlagen</unclear> <unclear cert="medium" resp="#joint">ubergueldet</unclear>, auß
<lb n="14"/>der <unclear cert="medium" resp="#joint">kammern</unclear> in <unclear cert="low" resp="#joint">ainem</unclear> <unclear cert="low" resp="#joint">Casten</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">entwendet</unclear>, <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">Meilwegs</unclear> <unclear cert="low" resp="#joint">darvon</unclear>
<lb n="16"/>in <unclear cert="medium" resp="#joint">ainem</unclear> <unclear cert="medium" resp="#joint">Marckhtfloeckhen</unclear> bei <unclear cert="low" resp="#joint">ainem</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Closter</unclear> einem <unclear cert="low" resp="#joint">Wiert</unclear> den Waidner
<lb n="18"/>umb <unclear cert="medium" resp="#joint">anderhalben</unclear> <unclear cert="medium" resp="#joint">guelden</unclear>, die <unclear cert="medium" resp="#joint">Pecher</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-135" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Augspurg</unclear></placeName> neben <unclear cert="medium" resp="#joint">anderm</unclear> <unclear cert="medium" resp="#joint">silber</unclear>-
<pb facs="StadtASG_Missive_1268_4274.jpg" n="2"/>
<lb n="20"/><unclear cert="medium" resp="#joint">gepiets</unclear> <unclear cert="medium" resp="#joint">wehr</unclear>, umb 20. fl. <unclear cert="low" resp="#joint">verkhaufft</unclear>.
<lb n="21"/>Ob und wie sich <unclear cert="medium" resp="#joint">diß</unclear> erb <unclear cert="medium" resp="#joint">vorbhafften</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">aussag</unclear> in warheit allen umbstenden
<lb n="23"/>nach verhalt, biten wir <unclear cert="low" resp="#joint">freündtlich</unclear>,
<lb n="24"/><unclear cert="low" resp="#joint">auf</unclear> <unclear cert="low" resp="#joint">gebürliche</unclear> nachforsch, wie sichs
<lb n="25"/><unclear cert="low" resp="#joint">befündet</unclear> <unclear cert="medium" resp="#joint">unß</unclear> bei disem <unclear cert="low" resp="#joint">unserm</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">poten</unclear> in schrifften <unclear cert="low" resp="#joint">zuoverstendigen</unclear>.
<lb n="27"/>Das beschulden wir <unclear cert="low" resp="#joint">hinwider</unclear> in
<lb n="28"/><unclear cert="low" resp="#joint">gleichem</unclear> und einem <unclear cert="low" resp="#joint">mehrerm</unclear>, und
<lb n="29"/>sindt <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="medium" resp="#joint">zuo</unclear> freündtlichen diensten
<lb n="30"/>erbietig. Datum den <origDate when="1590-06-11" resp="#ner">11. monats
<lb n="31"/><unclear cert="low" resp="#joint">junii</unclear> anno 1590</origDate>.
<lb n="32"/><orgName role="issuer" resp="#ner">Camerer und Rath der stat
<lb n="33"/>Regenspurg</orgName>.
<pb facs="StadtASG_Missive_1268_4275.jpg" n="3"/>
<pb facs="StadtASG_Missive_1268_4276.jpg" n="4"/>
<lb n="34"/>Den <unclear cert="low" resp="#joint">fuersichtigen</unclear>, ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger=
<lb n="35"/>maister und Rath der stat S. Gallen</orgName> in <unclear cert="low" resp="#joint">Schweiz</unclear>
<lb n="36"/><unclear cert="medium" resp="#joint">unsern</unclear> lieben und gueten <unclear cert="low" resp="#joint">freündten</unclear>.
</p>
