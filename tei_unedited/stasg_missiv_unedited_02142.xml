<lb n="9"/><unclear cert="low" resp="#joint">leüth</unclear>, <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">aelten</unclear> <unclear cert="low" resp="#joint">Jnzüg-rodel</unclear>, <unclear cert="low" resp="#joint">selten</unclear> <unclear cert="low" resp="#joint">fleißig</unclear> nit nachgangen
<lb n="10"/>Und derowegen zue erhaltung ihrer Nuzbarkeiten verur-
<lb n="11"/>sacht <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">sÿ</unclear> samptlich <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">neüwen</unclear> <unclear cert="low" resp="#joint">Eÿden</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
