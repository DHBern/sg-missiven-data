<lb n="41"/>Verhoffentlich <unclear cert="medium" resp="#joint">weiln</unclear> <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">von</unclear> <unclear cert="medium" resp="#joint">aůgt=</unclear>
