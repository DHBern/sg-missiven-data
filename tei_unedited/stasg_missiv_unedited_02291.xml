<lb n="32"/><unclear cert="medium" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">avisirn</unclear>, sonder auch
<lb n="33"/><unclear cert="medium" resp="#joint">obrikheitlich</unclear> dahin <unclear cert="low" resp="#joint">mandirn</unclear>, <unclear cert="low" resp="#joint">da</unclear> <unclear cert="low" resp="#joint">sye</unclear> an
<lb n="34"/>dem <unclear cert="medium" resp="#joint">undersee</unclear> <unclear cert="medium" resp="#joint">deßen</unclear> <unclear cert="medium" resp="#joint">gwerbs</unclear> sich <unclear cert="low" resp="#joint">werben</unclear>,
<lb n="35"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">sye</unclear> <unclear cert="low" resp="#joint">All</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">jeder</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">herauff</unclear>
