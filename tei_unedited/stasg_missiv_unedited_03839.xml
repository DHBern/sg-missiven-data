<p>
<pb facs="StadtASG_Missive_3839_15481.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unser</unclear> <unclear cert="low" resp="#joint">frueindtlich</unclear> <unclear cert="low" resp="#joint">willig</unclear> <unclear cert="low" resp="#joint">dienst</unclear> und <unclear cert="low" resp="#joint">grueeß</unclear> <unclear cert="low" resp="#joint">Wie</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">liebe</unclear> und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">Frueind</unclear>. <unclear cert="low" resp="#joint">Innsonnders</unclear> <unclear cert="low" resp="#joint">Edler</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">frommer</unclear> <unclear cert="low" resp="#joint">vürnemmer</unclear> und <unclear cert="low" resp="#joint">hochgelehrter</unclear>, <unclear cert="low" resp="#joint">sonnders</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">guennsstiger</unclear> und <unclear cert="low" resp="#joint">geehrter</unclear> <unclear cert="low" resp="#joint">herr</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Dem</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">ist</unclear> <unclear cert="low" resp="#joint">ungezweiffentlich</unclear> <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">gnuegsam</unclear> <unclear cert="low" resp="#joint">bekandt</unclear>,
<lb n="6"/><unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">Vor</unclear> <unclear cert="low" resp="#joint">2</unclear>. <unclear cert="low" resp="#joint">Jahren</unclear> <unclear cert="low" resp="#joint">Wir</unclear> <unclear cert="low" resp="#joint">füer</unclear> <unclear cert="low" resp="#joint">unnderschidliche</unclear> <unclear cert="low" resp="#joint">hochfleh</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">liche</unclear> <unclear cert="low" resp="#joint">schrifft</unclear>- <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Mundtliche</unclear> <unclear cert="low" resp="#joint">ansuechungen</unclear>, <unclear cert="low" resp="#joint">beÿ</unclear> <unclear cert="low" resp="#joint">eim</unclear> <unclear cert="low" resp="#joint">er</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">loeblichen</unclear> <orgName resp="#ner"><unclear cert="low" resp="#joint">Magistrat</unclear> der Statt <unclear cert="low" resp="#joint">St</unclear></orgName>. <unclear cert="low" resp="#joint">Gallen</unclear> <unclear cert="low" resp="#joint">Wegen</unclear> <unclear cert="low" resp="#joint">eines</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">anlehens</unclear>, <unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">vertragen</unclear> lassen, <unclear cert="low" resp="#joint">Mit</unclear> <unclear cert="low" resp="#joint">welchen</unclear>
<lb n="10"/>Wir aber <unclear cert="low" resp="#joint">Jederzeit</unclear> und zwar allein so fehren abgewisen
<lb n="11"/>und <unclear cert="low" resp="#joint">Vertroesstet</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">beschwerdthafften</unclear> <unclear cert="low" resp="#joint">reichs</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">Gravamen</unclear> in einem bessern Statu befinden werde, und
<lb n="13"/>man erachten küende, daß ein solch anlehen, zue deß ge-
<lb n="14"/>meinen Wesens nuzen und <persName resp="#ner">Wolfart</persName> dienen und ge-
<lb n="15"/>raichen moechte, daß Unß alßdann nach müglicheit gra-
<lb n="16"/>tificiert werden <unclear cert="low" resp="#joint">solle</unclear>.
<lb n="17"/><unclear cert="low" resp="#joint">Nun</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">getruckhte</unclear> und <unclear cert="low" resp="#joint">erschollne</unclear> <unclear cert="low" resp="#joint">acten</unclear>, wie
<lb n="18"/><unclear cert="low" resp="#joint">viell</unclear> gueten <unclear cert="low" resp="#joint">theils</unclear> <unclear cert="low" resp="#joint">Nachrüchtung</unclear> <unclear cert="low" resp="#joint">selligk</unclear> <unclear cert="low" resp="#joint">herrn</unclear> <unclear cert="low" resp="#joint">ohne</unclear>-
<lb n="19"/><unclear cert="low" resp="#joint">zweiffentlich</unclear> <unclear cert="low" resp="#joint">beÿ</unclear> <unclear cert="low" resp="#joint">handten</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">werden</unclear>, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">lob</unclear>
<lb n="20"/>und <unclear cert="low" resp="#joint">danckh</unclear> an dem so lang <unclear cert="low" resp="#joint">desiderierten</unclear> allge-
<lb n="21"/>meinen edlen Reichßfriden nit Mehr <unclear cert="low" resp="#joint">zuezweifflen</unclear>,
<lb n="22"/><unclear cert="low" resp="#joint">sonndern</unclear> <unclear cert="low" resp="#joint">hossenlich</unclear> in <unclear cert="low" resp="#joint">bälde</unclear> <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">orthen</unclear> <unclear cert="low" resp="#joint">im</unclear> <orgName ref="stadtasg-actors-559" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Reich</unclear></orgName>
<lb n="23"/><unclear cert="low" resp="#joint">offenlich</unclear> <unclear cert="low" resp="#joint">publiciert</unclear>, und <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">kriegß</unclear> <unclear cert="low" resp="#joint">armaden</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">dem</unclear>
<lb n="24"/><orgName ref="stadtasg-actors-559" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Reich</unclear></orgName> <unclear cert="low" resp="#joint">abgefüert</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">sollen</unclear>, <unclear cert="low" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">Zuvor</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">Ihr</unclear> <unclear cert="low" resp="#joint">contento</unclear> <unclear cert="low" resp="#joint">Von</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">kraisen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Ständen</unclear> deß
<lb n="26"/><orgName ref="stadtasg-actors-559" cert="medium" resp="#ner">Reichs</orgName> erstattet werden soll und mueß deß
<lb n="27"/>Wirt es hiesiger Statt, nach darüber allberait ge-
<lb n="28"/>machter Calculation und uberschlag, ein zimbliche
<lb n="29"/>haoche Summa betreffen, Und Weil man allberait
<lb n="30"/>die Ständt dahin erinnert, sich anfangs mit einer
<lb n="31"/>ansehenlichen <unclear cert="low" resp="#joint">baarschafft</unclear> <unclear cert="low" resp="#joint">gefasst</unclear> <unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">machen</unclear>, <unclear cert="low" resp="#joint">Wir</unclear> aber
<lb n="32"/><unclear cert="low" resp="#joint">laider</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">Vor</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">Vil</unclear> <unclear cert="low" resp="#joint">jahr</unclear> <unclear cert="low" resp="#joint">hero</unclear>, <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Verderbliche</unclear>
<pb facs="StadtASG_Missive_3839_15482.jpg" n="2"/>
<lb n="33"/>kriegs pressuren und contributiones, in solche ruin
<lb n="34"/>gesezet, und depauperiert worden, das unß und unserer
<lb n="35"/>wenigen burgerschafft, wol hieuß damit <unclear cert="low" resp="#joint">wolße</unclear> <unclear cert="low" resp="#joint">kunnen</unclear>,
<lb n="36"/><unclear cert="low" resp="#joint">per</unclear> <unclear cert="low" resp="#joint">Rerum</unclear> <unclear cert="low" resp="#joint">naturam</unclear> <unclear cert="low" resp="#joint">unmiglich</unclear> und unerschwinglich. Deß
<lb n="37"/>halben wir in eventum vorhemelich unser einziges
<lb n="38"/>absehen und hohes vertrauwen zue einem loblichen
<lb n="39"/>Magistrat <unclear cert="low" resp="#joint">vorgemelter</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></placeName>, die werde
<lb n="40"/>uff unser künfftig gebüerend ansuechen und hoch-
<lb n="41"/><unclear cert="low" resp="#joint">fleißig</unclear> <unclear cert="low" resp="#joint">bitten</unclear>, <unclear cert="low" resp="#joint">unß</unclear>, <unclear cert="low" resp="#joint">hienor</unclear> <unclear cert="low" resp="#joint">beschagner</unclear> <unclear cert="low" resp="#joint">maßen</unclear>, mit
<lb n="42"/>einem <unclear cert="low" resp="#joint">ergibigen</unclear> <unclear cert="low" resp="#joint">stückh</unclear> <unclear cert="low" resp="#joint">gelt</unclear> und anlehen, nit leychen,
<lb n="43"/>sonder auß christlicher liebe, treüw und mitleiden,
<lb n="44"/>auch gegen gnuegsamer obligation (die dan sambtlich
<lb n="45"/>burgerschafft, und <unclear cert="low" resp="#joint">alle</unclear> <unclear cert="low" resp="#joint">güetter</unclear>, in optima forma
<lb n="46"/><unclear cert="low" resp="#joint">außgefertigt</unclear> <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">solle</unclear>) damit nachbarlich
<lb n="47"/><unclear cert="low" resp="#joint">gratificieren</unclear>. <unclear cert="low" resp="#joint">Diewil</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">solcher</unclear> <unclear cert="low" resp="#joint">inten</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">tion</unclear> und <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">hochanglegnen</unclear> <unclear cert="low" resp="#joint">petito</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">eher</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">zuegelangen</unclear>, <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">herrn</unclear> <unclear cert="low" resp="#joint">hochvermögendem</unclear> <unclear cert="low" resp="#joint">wolge</unclear>-
<lb n="50"/><unclear cert="low" resp="#joint">zügen</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">wenig</unclear> <unclear cert="low" resp="#joint">gelegen</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unsern</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">vormals</unclear> abgeordneten in dergleichen bittlichen an-
<lb n="52"/>suechungen sehr angeneme officia, lieb und dienst
<lb n="53"/>erwißen, darauß wir <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">herren</unclear> gegen unß <unclear cert="low" resp="#joint">dragende</unclear>
<lb n="54"/><unclear cert="low" resp="#joint">sonderbare</unclear> <unclear cert="low" resp="#joint">guete</unclear> affection vernemmen und verspürt, wie
<lb n="55"/>wir solchen favor und hohe guetthat noch in <unclear cert="low" resp="#joint">danckhbarem</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">angedenckhen</unclear> haben, und nach müglicheit zueverdienen
<lb n="57"/>unß obligiert erkennen. <unclear cert="low" resp="#joint">Alß</unclear> <unclear cert="low" resp="#joint">dragen</unclear> wir noch-
<lb n="58"/>malen daß dienstliche vertrauwen zue demselben, deß-
<lb n="59"/>wegen wir jne zumal ganz jnstendig und hochlich
<lb n="60"/>bitten, der herr welle nach seiner bekanten und
<pb facs="StadtASG_Missive_3839_15483.jpg" n="3"/>
<lb n="61"/>hochberuembter discretion beedeten vorstehren
<lb n="62"/>der orthen, ein besßers nachruckhs (wie <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">disen</unclear>)
<lb n="63"/><unclear cert="low" resp="#joint">zufrueher</unclear> <unclear cert="low" resp="#joint">beherzigung</unclear> <unclear cert="low" resp="#joint">effectuieren</unclear>, und <unclear cert="low" resp="#joint">hinizwischen</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">gehoriger</unclear> <unclear cert="low" resp="#joint">orten</unclear> <unclear cert="low" resp="#joint">ohnmaßgeblich</unclear> <unclear cert="low" resp="#joint">bestermassen</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">praeoccupieren</unclear> und <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">cooperieren</unclear> damit
<lb n="66"/>unß in disem nothfahl, und <unclear cert="low" resp="#joint">eußerst</unclear> <unclear cert="low" resp="#joint">bedürfftigkeit</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">weither</unclear> <unclear cert="low" resp="#joint">künfftig</unclear> <unclear cert="low" resp="#joint">zuthuener</unclear> <unclear cert="low" resp="#joint">refu-tation</unclear> <unclear cert="low" resp="#joint">besten</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">nachbarlichen</unclear> <unclear cert="low" resp="#joint">willfahret</unclear> werden möchte.
<lb n="69"/><unclear cert="low" resp="#joint">Wellche</unclear> <unclear cert="low" resp="#joint">hirüber</unclear> <unclear cert="low" resp="#joint">deroselben</unclear> <unclear cert="low" resp="#joint">hochvernünfftige</unclear> <unclear cert="low" resp="#joint">gedanckhen</unclear>
<lb n="70"/><unclear cert="low" resp="#joint">wolhten</unclear> <unclear cert="low" resp="#joint">wir</unclear> unß <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">eventum</unclear> <unclear cert="low" resp="#joint">fürderlichsten</unclear>
<lb n="71"/><unclear cert="low" resp="#joint">hinzusezen</unclear>, mit <unclear cert="low" resp="#joint">eiffer</unclear> <unclear cert="low" resp="#joint">teürer</unclear> <unclear cert="low" resp="#joint">hürten</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">gerehten</unclear>
<lb n="72"/><unclear cert="low" resp="#joint">zuem</unclear> <unclear cert="low" resp="#joint">trewenn</unclear> unß <unclear cert="low" resp="#joint">hienzwischen</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">Allhöhsten</unclear>
<lb n="73"/><unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">seine</unclear> <unclear cert="low" resp="#joint">vätterliche</unclear> <unclear cert="low" resp="#joint">schirm</unclear> <unclear cert="low" resp="#joint">treülich</unclear> <unclear cert="low" resp="#joint">befehlent</unclear>. <unclear cert="low" resp="#joint">Datum</unclear>
<lb n="74"/><origDate when="1648-08-03" resp="#ner">3. <unclear cert="low" resp="#joint">Augustj</unclear>. <unclear cert="low" resp="#joint">1648</unclear></origDate>.
<lb n="75"/><unclear cert="low" resp="#joint">Deroselben</unclear>
<lb n="76"/><unclear cert="low" resp="#joint">dienstwillige</unclear>
<lb n="77"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermaister und rhat
<lb n="78"/>der Statt <unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></orgName>.
<pb facs="StadtASG_Missive_3839_15484.jpg" n="4"/>
<lb n="79"/>Dem edlen, fromen, <unclear cert="low" resp="#joint">ernvesten</unclear> und
<lb n="80"/>wolgelerten herren <persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Sebastian</unclear> <unclear cert="low" resp="#joint">Schobingern</unclear></persName>,
