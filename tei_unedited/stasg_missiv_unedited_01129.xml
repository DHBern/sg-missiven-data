<lb n="10"/><unclear cert="medium" resp="#joint">zuoerkhennen</unclear>, <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">glychwol</unclear> <unclear cert="low" resp="#joint">Statt</unclear>
<lb n="11"/><placeName ref="stadtasg-places-431" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Pollaÿ</unclear></placeName> <unclear cert="medium" resp="#joint">Zoll</unclear>, <unclear cert="low" resp="#joint">unnserß</unclear> <unclear cert="low" resp="#joint">erachtens</unclear> sich <unclear cert="low" resp="#joint">unbedächtig</unclear>
