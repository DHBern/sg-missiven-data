<lb n="3"/><unclear cert="low" resp="#joint">gueten</unclear> fründt, wir haben E. <unclear cert="low" resp="#joint">Wht</unclear>. schryben
<lb n="4"/>den <persName resp="#ner">Jacob <unclear cert="medium" resp="#joint">Krenckher</unclear></persName> betreffendt, Alles innhallts,
<lb n="5"/>unnd endtlich <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">was</unclear> vermainten ursachen
<lb n="6"/><unclear cert="medium" resp="#joint">sy</unclear> <unclear cert="medium" resp="#joint">gedenckhen</unclear>, <unclear cert="medium" resp="#joint">das</unclear> Er <persName resp="#ner"><unclear cert="low" resp="#joint">Krenckher</unclear></persName> nit schuldig
<lb n="7"/>sich <unclear cert="medium" resp="#joint">zuostellen</unclear>, und umb den <unclear cert="low" resp="#joint">lehenfrävel</unclear> ab-
<lb n="8"/><unclear cert="medium" resp="#joint">zuokhomen</unclear>, <unclear cert="medium" resp="#joint">hören</unclear> <unclear cert="medium" resp="#joint">verlesen</unclear> und vernomen,
