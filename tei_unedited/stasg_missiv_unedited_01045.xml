<p>
<pb facs="StadtASG_Missive_1045_3247.jpg" n="1"/>
<lb n="1"/>Edel, from, <unclear cert="medium" resp="#joint">vest</unclear>, <unclear cert="medium" resp="#joint">fuersichtig</unclear>, <unclear cert="medium" resp="#joint">ersam</unclear> unnd weise, <unclear cert="low" resp="#joint">sonnders</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">gonstige</unclear>, liebe herrn unnd <unclear cert="low" resp="#joint">nachpaurn</unclear>, <unclear cert="medium" resp="#joint">euch</unclear> <unclear cert="low" resp="#joint">seyen</unclear>
<lb n="3"/><unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear>, <unclear cert="low" resp="#joint">nachpeürlich</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">guetwillig</unclear> <unclear cert="medium" resp="#joint">diennst</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">zuvor</unclear>. <unclear cert="low" resp="#joint">Heüt</unclear> dato ist unnser lieber <unclear cert="low" resp="#joint">getreüwer</unclear> mit-
<lb n="5"/>burger <persName resp="#ner">Jacob <unclear cert="medium" resp="#joint">Zoller</unclear></persName>, vor unns <unclear cert="low" resp="#joint">erschinen</unclear>, <unclear cert="low" resp="#joint">zueerkennen</unclear>
<lb n="6"/>geben. Nachdem Ime eür burger ainer, mit namen
<lb n="7"/><persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Kaga</unclear></persName>, in <unclear cert="medium" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">Zollers</unclear> <unclear cert="low" resp="#joint">hanndtierung</unclear>, ain <unclear cert="low" resp="#joint">zeitlanng</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">factorirt</unclear>. Unnd als er <unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="medium" resp="#joint">Zoller</unclear> umb <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">letstgelt</unclear>
<lb n="9"/>Rechnung <unclear cert="medium" resp="#joint">geben</unclear>, <unclear cert="medium" resp="#joint">habe</unclear> er <unclear cert="low" resp="#joint">Kaga</unclear>, <unclear cert="medium" resp="#joint">Ime</unclear> Zoller <unclear cert="low" resp="#joint">zwoelf</unclear> <unclear cert="low" resp="#joint">stueckhe</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">Rauhe</unclear> <unclear cert="low" resp="#joint">krebs</unclear> <unclear cert="low" resp="#joint">leinwath</unclear>, <unclear cert="low" resp="#joint">Inmaſſen</unclear> er <unclear cert="low" resp="#joint">beuelch</unclear> von <unclear cert="medium" resp="#joint">Ime</unclear>
<lb n="11"/>gehabt, <unclear cert="low" resp="#joint">erkaufft</unclear>, <unclear cert="low" resp="#joint">Ine</unclear> auch vor sein <unclear cert="low" resp="#joint">Kaga</unclear> <unclear cert="low" resp="#joint">abtretten</unclear>,
<lb n="12"/>damit <unclear cert="low" resp="#joint">erweißt</unclear> unnd bezalt, <unclear cert="medium" resp="#joint">so</unclear> seye <unclear cert="low" resp="#joint">domals</unclear> <unclear cert="medium" resp="#joint">gleichwoll</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">sein</unclear> <unclear cert="medium" resp="#joint">gelegennhait</unclear> gewesen, die <unclear cert="low" resp="#joint">factorei</unclear> <unclear cert="low" resp="#joint">zueuerenndern</unclear>,
<lb n="14"/>die er auch <unclear cert="low" resp="#joint">verenndert</unclear>, unnd dieselbig sambt <unclear cert="medium" resp="#joint">den</unclear> obgemelten
<lb n="15"/>zwoelf <unclear cert="low" resp="#joint">stueckhen</unclear> <unclear cert="low" resp="#joint">Rauhen</unclear> <unclear cert="low" resp="#joint">krebs</unclear> <unclear cert="low" resp="#joint">leinwath</unclear>, <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Schuechster</unclear></persName>
<lb n="16"/><unclear cert="low" resp="#joint">ubergeben</unclear>, In hoffnung gewesen, <unclear cert="medium" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">solte</unclear> <unclear cert="low" resp="#joint">Ime</unclear> <unclear cert="low" resp="#joint">daran</unclear>
<lb n="17"/>kain manngel, oder <unclear cert="medium" resp="#joint">verhinderung</unclear> widerfaren sein. So
<lb n="18"/><unclear cert="medium" resp="#joint">werde</unclear> er aber bericht, wie des obgemelten seins
<lb n="19"/><unclear cert="low" resp="#joint">gewesnen</unclear> <unclear cert="low" resp="#joint">factors</unclear> <unclear cert="low" resp="#joint">gleübiger</unclear> <unclear cert="low" resp="#joint">zuegeuaren</unclear>, unnd Ime Zoller
<lb n="20"/><unclear cert="low" resp="#joint">solche</unclear> <unclear cert="low" resp="#joint">obgemelte</unclear> <unclear cert="low" resp="#joint">leinwath</unclear>, <unclear cert="low" resp="#joint">verarrestiern</unclear> unnd ver-
<lb n="21"/><unclear cert="low" resp="#joint">pietten</unclear> <unclear cert="low" resp="#joint">laſſen</unclear>, das <unclear cert="low" resp="#joint">Ine</unclear> doch aus <unclear cert="low" resp="#joint">erzelten</unclear> <unclear cert="low" resp="#joint">ursachen</unclear>, nit
<lb n="22"/>wenig <unclear cert="medium" resp="#joint">befrombde</unclear>, <unclear cert="medium" resp="#joint">dieweil</unclear> gemelter <unclear cert="medium" resp="#joint">factor</unclear> <unclear cert="medium" resp="#joint">solche</unclear> <unclear cert="medium" resp="#joint">leinwath</unclear>
<lb n="23"/>nit aus <unclear cert="medium" resp="#joint">seinem</unclear> gelt, sonnder aus gemelts Zollers gelt
<lb n="24"/><unclear cert="low" resp="#joint">erkaufft</unclear>, unnd <unclear cert="low" resp="#joint">annderst</unclear> nit, dann <unclear cert="low" resp="#joint">factors</unclear> <unclear cert="low" resp="#joint">weis</unclear> <unclear cert="low" resp="#joint">bej</unclear>
<lb n="25"/><unclear cert="medium" resp="#joint">hannden</unclear> gehabt, <unclear cert="low" resp="#joint">Ime</unclear> die auch, <unclear cert="medium" resp="#joint">wie</unclear> vor gemelt, vor
<lb n="26"/><unclear cert="medium" resp="#joint">seinem</unclear> abtritt oder austretten, uberanntwurt, da
<lb n="27"/>er annderer <unclear cert="medium" resp="#joint">seiner</unclear> <unclear cert="low" resp="#joint">verhanndlung</unclear>, gar nit <unclear cert="low" resp="#joint">zuentgelten</unclear>
<lb n="28"/><unclear cert="medium" resp="#joint">vermaint</unclear>. So nach lenngs fuergebracht, <unclear cert="low" resp="#joint">unns</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">darauf</unclear> umb <unclear cert="low" resp="#joint">rathung</unclear> <unclear cert="low" resp="#joint">angerueffen</unclear>, unnd gebetten, <unclear cert="medium" resp="#joint">wir</unclear>
<lb n="30"/>wolten <unclear cert="low" resp="#joint">Ime</unclear> an eüch <unclear cert="low" resp="#joint">deßhalben</unclear> <unclear cert="low" resp="#joint">fuerschrifft</unclear> <unclear cert="low" resp="#joint">mitthailen</unclear>,
<lb n="31"/>die wir Ime zuegeben bewilligt, <unclear cert="low" resp="#joint">Wover</unclear> <unclear cert="medium" resp="#joint">dann</unclear>
<lb n="32"/>die sachen obgehörter <unclear cert="low" resp="#joint">maſſen</unclear> beschaffen, <unclear cert="low" resp="#joint">wurde</unclear> er sich
<lb n="33"/><unclear cert="medium" resp="#joint">warlich</unclear> nit unbillich <unclear cert="medium" resp="#joint">zubeschweren</unclear> haben, Demnach
<lb n="34"/><unclear cert="low" resp="#joint">lanngt</unclear> an <unclear cert="medium" resp="#joint">eüch</unclear>, <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">freündtlichs</unclear> <unclear cert="medium" resp="#joint">Nachpeürlichs</unclear> <unclear cert="medium" resp="#joint">pith</unclear>
<lb n="35"/>Ir wollen mit <unclear cert="low" resp="#joint">gedachten</unclear> <unclear cert="low" resp="#joint">gleübiger</unclear> dahin <unclear cert="low" resp="#joint">hanndlen</unclear>, das
<pb facs="StadtASG_Missive_1045_3248.jpg" n="2"/>
<lb n="36"/><unclear cert="low" resp="#joint">Si</unclear> gemelten <unclear cert="low" resp="#joint">zollnr</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">arrests</unclear> <unclear cert="low" resp="#joint">endtschlachen</unclear>. Unnd darmit
<lb n="37"/><unclear cert="low" resp="#joint">unverhindert</unclear> <unclear cert="medium" resp="#joint">fort</unclear> handlen laßen. <unclear cert="low" resp="#joint">Stöllen</unclear> auch in <unclear cert="medium" resp="#joint">kainen</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">zweuifel</unclear>, Ir <unclear cert="low" resp="#joint">werden</unclear> <unclear cert="low" resp="#joint">eüch</unclear> der gebür nach <unclear cert="low" resp="#joint">hierinn</unclear> zu <unclear cert="low" resp="#joint">erzaigen</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">zuoehalten</unclear> <unclear cert="low" resp="#joint">wißen</unclear>. Unnd <unclear cert="low" resp="#joint">Ine</unclear> also diser unnser <unclear cert="low" resp="#joint">für=</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">schrift</unclear> <unclear cert="low" resp="#joint">gonstigclich</unclear> <unclear cert="low" resp="#joint">genießen</unclear> laßen. <unclear cert="medium" resp="#joint">Das</unclear> <unclear cert="low" resp="#joint">begern</unclear> wir
<lb n="41"/>in dergleichen <unclear cert="low" resp="#joint">faelen</unclear> unnd in all <unclear cert="low" resp="#joint">ander</unclear> <unclear cert="low" resp="#joint">wege</unclear> <unclear cert="medium" resp="#joint">freündtlich</unclear>
<lb n="42"/>und <unclear cert="low" resp="#joint">nachpeürlichen</unclear> <unclear cert="low" resp="#joint">zueverdienen</unclear>, Unnd was <unclear cert="low" resp="#joint">eüch</unclear>
<lb n="43"/><unclear cert="medium" resp="#joint">hiemit</unclear> von unns <unclear cert="medium" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">nachpeürlich</unclear> lieb unnd
<lb n="44"/><unclear cert="low" resp="#joint">annemst</unclear> ist. <unclear cert="low" resp="#joint">Datum</unclear> <origPlace ref="stadtasg-places-89" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Veldkhirch</unclear></origPlace> <origDate when="1575-02-26" cert="medium" resp="#ner">den 26 <unclear cert="low" resp="#joint">Februarij</unclear> anno 75</origDate>
