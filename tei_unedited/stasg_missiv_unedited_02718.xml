    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2718_10551.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unsser</unclear> <unclear cert="low" resp="#joint">fründt</unclear>. <unclear cert="low" resp="#joint">nachpürlig</unclear> willig <unclear cert="low" resp="#joint">dinst</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">waß</unclear> wir ehren liebs und guots ver
<lb n="3"/>moegend, zuvor, Edle, veste, fromme, ehren-
<lb n="4"/>veste, fürsichtige, ehrsame und wisse, inßunders
<lb n="5"/>guote fründt und getrüwe liebe nachparren.
<lb n="6"/>Unß hat <unclear cert="low" resp="#joint">wilund</unclear> <unclear cert="low" resp="#joint">hauptman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Muetz</unclear></persName>
<lb n="7"/>von <placeName resp="#ner"><unclear cert="low" resp="#joint">Krüytzl</unclear></placeName>., <unclear cert="low" resp="#joint">umbstendtlig</unclear> <unclear cert="low" resp="#joint">berichtet</unclear>. <unclear cert="low" resp="#joint">waß</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">massen</unclear> üwer angehoerig burger und dißs
<lb n="9"/><orgName ref="stadtasg-actors-552" cert="medium" resp="#ner">Spittals</orgName> danwagert, N: N: Welicher mit
<lb n="10"/>Hoß Schachen zuo <placeName resp="#ner">Krüyzlen</placeName> einen rechtß handel
<lb n="11"/>angefangen. zum offteren mallen daß recht
<lb n="12"/>ußzefueren, ervorderet worden. So <unclear cert="low" resp="#joint">sich</unclear> aber
<lb n="13"/><unclear cert="low" resp="#joint">bißhero</unclear> nit <unclear cert="low" resp="#joint">instellen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">eß</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">sin</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">soete</unclear>. <unclear cert="low" resp="#joint">ferner</unclear> <unclear cert="low" resp="#joint">andtwurt</unclear> <unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">woellen</unclear>, <unclear cert="low" resp="#joint">da</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">besagter</unclear> <unclear cert="low" resp="#joint">Schach</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">betrachtung</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">sachen</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">beschaffenheit</unclear>, <unclear cert="low" resp="#joint">und</unclear> zuo <unclear cert="low" resp="#joint">erretung</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">ehren</unclear>.
<lb n="17"/><unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">lassen</unclear> <unclear cert="low" resp="#joint">koenne</unclear>. <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">selbigen</unclear> <unclear cert="low" resp="#joint">nachze</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">setzen</unclear>, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">lang</unclear>, <unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">dißer</unclear> <unclear cert="low" resp="#joint">sach</unclear> halb ein voll
<lb n="19"/>komne eroerterung und rechtlig ußspruch
<lb n="20"/>bescheche. <unclear cert="low" resp="#joint">Inmassen</unclear> <unclear cert="low" resp="#joint">besagtz</unclear> <unclear cert="low" resp="#joint">Hoßen</unclear> <unclear cert="low" resp="#joint">Schache</unclear>, gantz
<lb n="21"/><unclear cert="low" resp="#joint">underthnig</unclear> begeren <unclear cert="low" resp="#joint">sige</unclear>, <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">unsser</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="22"/><unclear cert="low" resp="#joint">trüwe</unclear> <unclear cert="low" resp="#joint">lieb</unclear> <unclear cert="low" resp="#joint">nachparren</unclear>, <unclear cert="low" resp="#joint">schrifftlig</unclear> <unclear cert="low" resp="#joint">zbelangen</unclear> zuo-
<lb n="23"/>lassen, daß ernentter Danwagert dahin gehalten
<lb n="24"/>werde. vor unß (alda das recht <unclear cert="low" resp="#joint">angefangen</unclear>.)
<lb n="25"/><unclear cert="low" resp="#joint">söllches</unclear> <unclear cert="low" resp="#joint">uß</unclear> <unclear cert="low" resp="#joint">fueren</unclear> <unclear cert="low" resp="#joint">helffe</unclear>, damit <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">groesserer</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">unkoste</unclear> <unclear cert="low" resp="#joint">erspart</unclear> <unclear cert="low" resp="#joint">verblibe</unclear>: <unclear cert="low" resp="#joint">Wan</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">dan</unclear> wir <unclear cert="low" resp="#joint">söllich</unclear> <unclear cert="low" resp="#joint">fürbringen</unclear> und <unclear cert="low" resp="#joint">pitliges</unclear> <unclear cert="low" resp="#joint">ansuochen</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">gnugsamligen</unclear> <unclear cert="low" resp="#joint">angehoert</unclear> und verstanden, habend
<lb n="29"/>wir söllches billich sin befunden. Langet hiemit
<lb n="30"/>an üch unsser getrüwe lieb nachparren unsser
<lb n="31"/>gantz fründt. und nachpürliges begeren, ir
<lb n="32"/><unclear cert="low" resp="#joint">woellend</unclear> <unclear cert="low" resp="#joint">gedachten</unclear> <unclear cert="low" resp="#joint">Danwageten</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">halten</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">mehr</unclear> gemelten Hoß Schachen. vor <unclear cert="low" resp="#joint">unß</unclear>.
<lb n="34"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">rechten</unclear> <unclear cert="low" resp="#joint">biß</unclear> zuo <unclear cert="low" resp="#joint">ußtrag</unclear> der <unclear cert="low" resp="#joint">sach</unclear> <unclear cert="low" resp="#joint">andtwurt</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">gebe</unclear>. <unclear cert="low" resp="#joint">Im</unclear> <unclear cert="low" resp="#joint">ohe</unclear> <unclear cert="low" resp="#joint">verhofften</unclear> <unclear cert="low" resp="#joint">fahl</unclear> aber söllches
<pb facs="StadtASG_Missive_2718_10552.jpg" n="2"/>
<lb n="36"/>nit beschechen sote, wurde unß <unclear cert="low" resp="#joint">daßelbige</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">bedencklichen</unclear> <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">komen</unclear>. <unclear cert="low" resp="#joint">Wuß</unclear> aber nit <unclear cert="low" resp="#joint">zwiflet</unclear>,
<lb n="38"/><unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">gutwillig</unclear> <unclear cert="low" resp="#joint">beschechen</unclear> <unclear cert="low" resp="#joint">werde</unclear>.
<lb n="39"/><unclear cert="low" resp="#joint">Waß</unclear> <unclear cert="low" resp="#joint">denach</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">jenigen</unclear> <unclear cert="low" resp="#joint">anlangen</unclear> <unclear cert="low" resp="#joint">moechte</unclear>,
<lb n="40"/><unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">wollich</unclear> uß uwer deß <orgName ref="stadtasg-actors-552" cert="medium" resp="#ner">Spitals</orgName> holtzer,
<lb n="41"/>etwaß entfremdt, habend wir dieselbige
<lb n="42"/>fuer unß ervorderet, und nach beschechner
<lb n="43"/>examinieren, der gebuer, und jrem verdienen
<lb n="44"/>nach abgestrafft. Und so aber sollich
<lb n="45"/><unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">mehr</unclear> <unclear cert="low" resp="#joint">derselbigen</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">soten</unclear>, (<unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">sye</unclear> nach
<lb n="46"/><unclear cert="low" resp="#joint">anduetung</unclear>, gegen <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">gemelten</unclear> <unclear cert="low" resp="#joint">houptman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">Metzger</unclear></persName> bescheche sin solle.) wolliche in selbigen
<lb n="48"/><unclear cert="low" resp="#joint">hoeltzer</unclear> <unclear cert="low" resp="#joint">kuenfftig</unclear> <unclear cert="low" resp="#joint">diebswiß</unclear> <unclear cert="low" resp="#joint">verfuebt</unclear>. <unclear cert="low" resp="#joint">Wuere</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">glichfalß</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">begeren</unclear>, unß selbige persohnen
<lb n="50"/>namhafft ze machen, die wir <unclear cert="low" resp="#joint">irem</unclear>
<lb n="51"/><unclear cert="low" resp="#joint">verdienen</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">zestraffen</unclear> nit <unclear cert="low" resp="#joint">underlaßen</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">werdend</unclear>. <unclear cert="low" resp="#joint">Unß</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">hieran</unclear> <unclear cert="low" resp="#joint">ein</unclear> nachparliches
<lb n="53"/>gefallen beschicht. In betrachtung, daß wir
<lb n="54"/><unclear cert="low" resp="#joint">glichmaeßig</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">andere</unclear> <unclear cert="low" resp="#joint">oberkeiten</unclear> <unclear cert="low" resp="#joint">gesinet</unclear>,
<lb n="55"/><unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">boeß</unclear> <unclear cert="low" resp="#joint">abzeschaffen</unclear>, <unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">jedrem</unclear> <unclear cert="low" resp="#joint">daß</unclear>
<lb n="56"/><unclear cert="low" resp="#joint">sinige</unclear> <unclear cert="low" resp="#joint">geschirmbt</unclear> <unclear cert="low" resp="#joint">werde</unclear> etc.
<lb n="57"/>Woellend unß hiemit sambtlich, aller sites
<lb n="58"/>goetlichen schirm wol bevolchen haben.
<lb n="59"/><unclear cert="low" resp="#joint">Datho</unclear> <unclear cert="low" resp="#joint">ze</unclear> <origPlace ref="stadtasg-places-263" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Trogen</unclear></origPlace> <origDate when="1628" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">5</unclear>. <unclear cert="low" resp="#joint">ten</unclear> <unclear cert="low" resp="#joint">December</unclear>.
<lb n="60"/>anno 1628.</origDate>
<lb n="61"/><orgName ref="stadtasg-actors-565" cert="medium" role="issuer" resp="#ner">Landtaman und rath der <unclear cert="low" resp="#joint">ußeren</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">roden</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">landts</unclear> <unclear cert="low" resp="#joint">Appenzell</unclear></orgName>.
<pb facs="StadtASG_Missive_2718_10553.jpg" n="3"/>
<pb facs="StadtASG_Missive_2718_10554.jpg" n="4"/>
<lb n="63"/>Den <unclear cert="low" resp="#joint">edlen</unclear>, <unclear cert="low" resp="#joint">vesten</unclear>, frommen, <unclear cert="low" resp="#joint">fürnemmen</unclear>, fürsichtigen,
<lb n="64"/>ersammen und <unclear cert="low" resp="#joint">weyßen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermeister</unclear> und Rath
<lb n="65"/>der Statt St. Gallen</orgName> unnseren inßonders
<lb n="66"/>guoten fründen und gethrüwen lieben nachparn.
</p>
        </body>
