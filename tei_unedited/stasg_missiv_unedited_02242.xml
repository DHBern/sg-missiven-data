        <body>
<p>
<pb facs="StadtASG_Missive_2242_8481.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">fründtlich</unclear>, <unclear cert="medium" resp="#joint">nachberlich</unclear> dienst und
<lb n="2"/><unclear cert="low" resp="#joint">gruoß</unclear> <unclear cert="low" resp="#joint">zuovor</unclear>, <unclear cert="low" resp="#joint">edler</unclear>, <unclear cert="low" resp="#joint">ehrenvester</unclear>, <unclear cert="low" resp="#joint">weiser</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">besunders</unclear> <unclear cert="low" resp="#joint">lieber</unclear> <unclear cert="low" resp="#joint">herr</unclear> <unclear cert="low" resp="#joint">landtvogt</unclear>, <unclear cert="low" resp="#joint">gueter</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">fründt</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachber</unclear>.
<lb n="5"/>Was derselbig an <unclear cert="medium" resp="#joint">uns</unclear>, wegen <persName resp="#ner">Salomon</persName>,
<lb n="6"/>und <unclear cert="medium" resp="#joint">Eliae</unclear> der Juden zuo <placeName ref="stadtasg-places-88" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Reinegkh</unclear></placeName>, <unclear cert="low" resp="#joint">euwerer</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">ambtsundersaeßen</unclear> <unclear cert="low" resp="#joint">intercedendo</unclear> <unclear cert="low" resp="#joint">geschriben</unclear>,
<lb n="8"/>haben wir <unclear cert="medium" resp="#joint">ußem</unclear> <unclear cert="medium" resp="#joint">empfangnem</unclear> schreiben,
<lb n="9"/><unclear cert="medium" resp="#joint">abhoerlich</unclear> wol verstanden. <unclear cert="medium" resp="#joint">Koennen</unclear>
<lb n="10"/>uns wol <unclear cert="medium" resp="#joint">erinneren</unclear>, daß wir <unclear cert="medium" resp="#joint">den</unclear> juden <unclear cert="low" resp="#joint">ins</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">gemein</unclear>, nach dem <unclear cert="medium" resp="#joint">dieselben</unclear> <unclear cert="medium" resp="#joint">etliche</unclear> <unclear cert="medium" resp="#joint">bey</unclear> <unclear cert="medium" resp="#joint">jetzigem</unclear> <unclear cert="medium" resp="#joint">verderbtem</unclear> <unclear cert="medium" resp="#joint">muentz</unclear>
<lb n="12"/><unclear cert="medium" resp="#joint">wechßlen</unclear>, alhie in unser Statt, <unclear cert="low" resp="#joint">allerley</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">vnertraegliche</unclear> <unclear cert="low" resp="#joint">schadigung</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">treiben</unclear> <unclear cert="low" resp="#joint">causiert</unclear> und <unclear cert="low" resp="#joint">gmacht</unclear>, und
<lb n="14"/><unclear cert="low" resp="#joint">domit</unclear> sie ihren handel und wandel
<lb n="15"/><unclear cert="medium" resp="#joint">desto</unclear> sicherer haben <unclear cert="medium" resp="#joint">koendten</unclear>, sich <unclear cert="low" resp="#joint">anderer</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">ehrlichen</unclear> <unclear cert="low" resp="#joint">bekleidungen</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">unbekandtnuß</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">gebraucht</unclear>, und <unclear cert="low" resp="#joint">alß</unclear> nit <unclear cert="medium" resp="#joint">nur</unclear> ein <unclear cert="low" resp="#joint">sonder</unclear> zuo mehr-
<lb n="18"/>mahlen, mit <unclear cert="low" resp="#joint">oberkeitlichem</unclear> <unclear cert="low" resp="#joint">ernst</unclear> <unclear cert="low" resp="#joint">uffer</unclear>-
<lb n="19"/>legt, sich unser Statt und <unclear cert="low" resp="#joint">jurisdiction</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">enteußeren</unclear>. <unclear cert="low" resp="#joint">Und</unclear>
<lb n="21"/>dieweil dann <unclear cert="low" resp="#joint">unsere</unclear> <unclear cert="low" resp="#joint">altvorderen</unclear> die
<lb n="22"/>Juden <unclear cert="medium" resp="#joint">niemalen</unclear> <unclear cert="medium" resp="#joint">weder</unclear> glitten noch <unclear cert="medium" resp="#joint">gedultet</unclear>,
<lb n="23"/><unclear cert="medium" resp="#joint">und</unclear> deßwegen <unclear cert="low" resp="#joint">satzung</unclear> <unclear cert="low" resp="#joint">hinderlaßen</unclear>,
<lb n="24"/>welche <unclear cert="low" resp="#joint">bißdahero</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">streng</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">wesehen</unclear> observiert <unclear cert="medium" resp="#joint">und</unclear> darob
<lb n="25"/><unclear cert="low" resp="#joint">muoßen</unclear> <unclear cert="low" resp="#joint">ghalten</unclear>, <unclear cert="low" resp="#joint">alß</unclear> wir
<lb n="26"/>es <unclear cert="low" resp="#joint">nochmalen</unclear> <unclear cert="low" resp="#joint">darbey</unclear> <unclear cert="low" resp="#joint">bewenden</unclear> <unclear cert="low" resp="#joint">laßen</unclear>. Welches
<lb n="27"/><unclear cert="medium" resp="#joint">dem</unclear> herren, wir <unclear cert="medium" resp="#joint">bester</unclear> <unclear cert="medium" resp="#joint">fründt</unclear>-, nach-
<pb facs="StadtASG_Missive_2242_8482.jpg" n="2"/>
<lb n="28"/><unclear cert="medium" resp="#joint">barlicher</unclear> wolmeinung, in antwort
<lb n="29"/><unclear cert="medium" resp="#joint">nit</unclear> <unclear cert="medium" resp="#joint">verhalten</unclear> <unclear cert="medium" resp="#joint">woellen</unclear>; <unclear cert="medium" resp="#joint">bÿneben</unclear> aber
<lb n="30"/>uns <unclear cert="medium" resp="#joint">erbieten</unclear> <unclear cert="medium" resp="#joint">thund</unclear>, wo wir <unclear cert="medium" resp="#joint">ihme</unclear>
<lb n="31"/>in <unclear cert="medium" resp="#joint">andere</unclear> weg, da es <unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="low" resp="#joint">betreffen</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">thuet</unclear>, alle <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">nachbarliche</unclear> <unclear cert="medium" resp="#joint">freund</unclear>-
<lb n="33"/>schafft <unclear cert="medium" resp="#joint">koennen</unclear> <unclear cert="medium" resp="#joint">erweisen</unclear>, <unclear cert="medium" resp="#joint">sind</unclear> wir
<lb n="34"/><unclear cert="medium" resp="#joint">jederzeit</unclear> <unclear cert="medium" resp="#joint">urbuetig</unclear>. Damit uns <unclear cert="low" resp="#joint">dem</unclear>
<lb n="35"/>lieben <unclear cert="medium" resp="#joint">Gott</unclear> <unclear cert="medium" resp="#joint">wol</unclear> <unclear cert="medium" resp="#joint">bevehlende</unclear>. <unclear cert="medium" resp="#joint">Date</unclear>
<lb n="36"/>den. <origDate when="1620" resp="#ner"><unclear cert="medium" resp="#joint">30</unclear>. <unclear cert="medium" resp="#joint">7bris</unclear>. 1620</origDate>.
<lb n="37"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und
<lb n="38"/><unclear cert="medium" resp="#joint">raht</unclear> der statt Sant-
<lb n="39"/>Gallen</orgName>.
<lb n="40"/>Dem edlen ehrenvesten und weisen
<lb n="41"/><persName role="recipient" resp="#ner">Johann <unclear cert="medium" resp="#joint">Zimmermann</unclear></persName>, <unclear cert="medium" resp="#joint">hauptman</unclear> und des
<lb n="42"/><unclear cert="low" resp="#joint">rahts</unclear> der statt Lucern, landtvogt im
<lb n="43"/><placeName ref="stadtasg-places-64" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Reinthal</unclear></placeName>, <unclear cert="medium" resp="#joint">unserm</unclear> <unclear cert="medium" resp="#joint">besonders</unclear> lieben herren
<lb n="44"/><unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">freund</unclear> und <unclear cert="medium" resp="#joint">nachbarn</unclear>.
<pb facs="StadtASG_Missive_2242_8483.jpg" n="3"/>
<pb facs="StadtASG_Missive_2242_8484.jpg" n="4"/>
<lb n="45"/>An H. Lvogt im <placeName ref="stadtasg-places-64" cert="medium" resp="#ner">Rhinthal</placeName>. <origDate when="1620" resp="#ner">30 9br.
<lb n="46"/>1620</origDate>
</p>
