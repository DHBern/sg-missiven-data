    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1519_5475.jpg" n="1"/>
<lb n="1"/>Unnser freündtlich, <unclear cert="low" resp="#joint">nachburlich</unclear> und <unclear cert="medium" resp="#joint">guetwillige</unclear>
<lb n="2"/>dienst, zuvor <unclear cert="low" resp="#joint">Fuersichtigen</unclear>, <unclear cert="low" resp="#joint">Ersamen</unclear> und weysen,
<lb n="3"/>besonders lieben <unclear cert="low" resp="#joint">freündt</unclear> und <unclear cert="low" resp="#joint">guete</unclear> nachburen.
<lb n="4"/>Bey unns ist ainer, der sich <unclear cert="medium" resp="#joint">nennt</unclear> <persName resp="#ner">Mathis Mueller</persName>,
<lb n="5"/>seines <unclear cert="low" resp="#joint">handtwercks</unclear> <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">weber</unclear>, <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">Person</unclear> <unclear cert="low" resp="#joint">von</unclear> ain und
<lb n="6"/>zwaintzig Jarn, wegen aines diebstals, <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">ime</unclear> ge=
<lb n="7"/>funden worden, in <unclear cert="low" resp="#joint">gefaengklich</unclear> <unclear cert="low" resp="#joint">verstrickung</unclear> <unclear cert="low" resp="#joint">inkhom=</unclear>
<lb n="8"/>men. der hatt in seiner bekanntnus <unclear cert="low" resp="#joint">angetzaigt</unclear>, sein
<lb n="9"/>vatter seye <unclear cert="low" resp="#joint">sunsten</unclear> von <placeName resp="#ner"><unclear cert="low" resp="#joint">Yßne</unclear></placeName> <unclear cert="low" resp="#joint">gewesen</unclear>, hab aber zue
<lb n="10"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">S. Gallen</placeName>, da er <unclear cert="medium" resp="#joint">erboren</unclear>, <unclear cert="medium" resp="#joint">gewohnt</unclear>, seye <unclear cert="medium" resp="#joint">vorlengsten</unclear> ge=
<lb n="11"/>storben, hab <unclear cert="medium" resp="#joint">gehaißen</unclear> <persName resp="#ner">Jeronimus Mueller</persName>, <unclear cert="medium" resp="#joint">daselbs</unclear> sey sein
<lb n="12"/><unclear cert="low" resp="#joint">muetter</unclear> bey <placeName resp="#ner"><unclear cert="low" resp="#joint">Eüch</unclear></placeName> <unclear cert="low" resp="#joint">noch</unclear> ain <unclear cert="medium" resp="#joint">wittib</unclear> <unclear cert="medium" resp="#joint">sußen</unclear>, deren schwester
<lb n="13"/><persName resp="#ner"><unclear cert="low" resp="#joint">Eehmann</unclear> der Nuernberger</persName> <unclear cert="medium" resp="#joint">Pott</unclear> <persName resp="#ner">Andreas <unclear cert="medium" resp="#joint">Stühelin</unclear></persName>,
<lb n="14"/>und seye er alainig <unclear cert="low" resp="#joint">vatterivem</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">zueerkanndten</unclear>,
<lb n="15"/>wie auch <unclear cert="low" resp="#joint">lebendten</unclear>, <unclear cert="low" resp="#joint">daz</unclear> <unclear cert="low" resp="#joint">geelbeden</unclear> sey <unclear cert="low" resp="#joint">schon</unclear> <unclear cert="low" resp="#joint">verthaet</unclear>. <unclear cert="medium" resp="#joint">sonn=</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">sten</unclear> hab er sich in diser seiner iugent, <unclear cert="medium" resp="#joint">ußer</unclear> diser seiner
<lb n="17"/>übelthat, <unclear cert="medium" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">untadelich</unclear> in der gleichen <unclear cert="low" resp="#joint">verbrechen</unclear>
<lb n="18"/>verhalten, wie dann bey <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">besagten</unclear> seinen
<lb n="19"/>verwandten werde <unclear cert="low" resp="#joint">zueerkuendigen</unclear> sein.
<lb n="20"/><unclear cert="medium" resp="#joint">Diewiln</unclear> dann nun unns <unclear cert="low" resp="#joint">obgelegen</unclear>, dises seines ver=
<lb n="21"/><unclear cert="low" resp="#joint">ruehmens</unclear> <unclear cert="low" resp="#joint">gründtlichen</unclear> <unclear cert="medium" resp="#joint">bricht</unclear> <unclear cert="low" resp="#joint">zuhaben</unclear>, <unclear cert="low" resp="#joint">alß</unclear> haben wir
<lb n="22"/>nit <unclear cert="low" resp="#joint">underlaßen</unclear> <unclear cert="low" resp="#joint">künden</unclear>, bey alainig <unclear cert="low" resp="#joint">deßen</unclear> darumben
<lb n="23"/><unclear cert="low" resp="#joint">abgeschickhten</unclear> <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">stattpotten</unclear> <unclear cert="low" resp="#joint">Eüch</unclear> <unclear cert="low" resp="#joint">deßhalben</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">freündt</unclear>. <unclear cert="low" resp="#joint">nachpurlichen</unclear> zuezeschreiben. Mit <unclear cert="medium" resp="#joint">freündt</unclear>.
<lb n="25"/><unclear cert="medium" resp="#joint">nachpurlicher</unclear> Pitt, Ir <unclear cert="low" resp="#joint">wellet</unclear> <unclear cert="low" resp="#joint">unbeschwaerdt</unclear> <unclear cert="low" resp="#joint">unß</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">nachpurlich</unclear> <unclear cert="low" resp="#joint">brichten</unclear>, wie sein <unclear cert="low" resp="#joint">thuen</unclear> beschaffen, ob
<lb n="27"/>er dises seines <unclear cert="low" resp="#joint">herkhommens</unclear> und <unclear cert="low" resp="#joint">verhaltens</unclear> unns die
<lb n="28"/><unclear cert="low" resp="#joint">warhaitt</unclear> <unclear cert="low" resp="#joint">fürgeben</unclear>. Daran wie Ir die liebe
<pb facs="StadtASG_Missive_1519_5476.jpg" n="2"/>
<lb n="29"/><unclear cert="low" resp="#joint">iustitiam</unclear> <unclear cert="low" resp="#joint">befüerdern</unclear>, alß syen wir <unclear cert="medium" resp="#joint">eüch</unclear> <unclear cert="medium" resp="#joint">uff</unclear>
<lb n="30"/><unclear cert="medium" resp="#joint">begebnenen</unclear> fällen <unclear cert="low" resp="#joint">freünttnachbaurlich</unclear> <unclear cert="low" resp="#joint">zuebe=</unclear>
<lb n="31"/>gegnen, und solches <unclear cert="low" resp="#joint">zueerwidern</unclear> <unclear cert="low" resp="#joint">guettwillig</unclear>. Gött=
<lb n="32"/>licher <unclear cert="medium" resp="#joint">bewarnus</unclear> <unclear cert="medium" resp="#joint">unnß</unclear> damitt sambtlichen <unclear cert="low" resp="#joint">emp=</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">felhend</unclear>. Datum <origDate when="1606-10-12" resp="#ner">den 12 octobris.
<lb n="34"/>anno 1606.</origDate>
<lb n="35"/><orgName ref="stadtasg-actors-587" cert="medium" role="issuer" resp="#ner">Verwalter der <unclear cert="medium" resp="#joint">haubtmannschaft</unclear>,
<lb n="36"/>burgermaister und rath der statt
<lb n="37"/>Costantz</orgName>.
<pb facs="StadtASG_Missive_1519_5477.jpg" n="3"/>
<pb facs="StadtASG_Missive_1519_5478.jpg" n="4"/>
<lb n="38"/>Den fuersichtigen, ersamen, weyßen,
<lb n="39"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und <unclear cert="low" resp="#joint">rhat</unclear> <unclear cert="low" resp="#joint">zue</unclear> S.
<lb n="40"/>Gallen</orgName>, unnßern besonders lieben
<lb n="41"/>freundten und guetten nachbauren.
</p>
