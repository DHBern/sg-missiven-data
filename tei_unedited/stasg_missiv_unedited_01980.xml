        <body>
<p>
<pb facs="StadtASG_Missive_1980_7381.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freündt</unclear>-, <unclear cert="medium" resp="#joint">nachbarlich</unclear> willig dienst, und was
<lb n="2"/>wir liebs und guots <unclear cert="medium" resp="#joint">vermoegend</unclear>, zuovor, <unclear cert="medium" resp="#joint">edler</unclear>,
<lb n="3"/><unclear cert="medium" resp="#joint">vester</unclear> und <unclear cert="medium" resp="#joint">weyser</unclear>, <unclear cert="medium" resp="#joint">sonders</unclear> <unclear cert="medium" resp="#joint">lieber</unclear> <unclear cert="medium" resp="#joint">herr</unclear> Landt-
<lb n="4"/>vogt, <unclear cert="medium" resp="#joint">guoter</unclear> <unclear cert="medium" resp="#joint">freünd</unclear> und <unclear cert="medium" resp="#joint">nachbar</unclear>.
<lb n="5"/>Dieweil wir <unclear cert="medium" resp="#joint">erachtet</unclear>, <unclear cert="medium" resp="#joint">weger</unclear> <unclear cert="medium" resp="#joint">seyn</unclear>, <unclear cert="medium" resp="#joint">eüwer</unclear>
<lb n="6"/>an uns, wegen <persName resp="#ner"><unclear cert="medium" resp="#joint">Steffen</unclear> <unclear cert="medium" resp="#joint">Majers</unclear></persName>, abgangen <unclear cert="medium" resp="#joint">schreiben</unclear>,
<lb n="7"/><unclear cert="medium" resp="#joint">muendtlich</unclear> als schrifftlich <unclear cert="medium" resp="#joint">zuobeantwurten</unclear>, so
<lb n="8"/>haben wir solches <unclear cert="medium" resp="#joint">zuoverrichten</unclear> <unclear cert="medium" resp="#joint">unseren</unclear> lieben
<lb n="9"/>getrüwen <unclear cert="medium" resp="#joint">Stattchribern</unclear> <persName resp="#ner">Melchior <unclear cert="medium" resp="#joint">Guoldin</unclear></persName>
<lb n="10"/><unclear cert="medium" resp="#joint">zuoverrichten</unclear> <unclear cert="medium" resp="#joint">anbefolchen</unclear>. <unclear cert="medium" resp="#joint">Dem</unclear> <unclear cert="medium" resp="#joint">wollend</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">ihr</unclear> in <unclear cert="medium" resp="#joint">seinem</unclear> anbringen als uns <unclear cert="medium" resp="#joint">selbsten</unclear> <unclear cert="medium" resp="#joint">glauben</unclear>
<lb n="12"/>zuostellen, und hiemit <unclear cert="medium" resp="#joint">freündt</unclear>-, <unclear cert="medium" resp="#joint">nachbarlich</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">ersuocht</unclear> seyn, die sachen dahin <unclear cert="medium" resp="#joint">zuorichten</unclear>, <unclear cert="medium" resp="#joint">daß</unclear>
<lb n="14"/>gedachter <persName resp="#ner"><unclear cert="medium" resp="#joint">Majer</unclear></persName> <unclear cert="medium" resp="#joint">einerewors</unclear> <unclear cert="medium" resp="#joint">ruewig</unclear> <unclear cert="medium" resp="#joint">verbleibe</unclear>,
<lb n="15"/>oder da er <unclear cert="medium" resp="#joint">je</unclear> an <unclear cert="medium" resp="#joint">unseren</unclear> burger <persName resp="#ner"><unclear cert="medium" resp="#joint">Johannes</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">Scheürhemen</unclear></persName> was <unclear cert="low" resp="#joint">weiters</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">sprechen</unclear>, er <unclear cert="medium" resp="#joint">ihne</unclear>
<lb n="17"/><unclear cert="medium" resp="#joint">Eidtgnossischem</unclear> brauch und <unclear cert="medium" resp="#joint">gwonheit</unclear> nach
<lb n="18"/>vor seinem <unclear cert="medium" resp="#joint">ordenlichen</unclear> richter <unclear cert="medium" resp="#joint">suoche</unclear>, da
<lb n="19"/>ihme <unclear cert="medium" resp="#joint">guot</unclear> gebürlich und <unclear cert="medium" resp="#joint">unverweisenlich</unclear>
<lb n="20"/>recht widerfahren solle. Eüch <unclear cert="medium" resp="#joint">hiewider</unclear>-
<lb n="21"/><unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">freündtschafft</unclear> und <unclear cert="medium" resp="#joint">allen</unclear> <unclear cert="medium" resp="#joint">angenemen</unclear>
<lb n="22"/>willen <unclear cert="medium" resp="#joint">zuoerweisen</unclear> <unclear cert="medium" resp="#joint">seyn</unclear> wir erbietig
<lb n="23"/>willig. Gottes <unclear cert="medium" resp="#joint">bwarhung</unclear> uns <unclear cert="medium" resp="#joint">samthlich</unclear>
<lb n="24"/>wol <unclear cert="medium" resp="#joint">befelchende</unclear>. Datum den .<origDate when="1626-02-22" resp="#ner"><unclear cert="low" resp="#joint">22</unclear>. <unclear cert="low" resp="#joint">tag</unclear> februarii
<lb n="25"/><unclear cert="medium" resp="#joint">A°</unclear> <unclear cert="medium" resp="#joint">1626</unclear></origDate>.
<lb n="26"/><unclear cert="medium" resp="#joint">B</unclear>. und <unclear cert="medium" resp="#joint">rhat</unclear>.
<lb n="27"/>Dem edlen vesten weisen <persName role="issuer" resp="#ner">Heinrich <unclear cert="medium" resp="#joint">Elmer</unclear></persName>
<lb n="28"/>des <unclear cert="medium" resp="#joint">Raths</unclear> und <unclear cert="medium" resp="#joint">Pannerherr</unclear> zuo <placeName resp="#ner">Glarus</placeName>, der
<lb n="29"/>zeit Landtvogt der <placeName resp="#ner">Landtgraffschafft</placeName> <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Turgoew</unclear></placeName>,
<lb n="30"/><unclear cert="medium" resp="#joint">unserem</unclear> insonders lieben herrn guoten
<lb n="31"/>fründ und <unclear cert="medium" resp="#joint">nachbarn</unclear>.
<pb facs="StadtASG_Missive_1980_7382.jpg" n="2"/>
<lb n="32"/>An H. l.vogt im <origPlace ref="stadtasg-places-103" cert="medium" resp="#ner">Turgoew</origPlace> 22<origDate when="1616" resp="#ner">. febr.
<lb n="33"/>1616</origDate>.
</p>
