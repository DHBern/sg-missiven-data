    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1915_7131.jpg" n="1"/>
<lb n="1"/>Unßer früntlich willig dinst sampt waß wir
<lb n="2"/>ehren liebs unn guots vermögend zuovor.
<lb n="3"/>Fromm fürsichtig ehrsam und wißs, jnsonders
<lb n="4"/>guot fründ, und wolvetrauet lieb nachparn.
<lb n="5"/>Eß hat der unßer <persName resp="#ner">Herman <unclear cert="low" resp="#joint">Tobler</unclear></persName> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">Wisen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">jm</unclear> <placeName ref="stadtasg-places-263" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Trogen</unclear></placeName>, <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">leiderß</unclear> <unclear cert="low" resp="#joint">innig</unclear> und <unclear cert="low" resp="#joint">hochbedurlich</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">br=</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">ngken</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">das</unclear> er <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">kurtzhigewichner</unclear> <unclear cert="low" resp="#joint">zijts</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">jn</unclear> <unclear cert="low" resp="#joint">üwerem</unclear> <unclear cert="low" resp="#joint">Kornhuß</unclear> zuo <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sainct Gallen</placeName>, üwerem
<lb n="9"/>burger <persName resp="#ner">Jacoben Wetteer</persName>, einen vierting kernen umb
<lb n="10"/>23. k. aberkufft und alß er uff gradt glicke
<lb n="11"/>das gelt erlegt, habe <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">genanten</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Wetters</unclear></persName> <unclear cert="low" resp="#joint">knab</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">gefragt</unclear> <unclear cert="low" resp="#joint">wellicher</unclear>, <unclear cert="low" resp="#joint">under</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">jenigen</unclear> so daselbst
<lb n="13"/>gestanden, den selbigen <unclear cert="low" resp="#joint">kernen</unclear> <unclear cert="low" resp="#joint">bezalen</unclear> <unclear cert="low" resp="#joint">muoße</unclear>.
<lb n="14"/>Er <persName resp="#ner"><unclear cert="low" resp="#joint">Herman</unclear> <unclear cert="low" resp="#joint">Tobler</unclear></persName> <unclear cert="low" resp="#joint">geantwurtet</unclear>, <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">muoße</unclear> <unclear cert="low" resp="#joint">jnne</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">bezalen</unclear>, und hieruff <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">zeiger</unclear> <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">deßselbigen</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">werttß</unclear> <unclear cert="low" resp="#joint">firt</unclear> <unclear cert="low" resp="#joint">pfenning</unclear> <unclear cert="low" resp="#joint">gegeben</unclear>. <unclear cert="low" resp="#joint">Hieruff</unclear> <unclear cert="low" resp="#joint">gesagter</unclear> üwer
<lb n="17"/>burger <persName resp="#ner">Jacob <unclear cert="low" resp="#joint">Wetter</unclear></persName>, <unclear cert="low" resp="#joint">jnne</unclear> <unclear cert="low" resp="#joint">nitt</unclear> allein mit so grob
<lb n="18"/>ehr verletzlichen wortten, vor menkhligem offenlich
<lb n="19"/>verletzt und angetastet, daß jme die selbigen
<lb n="20"/>zuo <unclear cert="low" resp="#joint">lyden</unclear> <unclear cert="low" resp="#joint">gantz</unclear> <unclear cert="low" resp="#joint">uerträglich</unclear>, <unclear cert="low" resp="#joint">sonder</unclear> <unclear cert="low" resp="#joint">berrlend</unclear> <unclear cert="low" resp="#joint">jnne</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zum</unclear> <unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">mall</unclear> <unclear cert="low" resp="#joint">unbefuogter</unclear> <unclear cert="low" resp="#joint">wiß</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">boden</unclear> ge=
<lb n="22"/>schlagen, unnd jne alß offenlich zuo spotz unnd
<lb n="23"/>schandten zuo bringen begert. Dath jnne wir <unclear cert="low" resp="#joint">billig</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">zum</unclear> <unclear cert="low" resp="#joint">höchsten</unclear> <unclear cert="low" resp="#joint">bedure</unclear>. Und <unclear cert="low" resp="#joint">sintemallen</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">gezwungen</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">werde</unclear>, zuo <unclear cert="low" resp="#joint">nottwendiger</unclear> <unclear cert="low" resp="#joint">rettung</unclear> <unclear cert="low" resp="#joint">siner</unclear> <unclear cert="low" resp="#joint">ehren</unclear>. <unclear cert="low" resp="#joint">Deß=</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">tene</unclear> <unclear cert="low" resp="#joint">recht</unclear>, <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">gemelten</unclear> <unclear cert="low" resp="#joint">üweren</unclear> <unclear cert="low" resp="#joint">burger</unclear> <unclear cert="low" resp="#joint">Jacob</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">Wetter</unclear> <unclear cert="low" resp="#joint">anzuorueffen</unclear>, <unclear cert="low" resp="#joint">hat</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">unß</unclear> umb <unclear cert="low" resp="#joint">bistand</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">gezügknuß</unclear> <unclear cert="low" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">bißher</unclear> <unclear cert="low" resp="#joint">verhaltens</unclear>, <unclear cert="low" resp="#joint">demuettigst</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">flißes</unclear> <unclear cert="low" resp="#joint">gepetten</unclear>. <unclear cert="low" resp="#joint">Diewill</unclear> <unclear cert="low" resp="#joint">sii</unclear> <unclear cert="low" resp="#joint">underthenig</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">pitten</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">verstanden</unclear>, und unß selbsten <unclear cert="low" resp="#joint">hechß</unclear> <unclear cert="low" resp="#joint">schuldig</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">erkennend</unclear> die wahrheit, und die unßeren jn billichen
<lb n="32"/>sachen zuo befürderen. So sagend und bezügend wir hie=
<lb n="33"/>mit alß unß gepürt, daß wir von den unßeren hiee
<lb n="34"/>unßerer mitträtten, den gläubwirdigen bricht em=
<lb n="35"/>pfangen, das gedachter <persName resp="#ner">Herman <unclear cert="low" resp="#joint">Tobler</unclear></persName>, <unclear cert="low" resp="#joint">sowol</unclear> <unclear cert="low" resp="#joint">auch</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">sine</unclear> <unclear cert="low" resp="#joint">vorrelttern</unclear> und geschwüsterigt, sich <unclear cert="low" resp="#joint">jedertijt</unclear> <unclear cert="low" resp="#joint">ehrlich</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">redlig</unclear> und unverlümbdet gehalten, das man <unclear cert="low" resp="#joint">bjm</unclear>
<lb n="38"/><unclear cert="low" resp="#joint">allerwennigisten</unclear> <unclear cert="low" resp="#joint">jnen</unclear> <unclear cert="low" resp="#joint">nichtß</unclear> <unclear cert="low" resp="#joint">böseß</unclear> <unclear cert="low" resp="#joint">nachzuo</unclear> <unclear cert="low" resp="#joint">reden</unclear> <unclear cert="low" resp="#joint">wußt</unclear>
<pb facs="StadtASG_Missive_1915_7132.jpg" n="2"/>
<lb n="39"/>Gelangt deßwegen an uech unßer fründt nachparlich
<lb n="40"/>begeren. Ir wellend, wie unß im allerwenigisten
<lb n="41"/>nicht zwyfflet, gemeltem unßerem landtman, von
<lb n="42"/>unßertwegen allen günstigen guotten willen erzeigen,
<lb n="43"/>und behülfflich sin, das gesagter uewer burger <persName resp="#ner"><unclear cert="low" resp="#joint">Jacob</unclear>
<lb n="44"/><unclear cert="low" resp="#joint">Metler</unclear></persName>, <unclear cert="low" resp="#joint">syne</unclear> <unclear cert="low" resp="#joint">ußgoßne</unclear> <unclear cert="low" resp="#joint">schmachwort</unclear> <unclear cert="low" resp="#joint">erwysen</unclear>, oder
<lb n="45"/>Ime, neben abtrag billichen costens, Jnne nach
<lb n="46"/>noturfft syner ehren entschlach und <unclear cert="low" resp="#joint">widerruoffe</unclear>,
<lb n="47"/><unclear cert="low" resp="#joint">do</unclear> wir <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">gedenckhen</unclear> <unclear cert="low" resp="#joint">wirt</unclear> <unclear cert="low" resp="#joint">synen</unclear> <unclear cert="low" resp="#joint">ehren</unclear> <unclear cert="low" resp="#joint">gnuog</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="48"/><unclear cert="low" resp="#joint">schehen</unclear> <unclear cert="low" resp="#joint">sin</unclear>. <unclear cert="low" resp="#joint">Solches</unclear> <unclear cert="low" resp="#joint">begerend</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">uech</unclear>, <unclear cert="low" resp="#joint">alß</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">dennen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">sonsten</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">allen</unclear> <unclear cert="low" resp="#joint">nachparlichen</unclear> und
<lb n="50"/><unclear cert="low" resp="#joint">fründtwilligen</unclear> <unclear cert="low" resp="#joint">diensten</unclear> <unclear cert="low" resp="#joint">wolgeneigt</unclear>, In zuotrag-
<lb n="51"/>enden fählen gantz fründtlich ze erwideren. Damit
<lb n="52"/>unß sambtlich goettlichen gnaden bevelchend. Date
<lb n="53"/><origPlace ref="stadtasg-places-263" cert="medium" resp="#ner">Trogen</origPlace> <origDate when="1614" resp="#ner">den .<unclear cert="low" resp="#joint">28.ten</unclear> <unclear cert="low" resp="#joint">Septemb</unclear>: Anno 1614</origDate>.
<lb n="54"/><orgName ref="stadtasg-actors-565" cert="medium" role="issuer" resp="#ner">Lanndtaman und rath der usseren
<lb n="55"/>roden deß landts Appenzell</orgName>.
<pb facs="StadtASG_Missive_1915_7133.jpg" n="3"/>
<pb facs="StadtASG_Missive_1915_7134.jpg" n="4"/>
<lb n="56"/>Denen frommen fuersichtigen
<lb n="57"/>ehrsamen und weÿßen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="58"/>meister und Rath der statt Sant
<lb n="59"/>Gallen</orgName>. Unßeren inßonders
<lb n="60"/>guetten freünden. und wollver-
<lb n="61"/>trüwten lieben nachparen <unclear cert="low" resp="#joint">etc</unclear>.
</p>
