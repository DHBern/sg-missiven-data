<lb n="27"/><unclear cert="low" resp="#joint">Wetter</unclear> <unclear cert="low" resp="#joint">anzuorueffen</unclear>, hat er unß umb <unclear cert="low" resp="#joint">bistand</unclear>
<lb n="28"/>und <unclear cert="low" resp="#joint">gezügknuß</unclear> <unclear cert="low" resp="#joint">sines</unclear> bißher verhaltens, <unclear cert="low" resp="#joint">demuettigst</unclear>
