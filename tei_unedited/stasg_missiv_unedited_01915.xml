<lb n="3"/>Fromm <unclear cert="medium" resp="#joint">fürsichtig</unclear> <unclear cert="low" resp="#joint">ehrsam</unclear> und <unclear cert="low" resp="#joint">wißs</unclear>, <unclear cert="low" resp="#joint">jnsonders</unclear>
<lb n="4"/><unclear cert="medium" resp="#joint">guot</unclear> fründ, und <unclear cert="low" resp="#joint">wolvetrauet</unclear> lieb <unclear cert="medium" resp="#joint">nachparn</unclear>.
<lb n="5"/>Eß hat der <unclear cert="medium" resp="#joint">unßer</unclear> <persName resp="#ner">Herman <unclear cert="low" resp="#joint">Tobler</unclear></persName> an der <unclear cert="medium" resp="#joint">Wisen</unclear>
<lb n="6"/><unclear cert="medium" resp="#joint">jm</unclear> <placeName ref="stadtasg-places-263" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Trogen</unclear></placeName>, unß <unclear cert="low" resp="#joint">leiderß</unclear> innig und <unclear cert="low" resp="#joint">hochbedurlich</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">br=</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">ngken</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, wie das er <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">kurtzhigewichner</unclear> <unclear cert="low" resp="#joint">zijts</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">jn</unclear> <unclear cert="low" resp="#joint">üwerem</unclear> <unclear cert="low" resp="#joint">Kornhuß</unclear> zuo <placeName ref="stadtasg-places-38" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Sainct</unclear> Gallen</placeName>, <unclear cert="low" resp="#joint">üwerem</unclear>
<lb n="9"/>burger <persName resp="#ner">Jacoben <unclear cert="low" resp="#joint">Wetteer</unclear></persName>, einen <unclear cert="low" resp="#joint">vierting</unclear> <unclear cert="medium" resp="#joint">kernen</unclear> umb
<lb n="10"/>23. <unclear cert="low" resp="#joint">k</unclear>. <unclear cert="low" resp="#joint">aberkufft</unclear> und alß er uff <unclear cert="low" resp="#joint">gradt</unclear> <unclear cert="low" resp="#joint">glicke</unclear>
<lb n="11"/>das gelt <unclear cert="medium" resp="#joint">erlegt</unclear>, habe diß genanten <persName resp="#ner"><unclear cert="low" resp="#joint">Wetters</unclear></persName> knab
<lb n="12"/>gefragt <unclear cert="low" resp="#joint">wellicher</unclear>, under den jenigen so daselbst
<lb n="13"/><unclear cert="medium" resp="#joint">gestanden</unclear>, den selbigen kernen <unclear cert="medium" resp="#joint">bezalen</unclear> <unclear cert="medium" resp="#joint">muoße</unclear>.
<lb n="14"/>Er <persName resp="#ner"><unclear cert="medium" resp="#joint">Herman</unclear> <unclear cert="medium" resp="#joint">Tobler</unclear></persName> geantwurtet, er <unclear cert="medium" resp="#joint">muoße</unclear> <unclear cert="medium" resp="#joint">jnne</unclear>
<lb n="15"/>bezalen, und hieruff ein zeiger oder deßselbigen
<lb n="16"/><unclear cert="low" resp="#joint">werttß</unclear> <unclear cert="low" resp="#joint">firt</unclear> pfenning gegeben. Hieruff gesagter <unclear cert="medium" resp="#joint">üwer</unclear>
<lb n="17"/>burger <persName resp="#ner">Jacob Wetter</persName>, jnne nitt allein mit so grob
<lb n="18"/><unclear cert="low" resp="#joint">ehr</unclear> <unclear cert="low" resp="#joint">verletzlichen</unclear> wortten, vor <unclear cert="low" resp="#joint">menkhligem</unclear> offenlich
<lb n="19"/>verletzt und angetastet, daß jme die selbigen
<lb n="20"/>zuo <unclear cert="medium" resp="#joint">lyden</unclear> gantz <unclear cert="low" resp="#joint">uerträglich</unclear>, sonder berrlend jnne
<lb n="21"/>zum anderen mall <unclear cert="low" resp="#joint">unbefuogter</unclear> <unclear cert="low" resp="#joint">wiß</unclear> zuo boden ge=
