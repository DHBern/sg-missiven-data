<lb n="23"/><unclear cert="low" resp="#joint">schandten</unclear> zuo bringen <unclear cert="medium" resp="#joint">begert</unclear>. Dath <unclear cert="low" resp="#joint">jnne</unclear> <unclear cert="medium" resp="#joint">wir</unclear> billig
<lb n="24"/><unclear cert="medium" resp="#joint">zum</unclear> <unclear cert="medium" resp="#joint">höchsten</unclear> bedure. Und <unclear cert="low" resp="#joint">sintemallen</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">gezwungen</unclear>
