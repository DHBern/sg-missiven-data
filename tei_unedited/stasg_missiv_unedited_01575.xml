<lb n="24"/><unclear cert="medium" resp="#joint">schryben</unclear>. und <unclear cert="medium" resp="#joint">bgwüßerung</unclear> <unclear cert="medium" resp="#joint">d</unclear> <unclear cert="medium" resp="#joint">ehrsamen</unclear> <orgName ref="stadtasg-actors-534" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Rhaeten</unclear></orgName>
