<lb n="7"/><unclear cert="low" resp="#joint">arbeit</unclear>. <unclear cert="low" resp="#joint">zum</unclear> <unclear cert="low" resp="#joint">hoechsten</unclear> und <unclear cert="low" resp="#joint">fründtlichisten</unclear> <unclear cert="low" resp="#joint">bedanckhen</unclear>.
<lb n="8"/><unclear cert="low" resp="#joint">Unnd</unclear> <unclear cert="low" resp="#joint">thuend</unclear> üch hieruf <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">eydt</unclear>: und <unclear cert="medium" resp="#joint">Pundtsgnoeßisch</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">wolmeinung</unclear> <unclear cert="medium" resp="#joint">zuevneinen</unclear>, dz wir unsers orts und
