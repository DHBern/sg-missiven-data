    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1929_7185.jpg" n="1"/>
<lb n="1"/>Unser freündlich willig dienst <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">vleiß</unclear> <unclear cert="low" resp="#joint">zuvorn</unclear> <unclear cert="low" resp="#joint">bereit</unclear>, <unclear cert="low" resp="#joint">fürsichtig</unclear> <unclear cert="low" resp="#joint">ehrsame</unclear> und <unclear cert="low" resp="#joint">weiße</unclear>, <unclear cert="low" resp="#joint">besonders</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">liebe</unclear> und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">freünd</unclear>. <unclear cert="low" resp="#joint">Welcher</unclear> <unclear cert="low" resp="#joint">gestalt</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">venedischen</unclear> <unclear cert="low" resp="#joint">unsern</unclear> lieben <unclear cert="low" resp="#joint">mitraths</unclear> <unclear cert="low" resp="#joint">freünden</unclear>, <persName resp="#ner"><unclear cert="low" resp="#joint">Wilhelmen</unclear></persName> und
<lb n="3"/><persName resp="#ner">Endreßen</persName> im Hoff, und mitverwandten, umb diese intercessionales, angeruefen worden, daß <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">E</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">eingeschloßener</unclear> <unclear cert="low" resp="#joint">ihrer</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">überreichter</unclear> <unclear cert="low" resp="#joint">supplication</unclear> mit mehrerm <unclear cert="low" resp="#joint">zuvernehmen</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">dieser</unclear> <unclear cert="low" resp="#joint">langwüriger</unclear> <unclear cert="low" resp="#joint">verzug</unclear> <unclear cert="low" resp="#joint">ihnen</unclear>, <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">petenten</unclear> <unclear cert="low" resp="#joint">sehr</unclear> <unclear cert="low" resp="#joint">beschwehrlich</unclear>, und <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">ihnen</unclear> in diesem
<lb n="6"/>fall, geholffen zusein, gantz gerne sehen und wünschen wolten, alß gelangt an <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">freündlichs</unclear> bitten,
<lb n="7"/><unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">geruhen</unclear> <unclear cert="low" resp="#joint">angedeutem</unclear> <unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">gevollmechtigten</unclear> <unclear cert="low" resp="#joint">anwaldt</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Kochen</unclear></persName>, oder seinem substituirten,
<lb n="8"/>schleinige hülff und execution gegen <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">debitorn</unclear>, <unclear cert="low" resp="#joint">widerfahren</unclear> <unclear cert="low" resp="#joint">zulaßen</unclear>, <unclear cert="low" resp="#joint">damit</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">endlich</unclear>, <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">solchem</unclear>
<lb n="9"/>lang mit <unclear cert="low" resp="#joint">geduldt</unclear> <unclear cert="low" resp="#joint">getragenem</unclear> <unclear cert="low" resp="#joint">außstahnd</unclear>, <unclear cert="low" resp="#joint">dermahlainsts</unclear> <unclear cert="low" resp="#joint">gelangen</unclear> <unclear cert="low" resp="#joint">mögen</unclear>. <unclear cert="low" resp="#joint">Solches</unclear> zu <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">billigkheit</unclear> <unclear cert="low" resp="#joint">gemeß</unclear>, <unclear cert="low" resp="#joint">seÿen</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">wir</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">dergleichen</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">begebenden</unclear> <unclear cert="low" resp="#joint">fällen</unclear>, <unclear cert="low" resp="#joint">hinwiderumb</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">freündlich</unclear> <unclear cert="low" resp="#joint">zubeschulden</unclear> willig und geflißen. Datum den <origDate when="1615-01-24" resp="#ner">24. januarij a° 1615</origDate>.
<lb n="12"/><orgName role="issuer" resp="#ner">Burgermeistere und rath
<lb n="13"/>der statt <unclear cert="low" resp="#joint">Nüernberg</unclear></orgName> <unclear cert="low" resp="#joint">c</unclear>.
<pb facs="StadtASG_Missive_1929_7186.jpg" n="2"/>
<lb n="14"/>Den frommen fuersichtigen ersamen und weisen,
<lb n="15"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">buergermeister und Rate der statt St. Gallen</orgName>,
<lb n="16"/>unsern besondern lieben und gueten freunden.
</p>
