    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1558_5631.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">freündtlich</unclear>, <unclear cert="low" resp="#joint">nachpuerlich</unclear>
<lb n="2"/><unclear cert="low" resp="#joint">gruoß</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">dienste</unclear> <unclear cert="low" resp="#joint">zuvor</unclear>, <unclear cert="low" resp="#joint">Fürsichtige</unclear>,
<lb n="3"/><unclear cert="low" resp="#joint">Ersame</unclear>, weise besunnders liebe freündt
<lb n="4"/>unnd <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">nachpuern</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Waß</unclear> an <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">Oberkhaiten</unclear> <unclear cert="low" resp="#joint">deß</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Landts</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">Appenzell</unclear></placeName>, <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">herren</unclear> <unclear cert="low" resp="#joint">Abbts</unclear>, <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">dero</unclear> <unclear cert="low" resp="#joint">gmeinen</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <orgName ref="stadtasg-actors-148" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">St</unclear>. <unclear cert="low" resp="#joint">Gallen</unclear></orgName> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">andte</unclear> <unclear cert="low" resp="#joint">Rathsboten</unclear>, <unclear cert="low" resp="#joint">unnderm</unclear> <unclear cert="low" resp="#joint">dato</unclear>
<lb n="9"/><date resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">ix</unclear>. <unclear cert="low" resp="#joint">Junij</unclear></date>, <unclear cert="low" resp="#joint">ab</unclear> <unclear cert="low" resp="#joint">unnßerngehaltenen</unclear>,
<lb n="10"/><unclear cert="low" resp="#joint">weegen</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">neüen</unclear> <unclear cert="low" resp="#joint">müntz</unclear>, <unclear cert="low" resp="#joint">nachpuerlichen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">gelanngen</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">alles</unclear> <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wir</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">sines</unclear> <unclear cert="low" resp="#joint">Innhalts</unclear>, <unclear cert="low" resp="#joint">daruff</unclear> nach <unclear cert="low" resp="#joint">wol</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">verstannden</unclear>. <unclear cert="low" resp="#joint">Döllen</unclear> <unclear cert="low" resp="#joint">Euch</unclear> <unclear cert="low" resp="#joint">daruff</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">ze</unclear> <unclear cert="low" resp="#joint">begerter</unclear> <unclear cert="low" resp="#joint">antworth</unclear>, <unclear cert="low" resp="#joint">freündt</unclear>: <unclear cert="low" resp="#joint">nach</unclear>-
<lb n="15"/><unclear cert="low" resp="#joint">puerlichen</unclear> nicht verhalten. <unclear cert="low" resp="#joint">Obwoln</unclear>
<lb n="16"/>wir <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">unnßeren</unclear> <unclear cert="low" resp="#joint">uberhaubt</unclear>, <unclear cert="low" resp="#joint">weegen</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">ern</unclear> <unclear cert="low" resp="#joint">anzahl</unclear>, <unclear cert="low" resp="#joint">halben</unclear> <unclear cert="low" resp="#joint">müntz</unclear>, mit
<lb n="18"/>nit geringer beschwerd, unnserer zuege-
<lb n="19"/>wanndten und undergebenen, ebnermaßen
<lb n="20"/>nun mehr ain <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">zeithero</unclear> <unclear cert="low" resp="#joint">gespürt</unclear>,
<lb n="21"/>So haben wir doch uß allerhandt be-
<lb n="22"/>wegnuen vrsachen unnd verhindernuß
<lb n="23"/>willen, <unclear cert="low" resp="#joint">solchem</unclear> <unclear cert="low" resp="#joint">gleichwol</unclear> <unclear cert="low" resp="#joint">beschwerlichem</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">werkh</unclear> <unclear cert="low" resp="#joint">fürzebauen</unclear>, unnd <unclear cert="low" resp="#joint">zebegegnen</unclear>
<lb n="25"/>nit <unclear cert="low" resp="#joint">gewüßt</unclear>. <unclear cert="low" resp="#joint">Daheer</unclear> <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">erno</unclear>-
<pb facs="StadtASG_Missive_1558_5632.jpg" n="2"/>
<lb n="26"/><unclear cert="low" resp="#joint">und</unclear> herren <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">benachparten</unclear>
<lb n="27"/>Freündt. <unclear cert="low" resp="#joint">Nachparlichen</unclear> <unclear cert="low" resp="#joint">begern</unclear> <unclear cert="low" resp="#joint">gemeeß</unclear>,
<lb n="28"/><unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">endtlich</unclear> <unclear cert="low" resp="#joint">mainung</unclear>, unnd <unclear cert="low" resp="#joint">uferichten</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">bestendigen</unclear> <unclear cert="low" resp="#joint">Receß</unclear>, <unclear cert="low" resp="#joint">unnß</unclear> noch z
<lb n="30"/>zeite, wie <unclear cert="low" resp="#joint">gern</unclear> <unclear cert="low" resp="#joint">wür</unclear> <unclear cert="low" resp="#joint">gewelt</unclear>, nit erclern
<lb n="31"/>kuenden, sonnder wellen von Euch, waß
<lb n="32"/>Ir euch mit den andern, diser <unclear cert="low" resp="#joint">Münzen</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">Nachparlichen</unclear> <unclear cert="low" resp="#joint">entschließet</unclear>, mit begärd
<lb n="34"/>in künfftig vernemen, unnß auch souil
<lb n="35"/>verantwurtlich darnach dirigiern, und
<lb n="36"/>darunder die gepür verhanndlen, Uff <unclear cert="low" resp="#joint">das</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">souil</unclear> <unclear cert="low" resp="#joint">müglichen</unclear>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">lann</unclear> <unclear cert="low" resp="#joint">menigclichem</unclear>
<lb n="38"/>desto eher beschwerdten entladen, beßere
<lb n="39"/>Münz solches, eingezogen werde,
<lb n="40"/>Und verbleiben euch damit, zuo allen Jhenigen,
<lb n="41"/>waß euch dienstlich lieb unnd <unclear cert="low" resp="#joint">angenem</unclear>,
<lb n="42"/><unclear cert="low" resp="#joint">vorderst</unclear> <unclear cert="low" resp="#joint">berait</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">guotwilligen</unclear>,
<lb n="43"/><unclear cert="low" resp="#joint">Datum</unclear> den <origDate resp="#ner">8. Julij a° 609</origDate>.
<lb n="44"/>Verwalter der Hauptman-
<lb n="45"/>schafft, <orgName ref="stadtasg-actors-56" cert="medium" role="issuer" resp="#ner">Burgermaister und
<lb n="46"/>Rath der Statt Costanz</orgName>,
<pb facs="StadtASG_Missive_1558_5633.jpg" n="3"/>
<pb facs="StadtASG_Missive_1558_5634.jpg" n="4"/>
<lb n="47"/>Denen fuersichtigen, ersamen, unnd <unclear cert="low" resp="#joint">weisen</unclear>
<lb n="48"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermaistern</unclear> unnd Rhat zue St. Gallen</orgName>,
<lb n="49"/>unnsern besonders lieben freundt unnd
<lb n="50"/>guetten nachbaurn.
</p>
