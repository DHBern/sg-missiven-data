    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_803_2159.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Unnsernn</unclear> <unclear cert="low" resp="#joint">frünndtlichenn</unclear> gruos <unclear cert="low" resp="#joint">zuouor</unclear>, lieben <unclear cert="medium" resp="#joint">herrenn</unclear>. <unclear cert="low" resp="#joint">Wir</unclear> gebenn
<lb n="2"/><unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">frünndtlich</unclear> <unclear cert="low" resp="#joint">zuouernemmen</unclear>, das <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">hüt</unclear> dato vor unns, die ersam
<lb n="3"/>frauw <persName resp="#ner"><unclear cert="low" resp="#joint">Barbla</unclear> <unclear cert="low" resp="#joint">Buwrin</unclear></persName> <unclear cert="low" resp="#joint">komen</unclear> <unclear cert="low" resp="#joint">ist</unclear>, unnd <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">anzeigt</unclear>, wie das
<lb n="4"/><unclear cert="low" resp="#joint">sij</unclear> ein lijbliche schwester zuo <placeName ref="stadtasg-places-188" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Venedig</unclear></placeName> <unclear cert="low" resp="#joint">gehept</unclear>, welche aber
<lb n="5"/>durch schickung des allmechtigen mit sampt irem huswirth
<lb n="6"/>mit todt abganngen, unnd inen angendern vor nüt gschei-
<lb n="7"/>dnengeten deßhalb, (unnd <unclear cert="low" resp="#joint">wiewol</unclear> <unclear cert="low" resp="#joint">wenig</unclear>) ein erb <unclear cert="low" resp="#joint">zuogefallen</unclear> were.
<lb n="8"/>So hette doch <unclear cert="low" resp="#joint">sij</unclear> ein bruoder genant <persName resp="#ner">Melcher Buwr</persName>, burger
<lb n="9"/>unnd <unclear cert="low" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">hußhablichen</unclear> <unclear cert="low" resp="#joint">seßhafft</unclear>, <unclear cert="low" resp="#joint">der</unclear> habe ein sun, welcher
<lb n="10"/>nun sollichs ererpt erbguot zuo <unclear cert="low" resp="#joint">Venedig</unclear> (welches doch im nit
<lb n="11"/><unclear cert="medium" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">gehörtt</unclear>) besitze. So <unclear cert="low" resp="#joint">hatt</unclear> <unclear cert="low" resp="#joint">obennante</unclear> <unclear cert="low" resp="#joint">frauw</unclear> <unclear cert="low" resp="#joint">Barbla</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">Buwrin</unclear> <unclear cert="low" resp="#joint">zwoij</unclear> <unclear cert="low" resp="#joint">klene</unclear> schwester kinder <unclear cert="medium" resp="#joint">bij</unclear> <unclear cert="low" resp="#joint">ieren</unclear>, welche des
<lb n="13"/><unclear cert="low" resp="#joint">erbtheils</unclear> <unclear cert="medium" resp="#joint">ouch</unclear> fehig, unnd aber <unclear cert="low" resp="#joint">Manglannden</unclear>, <unclear cert="low" resp="#joint">darnebend</unclear> <unclear cert="low" resp="#joint">elter</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">miltzthone</unclear>, unnd <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">vogts</unclear> <unclear cert="low" resp="#joint">libs</unclear> <unclear cert="low" resp="#joint">halb</unclear> <unclear cert="low" resp="#joint">weren</unclear>.
<lb n="15"/>So habe sij doch vormals <unclear cert="low" resp="#joint">gedocht</unclear> iren <unclear cert="low" resp="#joint">bruoder</unclear> deßhalben inen
<lb n="16"/>gelffen sollichs inzuobringen angeruoffen, weliches er vil
<lb n="17"/>thuen, ed inen wie die sachen <unclear cert="low" resp="#joint">geschaffe</unclear> <unclear cert="low" resp="#joint">nijen</unclear> sagen wellen.
<lb n="18"/>Wann aber <unclear cert="low" resp="#joint">eimen</unclear> <unclear cert="low" resp="#joint">irtwederm</unclear>, das <unclear cert="low" resp="#joint">sin</unclear>, welches <unclear cert="low" resp="#joint">im</unclear> von rechts
<lb n="19"/>unnd <unclear cert="low" resp="#joint">billigkeit</unclear> wegen <unclear cert="low" resp="#joint">gehörtte</unclear>, gegeben, und <unclear cert="low" resp="#joint">eiem</unclear> <unclear cert="low" resp="#joint">ieden</unclear> <unclear cert="low" resp="#joint">dar</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">geholffen</unclear> <unclear cert="low" resp="#joint">werdenn</unclear> soll, so <unclear cert="low" resp="#joint">glanngt</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">ganntz</unclear> <unclear cert="low" resp="#joint">fründt</unclear>-
<lb n="21"/>lich <unclear cert="low" resp="#joint">pitt</unclear> an <unclear cert="low" resp="#joint">üch</unclear>, das ir mit gemeltem <unclear cert="low" resp="#joint">euwerem</unclear> burger
<lb n="22"/>unnd <unclear cert="low" resp="#joint">insessenn</unclear> <unclear cert="low" resp="#joint">souil</unclear> <unclear cert="low" resp="#joint">verschaffen</unclear>, das er (als schuldig sollichs
<lb n="23"/>zuothuon) der guotten frauwen ouch denen schwester kinder
<lb n="24"/>zuo selligem erbtheil verhelffen welle. Das sindt wir
<lb n="25"/>umb <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">glichs</unclear> <unclear cert="low" resp="#joint">ed</unclear> anders <unclear cert="low" resp="#joint">fals</unclear> gantz guottwillig zuobeschulden.
<lb n="26"/>Datum <origPlace ref="stadtasg-places-449" cert="medium" resp="#ner">Steckboren</origPlace> <origDate when="1563-10-23" cert="medium" resp="#ner">den 23. tag octobris anno etc. <unclear cert="low" resp="#joint">Lxiij</unclear></origDate>.
<lb n="27"/><orgName role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Schulthaiß</unclear> und rath der statt
<lb n="28"/><unclear cert="low" resp="#joint">Steckboren</unclear> <unclear cert="low" resp="#joint">etc</unclear></orgName>.
<pb facs="StadtASG_Missive_803_2160.jpg" n="2"/>
<pb facs="StadtASG_Missive_803_2161.jpg" n="3"/>
<pb facs="StadtASG_Missive_803_2162.jpg" n="4"/>
<lb n="29"/>Denn <unclear cert="low" resp="#joint">ernvestenn</unclear>, fürsichtigen, <unclear cert="medium" resp="#joint">ersamenn</unclear> unnd weisen,
<lb n="30"/><unclear cert="medium" resp="#joint">herrenn</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister unnd Rath, der Statt zuo <unclear cert="low" resp="#joint">Sannt</unclear>
<lb n="31"/>Gallenn</orgName>, <unclear cert="low" resp="#joint">unnsernn</unclear> <unclear cert="low" resp="#joint">günnstigen</unclear> <unclear cert="medium" resp="#joint">liebenn</unclear> herrenn.
</p>
