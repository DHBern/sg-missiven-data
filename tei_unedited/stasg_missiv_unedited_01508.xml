<p>
<pb facs="StadtASG_Missive_1508_5429.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freundt</unclear>: <unclear cert="medium" resp="#joint">Nachbaurlich</unclear> willig dienst, und was wir <unclear cert="medium" resp="#joint">Ehren</unclear>, liebs
<lb n="2"/>und <unclear cert="low" resp="#joint">guets</unclear> <unclear cert="medium" resp="#joint">vermoegen</unclear>, <unclear cert="medium" resp="#joint">zuvor</unclear>. <unclear cert="medium" resp="#joint">Fromme</unclear> <unclear cert="medium" resp="#joint">Fuersichtige</unclear> Ehrsamm und <unclear cert="low" resp="#joint">Wyse</unclear>,
<lb n="3"/>Insonders <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">freundt</unclear> und <unclear cert="low" resp="#joint">getruwe</unclear> liebe <unclear cert="low" resp="#joint">Nachburn</unclear>, Was sich nun
<lb n="4"/>mit dem <unclear cert="low" resp="#joint">Unseren</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Herman</unclear> <unclear cert="low" resp="#joint">Gmunden</unclear></persName>, in dem <unclear cert="medium" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">sines</unclear> handels
<lb n="5"/>halb, deß rechten <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">zueerwarten</unclear>, angelobt, und <unclear cert="low" resp="#joint">verstroest</unclear>, <unclear cert="medium" resp="#joint">zu</unclear>-
<lb n="6"/>getragen, lassen wir <unclear cert="medium" resp="#joint">bliben</unclear>; <unclear cert="medium" resp="#joint">Nichtsdestoweniger</unclear>, <unclear cert="low" resp="#joint">diewyl</unclear> wir ver-
<lb n="7"/><unclear cert="medium" resp="#joint">nomen</unclear>, das ihr <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">begerten</unclear> <unclear cert="low" resp="#joint">Compaßbrieff</unclear> abgeschlagen, und
<lb n="8"/>die <unclear cert="medium" resp="#joint">kundtschafften</unclear> selbst <unclear cert="low" resp="#joint">Persoenlich</unclear> <unclear cert="low" resp="#joint">fuer</unclear> <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">zestellen</unclear>, bevolchen, khoennen
<lb n="9"/>wir uch <unclear cert="low" resp="#joint">unvormeldet</unclear> nit lassen; das wir <unclear cert="low" resp="#joint">semliches</unclear>, sovil es die
<lb n="10"/>unseren betrifft, nit <unclear cert="low" resp="#joint">thuenlich</unclear> befinden; Doch aber <unclear cert="low" resp="#joint">zue</unclear> besserer <unclear cert="low" resp="#joint">eu</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">wer</unclear> nachrichtung, so sind <unclear cert="medium" resp="#joint">etliche</unclear> andere <unclear cert="low" resp="#joint">Unsere</unclear> <unclear cert="low" resp="#joint">Landtleüth</unclear>, die
<lb n="12"/><unclear cert="low" resp="#joint">ebnermassen</unclear>, wie <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">gesagte</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Herman</unclear></persName>, von dem <unclear cert="low" resp="#joint">Landtleüffigen</unclear> <unclear cert="low" resp="#joint">Va</unclear>-
<lb n="13"/><persName resp="#ner"><unclear cert="low" resp="#joint">lentin</unclear> <unclear cert="low" resp="#joint">Krenchen</unclear></persName> <unclear cert="medium" resp="#joint">gehoert</unclear> und verstanden, <unclear cert="medium" resp="#joint">das</unclear> er <unclear cert="low" resp="#joint">zum</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">wolfeülhuß</unclear></placeName> <unclear cert="low" resp="#joint">zue</unclear>
<lb n="14"/><placeName ref="stadtasg-places-92" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rhynackh</unclear></placeName> von <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">frauwen</unclear> an der Brodtlauben, <unclear cert="low" resp="#joint">wolsofil</unclear> <unclear cert="low" resp="#joint">erkhafft</unclear>
<lb n="15"/>habe. Das aber <unclear cert="low" resp="#joint">sein</unclear> deß <unclear cert="low" resp="#joint">Landtleüffigen</unclear> red wahr sye!
<lb n="16"/><unclear cert="low" resp="#joint">wüssen</unclear> und sagen wir nit; <unclear cert="low" resp="#joint">wüssen</unclear> auch niemand, der <unclear cert="medium" resp="#joint">solches</unclear> der
<lb n="17"/><unclear cert="medium" resp="#joint">angerüerten</unclear> <unclear cert="low" resp="#joint">frauwen</unclear> <unclear cert="low" resp="#joint">nue</unclear> <unclear cert="low" resp="#joint">trauwe</unclear>. Derhalben gelangt unser
<lb n="18"/><unclear cert="low" resp="#joint">freündt</unclear>: <unclear cert="low" resp="#joint">Nachbaurlich</unclear> pitt an üch, <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">wollend</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">ermelter</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">frauwen</unclear> <unclear cert="low" resp="#joint">verschaffen</unclear>, das sy den <unclear cert="low" resp="#joint">unsrigen</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Herman</unclear> <unclear cert="low" resp="#joint">Gmunden</unclear></persName>
<lb n="20"/><unclear cert="low" resp="#joint">müessig</unclear>, und <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">halben</unclear> <unclear cert="low" resp="#joint">ohnersuecht</unclear> lasse, in <unclear cert="medium" resp="#joint">ansehung</unclear>, das er
<lb n="21"/>wie wir berichtet alain gredt: er habe es vom <persName resp="#ner"><unclear cert="low" resp="#joint">Valentino</unclear></persName>
<lb n="22"/><unclear cert="low" resp="#joint">ghoert</unclear>; und nit von <unclear cert="medium" resp="#joint">ihm</unclear> selbsten, das es also sige. <unclear cert="medium" resp="#joint">Sunsten</unclear>
<lb n="23"/>üch alle <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">Nachbarschafft</unclear> <unclear cert="medium" resp="#joint">zuerzaigen</unclear>, auch alles das <unclear cert="medium" resp="#joint">jhenig</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">zelaisten</unclear>, was die alten <unclear cert="low" resp="#joint">bündt</unclear>, so wir in <unclear cert="low" resp="#joint">gueter</unclear> <unclear cert="low" resp="#joint">freündtschafft</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">jhe</unclear> und alwegen gegen <unclear cert="low" resp="#joint">einanderen</unclear> gehalten, <unclear cert="medium" resp="#joint">vermoegend</unclear> sind
<lb n="26"/>wir <unclear cert="low" resp="#joint">jederzyth</unclear> so willig, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">urbiethig</unclear>, Hiemit <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">sampt</unclear>-
<lb n="27"/>lichen Goettlichem schirm <unclear cert="low" resp="#joint">befelchende</unclear>. Geben den. <origDate when="1606" resp="#ner"><unclear cert="low" resp="#joint">28.isten</unclear> Mon-
<lb n="28"/>ats tag <unclear cert="low" resp="#joint">Julij</unclear>, <unclear cert="low" resp="#joint">Ao</unclear>. <unclear cert="medium" resp="#joint">1606</unclear></origDate>
<lb n="29"/><orgName ref="stadtasg-actors-513" cert="medium" role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Statthalter</unclear> und <unclear cert="medium" resp="#joint">Raath</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">zue</unclear> Appenzell</orgName>. <unclear cert="low" resp="#joint">s</unclear>.
