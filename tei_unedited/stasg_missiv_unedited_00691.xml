<lb n="77"/><unclear cert="medium" resp="#joint">wellen</unclear>. Mit <unclear cert="medium" resp="#joint">frunndtlicher</unclear> pit unnd beger <unclear cert="low" resp="#joint">ir</unclear> <unclear cert="low" resp="#joint">wellt</unclear>
