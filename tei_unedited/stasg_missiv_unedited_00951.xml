<lb n="33"/>(so uff <unclear cert="medium" resp="#joint">nechste</unclear> <unclear cert="medium" resp="#joint">angende</unclear> <date resp="#ner">Badische <unclear cert="medium" resp="#joint">Jarraechung</unclear></date> komen
<lb n="34"/>werden) sich mit <unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">andern</unclear>, <unclear cert="medium" resp="#joint">nach</unclear> notturfft <unclear cert="medium" resp="#joint">under</unclear>-
<lb n="35"/><unclear cert="medium" resp="#joint">reden</unclear> <unclear cert="medium" resp="#joint">soeltend</unclear>, <unclear cert="medium" resp="#joint">wie</unclear> unnd <unclear cert="medium" resp="#joint">wellicher</unclear> maßen, zuo <unclear cert="medium" resp="#joint">besrer</unclear> <unclear cert="medium" resp="#joint">für</unclear>-
<lb n="36"/>derung <unclear cert="low" resp="#joint">vermelten</unclear> von <placeName resp="#ner">Bysantz</placeName>, schryben <unclear cert="low" resp="#joint">zethuond</unclear> werend,
<lb n="37"/><unclear cert="low" resp="#joint">moegind</unclear> sy Ire <unclear cert="low" resp="#joint">gsandten</unclear> <unclear cert="low" resp="#joint">deßhalb</unclear> hin, mit <unclear cert="low" resp="#joint">bevelch</unclear> unnd
