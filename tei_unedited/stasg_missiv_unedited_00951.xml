<lb n="23"/><unclear cert="low" resp="#joint">fruchtbarer</unclear> unnd <unclear cert="low" resp="#joint">erschießlicher</unclear> syn <unclear cert="low" resp="#joint">moechte</unclear>, <unclear cert="low" resp="#joint">moegind</unclear>
<lb n="24"/>wir für unnsern <unclear cert="medium" resp="#joint">theil</unclear> wol <unclear cert="low" resp="#joint">lyden</unclear>, das sy <unclear cert="low" resp="#joint">üwere</unclear> unnd
<lb n="25"/>unnser Eydtgnossen von <placeName ref="stadtasg-places-13" cert="medium" resp="#ner">Bern</placeName> die gestelten fürschrifft,
<lb n="26"/>Inn unnser der <unclear cert="low" resp="#joint">Evangelischen</unclear> stetten namen, gaan laßind,
<lb n="27"/>doch das sy etliche <unclear cert="low" resp="#joint">wort</unclear>, <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">bschluß</unclear> <unclear cert="low" resp="#joint">Irer</unclear> <unclear cert="low" resp="#joint">gestelten</unclear> <unclear cert="low" resp="#joint">copy</unclear>-
