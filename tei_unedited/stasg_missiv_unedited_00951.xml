<lb n="4"/>gnossen</orgName>. <unclear cert="low" resp="#joint">Uwer</unclear> schryben, unnd <unclear cert="medium" resp="#joint">uß</unclear> <unclear cert="medium" resp="#joint">anlaß</unclear> <unclear cert="medium" resp="#joint">von</unclear> üweren unnd
<lb n="5"/>unnserer lieben Eydtgnossen von <placeName ref="stadtasg-places-13" cert="medium" resp="#ner">Bern</placeName> <unclear cert="low" resp="#joint">gestelte</unclear>, unnd üch
<lb n="6"/><unclear cert="low" resp="#joint">überschickte</unclear> copyen, betreffend die <unclear cert="low" resp="#joint">fürbittlichen</unclear> schryben,
<lb n="7"/>etlicher burgern zuo <placeName resp="#ner">Bysantz</placeName> bedacht, habent wir empfan-
<lb n="8"/>gen, unnd <unclear cert="low" resp="#joint">syenes</unclear> innhalts der lenge nach verstanden, unnd
<lb n="9"/>bedunckt unns <unclear cert="low" resp="#joint">glych</unclear> wie üch, sidtmalen ein statt <placeName ref="stadtasg-places-13" cert="medium" resp="#ner">Bern</placeName>,
<lb n="10"/>mit der statt <placeName resp="#ner">Bysantz</placeName> (Irem <unclear cert="low" resp="#joint">vermelden</unclear> nach) inn <unclear cert="medium" resp="#joint">alter</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">burgerlicher</unclear> verwandtnuß <unclear cert="medium" resp="#joint">gewäsen</unclear>, unnd nach inn <unclear cert="low" resp="#joint">fründt</unclear>-
<lb n="12"/>licher nachpurschafft ist, <unclear cert="medium" resp="#joint">es</unclear> <unclear cert="medium" resp="#joint">moechte</unclear> Ir <unclear cert="low" resp="#joint">einich</unclear> <unclear cert="low" resp="#joint">fürbittlichs</unclear>
<lb n="13"/>schryben, den <unclear cert="low" resp="#joint">eewieten</unclear> <unclear cert="low" resp="#joint">religions</unclear> verwandten zuo <placeName resp="#ner">Bysantz</placeName>,
<lb n="14"/>als zuo <unclear cert="low" resp="#joint">einem</unclear> anfang gnuog <unclear cert="low" resp="#joint">fürdersam</unclear> syn. <unclear cert="low" resp="#joint">Welches</unclear> wir
<lb n="15"/><unclear cert="low" resp="#joint">vermelten</unclear> üwern unnd unnsern lieben Eydtgnossen von
<lb n="16"/><placeName ref="stadtasg-places-13" cert="medium" resp="#ner">Bern</placeName>, zuo <unclear cert="medium" resp="#joint">sambt</unclear> <unclear cert="medium" resp="#joint">überschickung</unclear> <unclear cert="medium" resp="#joint">abschrifften</unclear>, von <unclear cert="low" resp="#joint">üweren</unclear>, <unclear cert="low" resp="#joint">ouch</unclear>
