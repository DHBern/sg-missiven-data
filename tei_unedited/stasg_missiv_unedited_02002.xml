        <body>
<p>
<pb facs="StadtASG_Missive_2002_7469.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> <unclear cert="medium" resp="#joint">freundtlich</unclear> willig dienst, und was
<lb n="2"/>wir mehr <unclear cert="medium" resp="#joint">ehrn</unclear> liebs und <unclear cert="medium" resp="#joint">guetes</unclear> vermögen,
<lb n="3"/><unclear cert="medium" resp="#joint">zuvor</unclear> <unclear cert="medium" resp="#joint">Fuersichtige</unclear>, <unclear cert="medium" resp="#joint">Ersame</unclear>, und <unclear cert="medium" resp="#joint">Weyße</unclear>,
<lb n="4"/><unclear cert="medium" resp="#joint">besonders</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="medium" resp="#joint">freund</unclear> und <unclear cert="medium" resp="#joint">guete</unclear> <unclear cert="medium" resp="#joint">nachbarn</unclear>,
<lb n="5"/><unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. schreiben <unclear cert="medium" resp="#joint">vom</unclear> <date resp="#ner"><unclear cert="medium" resp="#joint">driten</unclear> <unclear cert="medium" resp="#joint">diß</unclear></date>,
<lb n="6"/>haben wir <unclear cert="medium" resp="#joint">sambt</unclear> <unclear cert="medium" resp="#joint">treülichen</unclear> <unclear cert="medium" resp="#joint">inßchluß</unclear>, <unclear cert="medium" resp="#joint">der</unclear>
<lb n="7"/>loblichen stadt <orgName ref="stadtasg-places-32" cert="medium" resp="#ner">Zürich</orgName> <unclear cert="medium" resp="#joint">abgangnen</unclear> <unclear cert="medium" resp="#joint">bschluß</unclear>,
<lb n="8"/>empfangen, und <unclear cert="medium" resp="#joint">thuen</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">zuvorderst</unclear> der
<lb n="9"/><unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">guetherzigen</unclear> <unclear cert="low" resp="#joint">wilfahrung</unclear>, <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">be</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">richts</unclear>, und <unclear cert="medium" resp="#joint">zuer</unclear> <unclear cert="medium" resp="#joint">veternnen</unclear> wol <unclear cert="medium" resp="#joint">meintlichen</unclear>
<lb n="11"/><unclear cert="medium" resp="#joint">anerbietens</unclear> <unclear cert="medium" resp="#joint">freundt</unclear>: und nachbarlich
<lb n="12"/><unclear cert="medium" resp="#joint">bedanckhen</unclear>, Und <unclear cert="low" resp="#joint">dieweil</unclear> <unclear cert="low" resp="#joint">seidt</unclear> <unclear cert="low" resp="#joint">hero</unclear> diser
<lb n="13"/><unclear cert="medium" resp="#joint">bewusten</unclear> sachen halben, <unclear cert="medium" resp="#joint">weiters</unclear> nichts so
<lb n="14"/>unß <unclear cert="medium" resp="#joint">bewüßt</unclear>, <unclear cert="medium" resp="#joint">fürgefallen</unclear>, noch sich er-
<lb n="15"/><unclear cert="low" resp="#joint">zeicht</unclear>, <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">wirs</unclear> dabey bewenden,
<lb n="16"/><unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">weitern</unclear> <unclear cert="low" resp="#joint">verlauff</unclear>, unß hingegen
<lb n="17"/><unclear cert="medium" resp="#joint">erbietend</unclear>, alles was <unclear cert="medium" resp="#joint">zue</unclear> abwendung
<lb n="18"/><unclear cert="medium" resp="#joint">unheils</unclear>, und <unclear cert="medium" resp="#joint">wolfarth</unclear> <unclear cert="medium" resp="#joint">gemeinen</unclear> <unclear cert="medium" resp="#joint">vatter</unclear>-
<lb n="19"/><unclear cert="medium" resp="#joint">landts</unclear> sonderlich <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">nachbarschafft</unclear>, <unclear cert="medium" resp="#joint">ersprieß</unclear>
<lb n="20"/>lich bey unß <unclear cert="low" resp="#joint">so</unclear> vil <unclear cert="medium" resp="#joint">müglich</unclear> <unclear cert="medium" resp="#joint">zubefürderen</unclear>,
<lb n="21"/>und was wir <unclear cert="medium" resp="#joint">vernen</unclear> deß <unclear cert="medium" resp="#joint">kriegs</unclear> <unclear cert="medium" resp="#joint">wesenß</unclear>
<lb n="22"/>halben <unclear cert="medium" resp="#joint">In</unclear> <unclear cert="medium" resp="#joint">erfahrung</unclear> bringen, <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">W</unclear>.
<lb n="23"/><unclear cert="medium" resp="#joint">vertreülich</unclear> <unclear cert="medium" resp="#joint">unverschonetlich</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <unclear cert="medium" resp="#joint">avisiren</unclear>,
<pb facs="StadtASG_Missive_2002_7470.jpg" n="2"/>
<lb n="24"/><unclear cert="low" resp="#joint">Derselben</unclear> <unclear cert="low" resp="#joint">bleiben</unclear> wir <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">gueter</unclear> nachpar-
<lb n="25"/>licher <unclear cert="medium" resp="#joint">correspondenz</unclear> und <unclear cert="medium" resp="#joint">angenemen</unclear>
<lb n="26"/>diensten wol <unclear cert="low" resp="#joint">beigethan</unclear>, <unclear cert="low" resp="#joint">goetlichem</unclear> <unclear cert="low" resp="#joint">obhalt</unclear>
<lb n="27"/><unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">sambtlichen</unclear> <unclear cert="low" resp="#joint">befelhende</unclear>. <unclear cert="low" resp="#joint">Datum</unclear>
<lb n="28"/><origPlace ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Lindauw</unclear></origPlace>, <origDate when="1616-06-06" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> 6 <unclear cert="medium" resp="#joint">Junÿ</unclear>. Anno 1616</origDate>.
<lb n="29"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermaister und Rath
<lb n="30"/>der Statt <unclear cert="medium" resp="#joint">Lindauw</unclear></orgName>.
<pb facs="StadtASG_Missive_2002_7471.jpg" n="3"/>
<pb facs="StadtASG_Missive_2002_7472.jpg" n="4"/>
<lb n="31"/>Denen fürsichtigen, ersamen und weisen
<lb n="32"/><orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister und <unclear cert="medium" resp="#joint">Rhat</unclear> der Statt
<lb n="33"/>S.t Gallen</orgName>, unsern <unclear cert="medium" resp="#joint">besonder</unclear> lieben
<lb n="34"/>freünden <unclear cert="medium" resp="#joint">unnd</unclear> gueten <unclear cert="low" resp="#joint">nachbaurn</unclear>.
<lb n="35"/><unclear cert="low" resp="#joint">S.t</unclear> <unclear cert="low" resp="#joint">Gallen</unclear>.
</p>
