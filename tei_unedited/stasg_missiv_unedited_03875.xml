<lb n="19"/><unclear cert="low" resp="#joint">insonderheit</unclear> in mobilibus <unclear cert="low" resp="#joint">bestandene</unclear> <unclear cert="low" resp="#joint">kommen</unclear>, <unclear cert="low" resp="#joint">rain</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">außgeplündert</unclear>, <unclear cert="low" resp="#joint">hernacher</unclear> <unclear cert="low" resp="#joint">mehrertheils</unclear> <unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">weib</unclear>
