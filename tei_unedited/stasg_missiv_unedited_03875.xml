<lb n="42"/>nem anbringen vollkomnen glauben <unclear cert="low" resp="#joint">zuezustellen</unclear>,
<lb n="43"/><unclear cert="low" resp="#joint">alßdann</unclear> <unclear cert="low" resp="#joint">unß</unclear> bey gegenwertiger zwar grosser aber
<lb n="44"/>hofentlich lester kriegsnoth auch günstig zu assisti=
<lb n="45"/>ren, und mit ainem anlehen von <unclear cert="low" resp="#joint">zwoelff</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">dreyzehen</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">hundert</unclear> <unclear cert="low" resp="#joint">gulden</unclear> <unclear cert="low" resp="#joint">mitleidenlich</unclear> <unclear cert="low" resp="#joint">zuebegegnen</unclear>, hingegen
<lb n="47"/>wür <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">dienstfr</unclear>. <unclear cert="low" resp="#joint">anerbietens</unclear>, <unclear cert="low" resp="#joint">Ewr</unclear>. <unclear cert="low" resp="#joint">Fst</unclear>. <unclear cert="low" resp="#joint">Frkht</unclear>.
<lb n="48"/><unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. und Wt. nit allain annembliche guete under=
<lb n="49"/>pfand, sambt ainer verschreibung in bester formb
<pb facs="StadtASG_Missive_3875_15629.jpg" n="3"/>
<lb n="50"/>zugeben, sonder auch mit der zinsraichung benueg-
<lb n="51"/>amb zufolgen, nitweniger seiner zeit das capital
<lb n="52"/>mit grossem danckh wider abzustatten.
<lb n="53"/><unclear cert="low" resp="#joint">Wie</unclear> wir nun an willfaehriger resolution (darumb
<lb n="54"/>wir <unclear cert="low" resp="#joint">nochmahlen</unclear> <unclear cert="low" resp="#joint">dienstfr</unclear>: bitten) nit <unclear cert="low" resp="#joint">zweiflen</unclear>,
<lb n="55"/><unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">thuen</unclear> <unclear cert="low" resp="#joint">zugleich</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">F</unclear>: <unclear cert="low" resp="#joint">W</unclear>: <unclear cert="low" resp="#joint">Framb</unclear>: <unclear cert="low" resp="#joint">H</unclear>: <unclear cert="low" resp="#joint">E</unclear>: und Uht:
<lb n="56"/>wir in deß Allerhoechsten protection <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">selbigeren</unclear>
<lb n="57"/>dem <unclear cert="low" resp="#joint">zeitlichen</unclear> <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">wolergehen</unclear> <unclear cert="low" resp="#joint">treuueifrigst</unclear>
<lb n="58"/><unclear cert="low" resp="#joint">entpfehlen</unclear>. Datum Yßnj <origDate when="1640" resp="#ner">den 20. 10bris Ao 1640</origDate>.
<lb n="59"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermaister und Rhat</orgName>
