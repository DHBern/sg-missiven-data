<lb n="23"/><unclear cert="medium" resp="#joint">blibene</unclear> <unclear cert="medium" resp="#joint">hauß</unclear> und <unclear cert="medium" resp="#joint">hof</unclear>, <unclear cert="medium" resp="#joint">mitt</unclear> <unclear cert="medium" resp="#joint">dem</unclear> ruggen <unclear cert="medium" resp="#joint">ansehen</unclear>, in
<lb n="24"/>das <unclear cert="medium" resp="#joint">bittere</unclear> <unclear cert="medium" resp="#joint">elend</unclear> <unclear cert="medium" resp="#joint">hinauß</unclear> <unclear cert="medium" resp="#joint">ziechen</unclear>, und da <unclear cert="medium" resp="#joint">wür</unclear> hernach
<pb facs="StadtASG_Missive_3875_15628.jpg" n="2"/>
<lb n="25"/>wider nach hauß gelangt, die militarische contributi=
<lb n="26"/>ones ainen alß <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">anderen</unclear> <unclear cert="low" resp="#joint">weg</unclear> entrichten, dieselbe
<lb n="27"/>mit <unclear cert="low" resp="#joint">unglaublicher</unclear> <unclear cert="low" resp="#joint">mueh</unclear> <unclear cert="low" resp="#joint">zusamen</unclear> <unclear cert="low" resp="#joint">bringen</unclear>, <unclear cert="low" resp="#joint">dem</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">soldaten</unclear> <unclear cert="low" resp="#joint">dardichen</unclear>, und darob den lieben <unclear cert="low" resp="#joint">unserigen</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">hunger</unclear> und <unclear cert="low" resp="#joint">mangel</unclear> <unclear cert="low" resp="#joint">lassen</unclear> <unclear cert="low" resp="#joint">muessen</unclear>, so werden wür
<lb n="30"/><unclear cert="low" resp="#joint">gleichsamb</unclear> <unclear cert="low" resp="#joint">necessitirt</unclear>, da wür anderst nach <unclear cert="low" resp="#joint">ubergestan=</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">dener</unclear> <unclear cert="low" resp="#joint">unaußsprechlichen</unclear> <unclear cert="low" resp="#joint">drangsal</unclear>, <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">annahenden</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">so</unclear> hoch desiderirten edlen <unclear cert="low" resp="#joint">fridens</unclear> <unclear cert="low" resp="#joint">erwünschte</unclear> <unclear cert="low" resp="#joint">früchten</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">dermahlen</unclear> <unclear cert="low" resp="#joint">zuegeniessen</unclear> <unclear cert="low" resp="#joint">hoffen</unclear> <unclear cert="low" resp="#joint">wollen</unclear>, <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">bezahlung</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">starcken</unclear> <unclear cert="low" resp="#joint">contingenz</unclear> für die königl. schwedt.
<lb n="35"/>militia, umb hülff und <unclear cert="low" resp="#joint">beysprung</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">hie</unclear> und <unclear cert="low" resp="#joint">dort</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">zubewerben</unclear>.
<lb n="37"/>Und demnach zue <unclear cert="low" resp="#joint">Ewr</unclear>. <unclear cert="low" resp="#joint">Fst</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">Frkht</unclear>. <unclear cert="low" resp="#joint">G</unclear>. <unclear cert="low" resp="#joint">L</unclear>. und Wt. wür
<lb n="38"/>diß orths auch ain besondere guete confidenz dragen,
<lb n="39"/>alß is an <unclear cert="low" resp="#joint">dieselbe</unclear> <unclear cert="low" resp="#joint">nochmahlen</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">dienstfr</unclear>. <unclear cert="low" resp="#joint">er=</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">suechen</unclear>, die <unclear cert="low" resp="#joint">geruehend</unclear> <unclear cert="low" resp="#joint">zueforderist</unclear> <unclear cert="low" resp="#joint">fürweiser</unclear> <unclear cert="low" resp="#joint">diß</unclear> un=
