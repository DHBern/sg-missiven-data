<p>
<pb facs="StadtASG_Missive_3875_15627.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freündtlich</unclear> willige <unclear cert="medium" resp="#joint">dienst</unclear> <unclear cert="medium" resp="#joint">zuovor</unclear>, <unclear cert="medium" resp="#joint">Edel</unclear>, Vest,
<lb n="2"/><unclear cert="medium" resp="#joint">Fromb</unclear>, Fürsichtig, <unclear cert="medium" resp="#joint">Ersamb</unclear> und <unclear cert="low" resp="#joint">Weyße</unclear>, <unclear cert="low" resp="#joint">besonders</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">günstige</unclear> <unclear cert="low" resp="#joint">hochgeehrte</unclear> Herren, <unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> und <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="medium" resp="#joint">Freünd</unclear>.
<lb n="4"/>Wann <unclear cert="medium" resp="#joint">wür</unclear> die <unclear cert="low" resp="#joint">ohnvergäßliche</unclear> liberalitet und <unclear cert="medium" resp="#joint">anseh=</unclear>
<lb n="5"/>liche <unclear cert="low" resp="#joint">brandsteür</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">Eue</unclear>. <unclear cert="low" resp="#joint">Vst</unclear>. <unclear cert="low" resp="#joint">Fromb</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. und <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unseren</unclear> burgeren nach <unclear cert="medium" resp="#joint">deren</unclear> in <date resp="#ner">Anno 1631</date>.
<lb n="7"/><unclear cert="low" resp="#joint">entstandenen</unclear> Reichß und <unclear cert="low" resp="#joint">Landtkündiger</unclear> <unclear cert="low" resp="#joint">schrecklichen</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">feürsbrunst</unclear>, <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">reparir</unclear>: und <unclear cert="medium" resp="#joint">aufbauung</unclear> <unclear cert="medium" resp="#joint">höchst=</unclear>
