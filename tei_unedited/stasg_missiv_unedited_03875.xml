<lb n="10"/>und <unclear cert="medium" resp="#joint">widerfahren</unclear> laßen, (<unclear cert="medium" resp="#joint">so</unclear> <unclear cert="medium" resp="#joint">ihretwegen</unclear> der <unclear cert="low" resp="#joint">Allerhöchste</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">Eue</unclear>. <unclear cert="low" resp="#joint">Vt</unclear>. <unclear cert="low" resp="#joint">Fromb</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. und <unclear cert="low" resp="#joint">Wt</unclear>. <unclear cert="low" resp="#joint">großer</unclear> <unclear cert="low" resp="#joint">lohn</unclear> und <unclear cert="low" resp="#joint">reicher</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">vergelter</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">wölle</unclear>.) zue <unclear cert="low" resp="#joint">gemüet</unclear> <unclear cert="low" resp="#joint">ziechen</unclear>, so werden
<lb n="13"/><unclear cert="medium" resp="#joint">wür</unclear> <unclear cert="medium" resp="#joint">gleich</unclear> <unclear cert="medium" resp="#joint">samb</unclear> <unclear cert="medium" resp="#joint">etwas</unclear> <unclear cert="medium" resp="#joint">bestürzt</unclear>, mit <unclear cert="medium" resp="#joint">gegenwerti=</unclear>
<lb n="14"/><unclear cert="medium" resp="#joint">gem</unclear> <unclear cert="medium" resp="#joint">einzukommen</unclear>.
<lb n="15"/>Dieweil <unclear cert="medium" resp="#joint">wür</unclear> aber bey <unclear cert="medium" resp="#joint">disem</unclear> <unclear cert="medium" resp="#joint">dreüßigjaehrigen</unclear> <unclear cert="medium" resp="#joint">blueti=</unclear>
<lb n="16"/>gen <unclear cert="low" resp="#joint">teütschen</unclear> Krieg in anderheit aber bey <unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">erst</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">2</unclear>. <unclear cert="low" resp="#joint">jahren</unclear> <unclear cert="low" resp="#joint">beschechnen</unclear> <unclear cert="low" resp="#joint">underschidlichen</unclear> <unclear cert="low" resp="#joint">plözlichen</unclear>
