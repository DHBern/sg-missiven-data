    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1555_5619.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig diennst zuvor,
<lb n="2"/>Ersamen unnd Weisen, <unclear cert="low" resp="#joint">insonders</unclear> lieben unnd
<lb n="3"/>gueten freündt.
<lb n="4"/>Was uns auch unsere Lieben unnd gueten Freündt,
<lb n="5"/>der vier Oberkaiten, Namblich der Innern unnd
<lb n="6"/>Ussern Roden deß Lanndts Appenzell, wie auch
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">Herrn</unclear> <unclear cert="low" resp="#joint">Abbts</unclear></persName>, unnd <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">Pfallzraethe</unclear>, <unclear cert="low" resp="#joint">vom</unclear>
<lb n="8"/><date resp="#ner"><unclear cert="low" resp="#joint">19</unclear>. <unclear cert="low" resp="#joint">diß</unclear></date>, wegen der <unclear cert="low" resp="#joint">einreissenden</unclear> <unclear cert="low" resp="#joint">boesen</unclear> <unclear cert="low" resp="#joint">neüen</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">Müenzsorten</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">3</unclear>. <unclear cert="low" resp="#joint">Creüzerer</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">wie</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">solcher</unclear> <unclear cert="low" resp="#joint">beschwaerlikait</unclear> <unclear cert="low" resp="#joint">raethlich</unclear> <unclear cert="low" resp="#joint">zuebegegnen</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">mittel</unclear> <unclear cert="low" resp="#joint">fürgeschlagen</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">freündt</unclear>. <unclear cert="low" resp="#joint">Nachbar</unclear>-
<lb n="12"/>lich zuegeschriben, vnd an uns gelangt haben,
<lb n="13"/>das <unclear cert="low" resp="#joint">wüerdet</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">zweifels</unclear> <unclear cert="low" resp="#joint">frey</unclear> wol
<lb n="14"/>bewußt sein.
<lb n="15"/>Nun erzaigt sich diser fähl vnd mangel <unclear cert="low" resp="#joint">der</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">heüffig</unclear> <unclear cert="low" resp="#joint">einschleichenden</unclear> <unclear cert="low" resp="#joint">klainen</unclear> <unclear cert="low" resp="#joint">geringen</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">Müenzsorten</unclear>, <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">mererlay</unclear> <unclear cert="low" resp="#joint">neüen</unclear> <unclear cert="low" resp="#joint">boehmischen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">drey</unclear> <unclear cert="low" resp="#joint">Creüzerern</unclear>, wie auch pfenningen,
<lb n="19"/>ebnermassen bey uns in diser Landtsart
<lb n="20"/>nit weniger, vnd ob wol im Reich deß-
<lb n="21"/>wegen vilfelltige Mandata, zur abschaffung
<lb n="22"/>solcher unnd der außlenndischen nit halltigen
<lb n="23"/><unclear cert="low" resp="#joint">Müenzsorten</unclear> <unclear cert="low" resp="#joint">außgangen</unclear>, <unclear cert="low" resp="#joint">wüerdet</unclear> <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">den</unclear>-
<lb n="24"/>selbigen <unclear cert="low" resp="#joint">schlechtlich</unclear> <unclear cert="low" resp="#joint">pariert</unclear>.
<lb n="25"/><unclear cert="low" resp="#joint">Wie</unclear> <unclear cert="low" resp="#joint">aber</unclear> <unclear cert="low" resp="#joint">vns</unclear>, <unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">Rich</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Crays</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">Stännden</unclear> <unclear cert="low" resp="#joint">zuegethon</unclear> (<unclear cert="low" resp="#joint">inmassen</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="27"/><unclear cert="low" resp="#joint">vernünfftig</unclear> <unclear cert="low" resp="#joint">zuebedennkhen</unclear>) <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">gebüeren</unclear>
<lb n="28"/><unclear cert="low" resp="#joint">will</unclear>, <unclear cert="low" resp="#joint">ohne</unclear> <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">vorwüssen</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">guetthaissen</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">vns</unclear>, mit andern ausser dem Reich geseßnen
<lb n="30"/>Orten: sonderlich in <unclear cert="low" resp="#joint">Müenz</unclear> <unclear cert="low" resp="#joint">sachen</unclear> (alls ainem
<lb n="31"/>weit <unclear cert="low" resp="#joint">aussehenden</unclear> <unclear cert="low" resp="#joint">werkh</unclear>) wegen ab: vnd
<lb n="32"/>aufsezung derselben, in handlung vnnd
<lb n="33"/>verglich einzuelassen, sonder solche sachen vff
<pb facs="StadtASG_Missive_1555_5620.jpg" n="2"/>
<lb n="34"/><unclear cert="medium" resp="#joint">der</unclear> <unclear cert="medium" resp="#joint">craißmüntz</unclear> probation <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">deputation</unclear>
<lb n="35"/><unclear cert="medium" resp="#joint">täg</unclear> gehörig. <unclear cert="low" resp="#joint">Allso</unclear> <unclear cert="low" resp="#joint">sellten</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">wir</unclear>,
<lb n="36"/><unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">begerrten</unclear> <unclear cert="low" resp="#joint">verstandts</unclear>, <unclear cert="low" resp="#joint">so</unclear> uns <unclear cert="medium" resp="#joint">Vesper</unclear>
<lb n="37"/>halb, das wir uns <unclear cert="medium" resp="#joint">dißfals</unclear> nit <unclear cert="medium" resp="#joint">einlassen</unclear>
<lb n="38"/><unclear cert="medium" resp="#joint">kundten</unclear>, <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">ohnnachbarschafft</unclear> nit <unclear cert="medium" resp="#joint">zuovermercken</unclear>,
<lb n="39"/><unclear cert="medium" resp="#joint">sondern</unclear> uns für entschuldigt <unclear cert="medium" resp="#joint">zuohaben</unclear>.
<lb n="40"/><unclear cert="medium" resp="#joint">Sonnsten</unclear> <unclear cert="medium" resp="#joint">mögten</unclear> wir wol <unclear cert="medium" resp="#joint">leiden</unclear>, das es
<lb n="41"/><unclear cert="low" resp="#joint">allenthalben</unclear> <unclear cert="low" resp="#joint">herumben</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">müntzwesen</unclear> <unclear cert="low" resp="#joint">besser</unclear>
<lb n="42"/>unnd <unclear cert="medium" resp="#joint">richtiger</unclear> <unclear cert="medium" resp="#joint">zuogienge</unclear>, <unclear cert="medium" resp="#joint">weder</unclear> <unclear cert="medium" resp="#joint">beschiht</unclear>, damit
<lb n="43"/>man <unclear cert="medium" resp="#joint">hin</unclear> und <unclear cert="low" resp="#joint">wider</unclear> <unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">besser</unclear> handlen und
<lb n="44"/><unclear cert="medium" resp="#joint">faren</unclear> <unclear cert="medium" resp="#joint">kundte</unclear>, und der gemain mann nit
<lb n="45"/>allso <unclear cert="medium" resp="#joint">geferret</unclear> <unclear cert="medium" resp="#joint">wurde</unclear>.
<lb n="46"/><unclear cert="medium" resp="#joint">Welhes</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">uff</unclear> begeren <unclear cert="medium" resp="#joint">obennannter</unclear> unser
<lb n="47"/>lieben <unclear cert="low" resp="#joint">genachbarten</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>. <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">unnser</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">erclerung</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear> <unclear cert="low" resp="#joint">uberschriben</unclear> <unclear cert="low" resp="#joint">wellen</unclear>,
<lb n="49"/>unnd <unclear cert="medium" resp="#joint">seyen</unclear> <unclear cert="medium" resp="#joint">derselben</unclear>, auch <unclear cert="medium" resp="#joint">angeruerten</unclear>
<lb n="50"/><unclear cert="medium" resp="#joint">genachbarten</unclear>, <unclear cert="medium" resp="#joint">sonsten</unclear> <unclear cert="medium" resp="#joint">freundtliche</unclear> dienst
<lb n="51"/>und <unclear cert="low" resp="#joint">guote</unclear> <unclear cert="low" resp="#joint">nachbarschafft</unclear>, mit <unclear cert="medium" resp="#joint">guotem</unclear> willen
<lb n="52"/><unclear cert="low" resp="#joint">wolgenaigt</unclear> und <unclear cert="medium" resp="#joint">beygethon</unclear>. Datum <origDate when="1609-06-26" resp="#ner">26. <unclear cert="medium" resp="#joint">Junii</unclear>
<lb n="53"/><unclear cert="medium" resp="#joint">a°</unclear> <unclear cert="medium" resp="#joint">1609</unclear></origDate>.
<lb n="54"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner"><unclear cert="medium" resp="#joint">Burgermaister</unclear> und rhat
<lb n="55"/>der statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_1555_5621.jpg" n="3"/>
<pb facs="StadtASG_Missive_1555_5622.jpg" n="4"/>
<lb n="56"/>Den Ersamen und Weysen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="57"/>und Rhat der Statt Sanct Gallen</orgName>, unsern
<lb n="58"/>besondern lieben und guetten fründen.
<lb n="59"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>.
</p>
