    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1555_5619.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig diennst zuvor,
<lb n="2"/>Ersamen unnd Weisen, <unclear cert="medium" resp="#joint">insonders</unclear> lieben unnd
<lb n="3"/>gueten <unclear cert="low" resp="#joint">freündt</unclear>.
<lb n="4"/>Was uns auch unsere Lieben unnd gueten <unclear cert="low" resp="#joint">Freündt</unclear>,
<lb n="5"/>der vier Oberkaiten, <unclear cert="low" resp="#joint">Namblich</unclear> der <unclear cert="low" resp="#joint">Innern</unclear> unnd
<lb n="6"/><unclear cert="low" resp="#joint">Ussern</unclear> Roden deß Lanndts Appenzell, wie auch
<lb n="7"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Herrn</unclear> <unclear cert="medium" resp="#joint">Abbts</unclear></persName>, unnd <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">Pfallzraethe</unclear>, vom
<lb n="8"/><date resp="#ner"><unclear cert="low" resp="#joint">19</unclear>. <unclear cert="low" resp="#joint">diß</unclear></date>, wegen der <unclear cert="medium" resp="#joint">einreissenden</unclear> <unclear cert="medium" resp="#joint">boesen</unclear> <unclear cert="medium" resp="#joint">neüen</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">Müenzsorten</unclear> der 3. <unclear cert="medium" resp="#joint">Creüzerer</unclear>, unnd wie
<lb n="10"/>solcher <unclear cert="low" resp="#joint">beschwaerlikait</unclear> <unclear cert="low" resp="#joint">raethlich</unclear> <unclear cert="low" resp="#joint">zuebegegnen</unclear>,
<lb n="11"/>mittel fürgeschlagen <unclear cert="medium" resp="#joint">vnd</unclear> <unclear cert="medium" resp="#joint">freündt</unclear>. <unclear cert="medium" resp="#joint">Nachbar</unclear>-
<lb n="12"/>lich <unclear cert="low" resp="#joint">zuegeschriben</unclear>, vnd an uns gelangt haben,
<lb n="13"/>das <unclear cert="medium" resp="#joint">wüerdet</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">zweifels</unclear> frey wol
<lb n="14"/><unclear cert="low" resp="#joint">bewußt</unclear> sein.
<lb n="15"/>Nun erzaigt sich diser <unclear cert="low" resp="#joint">fähl</unclear> vnd mangel <unclear cert="medium" resp="#joint">der</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">heüffig</unclear> <unclear cert="medium" resp="#joint">einschleichenden</unclear> <unclear cert="medium" resp="#joint">klainen</unclear> geringen
<lb n="17"/><unclear cert="medium" resp="#joint">Müenzsorten</unclear>, <unclear cert="medium" resp="#joint">vnd</unclear> <unclear cert="medium" resp="#joint">mererlay</unclear> <unclear cert="medium" resp="#joint">neüen</unclear> <unclear cert="medium" resp="#joint">boehmischen</unclear>
<lb n="18"/>oder <unclear cert="low" resp="#joint">drey</unclear> <unclear cert="low" resp="#joint">Creüzerern</unclear>, wie auch <unclear cert="low" resp="#joint">pfenningen</unclear>,
<lb n="19"/><unclear cert="low" resp="#joint">ebnermassen</unclear> bey uns in diser <unclear cert="low" resp="#joint">Landtsart</unclear>
<lb n="20"/>nit weniger, vnd ob wol <unclear cert="low" resp="#joint">im</unclear> Reich <unclear cert="low" resp="#joint">deß</unclear>-
<lb n="21"/>wegen <unclear cert="low" resp="#joint">vilfelltige</unclear> Mandata, zur abschaffung
<lb n="22"/>solcher unnd <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">außlenndischen</unclear> nit halltigen
<lb n="23"/><unclear cert="medium" resp="#joint">Müenzsorten</unclear> <unclear cert="medium" resp="#joint">außgangen</unclear>, <unclear cert="medium" resp="#joint">wüerdet</unclear> <unclear cert="medium" resp="#joint">doch</unclear> den-
<lb n="24"/>selbigen schlechtlich <unclear cert="medium" resp="#joint">pariert</unclear>.
<lb n="25"/>Wie aber <unclear cert="medium" resp="#joint">vns</unclear>, <unclear cert="medium" resp="#joint">alls</unclear> dem <unclear cert="low" resp="#joint">Rich</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">Crays</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">Stännden</unclear> <unclear cert="low" resp="#joint">zuegethon</unclear> (inmassen <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="27"/><unclear cert="low" resp="#joint">vernünfftig</unclear> <unclear cert="low" resp="#joint">zuebedennkhen</unclear>) nit <unclear cert="medium" resp="#joint">gebüeren</unclear>
<lb n="28"/>will, ohne <unclear cert="low" resp="#joint">derselben</unclear> <unclear cert="low" resp="#joint">vorwüssen</unclear> <unclear cert="low" resp="#joint">vnd</unclear> <unclear cert="low" resp="#joint">guetthaissen</unclear>,
<lb n="29"/><unclear cert="low" resp="#joint">vns</unclear>, mit <unclear cert="low" resp="#joint">andern</unclear> <unclear cert="low" resp="#joint">ausser</unclear> dem Reich <unclear cert="low" resp="#joint">geseßnen</unclear>
<lb n="30"/>Orten: sonderlich in <unclear cert="medium" resp="#joint">Müenz</unclear> sachen (alls <unclear cert="low" resp="#joint">ainem</unclear>
<lb n="31"/>weit <unclear cert="medium" resp="#joint">aussehenden</unclear> <unclear cert="medium" resp="#joint">werkh</unclear>) wegen ab: vnd
<lb n="32"/><unclear cert="low" resp="#joint">aufsezung</unclear> derselben, in handlung <unclear cert="low" resp="#joint">vnnd</unclear>
<lb n="33"/><unclear cert="low" resp="#joint">verglich</unclear> einzuelassen, sonder solche sachen vff
<pb facs="StadtASG_Missive_1555_5620.jpg" n="2"/>
<lb n="34"/>der <unclear cert="medium" resp="#joint">craißmüntz</unclear> probation unnd <unclear cert="low" resp="#joint">deputation</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">täg</unclear> gehörig. Allso <unclear cert="medium" resp="#joint">sellten</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">wir</unclear>,
<lb n="36"/>deß <unclear cert="medium" resp="#joint">begerrten</unclear> <unclear cert="medium" resp="#joint">verstandts</unclear>, <unclear cert="medium" resp="#joint">so</unclear> uns <unclear cert="low" resp="#joint">Vesper</unclear>
<lb n="37"/>halb, das wir uns <unclear cert="low" resp="#joint">dißfals</unclear> nit einlassen
<lb n="38"/><unclear cert="low" resp="#joint">kundten</unclear>, inn <unclear cert="low" resp="#joint">ohnnachbarschafft</unclear> nit <unclear cert="low" resp="#joint">zuovermercken</unclear>,
<lb n="39"/>sondern uns für entschuldigt <unclear cert="low" resp="#joint">zuohaben</unclear>.
<lb n="40"/><unclear cert="low" resp="#joint">Sonnsten</unclear> mögten wir wol leiden, das es
<lb n="41"/><unclear cert="low" resp="#joint">allenthalben</unclear> <unclear cert="low" resp="#joint">herumben</unclear> <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">müntzwesen</unclear> <unclear cert="low" resp="#joint">besser</unclear>
<lb n="42"/>unnd <unclear cert="medium" resp="#joint">richtiger</unclear> <unclear cert="medium" resp="#joint">zuogienge</unclear>, weder <unclear cert="low" resp="#joint">beschiht</unclear>, damit
<lb n="43"/>man hin und wider <unclear cert="medium" resp="#joint">desto</unclear> <unclear cert="medium" resp="#joint">besser</unclear> handlen und
<lb n="44"/>faren kundte, und der gemain mann nit
<lb n="45"/>allso <unclear cert="low" resp="#joint">geferret</unclear> wurde.
<lb n="46"/><unclear cert="low" resp="#joint">Welhes</unclear> wir <unclear cert="low" resp="#joint">uff</unclear> begeren <unclear cert="low" resp="#joint">obennannter</unclear> unser
<lb n="47"/>lieben <unclear cert="medium" resp="#joint">genachbarten</unclear> <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">W</unclear>. <unclear cert="medium" resp="#joint">zuo</unclear> unnser
<lb n="48"/><unclear cert="low" resp="#joint">erclerung</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear> <unclear cert="low" resp="#joint">uberschriben</unclear> <unclear cert="low" resp="#joint">wellen</unclear>,
<lb n="49"/>unnd seyen derselben, auch angeruerten
<lb n="50"/><unclear cert="low" resp="#joint">genachbarten</unclear>, sonsten <unclear cert="low" resp="#joint">freundtliche</unclear> dienst
<lb n="51"/>und <unclear cert="medium" resp="#joint">guote</unclear> nachbarschafft, mit guotem willen
<lb n="52"/><unclear cert="medium" resp="#joint">wolgenaigt</unclear> und <unclear cert="low" resp="#joint">beygethon</unclear>. Datum <origDate when="1609-06-26" resp="#ner">26. <unclear cert="low" resp="#joint">Junii</unclear>
<lb n="53"/>a° <unclear cert="low" resp="#joint">1609</unclear></origDate>.
<lb n="54"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermaister und rhat
<lb n="55"/>der statt Lindaw</orgName>.
<pb facs="StadtASG_Missive_1555_5621.jpg" n="3"/>
<pb facs="StadtASG_Missive_1555_5622.jpg" n="4"/>
<lb n="56"/>Den <unclear cert="medium" resp="#joint">Ersamen</unclear> und <unclear cert="medium" resp="#joint">Weysen</unclear> <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermaister
<lb n="57"/>und Rhat der Statt Sanct Gallen</orgName>, unsern
<lb n="58"/>besondern lieben und guetten fründen.
<lb n="59"/><placeName ref="stadtasg-places-38" cert="medium" resp="#ner">St. Gallen</placeName>.
</p>
