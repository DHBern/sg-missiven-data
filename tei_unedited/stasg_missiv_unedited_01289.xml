<lb n="122"/><unclear cert="medium" resp="#joint">Gallen</unclear></placeName> ab der <placeName resp="#ner"><unclear cert="medium" resp="#joint">Blaiche</unclear></placeName> gegen <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rorschach</unclear></placeName>, auch
