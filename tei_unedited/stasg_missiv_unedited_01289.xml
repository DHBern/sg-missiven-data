<lb n="116"/><unclear cert="low" resp="#joint">selig</unclear> <unclear cert="low" resp="#joint">jede</unclear> <unclear cert="low" resp="#joint">elen</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">3ren</unclear> <unclear cert="low" resp="#joint">batz</unclear> <unclear cert="low" resp="#joint">zekauffen</unclear>
