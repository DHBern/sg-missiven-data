<lb n="102"/>der zuo <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="low" resp="#joint">seßhafft</unclear> <unclear cert="low" resp="#joint">ist</unclear>. umb 5 <unclear cert="low" resp="#joint">fl</unclear>.
<lb n="103"/><unclear cert="low" resp="#joint">zkoiffen</unclear> <unclear cert="low" resp="#joint">geben</unclear>.
<lb n="104"/>Item jetz <date resp="#ner">zinstag</date>. <unclear cert="low" resp="#joint">werde</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">vierzehen</unclear> <unclear cert="low" resp="#joint">tag</unclear>,
