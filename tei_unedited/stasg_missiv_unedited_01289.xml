<lb n="120"/>Und dann <unclear cert="medium" resp="#joint">habe</unclear> er <unclear cert="medium" resp="#joint">vor</unclear> acht tag, <unclear cert="medium" resp="#joint">das</unclear> <unclear cert="medium" resp="#joint">den</unclear>
