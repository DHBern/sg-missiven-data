<lb n="107"/><unclear cert="low" resp="#joint">liwat</unclear> <unclear cert="low" resp="#joint">tuoch</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">ob</unclear> <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">hundert</unclear> und fünff-
