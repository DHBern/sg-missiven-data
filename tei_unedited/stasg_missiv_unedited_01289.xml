<lb n="114"/><unclear cert="low" resp="#joint">elen</unclear>. und das uberig etlichen weibern,
<lb n="115"/>so domals ouch in <unclear cert="low" resp="#joint">des</unclear> <unclear cert="low" resp="#joint">selben</unclear> <unclear cert="low" resp="#joint">bekhen</unclear> <unclear cert="low" resp="#joint">haus</unclear> <unclear cert="low" resp="#joint">komen</unclear>,
