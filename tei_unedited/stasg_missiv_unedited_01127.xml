    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1127_3633.jpg" n="1"/>
<lb n="1"/>Min <unclear cert="low" resp="#joint">fründtlich</unclear> willig <unclear cert="medium" resp="#joint">dinst</unclear>, <unclear cert="low" resp="#joint">gruos</unclear> und alles
<lb n="2"/>guots zuovor, <unclear cert="low" resp="#joint">edel</unclear> <unclear cert="low" resp="#joint">from</unclear>, vest <unclear cert="low" resp="#joint">fürnem</unclear> und
<lb n="3"/><unclear cert="low" resp="#joint">wiße</unclear>, sonders günßtig lieb herren, und guot fründ,
<lb n="4"/>ewer schryben darinn ir <unclear cert="low" resp="#joint">im</unclear> Jacoben <unclear cert="medium" resp="#joint">Wegeren</unclear>
<lb n="5"/>von <placeName ref="stadtasg-places-195" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Altnaw</unclear></placeName> über <unclear cert="low" resp="#joint">bschechnen</unclear> <unclear cert="low" resp="#joint">wypfung</unclear> <unclear cert="low" resp="#joint">dehain</unclear>
<lb n="6"/>kundtschafft vor mir <unclear cert="low" resp="#joint">zuoreden</unclear>, bewilligen und
<lb n="7"/><unclear cert="low" resp="#joint">zuolaßen</unclear> wellen begeren, hab ich <unclear cert="low" resp="#joint">mererß</unclear> in-
<lb n="8"/>halts ablößend verstanden, unnd <unclear cert="low" resp="#joint">waiß</unclear> mich
<lb n="9"/>glich nach wol das ich vor der <unclear cert="low" resp="#joint">zyth</unclear> üch und ge-
<lb n="10"/><unclear cert="low" resp="#joint">mälten</unclear> <unclear cert="medium" resp="#joint">Weger</unclear> in <unclear cert="low" resp="#joint">iwerem</unclear> gegeneinanderen
<lb n="11"/><unclear cert="low" resp="#joint">haltenden</unclear> <unclear cert="low" resp="#joint">strit</unclear>, für <unclear cert="low" resp="#joint">minen</unclear> gnedigen herren
<lb n="12"/><unclear cert="medium" resp="#joint">den</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Aidtgnoßen</unclear></orgName> <unclear cert="low" resp="#joint">Rathsgsandten</unclear> zu <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> zuo
<lb n="13"/>guot, oder rächtlichem ußschid remitiret
<lb n="14"/>unnd gewißen, zuerinneren, unnd diwyl
<lb n="15"/>unnd aber gerüerter Weger mich, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">ime</unclear> et-
<lb n="16"/><unclear cert="low" resp="#joint">liche</unclear> <unclear cert="low" resp="#joint">gezügen</unclear> <unclear cert="low" resp="#joint">welle</unclear> <unclear cert="low" resp="#joint">er</unclear> zuo fürderung <unclear cert="low" resp="#joint">sins</unclear> <unclear cert="low" resp="#joint">rächt</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">ens</unclear>, vor <unclear cert="low" resp="#joint">wolermälten</unclear> herren <unclear cert="low" resp="#joint">gsandten</unclear>, dar-
<lb n="18"/><unclear cert="low" resp="#joint">zuolegen</unclear> und <unclear cert="low" resp="#joint">zuobeschinen</unclear>, <unclear cert="low" resp="#joint">höchlich</unclear> von <unclear cert="low" resp="#joint">nötten</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">achtet</unclear> und vermaindt, zuverhören, underthenig
<lb n="20"/>angsuocht unnd gepätten, hab ich im sümliche
<lb n="21"/>sin pitt uß der ursach das <unclear cert="low" resp="#joint">vornacher</unclear> und <unclear cert="low" resp="#joint">bißharo</unclear>
<lb n="22"/>in der <placeName ref="stadtasg-places-103" cert="medium" resp="#ner">Landtgraffschafft <unclear cert="low" resp="#joint">Thurgöw</unclear></placeName> der bruch
<lb n="23"/>und harkomen <unclear cert="low" resp="#joint">gewäßen</unclear>, wann ain <unclear cert="low" resp="#joint">Landtvogt</unclear>
<lb n="24"/>oder <unclear cert="low" resp="#joint">Landtgricht</unclear> gen <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="low" resp="#joint">gewißen</unclear>, das <unclear cert="medium" resp="#joint">alßdan</unclear>
<lb n="25"/>der <unclear cert="low" resp="#joint">begärenden</unclear> <unclear cert="low" resp="#joint">parthy</unclear>, in <unclear cert="low" resp="#joint">abwäßen</unclear> baider <unclear cert="low" resp="#joint">thaill</unclear>-
<lb n="26"/><unclear cert="low" resp="#joint">en</unclear> kundtschafft <unclear cert="low" resp="#joint">verhordt</unclear>, und volgents die min-
<lb n="27"/>en gnedig herren den <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Aidtgnoßen</unclear></orgName> <unclear cert="low" resp="#joint">Rathsgsandt</unclear>-
<lb n="28"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">zuogeschikht</unclear> werden, <unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="low" resp="#joint">wägeren</unclear> unnd
<lb n="29"/>abschlagen können, derwegen ich <unclear cert="low" resp="#joint">angedüts</unclear>
<lb n="30"/><unclear cert="medium" resp="#joint">Wegers</unclear> kundtschafft, glich in sin <unclear cert="medium" resp="#joint">Wegers</unclear> <unclear cert="low" resp="#joint">wie</unclear>
<lb n="31"/>ouch <unclear cert="low" resp="#joint">iwerem</unclear> <unclear cert="low" resp="#joint">abwäßen</unclear> <unclear cert="low" resp="#joint">verhören</unclear> und <unclear cert="low" resp="#joint">gemaine</unclear>
<pb facs="StadtASG_Missive_1127_3634.jpg" n="2"/>
<lb n="32"/>laßen, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">dem</unclear> die vor wolgedachten minen
<lb n="33"/>gnedigen herren der <orgName resp="#ner">Eidtgnoßen</orgName> rhatsbott-
<lb n="34"/>schafften <unclear cert="low" resp="#joint">verschloßen</unclear> <unclear cert="low" resp="#joint">überschicken</unclear> <unclear cert="low" resp="#joint">würde</unclear>, <unclear cert="low" resp="#joint">alda</unclear> <unclear cert="low" resp="#joint">ir</unclear>
<lb n="35"/>dann wol ob ir wellen üwer inred darthon
<lb n="36"/>moegen, <unclear cert="low" resp="#joint">Soelichs</unclear> ich <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">zuo</unclear> widerantwurt
<lb n="37"/>nit verhalten soellen, Dann <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">ander</unclear>-
<lb n="38"/>weg <unclear cert="low" resp="#joint">angeneme</unclear> <unclear cert="low" resp="#joint">dienst</unclear>: und fründtlichen willen
<lb n="39"/>zebewisen, bin ich willig und <unclear cert="low" resp="#joint">gneigt</unclear>, <unclear cert="low" resp="#joint">d</unclear> den <origDate when="1580-06-07" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">7</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">junii</unclear> anno 80</origDate>
<lb n="41"/><persName role="issuer" resp="#ner">Hanns Jauch</persName> des rhats zuo
<lb n="42"/><placeName ref="stadtasg-places-70" cert="medium" resp="#ner">Ury</placeName>, landtvogt in ober
<lb n="43"/>und nid <placeName ref="stadtasg-places-103" cert="medium" resp="#ner">Thurgoew</placeName> etc.
<pb facs="StadtASG_Missive_1127_3635.jpg" n="3"/>
<pb facs="StadtASG_Missive_1127_3636.jpg" n="4"/>
<lb n="44"/>Den <unclear cert="low" resp="#joint">edlenn</unclear>, <unclear cert="medium" resp="#joint">fromen</unclear>, vesten, fürnemen und
<lb n="45"/><unclear cert="low" resp="#joint">wyssen</unclear> herren, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister und rath
<lb n="46"/>der <unclear cert="medium" resp="#joint">Sant</unclear> <unclear cert="low" resp="#joint">Gallen</unclear></orgName>, minen insonders <unclear cert="medium" resp="#joint">günst</unclear>-
<lb n="47"/>igen lieben herren.
</p>
