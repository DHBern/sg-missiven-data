        <body>
<p>
<pb facs="StadtASG_Missive_1127_3633.jpg" n="1"/>
<lb n="1"/>Min <unclear cert="low" resp="#joint">fründtlich</unclear> willig dinst, <unclear cert="low" resp="#joint">gruos</unclear> und <unclear cert="medium" resp="#joint">alles</unclear>
<lb n="2"/><unclear cert="medium" resp="#joint">guots</unclear> zuovor, edel <unclear cert="medium" resp="#joint">from</unclear>, vest <unclear cert="low" resp="#joint">fürnem</unclear> und
<lb n="3"/><unclear cert="low" resp="#joint">wiße</unclear>, sonders <unclear cert="low" resp="#joint">günßtig</unclear> lieb herren, und guot fründ,
<lb n="4"/>ewer schryben darinn ir <unclear cert="low" resp="#joint">im</unclear> Jacoben <unclear cert="medium" resp="#joint">Wegeren</unclear>
<lb n="5"/>von <placeName ref="stadtasg-places-195" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Altnaw</unclear></placeName> über <unclear cert="low" resp="#joint">bschechnen</unclear> <unclear cert="low" resp="#joint">wypfung</unclear> <unclear cert="low" resp="#joint">dehain</unclear>
<lb n="6"/>kundtschafft vor mir <unclear cert="low" resp="#joint">zuoreden</unclear>, bewilligen und
<lb n="7"/><unclear cert="low" resp="#joint">zuolaßen</unclear> <unclear cert="medium" resp="#joint">wellen</unclear> <unclear cert="medium" resp="#joint">begeren</unclear>, hab ich <unclear cert="low" resp="#joint">mererß</unclear> <unclear cert="medium" resp="#joint">in</unclear>-
<lb n="8"/>halts <unclear cert="medium" resp="#joint">ablößend</unclear> verstanden, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">waiß</unclear> mich
<lb n="9"/>glich nach wol das ich vor der <unclear cert="low" resp="#joint">zyth</unclear> <unclear cert="medium" resp="#joint">üch</unclear> und ge-
<lb n="10"/><unclear cert="low" resp="#joint">mälten</unclear> Weger in <unclear cert="low" resp="#joint">iwerem</unclear> <unclear cert="medium" resp="#joint">gegeneinanderen</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">haltenden</unclear> <unclear cert="low" resp="#joint">strit</unclear>, für <unclear cert="low" resp="#joint">minen</unclear> gnedigen <unclear cert="medium" resp="#joint">herren</unclear>
<lb n="12"/>den <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Aidtgnoßen</unclear></orgName> <unclear cert="low" resp="#joint">Rathsgsandten</unclear> <unclear cert="medium" resp="#joint">zu</unclear> <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> zuo
<lb n="13"/>guot, oder rächtlichem ußschid remitiret
<lb n="14"/>unnd gewißen, zuerinneren, unnd diwyl
<lb n="15"/>unnd aber <unclear cert="low" resp="#joint">gerüerter</unclear> Weger mich, <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">ime</unclear> et-
<lb n="16"/><unclear cert="medium" resp="#joint">liche</unclear> <unclear cert="low" resp="#joint">gezügen</unclear> <unclear cert="low" resp="#joint">welle</unclear> <unclear cert="medium" resp="#joint">er</unclear> zuo fürderung <unclear cert="medium" resp="#joint">sins</unclear> <unclear cert="low" resp="#joint">rächt</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">ens</unclear>, vor <unclear cert="low" resp="#joint">wolermälten</unclear> herren <unclear cert="low" resp="#joint">gsandten</unclear>, dar-
<lb n="18"/><unclear cert="low" resp="#joint">zuolegen</unclear> und <unclear cert="low" resp="#joint">zuobeschinen</unclear>, <unclear cert="low" resp="#joint">höchlich</unclear> von <unclear cert="low" resp="#joint">nötten</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">achtet</unclear> und vermaindt, zuverhören, underthenig
<lb n="20"/>angsuocht unnd <unclear cert="low" resp="#joint">gepätten</unclear>, hab ich <unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">sümliche</unclear>
<lb n="21"/>sin <unclear cert="low" resp="#joint">pitt</unclear> <unclear cert="medium" resp="#joint">uß</unclear> der ursach das <unclear cert="low" resp="#joint">vornacher</unclear> und <unclear cert="low" resp="#joint">bißharo</unclear>
<lb n="22"/>in der <placeName ref="stadtasg-places-103" cert="medium" resp="#ner">Landtgraffschafft <unclear cert="medium" resp="#joint">Thurgöw</unclear></placeName> der bruch
<lb n="23"/>und <unclear cert="medium" resp="#joint">harkomen</unclear> <unclear cert="low" resp="#joint">gewäßen</unclear>, wann ain <unclear cert="low" resp="#joint">Landtvogt</unclear>
<lb n="24"/>oder <unclear cert="medium" resp="#joint">Landtgricht</unclear> gen <placeName ref="stadtasg-places-53" cert="medium" resp="#ner">Baden</placeName> <unclear cert="low" resp="#joint">gewißen</unclear>, das <unclear cert="medium" resp="#joint">alßdan</unclear>
<lb n="25"/>der <unclear cert="low" resp="#joint">begärenden</unclear> <unclear cert="low" resp="#joint">parthy</unclear>, in <unclear cert="low" resp="#joint">abwäßen</unclear> <unclear cert="medium" resp="#joint">baider</unclear> <unclear cert="low" resp="#joint">thaill</unclear>-
<lb n="26"/><unclear cert="medium" resp="#joint">en</unclear> kundtschafft <unclear cert="low" resp="#joint">verhordt</unclear>, und volgents die min-
<lb n="27"/>en gnedig herren <unclear cert="medium" resp="#joint">den</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Aidtgnoßen</unclear></orgName> <unclear cert="low" resp="#joint">Rathsgsandt</unclear>-
<lb n="28"/><unclear cert="medium" resp="#joint">en</unclear> <unclear cert="low" resp="#joint">zuogeschikht</unclear> <unclear cert="medium" resp="#joint">werden</unclear>, <unclear cert="low" resp="#joint">nüt</unclear> <unclear cert="low" resp="#joint">wägeren</unclear> unnd
<lb n="29"/><unclear cert="medium" resp="#joint">abschlagen</unclear> können, <unclear cert="medium" resp="#joint">derwegen</unclear> ich <unclear cert="low" resp="#joint">angedüts</unclear>
<lb n="30"/>Wegers kundtschafft, glich <unclear cert="medium" resp="#joint">in</unclear> sin Wegers <unclear cert="medium" resp="#joint">wie</unclear>
<lb n="31"/>ouch <unclear cert="low" resp="#joint">iwerem</unclear> <unclear cert="low" resp="#joint">abwäßen</unclear> <unclear cert="medium" resp="#joint">verhören</unclear> und <unclear cert="low" resp="#joint">gemaine</unclear>
<pb facs="StadtASG_Missive_1127_3634.jpg" n="2"/>
<lb n="32"/><unclear cert="medium" resp="#joint">laßen</unclear>, unnd dem <unclear cert="medium" resp="#joint">die</unclear> vor wolgedachten minen
<lb n="33"/>gnedigen herren der <orgName resp="#ner"><unclear cert="low" resp="#joint">Eidtgnoßen</unclear></orgName> <unclear cert="low" resp="#joint">rhatsbott</unclear>-
<lb n="34"/>schafften <unclear cert="low" resp="#joint">verschloßen</unclear> <unclear cert="low" resp="#joint">überschicken</unclear> <unclear cert="low" resp="#joint">würde</unclear>, <unclear cert="medium" resp="#joint">alda</unclear> <unclear cert="medium" resp="#joint">ir</unclear>
<lb n="35"/>dann wol ob ir <unclear cert="medium" resp="#joint">wellen</unclear> üwer <unclear cert="low" resp="#joint">inred</unclear> <unclear cert="low" resp="#joint">darthon</unclear>
<lb n="36"/>moegen, <unclear cert="medium" resp="#joint">Soelichs</unclear> ich üch <unclear cert="medium" resp="#joint">zuo</unclear> widerantwurt
<lb n="37"/>nit verhalten <unclear cert="medium" resp="#joint">soellen</unclear>, Dann <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">ander</unclear>-
<lb n="38"/><unclear cert="medium" resp="#joint">weg</unclear> <unclear cert="low" resp="#joint">angeneme</unclear> <unclear cert="medium" resp="#joint">dienst</unclear>: und fründtlichen willen
<lb n="39"/><unclear cert="low" resp="#joint">zebewisen</unclear>, bin ich willig und <unclear cert="low" resp="#joint">gneigt</unclear>, <unclear cert="low" resp="#joint">d</unclear> den <origDate when="1580-06-07" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">7</unclear>
<lb n="40"/><unclear cert="medium" resp="#joint">junii</unclear> anno 80</origDate>
<lb n="41"/><persName role="issuer" resp="#ner">Hanns Jauch</persName> des rhats zuo
<lb n="42"/><placeName ref="stadtasg-places-70" cert="medium" resp="#ner">Ury</placeName>, landtvogt in ober
<lb n="43"/>und nid <placeName ref="stadtasg-places-103" cert="medium" resp="#ner">Thurgoew</placeName> etc.
<pb facs="StadtASG_Missive_1127_3635.jpg" n="3"/>
<pb facs="StadtASG_Missive_1127_3636.jpg" n="4"/>
<lb n="44"/>Den <unclear cert="low" resp="#joint">edlenn</unclear>, fromen, vesten, fürnemen und
<lb n="45"/><unclear cert="low" resp="#joint">wyssen</unclear> herren, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister und rath
<lb n="46"/>der Sant <unclear cert="low" resp="#joint">Gallen</unclear></orgName>, minen insonders <unclear cert="medium" resp="#joint">günst</unclear>-
<lb n="47"/>igen lieben herren.
</p>
