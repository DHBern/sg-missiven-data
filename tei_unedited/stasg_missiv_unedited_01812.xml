<lb n="35"/>vor E. E. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">erschienen</unclear>, und ermeldte mein liebe schwyger, durch
<lb n="36"/>den <unclear cert="low" resp="#joint">herren</unclear> <persName resp="#ner">Michell <unclear cert="low" resp="#joint">halßen</unclear></persName> <unclear cert="low" resp="#joint">bitlich</unclear> <unclear cert="low" resp="#joint">fuerbring</unclear> <unclear cert="low" resp="#joint">laß</unclear>, Nach <unclear cert="medium" resp="#joint">dem</unclear>
