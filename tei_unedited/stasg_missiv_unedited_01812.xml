<lb n="40"/><unclear cert="low" resp="#joint">herren</unclear> <persName resp="#ner">Ulrich <unclear cert="low" resp="#joint">Brenchlin</unclear></persName> <unclear cert="low" resp="#joint">Zunfftmeijster</unclear> und deß Raths alda
<lb n="41"/><unclear cert="medium" resp="#joint">widerumb</unclear> <unclear cert="low" resp="#joint">verheürat</unclear>, auch <unclear cert="low" resp="#joint">biß</unclear> ihren wittwen und <unclear cert="low" resp="#joint">Ehrlich</unclear>
