<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> freundtlich willig diennst zuvor, <unclear cert="medium" resp="#joint">Für</unclear>-
<lb n="2"/><unclear cert="low" resp="#joint">sichtige</unclear>, <unclear cert="low" resp="#joint">Ersame</unclear>, und <unclear cert="low" resp="#joint">weise</unclear>, <unclear cert="medium" resp="#joint">besonders</unclear> <unclear cert="low" resp="#joint">liebe</unclear>,
<lb n="3"/>und <unclear cert="low" resp="#joint">guete</unclear> <unclear cert="low" resp="#joint">Freund</unclear> und <unclear cert="low" resp="#joint">Nachbarn</unclear>.
<lb n="4"/>Was an <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">unser</unclear> burger <persName resp="#ner"><unclear cert="low" resp="#joint">Johanneß</unclear> <unclear cert="low" resp="#joint">Zeller</unclear></persName>
<lb n="5"/>wegen sein und seines <unclear cert="low" resp="#joint">Eheweibes</unclear> <unclear cert="medium" resp="#joint">suppliciert</unclear>
<lb n="6"/>unnd <unclear cert="medium" resp="#joint">gebetten</unclear>, das gibt der <unclear cert="low" resp="#joint">einschluß</unclear> seiner
<lb n="7"/><unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">ubergebner</unclear> supplication gnuegsam <unclear cert="low" resp="#joint">zue</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">vernemen</unclear>.
<lb n="9"/>Wann wir dann gern sehen, daß dise sach <unclear cert="medium" resp="#joint">zue</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">guetem</unclear> billichem und <unclear cert="medium" resp="#joint">nechstmaessigem</unclear> <unclear cert="medium" resp="#joint">vergleich</unclear> (<unclear cert="medium" resp="#joint">dar</unclear>-
<lb n="11"/><unclear cert="medium" resp="#joint">zue</unclear> wir E. F. Wht. wol <unclear cert="low" resp="#joint">geneigt</unclear> sein wissen) ge-
<lb n="12"/>langen <unclear cert="medium" resp="#joint">thete</unclear>, <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">ist</unclear> <unclear cert="medium" resp="#joint">an</unclear> dieselben unnser <unclear cert="low" resp="#joint">freund</unclear>-
<lb n="13"/><unclear cert="low" resp="#joint">nachperliches</unclear> und <unclear cert="medium" resp="#joint">bitten</unclear>, sy wollen die sachen
<lb n="14"/><unclear cert="low" resp="#joint">zwüschen</unclear> <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="medium" resp="#joint">Partheyen</unclear> <unclear cert="low" resp="#joint">dahin</unclear> <unclear cert="low" resp="#joint">dirigiern</unclear> unnd
<lb n="15"/>verhandlen, damit sie deß und <unclear cert="medium" resp="#joint">ihren</unclear> <unclear cert="medium" resp="#joint">habenden</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">differenz</unclear> halber guet. und freundtlich, nach
<lb n="17"/>billich gebürenden dingen <unclear cert="medium" resp="#joint">vereinbart</unclear> und ver-
<lb n="18"/>glichen, oder wie <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">end</unclear> <unclear cert="medium" resp="#joint">sein</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Zellers</unclear></persName> suppli-
<lb n="19"/>cation <unclear cert="medium" resp="#joint">gebetten</unclear>, <unclear cert="medium" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">raß</unclear> <unclear cert="low" resp="#joint">angezogner</unclear> <unclear cert="low" resp="#joint">Eerchafft</unclear>,
<lb n="20"/><unclear cert="low" resp="#joint">unß</unclear> zur entscheidung <unclear cert="medium" resp="#joint">zuegeordnet</unclear> werde.
<lb n="21"/>E. F. Wht. <unclear cert="low" resp="#joint">wollen</unclear> sich <unclear cert="medium" resp="#joint">hierinnen</unclear> der <unclear cert="medium" resp="#joint">massen</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">erweisen</unclear>, wie <unclear cert="medium" resp="#joint">zue</unclear> derselben <unclear cert="medium" resp="#joint">unser</unclear> guet <unclear cert="medium" resp="#joint">nachbarlich</unclear> <unclear cert="medium" resp="#joint">ver</unclear>-
<lb n="23"/><unclear cert="medium" resp="#joint">trawen</unclear> <unclear cert="medium" resp="#joint">steet</unclear>. Das begeren <unclear cert="low" resp="#joint">umb</unclear>
