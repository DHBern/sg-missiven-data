<lb n="51"/>ihres <unclear cert="low" resp="#joint">zuvor</unclear> lang gehabten <unclear cert="low" resp="#joint">burgerrechtens</unclear>, und <unclear cert="medium" resp="#joint">dan</unclear> auch
