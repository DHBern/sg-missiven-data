<lb n="24"/>E. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. wir <unclear cert="low" resp="#joint">hiewider</unclear> <unclear cert="low" resp="#joint">guotwillig</unclear> und <unclear cert="medium" resp="#joint">nach</unclear>-
