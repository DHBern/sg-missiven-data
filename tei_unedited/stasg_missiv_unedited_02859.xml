<lb n="31"/>dienst: und <unclear cert="medium" resp="#joint">freundtlich</unclear> <unclear cert="medium" resp="#joint">pitende</unclear>, <unclear cert="medium" resp="#joint">sy</unclear> <unclear cert="medium" resp="#joint">woellen</unclear> <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">an</unclear> unser statt
<lb n="32"/><unclear cert="medium" resp="#joint">guethwillig</unclear> <unclear cert="medium" resp="#joint">gehoer</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">glauben</unclear> <unclear cert="medium" resp="#joint">geben</unclear>, und uns <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">solcher</unclear> <unclear cert="medium" resp="#joint">eu</unclear>-
<lb n="33"/><unclear cert="medium" resp="#joint">ssersten</unclear> <unclear cert="medium" resp="#joint">seelen</unclear>: und <unclear cert="medium" resp="#joint">leibßnoth</unclear> und <unclear cert="medium" resp="#joint">gefahr</unclear>, mit einem <unclear cert="medium" resp="#joint">ergibigen</unclear>
<lb n="34"/>anlehen, gegen <unclear cert="medium" resp="#joint">gepuerender</unclear> <unclear cert="medium" resp="#joint">verzynsung</unclear> und <unclear cert="low" resp="#joint">gnuegsamer</unclear> obli-
<lb n="35"/><unclear cert="low" resp="#joint">gation</unclear>, <unclear cert="low" resp="#joint">derentwegen</unclear> mit <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wtl</unclear>. <unclear cert="low" resp="#joint">gemelter</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Loeffler</unclear></persName>, <unclear cert="low" resp="#joint">biß</unclear>
<lb n="36"/>in <unclear cert="medium" resp="#joint">dero</unclear> <unclear cert="medium" resp="#joint">gueth</unclear> <unclear cert="medium" resp="#joint">benuegen</unclear>, sich <unclear cert="medium" resp="#joint">zuvergleichen</unclear> <unclear cert="medium" resp="#joint">hiemit</unclear> unser <unclear cert="medium" resp="#joint">voll</unclear>-
<lb n="37"/><unclear cert="medium" resp="#joint">khomen</unclear> <unclear cert="medium" resp="#joint">macht</unclear> und <unclear cert="medium" resp="#joint">gewalth</unclear> haben <unclear cert="medium" resp="#joint">soll</unclear>, dem <unclear cert="medium" resp="#joint">wir</unclear> auch <unclear cert="medium" resp="#joint">gebuerlich</unclear>
<lb n="38"/>und <unclear cert="medium" resp="#joint">treulich</unclear> statt <unclear cert="medium" resp="#joint">zuthuen</unclear>, bey <unclear cert="medium" resp="#joint">unsern</unclear> <unclear cert="medium" resp="#joint">ehren</unclear>, <unclear cert="medium" resp="#joint">treuen</unclear> und glau-
<lb n="39"/>ben <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">crafft</unclear> <unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">versprechen</unclear>, <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">hilff</unclear> <unclear cert="low" resp="#joint">komen</unclear>, daß <unclear cert="medium" resp="#joint">seind</unclear>
<lb n="40"/>umb <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">V</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">F</unclear>. <unclear cert="medium" resp="#joint">E</unclear>. <unclear cert="medium" resp="#joint">Wtl</unclear>. und alle ire <unclear cert="low" resp="#joint">angehoerige</unclear>, <unclear cert="low" resp="#joint">wir</unclear> und die
<lb n="41"/><unclear cert="medium" resp="#joint">unßrige</unclear>, mit <unclear cert="medium" resp="#joint">hoechster</unclear> <unclear cert="medium" resp="#joint">unvergessner</unclear> <unclear cert="medium" resp="#joint">danckhbarkheit</unclear>, nach <unclear cert="low" resp="#joint">eusser</unclear>-
