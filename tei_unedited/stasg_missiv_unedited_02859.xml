<lb n="28"/>deß <unclear cert="low" resp="#joint">haben</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">umbgeen</unclear> <unclear cert="low" resp="#joint">kuenden</unclear>, <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">V</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Wtl</unclear>.,
