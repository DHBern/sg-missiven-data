<lb n="15"/><unclear cert="low" resp="#joint">auuch</unclear> <unclear cert="low" resp="#joint">oberkaitlichen</unclear> ampts halber, obligt,
<lb n="16"/>die <unclear cert="low" resp="#joint">ihnige</unclear> unns verburgerte personen,
<lb n="17"/><unclear cert="low" resp="#joint">annderen</unclear> orten wohnen, auuch <unclear cert="low" resp="#joint">zuor</unclear> ge-
<lb n="18"/><unclear cert="low" resp="#joint">pürrenden</unclear> <unclear cert="medium" resp="#joint">gehorsame</unclear> <unclear cert="low" resp="#joint">annzuohalten</unclear>, haben
<lb n="19"/>wir <persName resp="#ner"><unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">Krautschen</unclear></persName>, sein begeren, umb
<lb n="20"/><unclear cert="low" resp="#joint">souil</unclear> weniger <unclear cert="low" resp="#joint">abzuoschlagen</unclear> <unclear cert="low" resp="#joint">gewußt</unclear>, weil
