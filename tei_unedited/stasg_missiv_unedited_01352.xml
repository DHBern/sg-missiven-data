<lb n="3"/>unnd guoten <unclear cert="low" resp="#joint">freündt</unclear>. <unclear cert="low" resp="#joint">Warumben</unclear> unnd
<lb n="4"/><unclear cert="medium" resp="#joint">zuo</unclear> was <unclear cert="low" resp="#joint">ennd</unclear>, unnser burger, <persName resp="#ner">Peter <unclear cert="medium" resp="#joint">Krautschel</unclear></persName>,
<lb n="5"/>gegen unnd <unclear cert="medium" resp="#joint">wider</unclear> <unclear cert="medium" resp="#joint">unnsers</unclear> <unclear cert="medium" resp="#joint">burgers</unclear>,
