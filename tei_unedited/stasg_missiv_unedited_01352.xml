<lb n="22"/>hye zwaien unnderschidenlichen mahlen, orden-
<lb n="23"/><unclear cert="low" resp="#joint">lichen</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">zuom</unclear> rechten <unclear cert="low" resp="#joint">alher</unclear>, durch <unclear cert="low" resp="#joint">gebürrende</unclear>
