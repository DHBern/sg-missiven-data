<lb n="61"/>mit allem burgerlichen gehorsam nach ver=
<lb n="62"/>mogen zuverdienen <unclear cert="medium" resp="#joint">sowillig</unclear> alß <unclear cert="medium" resp="#joint">schuldig</unclear>.
<lb n="63"/>E. E. <unclear cert="medium" resp="#joint">F</unclear>. E. W. <unclear cert="medium" resp="#joint">unß</unclear> zu <unclear cert="medium" resp="#joint">gunsten</unclear> gehorsam=
