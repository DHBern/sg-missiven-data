<pb facs="StadtASG_Missive_1761_6498.jpg" n="4"/>
<lb n="57"/><unclear cert="low" resp="#joint">zuoerscheinen</unclear>, dann wir der <unclear cert="medium" resp="#joint">getroesten</unclear> hofnung
<lb n="58"/><unclear cert="low" resp="#joint">seind</unclear>, <unclear cert="low" resp="#joint">mergedachter</unclear> unser <unclear cert="low" resp="#joint">gewalthaber</unclear>, <unclear cert="low" resp="#joint">ber=</unclear>
<lb n="59"/><unclear cert="medium" resp="#joint">vend</unclear> werde derselben fruchtbarlichen ge=
