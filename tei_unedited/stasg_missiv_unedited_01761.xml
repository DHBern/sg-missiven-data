<lb n="66"/>E. E. <unclear cert="medium" resp="#joint">F</unclear>. E. W.
<lb n="67"/>Gehorsame burger
<lb n="68"/><persName role="issuer" resp="#ner">Tobias <unclear cert="medium" resp="#joint">Stüeler</unclear></persName>.
<lb n="69"/><persName role="issuer" resp="#ner">Jacob <unclear cert="low" resp="#joint">Kleinhanß</unclear></persName> <unclear cert="low" resp="#joint">an</unclear> <unclear cert="low" resp="#joint">stat</unclear>
