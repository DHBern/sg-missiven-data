        <body>
<p>
<pb facs="StadtASG_Missive_772_2039.JPG" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Haug</unclear> <unclear cert="low" resp="#joint">graue</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-100" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Montfort</unclear></placeName>, unnd
<lb n="2"/><placeName resp="#ner"><unclear cert="medium" resp="#joint">Rotenfels</unclear></placeName>, herr <unclear cert="medium" resp="#joint">zuo</unclear> <placeName ref="stadtasg-places-93" cert="medium" resp="#ner">Tetnang</placeName> und <placeName ref="stadtasg-places-84" cert="medium" resp="#ner">Arge</placeName> etc.
<lb n="3"/><unclear cert="medium" resp="#joint">Unnseren</unclear> <unclear cert="medium" resp="#joint">guenstlichen</unclear> gruos <unclear cert="medium" resp="#joint">zuuor</unclear>. Ersamen
<lb n="4"/>weisen, <unclear cert="medium" resp="#joint">besonnder</unclear> lieben, unnd gueten <unclear cert="low" resp="#joint">nachpaurn</unclear>,
<lb n="5"/>ir haben <unclear cert="medium" resp="#joint">onch</unclear> zweifels on noch wol <unclear cert="medium" resp="#joint">zauerfinnen</unclear>,
<lb n="6"/>das wir euch <unclear cert="low" resp="#joint">mermals</unclear> von wegen <unclear cert="medium" resp="#joint">unnsers</unclear>
<lb n="7"/>underthonen, <persName resp="#ner"><unclear cert="medium" resp="#joint">Lauxen</unclear> <unclear cert="medium" resp="#joint">Bürkhen</unclear></persName> von <placeName ref="stadtasg-places-271" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Ymenstat</unclear></placeName>,
<lb n="8"/>seiner gegen <unclear cert="low" resp="#joint">ewern</unclear> mitburgern den <persName resp="#ner"><unclear cert="low" resp="#joint">Schlapperitzin</unclear></persName>
<lb n="9"/><unclear cert="low" resp="#joint">säligen</unclear>, der <unclear cert="low" resp="#joint">ansprach</unclear> halber, darumb <unclear cert="medium" resp="#joint">sÿ</unclear> inn
<lb n="10"/>gegen <unclear cert="low" resp="#joint">etlichen</unclear> alhie im <placeName ref="stadtasg-places-339" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Allgew</unclear></placeName> versetzt, schrifftlich
<lb n="11"/>ersuecht, aber ime <unclear cert="medium" resp="#joint">bißanher</unclear> <unclear cert="medium" resp="#joint">nichtz</unclear> <unclear cert="medium" resp="#joint">erfolgt</unclear>,
<lb n="12"/>unnd <unclear cert="low" resp="#joint">wiewol</unclear> wir von <unclear cert="low" resp="#joint">euch</unclear>, das <unclear cert="medium" resp="#joint">ime</unclear> <unclear cert="medium" resp="#joint">Bürkhen</unclear>
<lb n="13"/>von den <unclear cert="low" resp="#joint">Schlapperitzin</unclear> <unclear cert="low" resp="#joint">nichtz</unclear> werden moege,
<lb n="14"/><unclear cert="low" resp="#joint">verstendigt</unclear>, so sind wir doch <unclear cert="medium" resp="#joint">kurzverschinen</unclear>
<lb n="15"/>tagen bericht, das die <unclear cert="low" resp="#joint">Schlapperitzin</unclear> in <placeName ref="stadtasg-places-273" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Italia</unclear></placeName>
<lb n="16"/>etlich schulden, so man inen zethun schuldig, darumb
<lb n="17"/>dann wie uns <unclear cert="low" resp="#joint">anzaigt</unclear> noch <unclear cert="low" resp="#joint">schuldtbrieff</unclear>, unnd
<lb n="18"/>gestelt <unclear cert="medium" resp="#joint">quitungen</unclear> die <unclear cert="medium" resp="#joint">unerloest</unclear> in ewer stat
<lb n="19"/><unclear cert="medium" resp="#joint">ligen</unclear>, verlassen haben soellen. <unclear cert="medium" resp="#joint">Soeuel</unclear> <unclear cert="medium" resp="#joint">dem</unclear>
<lb n="20"/><unclear cert="medium" resp="#joint">alßo</unclear>, <unclear cert="medium" resp="#joint">were</unclear> von <unclear cert="medium" resp="#joint">bemeltz</unclear> <unclear cert="medium" resp="#joint">unnsers</unclear> <unclear cert="medium" resp="#joint">underthonen</unclear>
<lb n="21"/>wegen, unnser <unclear cert="medium" resp="#joint">guenstlich</unclear> unnd <unclear cert="medium" resp="#joint">nachpeurlich</unclear>
<lb n="22"/><unclear cert="medium" resp="#joint">ansynnen</unclear>, <unclear cert="medium" resp="#joint">ir</unclear> <unclear cert="medium" resp="#joint">woelten</unclear> <unclear cert="medium" resp="#joint">ime</unclear> als <unclear cert="medium" resp="#joint">aim</unclear> armen
<lb n="23"/>gsellen umb <unclear cert="medium" resp="#joint">unsert</unclear> willen, lut <unclear cert="medium" resp="#joint">ewers</unclear> <unclear cert="medium" resp="#joint">iungst</unclear>
<lb n="24"/>gethonen schrifftlichen <unclear cert="medium" resp="#joint">erpiettens</unclear>, <unclear cert="medium" resp="#joint">hierinnen</unclear>, mit
<lb n="25"/>den obangeregten <unclear cert="medium" resp="#joint">schuldtbrieffen</unclear>, und quitung,
<lb n="26"/><unclear cert="medium" resp="#joint">auch</unclear> <unclear cert="medium" resp="#joint">in</unclear> ander weg <unclear cert="medium" resp="#joint">fürdersam</unclear>, unnd dahin ver=
<lb n="27"/>holffen sein, ob er <unclear cert="low" resp="#joint">am</unclear> <unclear cert="low" resp="#joint">selben</unclear> ort seiner <unclear cert="medium" resp="#joint">anforder=</unclear>
<lb n="28"/>ung, und <unclear cert="low" resp="#joint">ustends</unclear>, als <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">versetzter</unclear> man
<lb n="29"/><unclear cert="low" resp="#joint">zukomen</unclear>, und <unclear cert="low" resp="#joint">bezalt</unclear> werden, und sich <unclear cert="medium" resp="#joint">hiedurch</unclear>
<lb n="30"/>der <unclear cert="medium" resp="#joint">versazung</unclear> ledigen <unclear cert="medium" resp="#joint">moechte</unclear>, und <unclear cert="medium" resp="#joint">euch</unclear> <unclear cert="medium" resp="#joint">indem</unclear>
<lb n="31"/><unclear cert="medium" resp="#joint">aal</unclear> so guotwillig gegen ime erzaigen, damit er
<lb n="32"/><unclear cert="low" resp="#joint">unnsers</unclear> <unclear cert="low" resp="#joint">fürpits</unclear> fruchtpar genossen zehaben
<pb facs="StadtASG_Missive_772_2040.JPG" n="2"/>
<lb n="33"/><unclear cert="low" resp="#joint">spüren</unclear> unnd befinden <unclear cert="low" resp="#joint">moege</unclear>, (dann er
<lb n="34"/>diser hanndlung nit allein deß weyßßes
<lb n="35"/>halber. sonnder in <unclear cert="low" resp="#joint">ander</unclear> weg zuo <unclear cert="low" resp="#joint">grossem</unclear>
<lb n="36"/>costen, und schaden komen) Begeren wir
<lb n="37"/>umb uch günnstlich, unnd nachpürlich
<lb n="38"/>zuobeschulden. Datum <origDate when="1554" cert="medium" resp="#ner">den <unclear cert="medium" resp="#joint">xx</unclear> tag decembris
<lb n="39"/>anno etc. <unclear cert="low" resp="#joint">liiij</unclear></origDate>.
<pb facs="StadtASG_Missive_772_2041.JPG" n="3"/>
<pb facs="StadtASG_Missive_772_2042.JPG" n="4"/>
<lb n="40"/>Den ersamen, weisen, <unclear cert="low" resp="#joint">unnsern</unclear>
<lb n="41"/>besonndern lieben unnd gueten
<lb n="42"/><unclear cert="low" resp="#joint">nachpaurn</unclear> <unclear cert="low" resp="#joint">ec</unclear>., <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Burgermaister</unclear>
<lb n="43"/>unnd Rat der <unclear cert="medium" resp="#joint">Stat</unclear> Sant Gallen</orgName>
<lb n="44"/>ze antwurten.
</p>
