    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2280_8657.jpg" n="1"/>
<lb n="1"/>Unser freundtlich willig dienst, und
<lb n="2"/>was wir ehren liebs und guetts vermoe-
<lb n="3"/>gende, zuvor, Wolgeborne, Edle, Veste
<lb n="4"/>Fürsichtig, Ersame und Weise, besonders
<lb n="5"/>liebe Herren und guette Freündt.
<lb n="6"/>Nachdem dieselben unß <unclear cert="low" resp="#joint">zuehanden</unclear> <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">meiner</unclear> <unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">bishero</unclear> von
<lb n="8"/><unclear cert="low" resp="#joint">jahren</unclear> <unclear cert="low" resp="#joint">herro</unclear> <unclear cert="low" resp="#joint">etwelcher</unclear> <unclear cert="low" resp="#joint">viertausent</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">sonnen</unclear> <unclear cert="low" resp="#joint">cronen</unclear> <unclear cert="low" resp="#joint">anderswoerenden</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">hauptguet</unclear>, <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">zweytausent</unclear>
<lb n="11"/><unclear cert="low" resp="#joint">dreuhundert</unclear> <unclear cert="low" resp="#joint">fünff</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">sibenzig</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">sonnen</unclear> <unclear cert="low" resp="#joint">cronen</unclear>, <unclear cert="low" resp="#joint">samet</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">darvon</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">uff</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">Johanni</unclear> deß verwichenen 1620
<lb n="14"/>jahrs</date> biß uff <date resp="#ner">Johanni diß jahrs</date>
<lb n="15"/>verfallnen zinß zuthun schuldig ver-
<lb n="16"/>bliben. Haben <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">disen</unclear> <unclear cert="low" resp="#joint">orten</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">trauwten</unclear> lieben Mitburgern <persName resp="#ner">Daniel
<lb n="18"/>Studern</persName>, wie <unclear cert="low" resp="#joint">er</unclear> deß <unclear cert="low" resp="#joint">berichts</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">zu</unclear>
<lb n="20"/>mit <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Gn</unclear>. <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">erlegung</unclear> <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">nachstendigen</unclear> <unclear cert="low" resp="#joint">verfallnen</unclear> <unclear cert="low" resp="#joint">hauptguetts</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">der</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">zinß</unclear> <unclear cert="low" resp="#joint">halber</unclear> <unclear cert="low" resp="#joint">zuhandlen</unclear> <unclear cert="low" resp="#joint">beuelch</unclear> <unclear cert="low" resp="#joint">gegeben</unclear>, <unclear cert="low" resp="#joint">hiemit</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">ersuechende</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">wollen</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">besagten</unclear> <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">Mitburgern</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">solchem</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">seinem</unclear> <unclear cert="low" resp="#joint">anbringen</unclear> <unclear cert="low" resp="#joint">beuelch</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">gueter</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">expedition</unclear> <unclear cert="low" resp="#joint">abfertigen</unclear>. <unclear cert="low" resp="#joint">So</unclear>
<pb facs="StadtASG_Missive_2280_8658.jpg" n="2"/>
<lb n="27"/>wann wir ihnen uff begebende occasionen
<lb n="28"/>widerumb ehr, freündtschafft unnd
<lb n="29"/>dienst erzeigen und beweisen künnen,
<lb n="30"/>syen wir darzue so willig, als wir
<lb n="31"/>Gott den herren bitten, daß er
<lb n="32"/>in disen gefahrlichen leüffen unß beiderseits in bestendigem frid
<lb n="33"/>und wohlstandt lange zeit wölle
<lb n="34"/>erhalten. Datum den <origDate when="1622-07-14" resp="#ner">14ten Julii.
<lb n="35"/>Anno 1622</origDate>.
<lb n="36"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und rhat
<lb n="37"/>der statt St. Gallen</orgName>.
<lb n="38"/>Den hochgeachten, edlen, vesten, fürsichtigen,
<lb n="39"/>ehrsamen und weisen, herren syndicis, <orgName role="recipient" resp="#ner">burger-
<lb n="40"/>meisteren und rhat d statt Genff</orgName>, unsern
<lb n="41"/>besonders lieben herren und guetten freünden.
<pb facs="StadtASG_Missive_2280_8659.jpg" n="3"/>
<pb facs="StadtASG_Missive_2280_8660.jpg" n="4"/>
<lb n="42"/><origDate when="1621-07-14" resp="#ner">14. Julii 1621</origDate>. an <origPlace ref="stadtasg-places-169" cert="medium" resp="#ner">Genff</origPlace>, weg
<lb n="43"/>verehrender hilf
</p>
