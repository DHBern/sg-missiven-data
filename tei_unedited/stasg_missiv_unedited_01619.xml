    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1619_5883.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edl</unclear>, <unclear cert="low" resp="#joint">Ernueste</unclear>, <unclear cert="low" resp="#joint">fürsichtige</unclear>, <unclear cert="low" resp="#joint">Ersame</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">Weiße</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">denenselben</unclear> <unclear cert="low" resp="#joint">seien</unclear> <unclear cert="low" resp="#joint">unnßer</unclear> freündt <unclear cert="low" resp="#joint">nachberliche</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">willigiste</unclear> <unclear cert="low" resp="#joint">diennst</unclear>, <unclear cert="low" resp="#joint">besstes</unclear> <unclear cert="low" resp="#joint">vleiß</unclear> <unclear cert="low" resp="#joint">zuuoran</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Denen</unclear> <unclear cert="low" resp="#joint">herrn</unclear> <unclear cert="low" resp="#joint">ist</unclear> <unclear cert="low" resp="#joint">unuerborgen</unclear>, <unclear cert="low" resp="#joint">uß</unclear> was <unclear cert="low" resp="#joint">lanng</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">wiirigen</unclear> <unclear cert="low" resp="#joint">strittigkhaiten</unclear>, <unclear cert="low" resp="#joint">uß</unclear> unns <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">gegen</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">von</unclear> <placeName ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Lindow</unclear></placeName> <unclear cert="low" resp="#joint">erregt</unclear>, <unclear cert="low" resp="#joint">durch</unclear> <unclear cert="low" resp="#joint">dennselben</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">im</unclear> <unclear cert="low" resp="#joint">nechstverschinen</unclear> <unclear cert="low" resp="#joint">Jarr</unclear>, <unclear cert="low" resp="#joint">ain</unclear> <unclear cert="low" resp="#joint">marckht</unclear>, <unclear cert="low" resp="#joint">7</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">acht</unclear> <date resp="#ner">tag <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">Michaeli</unclear>,</date> <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">auf</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">newen</unclear>
<lb n="9"/><date resp="#ner"><unclear cert="low" resp="#joint">St</unclear>: <unclear cert="low" resp="#joint">Mauricij</unclear> <unclear cert="low" resp="#joint">tag</unclear></date>, <unclear cert="low" resp="#joint">zuhalten</unclear> <unclear cert="low" resp="#joint">gegeben</unclear> worden,
<lb n="10"/>Weill aber die frtl. drt. Ertzherzhog ect. zu <placeName ref="stadtasg-places-91" cert="medium" resp="#ner">Oester-
<lb n="11"/>reich</placeName>, unnßer Griegierender herr, und lanndts-
<lb n="12"/>fürst, auf unnser der Stat <placeName ref="stadtasg-places-90" cert="medium" resp="#ner">Bluemenz</placeName> ab-
<lb n="13"/><unclear cert="low" resp="#joint">gesannte</unclear>, <unclear cert="low" resp="#joint">unnderthenigistes</unclear> Supplicieren,
<lb n="14"/>unnd ietzo unnder wehrender Recht-
<lb n="15"/>tigen marckht auf dis Jarr, und biß
<lb n="16"/>zu außtrag der sachen, weill es auch in
<lb n="17"/>unnßern seiten, am <unclear cert="low" resp="#joint">haubtwerckh</unclear>, wider-
<lb n="18"/>umben gnedigist eingestelt, auch <unclear cert="low" resp="#joint">solchen</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">marckht</unclear> <unclear cert="low" resp="#joint">einzustellen</unclear>, <unclear cert="low" resp="#joint">unnßern</unclear> <unclear cert="low" resp="#joint">herrn</unclear>, unnd
<lb n="20"/>vogt, Crafft da herr zu der Jorgen-
<lb n="21"/>burg, unnd <placeName ref="stadtasg-places-72" cert="medium" resp="#ner">Vaelden</placeName> alles ernnsts
<lb n="22"/>auferladen, Soerntweills haben wir
<lb n="23"/>auß sonderbare gegen <unclear cert="low" resp="#joint">dennselben</unclear> <unclear cert="low" resp="#joint">trag</unclear>-
<lb n="24"/><unclear cert="low" resp="#joint">ennden</unclear> <unclear cert="low" resp="#joint">nachberlichen</unclear> affection <unclear cert="low" resp="#joint">nit</unclear> umb-
<lb n="25"/><unclear cert="low" resp="#joint">gehen</unclear> <unclear cert="low" resp="#joint">sollen</unclear>, <unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">wollen</unclear>, <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">herrn</unclear>, <unclear cert="low" resp="#joint">unnd</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">Ihren</unclear> <unclear cert="low" resp="#joint">mitburgeren</unclear>, <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">vehüetung</unclear> <unclear cert="low" resp="#joint">vergeb</unclear>-
<lb n="27"/>enlichen <unclear cert="low" resp="#joint">uncosstens</unclear>, solches zu auisieren,
<lb n="28"/>Imfahl aber ainer, oder anndere metzger,
<lb n="29"/>solchen nit in achtung nemmen, sonnder hierin
<pb facs="StadtASG_Missive_1619_5884.jpg" n="2"/>
<lb n="30"/>ziehen, unnd das vieh niemandts hun, wider
<lb n="31"/>das <unclear cert="low" resp="#joint">herkhomen</unclear> <unclear cert="low" resp="#joint">hinwegkhauffen</unclear> <unclear cert="low" resp="#joint">wolte</unclear>, auf
<lb n="32"/>wellichen dann vleissigs aufsehen beschehen
<lb n="33"/>wurdet, so velt alsdann disoertig, well-
<lb n="34"/>ichem was daruber begegnen wurde, die
<lb n="35"/>schuld niemandt annders, als Ime selbsten
<lb n="36"/>zuemessen. Es werden auch die <unclear cert="low" resp="#joint">maerkht</unclear>
<lb n="37"/><unclear cert="low" resp="#joint">alhie</unclear> zu <placeName ref="stadtasg-places-90" cert="medium" resp="#ner">Bludennz</placeName>, wie von alters her ge-
<lb n="38"/>breuchig <unclear cert="low" resp="#joint">gewesst</unclear>, auf <date resp="#ner">St. Maurizii tag
<lb n="39"/>des alten callennders</date>, diss der .<date resp="#ner">22. <unclear cert="low" resp="#joint">sett</unclear>-
<lb n="40"/>embris</date>, oder des <unclear cert="low" resp="#joint">neuen</unclear>, der .<date resp="#ner">2. octobris</date>,
<lb n="41"/>der <unclear cert="low" resp="#joint">erst</unclear> <unclear cert="low" resp="#joint">marckht</unclear>, unnd nachvolgennds die
<lb n="42"/>anndern, nachainanndern gehalten werden,
<lb n="43"/><unclear cert="low" resp="#joint">diß</unclear> <unclear cert="low" resp="#joint">wegen</unclear> <unclear cert="low" resp="#joint">vereraueter</unclear> <unclear cert="low" resp="#joint">gueter</unclear> nachpar-
<lb n="44"/>licher correspontenz, den herren zuwissen
<lb n="45"/>zumachen, haben wir nit <unclear cert="low" resp="#joint">unnderlassen</unclear> <unclear cert="medium" resp="#joint">wöllen</unclear>,
<lb n="46"/>wie dann die herren Ire benachbarten auch
<lb n="47"/>zuberichten wissen werden, unnd verbleib-
<lb n="48"/>en <unclear cert="low" resp="#joint">denselben</unclear> <unclear cert="low" resp="#joint">one</unclear> das, mit <unclear cert="medium" resp="#joint">allem</unclear> nachpar-
<lb n="49"/><unclear cert="medium" resp="#joint">lichem</unclear> <unclear cert="low" resp="#joint">guetem</unclear> willen woll beigethonn,
<lb n="50"/>und gewogen, datum <origPlace ref="stadtasg-places-90" cert="medium" resp="#ner">Bludennz</origPlace>,
<lb n="51"/><origDate when="1608" resp="#ner">den .13. settembris a° 1608</origDate>.
<lb n="52"/><unclear cert="low" resp="#joint">Eur</unclear> <unclear cert="low" resp="#joint">Vöst</unclear> unnd <unclear cert="low" resp="#joint">Weißhait</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">dinstwillig</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">schuld</unclear>-
<lb n="54"/><unclear cert="low" resp="#joint">ige</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">Baumeister</unclear>, unnd rath,
<lb n="56"/>der statt Bludennz.
<pb facs="StadtASG_Missive_1619_5885.jpg" n="3"/>
<pb facs="StadtASG_Missive_1619_5886.jpg" n="4"/>
<lb n="57"/>Den Edlen, <unclear cert="low" resp="#joint">Erenuesten</unclear>, Fürsichtigen, Ersamen, und
<lb n="58"/>Weisen H. und H. <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burgermeister und Rhat,
<lb n="59"/>der Statt St. Gallen</orgName>, unsern lieben <unclear cert="low" resp="#joint">herren</unclear>,
<lb n="60"/>und Naachbarn.
<lb n="61"/>St. Gallen.
</p>
