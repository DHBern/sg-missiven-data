<p>
<pb facs="StadtASG_Missive_1894_7051.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig <unclear cert="medium" resp="#joint">dinst</unclear>, zuvor, Edle, <unclear cert="medium" resp="#joint">Veste</unclear>,
<lb n="2"/><unclear cert="medium" resp="#joint">Ehrenveste</unclear>, <unclear cert="medium" resp="#joint">Fürsichtige</unclear>, <unclear cert="medium" resp="#joint">Ehrsame</unclear> und <unclear cert="medium" resp="#joint">Weiße</unclear>,
<lb n="3"/>Insonders <unclear cert="medium" resp="#joint">liebe</unclear> und <unclear cert="medium" resp="#joint">guote</unclear> <unclear cert="medium" resp="#joint">Freünde</unclear>.
<lb n="4"/><unclear cert="medium" resp="#joint">Deroselben</unclear> vom .<date resp="#ner">23. Aprilis</date> nechsthin an uns, wegen
<lb n="5"/>des <unclear cert="medium" resp="#joint">valors</unclear> der <unclear cert="low" resp="#joint">gemeinen</unclear> <unclear cert="low" resp="#joint">Muenssorten</unclear>, <unclear cert="low" resp="#joint">erfolgtes</unclear>
<lb n="6"/>widerantwurtliches schreiben, haben wir ab-
<lb n="7"/><unclear cert="medium" resp="#joint">hoerend</unclear> seines <unclear cert="medium" resp="#joint">innhalts</unclear> nach <unclear cert="medium" resp="#joint">lengs</unclear> verstanden,
<lb n="8"/>nit weniger <unclear cert="medium" resp="#joint">was</unclear> in der darmit <unclear cert="medium" resp="#joint">überschikhten</unclear>
<lb n="9"/><unclear cert="medium" resp="#joint">underschidlichen</unclear> <unclear cert="medium" resp="#joint">Muenss</unclear> <unclear cert="medium" resp="#joint">Listen</unclear> <unclear cert="medium" resp="#joint">ersehen</unclear>. Und
<lb n="10"/><unclear cert="medium" resp="#joint">darbeÿ</unclear> nit allein ihr <unclear cert="low" resp="#joint">vorsichtige</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wolmeinende</unclear> <unclear cert="low" resp="#joint">fürßorg</unclear> <unclear cert="low" resp="#joint">zum</unclear> besten
<lb n="11"/>des gemeinen <unclear cert="medium" resp="#joint">weßens</unclear> <unclear cert="medium" resp="#joint">ins</unclear> <unclear cert="medium" resp="#joint">gemein</unclear>, <unclear cert="medium" resp="#joint">sonder</unclear> auch
<lb n="12"/><unclear cert="medium" resp="#joint">in</unclear> <unclear cert="medium" resp="#joint">sonderheit</unclear> <unclear cert="medium" resp="#joint">verspürt</unclear>, die <unclear cert="medium" resp="#joint">sonderliche</unclear> <unclear cert="medium" resp="#joint">zu</unclear>-
<lb n="13"/><unclear cert="medium" resp="#joint">neigung</unclear> und freündtliches anerbieten, mit
<lb n="14"/>uns <unclear cert="low" resp="#joint">hierinnen</unclear> <unclear cert="low" resp="#joint">moeglichste</unclear> conformitet und <unclear cert="medium" resp="#joint">Corre</unclear>-
<lb n="15"/><unclear cert="medium" resp="#joint">spondentz</unclear> zuhalten, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="low" resp="#joint">ferneren</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">weitlaeüffigen</unclear> <unclear cert="low" resp="#joint">bericht</unclear>, darfür wir uns
<lb n="17"/>freündtlich und <unclear cert="medium" resp="#joint">vleißig</unclear> <unclear cert="medium" resp="#joint">thuon</unclear> <unclear cert="medium" resp="#joint">bedankhen</unclear>.
<lb n="18"/>Und <unclear cert="medium" resp="#joint">dieweil</unclear> wir <unclear cert="medium" resp="#joint">nichts</unclear> <unclear cert="medium" resp="#joint">liebers</unclear> sehen noch <unclear cert="medium" resp="#joint">wúnschen</unclear>
<lb n="19"/><unclear cert="medium" resp="#joint">moechten</unclear>, dann <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">zwúschen</unclear> <unclear cert="low" resp="#joint">E</unclear>: <unclear cert="low" resp="#joint">Vst</unclear>: <unclear cert="low" resp="#joint">Fr</unclear>:
