<p>
<pb facs="StadtASG_Missive_2196_8267.jpg" n="1"/>
<lb n="1"/>Unser fründt: nachbarlich willig
<lb n="2"/>dienst zuvor, Fuersichtig Ersam
<lb n="3"/>wyß, besonders liebe Fründt
<lb n="4"/>und gute Nachbarn.
<lb n="5"/>Wir <unclear cert="low" resp="#joint">zwiflen</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">werde</unclear>
<lb n="6"/><unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">alß</unclear> die ganz <unclear cert="low" resp="#joint">unverscha</unclear>-
<lb n="7"/><unclear cert="low" resp="#joint">mede</unclear> <unclear cert="low" resp="#joint">starck</unclear> <unclear cert="low" resp="#joint">geschwinde</unclear>, und
<lb n="8"/>nunmehr unerschwingliche
<lb n="9"/>Geldtsteigerung, so woll an
<lb n="10"/><unclear cert="low" resp="#joint">goldt</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">silber</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">ver</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">borgen</unclear> <unclear cert="low" resp="#joint">sin</unclear>.
<lb n="12"/><unclear cert="low" resp="#joint">Wann</unclear> <unclear cert="low" resp="#joint">dann</unclear> <unclear cert="low" resp="#joint">nun</unclear> <unclear cert="low" resp="#joint">hiedurch</unclear> <unclear cert="low" resp="#joint">uff</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">künfftig</unclear> <unclear cert="low" resp="#joint">nichts</unclear> anders, dann
<lb n="14"/>ganz beschwerlicher erfolg und
<lb n="15"/>unwiderbringlicher schaden zuer-
<lb n="16"/>warten, deme wir unserß theilß
<lb n="17"/>allhie, und in der benachbarten
<lb n="18"/>landtschafft, wo es <unclear cert="low" resp="#joint">muglich</unclear> <unclear cert="low" resp="#joint">wer</unclear>,
<lb n="19"/><unclear cert="low" resp="#joint">gerne</unclear> <unclear cert="low" resp="#joint">vorgebouwt</unclear>.
<lb n="20"/><unclear cert="low" resp="#joint">Diewil</unclear> aber im <orgName ref="stadtasg-actors-559" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Reich</unclear> <unclear cert="low" resp="#joint">Teütscher</unclear> <unclear cert="low" resp="#joint">nation</unclear></orgName>
<lb n="21"/>so gar kein fürsehung geschicht,
<lb n="22"/>und zum theil in den fürnemmen
<lb n="23"/>ReichsStetten nunmehr allerhandt
<lb n="24"/>uffschlag erfolgt, ud die Müntz
<lb n="25"/>in <unclear cert="low" resp="#joint">hohem</unclear> <unclear cert="low" resp="#joint">valor</unclear> <unclear cert="low" resp="#joint">eingenomen</unclear> <unclear cert="low" resp="#joint">ud</unclear> <unclear cert="low" resp="#joint">ußgeben</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">wird</unclear>, <unclear cert="low" resp="#joint">wie</unclear> auß <unclear cert="low" resp="#joint">bylag</unclear> <unclear cert="low" resp="#joint">litera</unclear>
<lb n="27"/>A. <unclear cert="low" resp="#joint">zuersehen</unclear>. <unclear cert="low" resp="#joint">Deß</unclear> <unclear cert="low" resp="#joint">handt</unclear>
<pb facs="StadtASG_Missive_2196_8268.jpg" n="2"/>
<lb n="28"/>wir <unclear cert="low" resp="#joint">gleichen</unclear> <unclear cert="low" resp="#joint">auß</unclear> <unclear cert="low" resp="#joint">beyderseits</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">genoethiget</unclear> <unclear cert="low" resp="#joint">worden</unclear> <unclear cert="low" resp="#joint">uns</unclear>, <unclear cert="low" resp="#joint">etwelcher</unclear>
<lb n="30"/><unclear cert="low" resp="#joint">weiße</unclear>
<lb n="31"/><unclear cert="low" resp="#joint">maaß</unclear> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">ungelegenheit</unclear> <unclear cert="low" resp="#joint">jeziger</unclear>
<lb n="32"/><unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">accommodiren</unclear>. Und
<lb n="33"/><unclear cert="low" resp="#joint">habendt</unclear> <unclear cert="low" resp="#joint">derowegen</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">guldin</unclear>
<lb n="34"/><unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">silberin</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">taxirt</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">gsezt</unclear> <unclear cert="low" resp="#joint">wie</unclear> in der <unclear cert="medium" resp="#joint">beylag</unclear> <unclear cert="medium" resp="#joint">litera</unclear>
<lb n="36"/>B. <unclear cert="low" resp="#joint">zuvernemmen</unclear>.
<lb n="37"/><unclear cert="low" resp="#joint">Welches</unclear> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">ehr</unclear>. <unclear cert="low" resp="#joint">wht</unclear>. wir
<lb n="38"/><unclear cert="low" resp="#joint">fründt</unclear> <unclear cert="low" resp="#joint">nachburlicher</unclear> <unclear cert="low" resp="#joint">wohlmei=</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">nung</unclear> <unclear cert="low" resp="#joint">ohnvermuethet</unclear>, <unclear cert="low" resp="#joint">unbeschwe=</unclear>
<lb n="40"/><unclear cert="low" resp="#joint">ret</unclear> <unclear cert="low" resp="#joint">zuegleich</unclear> <unclear cert="low" resp="#joint">nach=</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">burlich</unclear> <unclear cert="low" resp="#joint">bitten</unclear> <unclear cert="low" resp="#joint">wellen</unclear>, <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">vernemmen</unclear>
<lb n="42"/><unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">uebersendter</unclear> <unclear cert="low" resp="#joint">nachburlich</unclear> <unclear cert="low" resp="#joint">zube=</unclear>
<lb n="43"/>richten, ob <unclear cert="low" resp="#joint">dieselben</unclear> deßwegen <unclear cert="medium" resp="#joint">auch</unclear>
<lb n="44"/>waß ordnung der <unclear cert="medium" resp="#joint">taxation</unclear> auf=
<lb n="45"/><unclear cert="medium" resp="#joint">gerichtet</unclear>, und <unclear cert="low" resp="#joint">sonderlich</unclear> wie <unclear cert="low" resp="#joint">hoch</unclear>
<lb n="46"/><unclear cert="low" resp="#joint">allerhande</unclear> <unclear cert="low" resp="#joint">thaler</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">silber</unclear> <unclear cert="low" resp="#joint">sorten</unclear> <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">ihnen</unclear> <unclear cert="low" resp="#joint">gang=</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">bar</unclear> <unclear cert="low" resp="#joint">seye</unclear>, <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">darnach</unclear> <unclear cert="low" resp="#joint">wit=</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">ters</unclear> <unclear cert="low" resp="#joint">zuverhalten</unclear>. <unclear cert="low" resp="#joint">Hiemit</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">siendensambt</unclear> <unclear cert="low" resp="#joint">deme</unclear> <unclear cert="low" resp="#joint">nach</unclear>
<lb n="50"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">ehr</unclear>. <unclear cert="low" resp="#joint">wht</unclear>. <unclear cert="low" resp="#joint">angehoerige</unclear> <unclear cert="low" resp="#joint">underthanen</unclear>
<pb facs="StadtASG_Missive_2196_8269.jpg" n="3"/>
<lb n="51"/>Weindlerin genennt <persName resp="#ner">Wagnerin</persName>
<lb n="52"/>etlich jahr in unser Statt
<lb n="53"/>gedienet, (soudann jezo aber, in ewer Statt
<lb n="54"/>in diensten syn solle,) und lob сиe kam
<lb n="55"/>daß was сиe die sich eewybs syn fuer-
<lb n="56"/>gebe,) mit einem unserem
<lb n="57"/>Burger allhie, etwas unehrlichs
<lb n="58"/>verüebt haben solle.
<lb n="59"/>Damit nun deßwegen die gebuer für-
<lb n="60"/>genomen, und so dem nicht also
<lb n="61"/>sein solte (wie dann der bezüchtiget
<lb n="62"/>deßen nicht gestendig syn will.)
<lb n="63"/>so wohl сиe Weindlerin alß der
<lb n="64"/>unsere sich diser zuolag halber
<lb n="65"/>gebuendermaße
<lb n="66"/>entschütten
<lb n="67"/>köennind.
<lb n="68"/>So gelangt an E. W. un-
<lb n="69"/>ser nachbarlich ersuchen gedachter
<lb n="70"/>Weindlerin Oberkaitthalben
<lb n="71"/>günstig uffzelegen sich ehist
<lb n="72"/>in diß ohrts allher zü verfüegen damit so сиe
<lb n="73"/>unschuldig сиe sich verantworte,
<lb n="74"/>und beneben der unsere syner Ehren wol
<lb n="75"/>usßgehnge, und alßo in allweg
<lb n="76"/>fürbashinige was die gebür
<lb n="77"/>und billichkait wird erfordern.
<pb facs="StadtASG_Missive_2196_8270.jpg" n="4"/>
