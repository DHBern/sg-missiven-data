<lb n="11"/><unclear cert="low" resp="#joint">inzogen</unclear> <unclear cert="low" resp="#joint">word</unclear>, der hat <unclear cert="medium" resp="#joint">beÿ</unclear> <unclear cert="medium" resp="#joint">ersten</unclear> <unclear cert="medium" resp="#joint">verordnet</unclear>
