<lb n="4"/>insonders lieben <unclear cert="medium" resp="#joint">freunden</unclear>, und <unclear cert="medium" resp="#joint">gueten</unclear> nach-
<lb n="5"/><unclear cert="low" resp="#joint">barn</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">Waß</unclear> <unclear cert="low" resp="#joint">ihr</unclear> an <unclear cert="medium" resp="#joint">unß</unclear> wegen <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">erbfangnen</unclear>, <unclear cert="low" resp="#joint">frndl</unclear>. <unclear cert="low" resp="#joint">nachbrch</unclear>.
