<lb n="5"/><unclear cert="medium" resp="#joint">barn</unclear>.
<lb n="6"/><unclear cert="medium" resp="#joint">Waß</unclear> <unclear cert="medium" resp="#joint">ihr</unclear> an unß wegen <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">erbfangnen</unclear>, <unclear cert="medium" resp="#joint">frndl</unclear>. <unclear cert="medium" resp="#joint">nachbrch</unclear>.
<lb n="7"/><unclear cert="medium" resp="#joint">schriftlich</unclear> begeret, dz haben wir auß euwerm
<lb n="8"/>an <unclear cert="medium" resp="#joint">unß</unclear> abgangnen <unclear cert="low" resp="#joint">schriben</unclear> <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">lengs</unclear> verstand.
