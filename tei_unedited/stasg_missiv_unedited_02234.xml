    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_2234_8443.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edle</unclear>, <unclear cert="low" resp="#joint">Veste</unclear>, <unclear cert="low" resp="#joint">Eerenveste</unclear>, <unclear cert="low" resp="#joint">Wyse</unclear>, <unclear cert="low" resp="#joint">gönstige</unclear>, <unclear cert="low" resp="#joint">liebe</unclear> Herren <unclear cert="low" resp="#joint">Nachbaren</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">syend</unclear> <unclear cert="low" resp="#joint">min</unclear> <unclear cert="low" resp="#joint">fründtlich</unclear>, <unclear cert="low" resp="#joint">unvordrosne</unclear> <unclear cert="low" resp="#joint">dienst</unclear> <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">gruoß</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">zuvor</unclear>.
<lb n="4"/><unclear cert="low" resp="#joint">Demnach</unclear> ich <unclear cert="low" resp="#joint">diser</unclear> <unclear cert="low" resp="#joint">tagen</unclear> <unclear cert="low" resp="#joint">verstendiget</unclear> <unclear cert="low" resp="#joint">worden</unclear>. <unclear cert="low" resp="#joint">Waß</unclear>
<lb n="5"/><unclear cert="low" resp="#joint">maassen</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Andreas</unclear> <unclear cert="low" resp="#joint">Behamg</unclear></persName> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Lindow</unclear>, <unclear cert="low" resp="#joint">so</unclear> in üwer
<lb n="6"/><unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">unlangsten</unclear> <unclear cert="low" resp="#joint">hievor</unclear> <unclear cert="low" resp="#joint">justificiert</unclear> <unclear cert="low" resp="#joint">worden</unclear>, <unclear cert="low" resp="#joint">sye</unclear> <unclear cert="low" resp="#joint">selbs</unclear>,
<lb n="7"/>an der tortur nebent anderem etliche miner amptts-
<lb n="8"/>angehörigen angeben haben sölle, wie <unclear cert="low" resp="#joint">dz</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">und</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">nebent</unclear> ime etliche malefitzische fräffel begangen, Allda
<lb n="10"/>nun ich nit wüssen mag <unclear cert="low" resp="#joint">wer</unclear> <unclear cert="low" resp="#joint">söliche</unclear> <unclear cert="low" resp="#joint">persohnen</unclear> <unclear cert="low" resp="#joint">syendt</unclear>,
<lb n="11"/>oder was für fräffel sy begangen, darmit ich darumb
<lb n="12"/>tragenden amptshalber gebürenden maassen abstwaffen,
<lb n="13"/>chöndte. Also langt an üch min <unclear cert="low" resp="#joint">fründt</unclear>: <unclear cert="low" resp="#joint">nachpürliches</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">pitt</unclear> <unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">wöllendt</unclear> <unclear cert="low" resp="#joint">mier</unclear> <unclear cert="low" resp="#joint">by</unclear> <unclear cert="low" resp="#joint">zeigern</unclear> <unclear cert="low" resp="#joint">disem</unclear> <unclear cert="low" resp="#joint">allein</unclear> darumb
<lb n="15"/>abgesandten potten ein <unclear cert="low" resp="#joint">satten</unclear> <unclear cert="low" resp="#joint">bericht</unclear> <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">sölliche</unclear> <unclear cert="low" resp="#joint">persohnen</unclear>
<lb n="16"/>mit <unclear cert="low" resp="#joint">namen</unclear> <unclear cert="low" resp="#joint">heissen</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> was gestalten sy sölliche fräffel
<lb n="17"/>begangen, schrifftlichen überschickhen; Sölliches in der
<lb n="18"/>glichen unnd andern <unclear cert="low" resp="#joint">begebenden</unclear> <unclear cert="low" resp="#joint">fälen</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">zebeschulden</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">bin</unclear> <unclear cert="low" resp="#joint">ich</unclear> <unclear cert="low" resp="#joint">urpüttig</unclear>. <unclear cert="low" resp="#joint">Datum</unclear> <origPlace ref="stadtasg-places-29" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Frowenfeldt</unclear></origPlace> <origDate when="1596-10-08" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">den</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">8</unclear>. <unclear cert="low" resp="#joint">Octobris</unclear> <unclear cert="low" resp="#joint">A°</unclear> <unclear cert="low" resp="#joint">96</unclear> <unclear cert="low" resp="#joint">etc</unclear>.</origDate>
<lb n="21"/><persName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Hans</unclear> <unclear cert="low" resp="#joint">Cuonrad</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">Roll</unclear></persName>, <unclear cert="low" resp="#joint">deß</unclear>
<lb n="22"/><orgName resp="#ner"><unclear cert="low" resp="#joint">Rhats</unclear> <unclear cert="low" resp="#joint">zuo</unclear> <unclear cert="low" resp="#joint">Ury</unclear></orgName>, <unclear cert="low" resp="#joint">Landtvogt</unclear> <unclear cert="low" resp="#joint">in</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Obern</unclear></placeName>
<lb n="23"/><unclear cert="low" resp="#joint">unnd</unclear> <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Nidern</unclear> <unclear cert="low" resp="#joint">Thurgöws</unclear></placeName>.
<pb facs="StadtASG_Missive_2234_8444.jpg" n="2"/>
<pb facs="StadtASG_Missive_2234_8445.jpg" n="3"/>
<pb facs="StadtASG_Missive_2234_8446.jpg" n="4"/>
<lb n="24"/>Denen edlen vesten ehrenvesten unnd weÿßen
<lb n="25"/>herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister unnd rhatt der statt S.
<lb n="26"/>Gallen</orgName>, minen gönstigen lieben herren nach-
<lb n="27"/>bauren.
</p>
