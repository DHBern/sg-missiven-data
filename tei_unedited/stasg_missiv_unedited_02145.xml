<p>
<pb facs="StadtASG_Missive_2145_8039.jpg" n="1"/>
<lb n="1"/>Unser freündtlich willig <unclear cert="medium" resp="#joint">dinst</unclear> zuvor, fürsichtige
<lb n="2"/>ersame und weise, besonders liebe <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">guete</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">freünd</unclear>.
<lb n="4"/>Wir <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">heüt</unclear> <unclear cert="low" resp="#joint">dato</unclear>, <unclear cert="low" resp="#joint">Vb</unclear> <unclear cert="low" resp="#joint">eim</unclear> <unclear cert="low" resp="#joint">unverdrauenen</unclear> <unclear cert="low" resp="#joint">ort</unclear>,
<lb n="5"/><unclear cert="low" resp="#joint">berichtet</unclear>, das. 6000. <unclear cert="medium" resp="#joint">Spannische</unclear> <unclear cert="medium" resp="#joint">soldaten</unclear>, über
<lb n="6"/>den <persName resp="#ner"><unclear cert="low" resp="#joint">Gotthart</unclear></persName> <unclear cert="low" resp="#joint">herauß</unclear>, <unclear cert="low" resp="#joint">uff</unclear> <placeName ref="stadtasg-places-87" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Rorschach</unclear></placeName> und von <unclear cert="low" resp="#joint">dannen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">durch</unclear> <placeName ref="stadtasg-places-103" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Turgöw</unclear></placeName>, <unclear cert="low" resp="#joint">runter</unclear> die <unclear cert="low" resp="#joint">übern</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Arleberg</unclear></placeName> <unclear cert="low" resp="#joint">oder</unclear>
<lb n="8"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Achern</unclear></placeName>, <unclear cert="low" resp="#joint">marchiren</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear>, <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">östenreich=</unclear>
<lb n="9"/>ische <unclear cert="medium" resp="#joint">vögt</unclear> der <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">Arlebergischen</unclear> <unclear cert="low" resp="#joint">herrschafften</unclear>, <unclear cert="low" resp="#joint">uff</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">morgen</unclear> <unclear cert="low" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-117" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Dornbeüren</unclear></placeName>, wegen berathschlagung
<lb n="11"/>diß <unclear cert="low" resp="#joint">durchzugs</unclear>, <unclear cert="low" resp="#joint">zusamen</unclear> <unclear cert="low" resp="#joint">kommen</unclear> <unclear cert="low" resp="#joint">sollen</unclear>. Welches
<lb n="12"/>wir <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">Fst</unclear>. hiemit <unclear cert="low" resp="#joint">zuavisieren</unclear> nit <unclear cert="medium" resp="#joint">umbgehen</unclear>
<lb n="13"/><unclear cert="medium" resp="#joint">künden</unclear>; mit freündt <unclear cert="low" resp="#joint">nachbaurlichem</unclear> <unclear cert="low" resp="#joint">bitten</unclear>,
<lb n="14"/>sie <unclear cert="low" resp="#joint">wöllen</unclear> <unclear cert="low" resp="#joint">unß</unclear>, <unclear cert="low" resp="#joint">waß</unclear> <unclear cert="low" resp="#joint">sie</unclear> <unclear cert="low" resp="#joint">hievon</unclear> <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">wißenschafft</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">geerdt</unclear> und <unclear cert="medium" resp="#joint">ohnverzuglich</unclear> berichten. Das
<lb n="16"/><unclear cert="medium" resp="#joint">sein</unclear> wir, <unclear cert="medium" resp="#joint">uff</unclear> alle begebenheit, <unclear cert="low" resp="#joint">zuverdienen</unclear>
<lb n="17"/>bereitwillig, <unclear cert="low" resp="#joint">Gottes</unclear> <unclear cert="low" resp="#joint">gnaden</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">sambtlichen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">bewelchend</unclear>. <unclear cert="low" resp="#joint">Dato</unclear> den <origDate when="1619" resp="#ner"><unclear cert="medium" resp="#joint">ii.ten</unclear> septembris
<lb n="19"/><unclear cert="medium" resp="#joint">Ao</unclear> 1619</origDate>.
<lb n="20"/><orgName ref="stadtasg-actors-511" cert="medium" role="issuer" resp="#ner">Burgermeister und rhat
<lb n="21"/>der statt <unclear cert="medium" resp="#joint">Lindaw</unclear></orgName>.
<pb facs="StadtASG_Missive_2145_8040.jpg" n="2"/>
<pb facs="StadtASG_Missive_2145_8041.jpg" n="3"/>
<pb facs="StadtASG_Missive_2145_8042.jpg" n="4"/>
<lb n="22"/>Den
<lb n="23"/><unclear cert="low" resp="#joint">en</unclear>, <unclear cert="low" resp="#joint">fuersichtigen</unclear> ersamen und weisen <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="24"/>meister und Rhat, der statt Sanct Gallen</orgName>,
<lb n="25"/>unsern besondern lieben und gueten freünden.
</p>
