<lb n="9"/><unclear cert="low" resp="#joint">anderm</unclear> <unclear cert="low" resp="#joint">verstannden</unclear>, <unclear cert="low" resp="#joint">das</unclear> <unclear cert="low" resp="#joint">selbiger</unclear> tagen <unclear cert="low" resp="#joint">uch</unclear> <unclear cert="low" resp="#joint">baiden</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">oberkaitten</unclear>, von <unclear cert="low" resp="#joint">irern</unclear> burgern, <unclear cert="low" resp="#joint">kouffhus</unclear>- und <unclear cert="medium" resp="#joint">schifflueten</unclear>,
<lb n="11"/><unclear cert="low" resp="#joint">beschwerdt</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">clagswise</unclear> furkomen, das wir <unclear cert="low" resp="#joint">sellend</unclear>
<lb n="12"/>ain <unclear cert="low" resp="#joint">nuwe</unclear> ordnung <unclear cert="low" resp="#joint">der</unclear> schiffart halben, inn unnser statt
