<lb n="36"/>etwas nuwerung der schiffart <unclear cert="low" resp="#joint">angesehen</unclear>, <unclear cert="low" resp="#joint">do</unclear> <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">wir</unclear>
