<lb n="1"/>Hochwurdiger furst, gnediger herr, <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">fromen</unclear>, <unclear cert="low" resp="#joint">vesten</unclear>,
