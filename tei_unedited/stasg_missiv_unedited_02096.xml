<p>
<pb facs="StadtASG_Missive_2096_7855.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="medium" resp="#joint">freundt</unclear> nachbarlich willig dienst, zuovor
<lb n="2"/>fürsichtigen, ersamen, und weisen,
<lb n="3"/>insonders lieben <unclear cert="medium" resp="#joint">guoten</unclear> <unclear cert="medium" resp="#joint">freundt</unclear> <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="medium" resp="#joint">nachbarn</unclear>.
<lb n="4"/>Es ist <unclear cert="medium" resp="#joint">diser</unclear> <unclear cert="medium" resp="#joint">tagen</unclear> <unclear cert="medium" resp="#joint">ein</unclear> <unclear cert="medium" resp="#joint">iunger</unclear> knab, so sich <persName resp="#ner"><unclear cert="low" resp="#joint">Chri</unclear>-
<lb n="5"/><unclear cert="low" resp="#joint">stophel</unclear> <unclear cert="low" resp="#joint">Kobel</unclear></persName> <unclear cert="low" resp="#joint">von</unclear> <placeName ref="stadtasg-places-89" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Veldtkirch</unclear></placeName> <unclear cert="low" resp="#joint">nent</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">unser</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eydgnos</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">schaft</unclear></orgName> und gefangenschafft <unclear cert="medium" resp="#joint">komen</unclear>, der hat under
<lb n="7"/><unclear cert="low" resp="#joint">anderem</unclear> <unclear cert="low" resp="#joint">bekhandt</unclear>. <unclear cert="low" resp="#joint">Wassmassen</unclear> <unclear cert="low" resp="#joint">vor</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">ungefehr</unclear> <unclear cert="low" resp="#joint">5</unclear>. <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">6</unclear>. wuchen in <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">W</unclear>.
<lb n="9"/>statt <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">übelthäter</unclear> <unclear cert="low" resp="#joint">iustificiert</unclear> worden, den
<lb n="10"/>er <placeName resp="#ner"><unclear cert="low" resp="#joint">Rothlatz</unclear></placeName> <unclear cert="low" resp="#joint">genandt</unclear>, <unclear cert="low" resp="#joint">seye</unclear> <unclear cert="low" resp="#joint">auß</unclear> dem landt <placeName ref="stadtasg-places-8" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Abben</unclear>-
<lb n="11"/><unclear cert="low" resp="#joint">zell</unclear></placeName> <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">usseren</unclear> <unclear cert="low" resp="#joint">rooden</unclear> <unclear cert="low" resp="#joint">bürtig</unclear> gewesen, <unclear cert="low" resp="#joint">dene</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">habe</unclear> <unclear cert="low" resp="#joint">er</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Christoph</unclear></persName>, in halber <unclear cert="low" resp="#joint">jahrsfrist</unclear> (<unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">lang</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">seye</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">ihme</unclear> <unclear cert="low" resp="#joint">und</unclear> seinem <unclear cert="medium" resp="#joint">stieffvatter</unclear>, so zuo
<lb n="14"/><placeName ref="stadtasg-places-263" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Trogen</unclear></placeName> <unclear cert="medium" resp="#joint">gericht</unclear> worden, <unclear cert="low" resp="#joint">gangen</unclear>) <unclear cert="low" resp="#joint">kühe</unclear>, <unclear cert="low" resp="#joint">kalb</unclear> und <unclear cert="medium" resp="#joint">bockh</unclear>,
<lb n="15"/><unclear cert="medium" resp="#joint">farb</unclear> in <unclear cert="medium" resp="#joint">einem</unclear> waldt <unclear cert="medium" resp="#joint">uff</unclear> <placeName resp="#ner"><unclear cert="medium" resp="#joint">Saxt</unclear></placeName> <unclear cert="medium" resp="#joint">überlüpfen</unclear>, vil <unclear cert="medium" resp="#joint">wet</unclear>-
<lb n="16"/><unclear cert="medium" resp="#joint">ter</unclear> helffen <unclear cert="medium" resp="#joint">verbruoten</unclear>, der <unclear cert="low" resp="#joint">selbe</unclear> <unclear cert="low" resp="#joint">habe</unclear> sich <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">wol</unclear> <unclear cert="low" resp="#joint">kön</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">nen</unclear> <unclear cert="low" resp="#joint">unsichtbar</unclear>, zuo <unclear cert="medium" resp="#joint">klötz</unclear>, <unclear cert="medium" resp="#joint">stöckh</unclear> und <unclear cert="low" resp="#joint">unvernünffti</unclear>-
<lb n="18"/><unclear cert="low" resp="#joint">gen</unclear> <unclear cert="low" resp="#joint">thieren</unclear>, als <unclear cert="low" resp="#joint">katzen</unclear> und <unclear cert="low" resp="#joint">dergleichen</unclear> <unclear cert="low" resp="#joint">machen</unclear>.
<lb n="19"/><unclear cert="low" resp="#joint">Seye</unclear> <unclear cert="low" resp="#joint">dergestalt</unclear> eingezogen worden, so <unclear cert="medium" resp="#joint">baldt</unclear>
<lb n="20"/>er in die statt <unclear cert="low" resp="#joint">komen</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">wirtzhauß</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">zuogehn</unclear> <unclear cert="low" resp="#joint">wollen</unclear>, <unclear cert="low" resp="#joint">hetten</unclear> <unclear cert="low" resp="#joint">ihne</unclear> <unclear cert="low" resp="#joint">zween</unclear> <unclear cert="low" resp="#joint">bettelvögt</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">und</unclear> sonst noch <unclear cert="low" resp="#joint">einer</unclear> <unclear cert="low" resp="#joint">angegriffen</unclear>, deren er
<pb facs="StadtASG_Missive_2096_7856.jpg" n="2"/>
<lb n="23"/>sich allerdings erwehrt gehabt hette. Er
<lb n="24"/><persName resp="#ner">Christopb</persName> were auch eben damahln, alß man ihne
<lb n="25"/>justificiert, da gewesen, und die vergicht ge=
<lb n="26"/>hoerdt, nemblich die viertzehen hannen die morden
<lb n="27"/>und brand ueber ihne abgelesen, auch er hierauf
<lb n="28"/>geredbrecht und verbrandt worden.
<lb n="29"/>Wan wir nun ihme gefangnen solches nicht wohl
<lb n="30"/>glauben koennen, alldieweiln unß nie fuerkomen,
<lb n="31"/>daß dergleichen ubelthaeter in E. E. St. E. Wht.
<lb n="32"/>Statt, in der zeit, gethuetter maßten, abgethon
<lb n="33"/>worden, unnd dahero gern wißten wolten, wie
<lb n="34"/>es damit bewandt und beschaffen seye.
<lb n="35"/>Alß gelangt an E. E. St. E. Wht. unser
<lb n="36"/>freundt nachbarliches ersuechen, ob deme also,
<lb n="37"/>oder nit, unß freundt nachbarlich ze avisieren
<lb n="38"/>auch im fall angedeüter ubelthaeter obgehoerter
<lb n="39"/>fuergebner maßen eingezogen unnd gerichtet wor=
<lb n="40"/>den, unß deßselben vergicht, und ob er un=
<lb n="41"/>sers gefangnen nie gedacht, zuekomen zelaßten,
<lb n="42"/>unß darnach gegen ihme haben zeverhalten.
<lb n="43"/>Daß begeren wir in gleichem und andern
<pb facs="StadtASG_Missive_2096_7857.jpg" n="3"/>
<lb n="44"/><unclear cert="low" resp="#joint">freündtnachbarlich</unclear> zuerwideren, <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">da</unclear>-
<lb n="45"/>mit samptlich <unclear cert="medium" resp="#joint">Gottes</unclear> <unclear cert="medium" resp="#joint">getreüwer</unclear> obhalt <unclear cert="medium" resp="#joint">wohl</unclear>-
<lb n="46"/><unclear cert="medium" resp="#joint">bevehlende</unclear>. Datum <origDate when="1618-05-23" resp="#ner">den 23ten <unclear cert="medium" resp="#joint">Maij</unclear>
<lb n="47"/>Anno <unclear cert="medium" resp="#joint">1618</unclear></origDate>.
<lb n="48"/><orgName ref="stadtasg-actors-148" cert="medium" role="issuer" resp="#ner">Burgermeister und <unclear cert="medium" resp="#joint">Rhat</unclear>
<lb n="49"/>der Statt <unclear cert="medium" resp="#joint">Sannt</unclear> Gallen</orgName>.
<pb facs="StadtASG_Missive_2096_7858.jpg" n="4"/>
<lb n="50"/>Den <unclear cert="low" resp="#joint">ehrenvesten</unclear>, <unclear cert="low" resp="#joint">fuersichtigen</unclear>, <unclear cert="low" resp="#joint">ehrsamen</unclear> und
<lb n="51"/>weysen, <orgName ref="stadtasg-actors-511" cert="medium" role="recipient" resp="#ner">Burgermeister und Rhat der statt
<lb n="52"/><unclear cert="low" resp="#joint">Lindauw</unclear></orgName>, <unclear cert="low" resp="#joint">unsern</unclear> <unclear cert="low" resp="#joint">insonders</unclear> lieben <unclear cert="low" resp="#joint">gueten</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">freünden</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachparenn</unclear>
<lb n="54"/><placeName ref="stadtasg-places-24" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Lindauw</unclear></placeName>.
</p>
