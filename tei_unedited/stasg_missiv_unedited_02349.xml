<p>
<pb facs="StadtASG_Missive_2349_8997.jpg" n="1"/>
<lb n="1"/>Unser <unclear cert="low" resp="#joint">freündt</unclear>-, <unclear cert="low" resp="#joint">nachparlich</unclear> und <unclear cert="low" resp="#joint">gutwillig</unclear>
<lb n="2"/>dienst, zuvor, <unclear cert="low" resp="#joint">Fuersichtig</unclear> <unclear cert="low" resp="#joint">Ersamb</unclear> und
<lb n="3"/><unclear cert="medium" resp="#joint">Weiß</unclear>, besonders liebe freündt und
<lb n="4"/><unclear cert="medium" resp="#joint">gute</unclear> <unclear cert="medium" resp="#joint">Nachparn</unclear>.
<lb n="5"/><unclear cert="medium" resp="#joint">Euerselben</unclear> <unclear cert="medium" resp="#joint">unnderm</unclear> <unclear cert="medium" resp="#joint">dato</unclear> deß <date resp="#ner"><unclear cert="medium" resp="#joint">14</unclear>. <unclear cert="medium" resp="#joint">9bris</unclear>
<lb n="6"/>diß <unclear cert="medium" resp="#joint">1626</unclear>. <unclear cert="medium" resp="#joint">Jars</unclear></date> an <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">abgangen</unclear>
<lb n="7"/><unclear cert="low" resp="#joint">freündtnachparlich</unclear> <unclear cert="low" resp="#joint">schriben</unclear>, haben
<lb n="8"/>wir zu <unclear cert="low" resp="#joint">recht</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">empfangen</unclear> und darauß sachlich
<lb n="10"/>vernomen, waßmaße in
<lb n="11"/>in E. Ft. E. Wht. Statt, biejehrig disen
<lb n="12"/>durgeheften diß Jahrs an schmalz
<lb n="13"/>und unschlitt waß mangels
<lb n="14"/>erscheinen wolle, und <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">deßwegen</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">freündtlich</unclear> <unclear cert="low" resp="#joint">ersuecht</unclear>, <unclear cert="low" resp="#joint">wir</unclear> wolten unsern
<lb n="16"/>burger dahin <unclear cert="medium" resp="#joint">anwisen</unclear>, dz dieselbige
<lb n="17"/><unclear cert="low" resp="#joint">gemaine</unclear> <unclear cert="low" resp="#joint">Ihrer</unclear> <unclear cert="low" resp="#joint">Statt</unclear> <unclear cert="low" resp="#joint">gewonlich</unclear> <unclear cert="low" resp="#joint">wochenmarckt</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">mit</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">schmalz</unclear> <unclear cert="low" resp="#joint">käß</unclear> und unschlitt zufueren
<lb n="20"/>und den <unclear cert="medium" resp="#joint">Ihrigen</unclear> <unclear cert="medium" resp="#joint">käuflich</unclear> <unclear cert="medium" resp="#joint">widerfahren</unclear>
<lb n="21"/><unclear cert="medium" resp="#joint">laßen</unclear> solten.
<lb n="22"/><unclear cert="medium" resp="#joint">Dieweilen</unclear> wir nun von E. Ft. E. Wt.
<lb n="23"/>bißhero anders nichts dann alle guete
<lb n="24"/><unclear cert="medium" resp="#joint">Nachparschaft</unclear> <unclear cert="medium" resp="#joint">gespuert</unclear>, <unclear cert="medium" resp="#joint">allso</unclear> <unclear cert="medium" resp="#joint">sie</unclear> <unclear cert="medium" resp="#joint">un</unclear>-
<lb n="25"/>selbigen <unclear cert="low" resp="#joint">unßersgleichen</unclear> <unclear cert="low" resp="#joint">kauf</unclear> <unclear cert="low" resp="#joint">khauft</unclear>
<lb n="26"/><unclear cert="low" resp="#joint">zeit</unclear> <unclear cert="low" resp="#joint">heür</unclear> nach gestaltſame der noth
<lb n="27"/>gestattet, deßen wir Ihnen noch
<lb n="28"/>freündtnachparlich danckh wißen
<lb n="29"/>und derowegen mehrers nicht wünschen
<lb n="30"/>möchten, dann daß <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">Jhnen</unclear> <unclear cert="low" resp="#joint">hierin</unclear>
<lb n="31"/>und <unclear cert="medium" resp="#joint">Irem</unclear> <unclear cert="medium" resp="#joint">ehrn</unclear> begeren <unclear cert="medium" resp="#joint">willfahrn</unclear> <unclear cert="medium" resp="#joint">kündten</unclear>.
