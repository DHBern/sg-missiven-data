<lb n="41"/>nit gestattet, zue mahlen gemeldten <unclear cert="low" resp="#joint">feindt</unclear> <unclear cert="low" resp="#joint">d</unclear> <unclear cert="low" resp="#joint">raub</unclear> <unclear cert="low" resp="#joint">nicht</unclear>
