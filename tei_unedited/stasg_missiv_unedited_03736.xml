<lb n="32"/>vor <unclear cert="low" resp="#joint">herumb</unclear> <unclear cert="low" resp="#joint">geschwebt</unclear> und <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">mahlen</unclear> <unclear cert="low" resp="#joint">erweh</unclear>-
