<lb n="35"/>soldaten, alß auch <unclear cert="low" resp="#joint">vn</unclear> <unclear cert="low" resp="#joint">gueten</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">d</unclear> <orgName ref="stadtasg-actors-750" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Eidgnoßschafft</unclear></orgName> <unclear cert="low" resp="#joint">geseßnen</unclear>
