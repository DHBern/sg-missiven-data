<lb n="43"/><unclear cert="low" resp="#joint">käufflich</unclear> abgehandlet word wäre, <unclear cert="low" resp="#joint">dß</unclear> <unclear cert="low" resp="#joint">d</unclear> <unclear cert="low" resp="#joint">feind</unclear> <unclear cert="low" resp="#joint">auß</unclear>
<lb n="44"/>mangel <unclear cert="low" resp="#joint">d</unclear> <unclear cert="low" resp="#joint">lebens</unclear> <unclear cert="low" resp="#joint">mittel</unclear> vor lengsten vnser Nachpar-
<lb n="45"/>schafft widrumben hette quietiren müeßen, dardurch
<lb n="46"/>auch manchem armen betrangten Ehrliebten <persName resp="#ner">Biderman</persName>
<lb n="47"/>noch ein stükh haußrath in seinem hauß verbliben sein
