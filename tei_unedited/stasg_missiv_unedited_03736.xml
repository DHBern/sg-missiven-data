<lb n="55"/><unclear cert="low" resp="#joint">hinweg</unclear> <unclear cert="low" resp="#joint">nehm</unclear> und <unclear cert="low" resp="#joint">darmit</unclear> <unclear cert="low" resp="#joint">Magnoed</unclear> <unclear cert="low" resp="#joint">od</unclear> <unclear cert="low" resp="#joint">Langen</unclear>
