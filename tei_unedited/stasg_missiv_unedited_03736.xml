<lb n="49"/><unclear cert="low" resp="#joint">wäre</unclear>; <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">haben</unclear> wir <unclear cert="low" resp="#joint">auff</unclear> <unclear cert="low" resp="#joint">ainmahl</unclear>, <unclear cert="low" resp="#joint">so</unclear> <unclear cert="low" resp="#joint">namb</unclear>-
