<p>
<pb facs="StadtASG_Missive_780_2071.JPG" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Ernvest</unclear>, <unclear cert="low" resp="#joint">Hochgelerter</unclear>, <unclear cert="low" resp="#joint">fürsichttiger</unclear>, Ersamer unnd Weiser,
<lb n="2"/><unclear cert="low" resp="#joint">Innsonders</unclear> günstiger lieber Herr unnd <unclear cert="low" resp="#joint">Fründt</unclear>, wir
<lb n="3"/>haben unnserm järlichen alten gebrauch nach, <unclear cert="medium" resp="#joint">unnsern</unclear>
<lb n="4"/>stattschreiber sampt dem gredmaister, umb <unclear cert="medium" resp="#joint">alte</unclear> gewonliche
<lb n="5"/><unclear cert="medium" resp="#joint">gebräuch</unclear> der <unclear cert="low" resp="#joint">leinwatt</unclear> <unclear cert="low" resp="#joint">vahs</unclear>, unnd annderer <unclear cert="low" resp="#joint">guetter</unclear> halben,
<lb n="6"/><unclear cert="low" resp="#joint">bej</unclear> <unclear cert="low" resp="#joint">unns</unclear> für annder mit der <unclear cert="low" resp="#joint">fuer</unclear> alhie inn unnser
<lb n="7"/><unclear cert="low" resp="#joint">gred</unclear> <unclear cert="low" resp="#joint">anzukeren</unclear>, unnd dieselbigen <unclear cert="medium" resp="#joint">zugebrauchen</unclear>, <unclear cert="medium" resp="#joint">verschin=</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">ner</unclear> zeitt, <unclear cert="medium" resp="#joint">bej</unclear> <unclear cert="medium" resp="#joint">eüch</unclear> unnd andern kauffhern von <unclear cert="medium" resp="#joint">unsert=</unclear>
<lb n="9"/>wegen freündtlichen anzuhalten unnd <unclear cert="medium" resp="#joint">zupitten</unclear>, abge=
<lb n="10"/><unclear cert="medium" resp="#joint">förttiget</unclear> unnd gesanndt, <unclear cert="medium" resp="#joint">Seyen</unclear> wir vonn inen bericht
<lb n="11"/><unclear cert="low" resp="#joint">worden</unclear>, wie das ir <unclear cert="low" resp="#joint">eüch</unclear> neben anndern <unclear cert="low" resp="#joint">kauffhern</unclear>,
<lb n="12"/>alles <unclear cert="low" resp="#joint">guett</unclear> unnd freündtlichen willens gegen unns,
<lb n="13"/>unnd das ir <unclear cert="low" resp="#joint">fürohin</unclear> (wie dann <unclear cert="medium" resp="#joint">bißher</unclear> lannge
<lb n="14"/>zeitt beschehen.) unnser <unclear cert="medium" resp="#joint">gred</unclear> mit <unclear cert="low" resp="#joint">sendung</unclear> <unclear cert="low" resp="#joint">ewers</unclear> <unclear cert="low" resp="#joint">guetts</unclear>,
<lb n="15"/><unclear cert="low" resp="#joint">suochen</unclear> wöllen, <unclear cert="low" resp="#joint">erpotten</unclear> haben, <unclear cert="medium" resp="#joint">gleichwoll</unclear> <unclear cert="low" resp="#joint">ettliche</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">beschwerden</unclear> <unclear cert="low" resp="#joint">erlegt</unclear>, <unclear cert="low" resp="#joint">die</unclear> wir deß wir verhoffen
<lb n="17"/><unclear cert="medium" resp="#joint">abgestölt</unclear> haben, <unclear cert="low" resp="#joint">Kompt</unclear> unns aber <unclear cert="low" resp="#joint">iezo</unclear> für, wie das
<lb n="18"/>ettliche <unclear cert="low" resp="#joint">leinwatt</unclear> <unclear cert="low" resp="#joint">vahs</unclear> <unclear cert="low" resp="#joint">kürzlich</unclear> durch ettlich <unclear cert="low" resp="#joint">fuerleüth</unclear>,
<lb n="19"/>ettliche tag underwegen <unclear cert="medium" resp="#joint">verhindertt</unclear> worden, Solche
<lb n="20"/><unclear cert="low" resp="#joint">fuerleüth</unclear> wir, sobald <unclear cert="low" resp="#joint">sij</unclear> unns widerumb hieher
<lb n="21"/>werden, ungestrafft nit lassen wöllen, Dann <unclear cert="medium" resp="#joint">unser</unclear>
<lb n="22"/>gredmaister unns <unclear cert="medium" resp="#joint">anzeigt</unclear>, er habe inen den wagen=
<lb n="23"/><unclear cert="low" resp="#joint">leüthen</unclear>, gemelte <unclear cert="low" resp="#joint">leinwatt</unclear> <unclear cert="low" resp="#joint">vahs</unclear>, das <unclear cert="low" resp="#joint">sij</unclear> solche unver=
<lb n="24"/>zogenlich anttwurtten unnd <unclear cert="low" resp="#joint">ferttigen</unclear> sollen, (deß
<lb n="25"/><unclear cert="low" resp="#joint">sij</unclear> ime auch <unclear cert="medium" resp="#joint">verhaissen</unclear> unnd <unclear cert="medium" resp="#joint">zugesagt</unclear>.) <unclear cert="medium" resp="#joint">uffgeben</unclear>,
<lb n="26"/>Umb diser <unclear cert="low" resp="#joint">verhinderung</unclear> willen, ir und andere <unclear cert="low" resp="#joint">verursacht</unclear>,
<lb n="27"/>das ir <unclear cert="low" resp="#joint">iezo</unclear> <unclear cert="low" resp="#joint">ewere</unclear> l. <unclear cert="low" resp="#joint">vahs</unclear> uff <placeName ref="stadtasg-places-24" cert="medium" resp="#ner">Lindaw</placeName> <unclear cert="low" resp="#joint">zuo</unclear>, <unclear cert="low" resp="#joint">schickhen</unclear>,
<pb facs="StadtASG_Missive_780_2072.JPG" n="2"/>
<lb n="28"/><unclear cert="medium" resp="#joint">gelanngt</unclear> ann E. E. F. <unclear cert="medium" resp="#joint">E</unclear>. W. <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">gannz</unclear> <unclear cert="medium" resp="#joint">freuendtlich</unclear>
<lb n="29"/>nachparlich unnd <unclear cert="low" resp="#joint">vleissig</unclear> pitten, und <unclear cert="low" resp="#joint">ansuochen</unclear>, Ir und
<lb n="30"/>die andern <unclear cert="low" resp="#joint">kauffhern</unclear> woellen unns nit <unclear cert="medium" resp="#joint">begeben</unclear> noch
<lb n="31"/>von unns <unclear cert="low" resp="#joint">abweichen</unclear>, sonnder unns und <unclear cert="medium" resp="#joint">unnsern</unclear> <unclear cert="medium" resp="#joint">gred=</unclear>
<lb n="32"/>maister <unclear cert="low" resp="#joint">endtschuldiget</unclear> haben, auch solches gegen allen
<lb n="33"/>anndern <unclear cert="medium" resp="#joint">kauffhern</unclear> <unclear cert="medium" resp="#joint">vonn</unclear> <unclear cert="medium" resp="#joint">unnserntwegen</unclear> <unclear cert="medium" resp="#joint">thuon</unclear>, unnd
<lb n="34"/><unclear cert="medium" resp="#joint">dermassen</unclear> darob unnd daran sein, damit <unclear cert="low" resp="#joint">gemeltte</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">leiwat</unclear> <unclear cert="low" resp="#joint">vaß</unclear> unnd andere guetter <unclear cert="low" resp="#joint">fuerohin</unclear> wie <unclear cert="low" resp="#joint">biß=</unclear>
<lb n="36"/>her, Inn unnser <unclear cert="medium" resp="#joint">gred</unclear> <unclear cert="medium" resp="#joint">ankhomen</unclear>, und <unclear cert="medium" resp="#joint">anderswo</unclear> <unclear cert="medium" resp="#joint">hin</unclear>
<lb n="37"/>nit <unclear cert="low" resp="#joint">verwenndt</unclear> werden, <unclear cert="medium" resp="#joint">woellen</unclear> wir mit allem ernst
<lb n="38"/>darob halten, das <unclear cert="medium" resp="#joint">solche</unclear> guetter <unclear cert="low" resp="#joint">ann</unclear> <unclear cert="low" resp="#joint">ennd</unclear> und ortt,
<lb n="39"/>dahin sy gehoern, ordenlich, <unclear cert="medium" resp="#joint">vleissig</unclear>, <unclear cert="medium" resp="#joint">fuerder</unclear> und <unclear cert="low" resp="#joint">unver=</unclear>
<lb n="40"/>zogenlich verschafft werden <unclear cert="medium" resp="#joint">soellen</unclear>, dann wir <unclear cert="low" resp="#joint">Jezo</unclear>
<lb n="41"/><unclear cert="low" resp="#joint">nechstverschinen</unclear> <persName resp="#ner">Johannis</persName> ainen <unclear cert="low" resp="#joint">gredmaister</unclear> ange=
<lb n="42"/>nomen, <unclear cert="medium" resp="#joint">dere</unclear> <unclear cert="low" resp="#joint">unzweiffenlichen</unclear> hoffnung und zuover=
<lb n="43"/>sicht, er werde <unclear cert="low" resp="#joint">weylund</unclear> <unclear cert="low" resp="#joint">unnsern</unclear> vorigen <unclear cert="low" resp="#joint">gredmaister</unclear>
<lb n="44"/><persName resp="#ner">Jacoben <unclear cert="low" resp="#joint">Pfaffmair</unclear></persName> <unclear cert="low" resp="#joint">selligen</unclear> <unclear cert="low" resp="#joint">endtsezen</unclear>, unnd unnserm
<lb n="45"/><unclear cert="low" resp="#joint">greddiennst</unclear> woll <unclear cert="low" resp="#joint">vorsein</unclear> <unclear cert="low" resp="#joint">mugen</unclear>, <unclear cert="low" resp="#joint">solchen</unclear> <unclear cert="low" resp="#joint">trewlich</unclear>
<lb n="46"/>unnd woll <unclear cert="low" resp="#joint">vorstheen</unclear> unnd verwalten, das alles
<lb n="47"/><unclear cert="medium" resp="#joint">woellen</unclear> wir umb E. E. F. <unclear cert="medium" resp="#joint">E</unclear>. W. wo wir <unclear cert="medium" resp="#joint">kunden</unclear>,
<lb n="48"/>unnd die anndern <unclear cert="medium" resp="#joint">Jeden</unclear> <unclear cert="medium" resp="#joint">Innsonnders</unclear>, <unclear cert="medium" resp="#joint">gannz</unclear> <unclear cert="medium" resp="#joint">freuendt=</unclear>
<lb n="49"/>lichen verdienen unnd beschulden, <unclear cert="medium" resp="#joint">date</unclear> den <origDate when="1558-07-05" cert="medium" resp="#ner">5
<lb n="50"/>Julij anno etc 58</origDate>,
<lb n="51"/><orgName role="issuer" resp="#ner">Burgermaister und <unclear cert="low" resp="#joint">rathe</unclear>
<lb n="52"/>der statt <unclear cert="low" resp="#joint">Buechhorn</unclear></orgName>,
<pb facs="StadtASG_Missive_780_2073.jpg" n="3"/>
<pb facs="StadtASG_Missive_780_2074.jpg" n="4"/>
<lb n="53"/>Dem <unclear cert="low" resp="#joint">hern</unclear> <unclear cert="low" resp="#joint">ehernuesten</unclear>, <unclear cert="low" resp="#joint">fuersichtigen</unclear>, ersamen
<lb n="54"/>unnd <unclear cert="medium" resp="#joint">weisen</unclear> <persName role="recipient" resp="#ner"><unclear cert="low" resp="#joint">Ambrosi</unclear> Aigen</persName> burgermaister
<lb n="55"/>der statt <placeName ref="stadtasg-places-38" cert="medium" resp="#ner">Sannt Gallen</placeName>, <unclear cert="low" resp="#joint">unnserm</unclear> sonnders
<lb n="56"/>lieben herrn unnd <unclear cert="low" resp="#joint">freundt</unclear>,
</p>
