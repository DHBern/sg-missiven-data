        <body>
<p>
<pb facs="StadtASG_Missive_785_2091.JPG" n="1"/>
<lb n="1"/>Den <unclear cert="low" resp="#joint">ernuesten</unclear> fuersichtigen ersamen unnd weysen herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">burgermaister unnd <unclear cert="low" resp="#joint">rathe</unclear> der
<lb n="2"/>statt Sant Gallen</orgName>, meinen guenstigen herren. <unclear cert="low" resp="#joint">Empeuth</unclear> ich <persName role="issuer" resp="#ner">Anna <unclear cert="low" resp="#joint">Ylin</unclear></persName>, <unclear cert="low" resp="#joint">weylundt</unclear> <persName resp="#ner">Caspar
<lb n="3"/><unclear cert="medium" resp="#joint">Schlaprigtins</unclear></persName> seligen nachgelaßne eeliche <unclear cert="medium" resp="#joint">wittib</unclear>, diser zeit <unclear cert="medium" resp="#joint">wonhafft</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <placeName ref="stadtasg-places-77" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Rauenspurg</unclear></placeName>, <unclear cert="medium" resp="#joint">mein</unclear>
<lb n="4"/>gepuerendt willig dienst <unclear cert="medium" resp="#joint">zuvor</unclear>, unnd darbey <unclear cert="low" resp="#joint">zueuernemen</unclear>, <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">dem</unclear> ich, bey gedachtem
<lb n="5"/>meinem <unclear cert="medium" resp="#joint">eelichen</unclear> lieben <unclear cert="medium" resp="#joint">haußwuert</unclear> <unclear cert="medium" resp="#joint">hern</unclear>, <unclear cert="medium" resp="#joint">das</unclear> <unclear cert="medium" resp="#joint">burgrecht</unclear>, bey <unclear cert="medium" resp="#joint">ewer</unclear> <unclear cert="medium" resp="#joint">ernuest</unclear>, fuersichtig
<lb n="6"/>ersam <unclear cert="medium" resp="#joint">weyßhait</unclear> erlangt, unnd <unclear cert="low" resp="#joint">bißher</unclear> <unclear cert="low" resp="#joint">gehapt</unclear>, mich aber diser zeit nirgend <unclear cert="medium" resp="#joint">anderstwo</unclear> dan
<lb n="7"/><unclear cert="medium" resp="#joint">alhie</unclear> bey meinen <unclear cert="low" resp="#joint">pluetsfreunden</unclear>, unnd verwanten <unclear cert="medium" resp="#joint">zueerhalten</unclear> <unclear cert="medium" resp="#joint">waiße</unclear>, so will ich in
<lb n="8"/><unclear cert="medium" resp="#joint">crafft</unclear> diß <unclear cert="low" resp="#joint">meins</unclear> offnen brieffs neben dancksagung mir unnd meinen kindern <unclear cert="medium" resp="#joint">hieuor</unclear>
<lb n="9"/>unnd <unclear cert="medium" resp="#joint">bißher</unclear> bewißner <unclear cert="medium" resp="#joint">guetthaten</unclear>, <unclear cert="medium" resp="#joint">ewer</unclear> <unclear cert="medium" resp="#joint">ernuest</unclear>, fuersichtig ersam <unclear cert="medium" resp="#joint">weyßhait</unclear>, <unclear cert="medium" resp="#joint">angeregt</unclear>,
<lb n="10"/>mein <unclear cert="medium" resp="#joint">burgrecht</unclear> <unclear cert="medium" resp="#joint">fuer</unclear> mein person <unclear cert="medium" resp="#joint">hiemit</unclear> auffgegeben, unnd <unclear cert="medium" resp="#joint">auffgeschriben</unclear>, mich
<lb n="11"/>auch darbey <unclear cert="medium" resp="#joint">erpotten</unclear> haben, so ich, <unclear cert="medium" resp="#joint">ewer</unclear> <unclear cert="medium" resp="#joint">ernuest</unclear>, fuersichtig ersam <unclear cert="medium" resp="#joint">weyßhait</unclear> <unclear cert="medium" resp="#joint">darneben</unclear>,
<lb n="12"/>unnd darbey was <unclear cert="medium" resp="#joint">zuethuen</unclear> schuldig, dasselbig wie sich <unclear cert="medium" resp="#joint">gepuert</unclear> <unclear cert="medium" resp="#joint">willigclich</unclear> <unclear cert="medium" resp="#joint">zueerstatten</unclear>. Mit <unclear cert="medium" resp="#joint">demuete</unclear>-
<lb n="13"/><unclear cert="medium" resp="#joint">tiger</unclear>, unnd dienstlicher bitt, <unclear cert="medium" resp="#joint">sollich</unclear> auffgeben deß <unclear cert="medium" resp="#joint">burgrechten</unclear> <unclear cert="medium" resp="#joint">dermassen</unclear> von mir guen-
<lb n="14"/><unclear cert="medium" resp="#joint">stigclich</unclear> <unclear cert="medium" resp="#joint">anzuenemen</unclear>, unnd mich sampt meinen <unclear cert="medium" resp="#joint">kindern</unclear> <unclear cert="medium" resp="#joint">sonst</unclear> <unclear cert="medium" resp="#joint">inguenstigem</unclear> beuelch <unclear cert="medium" resp="#joint">zuehaben</unclear>.
<lb n="15"/>Das sollen unnd <unclear cert="low" resp="#joint">woellen</unclear>, <unclear cert="low" resp="#joint">umb</unclear> ewer <unclear cert="medium" resp="#joint">ernuest</unclear>, fuersichtig, ersam, weyßhait,
<lb n="16"/><unclear cert="low" resp="#joint">gepurender</unclear> <unclear cert="low" resp="#joint">weyß</unclear>, <unclear cert="low" resp="#joint">guetwillig</unclear>, <unclear cert="low" resp="#joint">unnd</unclear> <unclear cert="low" resp="#joint">unuerdrossen</unclear> <unclear cert="low" resp="#joint">zueuerdiennen</unclear> <unclear cert="low" resp="#joint">berait</unclear> <unclear cert="low" resp="#joint">sein</unclear>, <unclear cert="low" resp="#joint">ewer</unclear>, <unclear cert="low" resp="#joint">ernuest</unclear>,
<lb n="17"/><unclear cert="low" resp="#joint">fuersichtig</unclear>, <unclear cert="low" resp="#joint">ersam</unclear>, <unclear cert="low" resp="#joint">weyßhait</unclear>, <unclear cert="low" resp="#joint">derhalben</unclear> umb schrifftliche antwurt <unclear cert="medium" resp="#joint">pittendt</unclear>. <unclear cert="medium" resp="#joint">In</unclear> <unclear cert="medium" resp="#joint">urkundt</unclear>
<lb n="18"/>diß <unclear cert="medium" resp="#joint">brieffs</unclear>, der von mein, unnd auch deß <unclear cert="low" resp="#joint">wuerdigen</unclear>, unnd <unclear cert="low" resp="#joint">hochgelerten</unclear> herren <persName resp="#ner">Philips
<lb n="19"/><unclear cert="low" resp="#joint">Ylins</unclear></persName>, der medicin <unclear cert="low" resp="#joint">doctors</unclear>, unnd <unclear cert="low" resp="#joint">burgers</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">Rauenspurg</unclear>, meins <unclear cert="low" resp="#joint">freundtlichen</unclear> lieben
<lb n="20"/>brueders, auch <unclear cert="low" resp="#joint">erkornen</unclear> unnd <unclear cert="low" resp="#joint">erbettnen</unclear> <unclear cert="low" resp="#joint">vogts</unclear> <unclear cert="low" resp="#joint">fleissiger</unclear> <unclear cert="low" resp="#joint">bitt</unclear> wegen, mit deß ersamen, und
<lb n="21"/>weysen <persName resp="#ner"><unclear cert="low" resp="#joint">Anthonj</unclear> <unclear cert="low" resp="#joint">Moyenbergers</unclear></persName>, <unclear cert="low" resp="#joint">derzeit</unclear> stattamans <unclear cert="medium" resp="#joint">alhie</unclear> aigen <unclear cert="medium" resp="#joint">fuergetrucktem</unclear> innsigel
<lb n="22"/>doch ime unnd sein erben, in <unclear cert="medium" resp="#joint">allweg</unclear> <unclear cert="medium" resp="#joint">one</unclear> schaden besigelt, unnd geben ist <origDate resp="#ner">den <unclear cert="low" resp="#joint">dreyzehenden</unclear> tag
<lb n="23"/><unclear cert="medium" resp="#joint">augusti</unclear>, nach Christi gepurt gezelt <unclear cert="low" resp="#joint">funffzehenhundert</unclear> <unclear cert="low" resp="#joint">funffzig</unclear> und acht jare</origDate>,
<pb facs="StadtASG_Missive_785_2092.JPG" n="2"/>
<lb n="24"/>[]
</p>
