<lb n="5"/><unclear cert="medium" resp="#joint">beÿ</unclear> uns <unclear cert="medium" resp="#joint">verbottner</unclear> und <unclear cert="medium" resp="#joint">angeschlagner</unclear> <unclear cert="medium" resp="#joint">sechß</unclear>
