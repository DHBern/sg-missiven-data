<lb n="7"/><unclear cert="medium" resp="#joint">wortt</unclear> nit verhalten, <unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">die</unclear> <unclear cert="low" resp="#joint">jenige</unclear> <unclear cert="low" resp="#joint">sorten</unclear>
