<lb n="64"/><unclear cert="low" resp="#joint">Denen</unclear> <unclear cert="low" resp="#joint">Edel</unclear>, <unclear cert="low" resp="#joint">Eerenvest</unclear>, <unclear cert="low" resp="#joint">Achtbar</unclear>, <unclear cert="low" resp="#joint">Fürsichtig</unclear> <unclear cert="low" resp="#joint">undt</unclear> Weisen
