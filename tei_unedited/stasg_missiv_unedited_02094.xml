        <body>
<p>
<pb facs="StadtASG_Missive_2094_7849.jpg" n="1"/>
<lb n="1"/><unclear cert="low" resp="#joint">Edel</unclear> <unclear cert="low" resp="#joint">Ehrenvest</unclear> <unclear cert="low" resp="#joint">Achtbar</unclear> <unclear cert="low" resp="#joint">Fürsichtig</unclear> <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">weise</unclear>,
<lb n="2"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">wht</unclear>. <unclear cert="low" resp="#joint">seindt</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">freündtlich</unclear>
<lb n="3"/><unclear cert="low" resp="#joint">willige</unclear> <unclear cert="low" resp="#joint">dinnst</unclear> <unclear cert="low" resp="#joint">zuevoran</unclear>, <unclear cert="low" resp="#joint">Insonders</unclear> <unclear cert="low" resp="#joint">günstige</unclear>
<lb n="4"/>Herren <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">freünndt</unclear>.
<lb n="5"/>Es ist <date resp="#ner"><unclear cert="low" resp="#joint">gestrigenn</unclear> <unclear cert="low" resp="#joint">tags</unclear></date> vor <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">erschinen</unclear> <unclear cert="low" resp="#joint">ein</unclear> <unclear cert="low" resp="#joint">le</unclear>-
<lb n="6"/><unclear cert="low" resp="#joint">diger</unclear> <unclear cert="low" resp="#joint">junger</unclear> <unclear cert="low" resp="#joint">gesell</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">schuehmacher</unclear> <unclear cert="low" resp="#joint">handtwerckhs</unclear>
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">Hanns</unclear> <unclear cert="low" resp="#joint">Jacob</unclear> <unclear cert="low" resp="#joint">Locher</unclear></persName> <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">wht</unclear>. <unclear cert="low" resp="#joint">ge</unclear>-
<lb n="8"/><unclear cert="low" resp="#joint">wesnen</unclear> <unclear cert="low" resp="#joint">mitburgers</unclear> <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">beckhens</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Daniel</unclear> <unclear cert="low" resp="#joint">Lochers</unclear></persName>
<lb n="9"/><unclear cert="low" resp="#joint">nachgelaßener</unclear> <unclear cert="low" resp="#joint">sohn</unclear>, <unclear cert="low" resp="#joint">unndt</unclear> unns <unclear cert="low" resp="#joint">clagend</unclear> <unclear cert="low" resp="#joint">zuerkennen</unclear>
<lb n="10"/>geben, welcher <unclear cert="low" resp="#joint">maßen</unclear> <unclear cert="low" resp="#joint">ihne</unclear> der allmaechtige Gott
<lb n="11"/>bey unns in der frembde mit beschwerlicher leibs-
<lb n="12"/>schwachheit angegrieffen, in deme er 3 wochen
<lb n="13"/>nach <date resp="#ner"><unclear cert="low" resp="#joint">weyhenachtten</unclear></date> <unclear cert="low" resp="#joint">biß</unclear> <date resp="#ner"><unclear cert="low" resp="#joint">zween</unclear> tag vor dem
<lb n="14"/><unclear cert="low" resp="#joint">faßnacht</unclear> <unclear cert="low" resp="#joint">sontag</unclear></date>, <unclear cert="low" resp="#joint">jüngsthin</unclear>, uff dem landt her-
<lb n="15"/>rumb, unndt der <unclear cert="low" resp="#joint">arbeit</unclear> <unclear cert="low" resp="#joint">nachgezogen</unclear>, <unclear cert="low" resp="#joint">inmittels</unclear>
<lb n="16"/><unclear cert="low" resp="#joint">ihme</unclear> die <unclear cert="low" resp="#joint">winterliche</unclear> <unclear cert="low" resp="#joint">kaelt</unclear> <unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">hefftig</unclear> <unclear cert="low" resp="#joint">zuegesetzt</unclear>,
<lb n="17"/><unclear cert="low" resp="#joint">daß</unclear>, <unclear cert="low" resp="#joint">ob</unclear> er <unclear cert="low" resp="#joint">wol</unclear> bey <unclear cert="low" resp="#joint">unnserm</unclear> <unclear cert="low" resp="#joint">mitburger</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Leonhardt</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">Stroeelin</unclear></persName> alhier arbeit erlangt, er doch sobaltden
<lb n="19"/>deß 3. tags vom fieber angegrieffen, darzue
<lb n="20"/>auch die <unclear cert="low" resp="#joint">schwehre</unclear> <unclear cert="low" resp="#joint">sucht</unclear> <unclear cert="low" resp="#joint">oder</unclear> <unclear cert="low" resp="#joint">kranckheit</unclear> <unclear cert="low" resp="#joint">kommen</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">also</unclear> <unclear cert="low" resp="#joint">daß</unclear> Er <unclear cert="low" resp="#joint">sobaldten</unclear> <unclear cert="low" resp="#joint">widerumb</unclear> <unclear cert="low" resp="#joint">ausstehen</unclear> unndt
<lb n="22"/><unclear cert="low" resp="#joint">biß</unclear> <unclear cert="low" resp="#joint">dato</unclear> bey <persName resp="#ner"><unclear cert="low" resp="#joint">Caspar</unclear> <unclear cert="low" resp="#joint">Weckherlen</unclear></persName> <unclear cert="low" resp="#joint">unnsern</unclear>
<lb n="23"/><unclear cert="low" resp="#joint">Todtengrebern</unclear> <unclear cert="low" resp="#joint">alhier</unclear> sich <unclear cert="low" resp="#joint">uffhalten</unclear> unndt <unclear cert="low" resp="#joint">seiner</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">wartten</unclear> <unclear cert="low" resp="#joint">laßen</unclear> <unclear cert="low" resp="#joint">mueßen</unclear>: <unclear cert="low" resp="#joint">Darneben</unclear> <unclear cert="low" resp="#joint">gebetten</unclear>
<pb facs="StadtASG_Missive_2094_7850.jpg" n="2"/>
<lb n="25"/>dieweile er verhoffe, es solle sich widerumb
<lb n="26"/>zur zimblichen gesundtheit, mit ihme nahen, unndt
<lb n="27"/>darmit er bey dem wuerth unnd leuten richtig-
<lb n="28"/>keit machen koente, ihne an E. E. u. F. Wht.
<lb n="29"/>zuuerschreiben, auff das ihme solhen seines be-
<lb n="30"/><unclear cert="low" resp="#joint">schwehrlichen</unclear> <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">nottuerfftigen</unclear> <unclear cert="low" resp="#joint">zustandts</unclear> halben,
<lb n="31"/><unclear cert="low" resp="#joint">desto</unclear> <unclear cert="low" resp="#joint">eher</unclear> <unclear cert="low" resp="#joint">geglaubt</unclear>, <unclear cert="low" resp="#joint">unndt</unclear> von seinem patrimonio,
<lb n="32"/>welches sein vetter <persName resp="#ner">Felix Zuebler</persName> handelsmann
<lb n="33"/>underhanden haben solle, ein gulden zwoelff
<lb n="34"/>oder vierzehen, bey zeigern diesem von ihme abge-
<lb n="35"/><unclear cert="low" resp="#joint">ferttigtem</unclear> <unclear cert="low" resp="#joint">eigenem</unclear> <unclear cert="low" resp="#joint">botten</unclear>, <unclear cert="low" resp="#joint">zugeferttigt</unclear>, <unclear cert="low" resp="#joint">so</unclear>
<lb n="36"/><unclear cert="low" resp="#joint">woln</unclear> <unclear cert="low" resp="#joint">demselben</unclear> <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">bottenlohn</unclear> da <unclear cert="low" resp="#joint">selbsten</unclear>, <unclear cert="low" resp="#joint">auch</unclear>
<lb n="37"/>entrichtet werden <unclear cert="low" resp="#joint">moege</unclear>: <unclear cert="low" resp="#joint">der</unclear> <unclear cert="low" resp="#joint">zuuersicht</unclear>, er
<lb n="38"/>sich als dann widerumb uff den weg, <unclear cert="low" resp="#joint">naher</unclear> <unclear cert="low" resp="#joint">hauß</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">zubegeben</unclear> <unclear cert="low" resp="#joint">understehen</unclear> wolte.
<lb n="40"/>Weilen wir dann, sowoln von seinem meister, als
<lb n="41"/>dem wuerth, beeden obbenant, vernommen, es
<lb n="42"/>auch der augenschein also mit sich bringt, waß
<lb n="43"/>er seiner leibs beschwehrlichkeit halben
<lb n="44"/><unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">vorbracht</unclear>, <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">sonderlich</unclear>, <unclear cert="low" resp="#joint">daß</unclear> an der
<lb n="45"/>zehrung kein uebermas bey ihme verspuehrt worden:
<lb n="46"/>So haben wir ihme, alß einem frembden noth-
<lb n="47"/>leidenten, umb <unclear cert="low" resp="#joint">soviel</unclear> <unclear cert="low" resp="#joint">weniger</unclear> <unclear cert="low" resp="#joint">abschlaegig</unclear> <unclear cert="low" resp="#joint">erschenen</unclear>,
<lb n="48"/>sondern <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">u</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">es</unclear> <unclear cert="low" resp="#joint">dergestallt</unclear> <unclear cert="low" resp="#joint">no</unclear>-
<pb facs="StadtASG_Missive_2094_7851.jpg" n="3"/>
<lb n="49"/>tificiren sollen unndt <unclear cert="low" resp="#joint">wollen</unclear>, <unclear cert="low" resp="#joint">nicht</unclear> <unclear cert="low" resp="#joint">zweiffelnde</unclear>,
<lb n="50"/><unclear cert="low" resp="#joint">sie</unclear> es <unclear cert="low" resp="#joint">ihres</unclear> <unclear cert="low" resp="#joint">theils</unclear> <unclear cert="low" resp="#joint">numehro</unclear> als an inordung
<lb n="51"/>setzen werden, darmit dem <unclear cert="low" resp="#joint">armen</unclear> <unclear cert="low" resp="#joint">krancken</unclear>
<lb n="52"/><unclear cert="low" resp="#joint">gesellen</unclear> <unclear cert="low" resp="#joint">alhier</unclear> <unclear cert="low" resp="#joint">geholffen</unclear>, <unclear cert="low" resp="#joint">unndt</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">wiederumb</unclear>
<lb n="53"/><unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">frieden</unclear> <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">seinigen</unclear> <unclear cert="low" resp="#joint">gluecklich</unclear> gelangen
<lb n="54"/>unndt <unclear cert="low" resp="#joint">kommen</unclear> <unclear cert="low" resp="#joint">moge</unclear>. <unclear cert="low" resp="#joint">Erwareten</unclear> <unclear cert="low" resp="#joint">doch</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">E</unclear>. <unclear cert="low" resp="#joint">F</unclear>. <unclear cert="low" resp="#joint">Wht</unclear>. <unclear cert="low" resp="#joint">beschriebener</unclear> <unclear cert="low" resp="#joint">wieder</unclear> ant=
<lb n="56"/>woret, umb eigentlicher nachrichtung willen, unndt
<lb n="57"/>verbleiben den selben zu freundtlicher dienst=
<lb n="58"/><unclear cert="low" resp="#joint">erzeigung</unclear>, <unclear cert="low" resp="#joint">unsers</unclear> <unclear cert="low" resp="#joint">theils</unclear>, <unclear cert="low" resp="#joint">geneigt</unclear> unndt willig.
<lb n="59"/>Datum <origPlace resp="#ner">Kitzingen</origPlace> im landt zu <placeName ref="stadtasg-places-131" cert="medium" resp="#ner">Francken</placeName> am
<lb n="60"/><placeName resp="#ner"><unclear cert="low" resp="#joint">Meinstromb</unclear></placeName> <unclear cert="low" resp="#joint">gelegen</unclear>, <origDate when="1618-04-23" resp="#ner"><unclear cert="low" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">23ten</unclear> Aprilis alten
<lb n="61"/>calenders ao. 1618</origDate>.
<lb n="62"/><orgName role="issuer" resp="#ner">Burgermeister unndt
<lb n="63"/><unclear cert="low" resp="#joint">rhath</unclear> <unclear cert="low" resp="#joint">daselbsten</unclear></orgName>.
