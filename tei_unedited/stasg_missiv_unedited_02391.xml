<lb n="9"/>und <unclear cert="medium" resp="#joint">nachparn</unclear>,
<lb n="10"/>Dieweil unß <unclear cert="low" resp="#joint">d</unclear>. <unclear cert="low" resp="#joint">windtwurff</unclear> <unclear cert="low" resp="#joint">bey</unclear> <unclear cert="low" resp="#joint">wildtbrats</unclear> <unclear cert="low" resp="#joint">etwas</unclear>
