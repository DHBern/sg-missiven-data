<lb n="5"/>und <unclear cert="medium" resp="#joint">bestelter</unclear> <unclear cert="medium" resp="#joint">Obrister</unclear>, auch deß <unclear cert="medium" resp="#joint">Lobl</unclear>: <unclear cert="medium" resp="#joint">Schwebi</unclear>-
