<lb n="25"/>da die Herren noch nit <unclear cert="medium" resp="#joint">häbig</unclear>.) nach <unclear cert="medium" resp="#joint">andere</unclear>
<lb n="26"/>in <unclear cert="medium" resp="#joint">particulari</unclear>, nach ihrem <unclear cert="medium" resp="#joint">begeren</unclear>, <unclear cert="medium" resp="#joint">zueverschreibn</unclear>
<pb facs="StadtASG_Missive_3230_12782.jpg" n="2"/>
<lb n="27"/><unclear cert="medium" resp="#joint">erbiettig</unclear>, solche <unclear cert="medium" resp="#joint">summa</unclear> <unclear cert="medium" resp="#joint">sambt</unclear> <unclear cert="medium" resp="#joint">gebuerenden</unclear>
<lb n="28"/>interesse, <unclear cert="medium" resp="#joint">inner</unclear> einer <unclear cert="medium" resp="#joint">benambten</unclear> zeit, <unclear cert="medium" resp="#joint">oder</unclear> <unclear cert="medium" resp="#joint">uf</unclear>
<lb n="29"/>etlich jahr, nach <unclear cert="medium" resp="#joint">dero</unclear> <unclear cert="medium" resp="#joint">belieben</unclear>, <unclear cert="medium" resp="#joint">widerumb</unclear> <unclear cert="medium" resp="#joint">danckh=</unclear>
<lb n="30"/><unclear cert="medium" resp="#joint">barlich</unclear> <unclear cert="medium" resp="#joint">zuerstatten</unclear>, zum <unclear cert="medium" resp="#joint">höchsten</unclear> <unclear cert="medium" resp="#joint">bittendte</unclear>, in
<lb n="31"/><unclear cert="medium" resp="#joint">diser</unclear> <unclear cert="medium" resp="#joint">unnser</unclear> <unclear cert="medium" resp="#joint">eüsserster</unclear> <unclear cert="medium" resp="#joint">abtringender</unclear> <unclear cert="medium" resp="#joint">noth</unclear>,
<lb n="32"/>umb <unclear cert="medium" resp="#joint">verhuettung</unclear> <unclear cert="medium" resp="#joint">unnsers</unclear> grossen <unclear cert="medium" resp="#joint">unheils</unclear>,
<lb n="33"/><unclear cert="medium" resp="#joint">unnß</unclear> nit <unclear cert="medium" resp="#joint">zuelassen</unclear>, sonder <unclear cert="medium" resp="#joint">hierzue</unclear> bey gemeiner
<lb n="34"/><unclear cert="medium" resp="#joint">dero</unclear> Statt, <unclear cert="medium" resp="#joint">Hospital</unclear>, oder <unclear cert="medium" resp="#joint">wo</unclear> es <unclear cert="low" resp="#joint">gesein</unclear> <unclear cert="low" resp="#joint">khan</unclear>,
<lb n="35"/><unclear cert="low" resp="#joint">verhülfflich</unclear> <unclear cert="low" resp="#joint">zuererscheinen</unclear>, solche unnß erzeig=
<lb n="36"/><unclear cert="medium" resp="#joint">endte</unclear> grosse gunst unnd <unclear cert="medium" resp="#joint">freündtschafft</unclear>, <unclear cert="medium" resp="#joint">wollen</unclear>
<lb n="37"/><unclear cert="medium" resp="#joint">wir</unclear>, uff alle <unclear cert="medium" resp="#joint">begebenheit</unclear>, <unclear cert="medium" resp="#joint">zuerwiderigen</unclear>,
<lb n="38"/>unnd zuverdienen <unclear cert="medium" resp="#joint">eüsserst</unclear> <unclear cert="medium" resp="#joint">vermögens</unclear> <unclear cert="medium" resp="#joint">unnß</unclear>
<lb n="39"/><unclear cert="medium" resp="#joint">befleissen</unclear>, <unclear cert="medium" resp="#joint">wie</unclear> die Herren von <unclear cert="medium" resp="#joint">unnserm</unclear> mit=
<lb n="40"/><unclear cert="medium" resp="#joint">burgern</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Johanz</unclear> <unclear cert="medium" resp="#joint">Stadler</unclear></persName>, <unclear cert="medium" resp="#joint">welchen</unclear> <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">hiemit</unclear>,
<lb n="41"/><unclear cert="medium" resp="#joint">wo</unclear> <unclear cert="medium" resp="#joint">nimmer</unclear> <unclear cert="medium" resp="#joint">müglich</unclear>, <unclear cert="medium" resp="#joint">hierumen</unclear>: oder auch <unclear cert="medium" resp="#joint">umb</unclear>
<lb n="42"/>ein <unclear cert="medium" resp="#joint">mehrers</unclear> <unclear cert="medium" resp="#joint">sich</unclear> <unclear cert="medium" resp="#joint">zuebewerben</unclear>, bevollmächtigt,
<lb n="43"/>mit <unclear cert="medium" resp="#joint">mehrerm</unclear> <unclear cert="medium" resp="#joint">vernehmen</unclear> sich wollen belieben
<lb n="44"/><unclear cert="medium" resp="#joint">lassen</unclear>, der <unclear cert="medium" resp="#joint">getrösten</unclear> hoffnung <unclear cert="medium" resp="#joint">gelebendte</unclear>, die
<lb n="45"/>Herren <unclear cert="medium" resp="#joint">unnß</unclear> hiermit nit lassen, <unclear cert="medium" resp="#joint">weillen</unclear> <unclear cert="medium" resp="#joint">unnß</unclear>
<lb n="46"/>unnd gemeiner <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">burgerschafft</unclear> ihr wohl
<lb n="47"/><unclear cert="low" resp="#joint">daran</unclear> <unclear cert="low" resp="#joint">gelegen</unclear>, <unclear cert="low" resp="#joint">dem</unclear> <unclear cert="low" resp="#joint">lieben</unclear> <unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">unnß</unclear> <unclear cert="low" resp="#joint">damit</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">sambtlich</unclear> <unclear cert="low" resp="#joint">wohl</unclear> <unclear cert="low" resp="#joint">befehlendte</unclear>. Datum <date resp="#ner"><unclear cert="low" resp="#joint">den</unclear> .<unclear cert="low" resp="#joint">18.ten</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">Maij</unclear>, anno .1634.</date>
<lb n="50"/><orgName ref="stadtasg-actors-58" cert="medium" role="issuer" resp="#ner">Burgermeister unnd
<lb n="51"/>Rath <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">Rhavenspurg</unclear></orgName>.
<pb facs="StadtASG_Missive_3230_12783.jpg" n="3"/>
<lb n="52"/>P. S.
<lb n="53"/>Insonders gl. liebe herren. Wiewoln
<lb n="54"/>daß schriben auf <persName resp="#ner">Johann Marckhen</persName> gestelt, und
<lb n="55"/>er darmit abgeferttiget werden sollen.
<lb n="56"/>So ist aber sein liebe haußfraw erst ihrer
<lb n="57"/>leibs buerde erlediget, und nit zum besten
<lb n="58"/>auf, dahero wir ihne auf sein einge-
<lb n="59"/>wendte starckhe entschuldigung, nit wol
<lb n="60"/>fortschickhen khönnen, sonderen zaigern diß
<lb n="61"/>aigens oblauffenden potten abferttigen wollen,
<lb n="62"/>unnß gegen ihnen verthraestende, sye werden
<lb n="63"/>unnß deß halcher auf etlich wenig holtz
<lb n="64"/>gegen gnuegsamer versicherung, zue
<lb n="65"/>unserer obhabenden thruengenen starckhen
<lb n="66"/>außgab, nachparlichen willfahren. So wir,
<lb n="67"/>neben schuldiger erstattung, umb die herren
<lb n="68"/>unnd ihre angehoerige anderwertths wider
<lb n="69"/>zuebeschulden erbiethig. Actum ut in litteris.
