<p>
<pb facs="StadtASG_Missive_3230_12781.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unßern</unclear> grueß und genaigten willen, zuvor,
<lb n="2"/>Edle, Gestrenge, Veste, Ehrenveste, <unclear cert="medium" resp="#joint">Für</unclear>-
<lb n="3"/><unclear cert="medium" resp="#joint">sichtige</unclear>, <unclear cert="medium" resp="#joint">Ehrsamb</unclear>, <unclear cert="medium" resp="#joint">Weyße</unclear> unnd <unclear cert="medium" resp="#joint">Frombe</unclear>, <unclear cert="medium" resp="#joint">Inßonders</unclear>
<lb n="4"/>liebe Herren unnd guete <unclear cert="low" resp="#joint">Freundt</unclear>.
<lb n="5"/><unclear cert="low" resp="#joint">Denselben</unclear> ist <unclear cert="low" resp="#joint">unverborgen</unclear>, waß daß <unclear cert="medium" resp="#joint">lang</unclear>-
<lb n="6"/><unclear cert="medium" resp="#joint">wehrendte</unclear> <unclear cert="medium" resp="#joint">kriegß</unclear> <unclear cert="medium" resp="#joint">weßen</unclear> für <unclear cert="medium" resp="#joint">ungelegenheitn</unclear>
<lb n="7"/><unclear cert="medium" resp="#joint">im</unclear> <unclear cert="medium" resp="#joint">Roem</unclear>: <orgName ref="stadtasg-actors-559" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Reich</unclear></orgName> <unclear cert="medium" resp="#joint">verurßacht</unclear>, unnd <unclear cert="low" resp="#joint">wie</unclear> <unclear cert="low" resp="#joint">fast</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">menigclich</unclear> <unclear cert="low" resp="#joint">erschöpft</unclear>, unnd <unclear cert="medium" resp="#joint">erarmbt</unclear> <unclear cert="medium" resp="#joint">wordn</unclear>,
<lb n="9"/><unclear cert="medium" resp="#joint">khönen</unclear>, <unclear cert="medium" resp="#joint">wann</unclear> <unclear cert="medium" resp="#joint">nuhr</unclear> die <unclear cert="medium" resp="#joint">itzo</unclear> <unclear cert="medium" resp="#joint">obschwebendte</unclear>
<lb n="10"/><unclear cert="medium" resp="#joint">starckhe</unclear> <unclear cert="medium" resp="#joint">Einquartierung</unclear>, <unclear cert="medium" resp="#joint">unß</unclear> mehr <unclear cert="medium" resp="#joint">alß</unclear>
<lb n="11"/>vil <unclear cert="medium" resp="#joint">khostet</unclear>, unnd die soldaten umb <unclear cert="medium" resp="#joint">ihren</unclear> <unclear cert="medium" resp="#joint">auß</unclear>-
