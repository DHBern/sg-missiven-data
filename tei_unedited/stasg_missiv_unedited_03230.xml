<lb n="13"/><unclear cert="medium" resp="#joint">stendig</unclear> und <unclear cert="medium" resp="#joint">inportune</unclear>, mit <unclear cert="low" resp="#joint">starckhn</unclear> <unclear cert="low" resp="#joint">betrohungn</unclear>,
<lb n="14"/><unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">selbsten</unclear> bezalt <unclear cert="low" resp="#joint">zuemachn</unclear>, <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">tringen</unclear>,
<lb n="15"/>haben wir <unclear cert="medium" resp="#joint">auß</unclear> <unclear cert="medium" resp="#joint">unßm</unclear> <unclear cert="medium" resp="#joint">obligendtn</unclear> <unclear cert="medium" resp="#joint">notfalltn</unclear>,
<lb n="16"/>unnd damit die gemaine <unclear cert="medium" resp="#joint">burgerschaft</unclear> nit
<lb n="17"/><unclear cert="low" resp="#joint">gar</unclear> ruinirt <unclear cert="medium" resp="#joint">oder</unclear> <unclear cert="medium" resp="#joint">beängstiget</unclear> <unclear cert="medium" resp="#joint">werdte</unclear>, <unclear cert="medium" resp="#joint">die</unclear>
<lb n="18"/>Herren <unclear cert="medium" resp="#joint">alß</unclear> <unclear cert="medium" resp="#joint">zue</unclear> <unclear cert="medium" resp="#joint">ihnen</unclear> <unclear cert="medium" resp="#joint">gestelten</unclear> gueten <unclear cert="medium" resp="#joint">vertrewen</unclear>,
<lb n="19"/>umb <unclear cert="medium" resp="#joint">ain</unclear> <unclear cert="medium" resp="#joint">dahrlehn</unclear> uff. 5: <unclear cert="medium" resp="#joint">in</unclear>. 6000 <unclear cert="low" resp="#joint">fl</unclear>. <unclear cert="low" resp="#joint">ahnzuesuechn</unclear>,
<lb n="20"/>unnd <unclear cert="medium" resp="#joint">zuebiten</unclear> khainen <unclear cert="medium" resp="#joint">umbgang</unclear> nehmen khönn,
<lb n="21"/>dargegen sein wir <unclear cert="medium" resp="#joint">dieselbe</unclear>, nit <unclear cert="medium" resp="#joint">allain</unclear> <unclear cert="medium" resp="#joint">auf</unclear> ge-
<lb n="22"/><unclear cert="medium" resp="#joint">mainer</unclear> <unclear cert="medium" resp="#joint">unßrer</unclear> <unclear cert="medium" resp="#joint">Statt</unclear> <unclear cert="medium" resp="#joint">güedter</unclear> <unclear cert="medium" resp="#joint">zueversichern</unclear>,
<lb n="23"/>sondern auch wir die <unclear cert="medium" resp="#joint">burgermaister</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Joachim</unclear>
