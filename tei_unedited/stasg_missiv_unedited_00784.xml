<lb n="7"/>er das <unclear cert="medium" resp="#joint">guet</unclear> <unclear cert="medium" resp="#joint">rindflaisch</unclear> ain <unclear cert="medium" resp="#joint">pfund</unclear> des schwaeren <unclear cert="low" resp="#joint">gwichts</unclear>,
<lb n="8"/>da <unclear cert="medium" resp="#joint">sechtzig</unclear> <unclear cert="medium" resp="#joint">lot</unclear> ain <unclear cert="medium" resp="#joint">pfund</unclear> <unclear cert="medium" resp="#joint">gelten</unclear>, <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">funff</unclear> pfening und
<lb n="9"/>das <unclear cert="low" resp="#joint">kue</unclear>- und <unclear cert="low" resp="#joint">kalbellen</unclear> <unclear cert="low" resp="#joint">flaisch</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">nuen</unclear> haller unnd
<lb n="10"/>das <unclear cert="low" resp="#joint">bratflaisch</unclear> ouch <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="medium" resp="#joint">nuen</unclear> <unclear cert="medium" resp="#joint">haller</unclear>, <unclear cert="medium" resp="#joint">alles</unclear> <unclear cert="medium" resp="#joint">unßer</unclear> <unclear cert="medium" resp="#joint">wer</unclear>-
