<lb n="36"/><unclear cert="low" resp="#joint">ani</unclear> <unclear cert="low" resp="#joint">vorthail</unclear> mit <unclear cert="low" resp="#joint">leugg</unclear> und <unclear cert="low" resp="#joint">loewen</unclear> <unclear cert="low" resp="#joint">leewin</unclear> <unclear cert="low" resp="#joint">khouff</unclear>
