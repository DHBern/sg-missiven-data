<lb n="17"/>er <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">fleisch</unclear> <unclear cert="low" resp="#joint">und</unclear> in der <unclear cert="low" resp="#joint">mezge</unclear> <unclear cert="low" resp="#joint">erloest</unclear> (
