<lb n="11"/>wie <unclear cert="medium" resp="#joint">vor</unclear> disem nicht mehr <unclear cert="medium" resp="#joint">bekommen</unclear> <unclear cert="medium" resp="#joint">koenne</unclear>, und
<lb n="12"/>sein <unclear cert="medium" resp="#joint">kuechl</unclear> <unclear cert="medium" resp="#joint">hauß</unclear> <unclear cert="medium" resp="#joint">stillen</unclear> <unclear cert="medium" resp="#joint">weisen</unclear> diß, <unclear cert="low" resp="#joint">alß</unclear> <unclear cert="low" resp="#joint">er</unclear> <unclear cert="low" resp="#joint">jueng</unclear>-
