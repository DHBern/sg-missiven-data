<lb n="26"/>Und <unclear cert="low" resp="#joint">obwol</unclear> wir, <unclear cert="low" resp="#joint">demnach</unclear> auf <unclear cert="low" resp="#joint">sein</unclear> <unclear cert="low" resp="#joint">instendiges</unclear>
<lb n="27"/>bitten, gegen <unclear cert="medium" resp="#joint">ermelten</unclear> <unclear cert="medium" resp="#joint">herrn</unclear> vogt <unclear cert="low" resp="#joint">zue</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Wangen</unclear></placeName>
