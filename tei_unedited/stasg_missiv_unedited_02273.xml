<lb n="5"/><unclear cert="medium" resp="#joint">gueten</unclear> <unclear cert="medium" resp="#joint">Freünd</unclear> und <unclear cert="medium" resp="#joint">getreüwe</unclear> liebe Eydtgnossen.
<lb n="6"/>Es hat <unclear cert="medium" resp="#joint">uns</unclear>, unser <unclear cert="medium" resp="#joint">getreuwer</unclear> lieber <unclear cert="medium" resp="#joint">mitburger</unclear>
<lb n="7"/><persName resp="#ner"><unclear cert="medium" resp="#joint">Lonard</unclear> <unclear cert="medium" resp="#joint">Kromer</unclear></persName> der <unclear cert="medium" resp="#joint">mezger</unclear> <unclear cert="medium" resp="#joint">gehorsamlich</unclear> <unclear cert="medium" resp="#joint">brichtet</unclear>.
