<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">Friderich</unclear> Schobinger</persName>, <unclear cert="medium" resp="#joint">luth</unclear> <unclear cert="medium" resp="#joint">syner</unclear> obligation, unns=
