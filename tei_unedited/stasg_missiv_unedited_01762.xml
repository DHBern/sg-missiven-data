<lb n="3"/><unclear cert="medium" resp="#joint">ig</unclear>, <unclear cert="low" resp="#joint">ersam</unclear>, wyß, <unclear cert="low" resp="#joint">insonnders</unclear> guot fründt, unnd ge=
<lb n="4"/><unclear cert="low" resp="#joint">trüw</unclear> lieb eidtgnossen. Nachdem wir <unclear cert="medium" resp="#joint">üwer</unclear>
<lb n="5"/>schryben vom <date resp="#ner"><unclear cert="low" resp="#joint">19</unclear>. <unclear cert="low" resp="#joint">t</unclear> <unclear cert="low" resp="#joint">Martii</unclear> nechst</date> <unclear cert="low" resp="#joint">verschinnen</unclear>,
