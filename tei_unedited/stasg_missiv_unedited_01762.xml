<p>
<pb facs="StadtASG_Missive_1762_6503.jpg" n="1"/>
<lb n="1"/>Unnser fründtlich willig <unclear cert="medium" resp="#joint">dinst</unclear>, <unclear cert="medium" resp="#joint">unnd</unclear> was wir <unclear cert="medium" resp="#joint">ehren</unclear>,
<lb n="2"/>liebs <unclear cert="medium" resp="#joint">unnd</unclear> guots vermögend, zuovor, <unclear cert="low" resp="#joint">from</unclear>, fürsicht=
<lb n="3"/>ig, <unclear cert="low" resp="#joint">ersam</unclear>, wyß, <unclear cert="low" resp="#joint">insonnders</unclear> guot fründt, unnd ge=
<lb n="4"/><unclear cert="low" resp="#joint">trüw</unclear> lieb eidtgnossen. Nachdem wir <unclear cert="low" resp="#joint">üwer</unclear>
<lb n="5"/>schryben vom <date resp="#ner"><unclear cert="low" resp="#joint">19</unclear>. <unclear cert="low" resp="#joint">t</unclear> <unclear cert="low" resp="#joint">Martii</unclear> nechst</date> <unclear cert="low" resp="#joint">verschinnen</unclear>,
<lb n="6"/><unclear cert="low" resp="#joint">belanngend</unclear> die jhenige <unclear cert="low" resp="#joint">summ</unclear> <unclear cert="low" resp="#joint">gelts</unclear>, so <unclear cert="low" resp="#joint">üwer</unclear> burger
<lb n="7"/><persName resp="#ner"><unclear cert="low" resp="#joint">Friderich</unclear> Schobinger</persName>, luth syner obligation, <unclear cert="medium" resp="#joint">unns=</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">erm</unclear> burger <persName resp="#ner">Hans Ludwigen <unclear cert="low" resp="#joint">Schwertzenbach</unclear></persName> schuld=
<lb n="9"/>ig ist, unnd inn <unclear cert="low" resp="#joint">üwer</unclear> canntzly erlegt hatt,
<lb n="10"/>und <unclear cert="medium" resp="#joint">den</unclear> arrest, so <unclear cert="medium" resp="#joint">bemelts</unclear> <placeName ref="stadtasg-places-374" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schwertzenbachs</unclear></placeName> abge=
<lb n="11"/>scheiden <unclear cert="low" resp="#joint">ehewyb</unclear>, <unclear cert="low" resp="#joint">frauw</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Rebecca</unclear> <unclear cert="low" resp="#joint">Zollikofernin</unclear></persName>,
<lb n="12"/>wie <unclear cert="low" resp="#joint">auch</unclear> <unclear cert="low" resp="#joint">üwer</unclear> burger <persName resp="#ner"><unclear cert="medium" resp="#joint">Ambrosi</unclear> <unclear cert="low" resp="#joint">Hiller</unclear></persName>, von
<lb n="13"/>wegen <unclear cert="low" resp="#joint">ihrer</unclear> an den <placeName ref="stadtasg-places-374" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schwertzenbach</unclear></placeName> habenden
<lb n="14"/>ansprachen, <unclear cert="low" resp="#joint">by</unclear> üch an <unclear cert="low" resp="#joint">söllich</unclear> gelt erlangt
<lb n="15"/>habent, deß <unclear cert="medium" resp="#joint">gnanndten</unclear> <unclear cert="medium" resp="#joint">Schwertzenbachs</unclear>
<lb n="16"/><unclear cert="medium" resp="#joint">guotsvogt</unclear> und <unclear cert="low" resp="#joint">verwanndten</unclear>, <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">disrem</unclear> <unclear cert="low" resp="#joint">über=</unclear>
<lb n="17"/><unclear cert="low" resp="#joint">geben</unclear> <unclear cert="low" resp="#joint">laßen</unclear>, <unclear cert="low" resp="#joint">darüber</unclear> die <unclear cert="medium" resp="#joint">wytere</unclear> <unclear cert="medium" resp="#joint">gebür</unclear> unnd
<lb n="18"/><unclear cert="low" resp="#joint">ihr</unclear> <unclear cert="low" resp="#joint">nothurfft</unclear> <unclear cert="low" resp="#joint">fürzuonemmen</unclear>. Habent
<lb n="19"/>uff hütt <unclear cert="medium" resp="#joint">unnsere</unclear> lieben <unclear cert="medium" resp="#joint">burgere</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Ruodolf</unclear> <unclear cert="medium" resp="#joint">Schuchtz=</unclear></persName>
<lb n="20"/>er, <unclear cert="medium" resp="#joint">als</unclear> <unclear cert="medium" resp="#joint">jetziger</unclear> deß <placeName ref="stadtasg-places-374" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Schwertzenbachs</unclear></placeName> <unclear cert="low" resp="#joint">guotsvogt</unclear>,
<lb n="21"/><unclear cert="low" resp="#joint">unnd</unclear> <persName resp="#ner">Hans Heinrich <unclear cert="low" resp="#joint">Schwertzenbach</unclear></persName> desselben
<lb n="22"/><unclear cert="low" resp="#joint">bruoder</unclear>, unns berichtet, wie sy umb diser sach
<lb n="23"/>willen, zuo üch <unclear cert="low" resp="#joint">zerrysen</unclear> gesinnet sygind, <unclear cert="medium" resp="#joint">unnd</unclear>
<lb n="24"/>unns darby umb ein fürschryben an üch <unclear cert="low" resp="#joint">gebätt=</unclear>
<lb n="25"/>en, damit die jhenige durch den <persName resp="#ner">Schobing=</persName>
<lb n="26"/>er inn <unclear cert="low" resp="#joint">üwer</unclear> canntzly gelegte <unclear cert="low" resp="#joint">summa</unclear> <unclear cert="low" resp="#joint">gelts</unclear>, al=
<lb n="27"/><unclear cert="low" resp="#joint">her</unclear> zuo <unclear cert="low" resp="#joint">unnsern</unclear> ald <unclear cert="low" resp="#joint">ihren</unclear> <unclear cert="medium" resp="#joint">hannden</unclear> <unclear cert="low" resp="#joint">geliferet</unclear>
<lb n="28"/>werden möchte, <unclear cert="low" resp="#joint">welliches</unclear> (<unclear cert="low" resp="#joint">ihrs</unclear> erachtens)
<lb n="29"/>sich gebüren, und üch, als sy verhoffind, nit
<lb n="30"/><unclear cert="low" resp="#joint">zuowider</unclear> <unclear cert="medium" resp="#joint">syn</unclear> werde, diewyl gedachter
<pb facs="StadtASG_Missive_1762_6504.jpg" n="2"/>
<lb n="31"/><persName resp="#ner"><unclear cert="low" resp="#joint">Hans</unclear> Ludwig <unclear cert="low" resp="#joint">Schwartzenbach</unclear></persName>, <unclear cert="low" resp="#joint">unsern</unclear> burger,
<lb n="32"/><unclear cert="low" resp="#joint">soeliche</unclear> <unclear cert="low" resp="#joint">abgloeste</unclear> summa gelts, <unclear cert="low" resp="#joint">sÿn</unclear> guot. Auch
<lb n="33"/>der <unclear cert="medium" resp="#joint">hÿrat</unclear> zwüschent ime und der <unclear cert="low" resp="#joint">genanten</unclear>
<lb n="34"/>fraw <persName resp="#ner"><unclear cert="low" resp="#joint">Zollickhoferin</unclear></persName>, <unclear cert="low" resp="#joint">sÿner</unclear> <unclear cert="low" resp="#joint">glÿch</unclear> wol <unclear cert="low" resp="#joint">abgescheid=</unclear>
<lb n="35"/>nen <unclear cert="low" resp="#joint">eefrawen</unclear>, <unclear cert="medium" resp="#joint">vor</unclear> wellichem <unclear cert="medium" resp="#joint">ir</unclear> der frawen=
<lb n="36"/><unclear cert="medium" resp="#joint">er</unclear> <unclear cert="medium" resp="#joint">fürnemste</unclear> ansprach zuo <unclear cert="medium" resp="#joint">sÿnem</unclear> <unclear cert="medium" resp="#joint">guot</unclear>, <unclear cert="medium" resp="#joint">herreicht</unclear>,
<lb n="37"/>nach der statt <placeName ref="stadtasg-places-32" cert="medium" resp="#ner">Zürich</placeName> recht <unclear cert="low" resp="#joint">uffgerichtet</unclear>. Und
<lb n="38"/>die sachen <unclear cert="low" resp="#joint">sÿn</unclear> deß bemeldten <persName resp="#ner"><unclear cert="medium" resp="#joint">Schwartzenbachs</unclear></persName> hab
<lb n="39"/>und <unclear cert="medium" resp="#joint">guot</unclear>, <unclear cert="medium" resp="#joint">schulden</unclear> und <unclear cert="medium" resp="#joint">widerschulden</unclear> belangendt,
<lb n="40"/>bißher <unclear cert="medium" resp="#joint">alles</unclear>, <unclear cert="medium" resp="#joint">siderhar</unclear> <unclear cert="medium" resp="#joint">sÿnem</unclear> abtritt, mehrentheils
<lb n="41"/>durch <unclear cert="low" resp="#joint">verordnete</unclear> uß <unclear cert="low" resp="#joint">unserm</unclear> <unclear cert="low" resp="#joint">rathsmittel</unclear>,
<lb n="42"/><unclear cert="low" resp="#joint">alhie</unclear> verhandlet worden, und umb die beschaff=
<lb n="43"/>enheit deß <unclear cert="low" resp="#joint">guots</unclear>, und aller sachen, bericht <unclear cert="low" resp="#joint">gegäben</unclear>
<lb n="44"/>werden <unclear cert="low" resp="#joint">khan</unclear>. Deß <persName resp="#ner"><unclear cert="low" resp="#joint">Schobingers</unclear></persName> obligation
<lb n="45"/>auch, durch <unclear cert="low" resp="#joint">dero</unclear> anlaß <unclear cert="low" resp="#joint">wir</unclear> in wüßend, und durch
<lb n="46"/><unclear cert="medium" resp="#joint">mitel</unclear> der <unclear cert="low" resp="#joint">daran</unclear> bezalten 400. fl. <unclear cert="low" resp="#joint">bÿ</unclear> üch behalt=
<lb n="47"/>en worden. So <unclear cert="low" resp="#joint">sÿgen</unclear> <unclear cert="low" resp="#joint">sÿ</unclear> deß anerbietens,
<lb n="48"/>menigklichem <unclear cert="medium" resp="#joint">den</unclear> <unclear cert="low" resp="#joint">deran</unclear> <unclear cert="low" resp="#joint">zesprächen</unclear>, <unclear cert="low" resp="#joint">guetlich</unclear> oder
<lb n="49"/>rechtlich bscheid <unclear cert="low" resp="#joint">zegäben</unclear>, und <unclear cert="medium" resp="#joint">alle</unclear> sachen nun
<lb n="50"/><unclear cert="medium" resp="#joint">mehr</unclear> <unclear cert="medium" resp="#joint">so</unclear> <unclear cert="medium" resp="#joint">ihne</unclear> <unclear cert="medium" resp="#joint">muoglich</unclear> nach gebür an ein ort
<lb n="51"/><unclear cert="low" resp="#joint">zemachen</unclear>.
<lb n="52"/>Und wann nun wir die <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">inn</unclear> allen
<lb n="53"/>zimblichen sachen <unclear cert="low" resp="#joint">zebefürderen</unclear> so geneigt als
<lb n="54"/>schuldig sind. So gelangt <unclear cert="low" resp="#joint">daruf</unclear>
<lb n="55"/>an üch, <unclear cert="medium" resp="#joint">unsere</unclear> <unclear cert="medium" resp="#joint">fründtliche</unclear> gesinnen, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">bitten</unclear>. Ir
<lb n="56"/>woellind <unclear cert="medium" resp="#joint">inn</unclear> <unclear cert="medium" resp="#joint">ansehen</unclear> der <unclear cert="low" resp="#joint">obangeregten</unclear> gründen
<lb n="57"/>und ursachen, den genannten <unclear cert="low" resp="#joint">unseren</unclear> burg=
<lb n="58"/><unclear cert="low" resp="#joint">eren</unclear> <unclear cert="low" resp="#joint">bewÿseren</unclear> <unclear cert="low" resp="#joint">diß</unclear>, <unclear cert="low" resp="#joint">inn</unclear> <unclear cert="low" resp="#joint">ihrem</unclear> <unclear cert="low" resp="#joint">begeren</unclear>
<lb n="59"/>fründtlich willfahren, und üch <unclear cert="low" resp="#joint">inn</unclear> sachen also
<lb n="60"/>erzeigen. <unclear cert="medium" resp="#joint">Das</unclear> <unclear cert="medium" resp="#joint">sÿ</unclear> <unclear cert="medium" resp="#joint">unserer</unclear> <unclear cert="medium" resp="#joint">fürschrifft</unclear> <unclear cert="medium" resp="#joint">gnoßen</unclear>
<pb facs="StadtASG_Missive_1762_6505.jpg" n="3"/>
<lb n="61"/>haben <unclear cert="low" resp="#joint">chümmen</unclear> <unclear cert="low" resp="#joint">mögind</unclear>. Sind wir deß <unclear cert="low" resp="#joint">anerbiet</unclear>-
<lb n="62"/>ens, der gemeldten <unclear cert="low" resp="#joint">frauwen</unclear> <unclear cert="low" resp="#joint">Zolligkhoferin</unclear>, auch
<lb n="63"/><unclear cert="low" resp="#joint">dem</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Hiller</unclear></persName> und <unclear cert="low" resp="#joint">menigklichem</unclear> der an diß, und
<lb n="64"/><unclear cert="medium" resp="#joint">ander</unclear> bemelts <unclear cert="medium" resp="#joint">unßers</unclear> burgers deß <placeName ref="stadtasg-places-374" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Schwartzen</unclear>-
<lb n="65"/><unclear cert="medium" resp="#joint">nbachs</unclear></placeName> hab und gut ansprach hatt, <unclear cert="low" resp="#joint">gebürlichs</unclear>
<lb n="66"/>und gut <unclear cert="low" resp="#joint">fürderlich</unclear> recht zehalten und <unclear cert="low" resp="#joint">ergahn</unclear>
<lb n="67"/><unclear cert="low" resp="#joint">zelaßen</unclear>. <unclear cert="low" resp="#joint">Deßen</unclear> <unclear cert="low" resp="#joint">habent</unclear> wir
<lb n="68"/>üch uff <unclear cert="low" resp="#joint">vorangezogen</unclear> <unclear cert="low" resp="#joint">üwer</unclear> schryben, und deß
<lb n="69"/><unclear cert="low" resp="#joint">Schwartzenbachischen</unclear> guts vogts und ver-
<lb n="70"/><unclear cert="low" resp="#joint">wandten</unclear> bitt berichten <unclear cert="low" resp="#joint">wellen</unclear>. Und
<lb n="71"/>nach <unclear cert="low" resp="#joint">anerbietung</unclear> aller <orgName resp="#ner"><unclear cert="medium" resp="#joint">Eidtgnößischen</unclear></orgName> <unclear cert="medium" resp="#joint">trüw</unclear>
<lb n="72"/>und fründtschafft, thund wir üch dem <unclear cert="low" resp="#joint">Goett</unclear>-
<lb n="73"/>lichen schirm wol <unclear cert="low" resp="#joint">beuelchen</unclear>. Datum
<lb n="74"/><origDate when="1612-04-25" resp="#ner">den <unclear cert="low" resp="#joint">25</unclear> <unclear cert="low" resp="#joint">ten</unclear> Aprilis anno 1612</origDate>.
<lb n="75"/><orgName ref="stadtasg-actors-503" cert="medium" role="issuer" resp="#ner">Burgermeister und Rath
<lb n="76"/>der statt Zürich</orgName>.
<pb facs="StadtASG_Missive_1762_6506.jpg" n="4"/>
<lb n="77"/>Den <unclear cert="medium" resp="#joint">Fromen</unclear> <unclear cert="medium" resp="#joint">Fuersichtigen</unclear>, <unclear cert="low" resp="#joint">Eersamen</unclear>
<lb n="78"/>Weysen, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Buergermeister</unclear> und Rath
<lb n="79"/>der Statt Sanct Gallen</orgName>, <unclear cert="low" resp="#joint">unnseren</unclear>
