<lb n="5"/>und <unclear cert="low" resp="#joint">getrüwe</unclear> <unclear cert="medium" resp="#joint">liebe</unclear> <unclear cert="low" resp="#joint">Eydtgnossen</unclear>.
<lb n="6"/><unclear cert="low" resp="#joint">Was</unclear> <unclear cert="low" resp="#joint">Ihr</unclear> an uns wegen <unclear cert="medium" resp="#joint">üwers</unclear> bestellten
