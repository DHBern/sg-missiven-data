<lb n="8"/><unclear cert="low" resp="#joint">Hünlis</unclear></persName> von <placeName ref="stadtasg-places-133" cert="medium" resp="#ner">Basel</placeName> nicht <unclear cert="low" resp="#joint">allein</unclear> <unclear cert="medium" resp="#joint">zuge</unclear>-
