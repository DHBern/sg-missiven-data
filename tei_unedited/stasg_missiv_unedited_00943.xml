<lb n="71"/>Denn <unclear cert="low" resp="#joint">erbarnn</unclear> <unclear cert="low" resp="#joint">fuersichtigenn</unclear> unnd <unclear cert="medium" resp="#joint">wolweysenn</unclear> N.
