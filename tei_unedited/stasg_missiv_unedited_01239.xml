<p>
<pb facs="StadtASG_Missive_1239_4129.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">früntlich</unclear> willig <unclear cert="medium" resp="#joint">dienst</unclear>, sampt was wir
<lb n="2"/><unclear cert="low" resp="#joint">eeren</unclear>, liebs, <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">guets</unclear> vermögend zuvor
<lb n="3"/><unclear cert="medium" resp="#joint">from</unclear>, fürsichtig, ersam wyß, <unclear cert="low" resp="#joint">insonnders</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">frünnd</unclear>, unnd <unclear cert="medium" resp="#joint">getrüw</unclear> lieb <unclear cert="low" resp="#joint">Eidtgnossen</unclear>,
<lb n="5"/><unclear cert="low" resp="#joint">unns</unclear> sind nun etliche zyt dahär vilfaltige
<lb n="6"/>warnungen zuekhommen, kriegscher anschleg.
<lb n="7"/>unnd <unclear cert="low" resp="#joint">fürnemen</unclear> halb, <unclear cert="low" resp="#joint">über</unclear>, und <unclear cert="medium" resp="#joint">gegen</unclear> <unclear cert="medium" resp="#joint">etliche</unclear>
<lb n="8"/><unclear cert="medium" resp="#joint">unnserer</unclear> schloß. und <unclear cert="medium" resp="#joint">fleckenn</unclear> deß <placeName resp="#ner"><unclear cert="medium" resp="#joint">Welschnen</unclear>
<lb n="9"/>landts</placeName>, <unclear cert="medium" resp="#joint">wölches</unclear> <unclear cert="medium" resp="#joint">unns</unclear> <unclear cert="medium" resp="#joint">glychwohl</unclear> vil <unclear cert="low" resp="#joint">naehen</unclear>-
<lb n="10"/><unclear cert="low" resp="#joint">denckens</unclear>, aber doch nit sovil <unclear cert="low" resp="#joint">bewegt</unclear>, unnd
<lb n="11"/>gebracht, ettwas <unclear cert="low" resp="#joint">gwüßes</unclear> <unclear cert="low" resp="#joint">daruf</unclear> <unclear cert="low" resp="#joint">zesetzen</unclear>,
<lb n="12"/>ein <unclear cert="low" resp="#joint">volnstreckung</unclear> derselben zebefaren, noch
<lb n="13"/>inn <unclear cert="low" resp="#joint">söllches</unclear> <unclear cert="low" resp="#joint">misthrauen</unclear> <unclear cert="low" resp="#joint">zekhomen</unclear>. <unclear cert="low" resp="#joint">das</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">jemandts</unclear> (daß <unclear cert="low" resp="#joint">wir</unclear> deß <unclear cert="low" resp="#joint">dhain</unclear> anlaß, noch
<lb n="15"/>ursach <unclear cert="medium" resp="#joint">gebenn</unclear>.) <unclear cert="medium" resp="#joint">willens</unclear>, hette uns <unclear cert="medium" resp="#joint">zeüber</unclear>-
<lb n="16"/>fallenn. diewyl sich aber <unclear cert="low" resp="#joint">under</unclear> söllichen
<lb n="17"/>lümden zuetregt. das diser zyt <unclear cert="medium" resp="#joint">abermalen</unclear>
<lb n="18"/><unclear cert="low" resp="#joint">kriegsvolck</unclear> <unclear cert="low" resp="#joint">vß</unclear> <placeName ref="stadtasg-places-372" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Piemondt</unclear></placeName>, unnd <placeName ref="stadtasg-places-437" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Saphoy</unclear></placeName>, an
<lb n="19"/>die frontiern unnserer landen <unclear cert="low" resp="#joint">zücht</unclear>, unnd
<lb n="20"/>inn <unclear cert="low" resp="#joint">ettliche</unclear> <unclear cert="low" resp="#joint">fleckenn</unclear> den <unclear cert="low" resp="#joint">unsren</unclear> <unclear cert="low" resp="#joint">wolbekant</unclear>
<lb n="21"/><unclear cert="low" resp="#joint">ettwas</unclear> <unclear cert="low" resp="#joint">starcke</unclear> <unclear cert="low" resp="#joint">bsatzungen</unclear> <unclear cert="low" resp="#joint">gelegt</unclear> <unclear cert="medium" resp="#joint">werden</unclear>,
<lb n="22"/><unclear cert="low" resp="#joint">muessend</unclear> wir abnemen, und gedencken,
<lb n="23"/>das nit <unclear cert="medium" resp="#joint">jederman</unclear> <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">genaigt</unclear>, und dahär
<lb n="24"/>nit vil <unclear cert="low" resp="#joint">gunsts</unclear>, noch <unclear cert="medium" resp="#joint">gueten</unclear> willens zeverseh.
<lb n="25"/>sind doch nit gsinnet, deßwegen <unclear cert="low" resp="#joint">einiche</unclear>
<lb n="26"/>erhebung <unclear cert="low" resp="#joint">fürzenemen</unclear>, noch <unclear cert="low" resp="#joint">jemandts</unclear> <unclear cert="low" resp="#joint">vy</unclear>-
<lb n="27"/><unclear cert="low" resp="#joint">endtschafft</unclear>, oder laidts zebewysen, die
<lb n="28"/><unclear cert="low" resp="#joint">fürsorg</unclear> aber, <unclear cert="medium" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">gheiß</unclear>, so wir <unclear cert="low" resp="#joint">zu</unclear> <unclear cert="low" resp="#joint">unnseren</unclear>
<lb n="29"/><unclear cert="low" resp="#joint">landen</unclear> und <unclear cert="low" resp="#joint">underthanen</unclear> (<unclear cert="low" resp="#joint">wölche</unclear> ewer
<lb n="30"/>der nüw lieb Eidtgnossen, darein eir selbst,
<lb n="31"/>unns zuegesprochen habendt.) tragend. trengt.
<lb n="32"/>unnd <unclear cert="low" resp="#joint">bewegt</unclear> <unclear cert="low" resp="#joint">unns</unclear>, <unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">flecken</unclear>.
<lb n="33"/>mit einer <unclear cert="medium" resp="#joint">bsatzung</unclear> von <placeName resp="#ner"><unclear cert="low" resp="#joint">Thütschem</unclear></placeName> <unclear cert="low" resp="#joint">volck</unclear>,
<lb n="34"/><unclear cert="low" resp="#joint">zueversicheren</unclear>, das zwar vast beschwärlich.
<lb n="35"/>unnd <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">wir</unclear> sonst vil lieber <unclear cert="medium" resp="#joint">welltind</unclear> über-
<lb n="36"/>hept sihn, wir khönnend aber die <unclear cert="low" resp="#joint">unnseren</unclear>
<pb facs="StadtASG_Missive_1239_4130.jpg" n="2"/>
<lb n="37"/>uß <unclear cert="low" resp="#joint">irem</unclear> mangell deß <unclear cert="low" resp="#joint">hirnns</unclear> (<unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">unß</unclear>,
<lb n="38"/>alls <unclear cert="medium" resp="#joint">iren</unclear> <unclear cert="medium" resp="#joint">oberkeit</unclear> <unclear cert="medium" resp="#joint">wolerkend</unclear>) <unclear cert="medium" resp="#joint">fließen</unclear>, noch
<lb n="39"/>allso <unclear cert="medium" resp="#joint">lychtlich</unclear> one <unclear cert="low" resp="#joint">fürsehung</unclear>, <unclear cert="low" resp="#joint">böser</unclear> <unclear cert="low" resp="#joint">anschlag</unclear>,
<lb n="40"/><unclear cert="low" resp="#joint">zůr</unclear> <unclear cert="low" resp="#joint">thatt</unclear> <unclear cert="low" resp="#joint">khomen</unclear> <unclear cert="low" resp="#joint">lasset</unclear>, <unclear cert="low" resp="#joint">destowen</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">mißend</unclear>, <unclear cert="low" resp="#joint">irenthalb</unclear> <unclear cert="low" resp="#joint">uffsehens</unclear> <unclear cert="low" resp="#joint">zehaben</unclear>,
<lb n="42"/><unclear cert="low" resp="#joint">sinder</unclear> <unclear cert="low" resp="#joint">doch</unclear> nit <unclear cert="low" resp="#joint">gemeint</unclear>, <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">jemandts</unclear>,
<lb n="43"/><unclear cert="low" resp="#joint">uetzit</unclear> unfründtlichs fürzenemmen, der
<lb n="44"/><unclear cert="low" resp="#joint">unß</unclear> nit schädtlich beleïdige, und zůr
<lb n="45"/>gegenweer reitzen wirt, und damït
<lb n="46"/>wir nun, ouch <unclear cert="low" resp="#joint">dheiner</unclear> <unclear cert="low" resp="#joint">urhebung</unclear> <unclear cert="low" resp="#joint">mögend</unclear>
<lb n="47"/><unclear cert="low" resp="#joint">bezigen</unclear>, noch bschuldiget werden, sonders
<lb n="48"/><unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">entschüttung</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">mencklichem</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">ußsprechen</unclear> <unclear cert="low" resp="#joint">sye</unclear>, so habend wir nitt
<lb n="50"/>underlassen wellen, <unclear cert="low" resp="#joint">uech</unclear> unser getrüw
<lb n="51"/>lieb <orgName resp="#ner"><unclear cert="low" resp="#joint">Eidtgnossen</unclear></orgName> <unclear cert="low" resp="#joint">gemeinlich</unclear> und jedes
<lb n="52"/><unclear cert="medium" resp="#joint">orth</unclear> <unclear cert="medium" resp="#joint">besonders</unclear>, (<unclear cert="medium" resp="#joint">zů</unclear> denen wir <unclear cert="medium" resp="#joint">unß</unclear> rhats,
<lb n="53"/>und bystandts <unclear cert="low" resp="#joint">vertröstend</unclear>) deß alles
<lb n="54"/><unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">zeberichten</unclear>, darby ouch <unclear cert="low" resp="#joint">gantz</unclear>
<lb n="55"/><unclear cert="low" resp="#joint">flyßig</unclear>, und fründtlich <unclear cert="low" resp="#joint">zebitten</unclear>, <unclear cert="low" resp="#joint">in</unclear> söllich
<lb n="56"/>sälßamigen zyten und seltsamen gfarlich
<lb n="57"/>besorgnuß, ein gůt getrüw Eidtgnössisch
<lb n="58"/>uffsehen unßerthalb zehaben, und <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">üwer</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">wyßheit</unclear> in <unclear cert="low" resp="#joint">bedenckhen</unclear> <unclear cert="low" resp="#joint">zefueren</unclear>, was
<lb n="60"/><unclear cert="low" resp="#joint">vlen</unclear> uff sölliche <unclear cert="low" resp="#joint">zůfäll</unclear> <unclear cert="low" resp="#joint">ußnemmen</unclear>, <unclear cert="low" resp="#joint">darüber</unclear>
<lb n="61"/>ouch <unclear cert="low" resp="#joint">uff</unclear> und <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">gräntzen</unclear> <unclear cert="low" resp="#joint">nüwlich</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">anckomenen</unclear> <unclear cert="low" resp="#joint">kriegßvolcks</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">starckem</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">besatzung</unclear> wegen, für <unclear cert="medium" resp="#joint">gfar</unclear>, und <unclear cert="medium" resp="#joint">nachtheïls</unclear>
<lb n="64"/><unclear cert="medium" resp="#joint">zebesorgen</unclear> <unclear cert="medium" resp="#joint">habend</unclear>, <unclear cert="medium" resp="#joint">unß</unclear> ouch <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">ein</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">nothvaal</unclear> <unclear cert="low" resp="#joint">zůsteenden</unclear> <unclear cert="low" resp="#joint">noth</unclear>, <unclear cert="low" resp="#joint">üwers</unclear> trost-
<lb n="66"/><unclear cert="low" resp="#joint">lichen</unclear> <unclear cert="low" resp="#joint">bystandts</unclear> <unclear cert="low" resp="#joint">trosts</unclear>, und <unclear cert="medium" resp="#joint">hilffs</unclear>,
<lb n="67"/>nit <unclear cert="medium" resp="#joint">zeermanglen</unclear>, alls <unclear cert="medium" resp="#joint">wir</unclear> <unclear cert="medium" resp="#joint">unß</unclear> <unclear cert="medium" resp="#joint">deß</unclear> <unclear cert="medium" resp="#joint">zů</unclear>
<lb n="68"/>üch <unclear cert="medium" resp="#joint">ungezwyffelt</unclear> <unclear cert="medium" resp="#joint">versehend</unclear>, und <unclear cert="medium" resp="#joint">in</unclear> söllich
<lb n="69"/><unclear cert="medium" resp="#joint">vaal</unclear> mit <unclear cert="low" resp="#joint">uech</unclear> <unclear cert="low" resp="#joint">zeglychem</unclear> willen, ouch <unclear cert="medium" resp="#joint">gegen</unclear>-
<lb n="70"/><unclear cert="medium" resp="#joint">gegeneigt</unclear> <unclear cert="medium" resp="#joint">sin</unclear> <unclear cert="medium" resp="#joint">werdend</unclear>, Gott <unclear cert="low" resp="#joint">bittende</unclear>, das er
