    <text>
        <body>
<p>
<pb facs="StadtASG_Missive_1239_4129.jpg" n="1"/>
<lb n="1"/>Unnser <unclear cert="low" resp="#joint">früntlich</unclear> willig dienst, sampt was wir
<lb n="2"/><unclear cert="low" resp="#joint">eeren</unclear>, liebs, <unclear cert="medium" resp="#joint">unnd</unclear> guets vermögend zuvor
<lb n="3"/>from, fürsichtig, ersam wyß, <unclear cert="low" resp="#joint">insonnders</unclear>
<lb n="4"/><unclear cert="low" resp="#joint">guet</unclear> <unclear cert="low" resp="#joint">frünnd</unclear>, unnd getrüw lieb <unclear cert="low" resp="#joint">Eidtgnossen</unclear>,
<lb n="5"/><unclear cert="low" resp="#joint">unns</unclear> sind nun etliche zyt dahär vilfaltige
<lb n="6"/>warnungen zuekhommen, kriegscher anschleg.
<lb n="7"/>unnd <unclear cert="low" resp="#joint">fürnemen</unclear> halb, <unclear cert="low" resp="#joint">über</unclear>, und <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">etliche</unclear>
<lb n="8"/><unclear cert="low" resp="#joint">unnserer</unclear> schloß. und <unclear cert="low" resp="#joint">fleckenn</unclear> deß <placeName resp="#ner"><unclear cert="low" resp="#joint">Welschnen</unclear>
<lb n="9"/><unclear cert="low" resp="#joint">landts</unclear></placeName>, <unclear cert="low" resp="#joint">wölches</unclear> <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">glychwohl</unclear> vil naehen-
<lb n="10"/>denckens, aber doch nit <unclear cert="low" resp="#joint">sovil</unclear> <unclear cert="low" resp="#joint">bewegt</unclear>, unnd
<lb n="11"/>gebracht, <unclear cert="low" resp="#joint">ettwas</unclear> <unclear cert="low" resp="#joint">gwüßes</unclear> <unclear cert="low" resp="#joint">daruf</unclear> <unclear cert="low" resp="#joint">zesetzen</unclear>,
<lb n="12"/>ein volnstreckung derselben zebefaren, noch
<lb n="13"/>inn <unclear cert="low" resp="#joint">söllches</unclear> <unclear cert="low" resp="#joint">misthrauen</unclear> <unclear cert="low" resp="#joint">zekhomen</unclear>. <unclear cert="low" resp="#joint">das</unclear>
<lb n="14"/><unclear cert="low" resp="#joint">jemandts</unclear> (<unclear cert="low" resp="#joint">daß</unclear> <unclear cert="low" resp="#joint">wir</unclear> deß <unclear cert="low" resp="#joint">dhain</unclear> <unclear cert="low" resp="#joint">anlaß</unclear>, <unclear cert="low" resp="#joint">noch</unclear>
<lb n="15"/><unclear cert="low" resp="#joint">ursach</unclear> <unclear cert="low" resp="#joint">gebenn</unclear>.) <unclear cert="low" resp="#joint">willens</unclear>, <unclear cert="low" resp="#joint">hette</unclear> <unclear cert="low" resp="#joint">uns</unclear> <unclear cert="low" resp="#joint">zeüber</unclear>-
<lb n="16"/>fallenn. diewyl sich aber under söllichen
<lb n="17"/>lümden zuetregt. das diser zyt abermalen
<lb n="18"/><unclear cert="low" resp="#joint">kriegsvolck</unclear> <unclear cert="low" resp="#joint">vß</unclear> <placeName ref="stadtasg-places-372" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Piemondt</unclear></placeName>, unnd <placeName ref="stadtasg-places-437" cert="medium" resp="#ner">Saphoy</placeName>, an
<lb n="19"/>die frontiern unnserer landen <unclear cert="low" resp="#joint">zücht</unclear>, unnd
<lb n="20"/>inn ettliche fleckenn den unsren wolbekant
<lb n="21"/>ettwas starcke bsatzungen gelegt werden,
<lb n="22"/><unclear cert="low" resp="#joint">muessend</unclear> wir abnemen, und gedencken,
<lb n="23"/>das nit jederman <unclear cert="low" resp="#joint">zue</unclear> <unclear cert="low" resp="#joint">unns</unclear> <unclear cert="low" resp="#joint">genaigt</unclear>, und dahär
<lb n="24"/>nit vil <unclear cert="low" resp="#joint">gunsts</unclear>, noch gueten willens zeverseh.
<lb n="25"/>sind doch nit gsinnet, deßwegen einiche
<lb n="26"/>erhebung fürzenemen, noch jemandts vy-
<lb n="27"/>endtschafft, oder laidts zebewysen, die
<lb n="28"/>fürsorg aber, und gheiß, so wir zu unnseren
<lb n="29"/>landen und <unclear cert="low" resp="#joint">underthanen</unclear> (<unclear cert="low" resp="#joint">wölche</unclear> ewer
<lb n="30"/>der nüw lieb Eidtgnossen, darein eir selbst,
<lb n="31"/>unns zuegesprochen habendt.) tragend. trengt.
<lb n="32"/>unnd <unclear cert="low" resp="#joint">bewegt</unclear> <unclear cert="low" resp="#joint">unns</unclear>, <unclear cert="low" resp="#joint">dieselben</unclear> <unclear cert="low" resp="#joint">unnser</unclear> <unclear cert="low" resp="#joint">flecken</unclear>.
<lb n="33"/>mit einer <unclear cert="low" resp="#joint">bsatzung</unclear> <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Thütschem</unclear></placeName> <unclear cert="low" resp="#joint">volck</unclear>,
<lb n="34"/><unclear cert="low" resp="#joint">zueversicheren</unclear>, das zwar vast beschwärlich.
<lb n="35"/>unnd <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">wir</unclear> sonst vil lieber <unclear cert="low" resp="#joint">welltind</unclear> <unclear cert="low" resp="#joint">über</unclear>-
<lb n="36"/>hept sihn, wir khönnend aber die <unclear cert="low" resp="#joint">unnseren</unclear>
<pb facs="StadtASG_Missive_1239_4130.jpg" n="2"/>
<lb n="37"/>uß irem mangell deß <unclear cert="low" resp="#joint">hirnns</unclear> (<unclear cert="low" resp="#joint">dan</unclear> <unclear cert="low" resp="#joint">sy</unclear> <unclear cert="low" resp="#joint">von</unclear> <unclear cert="low" resp="#joint">unß</unclear>,
<lb n="38"/><unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">iren</unclear> <unclear cert="low" resp="#joint">oberkeit</unclear> <unclear cert="low" resp="#joint">wolerkend</unclear>) <unclear cert="low" resp="#joint">fließen</unclear>, noch
<lb n="39"/>allso <unclear cert="low" resp="#joint">lychtlich</unclear> <unclear cert="low" resp="#joint">one</unclear> <unclear cert="low" resp="#joint">fürsehung</unclear>, <unclear cert="low" resp="#joint">böser</unclear> <unclear cert="low" resp="#joint">anschlag</unclear>,
<lb n="40"/><unclear cert="low" resp="#joint">zůr</unclear> <unclear cert="low" resp="#joint">thatt</unclear> <unclear cert="low" resp="#joint">khomen</unclear> <unclear cert="low" resp="#joint">lasset</unclear>, <unclear cert="low" resp="#joint">destowen</unclear>-
<lb n="41"/><unclear cert="low" resp="#joint">mißend</unclear>, <unclear cert="low" resp="#joint">irenthalb</unclear> <unclear cert="low" resp="#joint">uffsehens</unclear> <unclear cert="low" resp="#joint">zehaben</unclear>,
<lb n="42"/><unclear cert="low" resp="#joint">sinder</unclear> <unclear cert="low" resp="#joint">doch</unclear> <unclear cert="low" resp="#joint">nit</unclear> <unclear cert="low" resp="#joint">gemeint</unclear>, <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">jemandts</unclear>,
<lb n="43"/><unclear cert="low" resp="#joint">uetzit</unclear> <unclear cert="low" resp="#joint">unfründtlichs</unclear> fürzenemmen, der
<lb n="44"/>unß nit schädtlich beleïdige, und zůr
<lb n="45"/>gegenweer reitzen wirt, und damït
<lb n="46"/>wir nun, ouch dheiner urhebung mögend
<lb n="47"/>bezigen, noch bschuldiget werden, <unclear cert="low" resp="#joint">sonders</unclear>
<lb n="48"/><unclear cert="low" resp="#joint">unser</unclear> <unclear cert="low" resp="#joint">entschüttung</unclear> <unclear cert="low" resp="#joint">gegen</unclear> <unclear cert="low" resp="#joint">mencklichem</unclear>
<lb n="49"/><unclear cert="low" resp="#joint">ußsprechen</unclear> <unclear cert="low" resp="#joint">sye</unclear>, so habend wir nitt
<lb n="50"/>underlassen wellen, uech unser getrüw
<lb n="51"/>lieb <orgName resp="#ner">Eidtgnossen</orgName> gemeinlich und jedes
<lb n="52"/><unclear cert="low" resp="#joint">orth</unclear> <unclear cert="low" resp="#joint">besonders</unclear>, (<unclear cert="low" resp="#joint">zů</unclear> <unclear cert="low" resp="#joint">denen</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">unß</unclear> rhats,
<lb n="53"/>und bystandts vertröstend) deß alles
<lb n="54"/>hiemit zeberichten, darby ouch gantz
<lb n="55"/>flyßig, und fründtlich zebitten, in söllich
<lb n="56"/>sälßamigen zyten und seltsamen gfarlich
<lb n="57"/>besorgnuß, ein gůt getrüw Eidtgnössisch
<lb n="58"/>uffsehen unßerthalb zehaben, und <unclear cert="low" resp="#joint">nach</unclear> <unclear cert="low" resp="#joint">üwer</unclear>
<lb n="59"/><unclear cert="low" resp="#joint">wyßheit</unclear> in <unclear cert="low" resp="#joint">bedenckhen</unclear> <unclear cert="low" resp="#joint">zefueren</unclear>, <unclear cert="low" resp="#joint">was</unclear>
<lb n="60"/><unclear cert="low" resp="#joint">vlen</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">sölliche</unclear> <unclear cert="low" resp="#joint">zůfäll</unclear> <unclear cert="low" resp="#joint">ußnemmen</unclear>, <unclear cert="low" resp="#joint">darüber</unclear>
<lb n="61"/><unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unseren</unclear> <unclear cert="low" resp="#joint">gräntzen</unclear> <unclear cert="low" resp="#joint">nüwlich</unclear>
<lb n="62"/><unclear cert="low" resp="#joint">anckomenen</unclear> <unclear cert="low" resp="#joint">kriegßvolcks</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">starckem</unclear>
<lb n="63"/><unclear cert="low" resp="#joint">besatzung</unclear> <unclear cert="low" resp="#joint">wegen</unclear>, <unclear cert="low" resp="#joint">für</unclear> <unclear cert="low" resp="#joint">gfar</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">nachtheïls</unclear>
<lb n="64"/><unclear cert="low" resp="#joint">zebesorgen</unclear> <unclear cert="low" resp="#joint">habend</unclear>, <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">uff</unclear> <unclear cert="low" resp="#joint">ein</unclear>
<lb n="65"/><unclear cert="low" resp="#joint">nothvaal</unclear> <unclear cert="low" resp="#joint">zůsteenden</unclear> <unclear cert="low" resp="#joint">noth</unclear>, <unclear cert="low" resp="#joint">üwers</unclear> <unclear cert="low" resp="#joint">trost</unclear>-
<lb n="66"/><unclear cert="low" resp="#joint">lichen</unclear> <unclear cert="low" resp="#joint">bystandts</unclear> <unclear cert="low" resp="#joint">trosts</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">hilffs</unclear>,
<lb n="67"/>nit <unclear cert="low" resp="#joint">zeermanglen</unclear>, <unclear cert="low" resp="#joint">alls</unclear> <unclear cert="low" resp="#joint">wir</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">deß</unclear> <unclear cert="low" resp="#joint">zů</unclear>
<lb n="68"/><unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">ungezwyffelt</unclear> <unclear cert="low" resp="#joint">versehend</unclear>, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">in</unclear> <unclear cert="low" resp="#joint">söllich</unclear>
<lb n="69"/><unclear cert="low" resp="#joint">vaal</unclear> <unclear cert="low" resp="#joint">mit</unclear> <unclear cert="low" resp="#joint">uech</unclear> <unclear cert="low" resp="#joint">zeglychem</unclear> <unclear cert="low" resp="#joint">willen</unclear>, <unclear cert="low" resp="#joint">ouch</unclear> <unclear cert="low" resp="#joint">gegen</unclear>-
<lb n="70"/><unclear cert="low" resp="#joint">gegeneigt</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">werdend</unclear>, Gott bittende, das er
<lb n="71"/>alle böse <unclear cert="low" resp="#joint">anschleg</unclear> <unclear cert="low" resp="#joint">fürkomen</unclear>, <unclear cert="low" resp="#joint">uech</unclear> <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">unß</unclear> <unclear cert="low" resp="#joint">in</unclear> lieben
<lb n="72"/>vatterland, in gůtem friden, <unclear cert="low" resp="#joint">und</unclear> <unclear cert="low" resp="#joint">wolstand</unclear> er-
<lb n="73"/>hallten welle, dat <origDate when="1588" resp="#ner">16a decembris 1588</origDate>.
<lb n="74"/><orgName ref="stadtasg-actors-514" cert="medium" role="issuer" resp="#ner">Schultheiß und rhat
<lb n="75"/>der statt Bernn</orgName>.
<pb facs="StadtASG_Missive_1239_4131.jpg" n="3"/>
<pb facs="StadtASG_Missive_1239_4132.jpg" n="4"/>
<lb n="76"/>Denn frommen, <unclear cert="low" resp="#joint">fürsichtigenn</unclear>,
<lb n="77"/><unclear cert="low" resp="#joint">ersammenn</unclear>, <unclear cert="low" resp="#joint">wyßenn</unclear>, <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner">Burger-
<lb n="78"/>meister, unnd Rhat der statt
<lb n="79"/><unclear cert="medium" resp="#joint">Sannct</unclear> Gallenn</orgName>, unnserenn
<lb n="80"/><unclear cert="medium" resp="#joint">innsonders</unclear> guoten <unclear cert="low" resp="#joint">frünndenn</unclear>,
<lb n="81"/>unnd getrüwenn lieb Eydtgnossen.
</p>
