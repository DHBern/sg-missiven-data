<lb n="3"/>unnd <unclear cert="low" resp="#joint">wysenn</unclear>, <unclear cert="low" resp="#joint">innsunnders</unclear> <unclear cert="low" resp="#joint">guotten</unclear> <unclear cert="low" resp="#joint">fründ</unclear>, getrüwen
<lb n="4"/><unclear cert="medium" resp="#joint">liebenn</unclear> <unclear cert="medium" resp="#joint">Eydtgnossenn</unclear>. Es ist unnser burger <persName resp="#ner">Sebastian
<lb n="5"/><unclear cert="low" resp="#joint">Suetter</unclear></persName> unnd <persName resp="#ner">Anna <unclear cert="low" resp="#joint">Oesingerin</unclear></persName>, sein <unclear cert="low" resp="#joint">eeliche</unclear> <unclear cert="low" resp="#joint">hußfrouw</unclear>,
<lb n="6"/><unclear cert="low" resp="#joint">baide</unclear> selige, <unclear cert="low" resp="#joint">kurtzverschiner</unclear> <unclear cert="low" resp="#joint">tagen</unclear> mit tod <unclear cert="low" resp="#joint">abganngen</unclear>,
<lb n="7"/>unnd <unclear cert="low" resp="#joint">kaine</unclear> <unclear cert="low" resp="#joint">kinder</unclear> von <unclear cert="medium" resp="#joint">inen</unclear> baidenn, aber <unclear cert="medium" resp="#joint">glichwol</unclear> von
<lb n="8"/><unclear cert="medium" resp="#joint">yeder</unclear> siner <unclear cert="medium" resp="#joint">eelichenn</unclear> <unclear cert="medium" resp="#joint">hußfrouwen</unclear> seligenn <unclear cert="low" resp="#joint">erborenn</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">eeliche</unclear> <unclear cert="low" resp="#joint">kinder</unclear> <unclear cert="low" resp="#joint">innverlassenn</unclear>. <unclear cert="low" resp="#joint">Diewil</unclear> dann die <unclear cert="low" resp="#joint">frouw</unclear>
