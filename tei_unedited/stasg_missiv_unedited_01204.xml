<p>
<pb facs="StadtASG_Missive_1204_3975.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unser</unclear> fründtlich willig dienst, mitt <unclear cert="low" resp="#joint">erbiettung</unclear> aller eren,
<lb n="2"/>liebs unnd guots zuvor, frommen, fürsichtigen, <unclear cert="medium" resp="#joint">ersamen</unclear>
<lb n="3"/>unnd wysenn, <unclear cert="medium" resp="#joint">innsunnders</unclear> guotten <unclear cert="medium" resp="#joint">fründ</unclear>, getrüwen
<lb n="4"/>liebenn Eydtgnossenn. Es ist unnser burger <persName resp="#ner">Sebastian
<lb n="5"/><unclear cert="low" resp="#joint">Suetter</unclear></persName> unnd <persName resp="#ner">Anna <unclear cert="low" resp="#joint">Oesingerin</unclear></persName>, sein <unclear cert="low" resp="#joint">eeliche</unclear> <unclear cert="low" resp="#joint">hußfrouw</unclear>,
<lb n="6"/><unclear cert="low" resp="#joint">baide</unclear> selige, <unclear cert="low" resp="#joint">kurtzverschiner</unclear> <unclear cert="low" resp="#joint">tagen</unclear> mit tod <unclear cert="low" resp="#joint">abganngen</unclear>,
<lb n="7"/>unnd <unclear cert="low" resp="#joint">kaine</unclear> <unclear cert="low" resp="#joint">kinder</unclear> von inen baidenn, aber <unclear cert="low" resp="#joint">glichwol</unclear> von
<lb n="8"/><unclear cert="low" resp="#joint">yeder</unclear> siner <unclear cert="low" resp="#joint">eelichenn</unclear> <unclear cert="low" resp="#joint">hußfrouwen</unclear> seligenn <unclear cert="low" resp="#joint">erborenn</unclear>,
<lb n="9"/><unclear cert="low" resp="#joint">eeliche</unclear> <unclear cert="low" resp="#joint">kinder</unclear> <unclear cert="low" resp="#joint">innverlassenn</unclear>. <unclear cert="low" resp="#joint">Diewil</unclear> dann die <unclear cert="low" resp="#joint">frouw</unclear>
<lb n="10"/><unclear cert="low" resp="#joint">ine</unclear> <unclear cert="low" resp="#joint">ueberläbt</unclear> unnd <unclear cert="low" resp="#joint">volgends</unclear> nach <unclear cert="medium" resp="#joint">ime</unclear> mit tod <unclear cert="low" resp="#joint">verscheiden</unclear>,
<lb n="11"/>so hane ir billich ir <unclear cert="low" resp="#joint">morgengaab</unclear>, <unclear cert="low" resp="#joint">gebuerte</unclear> <unclear cert="low" resp="#joint">husraat</unclear>,
<lb n="12"/><unclear cert="low" resp="#joint">sambt</unclear> <unclear cert="low" resp="#joint">ainem</unclear> <unclear cert="low" resp="#joint">gebürenden</unclear> <unclear cert="low" resp="#joint">kindstail</unclear> zuo <unclear cert="medium" resp="#joint">stan</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> werdenn
<lb n="13"/>soellen, das dann <unclear cert="low" resp="#joint">jetzo</unclear> uf <unclear cert="low" resp="#joint">ire</unclear> <unclear cert="low" resp="#joint">nächste</unclear> unnd natürliche bluots
<lb n="14"/>fründ <unclear cert="medium" resp="#joint">unnd</unclear> erbenn gefallen etc. Sydmalen aber <unclear cert="low" resp="#joint">deß</unclear>-
<lb n="15"/><unclear cert="low" resp="#joint">halb</unclear> <unclear cert="low" resp="#joint">ainiche</unclear> <unclear cert="low" resp="#joint">bluotsfründ</unclear> noch <unclear cert="medium" resp="#joint">erbenn</unclear> <unclear cert="medium" resp="#joint">hie</unclear>, sunder <unclear cert="medium" resp="#joint">inen</unclear>
<lb n="16"/>an <unclear cert="medium" resp="#joint">erbern</unclear> <unclear cert="medium" resp="#joint">burgern</unclear>, <unclear cert="medium" resp="#joint">wylund</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Niclaus</unclear> <unclear cert="medium" resp="#joint">Oesingers</unclear></persName>,
<lb n="17"/><unclear cert="medium" resp="#joint">üwers</unclear> <unclear cert="medium" resp="#joint">mitburgers</unclear> (der dann ain <unclear cert="medium" resp="#joint">kemmetmacher</unclear> ge-
<lb n="18"/><unclear cert="medium" resp="#joint">wesenn</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="low" resp="#joint">sol</unclear>) eeliche tochter die <unclear cert="low" resp="#joint">heiratht</unclear> <unclear cert="low" resp="#joint">vor</unclear> <unclear cert="low" resp="#joint">ungefär</unclear>
<lb n="19"/><unclear cert="low" resp="#joint">driss</unclear>, vier oder <date resp="#ner"><unclear cert="medium" resp="#joint">fünffundryssig</unclear></date> <unclear cert="medium" resp="#joint">jarenn</unclear>, mit <unclear cert="medium" resp="#joint">irem</unclear> <unclear cert="low" resp="#joint">ersten</unclear>
<lb n="20"/><unclear cert="low" resp="#joint">eeman</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Hains</unclear> <unclear cert="low" resp="#joint">Herbern</unclear></persName> <unclear cert="low" resp="#joint">unnserm</unclear> burger seligenn, <unclear cert="low" resp="#joint">alher</unclear>
<lb n="21"/>in unnser statt <unclear cert="low" resp="#joint">zogen</unclear>, unnd <unclear cert="medium" resp="#joint">on</unclear> <unclear cert="medium" resp="#joint">zwyfell</unclear> by <unclear cert="low" resp="#joint">üch</unclear> <unclear cert="low" resp="#joint">noch</unclear>
<lb n="22"/><unclear cert="low" resp="#joint">bluotsfründt</unclear> unnd erbenn habenn wirt, so habenn
<lb n="23"/>wir <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">sölhane</unclear> <unclear cert="medium" resp="#joint">zeberichten</unclear> nit <unclear cert="low" resp="#joint">unnderlassenn</unclear> <unclear cert="low" resp="#joint">söllen</unclear>
<lb n="24"/><unclear cert="low" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">wellenn</unclear>. Unnd <unclear cert="medium" resp="#joint">lanngt</unclear> <unclear cert="medium" resp="#joint">daruf</unclear> an <unclear cert="medium" resp="#joint">üch</unclear> <unclear cert="medium" resp="#joint">unnser</unclear>
<lb n="25"/>fründtlich <unclear cert="low" resp="#joint">gesinnen</unclear>, ir <unclear cert="medium" resp="#joint">wellind</unclear> <unclear cert="low" resp="#joint">deßhalben</unclear> <unclear cert="low" resp="#joint">by</unclear> den <unclear cert="medium" resp="#joint">üwern</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">nachvorschung</unclear> <unclear cert="medium" resp="#joint">habenn</unclear> unbeschwärt sin, unnd ob <unclear cert="medium" resp="#joint">iemandts</unclear>
<lb n="27"/><unclear cert="medium" resp="#joint">irer</unclear> <unclear cert="medium" resp="#joint">bluotsverwandtenn</unclear> <unclear cert="medium" resp="#joint">vorhanndenn</unclear>, die selbenn mit
<lb n="28"/>aller <unclear cert="low" resp="#joint">notturft</unclear> (doch mit <unclear cert="medium" resp="#joint">glouplichem</unclear> <unclear cert="medium" resp="#joint">schin</unclear> <unclear cert="medium" resp="#joint">unnd</unclear> <unclear cert="medium" resp="#joint">urkun</unclear>
<lb n="29"/><unclear cert="medium" resp="#joint">uch</unclear> der <unclear cert="low" resp="#joint">ordennlichenn</unclear> <unclear cert="low" resp="#joint">oberkait</unclear>, wie unnd wellcher ge-
<lb n="30"/><unclear cert="medium" resp="#joint">stalt</unclear> <unclear cert="medium" resp="#joint">söllche</unclear> bluots <unclear cert="medium" resp="#joint">fründtschaft</unclear> beschaffenn sye) alher
<lb n="31"/><unclear cert="low" resp="#joint">sich</unclear> <unclear cert="low" resp="#joint">zeverfuegenn</unclear> wysenn, <unclear cert="medium" resp="#joint">sol</unclear> <unclear cert="low" resp="#joint">inen</unclear> <unclear cert="low" resp="#joint">widerfarenn</unclear>, was
<lb n="32"/>inen unnser Statt Erbrecht <unclear cert="low" resp="#joint">zuogibt</unclear> unnd sy sich <unclear cert="low" resp="#joint">nüt</unclear> ze-
<lb n="33"/><unclear cert="low" resp="#joint">beklagenn</unclear> habind. Ob aber <unclear cert="medium" resp="#joint">niemandt</unclear> <unclear cert="low" resp="#joint">ires</unclear> <unclear cert="medium" resp="#joint">bluots</unclear>-
<lb n="34"/><unclear cert="medium" resp="#joint">fründtenn</unclear> oder erben mer <unclear cert="low" resp="#joint">vorhanndenn</unclear>, wellind ir doch
<lb n="35"/><unclear cert="medium" resp="#joint">unnds</unclear> selbenn by <unclear cert="low" resp="#joint">zeigern</unclear> diß <unclear cert="low" resp="#joint">schryfftlich</unclear> <unclear cert="low" resp="#joint">berichtenn</unclear>,
<lb n="36"/>damit die <unclear cert="low" resp="#joint">übrigen</unclear> erben sich der <unclear cert="medium" resp="#joint">taillung</unclear> halber dar-
<lb n="37"/>nach <unclear cert="low" resp="#joint">wüssind</unclear> <unclear cert="low" resp="#joint">zeuerhaltenn</unclear>. Das stadt <unclear cert="medium" resp="#joint">unns</unclear> in <unclear cert="low" resp="#joint">glichem</unclear> und
<lb n="38"/>merern gegen <unclear cert="low" resp="#joint">üch</unclear> ganntz fründtlich <unclear cert="low" resp="#joint">zeuerdienenn</unclear>.
<pb facs="StadtASG_Missive_1204_3976.jpg" n="2"/>
<lb n="39"/><unclear cert="low" resp="#joint">hiemit</unclear> <unclear cert="low" resp="#joint">üch</unclear> unnd <unclear cert="medium" resp="#joint">unns</unclear> in den <unclear cert="low" resp="#joint">schirm</unclear> <unclear cert="low" resp="#joint">gottes</unclear> <unclear cert="low" resp="#joint">befelhende</unclear>.
