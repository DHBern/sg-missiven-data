<lb n="1"/>Unser fründtlich willig dienst, mitt <unclear cert="low" resp="#joint">erbiettung</unclear> <unclear cert="low" resp="#joint">aller</unclear> <unclear cert="low" resp="#joint">eren</unclear>,
