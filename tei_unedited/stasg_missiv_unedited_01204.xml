<lb n="11"/>so <unclear cert="medium" resp="#joint">hane</unclear> ir billich ir <unclear cert="low" resp="#joint">morgengaab</unclear>, <unclear cert="low" resp="#joint">gebuerte</unclear> <unclear cert="low" resp="#joint">husraat</unclear>,
