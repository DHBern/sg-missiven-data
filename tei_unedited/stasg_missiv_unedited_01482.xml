        <body>
<p>
<pb facs="StadtASG_Missive_1482_5327.jpg" n="1"/>
<lb n="1"/><unclear cert="medium" resp="#joint">Unnser</unclear> <unclear cert="low" resp="#joint">frünttlich</unclear> <unclear cert="low" resp="#joint">nachpüerlich</unclear> <unclear cert="low" resp="#joint">guotwillig</unclear> diennst
<lb n="2"/>mit <unclear cert="low" resp="#joint">erbietung</unclear> aller eeren, liebs unnd guotz <unclear cert="medium" resp="#joint">zuovor</unclear>.
<lb n="3"/><unclear cert="low" resp="#joint">Edel</unclear>, <unclear cert="low" resp="#joint">fromm</unclear>, <unclear cert="low" resp="#joint">eerenvest</unclear>, <unclear cert="low" resp="#joint">fürsichtig</unclear>, <unclear cert="medium" resp="#joint">wyß</unclear>, <unclear cert="low" resp="#joint">günnstig</unclear>, liebe
<lb n="4"/>Herren unnd guote <unclear cert="medium" resp="#joint">frünndt</unclear>. Wir werden <unclear cert="medium" resp="#joint">verstenndiget</unclear>,
<lb n="5"/>das ir uff gesterigen tag. Einen armen <unclear cert="low" resp="#joint">bösen</unclear> mentschen,
<lb n="6"/>umb siner <unclear cert="medium" resp="#joint">beganngnen</unclear> <unclear cert="medium" resp="#joint">boßhafften</unclear> unnd <unclear cert="medium" resp="#joint">mißhanndlingen</unclear>,
<lb n="7"/>wegen, richten lassen. <unclear cert="low" resp="#joint">Dabi</unclear> ouch <unclear cert="medium" resp="#joint">noch</unclear> <unclear cert="low" resp="#joint">zwoen</unclear> <unclear cert="medium" resp="#joint">der</unclear>-
<lb n="8"/>selbigen <unclear cert="low" resp="#joint">argwoenischen</unclear> <unclear cert="low" resp="#joint">verlümbdeten</unclear> <unclear cert="low" resp="#joint">personen</unclear> inn
<lb n="9"/><unclear cert="medium" resp="#joint">verwarung</unclear>. <unclear cert="low" resp="#joint">Soellen</unclear> <unclear cert="medium" resp="#joint">ouch</unclear> unnder <unclear cert="low" resp="#joint">annderem</unclear> <unclear cert="low" resp="#joint">bekenndt</unclear>
<lb n="10"/>haben, das <unclear cert="low" resp="#joint">ein</unclear> lannger kramer im <unclear cert="medium" resp="#joint">lannd</unclear> hin unnd
<lb n="11"/>heer zieche. So der <unclear cert="low" resp="#joint">boest</unclear> unnder allen <unclear cert="medium" resp="#joint">derglychen</unclear>
<lb n="12"/><unclear cert="low" resp="#joint">marderen</unclear>. Diewyl dann wir <unclear cert="medium" resp="#joint">verschinnen</unclear>
<lb n="13"/><unclear cert="low" resp="#joint">zinstags</unclear>. <unclear cert="low" resp="#joint">Ein</unclear> <unclear cert="low" resp="#joint">sömlichen</unclear> <unclear cert="low" resp="#joint">verdachtlichen</unclear> <unclear cert="low" resp="#joint">kramer</unclear>,
<lb n="14"/>der <unclear cert="medium" resp="#joint">fürgeben</unclear> <unclear cert="low" resp="#joint">sije</unclear> vier unnd <unclear cert="low" resp="#joint">zwoenntzig</unclear> <unclear cert="low" resp="#joint">stundt</unclear> ver-
<lb n="15"/><unclear cert="low" resp="#joint">zugt</unclear> <unclear cert="low" resp="#joint">gweßen</unclear>, ouch sich <unclear cert="low" resp="#joint">sonnst</unclear> mit einem <unclear cert="low" resp="#joint">fünstling</unclear>
<lb n="16"/>unnd <unclear cert="medium" resp="#joint">annderen</unclear> sachen <unclear cert="low" resp="#joint">ungebürlich</unclear> erzeigt, <unclear cert="low" resp="#joint">Gfen</unclear>-
<lb n="17"/><unclear cert="low" resp="#joint">gklich</unclear> <unclear cert="medium" resp="#joint">inziechen</unclear>. Unnd <unclear cert="medium" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">sin</unclear> <unclear cert="medium" resp="#joint">thun</unclear> <unclear cert="medium" resp="#joint">erfragen</unclear>
<lb n="18"/>lassen. Hat er <unclear cert="low" resp="#joint">enndtlich</unclear> nach <unclear cert="medium" resp="#joint">strennge</unclear> der <unclear cert="low" resp="#joint">überstanndnen</unclear>,
<lb n="19"/><unclear cert="medium" resp="#joint">marter</unclear> <unclear cert="low" resp="#joint">bekenndt</unclear>. Das er unnd <unclear cert="low" resp="#joint">sine</unclear> <unclear cert="medium" resp="#joint">gesellen</unclear>, <unclear cert="medium" resp="#joint">biß</unclear>
<lb n="20"/>inn <unclear cert="low" resp="#joint">zechnen</unclear> <unclear cert="low" resp="#joint">marden</unclear> <unclear cert="low" resp="#joint">miteinannderen</unclear> <unclear cert="low" resp="#joint">verüebt</unclear>.
<lb n="21"/><unclear cert="low" resp="#joint">Wüsse</unclear> aber nit ob <unclear cert="low" resp="#joint">sine</unclear> gesellen noch <unclear cert="medium" resp="#joint">vorhanden</unclear> oder
<lb n="22"/><unclear cert="low" resp="#joint">all</unclear> nit. Doch <unclear cert="low" resp="#joint">heisse</unclear> der <unclear cert="low" resp="#joint">ein</unclear> <persName resp="#ner">Hanns</persName>. Der
<lb n="23"/><unclear cert="medium" resp="#joint">annder</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Peeter</unclear></persName>. Der <unclear cert="medium" resp="#joint">dritt</unclear> <persName resp="#ner"><unclear cert="medium" resp="#joint">Paulj</unclear></persName>. Der vierdt
<lb n="24"/><persName resp="#ner"><unclear cert="low" resp="#joint">Steffan</unclear></persName>. Unnd der <unclear cert="low" resp="#joint">fünnfft</unclear> <persName resp="#ner"><unclear cert="low" resp="#joint">Liennhard</unclear></persName>. <unclear cert="low" resp="#joint">Sijen</unclear> <unclear cert="medium" resp="#joint">all</unclear>
<lb n="25"/><unclear cert="low" resp="#joint">auß</unclear> <placeName ref="stadtasg-places-15" cert="medium" resp="#ner"><unclear cert="low" resp="#joint">Wienn</unclear></placeName> <unclear cert="low" resp="#joint">erschinnen</unclear>. <unclear cert="low" resp="#joint">Könne</unclear> aber ir <unclear cert="low" resp="#joint">je</unclear> <unclear cert="medium" resp="#joint">des</unclear>
<lb n="26"/><unclear cert="medium" resp="#joint">übernamen</unclear> nit nennen etc. Derhalben so
<lb n="27"/>gelanngt an üch unser nachpüerlich <unclear cert="low" resp="#joint">pittn</unclear>, ir <unclear cert="low" resp="#joint">weellen</unclear>,
<lb n="28"/>unns <unclear cert="low" resp="#joint">vom</unclear> <unclear cert="low" resp="#joint">obrkait</unclear>, unnd <unclear cert="low" resp="#joint">stür</unclear> der <unclear cert="low" resp="#joint">gerechtigkeit</unclear>
<lb n="29"/>wegen <unclear cert="low" resp="#joint">bi</unclear> <unclear cert="low" resp="#joint">zeigeren</unclear> schrifftlich berichten. Ob <unclear cert="low" resp="#joint">vilicht</unclear>
<lb n="30"/>der <unclear cert="low" resp="#joint">abgethane</unclear> <unclear cert="low" resp="#joint">menntsch</unclear> oder <unclear cert="low" resp="#joint">üwere</unclear> noch <unclear cert="low" resp="#joint">zwoen</unclear> ge-
<lb n="31"/><unclear cert="low" resp="#joint">fanngnen</unclear> <unclear cert="low" resp="#joint">etwas</unclear> von disem lanngen <unclear cert="medium" resp="#joint">kramer</unclear>
<lb n="32"/><unclear cert="medium" resp="#joint">moechten</unclear> <unclear cert="medium" resp="#joint">wüssen</unclear> haben. Dann er sich <unclear cert="low" resp="#joint">nempt</unclear> <persName resp="#ner">Crista
<lb n="33"/><unclear cert="medium" resp="#joint">Bader</unclear></persName> <unclear cert="low" resp="#joint">von</unclear> <placeName resp="#ner"><unclear cert="low" resp="#joint">Haselperz</unclear></placeName> <unclear cert="medium" resp="#joint">uß</unclear> <placeName ref="stadtasg-places-99" cert="medium" resp="#ner"><unclear cert="medium" resp="#joint">Tyrol</unclear></placeName>. Oder ob ir diser
<lb n="34"/><unclear cert="low" resp="#joint">wahrhaffteren</unclear> und <unclear cert="low" resp="#joint">boesen</unclear> <unclear cert="low" resp="#joint">buben</unclear>, namen <unclear cert="low" resp="#joint">merer</unclear>
<lb n="35"/><unclear cert="low" resp="#joint">moechten</unclear> <unclear cert="low" resp="#joint">verzeichnet</unclear> haben. <unclear cert="medium" resp="#joint">Damit</unclear> wir unns
<lb n="36"/>gegen <unclear cert="medium" resp="#joint">dem</unclear> <unclear cert="medium" resp="#joint">schuldigen</unclear> <unclear cert="low" resp="#joint">desterbaß</unclear> zehandlen wüssen.
<pb facs="StadtASG_Missive_1482_5328.jpg" n="2"/>
<lb n="37"/>Das <unclear cert="low" resp="#joint">stath</unclear> <unclear cert="low" resp="#joint">umb</unclear> <unclear cert="low" resp="#joint">uech</unclear> <unclear cert="low" resp="#joint">hinwiderumb</unclear> inn <unclear cert="medium" resp="#joint">soelcher</unclear> unnd
<lb n="38"/>derglychen sachen und <unclear cert="low" resp="#joint">faellen</unclear>, gantz <unclear cert="low" resp="#joint">Nachpuerlich</unclear>
<lb n="39"/><unclear cert="low" resp="#joint">zubeschulden</unclear> unnd zuverdienen.
<lb n="40"/><unclear cert="low" resp="#joint">Gott</unclear> <unclear cert="low" resp="#joint">samptlich</unclear> <unclear cert="low" resp="#joint">wolbevolchen</unclear>. <unclear cert="low" resp="#joint">Dat</unclear> <origDate when="1605" resp="#ner">Frytags
<lb n="41"/>den <unclear cert="low" resp="#joint">8</unclear> <unclear cert="low" resp="#joint">t</unclear>. Julii. Anno 1605</origDate>.
<lb n="42"/><orgName role="issuer" resp="#ner"><unclear cert="low" resp="#joint">Statthaltter</unclear> <unclear cert="low" resp="#joint">Vogtzrychs</unclear> Schultheiß
<lb n="43"/>unnd Rath der Stat Wyl Im <unclear cert="low" resp="#joint">Thurgöuw</unclear></orgName>,
<pb facs="StadtASG_Missive_1482_5329.jpg" n="3"/>
<pb facs="StadtASG_Missive_1482_5330.jpg" n="4"/>
<lb n="44"/><unclear cert="low" resp="#joint">Denen</unclear> edlen fromen erenvesten fuersichtigen <unclear cert="medium" resp="#joint">und</unclear>
<lb n="45"/><unclear cert="medium" resp="#joint">wysen</unclear> herren <orgName ref="stadtasg-actors-148" cert="medium" role="recipient" resp="#ner"><unclear cert="medium" resp="#joint">Burgermeister</unclear> <unclear cert="medium" resp="#joint">und</unclear> Rath der <unclear cert="medium" resp="#joint">stat</unclear>
<lb n="46"/><unclear cert="medium" resp="#joint">Sanct</unclear> Gallen</orgName> unnsern guenstigen
<lb n="47"/>lieben herren gueten fruenden und nachbaren.
</p>
